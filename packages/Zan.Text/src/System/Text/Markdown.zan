using System;

namespace System.Text;

// 面向应用文本的小型确定性 Markdown 转 HTML 渲染器。
// <c>Markdown.ToHtml(text)</c> 支持 ATX 标题、段落、块级
// 引用、有序和无序列表、三反引号围栏代码、行内
// 代码、斜体、粗体、链接及反斜杠转义。输出
// 紧凑：块级元素以换行分隔，段落的软换行
// 变为空格。
// 刻意不兼容 CommonMark：块不嵌套，列表项和
// 引用各占一行源码，围栏信息字符串被忽略，行内
// 定界符取第一个匹配的闭合符。未闭合的定界符原样输出，
// 未闭合的围栏把剩余输入当作代码。
// 源文本、代码、标签和链接属性均做 HTML 转义。链接 URL
// 必须是相对路径，或使用 <c>http</c>、<c>https</c>、<c>mailto</c>
// 协议；含 ASCII 控制字符的 URL 只渲染为标签文本，
// 不生成锚点链接。
public class Markdown {
    // 零分配判定切片是否全空白。
    private static bool IsBlankSlice(Span<byte> sp, int start, int end) {
        for (int i = start; i < end; i = i + 1) {
            int c = sp[i] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { return false; }
        }
        return true;
    }

    // 零分配判定切片是否以 "```" 开头。
    private static bool IsFenceSlice(Span<byte> sp, int start, int end) {
        return end - start >= 3 &&
            (sp[start] & 255) == 96 && (sp[start + 1] & 255) == 96 && (sp[start + 2] & 255) == 96;
    }

    // 切片版 ATX 标题级别（1-6）。
    private static int HeadingLevelSlice(Span<byte> sp, int start, int end) {
        int len = end - start;
        int n = 0;
        for (; n < len && n < 6 && (sp[start + n] & 255) == 35; n = n + 1) { }
        if (n > 0 && n < len && (sp[start + n] & 255) == 32) { return n; }
        return 0;
    }

    // 切片版块级引用判定。
    private static bool IsQuoteSlice(Span<byte> sp, int start, int end) {
        return start < end && (sp[start] & 255) == 62;
    }

    // 切片版列表行类别（0/1/2）。
    private static int ListKindSlice(Span<byte> sp, int start, int end) {
        int len = end - start;
        if (len >= 2) {
            int c0 = sp[start] & 255;
            if ((c0 == 45 || c0 == 42 || c0 == 43) && (sp[start + 1] & 255) == 32) { return 1; }
        }
        int at = 0;
        for (; at < len; at = at + 1) {
            int c = sp[start + at] & 255;
            if (c < 48 || c > 57) { break; }
        }
        if (at > 0 && at + 1 < len && (sp[start + at] & 255) == 46 && (sp[start + at + 1] & 255) == 32) { return 2; }
        return 0;
    }

    // 切片版列表正文相对偏移。
    private static int ListBodySlice(Span<byte> sp, int start, int end, int kind) {
        if (kind == 1) { return start + 2; }
        int at = start;
        for (; at < end; at = at + 1) {
            int c = sp[at] & 255;
            if (c < 48 || c > 57) { break; }
        }
        return at + 2;
    }

    // 切片版新块起始判定。
    private static bool IsBlockStartSlice(Span<byte> sp, int start, int end) {
        return Markdown.IsFenceSlice(sp, start, end) || Markdown.HeadingLevelSlice(sp, start, end) > 0 ||
            Markdown.ListKindSlice(sp, start, end) != 0 || Markdown.IsQuoteSlice(sp, start, end);
    }

    // 切片版安全 URL 判定（零 Substring/ToLower 分配）。
    private static bool SafeUrlSlice(Span<byte> sp, int start, int end) {
        int colon = -1;
        bool relative = false;
        for (int i = start; i < end; i = i + 1) {
            int c = sp[i] & 255;
            if (c <= 31 || c == 127) { return false; }
            if (!relative && c == 58 && colon < 0) { colon = i; }
            if (c == 47 || c == 63 || c == 35) { relative = true; }
        }
        if (colon < 0) { return true; }
        int slen = colon - start;
        if (slen == 4) {
            return ((sp[start] & 255) | 32) == 104
                && ((sp[start + 1] & 255) | 32) == 116
                && ((sp[start + 2] & 255) | 32) == 116
                && ((sp[start + 3] & 255) | 32) == 112;
        }
        if (slen == 5) {
            return ((sp[start] & 255) | 32) == 104
                && ((sp[start + 1] & 255) | 32) == 116
                && ((sp[start + 2] & 255) | 32) == 116
                && ((sp[start + 3] & 255) | 32) == 112
                && ((sp[start + 4] & 255) | 32) == 115;
        }
        if (slen == 6) {
            return ((sp[start] & 255) | 32) == 109
                && ((sp[start + 1] & 255) | 32) == 97
                && ((sp[start + 2] & 255) | 32) == 105
                && ((sp[start + 3] & 255) | 32) == 108
                && ((sp[start + 4] & 255) | 32) == 116
                && ((sp[start + 5] & 255) | 32) == 111;
        }
        return false;
    }

    // 流式按 CR/CRLF/LF 步进下一行切片（语义与 Lines() 逐行一致，包括尾换行后的空行；无 CR 时走 memchr 快路径）。
    private static bool NextLine(Span<byte> sp, nint tp, int len, bool hasCr, ref int pos, out int lineStart, out int lineEnd) {
        if (pos > len) {
            lineStart = len;
            lineEnd = len;
            return false;
        }
        int p = pos;
        lineStart = p;
        if (!hasCr) {
            int nl = p < len ? NativeMemory.Find(tp, p, 10, len - p) : -1;
            if (nl < 0) {
                lineEnd = len;
                pos = len + 1;
            } else {
                lineEnd = nl;
                pos = nl + 1;
            }
            return true;
        }
        while (p < len) {
            int c = sp[p] & 255;
            if (c == 10 || c == 13) { break; }
            p = p + 1;
        }
        lineEnd = p;
        if (p == len) {
            pos = len + 1;
        } else if ((sp[p] & 255) == 13) {
            pos = (p + 1 < len && (sp[p + 1] & 255) == 10) ? (p + 2) : (p + 1);
        } else {
            pos = p + 1;
        }
        return true;
    }

    // 流式 HTML 转义切片 [start, end) 直接写入原生 StringBuilder（Span<byte> + StringView 零中间分配）。
    private static void AppendEscapedSlice(StringBuilder sb, Span<byte> sp, nint tp, int start, int end) {
        if (start >= end) { return; }
        int last = start;
        for (int i = start; i < end; i = i + 1) {
            int c = sp[i] & 255;
            if (c > 62) { continue; }
            string esc = null;
            if (c == 38) { esc = "&amp;"; }
            else if (c == 60) { esc = "&lt;"; }
            else if (c == 62) { esc = "&gt;"; }
            else if (c == 34) { esc = "&quot;"; }
            else if (c == 39) { esc = "&#39;"; }
            if (esc != null) {
                if (i > last) { sb.Append(new StringView(tp + (nint)last, i - last)); }
                sb.Append(esc);
                last = i + 1;
            }
        }
        if (last < end) { sb.Append(new StringView(tp + (nint)last, end - last)); }
    }

    // 在 [from, end) 内查找单字节 target，找不到返回 -1。
    private static int FindByteInRange(nint tp, int from, int end, int target) {
        int rem = end - from;
        if (rem <= 0) { return -1; }
        return NativeMemory.Find(tp, from, target, rem);
    }

    // 在 [from, end) 内查找双同字节 (ch, ch)，找不到返回 -1。
    private static int FindDoubleByteInRange(Span<byte> sp, nint tp, int from, int end, int ch) {
        int p = from;
        while (p + 1 < end) {
            int hit = NativeMemory.Find(tp, p, ch, end - 1 - p);
            if (hit < 0) { return -1; }
            if ((sp[hit + 1] & 255) == ch) { return hit; }
            p = hit + 1;
        }
        return -1;
    }

    // 单遍融合行内解析 + HTML 转义切片 [start, end) 直接写入原生 StringBuilder。
    private static void AppendInlineSlice(StringBuilder html, Span<byte> sp, nint tp, int start, int end, int depth) {
        if (start >= end) { return; }
        if (depth < 0 || depth >= 32) {
            Markdown.AppendEscapedSlice(html, sp, tp, start, end);
            return;
        }
        int plainStart = start;
        int i = start;
        // 单调失败记忆：某闭合符已扫至 end 未命中时不再重复线性扫，消除 O(N^2) DoS。
        bool noDoubleStar = false;
        bool noSingleStar = false;
        bool noBacktick = false;
        bool noDoubleUnder = false;
        bool noSingleUnder = false;
        bool noCloseBracket = false;
        int noCloseParenFrom = end + 1;
        while (i < end) {
            int c = sp[i] & 255;
            if (c > 96) {
                i = i + 1;
                continue;
            }
            if (c <= 62) {
                if (c == 42) {
                    if (i + 1 < end && (sp[i + 1] & 255) == 42) {
                        int close = noDoubleStar ? -1 : Markdown.FindDoubleByteInRange(sp, tp, i + 2, end, 42);
                        if (close > i + 2) {
                            if (i > plainStart) { html.Append(new StringView(tp + (nint)plainStart, i - plainStart)); }
                            html.Append("<strong>");
                            Markdown.AppendInlineSlice(html, sp, tp, i + 2, close, depth + 1);
                            html.Append("</strong>");
                            i = close + 2;
                            plainStart = i;
                        } else {
                            if (close < 0) { noDoubleStar = true; }
                            i = i + 2;
                        }
                    } else {
                        int close = noSingleStar ? -1 : Markdown.FindByteInRange(tp, i + 1, end, 42);
                        if (close > i + 1) {
                            if (i > plainStart) { html.Append(new StringView(tp + (nint)plainStart, i - plainStart)); }
                            html.Append("<em>");
                            Markdown.AppendInlineSlice(html, sp, tp, i + 1, close, depth + 1);
                            html.Append("</em>");
                            i = close + 1;
                            plainStart = i;
                        } else {
                            if (close < 0) { noSingleStar = true; }
                            i = i + 1;
                        }
                    }
                    continue;
                }
                string esc = null;
                if (c == 38) { esc = "&amp;"; }
                else if (c == 60) { esc = "&lt;"; }
                else if (c == 62) { esc = "&gt;"; }
                else if (c == 34) { esc = "&quot;"; }
                else if (c == 39) { esc = "&#39;"; }
                if (esc != null) {
                    if (i > plainStart) { html.Append(new StringView(tp + (nint)plainStart, i - plainStart)); }
                    html.Append(esc);
                    i = i + 1;
                    plainStart = i;
                    continue;
                }
                i = i + 1;
                continue;
            }
            if (c == 92 && i + 1 < end) {
                if (i > plainStart) { html.Append(new StringView(tp + (nint)plainStart, i - plainStart)); }
                int nc = sp[i + 1] & 255;
                if (nc == 38) { html.Append("&amp;"); i = i + 2; plainStart = i; }
                else if (nc == 60) { html.Append("&lt;"); i = i + 2; plainStart = i; }
                else if (nc == 62) { html.Append("&gt;"); i = i + 2; plainStart = i; }
                else if (nc == 34) { html.Append("&quot;"); i = i + 2; plainStart = i; }
                else if (nc == 39) { html.Append("&#39;"); i = i + 2; plainStart = i; }
                else { plainStart = i + 1; i = i + 2; }
            } else if (c == 96) {
                int close = noBacktick ? -1 : Markdown.FindByteInRange(tp, i + 1, end, 96);
                if (close >= 0) {
                    if (i > plainStart) { html.Append(new StringView(tp + (nint)plainStart, i - plainStart)); }
                    html.Append("<code>");
                    Markdown.AppendEscapedSlice(html, sp, tp, i + 1, close);
                    html.Append("</code>");
                    i = close + 1;
                    plainStart = i;
                } else {
                    noBacktick = true;
                    i = i + 1;
                }
            } else if (c == 95) {
                if (i + 1 < end && (sp[i + 1] & 255) == 95) {
                    int close = noDoubleUnder ? -1 : Markdown.FindDoubleByteInRange(sp, tp, i + 2, end, 95);
                    if (close > i + 2) {
                        if (i > plainStart) { html.Append(new StringView(tp + (nint)plainStart, i - plainStart)); }
                        html.Append("<strong>");
                        Markdown.AppendInlineSlice(html, sp, tp, i + 2, close, depth + 1);
                        html.Append("</strong>");
                        i = close + 2;
                        plainStart = i;
                    } else {
                        if (close < 0) { noDoubleUnder = true; }
                        i = i + 2;
                    }
                } else {
                    int close = noSingleUnder ? -1 : Markdown.FindByteInRange(tp, i + 1, end, 95);
                    if (close > i + 1) {
                        if (i > plainStart) { html.Append(new StringView(tp + (nint)plainStart, i - plainStart)); }
                        html.Append("<em>");
                        Markdown.AppendInlineSlice(html, sp, tp, i + 1, close, depth + 1);
                        html.Append("</em>");
                        i = close + 1;
                        plainStart = i;
                    } else {
                        if (close < 0) { noSingleUnder = true; }
                        i = i + 1;
                    }
                }
            } else if (c == 91) {
                int labelEnd = noCloseBracket ? -1 : Markdown.FindByteInRange(tp, i + 1, end, 93);
                if (labelEnd < 0) { noCloseBracket = true; }
                int urlEnd = -1;
                if (labelEnd >= 0 && labelEnd + 1 < end && (sp[labelEnd + 1] & 255) == 40) {
                    int uFrom = labelEnd + 2;
                    if (uFrom < noCloseParenFrom) {
                        urlEnd = Markdown.FindByteInRange(tp, uFrom, end, 41);
                        if (urlEnd < 0) { noCloseParenFrom = uFrom; }
                    }
                }
                if (labelEnd >= 0 && urlEnd >= 0) {
                    if (i > plainStart) { html.Append(new StringView(tp + (nint)plainStart, i - plainStart)); }
                    int us = labelEnd + 2;
                    int ue = urlEnd;
                    while (us < ue) {
                        int uc = sp[us] & 255;
                        if (uc != 32 && uc != 9 && uc != 13 && uc != 10) { break; }
                        us = us + 1;
                    }
                    while (ue > us) {
                        int uc = sp[ue - 1] & 255;
                        if (uc != 32 && uc != 9 && uc != 13 && uc != 10) { break; }
                        ue = ue - 1;
                    }
                    if (Markdown.SafeUrlSlice(sp, us, ue)) {
                        html.Append("<a href=\"");
                        Markdown.AppendEscapedSlice(html, sp, tp, us, ue);
                        html.Append("\">");
                        Markdown.AppendInlineSlice(html, sp, tp, i + 1, labelEnd, depth + 1);
                        html.Append("</a>");
                    } else {
                        Markdown.AppendInlineSlice(html, sp, tp, i + 1, labelEnd, depth + 1);
                    }
                    i = urlEnd + 1;
                    plainStart = i;
                } else {
                    i = i + 1;
                }
            } else {
                i = i + 1;
            }
        }
        if (plainStart < end) {
            html.Append(new StringView(tp + (nint)plainStart, end - plainStart));
        }
    }

    // 将受支持的 Markdown 语法渲染为紧凑的转义 HTML（零 Lines 拆分 + 首字节快分发 + 原生 StringBuilder）。
    public static string ToHtml(string text) {
        if (text == null || text.Length == 0) { return ""; }
        int len = text.Length;
        nint tp = (nint)text;
        Span<byte> sp = new Span<byte>(tp, len);
        bool hasCr = NativeMemory.Find(tp, 0, 13, len) >= 0;
        StringBuilder html = new StringBuilder(len + (len >> 1) + 64);
        int pos = 0;
        int ls = 0;
        int le = 0;
        bool hasLine = Markdown.NextLine(sp, tp, len, hasCr, ref pos, out ls, out le);
        bool first = true;
        while (hasLine) {
            if (ls >= le) {
                hasLine = Markdown.NextLine(sp, tp, len, hasCr, ref pos, out ls, out le);
                continue;
            }
            int c0 = sp[ls] & 255;
            if ((c0 == 32 || c0 == 9 || c0 == 13 || c0 == 10) && Markdown.IsBlankSlice(sp, ls, le)) {
                hasLine = Markdown.NextLine(sp, tp, len, hasCr, ref pos, out ls, out le);
                continue;
            }

            if (c0 == 96 && Markdown.IsFenceSlice(sp, ls, le)) {
                if (!first) { html.Append("\n"); }
                first = false;
                html.Append("<pre><code>");
                hasLine = Markdown.NextLine(sp, tp, len, hasCr, ref pos, out ls, out le);
                bool codeFirst = true;
                while (hasLine && !(ls + 3 <= le && (sp[ls] & 255) == 96 && Markdown.IsFenceSlice(sp, ls, le))) {
                    if (!codeFirst) { html.Append("\n"); }
                    Markdown.AppendEscapedSlice(html, sp, tp, ls, le);
                    codeFirst = false;
                    hasLine = Markdown.NextLine(sp, tp, len, hasCr, ref pos, out ls, out le);
                }
                if (hasLine) {
                    hasLine = Markdown.NextLine(sp, tp, len, hasCr, ref pos, out ls, out le);
                }
                html.Append("</code></pre>");
                continue;
            }

            if (c0 == 35) {
                int heading = Markdown.HeadingLevelSlice(sp, ls, le);
                if (heading > 0) {
                    if (!first) { html.Append("\n"); }
                    first = false;
                    string openH = heading == 1 ? "<h1>" : (heading == 2 ? "<h2>" : (heading == 3 ? "<h3>" : (heading == 4 ? "<h4>" : (heading == 5 ? "<h5>" : "<h6>"))));
                    string closeH = heading == 1 ? "</h1>" : (heading == 2 ? "</h2>" : (heading == 3 ? "</h3>" : (heading == 4 ? "</h4>" : (heading == 5 ? "</h5>" : "</h6>"))));
                    html.Append(openH);
                    Markdown.AppendInlineSlice(html, sp, tp, ls + heading + 1, le, 0);
                    html.Append(closeH);
                    hasLine = Markdown.NextLine(sp, tp, len, hasCr, ref pos, out ls, out le);
                    continue;
                }
            }

            if (c0 == 45 || c0 == 42 || c0 == 43 || (c0 >= 48 && c0 <= 57)) {
                int listKind = Markdown.ListKindSlice(sp, ls, le);
                if (listKind != 0) {
                    if (!first) { html.Append("\n"); }
                    first = false;
                    html.Append(listKind == 2 ? "<ol>" : "<ul>");
                    while (hasLine && Markdown.ListKindSlice(sp, ls, le) == listKind) {
                        int at = Markdown.ListBodySlice(sp, ls, le, listKind);
                        html.Append("<li>");
                        Markdown.AppendInlineSlice(html, sp, tp, at, le, 0);
                        html.Append("</li>");
                        hasLine = Markdown.NextLine(sp, tp, len, hasCr, ref pos, out ls, out le);
                    }
                    html.Append(listKind == 2 ? "</ol>" : "</ul>");
                    continue;
                }
            }

            if (c0 == 62) {
                if (!first) { html.Append("\n"); }
                first = false;
                html.Append("<blockquote><p>");
                bool quoteFirst = true;
                while (hasLine && ls < le && (sp[ls] & 255) == 62) {
                    if (!quoteFirst) { html.Append(" "); }
                    int at = (le - ls > 1 && (sp[ls + 1] & 255) == 32) ? (ls + 2) : (ls + 1);
                    Markdown.AppendInlineSlice(html, sp, tp, at, le, 0);
                    quoteFirst = false;
                    hasLine = Markdown.NextLine(sp, tp, len, hasCr, ref pos, out ls, out le);
                }
                html.Append("</p></blockquote>");
                continue;
            }

            if (!first) { html.Append("\n"); }
            first = false;
            html.Append("<p>");
            bool paraFirst = true;
            while (hasLine) {
                if (ls >= le) { break; }
                int pc0 = sp[ls] & 255;
                if ((pc0 == 32 || pc0 == 9 || pc0 == 13 || pc0 == 10) && Markdown.IsBlankSlice(sp, ls, le)) { break; }
                if ((pc0 == 96 || pc0 == 35 || pc0 == 62 || pc0 == 45 || pc0 == 42 || pc0 == 43 || (pc0 >= 48 && pc0 <= 57))
                    && Markdown.IsBlockStartSlice(sp, ls, le)) { break; }
                if (!paraFirst) { html.Append(" "); }
                Markdown.AppendInlineSlice(html, sp, tp, ls, le, 0);
                paraFirst = false;
                hasLine = Markdown.NextLine(sp, tp, len, hasCr, ref pos, out ls, out le);
            }
            html.Append("</p>");
        }
        return html.ToString();
    }

    // 追加一个块级元素；非首块前置 "\n"。返回后续调用的
    // first 值（恒 false）。
    public static bool Block(StringBuilder html, bool first, string block) {
        if (html == null) { return false; }
        if (!first) { html.Append("\n"); }
        if (block != null) { html.Append(block); }
        return false;
    }

    // 行内语法（代码/粗体/斜体/链接/转义）渲染入口。
    public static string Inline(string text) {
        return Markdown.InlineAt(text, 0);
    }

    // Inline 的递归实现：`depth` 限制嵌套层数，超限时整段只做
    // HTML 转义。未闭合的定界符按字面输出。
    public static string InlineAt(string text, int depth) {
        if (text == null || text.Length == 0) { return ""; }
        if (depth < 0 || depth >= 32) { return Markdown.EscapeHtml(text); }
        int len = text.Length;
        nint tp = (nint)text;
        Span<byte> sp = new Span<byte>(tp, len);
        StringBuilder html = new StringBuilder(len + 32);
        Markdown.AppendInlineSlice(html, sp, tp, 0, len, depth);
        return html.ToString();
    }

    // 链接 URL 是否可生成锚点：相对路径，或 http/https/mailto
    // 协议，且不含 ASCII 控制字符。
    public static bool SafeUrl(string url) {
        if (url == null) { return false; }
        int len = url.Length;
        Span<byte> sp = new Span<byte>((nint)url, len);
        return Markdown.SafeUrlSlice(sp, 0, len);
    }

    // HTML 转义：&lt; &gt; &amp; &quot; &#39;（Span<byte> + StringView 零中间切片分配）。
    public static string EscapeHtml(string text) {
        if (text == null) { return ""; }
        int len = text.Length;
        int last = 0;
        StringBuilder html = null;
        nint tp = (nint)text;
        Span<byte> sp = new Span<byte>(tp, len);
        for (int i = 0; i < len; i = i + 1) {
            int c = sp[i] & 255;
            if (c > 62) { continue; }
            string esc = null;
            if (c == 38) { esc = "&amp;"; }
            else if (c == 60) { esc = "&lt;"; }
            else if (c == 62) { esc = "&gt;"; }
            else if (c == 34) { esc = "&quot;"; }
            else if (c == 39) { esc = "&#39;"; }
            if (esc != null) {
                if (html == null) { html = new StringBuilder(len + 16); }
                if (i > last) { html.Append(new StringView(tp + (nint)last, i - last)); }
                html.Append(esc);
                last = i + 1;
            }
        }
        if (html == null) { return text; }
        if (last < len) { html.Append(new StringView(tp + (nint)last, len - last)); }
        return html.ToString();
    }

    // 该行是否开始一个新块（围栏代码/标题/列表/引用），
    // 段落累积据此停止。
    public static bool IsBlockStart(string line) {
        return Markdown.StartsWith(line, "```") || Markdown.HeadingLevel(line) > 0 ||
            Markdown.ListKind(line) != 0 || Markdown.IsQuote(line);
    }

    // ATX 标题级别（1-6，"#" 后须有空格）；非标题返回 0。
    public static int HeadingLevel(string line) {
        if (line == null) { return 0; }
        int len = line.Length;
        int n = 0;
        for (; n < len && n < 6 && (line[n] & 255) == 35; n = n + 1) { }
        if (n > 0 && n < len && (line[n] & 255) == 32) { return n; }
        return 0;
    }

    // 该行是否为块级引用（以 ">" 开头）。
    public static bool IsQuote(string line) {
        return line != null && line.Length > 0 && (line[0] & 255) == 62;
    }

    // 列表行类别：1 无序（"- "/"* "/"+ "），2 有序（"N. "），
    // 非列表行返回 0。
    public static int ListKind(string line) {
        if (line == null) { return 0; }
        int len = line.Length;
        if (len >= 2) {
            int c0 = line[0] & 255;
            if ((c0 == 45 || c0 == 42 || c0 == 43) && (line[1] & 255) == 32) { return 1; }
        }
        int at = 0;
        for (; at < len; at = at + 1) {
            int c = line[at] & 255;
            if (c < 48 || c > 57) { break; }
        }
        if (at > 0 && at + 1 < len && (line[at] & 255) == 46 && (line[at + 1] & 255) == 32) { return 2; }
        return 0;
    }

    // 列表行中项正文（"<li>" 内容）的起始下标。
    public static int ListBody(string line, int kind) {
        if (kind == 1) { return 2; }
        if (line == null) { return 0; }
        int len = line.Length;
        int at = 0;
        for (; at < len; at = at + 1) {
            int c = line[at] & 255;
            if (c < 48 || c > 57) { break; }
        }
        return at + 2;
    }

    // 按 CR/CRLF/LF 把文本切成行；结尾无换行也补最后一行。
    public static List<string> Lines(string text) {
        List<string> lines = new List<string>();
        if (text == null) { return lines; }
        int len = text.Length;
        int start = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = text[i] & 255;
            if (c == 13) {
                lines.Add(text.Substring(start, i - start));
                if (i + 1 < len && (text[i + 1] & 255) == 10) { i = i + 1; }
                start = i + 1;
            } else if (c == 10) {
                lines.Add(text.Substring(start, i - start));
                start = i + 1;
            }
        }
        if (start <= len) {
            lines.Add(text.Substring(start, len - start));
        }
        return lines;
    }

    // 去除两端空白（空格、制表、换行）。
    public static string Trim(string text) {
        if (text == null) { return ""; }
        return text.Trim();
    }

    // 字符是否为空白（空格/制表/CR/LF）。
    public static bool IsSpace(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        int c = ch[0] & 255;
        return c == 32 || c == 9 || c == 13 || c == 10;
    }

    // 前缀匹配。
    public static bool StartsWith(string text, string prefix) {
        if (text == null || prefix == null) { return false; }
        return text.StartsWith(prefix);
    }

    // 从 from 起查找子串，找不到返回 -1。
    public static int Find(string text, string needle, int from) {
        if (text == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > text.Length) { return -1; }
        return text.IndexOf(needle, from);
    }
}
