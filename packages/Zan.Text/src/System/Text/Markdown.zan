using System;

namespace System.Text;

// 面向应用文本的小型确定性 Markdown 转 HTML 渲染器。
// <c>Markdown.ToHtml(text)</c> 支持 ATX 标题、段落、块级
// 引用、有序和无序列表、三反引号围栏代码、行内
// 代码、斜体、粗体、链接及反斜杠转义。输出
// 紧凑：块级元素以换行分隔，段落的软换行
// 变为空格。
// 刻意不兼容 CommonMark：块不嵌套，列表项和
// 引用各占一行源码，围栏信息字符串被忽略，行内
// 定界符取第一个匹配的闭合符。未闭合的定界符原样输出，
// 未闭合的围栏把剩余输入当作代码。
// 源文本、代码、标签和链接属性均做 HTML 转义。链接 URL
// 必须是相对路径，或使用 <c>http</c>、<c>https</c>、<c>mailto</c>
// 协议；含 ASCII 控制字符的 URL 只渲染为标签文本，
// 不生成锚点链接。
public class Markdown {
    // 零分配判定一行是否全空白（替代 Trim(line) == ""）。
    private static bool IsBlankLine(string line) {
        if (line == null) { return true; }
        int n = line.Length;
        for (int i = 0; i < n; i = i + 1) {
            int c = line[i] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { return false; }
        }
        return true;
    }

    // 零分配判定是否以 "```" 开头。
    private static bool IsFenceLine(string line) {
        return line != null && line.Length >= 3 &&
            (line[0] & 255) == 96 && (line[1] & 255) == 96 && (line[2] & 255) == 96;
    }

    // 流式 HTML 转义切片 [start, end) 直接写入目标 StringBuilder（StringView 零中间分配）。
    private static void AppendEscapedSlice(StringBuilder sb, string text, int start, int end) {
        if (text == null || start >= end) { return; }
        nint tp = (nint)text;
        int last = start;
        for (int i = start; i < end; i = i + 1) {
            int c = text[i] & 255;
            string esc = null;
            if (c == 38) { esc = "&amp;"; }
            else if (c == 60) { esc = "&lt;"; }
            else if (c == 62) { esc = "&gt;"; }
            else if (c == 34) { esc = "&quot;"; }
            else if (c == 39) { esc = "&#39;"; }
            if (esc != null) {
                if (i > last) { sb.Append(new StringView(tp + (nint)last, i - last)); }
                sb.Append(esc);
                last = i + 1;
            }
        }
        if (last < end) { sb.Append(new StringView(tp + (nint)last, end - last)); }
    }

    // 在 [from, end) 内查找单字节 target，找不到返回 -1。
    private static int FindByteInRange(nint tp, int from, int end, int target) {
        int rem = end - from;
        if (rem <= 0) { return -1; }
        return NativeMemory.Find(tp, from, target, rem);
    }

    // 在 [from, end) 内查找双同字节 (ch, ch)，找不到返回 -1。
    private static int FindDoubleByteInRange(string text, nint tp, int from, int end, int ch) {
        int p = from;
        while (p + 1 < end) {
            int hit = NativeMemory.Find(tp, p, ch, end - 1 - p);
            if (hit < 0) { return -1; }
            if ((text[hit + 1] & 255) == ch) { return hit; }
            p = hit + 1;
        }
        return -1;
    }

    // 流式行内渲染切片 [start, end) 直接写入目标 StringBuilder。
    private static void AppendInlineSlice(StringBuilder html, string text, int start, int end, int depth) {
        if (text == null || start >= end) { return; }
        if (depth >= 32) {
            Markdown.AppendEscapedSlice(html, text, start, end);
            return;
        }
        nint tp = (nint)text;
        int i = start;
        while (i < end) {
            int c = text[i] & 255;
            if (c == 92 && i + 1 < end) {
                int nc = text[i + 1] & 255;
                if (nc == 38) { html.Append("&amp;"); }
                else if (nc == 60) { html.Append("&lt;"); }
                else if (nc == 62) { html.Append("&gt;"); }
                else if (nc == 34) { html.Append("&quot;"); }
                else if (nc == 39) { html.Append("&#39;"); }
                else { html.Append(new StringView(tp + (nint)(i + 1), 1)); }
                i = i + 2;
            } else if (c == 96) {
                int close = Markdown.FindByteInRange(tp, i + 1, end, 96);
                if (close >= 0) {
                    html.Append("<code>");
                    Markdown.AppendEscapedSlice(html, text, i + 1, close);
                    html.Append("</code>");
                    i = close + 1;
                } else {
                    html.Append("`"); i = i + 1;
                }
            } else if ((c == 42 || c == 95) && i + 1 < end && (text[i + 1] & 255) == c) {
                int close = Markdown.FindDoubleByteInRange(text, tp, i + 2, end, c);
                if (close > i + 2) {
                    html.Append("<strong>");
                    Markdown.AppendInlineSlice(html, text, i + 2, close, depth + 1);
                    html.Append("</strong>");
                    i = close + 2;
                } else {
                    html.Append(c == 42 ? "**" : "__"); i = i + 2;
                }
            } else if (c == 42 || c == 95) {
                int close = Markdown.FindByteInRange(tp, i + 1, end, c);
                if (close > i + 1) {
                    html.Append("<em>");
                    Markdown.AppendInlineSlice(html, text, i + 1, close, depth + 1);
                    html.Append("</em>");
                    i = close + 1;
                } else {
                    html.Append(c == 42 ? "*" : "_"); i = i + 1;
                }
            } else if (c == 91) {
                int labelEnd = Markdown.FindByteInRange(tp, i + 1, end, 93);
                int urlEnd = -1;
                if (labelEnd >= 0 && labelEnd + 1 < end && (text[labelEnd + 1] & 255) == 40) {
                    urlEnd = Markdown.FindByteInRange(tp, labelEnd + 2, end, 41);
                }
                if (labelEnd >= 0 && urlEnd >= 0) {
                    int us = labelEnd + 2;
                    int ue = urlEnd;
                    while (us < ue) {
                        int uc = text[us] & 255;
                        if (uc != 32 && uc != 9 && uc != 13 && uc != 10) { break; }
                        us = us + 1;
                    }
                    while (ue > us) {
                        int uc = text[ue - 1] & 255;
                        if (uc != 32 && uc != 9 && uc != 13 && uc != 10) { break; }
                        ue = ue - 1;
                    }
                    string url = text.Substring(us, ue - us);
                    if (Markdown.SafeUrl(url)) {
                        html.Append("<a href=\"");
                        Markdown.AppendEscapedSlice(html, url, 0, url.Length);
                        html.Append("\">");
                        Markdown.AppendInlineSlice(html, text, i + 1, labelEnd, depth + 1);
                        html.Append("</a>");
                    } else {
                        Markdown.AppendInlineSlice(html, text, i + 1, labelEnd, depth + 1);
                    }
                    i = urlEnd + 1;
                } else {
                    html.Append("["); i = i + 1;
                }
            } else {
                int run = i + 1;
                while (run < end) {
                    int rc = text[run] & 255;
                    if (rc == 92 || rc == 96 || rc == 42 || rc == 95 || rc == 91) { break; }
                    run = run + 1;
                }
                Markdown.AppendEscapedSlice(html, text, i, run);
                i = run;
            }
        }
    }

    // 将受支持的 Markdown 语法渲染为紧凑的转义 HTML（全程单 StringBuilder 流式写出）。
    public static string ToHtml(string text) {
        if (text == null || text.Length == 0) { return ""; }
        List<string> lines = Markdown.Lines(text);
        int lineCount = lines.Count;
        StringBuilder html = new StringBuilder(text.Length + 64);
        int i = 0;
        bool first = true;
        while (i < lineCount) {
            string line = lines[i];
            if (Markdown.IsBlankLine(line)) { i = i + 1; continue; }

            if (Markdown.IsFenceLine(line)) {
                if (!first) { html.Append("\n"); }
                first = false;
                html.Append("<pre><code>");
                i = i + 1;
                bool codeFirst = true;
                while (i < lineCount && !Markdown.IsFenceLine(lines[i])) {
                    if (!codeFirst) { html.Append("\n"); }
                    string cl = lines[i];
                    Markdown.AppendEscapedSlice(html, cl, 0, cl.Length);
                    codeFirst = false;
                    i = i + 1;
                }
                if (i < lineCount) { i = i + 1; }
                html.Append("</code></pre>");
                continue;
            }

            int heading = Markdown.HeadingLevel(line);
            if (heading > 0) {
                if (!first) { html.Append("\n"); }
                first = false;
                string openH = heading == 1 ? "<h1>" : (heading == 2 ? "<h2>" : (heading == 3 ? "<h3>" : (heading == 4 ? "<h4>" : (heading == 5 ? "<h5>" : "<h6>"))));
                string closeH = heading == 1 ? "</h1>" : (heading == 2 ? "</h2>" : (heading == 3 ? "</h3>" : (heading == 4 ? "</h4>" : (heading == 5 ? "</h5>" : "</h6>"))));
                html.Append(openH);
                Markdown.AppendInlineSlice(html, line, heading + 1, line.Length, 0);
                html.Append(closeH);
                i = i + 1;
                continue;
            }

            int listKind = Markdown.ListKind(line);
            if (listKind != 0) {
                if (!first) { html.Append("\n"); }
                first = false;
                html.Append(listKind == 2 ? "<ol>" : "<ul>");
                while (i < lineCount && Markdown.ListKind(lines[i]) == listKind) {
                    string li = lines[i];
                    int at = Markdown.ListBody(li, listKind);
                    html.Append("<li>");
                    Markdown.AppendInlineSlice(html, li, at, li.Length, 0);
                    html.Append("</li>");
                    i = i + 1;
                }
                html.Append(listKind == 2 ? "</ol>" : "</ul>");
                continue;
            }

            if (Markdown.IsQuote(line)) {
                if (!first) { html.Append("\n"); }
                first = false;
                html.Append("<blockquote><p>");
                bool quoteFirst = true;
                while (i < lineCount && Markdown.IsQuote(lines[i])) {
                    if (!quoteFirst) { html.Append(" "); }
                    string ql = lines[i];
                    int at = (ql.Length > 1 && (ql[1] & 255) == 32) ? 2 : 1;
                    Markdown.AppendInlineSlice(html, ql, at, ql.Length, 0);
                    quoteFirst = false;
                    i = i + 1;
                }
                html.Append("</p></blockquote>");
                continue;
            }

            if (!first) { html.Append("\n"); }
            first = false;
            html.Append("<p>");
            bool paraFirst = true;
            while (i < lineCount && !Markdown.IsBlankLine(lines[i]) && !Markdown.IsBlockStart(lines[i])) {
                if (!paraFirst) { html.Append(" "); }
                string pl = lines[i];
                Markdown.AppendInlineSlice(html, pl, 0, pl.Length, 0);
                paraFirst = false;
                i = i + 1;
            }
            html.Append("</p>");
        }
        return html.ToString();
    }

    // 追加一个块级元素；非首块前置 "\n"。返回后续调用的
    // first 值（恒 false）。
    public static bool Block(StringBuilder html, bool first, string block) {
        if (!first) { html.Append("\n"); }
        html.Append(block);
        return false;
    }

    // 行内语法（代码/粗体/斜体/链接/转义）渲染入口。
    public static string Inline(string text) {
        return Markdown.InlineAt(text, 0);
    }

    // Inline 的递归实现：`depth` 限制嵌套层数，超限时整段只做
    // HTML 转义。未闭合的定界符按字面输出。
    public static string InlineAt(string text, int depth) {
        if (text == null || text.Length == 0) { return ""; }
        if (depth >= 32) { return Markdown.EscapeHtml(text); }
        StringBuilder html = new StringBuilder(text.Length + 16);
        Markdown.AppendInlineSlice(html, text, 0, text.Length, depth);
        return html.ToString();
    }

    // 链接 URL 是否可生成锚点：相对路径，或 http/https/mailto
    // 协议，且不含 ASCII 控制字符。
    public static bool SafeUrl(string url) {
        if (url == null) { return false; }
        int colon = -1;
        bool relative = false;
        int len = url.Length;
        for (int i = 0; i < len; i = i + 1) {
            int c = url[i] & 255;
            if (c <= 31 || c == 127) { return false; }
            if (!relative && c == 58 && colon < 0) { colon = i; }
            if (c == 47 || c == 63 || c == 35) { relative = true; }
        }
        if (colon < 0) { return true; }
        string scheme = url.Substring(0, colon).ToLower();
        return scheme == "http" || scheme == "https" || scheme == "mailto";
    }

    // HTML 转义：&lt; &gt; &amp; &quot; &#39;（StringView 零中间切片分配）。
    public static string EscapeHtml(string text) {
        if (text == null) { return ""; }
        int len = text.Length;
        int last = 0;
        StringBuilder html = null;
        nint tp = (nint)text;
        for (int i = 0; i < len; i = i + 1) {
            int c = text[i] & 255;
            string esc = null;
            if (c == 38) { esc = "&amp;"; }
            else if (c == 60) { esc = "&lt;"; }
            else if (c == 62) { esc = "&gt;"; }
            else if (c == 34) { esc = "&quot;"; }
            else if (c == 39) { esc = "&#39;"; }
            if (esc != null) {
                if (html == null) { html = new StringBuilder(len + 16); }
                if (i > last) { html.Append(new StringView(tp + (nint)last, i - last)); }
                html.Append(esc);
                last = i + 1;
            }
        }
        if (html == null) { return text; }
        if (last < len) { html.Append(new StringView(tp + (nint)last, len - last)); }
        return html.ToString();
    }

    // 该行是否开始一个新块（围栏代码/标题/列表/引用），
    // 段落累积据此停止。
    public static bool IsBlockStart(string line) {
        return Markdown.StartsWith(line, "```") || Markdown.HeadingLevel(line) > 0 ||
            Markdown.ListKind(line) != 0 || Markdown.IsQuote(line);
    }

    // ATX 标题级别（1-6，"#" 后须有空格）；非标题返回 0。
    public static int HeadingLevel(string line) {
        if (line == null) { return 0; }
        int len = line.Length;
        int n = 0;
        for (; n < len && n < 6 && (line[n] & 255) == 35; n = n + 1) { }
        if (n > 0 && n < len && (line[n] & 255) == 32) { return n; }
        return 0;
    }

    // 该行是否为块级引用（以 ">" 开头）。
    public static bool IsQuote(string line) {
        return line != null && line.Length > 0 && (line[0] & 255) == 62;
    }

    // 列表行类别：1 无序（"- "/"* "/"+ "），2 有序（"N. "），
    // 非列表行返回 0。
    public static int ListKind(string line) {
        if (line == null) { return 0; }
        int len = line.Length;
        if (len >= 2) {
            int c0 = line[0] & 255;
            if ((c0 == 45 || c0 == 42 || c0 == 43) && (line[1] & 255) == 32) { return 1; }
        }
        int at = 0;
        for (; at < len; at = at + 1) {
            int c = line[at] & 255;
            if (c < 48 || c > 57) { break; }
        }
        if (at > 0 && at + 1 < len && (line[at] & 255) == 46 && (line[at + 1] & 255) == 32) { return 2; }
        return 0;
    }

    // 列表行中项正文（"<li>" 内容）的起始下标。
    public static int ListBody(string line, int kind) {
        if (kind == 1) { return 2; }
        if (line == null) { return 0; }
        int len = line.Length;
        int at = 0;
        for (; at < len; at = at + 1) {
            int c = line[at] & 255;
            if (c < 48 || c > 57) { break; }
        }
        return at + 2;
    }

    // 按 CR/CRLF/LF 把文本切成行；结尾无换行也补最后一行。
    public static List<string> Lines(string text) {
        List<string> lines = new List<string>();
        if (text == null) { return lines; }
        int len = text.Length;
        int start = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = text[i] & 255;
            if (c == 13) {
                lines.Add(text.Substring(start, i - start));
                if (i + 1 < len && (text[i + 1] & 255) == 10) { i = i + 1; }
                start = i + 1;
            } else if (c == 10) {
                lines.Add(text.Substring(start, i - start));
                start = i + 1;
            }
        }
        if (start <= len) {
            lines.Add(text.Substring(start, len - start));
        }
        return lines;
    }

    // 去除两端空白（空格、制表、换行）。
    public static string Trim(string text) {
        if (text == null) { return ""; }
        return text.Trim();
    }

    // 字符是否为空白（空格/制表/CR/LF）。
    public static bool IsSpace(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        int c = ch[0] & 255;
        return c == 32 || c == 9 || c == 13 || c == 10;
    }

    // 前缀匹配。
    public static bool StartsWith(string text, string prefix) {
        if (text == null || prefix == null) { return false; }
        return text.StartsWith(prefix);
    }

    // 从 from 起查找子串，找不到返回 -1。
    public static int Find(string text, string needle, int from) {
        if (text == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > text.Length) { return -1; }
        return text.IndexOf(needle, from);
    }
}
