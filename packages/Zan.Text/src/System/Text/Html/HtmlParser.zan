using System;
using System.Collections.Generic;

namespace System.Text.Html;

// 容错的 HTML 解析器。
//
// 目标是"够用且安全"，不是完整实现 HTML5 树构造：
//   - 标签与属性按 HTML 规则解析：属性名小写、同名属性取第一个、
//     无引号的值到空白或 '>' 为止；
//   - 空元素不压栈；script/style 的内容按原始文本处理（里面的 '<'
//     不是标签），textarea/title 的内容解实体；
//   - 隐式闭合覆盖 p / li / dt / dd / option / tr / td / th /
//     thead / tbody / tfoot；
//   - 结束标签找到匹配就一路关到它，找不到就忽略；
//   - 畸形输入不抛异常：孤立的 '<' 当文本，属性名不合法就跳过。
public class HtmlParser {
    private static string[] s_indentCache;
    private static string indentLock = "Zan.HtmlParser.IndentCache";
    // 防恶意深嵌套 HTML 在后续递归遍历（序列化/消毒/查询）时打穿线程栈。
    private static int MaxNestingDepth = 512;

    string src;
    nint srcPtr;
    int len;
    int pos;
    List<HtmlNode> open;
    string[] nameCache;

    public HtmlParser() {
        this.src = "";
        this.srcPtr = 0;
        this.len = 0;
        this.pos = 0;
        this.open = new List<HtmlNode>();
        this.nameCache = new string[64];
    }

    private static string[] GetIndentCache() {
        string[] cached = HtmlParser.s_indentCache;
        if (cached != null) { return cached; }
        lock (HtmlParser.indentLock) {
            if (HtmlParser.s_indentCache == null) {
                string[] c = new string[17];
                string cur = "\n";
                for (int i = 0; i <= 16; i = i + 1) {
                    c[i] = cur;
                    cur = cur + " ";
                }
                HtmlParser.s_indentCache = c;
            }
            return HtmlParser.s_indentCache;
        }
    }

    // 解析 HTML 片段。
    public static HtmlDocument Parse(string html) {
        HtmlParser p = new HtmlParser();
        p.src = html == null ? "" : html;
        p.srcPtr = (nint)p.src;
        p.len = p.src.Length;
        p.pos = 0;
        HtmlDocument doc = new HtmlDocument();
        p.open.Add(doc.root);
        p.Run();
        return doc;
    }

    // 64 槽直接映射小写折叠驻留缓存：命中时零堆分配返回已有小写标签/属性名。
    string InternLower(int start, int stop) {
        int n = stop - start;
        if (n <= 0) { return ""; }
        if (n > 32) { return HtmlParser.AsciiLowerSlice(this.src, start, stop); }
        Span<byte> buf = new Span<byte>(this.srcPtr, this.len);
        int h = -2128831035;
        bool hasUpper = false;
        for (int i = start; i < stop; i = i + 1) {
            int c = buf[i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; hasUpper = true; }
            h = (h ^ c) * 16777619;
        }
        int slot = h & 63;
        string cached = this.nameCache[slot];
        if (cached != null && cached.Length == n) {
            bool eq = true;
            for (int i = 0; i < n; i = i + 1) {
                int c = buf[start + i] & 255;
                if (c >= 65 && c <= 90) { c = c + 32; }
                if (c != (cached[i] & 255)) { eq = false; break; }
            }
            if (eq) { return cached; }
        }
        string fresh;
        if (!hasUpper) {
            fresh = this.src.Substring(start, n);
        } else {
            byte[] outb = new byte[n];
            for (int i = 0; i < n; i = i + 1) {
                int c = buf[start + i] & 255;
                if (c >= 65 && c <= 90) { c = c + 32; }
                outb[i] = (byte)c;
            }
            fresh = outb.ToStr(0, n);
        }
        this.nameCache[slot] = fresh;
        return fresh;
    }

    string InternPlainSlice(int start, int tlen) {
        if (tlen <= 0) { return ""; }
        if (tlen <= 17 && (this.src[start] & 255) == 10) {
            Span<byte> buf = new Span<byte>(this.srcPtr + (nint)start, tlen);
            bool allSp = true;
            for (int i = 1; i < tlen; i = i + 1) {
                if ((buf[i] & 255) != 32) { allSp = false; break; }
            }
            if (allSp) {
                return HtmlParser.GetIndentCache()[tlen - 1];
            }
        }
        return this.src.Substring(start, tlen);
    }

    void Run() {
        nint sp = this.srcPtr;
        Span<byte> buf = new Span<byte>(sp, this.len);
        while (this.pos < this.len) {
            int c = buf[this.pos] & 255;
            if (c != 60) {
                int start = this.pos;
                int rem = this.len - (start + 1);
                int lt = rem > 0 ? NativeMemory.Find(sp, start + 1, 60, rem) : -1;
                this.pos = lt < 0 ? this.len : lt;
                int tlen = this.pos - start;
                int amp = NativeMemory.Find(sp, start, 38, tlen);
                if (amp < 0) {
                    this.AddText(this.InternPlainSlice(start, tlen));
                } else {
                    this.AddText(HtmlUtil.DecodeEntitiesSlice(this.src, start, tlen));
                }
                continue;
            }
            int p1 = this.pos + 1;
            if (p1 < this.len) {
                int c1 = buf[p1] & 255;
                if (c1 == 47) { this.ParseEndTag(); continue; }  // "</"
                if (c1 == 33) {  // "<!"
                    if (this.pos + 3 < this.len && (buf[this.pos + 2] & 255) == 45 && (buf[this.pos + 3] & 255) == 45) {
                        this.ParseComment();
                    } else {
                        this.SkipBogus();
                    }
                    continue;
                }
                if (HtmlUtil.IsNameStart(c1)) {
                    this.ParseStartTag();
                    continue;
                }
            }
            // 孤立的 '<'：当普通文本。
            this.AddText("<");
            this.pos = this.pos + 1;
        }
    }

    // 当前所在的容器（栈顶）。
    HtmlNode Current() {
        return this.open[this.open.Count - 1];
    }

    void AddText(string text) {
        if (text.Length == 0) { return; }
        this.Current().AppendChild(HtmlNode.TextNode(text));
    }

    // 当前位置是否以 prefix 开头。
    bool Has(string prefix) {
        if (this.pos + prefix.Length > this.len) { return false; }
        return this.MatchAt(prefix, this.pos);
    }

    // 大小写不敏感地比较 src[at..] 与 needle。
    bool MatchAt(string needle, int at) {
        if (at + needle.Length > this.len) { return false; }
        for (int k = 0; k < needle.Length; k = k + 1) {
            int a = this.src[at + k] & 255;
            int b = needle[k] & 255;
            if (a >= 65 && a <= 90) { a = a + 32; }
            if (b >= 65 && b <= 90) { b = b + 32; }
            if (a != b) { return false; }
        }
        return true;
    }

    // 从 from 起大小写不敏感地找 needle，找不到返回 -1（首字节 SIMD 跳跃扫描）。
    int FindIgnoreCase(string needle, int from) {
        int m = needle.Length;
        if (m == 0) { return -1; }
        int c0 = needle[0] & 255;
        int lo = (c0 >= 65 && c0 <= 90) ? (c0 + 32) : c0;
        int hi = (lo >= 97 && lo <= 122) ? (lo - 32) : lo;
        nint sp = (nint)this.src;
        int limit = this.len - m + 1;
        int i = from;
        while (i < limit) {
            int hit;
            if (lo == hi) {
                hit = NativeMemory.Find(sp, i, lo, limit - i);
            } else {
                int rel = NativeMemory.IndexOfAny(sp + (nint)i, limit - i, (byte)lo, (byte)hi);
                hit = rel < 0 ? -1 : (i + rel);
            }
            if (hit < 0) { return -1; }
            if (this.MatchAt(needle, hit)) { return hit; }
            i = hit + 1;
        }
        return -1;
    }

    void ParseComment() {
        int end = this.src.IndexOf("-->", this.pos + 4);
        string body;
        if (end < 0) {
            body = this.src.Substring(this.pos + 4, this.len - this.pos - 4);
            this.pos = this.len;
        } else {
            body = this.src.Substring(this.pos + 4, end - this.pos - 4);
            this.pos = end + 3;
        }
        this.Current().AppendChild(HtmlNode.CommentNode(body));
    }

    // doctype 之类的声明：整段丢掉。
    void SkipBogus() {
        int from = this.pos + 2;
        int rem = this.len - from;
        int end = rem > 0 ? NativeMemory.Find(this.srcPtr, from, 62, rem) : -1;
        if (end < 0) { this.pos = this.len; } else { this.pos = end + 1; }
    }

    static string AsciiLowerSlice(string s, int start, int stop) {
        int n = stop - start;
        if (n <= 0) { return ""; }
        bool hasUpper = false;
        for (int i = start; i < stop; i = i + 1) {
            int c = s[i] & 255;
            if (c >= 65 && c <= 90) { hasUpper = true; break; }
        }
        if (!hasUpper) { return s.Substring(start, n); }
        byte[] buf = new byte[n];
        for (int i = 0; i < n; i = i + 1) {
            int c = s[start + i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            buf[i] = (byte)c;
        }
        return buf.ToStr(0, n);
    }

    void ParseEndTag() {
        int j = this.pos + 2;
        int nameStart = j;
        Span<byte> buf = new Span<byte>(this.srcPtr, this.len);
        while (j < this.len && HtmlUtil.IsNameChar(buf[j] & 255)) { j = j + 1; }
        int rem = this.len - j;
        int gt = rem > 0 ? NativeMemory.Find(this.srcPtr, j, 62, rem) : -1;
        this.pos = gt < 0 ? this.len : gt + 1;
        int nlen = j - nameStart;
        if (nlen <= 0) { return; }
        int cnt = this.open.Count;
        if (cnt > 1) {
            string topTag = this.open[cnt - 1].tag;
            if (topTag.Length == nlen) {
                bool eq = true;
                for (int i = 0; i < nlen; i = i + 1) {
                    int c = buf[nameStart + i] & 255;
                    if (c >= 65 && c <= 90) { c = c + 32; }
                    if (c != (topTag[i] & 255)) { eq = false; break; }
                }
                if (eq) {
                    this.open.RemoveAt(cnt - 1);
                    return;
                }
            }
        }
        string name = this.InternLower(nameStart, j);
        this.CloseTag(name);
    }

    void ParseStartTag() {
        int j = this.pos + 1;
        int nameStart = j;
        Span<byte> buf = new Span<byte>(this.srcPtr, this.len);
        while (j < this.len && HtmlUtil.IsNameChar(buf[j] & 255)) { j = j + 1; }
        string name = this.InternLower(nameStart, j);
        HtmlNode node = HtmlNode.Element(name);

        while (j < this.len) {
            while (j < this.len && HtmlUtil.IsSpace(buf[j] & 255)) { j = j + 1; }
            if (j >= this.len) { break; }
            int c = buf[j] & 255;
            if (c == 62) { j = j + 1; break; }                                   // '>'
            if (c == 47 && j + 1 < this.len && (buf[j + 1] & 255) == 62) { j = j + 2; break; }  // '/>'
            int attrStart = j;
            while (j < this.len) {
                int cc = buf[j] & 255;
                if (HtmlUtil.IsSpace(cc) || cc == 61 || cc == 62 || cc == 34 || cc == 39 || cc == 60) { break; }
                j = j + 1;
            }
            if (j == attrStart) { j = j + 1; continue; }
            string attrName = this.InternLower(attrStart, j);
            int vs = 0;
            int ve = 0;
            int k = j;
            while (k < this.len && HtmlUtil.IsSpace(buf[k] & 255)) { k = k + 1; }
            if (k < this.len && (buf[k] & 255) == 61) {
                k = k + 1;
                while (k < this.len && HtmlUtil.IsSpace(buf[k] & 255)) { k = k + 1; }
                if (k < this.len) {
                    int q = buf[k] & 255;
                    if (q == 34 || q == 39) {
                        k = k + 1;
                        vs = k;
                        int rem = this.len - k;
                        int qe = rem > 0 ? NativeMemory.Find(this.srcPtr, k, q, rem) : -1;
                        k = qe < 0 ? this.len : qe;
                        ve = k;
                        if (k < this.len) { k = k + 1; }
                    } else {
                        vs = k;
                        while (k < this.len) {
                            int cc = buf[k] & 255;
                            if (HtmlUtil.IsSpace(cc) || cc == 62) { break; }
                            k = k + 1;
                        }
                        ve = k;
                    }
                }
                j = k;
            }
            // HTML 规则：同名属性取第一个。
            // 首个属性免 ContainsKey 二次哈希；无实体短属性值命中 64 槽驻留缓存零分配。
            Dictionary<string, string> am = node.attrsMap;
            if (am == null) {
                am = new Dictionary<string, string>();
                node.attrsMap = am;
                int vlen = ve - vs;
                string decoded = "";
                if (vlen > 0) {
                    int amp = NativeMemory.Find(this.srcPtr, vs, 38, vlen);
                    decoded = amp < 0 ? this.src.Substring(vs, vlen) : HtmlUtil.DecodeEntitiesSlice(this.src, vs, vlen);
                }
                am.Add(attrName, decoded);
            } else if (!am.ContainsKey(attrName)) {
                int vlen = ve - vs;
                string decoded = "";
                if (vlen > 0) {
                    int amp = NativeMemory.Find(this.srcPtr, vs, 38, vlen);
                    decoded = amp < 0 ? this.src.Substring(vs, vlen) : HtmlUtil.DecodeEntitiesSlice(this.src, vs, vlen);
                }
                am.Add(attrName, decoded);
            }
        }
        this.pos = j;

        this.ApplyImpliedEndTags(name);
        this.Current().AppendChild(node);
        if (HtmlUtil.IsVoidTag(name)) { return; }
        if (HtmlUtil.IsRawTextTag(name) || HtmlUtil.IsEscapableRawTextTag(name)) {
            this.ReadRawText(node, name);
            return;
        }
        if (this.open.Count < HtmlParser.MaxNestingDepth) {
            this.open.Add(node);
        }
    }

    // 原始文本元素的内容：到对应的结束标签为止。
    void ReadRawText(HtmlNode node, string name) {
        string closeTag = "</" + name;
        int at = this.FindIgnoreCase(closeTag, this.pos);
        int rawStart = this.pos;
        int rawEnd;
        if (at < 0) {
            rawEnd = this.len;
            this.pos = this.len;
        } else {
            rawEnd = at;
            this.pos = at;
        }
        if (rawEnd > rawStart) {
            string text = HtmlUtil.IsEscapableRawTextTag(name)
                ? HtmlUtil.DecodeEntitiesSlice(this.src, rawStart, rawEnd - rawStart)
                : this.src.Substring(rawStart, rawEnd - rawStart);
            node.AppendChild(HtmlNode.TextNode(text));
        }
        if (this.Has(closeTag)) {
            int j = this.pos + closeTag.Length;
            int rem = this.len - j;
            int gt = rem > 0 ? NativeMemory.Find(this.srcPtr, j, 62, rem) : -1;
            this.pos = gt < 0 ? this.len : gt + 1;
        }
    }

    // 开始标签带来的隐式闭合（栈顶快判，非 <p> 与非列表/表格标签 O(1) 跳过 31 路扫描）。
    void ApplyImpliedEndTags(string name) {
        int cnt = this.open.Count;
        if (cnt <= 1) { return; }
        string top = this.open[cnt - 1].tag;
        if (top == "p") {
            if (HtmlParser.ClosesParagraph(name)) {
                this.open.RemoveAt(cnt - 1);
            }
            return;
        }
        if (name.Length == 0) { return; }
        int c0 = name[0] & 255;
        if (c0 != 108 && c0 != 100 && c0 != 111 && c0 != 116) { return; }
        if (name == "li") {
            this.CloseTopOf("li");
        } else if (name == "dt" || name == "dd") {
            this.CloseTopOf("dt");
            this.CloseTopOf("dd");
        } else if (name == "option") {
            this.CloseTopOf("option");
        } else if (name == "optgroup") {
            this.CloseTopOf("option");
            this.CloseTopOf("optgroup");
        } else if (name == "tr") {
            this.CloseTopOf("td");
            this.CloseTopOf("th");
            this.CloseTopOf("tr");
        } else if (name == "td" || name == "th") {
            this.CloseTopOf("td");
            this.CloseTopOf("th");
        } else if (name == "thead" || name == "tbody" || name == "tfoot") {
            this.CloseTopOf("td");
            this.CloseTopOf("th");
            this.CloseTopOf("tr");
            this.CloseTopOf("thead");
            this.CloseTopOf("tbody");
            this.CloseTopOf("tfoot");
        }
    }

    // 这些块级标签开始时会关掉还开着的 <p>。
    static bool ClosesParagraph(string name) {
        return name == "address" || name == "article" || name == "aside"
            || name == "blockquote" || name == "details" || name == "dialog"
            || name == "div" || name == "dl" || name == "fieldset"
            || name == "figcaption" || name == "figure" || name == "footer"
            || name == "form" || name == "h1" || name == "h2" || name == "h3"
            || name == "h4" || name == "h5" || name == "h6" || name == "header"
            || name == "hgroup" || name == "hr" || name == "main" || name == "menu"
            || name == "nav" || name == "ol" || name == "p" || name == "pre"
            || name == "section" || name == "table" || name == "ul";
    }

    // 栈顶是这个标签就关掉它。
    void CloseTopOf(string tag) {
        if (this.open.Count <= 1) { return; }
        HtmlNode top = this.open[this.open.Count - 1];
        if (top.tag == tag) { this.open.RemoveAt(this.open.Count - 1); }
    }

    // 结束标签：找到匹配就一路关到它，找不到忽略。
    void CloseTag(string name) {
        for (int i = this.open.Count - 1; i >= 1; i = i - 1) {
            if (this.open[i].tag == name) {
                while (this.open.Count > i) { this.open.RemoveAt(this.open.Count - 1); }
                return;
            }
        }
    }
}
