using System;
using System.Collections.Generic;

namespace System.Text.Html;

// 一个属性条件（"[href]" / "[href^=http]" / …）。
public class CssAttr {
    // 属性名（小写）。
    public string name;
    // 操作符：""（存在）、"="、"~="、"|="、"^="、"$="、"*="。
    public string op;
    // 预解码操作符枚举：0=存在, 1==, 2=~=, 3=|=, 4=^=, 5=$=, 6=*=。
    public int opKind;
    // 比较值。
    public string value;

    public CssAttr() {
        this.name = "";
        this.op = "";
        this.opKind = 0;
        this.value = "";
    }
}

// 一个伪类条件。
public class CssPseudo {
    // 伪类名（小写）。
    public string name;
    // 预解码伪类枚举：1=first-child, 2=last-child, 3=only-child, 4=empty, 5=root, 6=not, 7=nth-child, 8=nth-of-type。
    public int kind;
    // 括号里的参数（":not(.x)" 的 ".x"、":nth-child(2n+1)" 的 "2n+1"）。
    public string arg;
    // 不支持/解析不了 → 永不匹配。
    public bool unsupported;
    // ":not(...)" 的参数解析结果。
    public CssCompound notCompound;
    // ":nth-child(...)" 的 an+b。
    public int nthA;
    public int nthB;

    public CssPseudo() {
        this.name = "";
        this.kind = 0;
        this.arg = "";
        this.unsupported = false;
        this.notCompound = null;
        this.nthA = 0;
        this.nthB = 0;
    }
}

// 一个复合选择器（"div.big[href]"）。
public class CssCompound {
    // 标签名（"" = 任意，"*" = 任意）。
    public string tag;
    // id（"" = 不限）。
    public string id;
    // 类名列表。
    public List<string> classes;
    // 属性条件。
    public List<CssAttr> attrs;
    // 伪类条件。
    public List<CssPseudo> pseudos;
    // 解析不了 → 永不匹配。
    public bool unsupported;
    // 预解码：是否需要按标签名过滤（tag 非空且非 "*"）。
    internal bool hasTagFilter;

    public CssCompound() {
        this.tag = "";
        this.id = "";
        this.classes = new List<string>();
        this.attrs = new List<CssAttr>();
        this.pseudos = new List<CssPseudo>();
        this.unsupported = false;
        this.hasTagFilter = false;
    }
}

// 一条复杂选择器（"div > p span"）：compound 列表 + 组合符列表。
//
// combinators[i] 是 compound[i-1] 与 compound[i] 之间的关系：
// "descendant"（后代）、"child"（直接子）、"adjacent"（紧邻兄弟）、
// "sibling"（任意前序兄弟）；combinators[0] 不用。
public class CssComplex {
    public List<CssCompound> compounds;
    public List<string> combinators;
    // 预解码组合符枚举：0=首段, 1=child, 2=descendant, 3=adjacent, 4=sibling。
    internal List<int> combKinds;
    // 分支组合符（descendant / sibling）计数；≥2 时才可能回溯并启用共享 failMemo。
    internal int branchCombCount;
    internal Dict<HtmlNode, long> failMemo;

    public CssComplex() {
        this.compounds = new List<CssCompound>();
        this.combinators = new List<string>();
        this.combKinds = new List<int>();
        this.branchCombCount = 0;
        this.failMemo = null;
    }
}

// CSS 选择器查询层。
//
// 支持的选择器语法：
//   - 标签（div）、通配（*）、id（#a）、类（.b）；
//   - 属性：[href]、[href=x]、[href~=x]、[href|=x]、[href^=x]、
//     [href$=x]、[href*=x]；
//   - 组合符：后代（空格）、直接子（>）、紧邻兄弟（+）、通用兄弟（~）；
//   - 选择器组（逗号分隔）；
//   - 伪类：:first-child、:last-child、:only-child、:empty、:root、
//     :not(简单选择器)、:nth-child(an+b)。
//
// 不支持：伪元素（::before）、动态伪类（:hover）、:has()、命名空间、
// 属性选择器里的正则语法（|= 之外的 i 标志）。用不了的写法会被标成
// "不支持"，整条选择器不匹配任何元素——不静默当成"匹配全部"。
public class CssSelector {
    string src;
    int pos;

    public CssSelector() {
        this.src = "";
        this.pos = 0;
    }

    // 在 scope 的子树里查询（文档顺序，不含 scope 本身）。
    public static List<HtmlNode> Query(HtmlNode scope, string selector) {
        if (scope == null) { return new List<HtmlNode>(); }
        CssSelector p = new CssSelector();
        p.src = selector == null ? "" : selector;
        p.pos = 0;
        List<CssComplex> list = p.ParseList();
        List<HtmlNode> hits = new List<HtmlNode>();
        bool needCount = CssSelector.ListNeedsElemCount(list);
        if (list.Count == 1) {
            CssSelector.CollectSingle(scope, list[0], hits, needCount);
        } else {
            p.Collect(scope, list, hits, needCount);
        }
        return hits;
    }

    // 在 scope 的子树里查第一个（命中即刻早退，不扫描剩余节点）。
    public static HtmlNode Find(HtmlNode scope, string selector) {
        if (scope == null) { return null; }
        CssSelector p = new CssSelector();
        p.src = selector == null ? "" : selector;
        p.pos = 0;
        List<CssComplex> list = p.ParseList();
        bool needCount = CssSelector.ListNeedsElemCount(list);
        if (list.Count == 1) {
            return CssSelector.FindFirstSingle(scope, list[0], needCount);
        }
        return p.FindFirst(scope, list, needCount);
    }

    private static void CollectSingle(HtmlNode scope, CssComplex cx, List<HtmlNode> hits, bool needCount) {
        List<HtmlNode> children = scope.childList;
        if (children == null) { return; }
        int cnt = children.Count;
        int elemTotal = -1;
        if (needCount) {
            elemTotal = 0;
            for (int i = 0; i < cnt; i = i + 1) {
                if (children[i].type == HtmlNodeType.Element) { elemTotal = elemTotal + 1; }
            }
        }
        int elemIdx = 0;
        for (int i = 0; i < cnt; i = i + 1) {
            HtmlNode c = children[i];
            if (c.type == HtmlNodeType.Element) {
                if (CssSelector.MatchComplexAt(c, cx, elemIdx, elemTotal)) { hits.Add(c); }
                elemIdx = elemIdx + 1;
                if (c.childList != null && c.childList.Count > 0) {
                    CssSelector.CollectSingle(c, cx, hits, needCount);
                }
            }
        }
    }

    private static HtmlNode FindFirstSingle(HtmlNode scope, CssComplex cx, bool needCount) {
        List<HtmlNode> children = scope.childList;
        if (children == null) { return null; }
        int cnt = children.Count;
        int elemTotal = -1;
        if (needCount) {
            elemTotal = 0;
            for (int i = 0; i < cnt; i = i + 1) {
                if (children[i].type == HtmlNodeType.Element) { elemTotal = elemTotal + 1; }
            }
        }
        int elemIdx = 0;
        for (int i = 0; i < cnt; i = i + 1) {
            HtmlNode c = children[i];
            if (c.type == HtmlNodeType.Element) {
                if (CssSelector.MatchComplexAt(c, cx, elemIdx, elemTotal)) { return c; }
                elemIdx = elemIdx + 1;
                if (c.childList != null && c.childList.Count > 0) {
                    HtmlNode found = CssSelector.FindFirstSingle(c, cx, needCount);
                    if (found != null) { return found; }
                }
            }
        }
        return null;
    }

    private static bool ListNeedsElemCount(List<CssComplex> list) {
        for (int k = 0; k < list.Count; k = k + 1) {
            List<CssCompound> comps = list[k].compounds;
            if (comps.Count == 0) { continue; }
            List<CssPseudo> ps = comps[comps.Count - 1].pseudos;
            for (int j = 0; j < ps.Count; j = j + 1) {
                int pk = ps[j].kind;
                if (pk == 2 || pk == 3) { return true; }
            }
        }
        return false;
    }

    void Collect(HtmlNode scope, List<CssComplex> list, List<HtmlNode> hits, bool needCount) {
        List<HtmlNode> children = scope.childList;
        if (children == null) { return; }
        int cnt = children.Count;
        int elemTotal = -1;
        if (needCount) {
            elemTotal = 0;
            for (int i = 0; i < cnt; i = i + 1) {
                if (children[i].IsElement()) { elemTotal = elemTotal + 1; }
            }
        }
        int elemIdx = 0;
        int listCnt = list.Count;
        if (listCnt == 1) {
            CssComplex cx0 = list[0];
            for (int i = 0; i < cnt; i = i + 1) {
                HtmlNode c = children[i];
                if (c.IsElement()) {
                    if (CssSelector.MatchComplexAt(c, cx0, elemIdx, elemTotal)) { hits.Add(c); }
                    elemIdx = elemIdx + 1;
                    if (c.childList != null && c.childList.Count > 0) {
                        this.Collect(c, list, hits, needCount);
                    }
                }
            }
            return;
        }
        for (int i = 0; i < cnt; i = i + 1) {
            HtmlNode c = children[i];
            if (c.IsElement()) {
                for (int k = 0; k < listCnt; k = k + 1) {
                    if (CssSelector.MatchComplexAt(c, list[k], elemIdx, elemTotal)) { hits.Add(c); break; }
                }
                elemIdx = elemIdx + 1;
                if (c.childList != null && c.childList.Count > 0) {
                    this.Collect(c, list, hits, needCount);
                }
            }
        }
    }

    HtmlNode FindFirst(HtmlNode scope, List<CssComplex> list, bool needCount) {
        List<HtmlNode> children = scope.childList;
        if (children == null) { return null; }
        int cnt = children.Count;
        int elemTotal = -1;
        if (needCount) {
            elemTotal = 0;
            for (int i = 0; i < cnt; i = i + 1) {
                if (children[i].IsElement()) { elemTotal = elemTotal + 1; }
            }
        }
        int elemIdx = 0;
        int listCnt = list.Count;
        if (listCnt == 1) {
            CssComplex cx0 = list[0];
            for (int i = 0; i < cnt; i = i + 1) {
                HtmlNode c = children[i];
                if (c.IsElement()) {
                    if (CssSelector.MatchComplexAt(c, cx0, elemIdx, elemTotal)) { return c; }
                    elemIdx = elemIdx + 1;
                    if (c.childList != null && c.childList.Count > 0) {
                        HtmlNode found = this.FindFirst(c, list, needCount);
                        if (found != null) { return found; }
                    }
                }
            }
            return null;
        }
        for (int i = 0; i < cnt; i = i + 1) {
            HtmlNode c = children[i];
            if (c.IsElement()) {
                for (int k = 0; k < listCnt; k = k + 1) {
                    if (CssSelector.MatchComplexAt(c, list[k], elemIdx, elemTotal)) { return c; }
                }
                elemIdx = elemIdx + 1;
                if (c.childList != null && c.childList.Count > 0) {
                    HtmlNode found = this.FindFirst(c, list, needCount);
                    if (found != null) { return found; }
                }
            }
        }
        return null;
    }

    // ---- 解析 ----

    List<CssComplex> ParseList() {
        List<CssComplex> list = new List<CssComplex>();
        this.SkipSpace();
        if (this.pos >= this.src.Length) {
            throw new ArgumentException("empty CSS selector");
        }
        while (true) {
            list.Add(this.ParseComplex());
            this.SkipSpace();
            if (this.pos < this.src.Length && (this.src[this.pos] & 255) == 44) {
                this.pos = this.pos + 1;
                this.SkipSpace();
                if (this.pos >= this.src.Length) {
                    throw new ArgumentException("CSS selector ends with ','");
                }
                continue;
            }
            break;
        }
        if (this.pos < this.src.Length) {
            throw new ArgumentException("invalid CSS selector at " + Convert.ToString(this.pos));
        }
        return list;
    }

    CssComplex ParseComplex() {
        CssComplex cx = new CssComplex();
        string pending = "";
        int pendingKind = 0;
        bool first = true;
        while (true) {
            this.SkipSpace();
            if (this.pos >= this.src.Length) { break; }
            int c = this.src[this.pos] & 255;
            if (c == 44) { break; }   // ','
            if (c == 62) { this.pos = this.pos + 1; pending = "child"; pendingKind = 1; continue; }
            if (c == 43) { this.pos = this.pos + 1; pending = "adjacent"; pendingKind = 3; continue; }
            if (c == 126) { this.pos = this.pos + 1; pending = "sibling"; pendingKind = 4; continue; }
            CssCompound comp = this.ParseCompound();
            if (comp.tag.Length == 0 && comp.id.Length == 0 && comp.classes.Count == 0
                && comp.attrs.Count == 0 && comp.pseudos.Count == 0) {
                // 空复合选择器：说明写错了（少了选择器主体）。
                throw new ArgumentException("invalid CSS selector at " + Convert.ToString(this.pos));
            }
            cx.compounds.Add(comp);
            if (first) {
                cx.combinators.Add("");
                cx.combKinds.Add(0);
            } else {
                int ck = pendingKind != 0 ? pendingKind : 2;
                cx.combinators.Add(pendingKind != 0 ? pending : "descendant");
                cx.combKinds.Add(ck);
                if (ck == 2 || ck == 4) { cx.branchCombCount = cx.branchCombCount + 1; }
            }
            first = false;
            pending = "";
            pendingKind = 0;
            // 看下一个非空格字符，决定后一个 compound 的关系。
            int save = this.pos;
            this.SkipSpace();
            if (this.pos >= this.src.Length) { this.pos = save; break; }
            int nc = this.src[this.pos] & 255;
            if (nc == 44) { this.pos = save; break; }
            if (nc == 62 || nc == 43 || nc == 126) { continue; }
            this.pos = save;
            pending = "descendant";
            pendingKind = 2;
        }
        if (cx.compounds.Count == 0) {
            throw new ArgumentException("invalid CSS selector at " + Convert.ToString(this.pos));
        }
        return cx;
    }

    private static string AsciiLower(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int n = s.Length;
        Span<byte> sb = new Span<byte>((nint)s, n);
        bool hasUpper = false;
        for (int i = 0; i < n; i = i + 1) {
            int c = sb[i];
            if (c >= 65 && c <= 90) { hasUpper = true; break; }
        }
        if (!hasUpper) { return s; }
        byte[] buf = new byte[n];
        Span<byte> dst = new Span<byte>((nint)buf, n);
        for (int i = 0; i < n; i = i + 1) {
            int c = sb[i];
            if (c >= 65 && c <= 90) { c = c + 32; }
            dst[i] = (byte)c;
        }
        return NativeMemory.GetString((nint)buf, 0, n);
    }

    CssCompound ParseCompound() {
        CssCompound comp = new CssCompound();
        if (this.pos < this.src.Length) {
            int c = this.src[this.pos] & 255;
            if (c == 42) {          // '*'
                this.pos = this.pos + 1;
                comp.tag = "*";
            } else if (HtmlUtil.IsNameStart(c)) {
                comp.tag = CssSelector.AsciiLower(this.ReadName());
                comp.hasTagFilter = comp.tag.Length > 0;
            }
        }
        while (this.pos < this.src.Length) {
            int c = this.src[this.pos] & 255;
            if (c == 35) {         // '#'
                this.pos = this.pos + 1;
                comp.id = this.ReadName();
            } else if (c == 46) {  // '.'
                this.pos = this.pos + 1;
                comp.classes.Add(this.ReadName());
            } else if (c == 91) {  // '['
                comp.attrs.Add(this.ParseAttr());
            } else if (c == 58) {  // ':'
                comp.pseudos.Add(this.ParsePseudo());
            } else {
                break;
            }
        }
        return comp;
    }

    CssAttr ParseAttr() {
        CssAttr a = new CssAttr();
        this.pos = this.pos + 1;   // '['
        this.SkipSpace();
        a.name = CssSelector.AsciiLower(this.ReadName());
        this.SkipSpace();
        if (this.pos >= this.src.Length) { return a; }
        int c = this.src[this.pos] & 255;
        if (c == 93) { this.pos = this.pos + 1; return a; }   // ']'
        string op = "";
        int opKind = 0;
        if (c == 61) {
            op = "="; opKind = 1;
            this.pos = this.pos + 1;
        } else if (c == 126 || c == 124 || c == 94 || c == 36 || c == 42) {
            if (c == 126) { op = "~="; opKind = 2; }
            else if (c == 124) { op = "|="; opKind = 3; }
            else if (c == 94) { op = "^="; opKind = 4; }
            else if (c == 36) { op = "$="; opKind = 5; }
            else { op = "*="; opKind = 6; }
            this.pos = this.pos + 1;
            if (this.pos < this.src.Length && (this.src[this.pos] & 255) == 61) { this.pos = this.pos + 1; }
        } else {
            return a;
        }
        a.op = op;
        a.opKind = opKind;
        this.SkipSpace();
        if (this.pos < this.src.Length) {
            int q = this.src[this.pos] & 255;
            if (q == 34 || q == 39) {
                this.pos = this.pos + 1;
                int start = this.pos;
                while (this.pos < this.src.Length && (this.src[this.pos] & 255) != q) { this.pos = this.pos + 1; }
                a.value = this.src.Substring(start, this.pos - start);
                if (this.pos < this.src.Length) { this.pos = this.pos + 1; }
            } else {
                int start = this.pos;
                while (this.pos < this.src.Length) {
                    int cc = this.src[this.pos] & 255;
                    if (HtmlUtil.IsSpace(cc) || cc == 93) { break; }
                    this.pos = this.pos + 1;
                }
                a.value = this.src.Substring(start, this.pos - start);
            }
        }
        this.SkipSpace();
        if (this.pos < this.src.Length && (this.src[this.pos] & 255) == 93) { this.pos = this.pos + 1; }
        return a;
    }

    CssPseudo ParsePseudo() {
        CssPseudo p = new CssPseudo();
        this.pos = this.pos + 1;   // ':'
        if (this.pos < this.src.Length && (this.src[this.pos] & 255) == 58) {
            this.pos = this.pos + 1;
            p.name = "::" + CssSelector.AsciiLower(this.ReadName());
            p.unsupported = true;
            return p;
        }
        p.name = CssSelector.AsciiLower(this.ReadName());
        if (this.pos < this.src.Length && (this.src[this.pos] & 255) == 40) {
            int close = this.src.IndexOf(")", this.pos);
            if (close < 0) {
                p.unsupported = true;
                return p;
            }
            p.arg = this.src.Substring(this.pos + 1, close - this.pos - 1).Trim();
            this.pos = close + 1;
        }
        if (p.name == "not") {
            if (p.arg.Length == 0) {
                p.unsupported = true;
                return p;
            }
            CssSelector sub = new CssSelector();
            sub.src = p.arg;
            sub.pos = 0;
            CssCompound sc = sub.ParseCompound();
            if (sub.pos < sub.src.Length) { p.unsupported = true; return p; }
            p.notCompound = sc;
            p.kind = 6;
            return p;
        }
        if (p.name == "nth-child" || p.name == "nth-of-type") {
            if (!CssSelector.ParseNth(p.arg, p)) { p.unsupported = true; }
            else { p.kind = p.name == "nth-of-type" ? 8 : 7; }
            return p;
        }
        if (p.name == "first-child") { p.kind = 1; return p; }
        if (p.name == "last-child") { p.kind = 2; return p; }
        if (p.name == "only-child") { p.kind = 3; return p; }
        if (p.name == "empty") { p.kind = 4; return p; }
        if (p.name == "root") { p.kind = 5; return p; }
        p.unsupported = true;
        return p;
    }

    string ReadName() {
        int n = this.src.Length;
        int p = this.pos;
        if (p >= n) { return ""; }
        Span<byte> sb = new Span<byte>((nint)this.src, n);
        int start = p;
        while (p < n && HtmlUtil.IsNameChar(sb[p])) { p = p + 1; }
        this.pos = p;
        return this.src.Substring(start, p - start);
    }

    void SkipSpace() {
        int n = this.src.Length;
        int p = this.pos;
        if (p >= n) { return; }
        Span<byte> sb = new Span<byte>((nint)this.src, n);
        while (p < n && HtmlUtil.IsSpace(sb[p])) { p = p + 1; }
        this.pos = p;
    }

    // 解析 an+b（"odd"/"even"/"n"/"-n+3"/"2n + 1"/"3"…，符合 CSS Syntax An+B）。
    static bool ParseNth(string expr, CssPseudo p) {
        if (expr == null) { return false; }
        string s = CssSelector.AsciiLower(expr.Trim());
        if (s.Length == 0) { return false; }
        if (s == "odd") { p.nthA = 2; p.nthB = 1; return true; }
        if (s == "even") { p.nthA = 2; p.nthB = 0; return true; }
        int nAt = -1;
        for (int i = 0; i < s.Length; i = i + 1) {
            if ((s[i] & 255) == 110) { nAt = i; break; }
        }
        if (nAt < 0) {
            int v;
            if (!CssSelector.ParseIntStrict(s, out v)) { return false; }
            p.nthA = 0;
            p.nthB = v;
            return true;
        }
        int a;
        string head = s.Substring(0, nAt).Trim();
        if (head.Length == 0 || head == "+") { a = 1; }
        else if (head == "-") { a = -1; }
        else if (!CssSelector.ParseIntStrict(head, out a)) { return false; }
        string tail = s.Substring(nAt + 1).Trim();
        int b = 0;
        if (tail.Length > 0) {
            int sc = tail[0] & 255;
            if (sc != 43 && sc != 45) { return false; }
            int j = 1;
            while (j < tail.Length && HtmlUtil.IsSpace(tail[j] & 255)) { j = j + 1; }
            if (j >= tail.Length) { return false; }
            string signedNum = (sc == 45 ? "-" : "+") + tail.Substring(j);
            if (!CssSelector.ParseIntStrict(signedNum, out b)) { return false; }
        }
        p.nthA = a;
        p.nthB = b;
        return true;
    }

    // 严格整数解析（允许前导 '+'/'-'，不接受空串、其它字符或 32 位溢出）。
    static bool ParseIntStrict(string s, out int value) {
        value = 0;
        if (s == null || s.Length == 0) { return false; }
        int i = 0;
        int sign = 1;
        int c = s[0] & 255;
        if (c == 43) { i = 1; }
        else if (c == 45) { sign = -1; i = 1; }
        if (i >= s.Length) { return false; }
        long v = 0L;
        long limit = sign == -1 ? 2147483648L : 2147483647L;
        for (; i < s.Length; i = i + 1) {
            int d = s[i] & 255;
            if (d < 48 || d > 57) { return false; }
            v = v * 10L + (long)(d - 48);
            if (v > limit) { return false; }
        }
        value = (int)(sign == -1 ? -v : v);
        return true;
    }

    // ---- 匹配 ----

    static bool MatchComplex(HtmlNode node, CssComplex cx) {
        return CssSelector.MatchComplexAt(node, cx, -1, -1);
    }

    static bool MatchComplexAt(HtmlNode node, CssComplex cx, int elemIdx, int elemTotal) {
        int n = cx.compounds.Count;
        if (n == 0) { return false; }
        if (!CssSelector.MatchCompoundAt(node, cx.compounds[n - 1], elemIdx, elemTotal)) { return false; }
        if (n == 1) { return true; }
        Dict<HtmlNode, long> failMemo = null;
        if (cx.branchCombCount >= 2) {
            failMemo = cx.failMemo;
            if (failMemo == null) {
                failMemo = new Dict<HtmlNode, long>();
                cx.failMemo = failMemo;
            }
        }
        return CssSelector.MatchChain(node, cx, n - 2, failMemo);
    }

    // node 匹配 compound[idx+1]，再往上找 compound[idx] 的匹配；
    // failMemo 按节点位图缓存已证实失败的 idx（防深 DOM 下多后代/兄弟组合符指数回溯）。
    static bool MatchChain(HtmlNode node, CssComplex cx, int idx, Dict<HtmlNode, long> failMemo) {
        if (idx < 0) { return true; }
        if (failMemo != null && idx < 62) {
            long mask = 0L;
            if (failMemo.TryGetValue(node, out mask) && (mask & (1L << idx)) != 0L) {
                return false;
            }
        }
        int comb = cx.combKinds[idx + 1];
        CssCompound target = cx.compounds[idx];
        if (comb == 1) {  // child
            HtmlNode p = node.Parent();
            if (p != null && p.IsElement()
                && CssSelector.MatchCompoundAt(p, target, -1, -1)
                && CssSelector.MatchChain(p, cx, idx - 1, failMemo)) {
                return true;
            }
            if (failMemo != null && idx < 62) {
                long prev = 0L;
                failMemo.TryGetValue(node, out prev);
                failMemo[node] = prev | (1L << idx);
            }
            return false;
        }
        if (comb == 2) {  // descendant
            HtmlNode p = node.ElementParent();
            while (p != null) {
                if (CssSelector.MatchCompoundAt(p, target, -1, -1)
                    && CssSelector.MatchChain(p, cx, idx - 1, failMemo)) { return true; }
                p = p.ElementParent();
            }
            if (failMemo != null && idx < 62) {
                long prev = 0L;
                failMemo.TryGetValue(node, out prev);
                failMemo[node] = prev | (1L << idx);
            }
            return false;
        }
        // adjacent（紧邻, 3）/ sibling（任意前序, 4）
        HtmlNode parent = node.Parent();
        if (parent == null || parent.childList == null) { return false; }
        int limit = (comb == 3) ? 1 : node.index;
        int seen = 0;
        List<HtmlNode> sibs = parent.childList;
        for (int i = node.index - 1; i >= 0 && seen < limit; i = i - 1) {
            HtmlNode sib = sibs[i];
            if (!sib.IsElement()) { continue; }
            seen = seen + 1;
            if (CssSelector.MatchCompoundAt(sib, target, -1, -1)
                && CssSelector.MatchChain(sib, cx, idx - 1, failMemo)) { return true; }
            if (comb == 3) { break; }
        }
        if (failMemo != null && idx < 62) {
            long prev = 0L;
            failMemo.TryGetValue(node, out prev);
            failMemo[node] = prev | (1L << idx);
        }
        return false;
    }

    static bool MatchCompound(HtmlNode node, CssCompound c) {
        return CssSelector.MatchCompoundAt(node, c, -1, -1);
    }

    static bool MatchCompoundAt(HtmlNode node, CssCompound c, int elemIdx, int elemTotal) {
        if (c.unsupported) { return false; }
        if (c.hasTagFilter && node.tag != c.tag) { return false; }
        if (c.id.Length > 0 && node.GetIdFast() != c.id) { return false; }
        int clsCnt = c.classes.Count;
        if (clsCnt > 0) {
            for (int i = 0; i < clsCnt; i = i + 1) {
                if (!node.HasClass(c.classes[i])) { return false; }
            }
        }
        int attrCnt = c.attrs.Count;
        if (attrCnt > 0) {
            for (int i = 0; i < attrCnt; i = i + 1) {
                if (!CssSelector.MatchAttr(node, c.attrs[i])) { return false; }
            }
        }
        int psCnt = c.pseudos.Count;
        if (psCnt > 0) {
            for (int i = 0; i < psCnt; i = i + 1) {
                if (!CssSelector.MatchPseudoAt(node, c.pseudos[i], elemIdx, elemTotal)) { return false; }
            }
        }
        return true;
    }

    // ":not(...)" 用：只比类型/id/类/属性，不比伪类。
    static bool MatchSimple(HtmlNode node, CssCompound c) {
        if (c == null || c.unsupported) { return false; }
        if (c.hasTagFilter && node.tag != c.tag) { return false; }
        if (c.id.Length > 0 && node.GetIdFast() != c.id) { return false; }
        int clsCnt = c.classes.Count;
        for (int i = 0; i < clsCnt; i = i + 1) {
            if (!node.HasClass(c.classes[i])) { return false; }
        }
        int attrCnt = c.attrs.Count;
        for (int i = 0; i < attrCnt; i = i + 1) {
            if (!CssSelector.MatchAttr(node, c.attrs[i])) { return false; }
        }
        return true;
    }

    static bool MatchAttr(HtmlNode node, CssAttr a) {
        if (node.attrsMap == null) { return false; }
        string v;
        if (!node.attrsMap.TryGetValue(a.name, out v)) { return false; }
        int k = a.opKind;
        if (k == 0) { return true; }
        if (k == 1) { return v == a.value; }
        if (k == 2) { return CssSelector.ContainsWord(v, a.value); }
        if (k == 3) { return v == a.value || CssSelector.StartsWithDash(v, a.value); }
        if (k == 4) { return a.value.Length > 0 && v.StartsWith(a.value); }
        if (k == 5) { return a.value.Length > 0 && v.EndsWith(a.value); }
        if (k == 6) { return a.value.Length > 0 && v.Contains(a.value); }
        return false;
    }

    static bool MatchPseudoAt(HtmlNode node, CssPseudo p, int elemIdx, int elemTotal) {
        if (p.unsupported) { return false; }
        int pk = p.kind;
        if (pk == 1) {
            // :first-child
            if (node.Parent() == null) { return false; }
            if (elemIdx >= 0) { return elemIdx == 0; }
            return !CssSelector.HasPrevElementSibling(node);
        }
        if (pk == 2) {
            // :last-child
            if (node.Parent() == null) { return false; }
            if (elemIdx >= 0 && elemTotal >= 0) { return elemIdx == elemTotal - 1; }
            return !CssSelector.HasNextElementSibling(node);
        }
        if (pk == 3) {
            // :only-child
            if (node.Parent() == null) { return false; }
            if (elemIdx >= 0 && elemTotal >= 0) { return elemIdx == 0 && elemTotal == 1; }
            return !CssSelector.HasPrevElementSibling(node) && !CssSelector.HasNextElementSibling(node);
        }
        if (pk == 4) { return node.childList == null || node.childList.Count == 0; }
        if (pk == 5) { return node.ElementAncestorCount() == 0; }
        if (pk == 6) { return !CssSelector.MatchSimple(node, p.notCompound); }
        if (pk == 7 || pk == 8) {
            int idx1 = (pk == 8
                ? CssSelector.ElementTypeIndex(node)
                : (elemIdx >= 0 ? elemIdx : CssSelector.ElementIndex(node))) + 1;
            long idxL = (long)idx1;
            long aL = (long)p.nthA;
            long bL = (long)p.nthB;
            if (aL == 0L) { return idxL == bL; }
            if (aL > 0L) { return idxL >= bL && (idxL - bL) % aL == 0L; }
            return idxL <= bL && (bL - idxL) % (0L - aL) == 0L;
        }
        return false;
    }

    static bool HasPrevElementSibling(HtmlNode node) {
        HtmlNode parent = node.Parent();
        if (parent == null || parent.childList == null) { return false; }
        int limit = node.index;
        if (limit > parent.childList.Count) { limit = parent.childList.Count; }
        for (int i = limit - 1; i >= 0; i = i - 1) {
            if (parent.childList[i].IsElement()) { return true; }
        }
        return false;
    }

    static bool HasNextElementSibling(HtmlNode node) {
        HtmlNode parent = node.Parent();
        if (parent == null || parent.childList == null) { return false; }
        int cnt = parent.childList.Count;
        for (int i = node.index + 1; i < cnt; i = i + 1) {
            if (parent.childList[i].IsElement()) { return true; }
        }
        return false;
    }

    // 前面有多少个元素兄弟。
    static int ElementIndex(HtmlNode node) {
        HtmlNode parent = node.Parent();
        if (parent == null || parent.childList == null) { return 0; }
        int n = 0;
        int limit = node.index;
        if (limit > parent.childList.Count) { limit = parent.childList.Count; }
        for (int i = 0; i < limit; i = i + 1) {
            if (parent.childList[i].IsElement()) { n = n + 1; }
        }
        return n;
    }

    // 前面有多少个同名标签的元素兄弟（:nth-of-type 用）。
    static int ElementTypeIndex(HtmlNode node) {
        HtmlNode parent = node.Parent();
        if (parent == null || parent.childList == null) { return 0; }
        string tag = node.tag;
        int n = 0;
        int limit = node.index;
        if (limit > parent.childList.Count) { limit = parent.childList.Count; }
        for (int i = 0; i < limit; i = i + 1) {
            HtmlNode sib = parent.childList[i];
            if (sib.IsElement() && sib.tag == tag) { n = n + 1; }
        }
        return n;
    }

    // 值里是否含有整个单词（空白分隔，Span 原地字节比对零 Substring 分配）。
    static bool ContainsWord(string v, string word) {
        if (word == null || word.Length == 0) { return false; }
        int n = v.Length;
        int wl = word.Length;
        if (n < wl) { return false; }
        Span<byte> vb = new Span<byte>((nint)v, n);
        Span<byte> wb = new Span<byte>((nint)word, wl);
        int i = 0;
        while (i < n) {
            while (i < n && HtmlUtil.IsSpace(vb[i])) { i = i + 1; }
            int start = i;
            while (i < n && !HtmlUtil.IsSpace(vb[i])) { i = i + 1; }
            if (i - start == wl) {
                bool eq = true;
                for (int k = 0; k < wl; k = k + 1) {
                    if (vb[start + k] != wb[k]) { eq = false; break; }
                }
                if (eq) { return true; }
            }
        }
        return false;
    }

    // 值等于 word 或以 "word-" 开头（Span 零拼接分配）。
    static bool StartsWithDash(string v, string word) {
        if (word == null || word.Length == 0) { return false; }
        int wl = word.Length;
        int vl = v.Length;
        if (vl < wl) { return false; }
        if (vl == wl) { return v == word; }
        Span<byte> vb = new Span<byte>((nint)v, vl);
        if (vb[wl] != 45) { return false; }
        Span<byte> wb = new Span<byte>((nint)word, wl);
        for (int i = 0; i < wl; i = i + 1) {
            if (vb[i] != wb[i]) { return false; }
        }
        return true;
    }
}
