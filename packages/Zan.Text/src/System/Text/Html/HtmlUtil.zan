using System;

namespace System.Text.Html;

// HTML 文本处理的小工具：转义、实体解码、名字规范化、空元素判定。
//
// 全部按**字节**处理：Zan 的 string 索引取的是 UTF-8 字节
// （string.Length 就是字节数），所以扫描标签与转义都按字节走，
// 非 ASCII 的多字节序列原样透传，不会被拆坏。
public class HtmlUtil {
    // 空白字符（空格、制表、CR、LF）。
    public static bool IsSpace(int c) {
        return c == 32 || c == 9 || c == 13 || c == 10;
    }

    // 名字的首字符：字母。
    public static bool IsNameStart(int c) {
        return (c >= 97 && c <= 122) || (c >= 65 && c <= 90);
    }

    // 名字的后续字符：字母、数字、'-'、'_'，以及非 ASCII 字节。
    public static bool IsNameChar(int c) {
        if (c >= 97 && c <= 122) { return true; }
        if (c >= 65 && c <= 90) { return true; }
        if (c >= 48 && c <= 57) { return true; }
        if (c == 45 || c == 95) { return true; }
        if (c >= 128) { return true; }
        return false;
    }

    // 空元素（没有结束标签，也没有内容）。
    public static bool IsVoidTag(string tag) {
        if (tag == null || tag.Length == 0) { return false; }
        return tag == "area" || tag == "base" || tag == "br" || tag == "col"
            || tag == "embed" || tag == "hr" || tag == "img" || tag == "input"
            || tag == "link" || tag == "meta" || tag == "param" || tag == "source"
            || tag == "track" || tag == "wbr";
    }

    // 原始文本元素：内容按纯文本处理（不解析标签）。
    //
    // script/style 是 RAWTEXT（内容里的实体也不解码）；textarea/title
    // 是 RCDATA（标签照旧解析，实体照旧解码）。
    public static bool IsRawTextTag(string tag) {
        return tag == "script" || tag == "style";
    }

    public static bool IsEscapableRawTextTag(string tag) {
        return tag == "textarea" || tag == "title";
    }

    // 转义文本内容：& < > 。文本节点里出现这三个字符就必须转义，
    // 否则用户内容会被当成标记解析——这是消毒器最关键的一步。
    // 委托 stdlib 共享内核（控制字符原样保留）。
    public static string EscapeText(string text) {
        return Encoding.XmlEscape(text, false, false);
    }

    // 转义属性值：& < > " 。双引号必须转义（属性值用双引号包），
    // 单引号不用。委托 stdlib 共享内核。
    public static string EscapeAttr(string text) {
        return Encoding.XmlEscape(text, true, false);
    }

    static Dictionary<string, int> s_entities;

    static Dictionary<string, int> EntityMap() {
        if (HtmlUtil.s_entities == null) {
            Dictionary<string, int> m = new Dictionary<string, int>();
            m["amp"] = 38; m["lt"] = 60; m["gt"] = 62; m["quot"] = 34; m["apos"] = 39;
            m["colon"] = 58; m["sol"] = 47; m["Tab"] = 9; m["NewLine"] = 10; m["nbsp"] = 160;
            m["iexcl"] = 161; m["cent"] = 162; m["pound"] = 163; m["curren"] = 164; m["yen"] = 165;
            m["brvbar"] = 166; m["sect"] = 167; m["uml"] = 168; m["copy"] = 169; m["ordf"] = 170;
            m["laquo"] = 171; m["not"] = 172; m["shy"] = 173; m["reg"] = 174; m["macr"] = 175;
            m["deg"] = 176; m["plusmn"] = 177; m["sup2"] = 178; m["sup3"] = 179; m["acute"] = 180;
            m["micro"] = 181; m["para"] = 182; m["middot"] = 183; m["cedil"] = 184; m["sup1"] = 185;
            m["ordm"] = 186; m["raquo"] = 187; m["frac14"] = 188; m["frac12"] = 189; m["frac34"] = 190;
            m["iquest"] = 191; m["times"] = 215; m["divide"] = 247; m["ndash"] = 8211; m["mdash"] = 8212;
            m["lsquo"] = 8216; m["rsquo"] = 8217; m["sbquo"] = 8218; m["ldquo"] = 8220; m["rdquo"] = 8221;
            m["bdquo"] = 8222; m["dagger"] = 8224; m["bull"] = 8226; m["hellip"] = 8230; m["permil"] = 8240;
            m["prime"] = 8242; m["lsaquo"] = 8249; m["rsaquo"] = 8250; m["oline"] = 8254; m["frasl"] = 8260;
            m["euro"] = 8364; m["trade"] = 8482; m["larr"] = 8592; m["uarr"] = 8593; m["rarr"] = 8594;
            m["darr"] = 8595; m["harr"] = 8596; m["minus"] = 8722; m["ne"] = 8800; m["le"] = 8804;
            m["ge"] = 8805; m["nequiv"] = 8801; m["alpha"] = 945; m["beta"] = 946; m["gamma"] = 947;
            m["delta"] = 948; m["pi"] = 960; m["sigma"] = 963; m["omega"] = 969;
            m["agrave"] = 224; m["aacute"] = 225; m["acirc"] = 226; m["atilde"] = 227; m["auml"] = 228;
            m["aring"] = 229; m["aelig"] = 230; m["ccedil"] = 231; m["egrave"] = 232; m["eacute"] = 233;
            m["ecirc"] = 234; m["euml"] = 235; m["igrave"] = 236; m["iacute"] = 237; m["icirc"] = 238;
            m["iuml"] = 239; m["ntilde"] = 241; m["ograve"] = 242; m["oacute"] = 243; m["ocirc"] = 244;
            m["otilde"] = 245; m["ouml"] = 246; m["oslash"] = 248; m["ugrave"] = 249; m["uacute"] = 250;
            m["ucirc"] = 251; m["uuml"] = 252; m["yacute"] = 253; m["yuml"] = 255; m["szlig"] = 223;
            HtmlUtil.s_entities = m;
        }
        return HtmlUtil.s_entities;
    }

    // 解码 HTML 实体：命名实体（&amp; &lt; …）与数字实体（&#65; &#x41;）。
    // 无 '&' 时零分配直接返回原串；命中实体时用 StringView 切片冲刷。
    public static string DecodeEntities(string text) {
        if (text == null) { return ""; }
        int n = text.Length;
        if (n == 0) { return ""; }
        nint tp = (nint)text;
        int i = NativeMemory.Find(tp, 0, 38, n);
        if (i < 0) { return text; }

        StringBuilder sb = null;
        int start = 0;
        while (i >= 0 && i < n) {
            string rep = "";
            int used = 0;
            if (HtmlUtil.TryEntity(text, i, out rep, out used)) {
                if (sb == null) { sb = new StringBuilder(n); }
                if (i > start) { sb.Append(new StringView(tp + (nint)start, i - start)); }
                sb.Append(rep);
                i = i + used;
                start = i;
            } else {
                i = i + 1;
            }
            if (i >= n) { break; }
            i = NativeMemory.Find(tp, i, 38, n - i);
        }
        if (sb == null) { return text; }
        if (start < n) { sb.Append(new StringView(tp + (nint)start, n - start)); }
        return sb.ToString();
    }

    // 尝试从 at 处解析一个实体。成功时 rep 是替换文本、used 是消耗的
    // 字节数；失败时两者都不动（调用方保留原文）。
    public static bool TryEntity(string text, int at, out string rep, out int used) {
        rep = "";
        used = 0;
        int n = text.Length;
        if (at + 1 >= n) { return false; }
        int c = text[at + 1] & 255;
        if (c == 35) {   // '#'
            int p = at + 2;
            int radix = 10;
            if (p < n && (text[p] & 255) == 120) { radix = 16; p = p + 1; }
            else if (p < n && (text[p] & 255) == 88) { radix = 16; p = p + 1; }
            int digits = 0;
            int value = 0;
            bool overflow = false;
            while (p < n && digits < 8) {
                int d = text[p] & 255;
                int v = HtmlUtil.HexDigit(d);
                if (v < 0) { break; }
                if (radix == 10 && v > 9) { break; }
                if (value > 0x10FFFF) {
                    overflow = true;
                } else {
                    value = value * radix + v;
                }
                digits = digits + 1;
                p = p + 1;
            }
            if (digits == 0 || p >= n || (text[p] & 255) != 59) { return false; }
            if (overflow || value <= 0 || value > 0x10FFFF || (value >= 0xD800 && value <= 0xDFFF)) {
                rep = "\uFFFD";
            } else {
                rep = System.Text.Encoding.Utf8FromCodePoint(value);
            }
            used = p + 1 - at;
            return true;
        }
        // 命名实体：字母数字，最长 32 个字符，必须以 ';' 收尾。
        int q = at + 1;
        int len = 0;
        while (q < n && len < 32) {
            int d = text[q] & 255;
            if (!HtmlUtil.IsEntityChar(d)) { break; }
            q = q + 1;
            len = len + 1;
        }
        if (len == 0 || q >= n || (text[q] & 255) != 59) { return false; }
        // 高频 6 实体零分配字节直判（amp / lt / gt / quot / apos / nbsp）
        if (len == 2) {
            int c1 = text[at + 2] & 255;
            if (c == 108 && c1 == 116) { rep = "<"; used = 4; return true; }   // lt
            if (c == 103 && c1 == 116) { rep = ">"; used = 4; return true; }   // gt
        } else if (len == 3) {
            if (c == 97 && (text[at + 2] & 255) == 109 && (text[at + 3] & 255) == 112) {
                rep = "&"; used = 5; return true;                              // amp
            }
        } else if (len == 4) {
            int c1 = text[at + 2] & 255;
            int c2 = text[at + 3] & 255;
            int c3 = text[at + 4] & 255;
            if (c == 113 && c1 == 117 && c2 == 111 && c3 == 116) { rep = "\""; used = 6; return true; }      // quot
            if (c == 97 && c1 == 112 && c2 == 111 && c3 == 115) { rep = "'"; used = 6; return true; }        // apos
            if (c == 110 && c1 == 98 && c2 == 115 && c3 == 112) { rep = "\u00A0"; used = 6; return true; }   // nbsp
        }
        string name = text.Substring(at + 1, len);
        int cp = HtmlUtil.EntityCodePoint(name);
        if (cp < 0) { return false; }
        rep = System.Text.Encoding.Utf8FromCodePoint(cp);
        used = q + 1 - at;
        return true;
    }

    // 实体名里允许的字符：字母、数字。
    public static bool IsEntityChar(int c) {
        return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57);
    }

    // 十六进制数字的值（0-9 a-f A-F），非法返回 -1。
    public static int HexDigit(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 87; }
        if (c >= 65 && c <= 70) { return c - 55; }
        return -1;
    }

    // 常见命名实体对应的码点；未知实体返回 -1（O(1) 哈希查表）。
    public static int EntityCodePoint(string name) {
        if (name == null) { return -1; }
        int cp;
        if (HtmlUtil.EntityMap().TryGetValue(name, out cp)) { return cp; }
        return -1;
    }
}
