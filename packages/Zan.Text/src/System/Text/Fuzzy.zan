using System;

namespace System.Text;

// 模糊字符串匹配：用于符号/文件搜索的子序列打分（纯算法，不依赖平台）。
public class Fuzzy {
    public static bool SameByte(int a, int b) {
        if (a == b) { return true; }
        if (a >= 65 && a <= 90) { a = a + 32; }
        if (b >= 65 && b <= 90) { b = b + 32; }
        return a == b;
    }

    // 当 `query` 作为 `candidate` 的子序列出现时返回 true
    // （字符按顺序、忽略大小写）。
    public static bool Matches(string query, string candidate) {
        if (query == null || query.Length == 0) { return true; }
        if (candidate == null) { return false; }
        int qlen = query.Length;
        int clen = candidate.Length;
        if (qlen > clen) { return false; }
        Span<byte> qsp = new Span<byte>((nint)query, qlen);
        Span<byte> csp = new Span<byte>((nint)candidate, clen);
        int qi = 0;
        int qa = qsp[0] & 255;
        if (qa >= 65 && qa <= 90) { qa = qa + 32; }
        int slack = clen - qlen;
        for (int ci = 0; ci < clen; ci = ci + 1) {
            int ca = csp[ci] & 255;
            if (ca >= 65 && ca <= 90) { ca = ca + 32; }
            if (qa == ca) {
                qi = qi + 1;
                if (qi == qlen) { return true; }
                qa = qsp[qi] & 255;
                if (qa >= 65 && qa <= 90) { qa = qa + 32; }
            } else {
                slack = slack - 1;
                if (slack < 0) { return false; }
            }
        }
        return false;
    }

    // [0,1] 的相似度：完全匹配（忽略大小写）为 1.0，
    // 有间隔则递减。连续片段、词首和驼峰边界有加分
    // （因此对 "FileList"，"flst" 优于 "flts"）。
    // `query` 不是子序列时返回 0。单遍融合扫描，消除三遍重复遍历。
    public static double Score(string query, string candidate) {
        if (query == null || query.Length == 0) { return 1.0; }
        if (candidate == null || candidate.Length == 0) { return 0.0; }
        int qlen = query.Length;
        int clen = candidate.Length;
        if (qlen > clen) { return 0.0; }

        Span<byte> qsp = new Span<byte>((nint)query, qlen);
        Span<byte> csp = new Span<byte>((nint)candidate, clen);
        long score = 0L;
        int qi = 0;
        int run = 0;
        int qa = qsp[0] & 255;
        if (qa >= 65 && qa <= 90) { qa = qa + 32; }
        int slack = clen - qlen;
        for (int ci = 0; ci < clen; ci = ci + 1) {
            int rawC = csp[ci] & 255;
            int ca = (rawC >= 65 && rawC <= 90) ? (rawC + 32) : rawC;
            if (qa == ca) {
                run = run + 1;
                int gain = run >= 2 ? 2 : 1;
                if (run == 1) {
                    if (ci == 0) {
                        gain = 3;
                    } else {
                        int prevC = csp[ci - 1] & 255;
                        int pLow = prevC | 32;
                        int cLow = rawC | 32;
                        bool prevAlpha = (pLow >= 97 && pLow <= 122);
                        bool curAlpha = (cLow >= 97 && cLow <= 122);
                        if ((!prevAlpha && curAlpha) || ((prevC >= 97 && prevC <= 122) && (rawC >= 65 && rawC <= 90))) {
                            gain = 3;
                        }
                    }
                }
                score = score + (long)gain;
                qi = qi + 1;
                if (qi == qlen) {
                    if (qlen == clen) { return 1.0; }
                    return (double)score / ((double)qlen * 3.0);
                }
                qa = qsp[qi] & 255;
                if (qa >= 65 && qa <= 90) { qa = qa + 32; }
            } else {
                run = 0;
                slack = slack - 1;
                if (slack < 0) { return 0.0; }
            }
        }
        return 0.0;
    }

    // 判断 s[i] 是否落在词边界上：边界指紧跟非字母的字母，
    // 或紧邻大写字母的小写字母（驼峰）。i 为 0 视为词首，返回 true。
    public static bool IsBoundary(string s, int i) {
        if (i <= 0) { return true; }
        if (s == null || i >= s.Length) { return false; }
        int p = s[i - 1] & 255;
        int c = s[i] & 255;
        bool prevAlpha = (p >= 65 && p <= 90) || (p >= 97 && p <= 122);
        bool curAlpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
        if (!prevAlpha && curAlpha) { return true; }
        bool prevLower = (p >= 97 && p <= 122);
        bool curUpper = (c >= 65 && c <= 90);
        if (prevLower && curUpper) { return true; }
        return false;
    }

    // 判断是否为 ASCII 字母（A-Z、a-z），只看首字符的低 8 位。
    public static bool IsLetter(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        int c = ch[0] & 255;
        return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
    }

    // 判断是否为 ASCII 大写字母（A-Z），只看首字符的低 8 位。
    public static bool IsUpper(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        int c = ch[0] & 255;
        return c >= 65 && c <= 90;
    }

    // 判断是否为 ASCII 小写字母（a-z），只看首字符的低 8 位。
    public static bool IsLower(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        int c = ch[0] & 255;
        return c >= 97 && c <= 122;
    }

    // 忽略大小写比较两个单字符（转小写后判等）。
    public static bool SameChar(string a, string b) {
        if (a == null || b == null || a.Length == 0 || b.Length == 0) { return false; }
        return Fuzzy.SameByte(a[0] & 255, b[0] & 255);
    }

    // 区分大小写的字符串相等（`==` 的具名包装）。
    public static bool SameStr(string a, string b) {
        return a == b;
    }

    // 忽略大小写的相等（与 Matches 一样不区分大小写）。
    public static bool SameStrIgnoreCase(string a, string b) {
        if (a == null || b == null) { return a == b; }
        int len = a.Length;
        if (len != b.Length) { return false; }
        nint ap = (nint)a;
        nint bp = (nint)b;
        if (ap == bp) { return true; }
        Span<byte> asp = new Span<byte>(ap, len);
        Span<byte> bsp = new Span<byte>(bp, len);
        for (int i = 0; i < len; i = i + 1) {
            int ca = asp[i] & 255;
            int cb = bsp[i] & 255;
            if (ca != cb) {
                if (ca >= 65 && ca <= 90) { ca = ca + 32; }
                if (cb >= 65 && cb <= 90) { cb = cb + 32; }
                if (ca != cb) { return false; }
            }
        }
        return true;
    }
}
