using System;

namespace System.Text;

/// <summary>
/// 极简 CSV 读写器。字段可用引号包围；被引字段中的引号
/// 会写成两个（<c>""</c>）。引号只在字段开头才有特殊含义
/// （RFC 4180）。可指定自定义分隔符（如 TSV 用制表符）。
///
///   List<List<string>> rows = Csv.Parse(text);        // 逗号分隔
///   List<List<string>> tsv = Csv.Parse(text, "\t");
///   string out = Csv.Serialize(rows);                 // 逗号分隔，自动加引号
/// </summary>
class Csv {
    /// <summary>将 CSV 文本解析为字段行。末尾的空行
    /// 会被忽略；格式错误的引号按字面处理。</summary>
    static List<List<string>> Parse(string text) {
        return Csv.ParseSep(text, ",");
    }

    /// <summary>使用自定义分隔符（单个字符）解析。</summary>
    static List<List<string>> ParseSep(string text, string separator) {
        List<List<string>> rows = new List<List<string>>();
        if (text == null) { return rows; }
        List<string> row = new List<string>();
        StringBuilder field = new StringBuilder();
        bool inQuotes = false;
        int i = 0;
        int n = text.Length;
        int sep = (separator != null && separator.Length > 0) ? (separator[0] & 255) : 44;
        while (i < n) {
            int c = text[i] & 255;
            if (inQuotes) {
                if (c == 34) {
                    if (i + 1 < n && (text[i + 1] & 255) == 34) {
                        field.Append("\"");
                        i = i + 2;
                    } else {
                        inQuotes = false;
                        i = i + 1;
                    }
                } else {
                    int run = i;
                    while (run < n && (text[run] & 255) != 34) {
                        run = run + 1;
                    }
                    field.Append(text.Substring(i, run - i));
                    i = run;
                }
            } else {
                if (c == 34) {
                    inQuotes = true;
                    i = i + 1;
                } else if (c == sep) {
                    row.Add(field.ToString());
                    field.Clear();
                    i = i + 1;
                } else if (c == 13) {
                    i = i + 1;   // 跳过 CR；\n 结束本行
                } else if (c == 10) {
                    row.Add(field.ToString());
                    field.Clear();
                    rows.Add(row);
                    row = new List<string>();
                    i = i + 1;
                } else {
                    int run = i;
                    while (run < n) {
                        int rc = text[run] & 255;
                        if (rc == 34 || rc == sep || rc == 13 || rc == 10) { break; }
                        run = run + 1;
                    }
                    field.Append(text.Substring(i, run - i));
                    i = run;
                }
            }
        }
        // 结尾处无换行的剩余内容。
        if (field.Length > 0 || row.Count > 0) {
            row.Add(field.ToString());
            rows.Add(row);
        }
        return rows;
    }

    /// <summary>将行序列化为 CSV 文本，对包含分隔符、引号或
    /// 换行符的字段加引号。末尾以换行符结束。</summary>
    static string Serialize(List<List<string>> rows) {
        return Csv.SerializeSep(rows, ",");
    }

    /// <summary>使用自定义分隔符序列化。</summary>
    static string SerializeSep(List<List<string>> rows, string separator) {
        StringBuilder sb = new StringBuilder();
        for (int r = 0; r < rows.Count; r = r + 1) {
            List<string> row = rows[r];
            for (int c = 0; c < row.Count; c = c + 1) {
                if (c > 0) { sb.Append(separator); }
                sb.Append(Csv.Escape(row[c], separator));
            }
            sb.Append("\n");
        }
        return sb.ToString();
    }

    /// 按需给单个字段加引号：含分隔符、引号或换行时用引号包围，
    /// 字段内的引号写成两个；其余原样返回。
    static string Escape(string field, string separator) {
        if (field == null) { return ""; }
        int flen = field.Length;
        int sepChar = (separator != null && separator.Length == 1) ? (separator[0] & 255) : -1;
        bool needQuote = false;
        if (sepChar >= 0) {
            for (int i = 0; i < flen; i = i + 1) {
                int c = field[i] & 255;
                if (c == sepChar || c == 34 || c == 10 || c == 13) {
                    needQuote = true;
                    break;
                }
            }
        } else {
            if (separator != null && field.IndexOf(separator, 0) >= 0) { needQuote = true; }
            else if (field.IndexOf("\"", 0) >= 0 || field.IndexOf("\n", 0) >= 0 || field.IndexOf("\r", 0) >= 0) { needQuote = true; }
        }
        if (!needQuote) { return field; }
        StringBuilder sb = new StringBuilder();
        sb.Append("\"");
        int last = 0;
        for (int i = 0; i < flen; i = i + 1) {
            if ((field[i] & 255) == 34) {
                if (i > last) { sb.Append(field.Substring(last, i - last)); }
                sb.Append("\"\"");
                last = i + 1;
            }
        }
        if (last < flen) { sb.Append(field.Substring(last, flen - last)); }
        sb.Append("\"");
        return sb.ToString();
    }
}
