name = "Zan.Text"
version = "1.0.0"
description = "Text processing for Zan: Markdown renderer, pinyin conversion with bundled data table, CP936/GBK codec, fuzzy matching, text templates and tables, and the regex engine — no native dependencies"
author = "Zan Team"
license = "MIT"

[embed]
text/pinyin.txt = "src/System/Text/data/pinyin.txt" if Pinyin_
