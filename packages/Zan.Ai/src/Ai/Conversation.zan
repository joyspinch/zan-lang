using System;
using System.Collections.Generic;

namespace Ai;

// 多轮对话历史：按轮（user+assistant）与 token 预算裁剪，系统提示不占历史预算。
public class Conversation {
    private List<AiMessage> messages;
    private int budgetTokens;
    public string lastError;

    public Conversation() {
        this.messages = new List<AiMessage>();
        this.budgetTokens = 2000;
        this.lastError = "";
    }

    // <=0 表示不限预算。
    public void SetBudgetTokens(int tokens) {
        this.budgetTokens = tokens;
    }

    public int BudgetTokens() { return this.budgetTokens; }
    public int Count() { return this.messages.Count; }
    public List<AiMessage> Messages() { return this.messages; }

    public void Add(AiMessage message) {
        if (message == null) { return; }
        this.messages.Add(message);
        this.Trim();
    }

    public void AddUser(string content) {
        this.Add(AiMessage.User(content));
    }

    public void AddAssistant(string content) {
        this.Add(AiMessage.Assistant(content));
    }

    public void Clear() { this.messages.Clear(); }

    public int UsedTokens() {
        long sum = 0L;
        for (int i = 0; i < this.messages.Count; i = i + 1) {
            AiMessage msg = this.messages[i];
            if (msg == null) { continue; }
            sum = sum + (long)Chunking.EstimateTokens(msg.content);
        }
        if (sum > 2147483647L) { return 2147483647; }
        return (int)sum;
    }

    // 超预算时从最老完整轮开始裁剪，保住进行中或最新一轮。
    void Trim() {
        if (this.budgetTokens <= 0) { return; }
        int count = this.messages.Count;
        if (count == 0) { return; }

        int[] msgTokens = new int[count];
        long total = 0L;
        long budgetL = (long)this.budgetTokens;
        for (int idx = 0; idx < count; idx = idx + 1) {
            AiMessage msg = this.messages[idx];
            int t = msg == null ? 0 : Chunking.EstimateTokens(msg.content);
            msgTokens[idx] = t;
            total = total + (long)t;
        }
        if (total <= budgetL) { return; }

        int pending = -1;
        for (int i = count - 1; i >= 0; i = i - 1) {
            AiMessage mi = this.messages[i];
            if (mi == null || !mi.IsUser()) { continue; }
            bool answered = false;
            for (int j = i + 1; j < count; j = j + 1) {
                AiMessage mj = this.messages[j];
                if (mj != null && mj.IsAssistant()) { answered = true; break; }
            }
            if (!answered) { pending = i; }
            break;
        }
        int regionEnd = pending >= 0 ? pending : count;

        List<int> starts = new List<int>();
        int pos = regionEnd - 1;
        while (pos >= 0) {
            int j = pos;
            while (j >= 0 && (this.messages[j] == null || !this.messages[j].IsUser())) { j = j - 1; }
            if (j < 0) { break; }
            starts.Add(j);
            pos = j - 1;
        }

        int dropCount = 0;
        for (int k = starts.Count - 1; k >= 0; k = k - 1) {
            if (total <= budgetL) { break; }
            int start = starts[k];
            int end = k == 0 ? regionEnd - 1 : starts[k - 1] - 1;
            for (int j = start; j <= end; j = j + 1) {
                total = total - (long)msgTokens[j];
            }
            dropCount = end + 1;
        }

        int maxDrop = regionEnd;
        if (pending < 0 && starts.Count > 0) { maxDrop = starts[0]; }
        if (dropCount > maxDrop) { dropCount = maxDrop; }

        if (dropCount > 0) {
            int keep = count - dropCount;
            for (int k = 0; k < keep; k = k + 1) {
                this.messages[k] = this.messages[k + dropCount];
            }
            for (int k = count - 1; k >= keep; k = k - 1) {
                this.messages.RemoveAt(k);
            }
        }
    }

    public List<AiMessage> Build(string systemPrompt) {
        List<AiMessage> outp = new List<AiMessage>();
        if (systemPrompt != null && systemPrompt.Length > 0) {
            outp.Add(AiMessage.System(systemPrompt));
        }
        for (int i = 0; i < this.messages.Count; i = i + 1) {
            if (this.messages[i] != null) {
                outp.Add(this.messages[i]);
            }
        }
        return outp;
    }

    public string ToJson() {
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < this.messages.Count; i = i + 1) {
            AiMessage msg = this.messages[i];
            if (msg == null) { continue; }
            w.WriteStartObject();
            w.WriteProperty("role", msg.role == null ? "" : msg.role);
            w.WriteProperty("content", msg.content == null ? "" : msg.content);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        return w.ToJson();
    }

    public bool FromJson(string json) {
        if (json == null || json.Length == 0) {
            this.messages.Clear();
            return true;
        }
        try {
            JsonDoc doc = JsonDoc.Parse(json);
            if (doc == null || doc.KindAt(0) != 4) {
                this.lastError = "会话内容格式不对";
                return false;
            }
            List<AiMessage> parsed = new List<AiMessage>();
            int count = doc.Count(0);
            int p = doc.FirstChild(0);
            for (int i = 0; i < count; i = i + 1) {
                if (p < 0) { break; }
                if (doc.KindAt(p) == 5) {
                    parsed.Add(new AiMessage(doc.Str(p, "role", "user"),
                        doc.Str(p, "content", "")));
                }
                p = doc.NextSibling(p);
            }
            this.messages = parsed;
            return true;
        } catch (Exception _ex) {
            this.lastError = "会话内容无法解析: " + _ex.Message;
            return false;
        }
    }
}
