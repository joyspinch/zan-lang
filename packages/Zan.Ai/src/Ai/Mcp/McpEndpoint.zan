using System;

namespace Ai.Mcp;

// MCP 服务地址：把 base URL 拆成 scheme/host/port/path。
public class McpEndpoint {
    public string host;
    public int port;
    public string path;
    public bool tls;

    public McpEndpoint() {
        this.host = "";
        this.port = 0;
        this.path = "";
        this.tls = false;
    }

    public string Host() { return this.host; }
    public int Port() { return this.port; }
    public string Path() { return this.path; }
    public bool Tls() { return this.tls; }

    // 是否本机端点（127.0.0.1 / localhost / ::1）。MCP 服务端通常就跑
    // 在本机，所以这条要认。
    public bool Local() {
        return this.host == "127.0.0.1" || this.host == "localhost"
        || this.host == "::1";
    }

    // 请求路径：空路径补成 "/"（MCP 服务端的 JSON-RPC 入口在根）。
    public string RequestPath() {
        if (this.path == null || this.path.Length == 0) { return "/"; }
        return this.path;
    }

    // 解析 base URL。失败返回 null。
    //
    // 失败的情形：没有 scheme、host 为空、路径里有 userinfo（@）或
    // fragment（#）——后两者能骗过朴素的字符串拼接（把凭据或片段拼
    // 进请求行）。
    public static McpEndpoint Parse(string url) {
        if (url == null) { return null; }
        int rawLen = url.Length;
        if (rawLen < 8) { return null; }
        nint up = (nint)url;
        Span<byte> sp = new Span<byte>(up, rawLen);
        int start = 0;
        int end = rawLen;
        while (start < end) {
            int c = (int)sp[start];
            if (c != 32 && (c < 9 || c > 13)) { break; }
            start = start + 1;
        }
        while (end > start) {
            int c = (int)sp[end - 1];
            if (c != 32 && (c < 9 || c > 13)) { break; }
            end = end - 1;
        }
        int len = end - start;
        if (len < 8) { return null; }
        bool tls = true;
        int port = 443;
        int authStart = start;
        if (sp[start] == 104 && sp[start + 1] == 116 && sp[start + 2] == 116
            && sp[start + 3] == 112 && sp[start + 4] == 115 && sp[start + 5] == 58
            && sp[start + 6] == 47 && sp[start + 7] == 47) {
            authStart = start + 8;
        } else if (sp[start] == 104 && sp[start + 1] == 116 && sp[start + 2] == 116
            && sp[start + 3] == 112 && sp[start + 4] == 58 && sp[start + 5] == 47
            && sp[start + 6] == 47) {
            authStart = start + 7;
            tls = false;
            port = 80;
        } else {
            return null;
        }

        // 单遍扫描校验非法字符、authority 中的 '@'/'?' 并定位首个 '/' 与 ':'。
        int slash = -1;
        int query = -1;
        int firstColon = -1;
        int lastColon = -1;
        bool hostSafeBeforeColon = true;
        for (int i = authStart; i < end; i = i + 1) {
            int c = (int)sp[i];
            if (c <= 32 || c >= 127 || c == 35 || c == 92) {
                return null;
            }
            if (slash < 0) {
                if (c == 47) { slash = i; }
                else if (c == 64 || c == 63) { return null; }
                else if (c == 58) {
                    if (firstColon < 0) { firstColon = i; }
                    lastColon = i;
                } else if (firstColon < 0 && hostSafeBeforeColon) {
                    bool ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                        || (c >= 97 && c <= 122) || c == 45 || c == 46;
                    if (!ok) { hostSafeBeforeColon = false; }
                }
            } else if (c == 63 && query < 0) {
                query = i;
            }
        }

        int hpEnd = slash >= 0 ? slash : end;
        if (hpEnd <= authStart) { return null; }

        int hostStart = authStart;
        int hostEnd = hpEnd;
        if (sp[authStart] == 91) {
            int rb = -1;
            for (int i = authStart + 1; i < hpEnd; i = i + 1) {
                if (sp[i] == 93) { rb = i; break; }
            }
            if (rb <= authStart + 1) { return null; }
            for (int i = authStart + 1; i < rb; i = i + 1) {
                int c = (int)sp[i];
                bool ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 70)
                    || (c >= 97 && c <= 102) || c == 58 || c == 46;
                if (!ok) { return null; }
            }
            hostStart = authStart + 1;
            hostEnd = rb;
            if (rb + 1 < hpEnd) {
                if (sp[rb + 1] != 58) { return null; }
                port = McpEndpoint.ParsePortSpan(sp, rb + 2, hpEnd, port);
            }
        } else {
            if (!hostSafeBeforeColon) { return null; }
            if (firstColon >= 0) {
                if (firstColon == authStart || firstColon != lastColon) { return null; }
                hostEnd = firstColon;
                port = McpEndpoint.ParsePortSpan(sp, firstColon + 1, hpEnd, port);
            }
        }
        if (hostEnd <= hostStart) { return null; }

        string pathStr = "";
        if (slash >= 0) {
            int pathEnd = end;
            if (query < 0) {
                while (pathEnd > slash && sp[pathEnd - 1] == 47) {
                    pathEnd = pathEnd - 1;
                }
            }
            if (pathEnd > slash) {
                pathStr = NativeMemory.GetString(up, slash, pathEnd - slash);
            }
        }

        McpEndpoint e = new McpEndpoint();
        e.tls = tls;
        e.port = port;
        e.host = NativeMemory.GetString(up, hostStart, hostEnd - hostStart);
        e.path = pathStr;
        return e;
    }

    // 端口解析：全数字且在 1..65535 之间才认，否则回落到默认值（防超长串溢出）。
    private static int ParsePortSpan(Span<byte> sp, int start, int end, int dflt) {
        int n = end - start;
        if (n <= 0 || n > 5) { return dflt; }
        int p = 0;
        for (int i = start; i < end; i = i + 1) {
            int c = (int)sp[i];
            if (c < 48 || c > 57) { return dflt; }
            p = p * 10 + (c - 48);
        }
        if (p < 1 || p > 65535) { return dflt; }
        return p;
    }
}
