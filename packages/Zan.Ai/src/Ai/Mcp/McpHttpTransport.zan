using System;
using System.Net.External;
using System.Net.Http;
using System.Net.Http.Client;

namespace Ai.Mcp;

// MCP 的 HTTP 传输（Streamable HTTP 那一半：POST 一段 JSON-RPC）。
//
// ## 为什么只有 HTTP
//
// 此实现负责 HTTP；其它传输通过 McpTransportFn 注入。
//
// ## 出网预算
//
// 与 `AiClient` 同一套纪律：连接/读/总超时都有限额，请求与响应有
// 体积上限，**不重试**——`tools/call` 不是幂等的，重试可能把一个
// 有副作用的工具执行两遍。本机端点放行（MCP 服务端通常跑在本机）。
//
// ## 鉴权
//
// 两种都发：`Authorization: Bearer <token>` 是标准写法，`X-Api-Key`
// 是很多 MCP 网关的写法。服务端认哪个是服务端的事；两边都发最多是
// 多一个头。token 为空就都不发（本地无鉴权的服务端）。
public class McpHttpTransport {
    private HttpClient http;
    private string path;
    private int connectMs;
    private int readMs;
    private int totalMs;
    private bool localEndpoint;

    public McpHttpTransport(McpEndpoint ep, string token) {
        this.connectMs = 10000;
        this.readMs = 30000;
        this.totalMs = 60000;
        if (ep.Tls()) {
            this.http = HttpClient.CreateHttps(ep.Host(), ep.Port());
        } else {
            this.http = new HttpClient(ep.Host(), ep.Port());
        }
        this.path = ep.RequestPath();
        this.http.SetHeader("Content-Type", "application/json");
        this.http.SetHeader("Accept", "application/json");
        // 协议版本头：MCP 2025-06-18 要求握手之后的每个请求都带上它。
        this.http.SetHeader("MCP-Protocol-Version", McpClient.ProtocolVersion());
        if (token != null && token.Length > 0) {
            this.http.SetHeader("Authorization", "Bearer " + token);
            this.http.SetHeader("X-Api-Key", token);
        }
        this.localEndpoint = ep.Local();
        this.ApplyPolicy();
    }

    // 首次请求前配置；HttpClient 使用后冻结策略，失败时保留原配置。
    public void SetTimeouts(int connectMs, int readMs, int totalMs) {
        ExternalCallPolicy policy = this.CreatePolicy(connectMs, readMs, totalMs);
        this.http.SetCallPolicy(policy);
        this.connectMs = connectMs;
        this.readMs = readMs;
        this.totalMs = totalMs;
    }

    void ApplyPolicy() {
        this.http.SetCallPolicy(this.CreatePolicy(this.connectMs, this.readMs, this.totalMs));
    }

    private ExternalCallPolicy CreatePolicy(int connectMs, int readMs, int totalMs) {
        ExternalCallPolicy p = ExternalCallPolicy.Default()
            .ConnectTimeout(connectMs)
            .ReadTimeout(readMs)
            .TotalTimeout(totalMs)
            .RequestLimit(4 * 1024 * 1024)
            .ResponseLimit(8 * 1024 * 1024)
            .ErrorLimit(64 * 1024)
            .Redirects(0)
            .RetryNetwork(false)
            .RetryAttempts(0);
        if (this.localEndpoint) { p.AllowLocalHttp(); }
        return p;
    }

    // 发一次 JSON-RPC 请求。
    //
    // 传输层失败（连不上、超时）**抛异常**——`HttpClient` 就是这个
    // 约定（`HttpRequestException`）。客户端那一层会兜住并转成
    // `lastError`，不会让异常飞到调用方。
    public async McpTransportResult Send(string requestJson) {
        HttpResponse resp = await this.http.SendAsync("POST", this.path, requestJson);
        return new McpTransportResult(resp.statusCode, resp.body);
    }

    // 关闭客户端持有的连接池。
    public void Close() {
        this.http.Close();
    }
}
