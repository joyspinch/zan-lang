using System;
using System.Json;
using System.Net.Http;

namespace Ai;

// OpenAI 兼容 /v1/embeddings 客户端：按响应 index 归位并校验所有向量维度一致。
public class Embeddings {
    // 向量化一批文本（normalize=true 时原地归一化到单位长度）；失败返回 null 并写 client.lastError。
    public static async AiEmbedding Embed(AiClient client, List<string> texts,
    bool normalize) {
        if (client == null) { return null; }
        if (texts == null || texts.Count == 0) {
            return new AiEmbedding(new List<List<double>>(), 0, new AiUsage());
        }
        AiEndpoint ep = AiEndpoint.Parse(client.config.baseUrl);
        if (ep == null) {
            client.lastError = "服务地址不合法: " + client.config.baseUrl;
            return null;
        }
        if (client.config.model.Length == 0) {
            client.lastError = "没有指定嵌入模型";
            return null;
        }

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("model", client.config.model);
        w.WritePropertyName("input");
        w.WriteStartArray();
        for (int i = 0; i < texts.Count; i = i + 1) {
            string t = texts[i] == null ? "" : texts[i];
            w.WriteString(t);
        }
        w.WriteEndArray();
        w.WriteEndObject();

        string raw = await client.PostJson(ep, "/embeddings", w.ToJson());
        if (raw == null) { return null; }
        return Embeddings.ParseResponse(client, raw, texts.Count, normalize);
    }

    // 解析 /v1/embeddings JSON 响应（按 index 归位并校验同维）；失败返回 null 并写 client.lastError。
    public static AiEmbedding ParseResponse(AiClient client, string raw,
    int expected, bool normalize) {
        if (client == null) { return null; }
        if (expected < 0) {
            client.lastError = "嵌入期望数量非法";
            return null;
        }
        if (raw == null || raw.Length == 0) {
            client.lastError = "嵌入服务返回的内容无法解析";
            return null;
        }
        // JsonDoc.Parse 扁平线性解析，零多余树状堆分配与垃圾回收开销
        JsonDoc doc = null;
        try {
            doc = JsonDoc.Parse(raw);
        } catch (Exception e) {
            client.lastError = "嵌入服务返回的内容无法解析";
            return null;
        }
        if (doc == null || doc.root < 0) {
            client.lastError = "嵌入服务返回的内容无法解析";
            return null;
        }
        string errMsg = AiClient.ErrorMessage(doc);
        if (errMsg.Length > 0) {
            client.lastError = errMsg;
            return null;
        }
        int data = doc.Get(doc.root, "data");
        if (data < 0 || doc.KindAt(data) != 4 || doc.Count(data) == 0) {
            client.lastError = "嵌入服务没有返回向量";
            return null;
        }

        // 按 index 归位（不靠数组顺序）。
        List<List<double>> slots = new List<List<double>>();
        for (int i = 0; i < expected; i = i + 1) {
            slots.Add(null);
        }
        int dims = 0;
        int dataCount = doc.Count(data);
        int itemNode = doc.FirstChild(data);
        for (int i = 0; i < dataCount; i = i + 1) {
            if (itemNode < 0) { break; }
            int at = doc.IntAt(doc.Get(itemNode, "index"), i);
            int vecNode = doc.Get(itemNode, "embedding");
            if (vecNode >= 0 && doc.KindAt(vecNode) == 4) {
                int vecLen = doc.Count(vecNode);
                List<double> v = new List<double>();
                v.Reserve(vecLen);
                int elemNode = doc.FirstChild(vecNode);
                for (int k = 0; k < vecLen; k = k + 1) {
                    if (elemNode < 0) { break; }
                    v.Add(doc.DoubleAt(elemNode, 0.0));
                    elemNode = doc.NextSibling(elemNode);
                }
                if (dims == 0) { dims = v.Count; }
                else if (v.Count != dims) {
                    client.lastError = "嵌入服务返回的向量维度不一致（"
                    + Convert.ToString(dims) + " vs " + Convert.ToString(v.Count) + "）";
                    return null;
                }
                if (at >= 0 && at < slots.Count) {
                    slots[at] = v;
                }
            }
            itemNode = doc.NextSibling(itemNode);
        }
        // 有槽位没填上 → 响应不完整。
        for (int i = 0; i < slots.Count; i = i + 1) {
            if (slots[i] == null) {
                client.lastError = "嵌入服务没有返回第 " + Convert.ToString(i)
                + " 个向量";
                return null;
            }
        }
        if (normalize) {
            for (int i = 0; i < slots.Count; i = i + 1) {
                Embeddings.Normalize(slots[i]);
            }
        }
        return new AiEmbedding(slots, dims, Embeddings.Usage(doc));
    }

    // 从响应里取用量（服务端给了就用服务端的，否则用估算）。
    private static AiUsage Usage(JsonDoc doc) {
        if (doc == null || doc.root < 0) { return new AiUsage(); }
        int u = doc.Get(doc.root, "usage");
        if (u < 0) { return new AiUsage(); }
        int p = doc.IntAt(doc.Get(u, "prompt_tokens"), 0);
        int t = doc.IntAt(doc.Get(u, "total_tokens"), 0);
        if (p <= 0 && t <= 0) { return new AiUsage(); }
        return new AiUsage(p > 0 ? p : t, 0, false);
    }

    // 向量化（不归一化）。
    public static async AiEmbedding Embed(AiClient client, List<string> texts) {
        return await Embeddings.Embed(client, texts, false);
    }

    // 向量化一组块（分块 → 向量），块的顺序与向量顺序一一对应。
    public static async AiEmbedding EmbedChunks(AiClient client,
    List<AiChunk> chunks, bool normalize) {
        if (chunks == null) { return null; }
        List<string> texts = new List<string>();
        for (int i = 0; i < chunks.Count; i = i + 1) {
            AiChunk c = chunks[i];
            texts.Add((c != null && c.text != null) ? c.text : "");
        }
        return await Embeddings.Embed(client, texts, normalize);
    }

    // 就地归一化到单位长度。零向量与非有限向量保持不变（除零/NaN 会污染后续检索）。
    public static void Normalize(List<double> v) {
        if (v == null || v.Count == 0) { return; }
        double sum = 0.0;
        for (int i = 0; i < v.Count; i = i + 1) {
            sum = sum + v[i] * v[i];
        }
        if (!(sum > 0.0 && sum <= 1.0e308)) { return; }
        double inv = 1.0 / Math.Sqrt(sum);
        for (int i = 0; i < v.Count; i = i + 1) {
            v[i] = v[i] * inv;
        }
    }
}
