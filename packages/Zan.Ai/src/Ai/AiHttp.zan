using System;
using System.Collections.Generic;
using System.Json;
using System.Net.External;
using System.Net.Http;
using System.Net.Http.Client;

namespace Ai;

internal class AiPostResult {
    public string body;
    public string error;

    public AiPostResult(string body, string error) {
        this.body = body;
        this.error = error;
    }
}

// 两个客户端共用连接缓存、POST 重试和错误解析，协议各自配置。
internal class AiHttp : IDisposable {
    // 按端点复用连接池。流式通路以 Canonical + "|sse" 区分。
    private Dictionary<string, HttpClient> clients;

    public AiHttp() {
        this.clients = new Dictionary<string, HttpClient>();
    }

    // 关闭所有出网连接（进程退出前或长寿命客户端空闲时调用）。
    //
    // 不关的话，池子里的 keep-alive 连接会一直挂着到进程退出——服务端
    // 那边也是（半开连接）。
    public void Close() {
        List<string> keys = this.clients.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            this.clients[keys[i]].Close();
        }
        this.clients.Clear();
    }

    public void Dispose() { this.Close(); }

    // 从缓存取连接；没有返回 null。
    public HttpClient CacheGet(string key) {
        HttpClient http = null;
        if (this.clients.TryGetValue(key, out http)) { return http; }
        return null;
    }

    // 出网预算。响应与请求体都有上限，超限的响应不会进内存。
    public static ExternalCallPolicy BuildPolicy(AiConfig config, AiEndpoint ep) {
        ExternalCallPolicy p = ExternalCallPolicy.Default()
            .ConnectTimeout(config.connectTimeoutMs)
            .ReadTimeout(config.readTimeoutMs)
            .TotalTimeout(config.totalTimeoutMs)
            .RequestLimit(config.requestLimitBytes)
            .ResponseLimit(config.responseLimitBytes)
            .ErrorLimit(128 * 1024)
            .Redirects(0)
            .RetryNetwork(false)
            .RetryAttempts(0);
        if (ep.Local()) { p.AllowLocalHttp(); }
        return p;
    }

    // 连接入缓存（客户端在设置完鉴权/策略头之后调用）。
    public void CachePut(string key, HttpClient http) {
        this.clients[key] = http;
    }

    // 新建一个裸 HttpClient（按端点选 TLS/明文），**不入缓存**——
    // 头与调用策略由调用方设置完再 CachePut。
    public HttpClient CreateClient(AiEndpoint ep) {
        if (ep.Tls()) {
            return HttpClient.CreateHttps(ep.Host(), ep.Port());
        }
        return new HttpClient(ep.Host(), ep.Port());
    }

    // 先验请求体，再在每次尝试内解析连接和路径，让初始化异常也走重试。
    public async AiPostResult Post(AiConfig config, string payload, string scope,
                                   Func<HttpClient> getClient, Func<string> getPath) {
        if (payload.Length > config.requestLimitBytes) {
            return new AiPostResult(null, "请求体超过上限（"
                + config.requestLimitBytes.ToString() + " 字节）");
        }
        int attempts = config.maxAttempts;
        if (attempts < 1) { attempts = 1; }
        string lastReason = "";
        int wait = 100;
        for (int attempt = 0; attempt < attempts; attempt = attempt + 1) {
            if (attempt > 0) {
                await Task.Delay(wait);
                wait = Math.Min(wait * 2, 2000);
            }
            try {
                HttpClient http = getClient();
                HttpResponse resp = await http.SendAsync("POST", getPath(), payload);
                int status = resp.statusCode;
                string bodyText = resp.body;
                if (status >= 200 && status < 300) {
                    return new AiPostResult(bodyText, null);
                }
                if (status < 500) {
                    return new AiPostResult(null, AiHttp.HttpErrorMessage(status, bodyText, scope));
                }
                lastReason = scope + " 服务返回 " + status.ToString();
            } catch (Exception e) {
                lastReason = "请求 " + scope + " 服务失败：" + e.Message;
            }
        }
        return new AiPostResult(null, lastReason);
    }

    // 从 HTTP 响应里提错误文案（4xx 时的解释）。响应体是 OpenAI 兼容
    // 错误形状（{"error":{"message":...}}）就取 message，否则用
    // "<scope> 服务返回 <status>" 兜底。
    public static string HttpErrorMessage(int status, string body, string scope) {
        string detail = "";
        if (body != null && body.Length > 0) {
            JsonDoc doc = null;
            try {
                doc = JsonDoc.Parse(body);
            } catch (Exception e) {
                doc = null;
            }
            if (doc != null && doc.root >= 0) {
                detail = AiClient.ErrorMessage(doc);
            }
        }
        if (detail.Length == 0) {
            detail = scope + " 服务返回 " + status.ToString();
        }
        return detail;
    }
}
