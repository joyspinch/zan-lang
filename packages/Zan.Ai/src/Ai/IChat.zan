using System;
using System.Collections.Generic;

namespace Ai;

// 对话后端统一契约：以协议无关的 AiMessage/AiTool 实体隔离 OpenAI 与 Anthropic 线格式差异。
// 非流式失败返回 null（原因在 LastError()），不使用异常传递业务失败。
public interface IChat {
    // 多轮补全（复制初始 messages，不修改调用方列表）；失败返回 null。
    async string CompleteMessages(List<AiMessage> messages, double temperature,
    string stop);

    // 带工具声明的补全，返回单轮结果（AiToolTurn）；失败返回 null。
    async AiToolTurn CompleteWithTools(List<AiMessage> messages, List<AiTool> tools,
    double temperature);

    // 流式补全（带工具）：逐事件推给 onEvent；回调返回 false 主动中止（不算失败）。
    // 与非流式不同，流式总是返回 AiStreamResult 保留已收到的半截内容，错误记在 error 与 LastError()。
    async AiStreamResult StreamWithTools(List<AiMessage> messages, List<AiTool> tools,
    double temperature, AiStreamFn onEvent);

    // 上一次失败的原因（成功时为空串）。
    string LastError();

    // 关掉出网连接（进程退出前或长寿命客户端空闲时调用）。
    void Close();
}
