using System;
using System.Collections.Generic;
using System.Text;

namespace Ai;

// 后端无关 RAG 编排：分块 -> 向量化 -> 检索 -> 可选重排 -> 生成；失败返回 null/-1 并写 lastError。
public class Rag {
    private AiClient client;
    private IRetriever retriever;
    private IIndexWriter writer;
    private IReranker reranker;
    private int chunkChars;
    private int chunkOverlap;
    private string template;
    private int topK;
    private int recallK;
    public string lastError;
    public string rerankError;

    public Rag(AiClient client, IRetriever retriever, IIndexWriter writer) {
        this.client = client;
        this.retriever = retriever;
        this.writer = writer;
        this.reranker = null;
        this.chunkChars = 800;
        this.chunkOverlap = 120;
        this.topK = 4;
        this.recallK = 0;
        this.template = Rag.DefaultTemplate();
        this.lastError = "";
        this.rerankError = "";
    }

    public void SetChunking(int maxChars, int overlap) {
        this.chunkChars = maxChars;
        this.chunkOverlap = overlap;
    }

    public void SetTopK(int k) {
        if (k < 1) { k = 1; }
        this.topK = k;
    }

    public void SetReranker(IReranker reranker, int recallK) {
        this.reranker = reranker;
        this.recallK = recallK;
    }

    private int RecallK() {
        if (this.reranker == null) { return this.topK; }
        int want = this.recallK;
        if (want < this.topK) { want = this.topK; }
        if (want < 20) { want = 20; }
        return want;
    }

    public void SetTemplate(string t) {
        this.template = t == null ? Rag.DefaultTemplate() : t;
    }

    public static string DefaultTemplate() {
        return "请只依据下面的资料回答问题。资料里没有的信息，直接说"
        + "「资料中未提及」，不要用你自己的知识补全。\n\n"
        + "资料：\n{{context}}\n\n问题：{{question}}\n\n回答：";
    }

    public async int Index(string document) {
        this.lastError = "";
        if (this.writer == null) { this.lastError = "没有写入器"; return -1; }
        if (this.client == null) { this.lastError = "没有客户端"; return -1; }
        List<AiChunk> chunks = Chunking.Recursive(document, this.chunkChars, this.chunkOverlap);
        if (chunks.Count == 0) { this.lastError = "文档为空"; return -1; }

        List<string> texts = new List<string>();
        for (int i = 0; i < chunks.Count; i = i + 1) {
            texts.Add(chunks[i].text);
        }
        AiEmbedding emb = await Embeddings.EmbedChunks(this.client, chunks, true);
        if (emb == null) {
            this.lastError = "向量化失败：" + this.client.lastError;
            return -1;
        }
        List<int> ids = await this.writer.Write(texts, emb.vectors, null);
        if (ids == null) {
            this.lastError = "入库失败：" + this.writer.LastError();
            return -1;
        }
        return ids.Count;
    }

    public async RagAnswer Ask(string question) {
        return await this.AskIn(question, null);
    }

    // 多轮问答：仅当前问题进检索，历史只进提示词，成功后再成对写入历史。
    public async RagAnswer AskIn(string question, Conversation conversation) {
        this.lastError = "";
        if (this.client == null) { this.lastError = "没有客户端"; return null; }
        if (this.retriever == null) { this.lastError = "没有检索器"; return null; }
        if (question == null || question.Length == 0) {
            this.lastError = "问题为空";
            return null;
        }

        List<string> one = new List<string>();
        one.Add(question);
        AiEmbedding qemb = await Embeddings.Embed(this.client, one, true);
        if (qemb == null) {
            this.lastError = "查询向量化失败：" + this.client.lastError;
            return null;
        }

        int want = this.RecallK();
        List<RetrieverHit> hits = await this.retriever.SearchAsync(qemb.At(0), question, want);
        if (hits == null || hits.Count == 0) {
            this.lastError = "没有检索到相关资料";
            return null;
        }

        List<string> texts = new List<string>();
        for (int i = 0; i < hits.Count; i = i + 1) {
            texts.Add(await this.retriever.TextOfAsync(hits[i].id));
        }

        this.rerankError = "";
        if (this.reranker != null && hits.Count > 1) {
            List<RerankHit> ranked = await this.reranker.Rerank(question, texts, 0);
            if (ranked == null || ranked.Count == 0) {
                this.rerankError = "重排失败（已降级为不重排）：" + this.reranker.LastError();
                hits = Rag.Take<RetrieverHit>(hits, this.topK);
                texts = Rag.Take<string>(texts, this.topK);
            } else {
                List<RetrieverHit> reorderedHits = new List<RetrieverHit>();
                List<string> reorderedTexts = new List<string>();
                Rag.ApplyRerank(hits, texts, ranked, this.topK, reorderedHits, reorderedTexts);
                hits = reorderedHits;
                texts = reorderedTexts;
            }
        } else {
            hits = Rag.Take<RetrieverHit>(hits, this.topK);
            texts = Rag.Take<string>(texts, this.topK);
        }

        RagAnswer answer = new RagAnswer();
        answer.question = question;
        StringBuilder ctx = new StringBuilder();
        for (int i = 0; i < hits.Count; i = i + 1) {
            string text = texts[i];
            RagCitation cite = new RagCitation();
            cite.id = hits[i].id;
            cite.text = text;
            cite.score = hits[i].score;
            cite.vectorRank = hits[i].vectorRank;
            cite.bm25Rank = hits[i].bm25Rank;
            answer.citations.Add(cite);
            if (i > 0) { ctx.Append("\n---\n"); }
            ctx.Append(text);
        }
        answer.context = ctx.ToString();

        string prompt = Rag.RenderPrompt(this.template, answer.context, question);
        string reply = "";
        if (conversation == null) {
            reply = await this.client.Complete("", prompt);
        } else {
            List<AiMessage> msgs = conversation.Build("");
            msgs.Add(AiMessage.User(prompt));
            reply = await this.client.CompleteMessages(msgs, 0.0, "");
        }
        if (reply == null) {
            this.lastError = "生成失败：" + this.client.lastError;
            return null;
        }
        answer.text = reply;

        if (conversation != null) {
            conversation.AddUser(prompt);
            conversation.AddAssistant(reply);
        }
        return answer;
    }

    static List<T> Take<T>(List<T> items, int n) {
        if (n <= 0 || items.Count <= n) { return items; }
        List<T> outp = new List<T>();
        for (int i = 0; i < n; i = i + 1) { outp.Add(items[i]); }
        return outp;
    }

    // 保留原 RRF score，按重排下标同步对齐命中与文本并补齐未打分项。
    static void ApplyRerank(List<RetrieverHit> hits, List<string> texts,
                            List<RerankHit> ranked, int topK,
                            List<RetrieverHit> outHits, List<string> outTexts) {
        int n = hits.Count;
        bool[] used = new bool[n];
        for (int i = 0; i < ranked.Count; i = i + 1) {
            if (topK > 0 && outHits.Count >= topK) { return; }
            int at = ranked[i].index;
            if (at < 0 || at >= n || used[at]) { continue; }
            used[at] = true;
            outHits.Add(hits[at]);
            outTexts.Add(at < texts.Count ? texts[at] : "");
        }
        for (int i = 0; i < n; i = i + 1) {
            if (topK > 0 && outHits.Count >= topK) { return; }
            if (!used[i]) {
                outHits.Add(hits[i]);
                outTexts.Add(i < texts.Count ? texts[i] : "");
            }
        }
    }

    // 单遍同时替换 {{context}} 与 {{question}}，避免检索结果内的占位符被二次展开。
    static string RenderPrompt(string template, string context, string question) {
        if (template == null || template.Length == 0) { return ""; }
        string ctx = context == null ? "" : context;
        string q = question == null ? "" : question;
        StringBuilder sb = new StringBuilder();
        int at = 0;
        while (at < template.Length) {
            int hc = template.IndexOf("{{context}}", at);
            int hq = template.IndexOf("{{question}}", at);
            if (hc < 0 && hq < 0) {
                sb.Append(template.Substring(at));
                break;
            }
            if (hc >= 0 && (hq < 0 || hc < hq)) {
                sb.Append(template.Substring(at, hc - at));
                sb.Append(ctx);
                at = hc + 11;
            } else {
                sb.Append(template.Substring(at, hq - at));
                sb.Append(q);
                at = hq + 12;
            }
        }
        return sb.ToString();
    }

    public static string ReplaceToken(string text, string token, string value) {
        if (text == null || token == null) { return ""; }
        if (token.Length == 0) { return text; }
        int hit = text.IndexOf(token, 0);
        if (hit < 0) { return text; }
        StringBuilder sb = new StringBuilder();
        string rep = value == null ? "" : value;
        int at = 0;
        while (hit >= 0) {
            sb.Append(text.Substring(at, hit - at));
            sb.Append(rep);
            at = hit + token.Length;
            hit = text.IndexOf(token, at);
        }
        sb.Append(text.Substring(at));
        return sb.ToString();
    }
}

