using System;
using System.Collections.Generic;
using System.Json;
using System.Net.Http.Client;
using System.Net.Sse;
using System.Text;

namespace Ai;

// 流式回调：返回 false 表示调用方主动停止（stopped=true，error 为空）。
public delegate bool AiStreamFn(AiStreamEvent e);
public delegate List<AiStreamEvent> AiStreamParserFn(string payload);

class AiToolSlot {
    public int index;
    public string id;
    public string name;
    public StringBuilder args;

    public AiToolSlot(int index) {
        this.index = index;
        this.id = "";
        this.name = "";
        this.args = new StringBuilder();
    }
}

// SSE 流式内核：收流、帧翻译与工具调用增量拼装；已收到的半截内容始终交回。
public class AiStream {
    public static async AiStreamResult Pump(HttpClient http, string path, string body,
    AiStreamFn onEvent, AiStreamParserFn parse) {
        AiStreamResult res = new AiStreamResult();
        if (http == null || parse == null) {
            res.error = "流式请求参数无效";
            return res;
        }
        string reqPath = path == null ? "" : path;
        string reqBody = body == null ? "" : body;
        SseSink sink = SseSink.ToMemory();
        long producer = 0;

        StringBuilder text = new StringBuilder();
        List<AiToolSlot> slots = new List<AiToolSlot>();
        SseLineReader reader = new SseLineReader();
        bool stopped = false;
        bool failed = false;
        try {
            producer = Task.Spawn(http.PostSseToSinkAsync(reqPath, reqBody, sink));
            while (true) {
                SseDelivery d = await sink.TakeCo();
                if (d.data.Length > 0) {
                    reader.Feed(d.data);
                    string line = reader.Next();
                    while (line.Length > 0) {
                        int r = AiStream.HandleLine(line, text, slots, res, onEvent, parse);
                        if (r == 0) {
                            stopped = true;
                            break;
                        }
                        if (r < 0) {
                            failed = true;
                            break;
                        }
                        line = reader.Next();
                    }
                }
                if (stopped || failed) {
                    sink.Abort();
                    break;
                }
                if (d.finished) { break; }
            }

            if (!stopped && !failed) {
                string rest = reader.Flush();
                if (rest.Length > 0) {
                    int fr = AiStream.HandleLine(rest, text, slots, res, onEvent, parse);
                    if (fr == 0) {
                        stopped = true;
                    } else if (fr < 0) {
                        failed = true;
                    }
                }
            }

            res.text = text.ToString();
            res.toolCalls = AiStream.FinishSlots(slots);
            res.stopped = stopped;

            if (!stopped && !failed) {
                string attempt = sink.Attempt();
                if (attempt.Length > 0 && attempt.StartsWith("err:")) {
                    res.error = "流式请求失败：" + attempt.Substring(4).Trim();
                }
            }
            if (!res.usageReported) {
                res.usage = new AiUsage(AiClient.EstimateTokens(reqBody),
                    AiClient.EstimateTokens(res.text), true);
            }
        } finally {
            await AiStream.ReleaseSink(producer, sink);
        }
        return res;
    }

    // 仅在 producer 退出后释放 sink，避免写入悬空互斥量。
    internal static async void ReleaseSink(long producer, SseSink sink) {
        if (sink == null) { return; }
        if (producer != 0) {
            if (Task.IsDone(producer) == 0) {
                sink.Abort();
            }
            int fast = 50;
            while (Task.IsDone(producer) == 0) {
                if (fast > 0) {
                    await Task.Delay(4);
                    fast = fast - 1;
                } else {
                    await Task.Delay(16);
                }
            }
        }
        sink.Dispose();
    }

    static int HandleLine(string line, StringBuilder text, List<AiToolSlot> slots,
    AiStreamResult res, AiStreamFn onEvent, AiStreamParserFn parse) {
        if (line.Length == 0 || !line.StartsWith("data:")) { return 1; }
        string payload = line.Substring(5).Trim();
        if (payload.Length == 0 || payload == "[DONE]") { return 1; }
        List<AiStreamEvent> events = parse(payload);
        if (events == null) { return 1; }
        for (int i = 0; i < events.Count; i = i + 1) {
            AiStreamEvent e = events[i];
            if (e == null) { continue; }
            if (e.kind == "error") {
                res.error = e.error;
                return -1;
            }
            if (e.kind == "delta" && e.text != null) { text.Append(e.text); }
            if (e.kind == "tool") { AiStream.ApplyTool(slots, e); }
            if (e.kind == "usage") {
                // 增量合并输入/输出 token（Anthropic 分两帧下发）。
                if (e.inputTokens > 0) { res.usage.promptTokens = e.inputTokens; }
                if (e.outputTokens > 0) { res.usage.completionTokens = e.outputTokens; }
                long sum = (long)res.usage.promptTokens + (long)res.usage.completionTokens;
                res.usage.totalTokens = sum > 2147483647L ? 2147483647 : (int)sum;
                res.usage.estimated = false;
                res.usageReported = true;
            }
            if (e.kind == "done" && e.finishReason != null && e.finishReason.Length > 0) {
                res.finishReason = e.finishReason;
            }
            if (onEvent != null && !onEvent(e)) { return 0; }
        }
        return 1;
    }

    static void ApplyTool(List<AiToolSlot> slots, AiStreamEvent e) {
        AiToolSlot slot = null;
        for (int i = 0; i < slots.Count; i = i + 1) {
            if (slots[i].index == e.toolIndex) {
                slot = slots[i];
                break;
            }
        }
        if (slot == null) {
            slot = new AiToolSlot(e.toolIndex);
            slots.Add(slot);
        }
        if (e.toolId.Length > 0) { slot.id = e.toolId; }
        if (e.toolName.Length > 0) { slot.name = e.toolName; }
        if (e.args.Length > 0) { slot.args.Append(e.args); }
    }

    static List<AiToolCall> FinishSlots(List<AiToolSlot> slots) {
        for (int i = 0; i < slots.Count; i = i + 1) {
            for (int j = i + 1; j < slots.Count; j = j + 1) {
                if (slots[j].index < slots[i].index) {
                    AiToolSlot t = slots[i];
                    slots[i] = slots[j];
                    slots[j] = t;
                }
            }
        }
        List<AiToolCall> calls = new List<AiToolCall>();
        for (int i = 0; i < slots.Count; i = i + 1) {
            calls.Add(new AiToolCall(slots[i].id, slots[i].name, slots[i].args.ToString()));
        }
        return calls;
    }

    private static string JsonDocStr(JsonDoc doc, int at, string key, string dflt) {
        if (doc == null || at < 0) { return dflt; }
        return doc.StrAt(doc.Get(at, key), dflt);
    }

    private static int JsonDocInt(JsonDoc doc, int at, string key, int dflt) {
        if (doc == null || at < 0) { return dflt; }
        return doc.IntAt(doc.Get(at, key), dflt);
    }

    private static JsonDoc ParseObjectDoc(string payload) {
        JsonDoc doc = null;
        try {
            doc = JsonDoc.Parse(payload);
        } catch (Exception e) {
            doc = null;
        }
        if (doc == null || doc.root < 0 || doc.KindAt(doc.root) != 5) { return null; }
        return doc;
    }

    private static AiStreamEvent MakeErrorEvent(JsonDoc doc, int errNode) {
        AiStreamEvent e = new AiStreamEvent("error");
        string reason = errNode < 0 ? "" : AiStream.JsonDocStr(doc, errNode, "message", "");
        e.error = reason.Length > 0 ? reason : "流内错误帧";
        return e;
    }

    public static List<AiStreamEvent> OpenAiEvents(string payload) {
        List<AiStreamEvent> events = new List<AiStreamEvent>();
        JsonDoc doc = AiStream.ParseObjectDoc(payload);
        if (doc == null) { return events; }

        int frameError = doc.Get(doc.root, "error");
        if (frameError >= 0 && doc.KindAt(frameError) != 0) {
            events.Add(AiStream.MakeErrorEvent(doc, frameError));
            return events;
        }

        int usage = doc.Get(doc.root, "usage");
        if (usage >= 0 && doc.KindAt(usage) == 5) {
            AiStreamEvent e = new AiStreamEvent("usage");
            e.inputTokens = AiStream.JsonDocInt(doc, usage, "prompt_tokens", 0);
            e.outputTokens = AiStream.JsonDocInt(doc, usage, "completion_tokens", 0);
            events.Add(e);
        }

        int choices = doc.Get(doc.root, "choices");
        if (choices < 0 || doc.KindAt(choices) != 4 || doc.Count(choices) == 0) { return events; }
        int choice = doc.FirstChild(choices);
        if (choice < 0) { return events; }

        int delta = doc.Get(choice, "delta");
        if (delta >= 0) {
            string piece = AiStream.JsonDocStr(doc, delta, "content", "");
            if (piece.Length > 0) {
                AiStreamEvent e = new AiStreamEvent("delta");
                e.text = piece;
                events.Add(e);
            }
            int calls = doc.Get(delta, "tool_calls");
            if (calls >= 0 && doc.KindAt(calls) == 4) {
                int count = doc.Count(calls);
                int one = doc.FirstChild(calls);
                for (int i = 0; i < count; i = i + 1) {
                    if (one >= 0) {
                        AiStreamEvent e = new AiStreamEvent("tool");
                        e.toolIndex = AiStream.JsonDocInt(doc, one, "index", i);
                        e.toolId = AiStream.JsonDocStr(doc, one, "id", "");
                        int fn = doc.Get(one, "function");
                        if (fn >= 0) {
                            e.toolName = AiStream.JsonDocStr(doc, fn, "name", "");
                            e.args = AiStream.JsonDocStr(doc, fn, "arguments", "");
                        }
                        events.Add(e);
                    }
                    one = doc.NextSibling(one);
                }
            }
        }

        string finish = AiStream.JsonDocStr(doc, choice, "finish_reason", "");
        if (finish.Length > 0) {
            AiStreamEvent e = new AiStreamEvent("done");
            e.finishReason = finish;
            events.Add(e);
        }
        return events;
    }

    public static List<AiStreamEvent> AnthropicEvents(string payload) {
        List<AiStreamEvent> events = new List<AiStreamEvent>();
        JsonDoc doc = AiStream.ParseObjectDoc(payload);
        if (doc == null) { return events; }
        string type = AiStream.JsonDocStr(doc, doc.root, "type", "");

        if (type == "error") {
            events.Add(AiStream.MakeErrorEvent(doc, doc.Get(doc.root, "error")));
            return events;
        }

        if (type == "message_start") {
            int message = doc.Get(doc.root, "message");
            int usage = message < 0 ? -1 : doc.Get(message, "usage");
            if (usage >= 0 && doc.KindAt(usage) == 5) {
                AiStreamEvent e = new AiStreamEvent("usage");
                e.inputTokens = AiStream.JsonDocInt(doc, usage, "input_tokens", 0);
                events.Add(e);
            }
            return events;
        }

        if (type == "content_block_start") {
            int index = AiStream.JsonDocInt(doc, doc.root, "index", 0);
            int block = doc.Get(doc.root, "content_block");
            if (block >= 0 && AiStream.JsonDocStr(doc, block, "type", "") == "tool_use") {
                AiStreamEvent e = new AiStreamEvent("tool");
                e.toolIndex = index;
                e.toolId = AiStream.JsonDocStr(doc, block, "id", "");
                e.toolName = AiStream.JsonDocStr(doc, block, "name", "");
                events.Add(e);
            }
            return events;
        }

        if (type == "content_block_delta") {
            int index = AiStream.JsonDocInt(doc, doc.root, "index", 0);
            int delta = doc.Get(doc.root, "delta");
            if (delta < 0) { return events; }
            string deltaType = AiStream.JsonDocStr(doc, delta, "type", "");
            if (deltaType == "text_delta") {
                string piece = AiStream.JsonDocStr(doc, delta, "text", "");
                if (piece.Length > 0) {
                    AiStreamEvent e = new AiStreamEvent("delta");
                    e.text = piece;
                    events.Add(e);
                }
            } else if (deltaType == "input_json_delta") {
                AiStreamEvent e = new AiStreamEvent("tool");
                e.toolIndex = index;
                e.args = AiStream.JsonDocStr(doc, delta, "partial_json", "");
                events.Add(e);
            }
            return events;
        }

        if (type == "message_delta") {
            int usage = doc.Get(doc.root, "usage");
            if (usage >= 0 && doc.KindAt(usage) == 5) {
                AiStreamEvent e = new AiStreamEvent("usage");
                e.outputTokens = AiStream.JsonDocInt(doc, usage, "output_tokens", 0);
                events.Add(e);
            }
            int delta = doc.Get(doc.root, "delta");
            string stop = delta < 0 ? "" : AiStream.JsonDocStr(doc, delta, "stop_reason", "");
            if (stop.Length > 0) {
                AiStreamEvent e = new AiStreamEvent("done");
                e.finishReason = stop;
                events.Add(e);
            }
            return events;
        }

        if (type == "message_stop") {
            events.Add(new AiStreamEvent("done"));
            return events;
        }
        return events;
    }
}
