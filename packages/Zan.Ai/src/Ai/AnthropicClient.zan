using System;
using System.Collections.Generic;
using System.Json;
using System.Net.External;
using System.Net.Http;
using System.Net.Http.Client;

namespace Ai;

// Anthropic Messages API 的客户端。
//
// ## 和 OpenAI 兼容协议差在哪（这些就是要翻译的全部）
//
// | | OpenAI 兼容 | Anthropic |
// |---|---|---|
// | 路径 | `/chat/completions` | `/v1/messages` |
// | 鉴权 | `Authorization: Bearer` | `x-api-key` |
// | 系统提示 | `messages` 里的一条 `role:system` | **顶层 `system` 字段** |
// | 正文 | `content` 是**字符串** | `content` 是**内容块数组** |
// | 工具声明 | `{"type":"function","function":{...}}` | `{"name":...,"input_schema":{...}}` |
// | 工具调用 | `tool_calls[]`（独立字段） | `content` 里的 `tool_use` **块** |
// | 工具结果 | `role:tool` 的独立消息 | **user 消息**里的 `tool_result` **块** |
// | 停止原因 | `finish_reason` | `stop_reason`（值是 `tool_use`） |
// | 用量 | `prompt_tokens`/`completion_tokens` | `input_tokens`/`output_tokens` |
//
// 内部模型（`AiMessage` / `AiTool`）**与协议无关**——翻译只发生在这一层。
//
// ## 一个必须做对的细节：**连续的工具结果要合并**
//
// Anthropic 要求 user 与 assistant 交替，而 OpenAI 的工具结果是一条独立
// 消息（`role:tool`）。一轮里调了三个工具就有三条连续的工具结果消息——
// 照搬会变成三条连续的 user 消息，而 Anthropic 的 `tool_result` **必须**
// 出现在"紧跟着带 `tool_use` 的那条 assistant 消息"之后的 user 消息里，
// 且必须是该消息的第一个块。分成三条，第二条的 `tool_result` 就找不到
// 对应的 `tool_use`（400）。
//
// 所以本客户端把**连续的工具结果消息合并成一条 user 消息**（多个
// `tool_result` 块）。
//
// ## 失败用返回值不用异常
//
// 与 `AiClient` 一致：网络失败 / 服务端报错 / 响应坏了，一律返回 null，
// 原因在 `lastError`。
public class AnthropicClient : IChat {
    // 配置（baseUrl / apiKey / model / 超时预算 / maxTokens）。
    public AiConfig config;

    // 端点 → HttpClient（**按端点复用**，与 `AiClient` 同一纪律：每次
    // 请求新建 HttpClient 等于每次丢掉连接池里的 keep-alive 连接）。
    private Dictionary<string, HttpClient> clients;

    // Anthropic API 版本头（`anthropic-version`）。
    private string apiVersion;

    // 上一次失败的原因。
    public string lastError;

    // 上一次调用的用量。
    public AiUsage lastUsage;

    public AnthropicClient(AiConfig config) {
        this.config = config == null ? new AiConfig("", "", "") : config;
        this.clients = new Dictionary<string, HttpClient>();
        this.apiVersion = AnthropicClient.DefaultApiVersion();
        this.lastError = "";
        this.lastUsage = new AiUsage();
    }

    public AnthropicClient(string baseUrl, string apiKey, string model) {
        this.config = new AiConfig(baseUrl, apiKey, model);
        this.clients = new Dictionary<string, HttpClient>();
        this.apiVersion = AnthropicClient.DefaultApiVersion();
        this.lastError = "";
        this.lastUsage = new AiUsage();
    }

    // 默认的 API 版本（Anthropic 用版本头挑行为，不是路径版本）。
    public static string DefaultApiVersion() { return "2023-06-01"; }

    // 改 API 版本头。
    public void SetApiVersion(string version) {
        this.apiVersion = version == null ? "" : version;
    }

    // 关掉出网连接（进程退出前或长寿命客户端空闲时调用）。
    public void Close() {
        List<string> keys = this.clients.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            this.clients[keys[i]].Close();
        }
        this.clients.Clear();
    }

    public void Dispose() { this.Close(); }

    // 上一次失败的原因（成功时为空串）。
    public string LastError() { return this.lastError; }

    // ------------------------------------------------------------------
    // 公开 API
    // ------------------------------------------------------------------

    // 补全（单条消息）。systemPrompt 可为空串。
    //
    // 失败返回 null（原因在 `lastError`）——与 `AiClient` 同一约定。
    public async string Complete(string systemPrompt, string userPrompt) {
        List<AiMessage> msgs = new List<AiMessage>();
        if (systemPrompt != null && systemPrompt.Length > 0) {
            msgs.Add(AiMessage.System(systemPrompt));
        }
        msgs.Add(AiMessage.User(userPrompt));
        return await this.CompleteMessages(msgs, 0.0, "");
    }

    // 补全（多轮消息）。temperature < 0 表示用服务端的默认值。
    // stop 非空时作为停止序列。
    public async string CompleteMessages(List<AiMessage> messages, double temperature,
    string stop) {
        AiToolTurn turn = await this.Send(messages, null, temperature, stop);
        if (turn == null) { return null; }
        return turn.content;
    }

    // 带工具的补全。
    //
    // tools 是工具声明（实体）——本客户端渲染成 Anthropic 的
    // `{"name":...,"input_schema":{...}}` 形状。
    //
    // 返回这一轮的结果：模型可能给了答案，也可能请求调工具。失败返回
    // null（原因在 `lastError`）。
    public async AiToolTurn CompleteWithTools(List<AiMessage> messages,
    List<AiTool> tools, double temperature) {
        return await this.Send(messages, tools, temperature, "");
    }

    // 流式补全（带工具）。
    //
    // 逐**事件**推给 onEvent：文本增量、工具调用的增量、用量、结束。
    // Anthropic 的工具参数是 `input_json_delta` 的**分片**（`partial_json`），
    // 靠内容块的 `index` 归位拼成完整 JSON。
    //
    // 回调返回 false → 调用方主动停止（中止上游），**不算失败**。
    //
    // 返回这一轮的结果。**永远不返回 null**：失败看结果里的 `error`
    // ——半截内容仍然有用。
    public async AiStreamResult StreamWithTools(List<AiMessage> messages,
    List<AiTool> tools, double temperature, AiStreamFn onEvent) {
        this.lastError = "";
        AiEndpoint ep = AiEndpoint.Parse(this.config.baseUrl);
        if (ep == null) {
            this.lastError = "服务地址不合法: " + this.config.baseUrl;
            return AiStreamResult.Failure(this.lastError);
        }
        if (this.config.model.Length == 0) {
            this.lastError = "没有指定模型";
            return AiStreamResult.Failure(this.lastError);
        }
        if (messages == null) {
            this.lastError = "没有消息";
            return AiStreamResult.Failure(this.lastError);
        }
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("model", this.config.model);
        w.WriteProperty("max_tokens", this.config.maxTokens);
        if (temperature >= 0.0) {
            w.WriteProperty("temperature", temperature);
        }
        w.WriteProperty("stream", true);
        string system = AnthropicClient.SystemText(messages);
        if (system.Length > 0) {
            w.WriteProperty("system", system);
        }
        w.WriteKey("messages");
        AnthropicClient.WriteMessages(w, messages);
        if (tools != null && tools.Count > 0) {
            w.WriteKey("tools");
            AnthropicClient.WriteTools(w, tools);
            w.WriteKey("tool_choice");
            w.StartObject();
            w.WriteProperty("type", "auto");
            w.EndObject();
        }
        w.EndObject();
        string payload = w.ToJson();
        if (payload.Length > this.config.requestLimitBytes) {
            this.lastError = "请求体超过上限（"
                + this.config.requestLimitBytes.ToString() + " 字节）";
            return AiStreamResult.Failure(this.lastError);
        }
        HttpClient http = this.StreamClient(ep);
        AiStreamResult res = await AiStream.Pump(http,
            AnthropicClient.MessagesPath(ep), payload, onEvent,
            AiStream.AnthropicEvents);
        if (res == null) {
            return AiStreamResult.Failure("流式传输未返回结果");
        }
        if (res.error.Length > 0) { this.lastError = res.error; }
        this.lastUsage = res.usage;
        return res;
    }

    // ------------------------------------------------------------------
    // 内部：一次请求
    // ------------------------------------------------------------------

    async AiToolTurn Send(List<AiMessage> messages, List<AiTool> tools,
    double temperature, string stop) {
        this.lastError = "";
        AiEndpoint ep = AiEndpoint.Parse(this.config.baseUrl);
        if (ep == null) {
            this.lastError = "服务地址不合法: " + this.config.baseUrl;
            return null;
        }
        if (this.config.model.Length == 0) {
            this.lastError = "没有指定模型";
            return null;
        }
        if (messages == null) {
            this.lastError = "没有消息";
            return null;
        }
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("model", this.config.model);
        w.WriteProperty("max_tokens", this.config.maxTokens);
        if (temperature >= 0.0) {
            w.WriteProperty("temperature", temperature);
        }
        w.WriteProperty("stream", false);
        string system = AnthropicClient.SystemText(messages);
        if (system.Length > 0) {
            w.WriteProperty("system", system);
        }
        if (stop != null && stop.Length > 0) {
            w.WriteKey("stop_sequences");
            w.StartArray();
            w.WriteString(stop);
            w.EndArray();
        }
        w.WriteKey("messages");
        AnthropicClient.WriteMessages(w, messages);
        if (tools != null && tools.Count > 0) {
            w.WriteKey("tools");
            AnthropicClient.WriteTools(w, tools);
            w.WriteKey("tool_choice");
            w.StartObject();
            w.WriteProperty("type", "auto");
            w.EndObject();
        }
        w.EndObject();

        string raw = await this.PostJson(ep, w.ToJson());
        if (raw == null) { return null; }
        JsonDoc doc = null;
        try {
            doc = JsonDoc.Parse(raw);
        } catch (Exception e) {
            doc = null;
        }
        if (doc == null || doc.root < 0) {
            this.lastError = "Anthropic 服务返回的内容无法解析";
            return null;
        }
        // 错误体形状与 OpenAI 兼容一样（{"error":{"message":...}}）。
        string errMsg = AiClient.ErrorMessage(doc);
        if (errMsg.Length > 0) {
            this.lastError = errMsg;
            return null;
        }
        AiToolTurn turn = AnthropicClient.ParseTurn(doc);
        if (turn == null) {
            this.lastError = "Anthropic 服务返回的内容无法解析";
            return null;
        }
        this.CaptureUsage(doc);
        return turn;
    }

    // 发起一次 POST（带重试）。失败返回 null，原因在 lastError。
    public async string PostJson(AiEndpoint ep, string payload) {
        if (payload.Length > this.config.requestLimitBytes) {
            this.lastError = "请求体超过上限（"
                + this.config.requestLimitBytes.ToString() + " 字节）";
            return null;
        }
        int attempts = this.config.maxAttempts;
        if (attempts < 1) { attempts = 1; }
        string lastReason = "";
        for (int attempt = 0; attempt < attempts; attempt = attempt + 1) {
            if (attempt > 0) {
                int wait = 100 * (1 << (attempt - 1));
                if (wait > 2000) { wait = 2000; }
                await Task.Delay(wait);
            }
            HttpClient http = null;
            try {
                http = this.Client(ep);
                HttpResponse resp = await http.SendAsync("POST",
                    AnthropicClient.MessagesPath(ep), payload);
                int status = resp.statusCode;
                string bodyText = resp.body;
                if (status >= 200 && status < 300) {
                    return bodyText;
                }
                if (status < 500) {
                    this.lastError = AnthropicClient.HttpErrorMessage(status, bodyText);
                    return null;
                }
                lastReason = "Anthropic 服务返回 " + status.ToString();
            } catch (Exception e) {
                lastReason = "请求 Anthropic 服务失败：" + e.Message;
            }
        }
        this.lastError = lastReason;
        return null;
    }

    // 请求路径。
    //
    // baseUrl 是**根地址**（"https://api.anthropic.com"）→ 拼
    // "/v1/messages"。用户如果写了 ".../v1"（有些 SDK 那样写），就只拼
    // "/messages"——否则会变成 "/v1/v1/messages"。
    public static string MessagesPath(AiEndpoint ep) {
        string p = ep.Path();
        if (p.EndsWith("/v1")) { return p + "/messages"; }
        return p + "/v1/messages";
    }

    // 取（或建）该端点的 `HttpClient`。同一端点复用同一个客户端，连接池
    // 才能生效；换端点就换客户端（池是按 host/port 建的）。
    private HttpClient Client(AiEndpoint ep) {
        string key = ep.Canonical();
        if (this.clients.ContainsKey(key)) { return this.clients[key]; }
        HttpClient http = null;
        if (ep.Tls()) {
            http = HttpClient.CreateHttps(ep.Host(), ep.Port());
        } else {
            http = new HttpClient(ep.Host(), ep.Port());
        }
        http.SetCallPolicy(this.Policy(ep));
        http.SetHeader("Content-Type", "application/json");
        http.SetHeader("Accept", "application/json");
        if (this.apiVersion.Length > 0) {
            http.SetHeader("anthropic-version", this.apiVersion);
        }
        if (this.config.apiKey.Length > 0) {
            http.SetHeader("x-api-key", this.config.apiKey);
        }
        this.clients[key] = http;
        return http;
    }

    // 流式专用的客户端：Accept 必须是 text/event-stream，读取超时按
    // **空闲窗口**算（每收到一个分片就重新计时），否则长回答会被读超时
    // 掐断——读超时要的是"对端沉默一段时间"，不是"总共读多久"。
    private HttpClient StreamClient(AiEndpoint ep) {
        string key = ep.Canonical() + "|sse";
        if (this.clients.ContainsKey(key)) { return this.clients[key]; }
        HttpClient http = null;
        if (ep.Tls()) {
            http = HttpClient.CreateHttps(ep.Host(), ep.Port());
        } else {
            http = new HttpClient(ep.Host(), ep.Port());
        }
        // 流式通路的总预算同样撤销（长流会被 totalTimeout 的墙钟掐断，
        // 停滞判据交给 IdleTimeout）；流上限显式给到响应上限，不让传输
        // 层回落到 64MiB 的默认值。
        ExternalCallPolicy p = this.Policy(ep).IdleTimeout(this.config.readTimeoutMs)
            .NoTotalTimeout()
            .StreamLimit(this.config.responseLimitBytes);
        http.SetCallPolicy(p);
        http.SetHeader("Content-Type", "application/json");
        http.SetHeader("Accept", "text/event-stream");
        if (this.apiVersion.Length > 0) {
            http.SetHeader("anthropic-version", this.apiVersion);
        }
        if (this.config.apiKey.Length > 0) {
            http.SetHeader("x-api-key", this.config.apiKey);
        }
        this.clients[key] = http;
        return http;
    }

    // 出网预算。响应与请求体都有上限，超限的响应不会进内存。
    private ExternalCallPolicy Policy(AiEndpoint ep) {
        ExternalCallPolicy p = ExternalCallPolicy.Default()
            .ConnectTimeout(this.config.connectTimeoutMs)
            .ReadTimeout(this.config.readTimeoutMs)
            .TotalTimeout(this.config.totalTimeoutMs)
            .RequestLimit(this.config.requestLimitBytes)
            .ResponseLimit(this.config.responseLimitBytes)
            .ErrorLimit(128 * 1024)
            .Redirects(0)
            .RetryNetwork(false)
            .RetryAttempts(0);
        if (ep.Local()) { p.AllowLocalHttp(); }
        return p;
    }

    // ------------------------------------------------------------------
    // 静态：协议翻译（公开是为了能单独测）
    // ------------------------------------------------------------------

    // 系统提示（所有 system 消息拼起来）。
    //
    // Anthropic 的 `system` 是**一个字符串**，不是消息数组。内部模型允许
    // 多条 system 消息，所以这里按顺序用空行拼成一段——**顺序不变**，
    // 规则不丢。
    public static string SystemText(List<AiMessage> messages) {
        if (messages == null) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < messages.Count; i = i + 1) {
            AiMessage m = messages[i];
            if (m == null) { continue; }
            if (m.role != "system") { continue; }
            if (sb.Length > 0) { sb.Append("\n\n"); }
            sb.Append(m.content == null ? "" : m.content);
        }
        return sb.ToString();
    }

    // 消息列表 → Anthropic 的 `messages` 数组。
    //
    // 三处翻译：
    // 1. **system 消息被摘走**（去顶层 `system` 字段），不进 messages。
    // 2. **连续的工具结果消息合并成一条 user 消息**（多个 `tool_result`
    //    块）——见类注释里那段"必须做对的细节"。
    // 3. 正文从字符串变成**内容块数组**；assistant 的工具调用变成
    //    `tool_use` 块。
    public static void WriteMessages(JsonWriter w, List<AiMessage> messages) {
        w.StartArray();
        if (messages == null) { w.EndArray(); return; }
        bool pendingToolResult = false;
        for (int i = 0; i < messages.Count; i = i + 1) {
            AiMessage m = messages[i];
            if (m == null || m.role == "system") { continue; }
            if (m.role == "tool") {
                if (!pendingToolResult) {
                    w.StartObject();
                    w.WriteProperty("role", "user");
                    w.WriteKey("content");
                    w.StartArray();
                    pendingToolResult = true;
                }
                w.StartObject();
                w.WriteProperty("type", "tool_result");
                w.WriteProperty("tool_use_id", m.toolCallId);
                w.WriteProperty("content", m.content == null ? "" : m.content);
                w.EndObject();
                continue;
            }
            if (pendingToolResult) {
                w.EndArray();
                w.EndObject();
                pendingToolResult = false;
            }
            w.StartObject();
            w.WriteProperty("role", m.role);
            w.WriteKey("content");
            w.StartArray();
            if (m.role == "assistant") {
                if (m.content != null && m.content.Length > 0) {
                    w.StartObject();
                    w.WriteProperty("type", "text");
                    w.WriteProperty("text", m.content);
                    w.EndObject();
                }
                for (int j = 0; j < m.toolCalls.Count; j = j + 1) {
                    AiToolCall c = m.toolCalls[j];
                    w.StartObject();
                    w.WriteProperty("type", "tool_use");
                    w.WriteProperty("id", c.id);
                    w.WriteProperty("name", c.name);
                    w.WriteKey("input");
                    if (c.arguments != null && c.arguments.Length > 0) {
                        w.WriteRaw(c.arguments);
                    } else {
                        w.StartObject();
                        w.EndObject();
                    }
                    w.EndObject();
                }
            } else {
                w.StartObject();
                w.WriteProperty("type", "text");
                w.WriteProperty("text", m.content == null ? "" : m.content);
                w.EndObject();
            }
            w.EndArray();
            w.EndObject();
        }
        if (pendingToolResult) {
            w.EndArray();
            w.EndObject();
        }
        w.EndArray();
    }

    public static string MessagesJson(List<AiMessage> messages) {
        JsonWriter w = new JsonWriter();
        AnthropicClient.WriteMessages(w, messages);
        return w.ToJson();
    }

    public static void WriteTools(JsonWriter w, List<AiTool> tools) {
        w.StartArray();
        if (tools != null) {
            for (int i = 0; i < tools.Count; i = i + 1) {
                AiTool t = tools[i];
                if (t == null) { continue; }
                w.StartObject();
                w.WriteProperty("name", t.name);
                w.WriteProperty("description", t.description);
                w.WriteKey("input_schema");
                if (t.parametersJson != null && t.parametersJson.Length > 0) {
                    w.WriteRaw(t.parametersJson);
                } else if (t.parameters != null) {
                    w.WriteRaw(Json.Serialize(t.parameters));
                } else {
                    w.StartObject();
                    w.WriteProperty("type", "object");
                    w.EndObject();
                }
                w.EndObject();
            }
        }
        w.EndArray();
    }

    public static string ToolsJson(List<AiTool> tools) {
        JsonWriter w = new JsonWriter();
        AnthropicClient.WriteTools(w, tools);
        return w.ToJson();
    }

    public static string InputOf(string arguments) {
        if (arguments == null || arguments.Length == 0) {
            return "{}";
        }
        try {
            JsonDoc doc = JsonDoc.Parse(arguments);
            if (doc != null && doc.KindAt(0) == 5) {
                return arguments;
            }
        } catch (Exception _ex) {
        }
        return "{}";
    }

    public static AiToolTurn ParseTurn(string raw) {
        if (raw == null || raw.Length == 0) { return null; }
        try {
            JsonDoc doc = JsonDoc.Parse(raw);
            if (doc != null) {
                return AnthropicClient.ParseTurn(doc);
            }
        } catch (Exception _ex) {
            return null;
        }
        return null;
    }

    public static AiToolTurn ParseTurn(JsonDoc doc) {
        if (doc == null || doc.root < 0 || doc.KindAt(doc.root) != 5) { return null; }
        int content = doc.Get(doc.root, "content");
        if (content < 0 || doc.KindAt(content) != 4) { return null; }
        AiToolTurn turn = new AiToolTurn();
        turn.finishReason = doc.StrAt(doc.Get(doc.root, "stop_reason"), "");
        StringBuilder sb = new StringBuilder();
        int count = doc.Count(content);
        int block = doc.FirstChild(content);
        for (int i = 0; i < count; i = i + 1) {
            if (block < 0) { break; }
            string type = doc.StrAt(doc.Get(block, "type"), "");
            if (type == "text") {
                string t = doc.StrAt(doc.Get(block, "text"), "");
                if (sb.Length > 0) { sb.Append("\n"); }
                sb.Append(t);
            } else if (type == "tool_use") {
                int input = doc.Get(block, "input");
                string args = input < 0 ? "{}" : doc.ToJson(input);
                if (args == null || args.Length == 0) { args = "{}"; }
                turn.toolCalls.Add(new AiToolCall(doc.StrAt(doc.Get(block, "id"), ""),
                    doc.StrAt(doc.Get(block, "name"), ""), args));
            }
            block = doc.NextSibling(block);
        }
        turn.content = sb.ToString();
        return turn;
    }

    // 从 HTTP 响应里提错误文案（4xx 时的解释）。
    private static string HttpErrorMessage(int status, string body) {
        string detail = "";
        if (body != null && body.Length > 0) {
            JsonDoc doc = null;
            try {
                doc = JsonDoc.Parse(body);
            } catch (Exception e) {
                doc = null;
            }
            if (doc != null && doc.root >= 0) {
                detail = AiClient.ErrorMessage(doc);
            }
        }
        if (detail.Length == 0) {
            detail = "Anthropic 服务返回 " + status.ToString();
        }
        return detail;
    }

    // 记录用量（Anthropic 的字段名是 input_tokens / output_tokens）。
    private void CaptureUsage(JsonDoc doc) {
        if (doc == null || doc.root < 0) { return; }
        int usage = doc.Get(doc.root, "usage");
        if (usage < 0) { return; }
        int p = doc.IntAt(doc.Get(usage, "input_tokens"), 0);
        int c = doc.IntAt(doc.Get(usage, "output_tokens"), 0);
        if (p <= 0 && c <= 0) { return; }
        this.lastUsage = new AiUsage(p, c, false);
    }
}
