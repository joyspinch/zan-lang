using System;
using System.Collections.Generic;
using System.Data.ZanDb;
using System.Json;

namespace Ai;

// 向量存储：封装 System.Data.ZanDb.VectorIndex（不拖入 ORM/sqlite 驱动）。
// 将 AiEmbedding 的 double 向量显式转为索引使用的 float[]（余弦误差约 1e-9，默认归一化入库；
// 需与服务端原始向量逐位比对时应直接使用 AiEmbedding.vectors）。
public class VectorStore {
    // 索引（null 表示还没建索引——维度未知前无法建）。
    private VectorIndex index;

    // 维度（0 = 未知）。
    private int dimensions;

    // 归一化开关（入库时是否归一化）。
    private bool normalized;

    // id → 原文。
    private Dictionary<int, string> texts;

    // id → 附加元数据（JSON 文本）。
    private Dictionary<int, string> metadata;

    public VectorStore(int dimensions, bool normalize) {
        this.dimensions = dimensions;
        this.normalized = normalize;
        this.texts = new Dictionary<int, string>();
        this.metadata = new Dictionary<int, string>();
        if (dimensions > 0) {
            this.index = new VectorIndex(new VectorIndexOptions(dimensions, 0));
        }
    }

    // 维度（0 = 未知）。
    public int Dimensions() { return this.dimensions; }

    // 索引里的条目数。
    public int Count() {
        if (this.index == null) { return 0; }
        return this.index.Count();
    }

    // 存一条记录（重复 id 为替换；维度不符抛 ArgumentException）。
    public void Add(int id, List<double> vector, string text, string meta) {
        if (this.index == null) {
            throw new ArgumentException("向量维度未知，无法入库");
        }
        if (vector == null || vector.Count != this.dimensions) {
            throw new ArgumentException("向量维度不符（期望 "
            + Convert.ToString(this.dimensions) + "，实际 "
            + Convert.ToString(vector == null ? 0 : vector.Count) + "）");
        }
        this.index.Add(id, VectorStore.ToFloatArray(vector, this.normalized));
        this.texts[id] = text == null ? "" : text;
        this.metadata[id] = meta == null ? "" : meta;
    }

    // 批量入库（顺序与 vectors 一致，id 从 startId 递增）。
    public void AddAll(List<List<double>> vectors, List<string> texts, int startId) {
        if (vectors == null) { return; }
        for (int i = 0; i < vectors.Count; i = i + 1) {
            if (startId > 2147483647 - i) {
                throw new ArgumentOutOfRangeException("startId overflow");
            }
            string t = "";
            if (texts != null && i < texts.Count) { t = texts[i]; }
            this.Add(startId + i, vectors[i], t, "");
        }
    }

    // 检索：返回 id + 距离（余弦度量下 distance = 1 - cos_sim，越小越近）。
    public List<VectorHit> Search(List<double> query, int k) {
        return this.Search(query, k, 0);
    }

    // 检索（限定 efSearch；0 = 用索引默认值）。
    public List<VectorHit> Search(List<double> query, int k, int efSearch) {
        if (this.index == null || query == null || k < 1) { return new List<VectorHit>(); }
        float[] q = VectorStore.ToFloatArray(query, this.normalized);
        return this.index.Search(q, k, efSearch);
    }

    // 原文（命中后回原文）。
    public string TextOf(int id) {
        string v;
        if (!this.texts.TryGetValue(id, out v)) { return ""; }
        return v;
    }

    // 元数据。
    public string MetaOf(int id) {
        string v;
        if (!this.metadata.TryGetValue(id, out v)) { return ""; }
        return v;
    }

    // 全部 id（升序）。
    public List<int> Ids() {
        List<int> ids = this.texts.Keys;
        ids.Sort();
        return ids;
    }

    // 导出状态（ids/texts/metadata 按 id 升序写为平行数组，避免 JSON 键序依赖）。
    public string ExportState() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("dimensions", this.dimensions);
        w.WriteProperty("normalized", this.normalized);
        if (this.index != null) {
            w.WritePropertyName("index");
            w.WriteRaw(this.index.ExportState().ToJson());
        }
        List<int> ids = this.Ids();
        w.WritePropertyName("ids");
        w.WriteStartArray();
        for (int i = 0; i < ids.Count; i = i + 1) {
            w.WriteInt(ids[i]);
        }
        w.WriteEndArray();
        w.WritePropertyName("texts");
        w.WriteStartArray();
        for (int i = 0; i < ids.Count; i = i + 1) {
            string t = this.texts[ids[i]];
            w.WriteString(t == null ? "" : t);
        }
        w.WriteEndArray();
        w.WritePropertyName("metadata");
        w.WriteStartArray();
        for (int i = 0; i < ids.Count; i = i + 1) {
            string m = this.metadata[ids[i]];
            w.WriteString(m == null ? "" : m);
        }
        w.WriteEndArray();
        w.WriteEndObject();
        return w.ToJson();
    }

    // 从状态恢复。
    public static VectorStore ImportState(string json) {
        if (json == null || json.Length == 0) {
            throw new ArgumentException("向量存储状态不是合法 JSON 对象");
        }
        JsonDoc doc = JsonDoc.Parse(json);
        if (doc == null || doc.root < 0 || doc.KindAt(doc.root) != 5) {
            throw new ArgumentException("向量存储状态不是合法 JSON 对象");
        }
        int dimNode = doc.Get(doc.root, "dimensions");
        int normNode = doc.Get(doc.root, "normalized");
        int dims = dimNode < 0 ? 0 : doc.IntAt(dimNode, 0);
        bool norm = normNode < 0 ? false : doc.BoolAt(normNode, false);
        VectorStore store = new VectorStore(dims, norm);

        int idArr = doc.Get(doc.root, "ids");
        int textArr = doc.Get(doc.root, "texts");
        int metaArr = doc.Get(doc.root, "metadata");
        if (idArr >= 0 && doc.KindAt(idArr) == 4) {
            int count = doc.Count(idArr);
            int idSlot = doc.FirstChild(idArr);
            int textSlot = textArr >= 0 ? doc.FirstChild(textArr) : -1;
            int metaSlot = metaArr >= 0 ? doc.FirstChild(metaArr) : -1;
            for (int i = 0; i < count; i = i + 1) {
                if (idSlot < 0) { break; }
                int id = doc.IntAt(idSlot, 0);
                string t = textSlot >= 0 ? doc.StrAt(textSlot, "") : "";
                string m = metaSlot >= 0 ? doc.StrAt(metaSlot, "") : "";
                store.texts[id] = t;
                store.metadata[id] = m;
                idSlot = doc.NextSibling(idSlot);
                if (textSlot >= 0) { textSlot = doc.NextSibling(textSlot); }
                if (metaSlot >= 0) { metaSlot = doc.NextSibling(metaSlot); }
            }
        }

        int idxNode = doc.Get(doc.root, "index");
        if (idxNode >= 0 && doc.KindAt(idxNode) == 5) {
            string idxJson = doc.ToJson(idxNode);
            store.index = VectorIndex.ImportState(JsonValue.Parse(idxJson));
        }

        return store;
    }

    // double → float（可选归一化）。
    public static float[] ToFloatArray(List<double> v, bool normalize) {
        if (v == null) { return new float[0]; }
        float[] outp = new float[v.Count];
        double sum = 0.0;
        for (int i = 0; i < v.Count; i = i + 1) {
            outp[i] = (float)v[i];
            sum = sum + v[i] * v[i];
        }
        if (normalize && sum > 0.0 && sum <= 1.0e308) {
            double inv = 1.0 / Math.Sqrt(sum);
            for (int i = 0; i < outp.Length; i = i + 1) {
                outp[i] = (float)((double)outp[i] * inv);
            }
        }
        return outp;
    }
}
