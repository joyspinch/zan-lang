using System;
using System.Collections.Generic;

namespace Ai;

// 一次问答的结果（答案 + 引用实体模型）。
public class RagAnswer {
    public string question;

    // 生成的答案。
    public string text;

    // 拼进提示词的上下文（命中块的拼接）。
    public string context;

    // 引用（命中的块 + 原文 + 分数）。
    public List<RagCitation> citations;

    public RagAnswer() {
        this.question = "";
        this.text = "";
        this.context = "";
        this.citations = new List<RagCitation>();
    }
}
