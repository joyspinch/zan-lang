using System;
using System.Collections.Generic;

namespace Ai;

// 协议无关的工具调用循环（agent loop）：请求失败返回 null + lastError；工具错误作为 tool 消息回传模型自纠。
public class ToolAgent {
    private IChat client;
    private ToolRegistry registry;
    private double temperature;
    public string lastError;
    private List<ToolEvent> events;

    public ToolAgent(IChat client, ToolRegistry registry) {
        this.client = client;
        this.registry = registry;
        this.temperature = 0.0;
        this.lastError = "";
        this.events = new List<ToolEvent>();
    }

    public void SetTemperature(double t) { this.temperature = t; }
    public List<ToolEvent> Events() { return this.events; }

    // 复制传入 messages 并执行多轮工具调用直到给出最终答复或触及 MaxCalls 上限。
    public async List<AiMessage> Run(List<AiMessage> messages) {
        this.lastError = "";
        this.events.Clear();
        if (this.client == null) { this.lastError = "没有客户端"; return null; }
        if (this.registry == null) { this.lastError = "没有工具注册表"; return null; }
        if (messages == null) { this.lastError = "没有消息"; return null; }

        List<AiMessage> history = new List<AiMessage>();
        for (int i = 0; i < messages.Count; i = i + 1) { history.Add(messages[i]); }
        List<AiTool> tools = this.registry.Declarations();

        int maxCalls = this.registry.MaxCalls();
        int used = 0;
        while (true) {
            AiToolTurn turn = await this.client.CompleteWithTools(history, tools, this.temperature);
            if (turn == null) {
                this.lastError = "调用 AI 服务失败：" + this.client.LastError();
                return null;
            }
            if (!turn.WantsTools()) {
                history.Add(AiMessage.Assistant(turn.content));
                ToolEvent ev = new ToolEvent();
                ev.kind = "final";
                ev.text = turn.content;
                this.events.Add(ev);
                return history;
            }
            if (used >= maxCalls) {
                this.lastError = "工具调用次数超过上限（" + Convert.ToString(maxCalls) + "）";
                history.Add(AiMessage.Assistant(turn.content));
                ToolEvent ev = new ToolEvent();
                ev.kind = "limit";
                ev.text = this.lastError;
                this.events.Add(ev);
                return history;
            }
            int remaining = maxCalls - used;
            int runCount = turn.toolCalls.Count;
            bool truncated = false;
            if (runCount > remaining) {
                runCount = remaining;
                truncated = true;
            }
            List<AiToolCall> execCalls = new List<AiToolCall>();
            for (int i = 0; i < runCount; i = i + 1) {
                execCalls.Add(turn.toolCalls[i]);
            }
            history.Add(AiMessage.AssistantCalls(execCalls));
            for (int i = 0; i < runCount; i = i + 1) {
                AiToolCall call = execCalls[i];
                used = used + 1;
                AiToolResult res = await this.registry.Call(call);
                ToolEvent ev = new ToolEvent();
                ev.kind = "tool";
                ev.name = call.name;
                ev.text = res.content;
                ev.isError = res.isError;
                this.events.Add(ev);
                history.Add(AiMessage.Tool(res.id, res.content));
            }
            if (truncated) {
                this.lastError = "工具调用次数超过上限（" + Convert.ToString(maxCalls) + "）";
                ToolEvent limEv = new ToolEvent();
                limEv.kind = "limit";
                limEv.text = this.lastError;
                this.events.Add(limEv);
                return history;
            }
        }
    }
}
