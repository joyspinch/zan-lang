using System;
using System.Json;
using System.Net.External;
using System.Net.Http;
using System.Net.Http.Client;
using System.Text;

namespace System.Ai;

// 统一 LLM 客户端。
//
// 职责：把"调一个大模型"这件事封成一个可复用的调用——多厂商端点、
// 超时预算、重试、流式/非流式、Token 计数与成本核算。
//
// **不依赖任何 Web 框架**（这是与 `Zan.Mvc/Framework/Ai` 的根本区别：
// 那个绑在 `HttpContext` 与 `Settings` 上，只能在 Web 应用里用）。
//
// ## 重试策略
//
// 只对**网络错误**与 **5xx** 重试。4xx 是请求本身的问题（key 错、
// 参数错、额度不足），重试没有意义只会浪费配额。
//
// **POST 补全默认不重试**（`maxAttempts` 默认 1）：补全没有幂等键，
// 重试可能重复计费。需要重试的只读调用（embeddings）可以自己把
// `maxAttempts` 调大。
//
// ## Token 计数
//
// `EstimateTokens` 是**启发式估算**，不是厂商 tokenizer 的真值。多数
// 厂商的响应里带 usage，但各家字段名与语义不一致（有的单列 reasoning
// token、有的单列 cached token），统一口径反而对不上。所以本包一律
// 用估算，并用 `AiUsage.estimated` 标出来。
//
// ## 流式
//
// `Stream` 用 SSE 逐块推给回调。回调返回 false 表示**调用方主动停止**
// （客户端断开），此时不再继续读流。

public class AiClient : IDisposable {
    public AiConfig config;

    // 端点 → HttpClient（**按端点复用**，不是每次请求新建）。
    //
    // 为什么不每次新建：`HttpClient` 内部有连接池，每次新建等于每次
    // 丢掉池子里的 keep-alive 连接——连接被服务端留着，客户端这边却
    // 已经把它丢了。实测：每次请求新建 `HttpClient` 且不关，leakcheck
    // 报"10 个 TcpClient / HttpRequest / ByteBuffer 泄漏"（每个请求一个）。
    //
    // 为什么不全局共用一个 `HttpClient`：连接池是**按 host/port 建的**，
    // 换端点就得换客户端。所以按端点规范化串（`AiEndpoint.Canonical`）
    // 做键，一个端点一个客户端。
    private Dictionary<string, HttpClient> clients;

    public AiClient(AiConfig config) {
        this.config = config == null ? new AiConfig("", "", "") : config;
        this.clients = new Dictionary<string, HttpClient>();
    }

    // 关闭所有出网连接（进程退出前或长寿命客户端空闲时调用）。
    //
    // 不关的话，池子里的 keep-alive 连接会一直挂着到进程退出——服务端
    // 那边也是（半开连接）。
    public void Close() {
        List<string> keys = this.clients.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            this.clients[keys[i]].Close();
        }
        this.clients.Clear();
    }

    public void Dispose() { this.Close(); }

    // 构造（直接给三元组）。
    public AiClient(string baseUrl, string apiKey, string model) {
        this.config = new AiConfig(baseUrl, apiKey, model);
    }

    // ------------------------------------------------------------------
    // 非流式补全
    // ------------------------------------------------------------------

    // 补全（单条消息）。systemPrompt 可为空串。
    //
    // 失败返回 null（错误原因在 LastError 里）——调用方要么检查 null，
    // 要么读 LastError 看原因。不用异常：网络失败是常态（超时、
    // 断网、服务端 5xx），用返回值比抛异常顺手。
    public async string Complete(string systemPrompt, string userPrompt) {
        List<AiMessage> msgs = new List<AiMessage>();
        if (systemPrompt != null && systemPrompt.Length > 0) {
            msgs.Add(AiMessage.System(systemPrompt));
        }
        msgs.Add(AiMessage.User(userPrompt));
        return await this.CompleteMessages(msgs, 0.0, "");
    }

    // 补全（多轮消息）。messages 是 `AiMessage` 列表（角色 + 内容）。
    //
    // temperature < 0 表示用服务端的默认值（不传该字段）。
    // stop 非空时作为停止序列（服务端支持才有效果）。
    public async string CompleteMessages(List<AiMessage> messages, double temperature,
    string stop) {
        this.lastError = "";
        AiEndpoint ep = AiEndpoint.Parse(this.config.baseUrl);
        if (ep == null) {
            this.lastError = "服务地址不合法: " + this.config.baseUrl;
            return null;
        }
        if (this.config.model.Length == 0) {
            this.lastError = "没有指定模型";
            return null;
        }
        JsonValue body = JsonValue.NewObject();
        body.PutStr("model", this.config.model);
        if (temperature >= 0.0) {
            body.PutDouble("temperature", temperature);
        }
        if (stop != null && stop.Length > 0) {
            body.PutStr("stop", stop);
        }
        body.PutBool("stream", false);
        body.PutJson("messages", AiClient.MessagesJson(messages));

        string raw = await this.PostJson(ep, "/chat/completions", body);
        if (raw == null) { return null; }
        // JsonValue.Parse 对坏 JSON **抛异常**（不是返回 null）——
        // 解析外部响应必须兜住。
        JsonValue root = null;
        try {
            root = JsonValue.Parse(raw);
        } catch (Exception e) {
            this.lastError = "AI 服务返回的内容无法解析";
            return null;
        }
        if (root == null) {
            this.lastError = "AI 服务返回的内容无法解析";
            return null;
        }
        string errMsg = AiClient.ErrorMessage(root);
        if (errMsg.Length > 0) {
            this.lastError = errMsg;
            return null;
        }
        JsonValue choices = root.Get("choices");
        if (choices == null || !choices.IsArray() || choices.Count() == 0) {
            this.lastError = "AI 服务没有返回回答";
            return null;
        }
        JsonValue msg = choices.At(0).Get("message");
        if (msg == null) {
            this.lastError = "AI 服务没有返回回答";
            return null;
        }
        // 记下用量（若服务端口径一致就用服务端的，否则保持估算）。
        this.CaptureUsage(root);
        return msg.Str("content", "");
    }

    // ------------------------------------------------------------------
    // 带工具的补全
    // ------------------------------------------------------------------

    // 补全（带工具）。返回这一轮的结果——模型可能给了答案，也可能
    // 请求调工具。
    //
    // toolsJson 是工具声明的 JSON 数组（`ToolRegistry.DeclarationsJson`
    // 给）。为空串表示不带工具。
    //
    // 返回 null 表示调用失败（原因在 lastError）。
    public async AiToolTurn CompleteWithTools(List<AiMessage> messages,
            string toolsJson, double temperature) {
        this.lastError = "";
        AiEndpoint ep = AiEndpoint.Parse(this.config.baseUrl);
        if (ep == null) {
            this.lastError = "服务地址不合法: " + this.config.baseUrl;
            return null;
        }
        if (this.config.model.Length == 0) {
            this.lastError = "没有指定模型";
            return null;
        }
        JsonValue body = JsonValue.NewObject();
        body.PutStr("model", this.config.model);
        if (temperature >= 0.0) {
            body.PutDouble("temperature", temperature);
        }
        body.PutBool("stream", false);
        body.PutJson("messages", AiClient.MessagesJson(messages));
        if (toolsJson != null && toolsJson.Length > 0) {
            body.PutJson("tools", toolsJson);
            // 让模型在需要时自己决定不调（有些服务方默认不许不调）。
            body.PutStr("tool_choice", "auto");
        }

        string raw = await this.PostJson(ep, "/chat/completions", body);
        if (raw == null) { return null; }
        AiToolTurn turn = AiClient.ParseToolTurn(raw);
        if (turn == null) {
            this.lastError = "AI 服务返回的内容无法解析";
            return null;
        }
        this.CaptureUsage(JsonValue.Parse(raw));
        return turn;
    }

    // 解析带工具的响应（公开是为了能单独测——归位、错误提取全在这里）。
    //
    // 坏 JSON → 返回 null。
    public static AiToolTurn ParseToolTurn(string raw) {
        JsonValue root = null;
        try {
            root = JsonValue.Parse(raw);
        } catch (Exception e) {
            return null;
        }
        if (root == null) { return null; }
        string errMsg = AiClient.ErrorMessage(root);
        if (errMsg.Length > 0) { return null; }
        JsonValue choices = root.Get("choices");
        if (choices == null || !choices.IsArray() || choices.Count() == 0) {
            return null;
        }
        JsonValue choice = choices.At(0);
        if (choice == null) { return null; }
        JsonValue msg = choice.Get("message");
        if (msg == null) { return null; }

        AiToolTurn turn = new AiToolTurn();
        turn.content = msg.Str("content", "");
        turn.finishReason = choice.Str("finish_reason", "");
        // 工具调用：按 index 归位（不靠数组顺序）。
        JsonValue calls = msg.Get("tool_calls");
        if (calls != null && calls.IsArray()) {
            for (int i = 0; i < calls.Count(); i = i + 1) {
                JsonValue one = calls.At(i);
                if (one == null) { continue; }
                string id = one.Str("id", "");
                JsonValue fn = one.Get("function");
                if (fn == null) { continue; }
                string name = fn.Str("name", "");
                string args = fn.Str("arguments", "");
                turn.toolCalls.Add(new AiToolCall(id, name, args));
            }
        }
        return turn;
    }

    // 补全并返回用量（成本核算用）。
    public async AiUsage CompleteWithUsage(string systemPrompt, string userPrompt) {
        string r = await this.Complete(systemPrompt, userPrompt);
        if (r == null) { return new AiUsage(); }
        return this.lastUsage;
    }

    // ------------------------------------------------------------------
    // 流式补全
    // ------------------------------------------------------------------

    // 流式补全：逐块把增量文本推给 onDelta。
    //
    // **增量投递**：传输在后台跑，字节边到边解析，onDelta 在**对应
    // 分片到达时**就被调用——不是等整条响应收完再一次性倾倒。整条
    // 缓冲完再回调等于没有流式：用户要等模型把话说完才看到第一个字。
    //
    // onDelta 返回 false 表示调用方要停止（客户端断开）——此时中止
    // 传输，返回已收到的全文。
    //
    // 返回完整文本（把所有增量拼起来）。失败返回 null，原因在
    // lastError。
    public async string Stream(List<AiMessage> messages, double temperature,
    AiDeltaFn onDelta) {
        this.lastError = "";
        AiEndpoint ep = AiEndpoint.Parse(this.config.baseUrl);
        if (ep == null) {
            this.lastError = "服务地址不合法: " + this.config.baseUrl;
            return null;
        }
        JsonValue body = JsonValue.NewObject();
        body.PutStr("model", this.config.model);
        if (temperature >= 0.0) {
            body.PutDouble("temperature", temperature);
        }
        body.PutBool("stream", true);
        body.PutJson("messages", AiClient.MessagesJson(messages));

        string payload = body.ToJson();
        if (payload.Length > this.config.requestLimitBytes) {
            this.lastError = "请求体超过上限（"
            + Convert.ToString(this.config.requestLimitBytes) + " 字节）";
            return null;
        }

        HttpClient http = this.StreamClient(ep);
        if (http == null) {
            this.lastError = "服务地址不合法: " + this.config.baseUrl;
            return null;
        }

        // 传输与消费分离：producer 把字节推进 sink（内存缓冲 + 事件门），
        // consumer 用 TakeCo 真挂起地等数据——有数据才醒，不靠轮询。
        SseSink sink = SseSink.ToMemory();
        Task.Spawn(http.PostSseToSinkAsync(ep.Path() + "/chat/completions",
        payload, sink));

        StringBuilder sb = new StringBuilder();
        // 半行缓冲：一次到达的字节可能把一行切成两半，跨次拼接。
        string pending = "";
        bool stopped = false;
        while (true) {
            SseDelivery d = await sink.TakeCo();
            if (d.data.Length > 0) {
                pending = pending + d.data;
                int nl = pending.IndexOf("\n");
                while (nl >= 0) {
                    string line = pending.Substring(0, nl).Trim();
                    pending = pending.Substring(nl + 1);
                    if (!this.OnStreamLine(line, sb, onDelta)) {
                        stopped = true;
                        break;
                    }
                    nl = pending.IndexOf("\n");
                }
            }
            if (stopped) {
                // 调用方主动停止：中止上游（别让对端接着算 token），
                // 返回已收到的全文。
                sink.Abort();
                break;
            }
            if (d.finished) { break; }
        }

        // 流结束时可能还剩半行：对端把最后一帧发了但**没以换行收尾**
        // （SSE 允许这样收尾，最后一个事件不必有空行）。这半行要按
        // 完整的一行处理，否则最后一个分片会被**静默丢掉**——收流
        // 正常结束、内容却少一截，且没有任何错误提示。
        if (!stopped && pending.Trim().Length > 0) {
            this.OnStreamLine(pending.Trim(), sb, onDelta);
        }

        // 传输结果：ok / err: ...
        //
        // **调用方主动停止不算失败**：中止上游必然让传输层报
        // "err: cancelled"，那是我们自己叫停的，报成错误会让调用方
        // 以为流挂了。
        if (!stopped) {
            string attempt = sink.Attempt();
            if (attempt.Length > 0 && attempt.StartsWith("err:")) {
                string reason = attempt.Substring(4).Trim();
                // 已经收到过内容却中途失败：内容仍然有用，但原因要报出来。
                this.lastError = "流式请求失败：" + reason;
                if (sb.Length == 0) { return null; }
            }
        }
        return sb.ToString();
    }

    // 解析一行 SSE。返回 false 表示调用方要求停止。
    private bool OnStreamLine(string line, StringBuilder sb, AiDeltaFn onDelta) {
        if (line.Length == 0) { return true; }
        if (!line.StartsWith("data:")) { return true; }
        string payload = line.Substring(5).Trim();
        if (payload == "[DONE]") { return true; }
        JsonValue frame = null;
        try {
            frame = JsonValue.Parse(payload);
        } catch (Exception e) {
            return true;   // 坏帧跳过，不让整条流断掉
        }
        if (frame == null) { return true; }
        JsonValue choices = frame.Get("choices");
        if (choices == null || !choices.IsArray() || choices.Count() == 0) {
            return true;
        }
        JsonValue delta = choices.At(0).Get("delta");
        if (delta == null) { return true; }
        string piece = delta.Str("content", "");
        if (piece.Length == 0) { return true; }
        sb.Append(piece);
        if (onDelta != null) {
            if (!onDelta(piece)) { return false; }
        }
        return true;
    }

    // 流式专用的客户端：Accept 必须是 text/event-stream，读取超时按
    // **空闲窗口**算（每收到一个分片就重新计时），否则长回答会被
    // 读超时掐断——读超时要的是"对端沉默一段时间"，不是"总共读多久"。
    private HttpClient StreamClient(AiEndpoint ep) {
        string key = ep.Canonical() + "|sse";
        if (this.clients.ContainsKey(key)) { return this.clients[key]; }
        HttpClient http = null;
        if (ep.Tls()) {
            http = HttpClient.CreateHttps(ep.Host(), ep.Port());
        } else {
            http = new HttpClient(ep.Host(), ep.Port());
        }
        ExternalCallPolicy p = this.Policy(ep).IdleTimeout(this.config.readTimeoutMs);
        http.SetCallPolicy(p);
        http.SetHeader("Content-Type", "application/json");
        http.SetHeader("Accept", "text/event-stream");
        if (this.config.apiKey.Length > 0) {
            http.SetHeader("Authorization", "Bearer " + this.config.apiKey);
        }
        this.clients[key] = http;
        return http;
    }


    // ------------------------------------------------------------------
    // 内部：HTTP
    // ------------------------------------------------------------------

    // 发起一次 POST（带重试）。失败返回 null，原因在 lastError。
    //
    // public 是因为 `Embeddings` 也用它（同一套出网预算与重试策略
    // 不该写两遍）。包内调用不会绕过 lastError 的约定。
    public async string PostJson(AiEndpoint ep, string path, JsonValue body) {
        string payload = body.ToJson();
        if (payload.Length > this.config.requestLimitBytes) {
            this.lastError = "请求体超过上限（"
            + Convert.ToString(this.config.requestLimitBytes) + " 字节）";
            return null;
        }
        int attempts = this.config.maxAttempts;
        if (attempts < 1) { attempts = 1; }
        string lastReason = "";
        for (int attempt = 0; attempt < attempts; attempt = attempt + 1) {
            if (attempt > 0) {
                // 指数退避：100ms / 200ms / 400ms …（上限 2 秒）。
                int wait = 100 * (1 << (attempt - 1));
                if (wait > 2000) { wait = 2000; }
                await Task.Delay(wait);
            }
            HttpClient http = null;
            try {
                http = this.Client(ep);
                HttpResponse resp = await http.SendAsync("POST", ep.Path() + path, payload);
                int status = resp.statusCode;
                string bodyText = resp.body;
                if (status >= 200 && status < 300) {
                    return bodyText;
                }
                // 4xx 不重试（请求本身有问题）。
                if (status < 500) {
                    this.lastError = AiClient.HttpErrorMessage(status, bodyText);
                    return null;
                }
                lastReason = "AI 服务返回 " + Convert.ToString(status);
            } catch (Exception e) {
                lastReason = "请求 AI 服务失败：" + e.Message;
            }
        }
        this.lastError = lastReason;
        return null;
    }

    // 取（或建）该端点的 `HttpClient`。
    //
    // 同一个端点复用同一个客户端，连接池才能生效；换端点就换客户端
    // （池是按 host/port 建的）。
    private HttpClient Client(AiEndpoint ep) {
        string key = ep.Canonical();
        if (this.clients.ContainsKey(key)) { return this.clients[key]; }
        HttpClient http = null;
        if (ep.Tls()) {
            http = HttpClient.CreateHttps(ep.Host(), ep.Port());
        } else {
            http = new HttpClient(ep.Host(), ep.Port());
        }
        http.SetCallPolicy(this.Policy(ep));
        http.SetHeader("Content-Type", "application/json");
        http.SetHeader("Accept", "application/json");
        if (this.config.apiKey.Length > 0) {
            http.SetHeader("Authorization", "Bearer " + this.config.apiKey);
        }
        this.clients[key] = http;
        return http;
    }

    // 出网预算。响应与请求体都有上限，超限的响应不会进内存。
    private ExternalCallPolicy Policy(AiEndpoint ep) {
        ExternalCallPolicy p = ExternalCallPolicy.Default()
        .ConnectTimeout(this.config.connectTimeoutMs)
        .ReadTimeout(this.config.readTimeoutMs)
        .TotalTimeout(this.config.totalTimeoutMs)
        .RequestLimit(this.config.requestLimitBytes)
        .ResponseLimit(this.config.responseLimitBytes)
        .ErrorLimit(128 * 1024)
        .Redirects(0)
        .RetryNetwork(false)
        .RetryAttempts(0);
        if (ep.Local()) { p.AllowLocalHttp(); }
        return p;
    }

    // ------------------------------------------------------------------
    // 静态辅助
    // ------------------------------------------------------------------

    // 消息列表 → JSON 数组文本。
    public static string MessagesJson(List<AiMessage> messages) {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < messages.Count; i = i + 1) {
            arr.Append(AiClient.MessageJson(messages[i]));
        }
        return arr.ToJson();
    }

    // 单条消息的 JSON。
    //
    // 三种形态（见 `AiMessage` 的说明）：
    // - system / user：role + content
    // - assistant：role + content + tool_calls（可空）
    // - tool：role + content + tool_call_id
    public static JsonValue MessageJson(AiMessage msg) {
        JsonValue m = JsonValue.NewObject();
        m.PutStr("role", msg.role);
        m.PutStr("content", msg.content);
        if (msg.IsTool() && msg.toolCallId.Length > 0) {
            m.PutStr("tool_call_id", msg.toolCallId);
        }
        if (msg.IsAssistant() && msg.toolCalls.Count > 0) {
            JsonValue calls = JsonValue.NewArray();
            for (int i = 0; i < msg.toolCalls.Count; i = i + 1) {
                AiToolCall c = msg.toolCalls[i];
                JsonValue fn = JsonValue.NewObject();
                fn.PutStr("name", c.name);
                fn.PutStr("arguments", c.arguments);
                JsonValue call = JsonValue.NewObject();
                call.PutStr("id", c.id);
                call.PutStr("type", "function");
                call.Put("function", fn);
                calls.Append(call);
            }
            m.Put("tool_calls", calls);
        }
        return m;
    }

    // 估算 token 数（启发式）。
    //
    // CJK 字符约 1 token，其余约 4 字符 1 token。这是各厂商 tokenizer
    // 的经验区间，不是真值——精确计数要接厂商的 tokenizer。
    //
    // 与 `Chunking.EstimateTokens` 是**同一把尺子**（`Chunking.TokenCost`
    // 的 4 倍刻度）——两处口径不一致会让"切出来说每块 100 token，
    // 一算却是 25"。
    public static int EstimateTokens(string text) {
        return Chunking.EstimateTokens(text);
    }

    // 从响应里取错误信息（OpenAI 兼容格式：error.message）。
    // 不是错误返回空串。
    public static string ErrorMessage(JsonValue root) {
        if (root == null) { return ""; }
        JsonValue err = root.Get("error");
        if (err == null || !err.IsObject()) { return ""; }
        return err.Str("message", "AI 服务返回错误");
    }

    // 从 HTTP 响应里提错误文案（4xx 时的解释）。
    private static string HttpErrorMessage(int status, string body) {
        string detail = "";
        if (body != null && body.Length > 0) {
            JsonValue root = null;
            try {
                root = JsonValue.Parse(body);
            } catch (Exception e) {
                root = null;
            }
            if (root != null) {
                detail = AiClient.ErrorMessage(root);
            }
        }
        if (detail.Length == 0) {
            detail = "AI 服务返回 " + Convert.ToString(status);
        }
        return detail;
    }

    // 记录用量：服务端口径与本包一致就用服务端的，否则保持估算。
    private void CaptureUsage(JsonValue root) {
        JsonValue usage = root.Get("usage");
        if (usage == null || !usage.IsObject()) { return; }
        JsonValue pt = usage.Get("prompt_tokens");
        JsonValue ct = usage.Get("completion_tokens");
        if (pt == null && ct == null) { return; }
        int p = pt == null ? 0 : (int)pt.AsDouble(0.0);
        int c = ct == null ? 0 : (int)ct.AsDouble(0.0);
        if (p <= 0 && c <= 0) { return; }
        this.lastUsage = new AiUsage(p, c, false);
    }

    // 上一次失败的原因（成功时为空串）。
    public string lastError;
    // 上一次调用的用量。
    public AiUsage lastUsage;
}

// 流式增量回调：返回 false 表示停止。
public delegate bool AiDeltaFn(string delta);
