using System;
using System.Collections.Generic;

namespace System.Ai;

// 重排器的**统一契约**——检索之后的第二道精排。
//
// ## 为什么需要这一层
//
// 双路检索（向量 + BM25）解决的是"召回"：把**可能相关**的块捞进来。
// 但 RRF 只看排名不看分数，捞进来的 top-k 里常常混着"词面沾边但
// 语义不对"的块——专有名词、缩写、多义词的典型受害者。
//
// 重排用一个**更强的模型**给"查询-文档对"逐对打分（cross-encoder
// 同时看两边，vs. 检索的双塔各自编码再比），精度显著高于召回。
//
// 代价：**慢且贵**。所以标准形态是"宽召回 + 窄精排"——先用便宜的双路
// 检索捞 50~100 条，再用重排精排成 top-5~10。
//
// ## 为什么是接口
//
// 重排有三种常见实现，成本与部署形态差别很大：
//
// 1. **重排 API**（`/v1/rerank`，如 Jina、Cohere）：跨编码器模型托管在
//    别人家，最省事，按量付费。
// 2. **本地 cross-encoder**（如 bge-reranker）：部署在本地/自己的机器，
//    无调用费，但要占显存。
// 3. **LLM 打分**（让通用大模型给每对打分）：不需要专用模型，但最慢
//    最贵。
//
// 三者的输入输出形态一致（查询 + 候选文本 → 分数），所以**接口放在
// 这一层**，上层（`Rag`）不关心用的是哪种。
//
// ## 失败语义
//
// 失败用返回值不用异常（本包一致）：返回 null（原因在 `LastError`）。
//
// **重排失败不该让整个问答失败**——重排是**增强**，不是必需。调用方
// 拿到 null 时应当**退回未重排的候选**（降级），而不是报错。这条在
// `Rag` 里已经落实：重排失败 → 用原顺序继续。

public interface IReranker {
    // 重排：给每条候选打相关性分，按分数降序返回。
    //
    // query 是查询文本；documents 是候选文本（顺序即下标）。返回的每条
    // 结果带 `index`（候选下标）与 `score`。
    //
    // topN > 0 时只返回前 topN 条；<= 0 表示全返回。
    //
    // 失败返回 null（原因在 `LastError`）。
    async List<RerankHit> Rerank(string query, List<string> documents, int topN);

    // 上一次失败的原因（成功时为空串）。
    string LastError();
}
