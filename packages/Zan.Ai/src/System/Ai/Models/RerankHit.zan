using System;

namespace System.Ai;

// 一条重排结果。
//
// - index：**候选数组里的下标**（不是 id）。重排服务只看到文本，看不到
//   你的 id——所以返回的是下标，由调用方映射回自己的实体。
// - score：相关性分数（越大越相关）。
//
// **分数的量纲由重排服务决定**（各家不同，有的在 0~1，有的是无上界的
// logit）。所以它**不能**和 RRF 分数直接相加或比较——量纲不同。融合
// 只能靠排名（RRF 那套）。
//
// 为什么实体而不是"下标 + 分数"两个平行数组：下标与分数是一一对应的
// 记录，用平行数组就等着某处丢掉对应关系。
public class RerankHit {
    // 候选数组里的下标（0 起）。
    public int index;

    // 相关性分数（越大越相关；量纲由服务决定）。
    public double score;

    public RerankHit() {
        this.index = 0;
        this.score = 0.0;
    }

    public RerankHit(int index, double score) {
        this.index = index;
        this.score = score;
    }
}
