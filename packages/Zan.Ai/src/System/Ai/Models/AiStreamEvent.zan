using System;

namespace System.Ai;

// 流式会话里的一个事件。
//
// ## 为什么用实体而不是"魔法字符串"
//
// 流里不只有"文本增量"这一件事：还有工具调用的增量（序号 / id / 名字 /
// 参数片段）、用量、结束、错误。用字符串前缀（`"tool:"`、`"err:"`）让
// 调用方靠 `StartsWith` 猜是最容易写错的一种设计——前缀拼错的分支永远
// 不命中，也没人会发现。所以事件是实体，种类放在 `kind` 字段里。
//
// ## 五种事件
//
// | kind | 含义 | 关键字段 |
// |---|---|---|
// | `delta` | 一段增量文本 | `text` |
// | `tool` | 工具调用的增量 | `toolIndex` / `toolId` / `toolName` / `args` |
// | `usage` | 用量更新 | `inputTokens` / `outputTokens` |
// | `done` | 流结束 | `finishReason` |
// | `error` | 流内错误 | `error` |
//
// ## 工具调用的增量是**片段**
//
// 服务方把工具参数分成几段发（`args` 是 JSON 文本的**片段**，不是完整
// JSON）。同一次调用的片段靠 `toolIndex` 归位——**不靠到达顺序**：服务方
// 可能先发第 2 个工具的参数片段，再发第 1 个的。
//
// `toolId` 与 `toolName` 只在**第一段**里带，后续片段不带（甚至有些
// 服务方整个调用只带一次名字）。所以拼装时是"有值才覆盖"，不是"每段都
// 赋值"——否则后一段的空名字会把前面的真名字抹掉。
public class AiStreamEvent {
    // 事件种类（见类注释里的表）。
    public string kind;

    // 增量文本（kind = "delta"）。
    public string text;

    // 工具调用的序号（kind = "tool"）——归位用。
    public int toolIndex;

    // 工具调用的标识与名字（kind = "tool"）。
    public string toolId;
    public string toolName;

    // 工具参数的**增量** JSON 片段（kind = "tool"）。
    public string args;

    // 结束原因（kind = "done"）："stop" / "tool_calls" / "tool_use" …
    // （可能为空——不保证每家都填）。
    public string finishReason;

    // 错误原因（kind = "error"）。
    public string error;

    // 用量（kind = "usage"）。
    public int inputTokens;
    public int outputTokens;

    public AiStreamEvent() {
        this.kind = "";
        this.text = "";
        this.toolIndex = 0;
        this.toolId = "";
        this.toolName = "";
        this.args = "";
        this.finishReason = "";
        this.error = "";
        this.inputTokens = 0;
        this.outputTokens = 0;
    }

    public AiStreamEvent(string kind) {
        this.kind = kind == null ? "" : kind;
        this.text = "";
        this.toolIndex = 0;
        this.toolId = "";
        this.toolName = "";
        this.args = "";
        this.finishReason = "";
        this.error = "";
        this.inputTokens = 0;
        this.outputTokens = 0;
    }
}
