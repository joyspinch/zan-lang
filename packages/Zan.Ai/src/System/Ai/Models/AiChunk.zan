using System;

namespace System.Ai;

// 一个文本块（分块的输出）。
//
// 块之间靠 index 保持原顺序，start/end 是它在**原文**里的字符偏移
// （[start, end)）——有了偏移才能把检索到的块还原回原文上下文，
// 这是 RAG 引用溯源的基础。
public class AiChunk {
    public string text;

    // 在原文里的字符偏移（左闭右开）。
    public int start;
    public int end;

    // 块序号（0 起，按原文顺序）。
    public int index;

    // 估算的 token 数。
    public int tokens;

    public AiChunk(string text, int start, int end, int index, int tokens) {
        this.text = text == null ? "" : text;
        this.start = start;
        this.end = end;
        this.index = index;
        this.tokens = tokens;
    }

    // 长度（字符数）。
    public int Length() { return this.text.Length; }
}
