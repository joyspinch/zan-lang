using System;
using System.Collections.Generic;
using System.Json;

namespace System.Ai;

// 一个工具的声明（发给服务方的 schema）。
public class AiTool {
    // 函数名（模型用它来调用）。
    public string name;

    // 描述（给模型看的）。
    public string description;

    // 参数的 JSON schema 文本。
    public string parametersJson;

    // 参数字典结构（可选）。
    public Dictionary<string, string> parameters;

    public AiTool() {
        this.name = "";
        this.description = "";
        this.parametersJson = "";
        this.parameters = null;
    }

    public AiTool(string name, string description) {
        this.name = name == null ? "" : name;
        this.description = description == null ? "" : description;
        this.parametersJson = "";
        this.parameters = null;
    }

    public AiTool(string name, string description, string parametersJson) {
        this.name = name == null ? "" : name;
        this.description = description == null ? "" : description;
        this.parametersJson = parametersJson == null ? "" : parametersJson;
        this.parameters = null;
    }

    public AiTool(string name, string description, Dictionary<string, string> parameters) {
        this.name = name == null ? "" : name;
        this.description = description == null ? "" : description;
        this.parameters = parameters;
        this.parametersJson = parameters == null ? "" : Json.Serialize(parameters);
    }

    // 序列化成服务方要的形状。
    public void WriteTo(JsonWriter w) {
        w.StartObject();
        w.WriteProperty("type", "function");
        w.WriteKey("function");
        w.StartObject();
        w.WriteProperty("name", this.name);
        w.WriteProperty("description", this.description);
        w.WriteKey("parameters");
        if (this.parametersJson != null && this.parametersJson.Length > 0) {
            w.WriteRaw(this.parametersJson);
        } else if (this.parameters != null) {
            w.WriteRaw(Json.Serialize(this.parameters));
        } else {
            w.StartObject();
            w.WriteProperty("type", "object");
            w.EndObject();
        }
        w.EndObject();
        w.EndObject();
    }

    public string ToJson() {
        JsonWriter w = new JsonWriter();
        this.WriteTo(w);
        return w.ToJson();
    }
}
