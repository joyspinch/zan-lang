using System;
using System.Json;

namespace System.Ai;

// 一个工具的**声明**（发给服务方的 schema）。
//
// ## 为什么要自己声明，而不是让服务方猜
//
// 模型**不知道**你的程序里有什么函数。工具声明就是告诉它："你有这些
// 能力，参数长这样"。写得越具体，模型调得越准；写得含糊（比如参数
// 叫 `x`、描述是"随便"），模型就靠猜，猜错就白跑一轮。
//
// ## schema 的形状
//
// OpenAI 兼容格式：
//
//   {"type": "function",
//    "function": {"name": "...", "description": "...",
//                 "parameters": {"type": "object",
//                                "properties": {...},
//                                "required": [...]}}}
//
// ## 声明与实现是**分开的**
//
// `AiTool`（本类）只是**声明**；实现是 `AiToolImpl`。分开是因为声明
// 要序列化给服务方，实现不能（实现是代码）。
//
// 这也带来一个好处：同一个声明可以对应多个实现（测试替身、真实实现、
// 危险操作的确认版）。

public class AiTool {
    // 函数名（模型用它来调用）。
    public string name;

    // 描述（**给模型看的**——要写清楚这个工具做什么、什么时候用）。
    //
    // 描述的质量直接决定调用准确率：模型靠描述判断"这个工具能不能解
    // 决我的问题"。写"查订单"不如写"按订单号查订单的当前状态与物流
    // 进度"——后者让模型知道什么时候该用它。
    public string description;

    // 参数的 JSON schema（对象，字段自己拼）。
    public JsonValue parameters;

    public AiTool() {
        this.name = "";
        this.description = "";
        this.parameters = null;
    }

    public AiTool(string name, string description, JsonValue parameters) {
        this.name = name == null ? "" : name;
        this.description = description == null ? "" : description;
        this.parameters = parameters;
    }

    // 序列化成服务方要的形状。
    public JsonValue ToJson() {
        JsonValue fn = JsonValue.NewObject();
        fn.PutStr("name", this.name);
        fn.PutStr("description", this.description);
        if (this.parameters != null) {
            fn.Put("parameters", this.parameters);
        } else {
            JsonValue p = JsonValue.NewObject();
            p.PutStr("type", "object");
            fn.Put("parameters", p);
        }
        JsonValue tool = JsonValue.NewObject();
        tool.PutStr("type", "function");
        tool.Put("function", fn);
        return tool;
    }
}
