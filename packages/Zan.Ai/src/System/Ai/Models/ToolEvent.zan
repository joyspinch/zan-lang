using System;

namespace System.Ai;

// 工具循环里的**一步**。
//
// ## 为什么要有事件而不是只在结束时给结果
//
// 一轮对话可能调了五轮工具、烧了不少钱。出问题时（模型调了个奇怪的
// 工具、某个工具一直返回错）要能看清**每一步**——调了什么、返回了什
// 么、是不是错的。只给最终结果的话，中间那些看不见。
//
// 所以每次工具执行产生一条 `ToolEvent`，最后一条是 `"final"`（模型
// 的最终答案）或 `"limit"`（撞了调用上限）。
//
// ## 字段
//
// - kind：`"tool"`（执行了一次工具）/ `"final"`（模型给出答案）/
//   `"limit"`（撞了调用上限，提前停）。
// - name：工具名（kind = "tool" 时有意义）。
// - text：内容——工具的返回值，或最终答案，或上限提示。
// - isError：这次工具调用是不是失败的。

public class ToolEvent {
    // 事件种类：tool / final / limit。
    public string kind;

    // 工具名。
    public string name;

    // 内容。
    public string text;

    // 这次工具调用是不是失败的。
    public bool isError;

    public ToolEvent() {
        this.kind = "";
        this.name = "";
        this.text = "";
        this.isError = false;
    }

    public ToolEvent(string kind, string name, string text, bool isError) {
        this.kind = kind == null ? "" : kind;
        this.name = name == null ? "" : name;
        this.text = text == null ? "" : text;
        this.isError = isError;
    }
}
