using System;
using System.Collections.Generic;
using System.Json;

namespace System.Ai;

// 一次"带工具的补全"的结果。
//
// ## 为什么要有这个类
//
// 带工具的补全，模型可能返回三种东西：
//
// 1. **直接给答案**（content 有文本，没调工具）——这一轮就结束了。
// 2. **请求调工具**（tool_calls 非空）——要执行工具、把结果回传，再问一次。
// 3. **又调又说**（content 有文本 + tool_calls 非空）——先看它说了什么，
//    再执行工具。
//
// 这三种在协议里是**同一个响应**，所以解析出来得是一个能表达全部情况的
// 实体——`AiToolTurn`。
//
// ## 一个关键点：finish_reason
//
// 服务方会用 `finish_reason` 告诉你是哪种情况（`tool_calls` 表示这次是
// 因为要调工具才停的，`stop` 表示说完了）。但**不保证每家都填**——
// 有的服务方不填。所以判断"要不要继续"要**看 `toolCalls` 是否为空**，
// 不能只看 `finish_reason`。
//
// 靠 `finish_reason` 判断的坑：服务方不填时，你会以为模型说完了，直接
// 把半截答案当最终答案返回——工具根本没被调用。

public class AiToolTurn {
    // 模型这一轮说的话（可能为空——它在调工具时一般不说话）。
    public string content;

    // 模型请求的工具调用（空 = 这一轮没有要调的工具）。
    public List<AiToolCall> toolCalls;

    // 服务方给的 finish_reason（可能为空——不保证每家都填）。
    public string finishReason;

    public AiToolTurn() {
        this.content = "";
        this.toolCalls = new List<AiToolCall>();
        this.finishReason = "";
    }

    // 这一轮是不是在要调工具。
    public bool WantsTools() { return this.toolCalls.Count > 0; }
}
