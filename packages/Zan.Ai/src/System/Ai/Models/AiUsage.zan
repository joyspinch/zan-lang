using System;

namespace System.Ai;

// 一次调用的用量。
//
// promptTokens / completionTokens 是**估算值**（见 AiClient.EstimateTokens
// 的启发式），不是厂商返回的真值——多数厂商的响应里确实带 usage，
// 但各家字段名与语义不一致（有的把 reasoning token 单列、有的把
// cached token 单列），统一口径会让数字对不上。所以本包一律用估算，
// 并用 estimated 标出来，调用方需要精确值时自己读原始响应。
public class AiUsage {
    public int promptTokens;
    public int completionTokens;
    public int totalTokens;

    // true 表示数字是启发式估算而非厂商回报的真值。
    public bool estimated;

    public AiUsage() {
        this.promptTokens = 0;
        this.completionTokens = 0;
        this.totalTokens = 0;
        this.estimated = true;
    }

    public AiUsage(int promptTokens, int completionTokens, bool estimated) {
        this.promptTokens = promptTokens;
        this.completionTokens = completionTokens;
        this.totalTokens = promptTokens + completionTokens;
        this.estimated = estimated;
    }

    // 成本（按单价表）。单价单位是"每百万 token"。
    //
    // pricing 为 null 时返回 0.0——**本包不内置价格**（价格会变，
    // 内置就是内置一份会过期的谎言），由调用方传。
    public double Cost(AiPricing pricing) {
        if (pricing == null) { return 0.0; }
        double inTok = (double)this.promptTokens / 1000000.0 * pricing.inputPerMillion;
        double outTok = (double)this.completionTokens / 1000000.0 * pricing.outputPerMillion;
        return inTok + outTok;
    }
}

// 模型单价（每百万 token 的价格）。
public class AiPricing {
    public string model;
    public double inputPerMillion;
    public double outputPerMillion;

    public AiPricing(string model, double inputPerMillion, double outputPerMillion) {
        this.model = model == null ? "" : model;
        this.inputPerMillion = inputPerMillion;
        this.outputPerMillion = outputPerMillion;
    }
}
