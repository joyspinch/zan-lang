using System;

namespace System.Ai;

// AI 客户端配置。
//
// baseUrl 是**服务根地址**（形如 "https://api.deepseek.com/v1"），
// 实际请求路径是 baseUrl + "/chat/completions"（或 "/embeddings"）。
// apiKey 可以是空串（本地 Ollama 不需要 key）。
public class AiConfig {
    public string baseUrl;
    public string apiKey;
    public string model;

    // 超时与重试预算。
    public int connectTimeoutMs;
    public int readTimeoutMs;
    public int totalTimeoutMs;
    public int maxAttempts;

    // 单次请求的请求体上限（字节）——防超大提示词打爆内存。
    public int requestLimitBytes;
    public int responseLimitBytes;

    public AiConfig(string baseUrl, string apiKey, string model) {
        this.baseUrl = baseUrl == null ? "" : baseUrl;
        this.apiKey = apiKey == null ? "" : apiKey;
        this.model = model == null ? "" : model;
        this.connectTimeoutMs = 10000;
        this.readTimeoutMs = 60000;
        this.totalTimeoutMs = 120000;
        this.maxAttempts = 1;
        this.requestLimitBytes = 2 * 1024 * 1024;
        this.responseLimitBytes = 8 * 1024 * 1024;
    }

    // 复制一份配置（改副本不影响原配置）。
    public AiConfig Clone() {
        AiConfig c = new AiConfig(this.baseUrl, this.apiKey, this.model);
        c.connectTimeoutMs = this.connectTimeoutMs;
        c.readTimeoutMs = this.readTimeoutMs;
        c.totalTimeoutMs = this.totalTimeoutMs;
        c.maxAttempts = this.maxAttempts;
        c.requestLimitBytes = this.requestLimitBytes;
        c.responseLimitBytes = this.responseLimitBytes;
        return c;
    }
}
