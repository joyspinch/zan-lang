using System;

namespace System.Ai;

// 一条检索命中。
//
// **同时携带两路的原始排名与原始分数**——RRF 只用排名，丢掉了分数的
// 绝对信息。调用方要自己加权（而不是用 RRF）时，这些字段是必需的。
//
// - vectorRank：向量路的名次（1 起，0 = 该路没命中）
// - bm25Rank：字面路的名次（1 起，0 = 该路没命中）
// - vectorDistance：向量路的距离（余弦度量下 = 1 - cos_sim，越小越近）
// - bm25Score：字面路的 BM25 分数（越大越相关）
// - score：RRF 融合分数（越大越相关）
public class RetrieverHit {
    public int id;

    // 向量路名次（0 = 没命中）。
    public int vectorRank;

    // 字面路名次（0 = 没命中）。
    public int bm25Rank;

    // 向量路距离。
    public double vectorDistance;

    // 字面路分数。
    public double bm25Score;

    // RRF 融合分数。
    public double score;

    public RetrieverHit() {
        this.id = 0;
        this.vectorRank = 0;
        this.bm25Rank = 0;
        this.vectorDistance = 0.0;
        this.bm25Score = 0.0;
        this.score = 0.0;
    }

    public RetrieverHit(int id) {
        this.id = id;
        this.vectorRank = 0;
        this.bm25Rank = 0;
        this.vectorDistance = 0.0;
        this.bm25Score = 0.0;
        this.score = 0.0;
    }

    // 两路都命中了吗。
    public bool BothHit() {
        return this.vectorRank > 0 && this.bm25Rank > 0;
    }

    public static RetrieverHit Of(int id) {
        return new RetrieverHit(id);
    }
}
