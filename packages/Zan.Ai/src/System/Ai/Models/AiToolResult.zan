using System;

namespace System.Ai;

// 一次工具调用的**结果**。
//
// ## id 必须原样带回
//
// `id` 是服务方给的调用标识。回传结果时必须**原样**带上——服务方靠它
// 把结果和这次调用对上。丢了 id 或自己编一个，服务方就找不到对应的
// 调用，模型会一直等（或者干脆当成没调过）。
//
// ## 错误结果也要回给模型
//
// 工具执行失败时**回一个错误结果**，而不是静默跳过或抛异常。模型看到
// "参数 x 不存在" 之后能自己纠正（换个参数重试）；看不到的话它只会
// 以为自己已经查过了，然后编一个答案。
//
// 所以 `isError` 是**结果的一部分**，不是异常。

public class AiToolResult {
    // 对应的调用标识（原样带回）。
    public string id;

    // 结果内容（给模型看的文本）。
    public string content;

    // true 表示这是**错误结果**（内容是要给模型看的错误说明）。
    public bool isError;

    public AiToolResult() {
        this.id = "";
        this.content = "";
        this.isError = false;
    }

    public AiToolResult(string id, string content, bool isError) {
        this.id = id == null ? "" : id;
        this.content = content == null ? "" : content;
        this.isError = isError;
    }

    // 成功结果。
    public static AiToolResult Ok(string id, string content) {
        return new AiToolResult(id, content, false);
    }

    // 错误结果。
    public static AiToolResult Error(string id, string message) {
        return new AiToolResult(id, message == null ? "工具执行失败" : message,
        true);
    }
}
