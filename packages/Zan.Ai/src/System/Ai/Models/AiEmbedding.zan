using System;

namespace System.Ai;

// 一次嵌入（embedding）调用的结果。
//
// 一批文本对应一批向量，**一一对应**（顺序与输入相同）。用实体承载
// 而不是"向量数组 + 索引数组"的平行结构——平行数组的对应关系一旦
// 在某一层丢掉，后面全是错位 bug。
public class AiEmbedding {
    // 每个输入文本的向量（顺序与输入一致）。
    public List<List<double>> vectors;

    // 向量维度（所有向量同维；0 表示没有向量）。
    public int dimensions;

    // 本次调用的 token 用量。
    public AiUsage usage;

    public AiEmbedding() {
        this.vectors = new List<List<double>>();
        this.dimensions = 0;
        this.usage = new AiUsage();
    }

    public AiEmbedding(List<List<double>> vectors, int dimensions, AiUsage usage) {
        this.vectors = vectors == null ? new List<List<double>>() : vectors;
        this.dimensions = dimensions;
        this.usage = usage == null ? new AiUsage() : usage;
    }

    // 向量个数。
    public int Count() { return this.vectors.Count; }

    // 第 i 个向量（越界返回空表，不抛）。
    public List<double> At(int i) {
        if (i < 0 || i >= this.vectors.Count) { return new List<double>(); }
        return this.vectors[i];
    }

    // 两个向量的余弦相似度。
    //
    // 维度不等返回 0.0；含零向量返回 0.0（零向量与任何向量的余弦
    // 无定义，返回 0 比返回 NaN 好——NaN 会污染下游排序）。
    public static double Cosine(List<double> a, List<double> b) {
        if (a == null || b == null) { return 0.0; }
        if (a.Count != b.Count) { return 0.0; }
        if (a.Count == 0) { return 0.0; }
        double dot = 0.0;
        double na = 0.0;
        double nb = 0.0;
        for (int i = 0; i < a.Count; i = i + 1) {
            double x = a[i];
            double y = b[i];
            dot = dot + x * y;
            na = na + x * x;
            nb = nb + y * y;
        }
        if (na <= 0.0 || nb <= 0.0) { return 0.0; }
        return dot / (Math.Sqrt(na) * Math.Sqrt(nb));
    }
}
