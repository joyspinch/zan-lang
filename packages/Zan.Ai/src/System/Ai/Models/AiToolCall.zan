using System;
using System.Collections.Generic;
using System.Json;

namespace System.Ai;

// 模型请求调用的一次工具。
public class AiToolCall {
    // 调用标识（回传结果时要原样带上）。
    public string id;

    // 函数名。
    public string name;

    // 参数（JSON 串）。
    public string arguments;

    public AiToolCall() {
        this.id = "";
        this.name = "";
        this.arguments = "";
    }

    public AiToolCall(string id, string name, string arguments) {
        this.id = id == null ? "" : id;
        this.name = name == null ? "" : name;
        this.arguments = arguments == null ? "" : arguments;
    }

    // 解析参数为键值字典。
    // 坏 JSON → 返回 null。不抛异常。
    public Dictionary<string, string> ParseArgs() {
        if (this.arguments == null || this.arguments.Length == 0) {
            return new Dictionary<string, string>();
        }
        try {
            JsonDoc doc = JsonDoc.Parse(this.arguments);
            if (doc == null || doc.KindAt(0) != 5) {
                return null;
            }
            Dictionary<string, string> dict = new Dictionary<string, string>();
            int cnt = doc.Count(0);
            for (int i = 0; i < cnt; i = i + 1) {
                string k = doc.KeyAt(0, i);
                int v = doc.ValAt(0, i);
                dict[k] = doc.StrAt(v, "");
            }
            return dict;
        } catch (Exception _ex) {
            // 工具调用入参 JSON 反序列化解析失败时返回 null
            return null;
        }
    }
}
