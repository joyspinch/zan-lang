using System;
using System.Json;

namespace System.Ai;

// 模型请求调用的一次工具。
//
// ## 为什么要实体
//
// 一次调用有**三个字段**：id、函数名、参数（JSON 串）。用平行数组
// 装就是"靠下标对齐"——`calls[i][0]` 是 id 还是函数名，谁也说不清。
//
// ## 字段
//
// - id：服务方给的调用标识。**回传结果时必须原样带上**——服务方靠它把
//   结果和这次调用对上。丢了它就没有办法把结果送回去。
// - name：函数名。
// - arguments：参数（**JSON 串**，不是已解析的对象——协议就是这么传
//   的，服务方给的就是一串 JSON 文本）。
//
// ## 参数的坑
//
// 服务方**不保证**给的参数是合法 JSON，也不保证参数符合你声明的
// schema（OpenAI 文档明说："the model does not always generate valid
// JSON, and may hallucinate parameters"）。所以：解析要兜住异常，参数
// 要按 schema 校验，**不合法就当这次调用失败**（回一个错误结果给模型，
// 让它自己纠正），不要把脏数据传进业务代码。

public class AiToolCall {
    // 调用标识（回传结果时要原样带上）。
    public string id;

    // 函数名。
    public string name;

    // 参数（JSON 串）。
    public string arguments;

    public AiToolCall() {
        this.id = "";
        this.name = "";
        this.arguments = "";
    }

    public AiToolCall(string id, string name, string arguments) {
        this.id = id == null ? "" : id;
        this.name = name == null ? "" : name;
        this.arguments = arguments == null ? "" : arguments;
    }

    // 解析参数。
    //
    // 坏 JSON → 返回 null（原因在 `lastError`）。**不抛异常**：模型的
    // 输出是不可信输入，解析外部数据必须兜住。
    public JsonValue ParseArgs() {
        if (this.arguments == null || this.arguments.Length == 0) {
            return new JsonValue();
        }
        try {
            return JsonValue.Parse(this.arguments);
        } catch (Exception e) {
            return null;
        }
    }
}
