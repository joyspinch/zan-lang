using System;
using System.Collections.Generic;

namespace System.Ai;

// 一轮流式会话的结果。
//
// ## 与非流式的 `AiToolTurn` 差在哪
//
// 非流式只有"成功 / 失败"两种结局。流式不是：**流可以只拿到一半**——
// 服务方在流中途报错、连接被掐断、调用方主动叫停，这些都会留下"半截
// 内容"。半截内容**仍然有用**（用户已经看到的字不能白看），所以流式的
// 结果对象总是存在，失败信息放在 `error` 里，而不是"失败就返回 null"。
//
// `AiClient.Stream`（只收文本的老接口）保留着"失败返回 null"的约定；
// 那是它的历史契约，不是流式的通用约定。
public class AiStreamResult {
    // 完整正文（所有文本增量拼起来）。
    public string text;

    // 拼装好的工具调用（**按服务方的序号归位**，不靠到达顺序）。
    public List<AiToolCall> toolCalls;

    // 结束原因（"stop" / "tool_calls" / "tool_use" …；可能为空）。
    public string finishReason;

    // 用量。服务方没回报时是**估算值**（`usage.estimated` 为 true）。
    public AiUsage usage;

    // true = 调用方主动叫停（回调返回了 false）。
    //
    // **主动停止不算失败**：`error` 保持为空——中止上游必然让传输层报
    // "err: cancelled"，那是我们自己叫停的，报成错误会让调用方以为流
    // 挂了。
    public bool stopped;

    // 失败原因（空串 = 没失败）。
    public string error;

    // true = 用量数字来自服务方的回报（false = 本包估算的）。
    public bool usageReported;

    public AiStreamResult() {
        this.text = "";
        this.toolCalls = new List<AiToolCall>();
        this.finishReason = "";
        this.usage = new AiUsage();
        this.stopped = false;
        this.error = "";
        this.usageReported = false;
    }

    // 这一轮是否成功（没有失败原因）。
    public bool Ok() { return this.error.Length == 0; }

    // 这一轮是不是要调工具。
    public bool WantsTools() { return this.toolCalls.Count > 0; }
}
