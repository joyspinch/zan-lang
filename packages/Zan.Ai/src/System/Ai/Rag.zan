using System;
using System.Collections.Generic;
using System.Text;

namespace System.Ai;

// RAG 编排：文档 → 分块 → 向量化 → 索引 → 检索 → 拼提示词 → 生成。
//
// ## 这层是"组装线"
// Zan 的 AI 侧零件本来就齐（分词器、BM25、HNSW 索引、HttpClient），
// 缺的是把它们串起来的这条链。本类就是那条链。
//
// ## 两种用法
//
// 1）**在线模式**（`Ask`）：每次问答都调 embedding 服务 + 补全服务。
//    文档已经在库里，查询要现算查询向量。
// 2）**离线索引模式**（`Index`）：先把文档切块、向量化、入库；查询时
//    只调 embedding + 补全。文档多的场景用这个（embedding 比补全便宜，
//    但没必要为同一份文档反复付费）。
//
// ## 后端无关
//
// 检索与写入都走**接口**（`IRetriever` / `IIndexWriter`），所以内存档、
// 本地持久化档、远端档都能直接接进编排层——三档的检索语义一致
// （同一 RRF 公式、同一命中实体），换后端不改变答案。
//
// 写侧**必须**与读侧配套：检索器要能取回命中的原文（引用溯源要它），
// 写入器要能写进同一个库。所以 `Rag` 要求两者来自**同一个后端**——
// 这不是限制，是正确性要求（写进 A 库、从 B 库读，是配错了）。
//
// ## 引用溯源
//
// `RagAnswer` 带 `citations`（命中的块 + 原文 + 分数）。这是 RAG 与
// "把整个文档塞进提示词"的关键差别——**答案能指回原文**。
//
// ## 失败语义
//
// 与 `AiClient` 一致：**失败用返回值不用异常**。`Ask` 返回 null 时，
// `lastError` 有可读原因（embedding 失败 / 补全失败 / 检索无结果…）。

public class Rag {
    // 客户端（调 embedding 与补全）。
    private AiClient client;

    // 检索器（后端无关）。
    private IRetriever retriever;

    // 写入器（后端无关）。
    private IIndexWriter writer;

    // 重排器（可为 null —— 不重排）。
    private IReranker reranker;

    // 分块参数。
    private int chunkChars;
    private int chunkOverlap;

    // 提示词模板。
    private string template;

    // 检索条数（进提示词的条数）。
    private int topK;

    // 召回条数（重排前的候选池大小）。
    private int recallK;

    // 上一次失败的原因。
    public string lastError;

    // 上一次**重排**失败的原因（重排失败不影响问答成功——降级继续）。
    public string rerankError;

    public Rag(AiClient client, IRetriever retriever, IIndexWriter writer) {
        this.client = client;
        this.retriever = retriever;
        this.writer = writer;
        this.reranker = null;
        this.chunkChars = 800;
        this.chunkOverlap = 120;
        this.topK = 4;
        this.recallK = 0;
        this.template = Rag.DefaultTemplate();
        this.lastError = "";
        this.rerankError = "";
    }

    // 分块参数（字节；中文一字 3 字节，800 字节约 260 字）。
    public void SetChunking(int maxChars, int overlap) {
        this.chunkChars = maxChars;
        this.chunkOverlap = overlap;
    }

    // 检索条数。
    public void SetTopK(int k) {
        if (k < 1) { k = 1; }
        this.topK = k;
    }

    // 装重排器（宽召回 + 窄精排）。
    //
    // recallK 是**重排前**的候选池大小（默认 topK 的 5 倍，最低 20）。
    // 召回要宽（别把对的漏掉），精排要窄（只留最相关的几条进提示词）。
    //
    // 为什么不设成 topK 的固定倍数：候选太宽，重排要打很多分（慢且贵）；
    // 太窄又漏。所以让调用方按自己的候选质量调。
    public void SetReranker(IReranker reranker, int recallK) {
        this.reranker = reranker;
        this.recallK = recallK;
    }

    // 召回条数（重排前的候选池大小）。
    private int RecallK() {
        if (this.reranker == null) { return this.topK; }
        int want = this.recallK;
        if (want < this.topK) { want = this.topK; }
        if (want < 20) { want = 20; }
        return want;
    }

    // 提示词模板（`{{context}}` 与 `{{question}}` 是占位符）。
    public void SetTemplate(string t) {
        this.template = t == null ? Rag.DefaultTemplate() : t;
    }

    // 默认提示词模板。
    //
    // 要求模型**只依据资料回答**、资料不足时明说——不这么要求，模型会
    // 用自己的先验知识编答案（幻觉），而用户分不清哪些是资料里的。
    public static string DefaultTemplate() {
        return "请只依据下面的资料回答问题。资料里没有的信息，直接说"
        + "「资料中未提及」，不要用你自己的知识补全。\n\n"
        + "资料：\n{{context}}\n\n问题：{{question}}\n\n回答：";
    }

    // 离线索引：把文档切块并向量化入库。
    //
    // 返回入库的块数；失败返回 -1（原因在 lastError）。
    //
    // **id 由后端分配**（`IIndexWriter.Write` 返回）——数据库档的 id 是
    // 服务端在事务内发的，调用方给的 id 会撞车（两个进程同时写）。
    public async int Index(string document) {
        this.lastError = "";
        if (this.writer == null) { this.lastError = "没有写入器"; return -1; }
        if (this.client == null) { this.lastError = "没有客户端"; return -1; }
        List<AiChunk> chunks = Chunking.Recursive(document, this.chunkChars,
        this.chunkOverlap);
        if (chunks.Count == 0) { this.lastError = "文档为空"; return -1; }

        // 向量化。
        List<string> texts = new List<string>();
        for (int i = 0; i < chunks.Count; i = i + 1) {
            texts.Add(chunks[i].text);
        }
        AiEmbedding emb = await Embeddings.EmbedChunks(this.client, chunks, true);
        if (emb == null) {
            this.lastError = "向量化失败：" + this.client.lastError;
            return -1;
        }
        // 入库（id 由后端分配）。
        List<int> ids = await this.writer.Write(texts, emb.vectors, null);
        if (ids == null) {
            this.lastError = "入库失败：" + this.writer.LastError();
            return -1;
        }
        return ids.Count;
    }

    // 在线问答：检索 → 拼提示词 → 调补全。
    //
    // 返回答案（含引用）；失败返回 null（原因在 lastError）。
    public async RagAnswer Ask(string question) {
        this.lastError = "";
        if (this.client == null) { this.lastError = "没有客户端"; return null; }
        if (this.retriever == null) { this.lastError = "没有检索器"; return null; }
        if (question == null || question.Length == 0) {
            this.lastError = "问题为空";
            return null;
        }

        // 1) 查询向量（现算）。
        List<string> one = new List<string>();
        one.Add(question);
        AiEmbedding qemb = await Embeddings.Embed(this.client, one, true);
        if (qemb == null) {
            this.lastError = "查询向量化失败：" + this.client.lastError;
            return null;
        }

        // 2) 混合检索（协程版——远端后端只能这么走）。
        //
        // 召回条数：有重排就取宽（recallK），没重排就取 topK。
        int want = this.RecallK();
        List<RetrieverHit> hits = await this.retriever.SearchAsync(qemb.At(0),
        question, want);
        if (hits.Count == 0) {
            this.lastError = "没有检索到相关资料";
            return null;
        }

        // 3) 取回候选原文（重排要文本，引用也要）。
        List<string> texts = new List<string>();
        for (int i = 0; i < hits.Count; i = i + 1) {
            texts.Add(await this.retriever.TextOfAsync(hits[i].id));
        }

        // 4) 重排（可选）。
        //
        // **重排失败就降级继续**（用未重排的候选）——重排是**增强**不是
        // 必需，让它拖垮整个问答是本末倒置。失败原因记在
        // `rerankError` 里，调用方能看出这次没重排。
        this.rerankError = "";
        if (this.reranker != null && hits.Count > 1) {
            List<RerankHit> ranked = await this.reranker.Rerank(question, texts,
            0);
            if (ranked == null || ranked.Count == 0) {
                this.rerankError = "重排失败（已降级为不重排）："
                + this.reranker.LastError();
                // 降级：按**召回时的顺序**取前 topK 条。
                hits = Rag.Take(hits, this.topK);
                texts = Rag.TakeTexts(texts, this.topK);
            } else {
                List<RetrieverHit> reordered = Rag.ApplyRerank(hits, ranked,
                this.topK);
                // 文本跟着命中一起重排——**不能按位置取**（位置变了，
                // 文本和命中就对不上了，这是这类代码最常见的错位 bug）。
                List<string> reorderedTexts = new List<string>();
                for (int i = 0; i < reordered.Count; i = i + 1) {
                    reorderedTexts.Add(Rag.TextOfHit(texts, hits, reordered[i]));
                }
                hits = reordered;
                texts = reorderedTexts;
            }
        } else {
            // 没有重排器（或只有一条候选）→ 直接取前 topK。
            hits = Rag.Take(hits, this.topK);
            texts = Rag.TakeTexts(texts, this.topK);
        }

        // 5) 拼上下文。
        RagAnswer answer = new RagAnswer();
        answer.question = question;
        StringBuilder ctx = new StringBuilder();
        for (int i = 0; i < hits.Count; i = i + 1) {
            int id = hits[i].id;
            string text = texts[i];
            RagCitation cite = new RagCitation();
            cite.id = id;
            cite.text = text;
            cite.score = hits[i].score;
            cite.vectorRank = hits[i].vectorRank;
            cite.bm25Rank = hits[i].bm25Rank;
            answer.citations.Add(cite);
            if (i > 0) { ctx.Append("\n---\n"); }
            ctx.Append(text);
        }
        answer.context = ctx.ToString();

        // 6) 拼提示词 → 调补全。
        string prompt = this.template;
        prompt = Rag.ReplaceToken(prompt, "{{context}}", answer.context);
        prompt = Rag.ReplaceToken(prompt, "{{question}}", question);
        string reply = await this.client.Complete("", prompt);
        if (reply == null) {
            this.lastError = "生成失败：" + this.client.lastError;
            return null;
        }
        answer.text = reply;
        return answer;
    }

    // 取前 n 条。
    static List<RetrieverHit> Take(List<RetrieverHit> hits, int n) {
        if (n <= 0 || hits.Count <= n) { return hits; }
        List<RetrieverHit> outp = new List<RetrieverHit>();
        for (int i = 0; i < n; i = i + 1) { outp.Add(hits[i]); }
        return outp;
    }

    // 取前 n 条文本。
    static List<string> TakeTexts(List<string> texts, int n) {
        if (n <= 0 || texts.Count <= n) { return texts; }
        List<string> outp = new List<string>();
        for (int i = 0; i < n; i = i + 1) { outp.Add(texts[i]); }
        return outp;
    }

    // 按 id 在原候选里找对应的文本。
    //
    // 重排后顺序变了，文本要按**id**找回，不能按位置取——按位置取是
    // 这类代码最常见的错位 bug（顺序一变，文本和命中就对不上，而且
    // 不报错，只是答案里混进了别的块）。
    static string TextOfHit(List<string> texts, List<RetrieverHit> original,
    RetrieverHit hit) {
        for (int i = 0; i < original.Count; i = i + 1) {
            if (original[i] == hit) {
                if (i < texts.Count) { return texts[i]; }
                return "";
            }
        }
        return "";
    }

    // 把重排结果套回命中列表，并截到 topK。
    //
    // ranked 里的 `index` 是**原命中列表里的下标**——重排服务只看得到
    // 文本，看不到 id，所以映射靠下标。
    //
    // **重排后的分数不写进 `RetrieverHit.score`**：重排分数的量纲由
    // 服务决定（0~1 或无上界 logit），与 RRF 分数不同量纲，混在一起
    // 下游没法比。命中的 `score` 仍是 RRF 分数（表示"被召回时的强度"），
    // 重排的相对次序由**顺序**表达。
    static List<RetrieverHit> ApplyRerank(List<RetrieverHit> hits,
    List<RerankHit> ranked, int topK) {
        List<RetrieverHit> outp = new List<RetrieverHit>();
        for (int i = 0; i < ranked.Count; i = i + 1) {
            int at = ranked[i].index;
            if (at < 0 || at >= hits.Count) { continue; }
            outp.Add(hits[at]);
        }
        // 重排漏掉的候选（模型没给全部打分）**追加在后面**——丢掉它们
        // 等于扔掉召回阶段找到的东西。
        for (int i = 0; i < hits.Count; i = i + 1) {
            bool seen = false;
            for (int j = 0; j < outp.Count; j = j + 1) {
                if (outp[j] == hits[i]) { seen = true; break; }
            }
            if (!seen) { outp.Add(hits[i]); }
        }
        if (topK > 0 && outp.Count > topK) {
            List<RetrieverHit> trimmed = new List<RetrieverHit>();
            for (int i = 0; i < topK; i = i + 1) { trimmed.Add(outp[i]); }
            return trimmed;
        }
        return outp;
    }

    // 占位符替换（全部替换，不只第一个）。
    public static string ReplaceToken(string text, string token, string value) {
        if (text == null || token == null) { return ""; }
        StringBuilder sb = new StringBuilder();
        int at = 0;
        while (true) {
            int hit = text.IndexOf(token, at);
            if (hit < 0) { break; }
            sb.Append(text.Substring(at, hit - at));
            sb.Append(value == null ? "" : value);
            at = hit + token.Length;
        }
        sb.Append(text.Substring(at));
        return sb.ToString();
    }
}

// 一次问答的结果（答案 + 引用）。
public class RagAnswer {
    public string question;

    // 生成的答案。
    public string text;

    // 拼进提示词的上下文（命中块的拼接）。
    public string context;

    // 引用（命中的块 + 原文 + 分数）。
    public List<RagCitation> citations;

    public RagAnswer() {
        this.question = "";
        this.text = "";
        this.context = "";
        this.citations = new List<RagCitation>();
    }
}

// 一条引用（命中的块）。
public class RagCitation {
    public int id;
    public string text;

    // RRF 融合分数。
    public double score;

    // 两路的原始名次（0 = 该路没命中）。
    public int vectorRank;
    public int bm25Rank;
}
