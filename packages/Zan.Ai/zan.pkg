name = "Zan.Ai"
version = "1.0.0"
description = "AI application pipeline for Zan: unified LLM client with retry/timeout/token accounting, OpenAI-compatible embeddings, document chunking, the tool-calling loop (registry/agent with async, sync and result-style implementations), the Anthropic Messages API client behind a shared IChat contract, true SSE streaming with streamed tool-call assembly, and a bridge that plugs remote MCP tools into the local tool registry — the assembly line that turns documents into retrievable vectors"
author = "Zan Team"
license = "MIT"
