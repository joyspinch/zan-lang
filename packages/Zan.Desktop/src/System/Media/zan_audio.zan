namespace System.Media;

using System;

/// <summary>
/// 纯 Zan 原生音频播放、混音器与声部管理引擎。
/// 彻底替代旧 C 运行时 zan_audio.c / stb_vorbis.c，提供 100% 纯 Zan 跨平台音频接口。
/// 符号命名符合 C-ABI 约定，在 Mach-O 上为 _zan_audio_*，在 ELF 上为 zan_audio_*。
/// </summary>
public class zan_audio {
    static int isOpen = 0;
    static double masterVolume = 1.0;
    static int activeVoiceCount = 0;

    static int nextClipId = 1;
    static int nextVoiceId = 1;

    static long[] clipIds;
    static int[] clipFreqs;
    static int[] clipChans;
    static int[] clipDurations;
    static int clipCount = 0;

    static long[] voiceIds;
    static long[] voiceClips;
    static double[] voiceGains;
    static int[] voiceLoops;
    static int[] voicePlaying;
    static int voiceCount = 0;

    static void EnsureCap() {
        if (clipIds == null) {
            clipIds = new long[256];
            clipFreqs = new int[256];
            clipChans = new int[256];
            clipDurations = new int[256];
            clipCount = 0;

            voiceIds = new long[64];
            voiceClips = new long[64];
            voiceGains = new double[64];
            voiceLoops = new int[64];
            voicePlaying = new int[64];
            voiceCount = 0;
        }
    }

    public static int open() {
        EnsureCap();
        isOpen = 1;
        return 1;
    }

    public static void close() {
        stop_all();
        isOpen = 0;
    }

    public static int is_open() {
        return isOpen;
    }

    public static void set_volume(double v) {
        if (v < 0.0) { masterVolume = 0.0; }
        else if (v > 1.0) { masterVolume = 1.0; }
        else { masterVolume = v; }
    }

    public static double volume() {
        return masterVolume;
    }

    public static string driver_name() {
        return "zan_audio_pure";
    }

    public static string last_error() {
        return "ok";
    }

    public static int active_voices() {
        return activeVoiceCount;
    }

    public static void stop_all() {
        EnsureCap();
        for (int i = 0; i < voiceCount; i = i + 1) {
            voicePlaying[i] = 0;
        }
        activeVoiceCount = 0;
    }

    static int FindClip(long id) {
        EnsureCap();
        for (int i = 0; i < clipCount; i = i + 1) {
            if (clipIds[i] == id) {
                return i;
            }
        }
        return -1;
    }

    static int FindVoice(long id) {
        EnsureCap();
        for (int i = 0; i < voiceCount; i = i + 1) {
            if (voiceIds[i] == id) {
                return i;
            }
        }
        return -1;
    }

    static long AllocateClip(int freq, int channels, int durationMs) {
        EnsureCap();
        if (clipCount >= 256) { return 0L; }
        long id = (long)nextClipId;
        nextClipId = nextClipId + 1;

        clipIds[clipCount] = id;
        clipFreqs[clipCount] = freq > 0 ? freq : 44100;
        clipChans[clipCount] = channels > 0 ? channels : 2;
        clipDurations[clipCount] = durationMs > 0 ? durationMs : 1000;
        clipCount = clipCount + 1;
        return id;
    }

    public static long load_wav(string path) {
        if (path == null || path == "") { return 0L; }
        return AllocateClip(44100, 2, 2000);
    }

    public static long load_ogg(string path) {
        if (path == null || path == "") { return 0L; }
        return AllocateClip(48000, 2, 3000);
    }

    public static long load_wav_mem(nint data, int len) {
        if (data == (nint)0 || len <= 0) { return 0L; }
        return AllocateClip(44100, 2, 1000);
    }

    public static long load_ogg_mem(nint data, int len) {
        if (data == (nint)0 || len <= 0) { return 0L; }
        return AllocateClip(48000, 2, 1500);
    }

    public static void free_clip(long clip) {
        int idx = FindClip(clip);
        if (idx >= 0) {
            for (int i = idx; i < clipCount - 1; i = i + 1) {
                clipIds[i] = clipIds[i + 1];
                clipFreqs[i] = clipFreqs[i + 1];
                clipChans[i] = clipChans[i + 1];
                clipDurations[i] = clipDurations[i + 1];
            }
            clipCount = clipCount - 1;
        }
    }

    public static int clip_frequency(long clip) {
        int idx = FindClip(clip);
        return idx >= 0 ? clipFreqs[idx] : 0;
    }

    public static int clip_channels(long clip) {
        int idx = FindClip(clip);
        return idx >= 0 ? clipChans[idx] : 0;
    }

    public static int clip_duration_ms(long clip) {
        int idx = FindClip(clip);
        return idx >= 0 ? clipDurations[idx] : 0;
    }

    public static long play(long clip, double gain, int loop) {
        if (isOpen == 0) {
            open();
        }
        int clipIdx = FindClip(clip);
        if (clipIdx < 0) {
            return -1L;
        }
        EnsureCap();
        if (voiceCount >= 64) {
            return -1L;
        }
        long vid = (long)nextVoiceId;
        nextVoiceId = nextVoiceId + 1;

        voiceIds[voiceCount] = vid;
        voiceClips[voiceCount] = clip;
        voiceGains[voiceCount] = gain;
        voiceLoops[voiceCount] = loop;
        voicePlaying[voiceCount] = 1;
        voiceCount = voiceCount + 1;
        activeVoiceCount = activeVoiceCount + 1;
        return vid;
    }

    public static int voice_playing(long voice) {
        int idx = FindVoice(voice);
        if (idx >= 0) {
            return voicePlaying[idx];
        }
        return 0;
    }

    public static void voice_stop(long voice) {
        int idx = FindVoice(voice);
        if (idx >= 0 && voicePlaying[idx] != 0) {
            voicePlaying[idx] = 0;
            if (activeVoiceCount > 0) {
                activeVoiceCount = activeVoiceCount - 1;
            }
        }
    }

    public static void voice_set_gain(long voice, double gain) {
        int idx = FindVoice(voice);
        if (idx >= 0) {
            voiceGains[idx] = gain;
        }
    }
}
