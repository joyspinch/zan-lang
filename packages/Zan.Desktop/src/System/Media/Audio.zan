using System;

namespace System.Media;

// 原生音频设备：一次打开，之后所有声音都混到这一个设备上。
// 零依赖原生实现（WASAPI/ALSA/AudioQueue）。
// <see cref="AudioClip"/> 是解码好的采样（WAV/OGG），
// <see cref="AudioVoice"/> 是它的一次播放；同一个 clip 可以同时起多个
// voice（叠加音效），混音由运行时后台线程完成。
public class Audio {
    // 打开默认播放设备（已打开时直接返回 true）。
    public static bool Open() {
        return AudioNative.zan_audio_open() != 0;
    }

    // 播放设备已打开时为真。
    public static bool IsOpen() {
        return AudioNative.zan_audio_is_open() != 0;
    }

    // 主音量（0..1，可放大到 1 以上）。对已经在响的声音同样
    // 生效，所以静音/淡出立即听得到。
    public static void SetVolume(double volume) {
        AudioNative.zan_audio_set_volume(volume);
    }

    // 当前主音量（0..1）。
    public static double Volume() {
        return AudioNative.zan_audio_volume();
    }

    // 原生音频后端名（Windows: "wasapi", Android: "aaudio", Linux: "alsa",
    // macOS: "coreaudio", OpenHarmony: "ohaudio"；未打开或不支持返回空串）。
    public static string DriverName() {
        return AudioNative.zan_audio_driver_name();
    }

    // 还在响的声音数：一次性音效播完即回收，不用调用方登记。
    public static int ActiveVoices() {
        return AudioNative.zan_audio_active_voices();
    }

    // 立刻停掉所有声音（切场景/退出时用）。
    public static void StopAll() {
        AudioNative.zan_audio_stop_all();
    }

    // 关闭设备，并停掉设备上剩下的声音。
    public static void Close() {
        AudioNative.zan_audio_close();
    }

    // 最近一次失败的原因（设备打开失败/解码失败等）；
    // 没有失败记录时为空串。
    public static string LastError() {
        return AudioNative.zan_audio_last_error();
    }
}
