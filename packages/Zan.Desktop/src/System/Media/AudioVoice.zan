using System;

namespace System.Media;

// 一次播放（voice）。
// 句柄带世代号：声音播完后句柄失效，<see cref="IsPlaying"/> 老实返回
// false、<see cref="Stop"/> 什么也不做，因此一个存活时间比声音长的
// AudioVoice 变量是安全的，不会碰到被回收的槽位。
class AudioVoice {
    long handle;

    // 包装一个原生 voice 句柄；0 表示没起来的声音，此时对象
    // 依然可用（IsPlaying 为 false），调用方不需要判空。
    static AudioVoice Of(long handle) {
        AudioVoice voice = new AudioVoice();
        voice.handle = handle;
        return voice;
    }

    // 声音是否成功起播（设备没开、voice 池满时为 false）。
    bool IsValid() { return this.handle != 0; }

    // 声音仍在响时为真；播完或已 Stop 即 false（句柄按世代号失效）。
    bool IsPlaying() {
        return AudioNative.zan_audio_voice_playing(this.handle) != 0;
    }

    // 这一个声音的音量（会再乘上主音量）。
    void SetGain(double gain) {
        AudioNative.zan_audio_voice_set_gain(this.handle, gain);
    }

    // 停掉这一个声音并使句柄失效；对已失效句柄无操作。
    void Stop() {
        AudioNative.zan_audio_voice_stop(this.handle);
        this.handle = 0;
    }
}
