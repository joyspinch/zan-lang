using System;

namespace System.Media;

// 流式 PCM 音频输出通道（16-bit signed interleaved PCM），内置环形缓冲、
// 实时重采样、倍速播放与精确播放时钟（用于视频播放器音画同步主时钟）。
public class AudioStream : IDisposable {
    private long handle;
    public int SampleRate;
    public int Channels;

    private AudioStream(long handle, int sampleRate, int channels) {
        this.handle = handle;
        this.SampleRate = sampleRate;
        this.Channels = channels;
    }

    public bool IsValid {
        get { return this.handle != 0; }
    }

    public static AudioStream Create(int sampleRate, int channels, int bufferMs) {
        long h = AudioNative.zan_audio_stream_create(sampleRate, channels, bufferMs);
        return h == 0 ? null : new AudioStream(h, sampleRate, channels);
    }

    // 写入交错 s16 PCM 帧（来自原生指针），返回实际写入帧数（缓冲满时不阻塞）。
    public int Write(nint pcmPtr, int frames) {
        if (this.handle == 0 || pcmPtr == 0 || frames <= 0) return 0;
        return AudioNative.zan_audio_stream_write(this.handle, pcmPtr, frames);
    }

    // 写入交错 s16 PCM 字节数组，返回实际写入帧数。
    public int WriteBytes(byte[] pcmBytes, int byteCount) {
        if (this.handle == 0 || pcmBytes == null || byteCount <= 0 || this.Channels <= 0) return 0;
        if (byteCount > pcmBytes.Length) byteCount = pcmBytes.Length;
        int frameBytes = this.Channels * 2;
        int frames = byteCount / frameBytes;
        if (frames <= 0) return 0;
        return AudioNative.zan_audio_stream_write(this.handle, (nint)pcmBytes, frames);
    }

    public void Pause() {
        if (this.handle != 0) AudioNative.zan_audio_stream_pause(this.handle, 1);
    }

    public void Resume() {
        if (this.handle != 0) AudioNative.zan_audio_stream_pause(this.handle, 0);
    }

    // 清空缓冲并归零已播时钟（Seek 跳转时调用）。
    public void Flush() {
        if (this.handle != 0) AudioNative.zan_audio_stream_flush(this.handle);
    }

    public void SetGain(double gain) {
        if (this.handle != 0) AudioNative.zan_audio_stream_set_gain(this.handle, gain);
    }

    public void SetSpeed(double speed) {
        if (this.handle != 0) AudioNative.zan_audio_stream_set_speed(this.handle, speed);
    }

    public int BufferedMs {
        get { return this.handle == 0 ? 0 : AudioNative.zan_audio_stream_buffered_ms(this.handle); }
    }

    public long PlayedMs {
        get { return this.handle == 0 ? 0 : AudioNative.zan_audio_stream_played_ms(this.handle); }
    }

    public int FreeFrames {
        get { return this.handle == 0 ? 0 : AudioNative.zan_audio_stream_free_frames(this.handle); }
    }

    public void Dispose() {
        if (this.handle != 0) {
            AudioNative.zan_audio_stream_destroy(this.handle);
            this.handle = 0;
        }
    }
}
