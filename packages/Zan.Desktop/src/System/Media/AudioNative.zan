using System;

namespace System.Media;

// 独立 zan_audio 原生驱动桥。
public class AudioNative {
    [DllImport("zan_audio")]
    public static extern int zan_audio_open();

    [DllImport("zan_audio")]
    public static extern void zan_audio_close();

    [DllImport("zan_audio")]
    public static extern int zan_audio_is_open();

    [DllImport("zan_audio")]
    public static extern void zan_audio_set_volume(double volume);

    [DllImport("zan_audio")]
    public static extern double zan_audio_volume();

    [DllImport("zan_audio")]
    public static extern string zan_audio_driver_name();

    [DllImport("zan_audio")]
    public static extern int zan_audio_active_voices();

    [DllImport("zan_audio")]
    public static extern void zan_audio_stop_all();

    [DllImport("zan_audio")]
    public static extern string zan_audio_last_error();

    [DllImport("zan_audio")]
    public static extern nint zan_audio_load_wav(string path);

    [DllImport("zan_audio")]
    public static extern nint zan_audio_load_ogg(string path);

    [DllImport("zan_audio")]
    public static extern nint zan_audio_load_wav_mem(string data, int len);

    [DllImport("zan_audio")]
    public static extern nint zan_audio_load_ogg_mem(string data, int len);

    [DllImport("zan_audio")]
    public static extern void zan_audio_free_clip(nint clip);

    [DllImport("zan_audio")]
    public static extern int zan_audio_clip_frequency(nint clip);

    [DllImport("zan_audio")]
    public static extern int zan_audio_clip_channels(nint clip);

    [DllImport("zan_audio")]
    public static extern int zan_audio_clip_duration_ms(nint clip);

    [DllImport("zan_audio")]
    public static extern long zan_audio_play(nint clip, double gain, int loop);

    [DllImport("zan_audio")]
    public static extern int zan_audio_voice_playing(long voice);

    [DllImport("zan_audio")]
    public static extern void zan_audio_voice_stop(long voice);

    [DllImport("zan_audio")]
    public static extern void zan_audio_voice_set_gain(long voice, double gain);
}
