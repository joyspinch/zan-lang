using System;

namespace System.Media;

// 加载到内存的采样（s16 PCM）；每次 Play 返回独立的 AudioVoice，支持同 clip 叠加播放。
public class AudioClip : IDisposable {
    public nint handle;

    private static AudioClip FromHandle(nint h) {
        AudioClip clip = new AudioClip();
        clip.handle = h;
        return clip;
    }

    // 加载 WAV 文件（PCM 8/16/24/32 位与 32 位浮点，含 WAVE_FORMAT_EXTENSIBLE）；
    // 失败时 IsValid() 为 false（原因见 Audio.LastError()），不返回 null。
    public static AudioClip LoadWav(string path) {
        if (path == null || path.Length == 0) { return AudioClip.FromHandle(0); }
        return AudioClip.FromHandle(AudioNative.zan_audio_load_wav(path));
    }

    // 加载 OGG Vorbis 文件（背景音乐）；失败时 IsValid() 为 false，不返回 null。
    public static AudioClip LoadOgg(string path) {
        if (path == null || path.Length == 0) { return AudioClip.FromHandle(0); }
        return AudioClip.FromHandle(AudioNative.zan_audio_load_ogg(path));
    }

    // 从内存字节同步解析 WAV（解码后不保留外部缓冲引用）；失败时 IsValid() 为 false。
    public static AudioClip LoadWavFromMem(string data, int len) {
        if (data == null || len <= 0) { return AudioClip.FromHandle(0); }
        if (len > data.Length) { len = data.Length; }
        return AudioClip.FromHandle(AudioNative.zan_audio_load_wav_mem(data, len));
    }

    // 从内存字节同步解码 OGG Vorbis；失败时 IsValid() 为 false。
    public static AudioClip LoadOggFromMem(string data, int len) {
        if (data == null || len <= 0) { return AudioClip.FromHandle(0); }
        if (len > data.Length) { len = data.Length; }
        return AudioClip.FromHandle(AudioNative.zan_audio_load_ogg_mem(data, len));
    }

    // 加载成功时为真（失败时为假对象，不返回 null）。
    public bool IsValid() { return this.handle != 0; }

    // 采样率（Hz）。
    public int Frequency() { return this.handle == 0 ? 0 : AudioNative.zan_audio_clip_frequency(this.handle); }

    // 声道数（1 单声道、2 立体声）。
    public int Channels() { return this.handle == 0 ? 0 : AudioNative.zan_audio_clip_channels(this.handle); }

    // 时长（毫秒）。
    public int DurationMs() { return this.handle == 0 ? 0 : AudioNative.zan_audio_clip_duration_ms(this.handle); }

    // 用默认音量播一次。
    public AudioVoice Play() {
        return this.Play(1.0, 0);
    }

    // 播放一次（gain 为音量，loop 非 0 表示循环播放）。
    public AudioVoice Play(double gain, int loop) {
        if (this.handle == 0) { return AudioVoice.Of(0); }
        if (!(gain >= 0.0 && gain <= 1.0e308)) { gain = 0.0; }
        return AudioVoice.Of(AudioNative.zan_audio_play(this.handle, gain, loop));
    }

    // 循环播放，直到 AudioVoice.Stop。
    public AudioVoice PlayLooping(double gain) {
        return this.Play(gain, 1);
    }

    // 释放采样，并停掉还在读它的声音。
    public void Close() {
        if (this.handle != 0) {
            AudioNative.zan_audio_free_clip(this.handle);
            this.handle = 0;
        }
    }

    // 释放采样资源（实现 IDisposable，等同于 Close）。
    public void Dispose() {
        this.Close();
    }
}
