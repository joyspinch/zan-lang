using System;

namespace System.Media;

// 加载到内存的采样（s16 PCM）。<see cref="Play"/> 每次返回
// 一个新的 <see cref="AudioVoice"/>，所以同一个 clip 可以叠着响。
public class AudioClip : IDisposable {
    public nint handle;

    // 加载 WAV 文件（PCM 8/16/24/32 位与 32 位浮点，含
    // WAVE_FORMAT_EXTENSIBLE）。失败时返回的对象 IsValid() 为 false
    // （原因见 <c>Audio.LastError()</c>），不返回 null。
    public static AudioClip LoadWav(string path) {
        AudioClip clip = new AudioClip();
        clip.handle = AudioNative.zan_audio_load_wav(path);
        return clip;
    }

    // 加载 OGG Vorbis 文件（背景音乐）。失败时返回的对象
    // IsValid() 为 false，不返回 null。
    public static AudioClip LoadOgg(string path) {
        AudioClip clip = new AudioClip();
        clip.handle = AudioNative.zan_audio_load_ogg(path);
        return clip;
    }

    // 从内存字节解析 WAV。<paramref name="data"/> 是完整的
    // WAV 文件字节（如从加密资源包解密出来的内容），全程不落盘。
    // 字节只在本次调用内同步读取（PCM 会被拷出），返回后即可释放
    // 缓冲区，不转移所有权。失败时返回的对象 IsValid() 为 false
    // （原因见 <c>Audio.LastError()</c>），不返回 null。
    public static AudioClip LoadWavFromMem(string data, int len) {
        AudioClip clip = new AudioClip();
        clip.handle = AudioNative.zan_audio_load_wav_mem(data, len);
        return clip;
    }

    // 从内存字节解码 OGG Vorbis（背景音乐）。字节只在本次
    // 调用内同步读取（PCM 会被拷出），返回后即可释放缓冲区。
    // 失败时返回的对象 IsValid() 为 false。
    public static AudioClip LoadOggFromMem(string data, int len) {
        AudioClip clip = new AudioClip();
        clip.handle = AudioNative.zan_audio_load_ogg_mem(data, len);
        return clip;
    }

    // 加载成功时为真（失败时为假对象，不返回 null）。
    public bool IsValid() { return this.handle != 0; }

    // 采样率（Hz）。
    public int Frequency() { return AudioNative.zan_audio_clip_frequency(this.handle); }

    // 声道数（1 单声道、2 立体声）。
    public int Channels() { return AudioNative.zan_audio_clip_channels(this.handle); }

    // 时长（毫秒）。
    public int DurationMs() { return AudioNative.zan_audio_clip_duration_ms(this.handle); }

    // 用默认音量播一次。
    public AudioVoice Play() {
        return this.Play(1.0, 0);
    }

    // 播一次。<paramref name="gain"/> 是这一个声音的音量，
    // <paramref name="loop"/> 非 0 表示循环（背景音乐）。
    public AudioVoice Play(double gain, int loop) {
        return AudioVoice.Of(AudioNative.zan_audio_play(this.handle, gain, loop));
    }

    // 循环播放，直到 <see cref="AudioVoice.Stop"/>。
    public AudioVoice PlayLooping(double gain) {
        return this.Play(gain, 1);
    }

    // 释放采样，并停掉还在读它的声音。
    public void Close() {
        if (this.handle != 0) {
            AudioNative.zan_audio_free_clip(this.handle);
            this.handle = 0;
        }
    }

    // 释放采样资源（实现 IDisposable，等同于 Close）。
    public void Dispose() {
        this.Close();
    }
}
