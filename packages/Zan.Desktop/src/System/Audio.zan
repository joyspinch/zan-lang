using System;
using System.Media;

namespace System;

/// <summary>原生音频设备（向后兼容入口，建议优先使用 <see cref="System.Media.Audio"/>）。</summary>
class Audio {
    /// 打开默认播放设备。
    static bool Open() { return System.Media.Audio.Open(); }
    /// 播放设备已打开时为真。
    static bool IsOpen() { return System.Media.Audio.IsOpen(); }
    /// 设置主音量。
    static void SetVolume(double volume) { System.Media.Audio.SetVolume(volume); }
    /// 当前主音量。
    static double Volume() { return System.Media.Audio.Volume(); }
    /// 原生音频后端名。
    static string DriverName() { return System.Media.Audio.DriverName(); }
    /// 还在响的声音数。
    static int ActiveVoices() { return System.Media.Audio.ActiveVoices(); }
    /// 立刻停掉所有声音。
    static void StopAll() { System.Media.Audio.StopAll(); }
    /// 关闭设备。
    static void Close() { System.Media.Audio.Close(); }
    /// 最近一次失败原因。
    static string LastError() { return System.Media.Audio.LastError(); }
}
