using System;

namespace System.Management;

/// <summary>
/// 物理/虚拟内存快照，所有大小均以字节为单位。Linux 的值
/// 来自 /proc/meminfo；Windows 来自 GlobalMemoryStatusEx。
/// </summary>
class MemoryStatus {
    /// 物理内存总量（字节）。
    public long totalPhys;
    /// 可用物理内存（字节）。
    public long availPhys;
    /// 提交上限（物理 + 页面文件）（字节）。
    public long totalPageFile;
    /// 当前可提交量（字节）。
    public long availPageFile;
    /// 本进程可用虚拟地址空间总量的系统视图（字节；Linux 为物理+交换的估算）。
    public long totalVirtual;
    /// 剩余虚拟内存（字节）。
    public long availVirtual;
    /// 物理内存使用率（0..100）。
    public int usagePercent;

    /// 系统物理内存不足时为 True。
    public bool IsLow() {
        if (totalPhys <= 0) { return false; }
        return usagePercent >= 90;
    }
}

/// <summary>
/// 内存统计。跨平台：Windows 使用 GlobalMemoryStatusEx，
/// Linux 解析 /proc/meminfo；macOS 读 sysctl（hw.memsize、
/// vm.stats.vm.v_* 页计数、kern.swapusage）。Linux 在 /proc/meminfo
/// 读不到时抛 PlatformNotSupportedException；macOS 读取失败时各字段
/// 保持 0（sysctl 不应失败，失败即系统异常）。
/// </summary>
class Memory {
    /// <summary>当前内存快照。</summary>
    static MemoryStatus GetStatus() {
        #if WINDOWS
        return Memory.WinStatus();
        #elif LINUX
        return Memory.LinuxStatus();
        #elif MACOS
        return Memory.MacStatus();
        #else
        throw new PlatformNotSupportedException(
            "Memory.GetStatus is not implemented on this platform");
        #endif
    }

    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GlobalMemoryStatusEx")]
    static extern int GlobalMemoryStatusEx(nint buf);

    /// Windows 实现：GlobalMemoryStatusEx；调用失败时各字段保持 0。
    static MemoryStatus WinStatus() {
        // MEMORYSTATUSEX (x64): dwLength(4) dwMemoryLoad(4) ullTotalPhys(8)
        // ullAvailPhys(8) ullTotalPageFile(8) ullAvailPageFile(8)
        // ullTotalVirtual(8) ullAvailVirtual(8) ullAvailExtendedVirtual(8).
        nint buf = NativeMemory.Alloc(64);
        new Span<int>(buf, 2)[0] = 64;   // dwLength
        Memory.GlobalMemoryStatusEx(buf);
        Span<long> q = new Span<long>(buf + 8, 7);
        MemoryStatus s = new MemoryStatus();
        s.totalPhys = q[0];
        s.availPhys = q[1];
        s.totalPageFile = q[2];
        s.availPageFile = q[3];
        s.totalVirtual = q[4];
        s.availVirtual = q[5];
        s.usagePercent = new Span<int>(buf + 4, 1)[0];
        NativeMemory.Free(buf);
        return s;
    }
    #endif

    #if MACOS
    [DllImport("crt", EntryPoint = "sysctlbyname")]
    static extern int SysctlByName(string name, nint oldp, nint oldlenp,
                                    nint newp, int newlen);

    /// macOS 实现：hw.memsize（物理总量）、vm.stats.vm.v_free_count +
    /// v_inactive_count 页（可用估算，与活动监视器口径一致）、
    /// kern.swapusage（交换容量）。totalVirtual/availVirtual 为
    /// 物理 + 交换的估算值（macOS 无直接对应）；sysctl 失败时各字段
    /// 保持 0。
    static MemoryStatus MacStatus() {
        MemoryStatus s = new MemoryStatus();
        s.totalPhys = Memory.SysctlU64("hw.memsize");
        int pageSize = Memory.SysctlI32("vm.pagesize");
        int freePages = Memory.SysctlI32("vm.stats.vm.v_free_count");
        int inactivePages = Memory.SysctlI32("vm.stats.vm.v_inactive_count");
        long availPages = freePages + inactivePages;
        s.availPhys = availPages * pageSize;
        string swap = Memory.SysctlString("kern.swapusage");
        s.totalPageFile = Memory.SwapField(swap, "total");
        s.availPageFile = Memory.SwapField(swap, "free");
        s.totalVirtual = s.totalPhys + s.totalPageFile;
        s.availVirtual = s.availPhys + s.availPageFile;
        if (s.totalPhys > 0) {
            long used = s.totalPhys - s.availPhys;
            s.usagePercent = (int)(used * 100 / s.totalPhys);
        }
        return s;
    }

    /// 读取 sysctl 字符串值；键不存在返回 ""。
    static string SysctlString(string name) {
        nint buf = NativeMemory.Alloc(256);
        nint len = NativeMemory.Alloc(8);
        new Span<long>(len, 1)[0] = 256;
        string s = "";
        if (Memory.SysctlByName(name, buf, len, 0, 0) == 0) {
            int n = 0;
            while (n < 256 && new Span<byte>(buf + n, 1)[0] != 0) {
                n = n + 1;
            }
            if (n > 0) { s = NativeMemory.GetString(buf, 0, n); }
        }
        NativeMemory.Free(buf);
        NativeMemory.Free(len);
        return s;
    }

    /// 读取 sysctl 的 32 位整数值；键不存在或长度不符返回 0。
    static int SysctlI32(string name) {
        nint buf = NativeMemory.Alloc(4);
        nint len = NativeMemory.Alloc(8);
        new Span<long>(len, 1)[0] = 4;
        int v = 0;
        if (Memory.SysctlByName(name, buf, len, 0, 0) == 0
            && new Span<long>(len, 1)[0] == 4) {
            v = new Span<int>(buf, 1)[0];
        }
        NativeMemory.Free(buf);
        NativeMemory.Free(len);
        return v;
    }

    /// 读取 sysctl 的 64 位整数值；键不存在或长度不符返回 0。
    static long SysctlU64(string name) {
        nint buf = NativeMemory.Alloc(8);
        nint len = NativeMemory.Alloc(8);
        new Span<long>(len, 1)[0] = 8;
        long v = 0;
        if (Memory.SysctlByName(name, buf, len, 0, 0) == 0
            && new Span<long>(len, 1)[0] == 8) {
            v = new Span<long>(buf, 1)[0];
        }
        NativeMemory.Free(buf);
        NativeMemory.Free(len);
        return v;
    }

    /// 从 kern.swapusage 文本（"total = 4096M  used = 128M  free = 3968M"）
    /// 取 `key` 的字节数；解析不了返回 0。单位 B/K/M/G/T（不区分大小写）。
    static long SwapField(string txt, string key) {
        if (txt == null) { return 0; }
        int i = Memory.IndexOf(txt, key + " = ", 0);
        if (i < 0) { return 0; }
        i = i + key.Length + 3;
        long v = 0;
        bool any = false;
        while (i < txt.Length && (txt[i] & 255) >= 48
               && (txt[i] & 255) <= 57) {
            v = v * 10 + ((txt[i] & 255) - 48);
            any = true;
            i = i + 1;
        }
        if (!any) { return 0; }
        if (i >= txt.Length) { return v; }
        int unit = (txt[i] & 255) | 32;   // 小写化
        if (unit == 107) { v = v * 1024; }             // k
        else if (unit == 109) { v = v * 1048576; }     // m
        else if (unit == 103) { v = v * 1073741824; }  // g
        else if (unit == 116) { v = v * 1099511627776; }  // t
        return v;
    }

    /// 从 `from` 起查找 `needle` 的首次出现，找不到返回 -1。
    static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }
    #endif

    #if LINUX
    /// Linux 实现：解析 /proc/meminfo；/proc/meminfo 读不到时抛
    /// PlatformNotSupportedException。totalVirtual/availVirtual 为
    /// 物理 + 交换的估算值（Linux 无直接对应）。
    static MemoryStatus LinuxStatus() {
        MemoryStatus s = new MemoryStatus();
        string txt = "";
        try {
            txt = File.ReadAllText("/proc/meminfo");
        } catch {
            throw new PlatformNotSupportedException(
                "cannot read /proc/meminfo");
        }
        s.totalPhys = Memory.KbField(txt, "MemTotal") * 1024;
        long avail = Memory.KbField(txt, "MemAvailable");
        if (avail == 0) {
            // 旧内核：MemFree + Buffers + Cached。
            avail = Memory.KbField(txt, "MemFree")
                  + Memory.KbField(txt, "Buffers")
                  + Memory.KbField(txt, "Cached");
        }
        s.availPhys = avail * 1024;
        s.totalPageFile = (Memory.KbField(txt, "SwapTotal") + 0) * 1024;
        s.availPageFile = Memory.KbField(txt, "SwapFree") * 1024;
        s.totalVirtual = s.totalPhys + s.totalPageFile;
        s.availVirtual = s.availPhys + s.availPageFile;
        if (s.totalPhys > 0) {
            long used = s.totalPhys - s.availPhys;
            s.usagePercent = (int)(used * 100 / s.totalPhys);
        }
        return s;
    }

    /// 从 /proc/meminfo 文本中取第一个 `key` 的 kB 值，缺失时为 0。
    static long KbField(string txt, string key) {
        int i = 0;
        while (i < txt.Length) {
            int eol = Memory.IndexOf(txt, "\n", i);
            if (eol < 0) { eol = txt.Length; }
            string line = txt.Substring(i, eol - i);
            if (line.StartsWith(key + ":")) {
                string rest = line.Substring(key.Length + 1, line.Length - key.Length - 1).Trim();
                // 剩余部分形如 "16384000 kB"——取第一个 token。
                int sp = Memory.IndexOf(rest, " ", 0);
                if (sp < 0) { return 0; }
                string num = rest.Substring(0, sp).Trim();
                return Memory.ParseLong(num);
            }
            i = eol + 1;
        }
        return 0;
    }

    /// 从 `from` 起查找 `needle` 的首次出现，找不到返回 -1。
    static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }

    /// 十进制解析为 long；空串或含非数字返回 0（注意与其他文件解析器的 -1 约定不同）。
    static long ParseLong(string s) {
        if (s == null || s.Length == 0) { return 0; }
        long v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 0x30 || c > 0x39) { return 0; }
            v = v * 10 + (c - 0x30);
        }
        return v;
    }

    /// 取 `ch` 编码后首字节的值（用于判断 ASCII 数字）。
    static int CodeOf(string ch) {
        if (ch == null || ch.Length == 0) { return 0; }
        return ch[0] & 255;
    }
    #endif
}
