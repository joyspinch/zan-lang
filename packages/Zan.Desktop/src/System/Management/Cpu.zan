using System;

namespace System.Management;

/// <summary>
/// CPU 标识与负载。Windows 从注册表读取品牌/频率
/// （即 Windows 缓存在
/// HKLM\HARDWARE\DESCRIPTION\System\CentralProcessor 下的 CPUID 值），核心数来自
/// GetSystemInfo，负载来自 GetSystemTimes。Linux 读取
/// /proc/cpuinfo 和 /proc/stat；macOS 读 sysctl（hw.ncpu、
/// machdep.cpu.brand_string、kern.cp_time；Apple Silicon 没有
/// machdep.cpu.vendor / hw.cpufrequency 键，Vendor/FrequencyMHz 返回空/0）。
/// 所有读取失败均返回空/0，不抛异常。
/// </summary>
class Cpu {
    // 采样间隔用的裸睡眠：不走 System.Threading——using System.Threading
    // 会把 Threading.zan 拉进闭包，其 zan_thread_* extern 声明一被发射就
    // 钉死 rt_sync 运行时对象（A56 税）。
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "Sleep")]
    static extern void SleepW(int ms);
    #elif LINUX || MACOS
    [DllImport("crt", EntryPoint = "usleep")]
    static extern int Usleep(int us);
    #endif

    /// <summary>CPU 品牌字符串，如 "Intel(R) Core(TM) i7-10750H CPU @
    /// 2.60GHz"。读取失败时为空。</summary>
    static string Brand() {
        #if WINDOWS
        return Cpu.RegString(
            0x80000002 /* HKLM */,
            "HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0",
            "ProcessorNameString");
        #elif LINUX
        return Cpu.ProcField("/proc/cpuinfo", "model name");
        #elif MACOS
        return Cpu.SysctlString("machdep.cpu.brand_string");
        #else
        return "";
        #endif
    }

    /// <summary>CPU 厂商，如 "GenuineIntel" / "AuthenticAMD"。无法读取时
    /// 为空。</summary>
    static string Vendor() {
        #if WINDOWS
        return Cpu.RegString(
            0x80000002 /* HKLM */,
            "HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0",
            "VendorIdentifier");
        #elif LINUX
        return Cpu.ProcField("/proc/cpuinfo", "vendor_id");
        #elif MACOS
        // Apple Silicon 没有这个键，返回 ""。
        return Cpu.SysctlString("machdep.cpu.vendor");
        #else
        return "";
        #endif
    }

    /// <summary>标称时钟频率（MHz），未知时为 0。</summary>
    static int FrequencyMHz() {
        #if WINDOWS
        return Cpu.RegDword(
            0x80000002 /* HKLM */,
            "HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0",
            "~MHz");
        #elif LINUX
        string mhz = Cpu.ProcField("/proc/cpuinfo", "cpu MHz");
        int v = Cpu.ParseInt(mhz);
        if (v < 0) { return 0; }   // 与文档一致：未知时为 0 而非 -1
        return v;
        #elif MACOS
        // hw.cpufrequency 单位 Hz（Intel；Apple Silicon 无此键返回 0）。
        return (int)(Cpu.SysctlInt64("hw.cpufrequency") / 1000000);
        #else
        return 0;
        #endif
    }

    /// <summary>操作系统可见的逻辑处理器数量。</summary>
    static int LogicalCores() {
        #if WINDOWS
        nint info = NativeMemory.Alloc(64);
        int n = 1;
        try {
            Cpu.WinGetSystemInfo(info);
            // 核心契约与语义定义。
            // 核心契约与语义定义。
            // level(2) revision(2).
            Span<int> w = new Span<int>(info, 16);
            n = w[8];
        } finally {
            NativeMemory.Free(info);
        }
        return n;
        #elif LINUX
        return Cpu.CountCpuLines();
        #elif MACOS
        return Cpu.SysctlInt32("hw.ncpu");
        #else
        return 1;
        #endif
    }

    /// <summary>约 300 ms 采样窗口内的总体 CPU 使用率（0..100）；
    /// 首次调用会采样两次并休眠。</summary>
    static int Usage() {
        #if WINDOWS
        nint t1 = NativeMemory.Alloc(24);
        nint t2 = NativeMemory.Alloc(24);
        long idle = 0;
        long busy = 0;
        try {
            // FILETIME 为两个 DWORD（8 字节），三项输出分别写入独立地址。
            if (Cpu.WinGetSystemTimes(t1, t1 + 8, t1 + 16) == 0) { return 0; }
            SleepW(300);
            if (Cpu.WinGetSystemTimes(t2, t2 + 8, t2 + 16) == 0) { return 0; }
            Span<long> a = new Span<long>(t1, 3);
            Span<long> b = new Span<long>(t2, 3);
            idle = b[0] - a[0];
            busy = (b[1] + b[2]) - (a[1] + a[2]);
        } finally {
            NativeMemory.Free(t1);
            NativeMemory.Free(t2);
        }
        if (busy <= 0) { return 0; }
        long pct = (busy - idle) * 100 / busy;
        if (pct < 0) { return 0; }
        if (pct > 100) { return 100; }
        return (int)pct;
        #elif LINUX
        // 系统底层交互与数据流转契约
        // steal。Busy = total - idle - iowait；间隔 300 ms 采样两次。
        long[] a = Cpu.CpuJiffies();
        Usleep(300000);
        long[] b = Cpu.CpuJiffies();
        long busy = (b[0] - a[0]) - (b[1] - a[1]);
        long total = b[0] - a[0];
        if (total <= 0) { return 0; }
        long pct = busy * 100 / total;
        if (pct < 0) { return 0; }
        if (pct > 100) { return 100; }
        return (int)pct;
        #elif MACOS
        // 系统底层交互与数据流转契约
        // Busy = total - idle；间隔 300 ms 采样两次。
        long[] a = Cpu.CpTime();
        Usleep(300000);
        long[] b = Cpu.CpTime();
        long total = 0;
        for (int i = 0; i < 5; i = i + 1) { total = total + b[i] - a[i]; }
        long idle = b[3] - a[3];   // CPU_STATE_IDLE
        long busy = total - idle;
        if (total <= 0) { return 0; }
        long pct = busy * 100 / total;
        if (pct < 0) { return 0; }
        if (pct > 100) { return 100; }
        return (int)pct;
        #else
        return 0;
        #endif
    }

    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetSystemInfo")]
    static extern void WinGetSystemInfo(nint info);

    [DllImport("kernel32", EntryPoint = "GetSystemTimes")]
    static extern int WinGetSystemTimes(nint idleTime, nint kernelTime, nint userTime);

    [DllImport("advapi32", EntryPoint = "RegOpenKeyExW")]
    static extern int RegOpenKeyExW(nint hKey, nint subKey, int options,
                                    int access, nint result);

    [DllImport("advapi32", EntryPoint = "RegQueryValueExW")]
    static extern int RegQueryValueExW(nint hKey, nint name, nint reserved,
                                       nint type, nint data, nint dataSize);

    [DllImport("advapi32", EntryPoint = "RegCloseKey")]
    static extern int RegCloseKey(nint hKey);

    /// 读取 HKLM\<subKey> 下的 REG_SZ 值，缺失时返回 ""。
    static string RegString(nint root, string subKey, string name) {
        nint wkey = Wide.Of(subKey);
        nint hk = NativeMemory.Alloc(8);
        nint hKey = 0;
        int r = -1;
        try {
            r = Cpu.RegOpenKeyExW(root, wkey, 0, 0x20019 /* KEY_READ */, hk);
            if (r == 0) { hKey = new Span<nint>(hk, 1)[0]; }
        } finally {
            Wide.Free(wkey);
            NativeMemory.Free(hk);
        }
        if (r != 0 || hKey == 0) { return ""; }

        nint wname = Wide.Of(name);
        nint buf = NativeMemory.Alloc(1024);
        nint size = NativeMemory.Alloc(4);
        string s = "";
        try {
            new Span<int>(size, 1)[0] = 512;
            r = Cpu.RegQueryValueExW(hKey, wname, 0, 0, buf, size);
            if (r == 0) {
                int bytes = new Span<int>(size, 1)[0];
                if (bytes > 2) { s = Wide.Read(buf); }
            }
        } finally {
            NativeMemory.Free(buf);
            NativeMemory.Free(size);
            Wide.Free(wname);
            Cpu.RegCloseKey(hKey);
        }
        return s;
    }

    /// 读取 HKLM\<subKey> 下的 REG_DWORD 值，缺失时返回 0。
    static int RegDword(nint root, string subKey, string name) {
        nint wkey = Wide.Of(subKey);
        nint hk = NativeMemory.Alloc(8);
        nint hKey = 0;
        int r = -1;
        try {
            r = Cpu.RegOpenKeyExW(root, wkey, 0, 0x20019 /* KEY_READ */, hk);
            if (r == 0) { hKey = new Span<nint>(hk, 1)[0]; }
        } finally {
            Wide.Free(wkey);
            NativeMemory.Free(hk);
        }
        if (r != 0 || hKey == 0) { return 0; }

        nint wname = Wide.Of(name);
        nint data = NativeMemory.Alloc(4);
        nint size = NativeMemory.Alloc(4);
        int v = 0;
        try {
            new Span<int>(size, 1)[0] = 4;
            r = Cpu.RegQueryValueExW(hKey, wname, 0, 0, data, size);
            if (r == 0) { v = new Span<int>(data, 1)[0]; }
        } finally {
            NativeMemory.Free(data);
            NativeMemory.Free(size);
            Wide.Free(wname);
            Cpu.RegCloseKey(hKey);
        }
        return v;
    }
    #endif

    #if MACOS
    [DllImport("crt", EntryPoint = "sysctlbyname")]
    static extern int SysctlByName(string name, nint oldp, nint oldlenp,
                                    nint newp, int newlen);

    /// 读取 sysctl 字符串值（UTF-8 C 串）；键不存在返回 ""。
    static string SysctlString(string name) {
        nint buf = NativeMemory.Alloc(256);
        nint len = NativeMemory.Alloc(8);
        string s = "";
        try {
            new Span<long>(len, 1)[0] = 256;
            if (Cpu.SysctlByName(name, buf, len, 0, 0) == 0) {
                int n = 0;
                while (n < 256 && new Span<byte>(buf + n, 1)[0] != 0) {
                    n = n + 1;
                }
                if (n > 0) { s = NativeMemory.GetString(buf, 0, n); }
            }
        } finally {
            NativeMemory.Free(buf);
            NativeMemory.Free(len);
        }
        return s;
    }

    /// 读取 sysctl 的 32 位整数值；键不存在或长度不符返回 0。
    static int SysctlInt32(string name) {
        nint buf = NativeMemory.Alloc(4);
        nint len = NativeMemory.Alloc(8);
        int v = 0;
        try {
            new Span<long>(len, 1)[0] = 4;
            if (Cpu.SysctlByName(name, buf, len, 0, 0) == 0
                && new Span<long>(len, 1)[0] == 4) {
                v = new Span<int>(buf, 1)[0];
            }
        } finally {
            NativeMemory.Free(buf);
            NativeMemory.Free(len);
        }
        return v;
    }

    /// 读取 sysctl 的 64 位整数值；键不存在或长度不符返回 0。
    static long SysctlInt64(string name) {
        nint buf = NativeMemory.Alloc(8);
        nint len = NativeMemory.Alloc(8);
        long v = 0;
        try {
            new Span<long>(len, 1)[0] = 8;
            if (Cpu.SysctlByName(name, buf, len, 0, 0) == 0
                && new Span<long>(len, 1)[0] == 8) {
                v = new Span<long>(buf, 1)[0];
            }
        } finally {
            NativeMemory.Free(buf);
            NativeMemory.Free(len);
        }
        return v;
    }

    /// kern.cp_time 的五个 tick 计数（user/nice/system/idle/irq）；
    /// 读取失败时全 0。
    static long[] CpTime() {
        long[] r = new long[5];
        nint buf = NativeMemory.Alloc(40);
        nint len = NativeMemory.Alloc(8);
        try {
            new Span<long>(len, 1)[0] = 40;
            if (Cpu.SysctlByName("kern.cp_time", buf, len, 0, 0) == 0) {
                Span<long> q = new Span<long>(buf, 5);
                for (int i = 0; i < 5; i = i + 1) { r[i] = q[i]; }
            }
        } finally {
            NativeMemory.Free(buf);
            NativeMemory.Free(len);
        }
        return r;
    }
    #endif

    #if LINUX
    /// /proc 的 key: value 文件中（冒号后）第一个 `field` 的值。
    static string ProcField(string path, string field) {
        string txt = "";
        try {
            txt = File.ReadAllText(path);
        } catch {
            return "";
        }
        // 逐行扫描：field + ":" + value
        int i = 0;
        while (i < txt.Length) {
            int eol = Cpu.IndexOf(txt, "\n", i);
            if (eol < 0) { eol = txt.Length; }
            string line = txt.Substring(i, eol - i);
            int colon = Cpu.IndexOf(txt, ":", i);
            if (colon >= 0 && colon < eol) {
                string key = txt.Substring(i, colon - i).Trim();
                if (key == field) {
                    return txt.Substring(colon + 1, eol - colon - 1).Trim();
                }
            }
            i = eol + 1;
        }
        return "";
    }

    /// 统计 /proc/cpuinfo 中 processor 行数；读取失败时至少返回 1。
    static int CountCpuLines() {
        string txt = "";
        try {
            txt = File.ReadAllText("/proc/cpuinfo");
        } catch {
            return 1;
        }
        int n = 0;
        int i = 0;
        while (i < txt.Length) {
            int eol = Cpu.IndexOf(txt, "\n", i);
            if (eol < 0) { eol = txt.Length; }
            string line = txt.Substring(i, eol - i).Trim();
            if (line.StartsWith("processor")) { n = n + 1; }
            i = eol + 1;
        }
        if (n < 1) { n = 1; }
        return n;
    }

    /// [0] = 总 jiffies，[1] = 空闲 jiffies（来自 /proc/stat 第一行）。
    static long[] CpuJiffies() {
        long[] r = new long[2];
        string txt = "";
        try {
            txt = File.ReadAllText("/proc/stat");
        } catch {
            return r;
        }
        int eol = Cpu.IndexOf(txt, "\n", 0);
        if (eol < 0) { eol = txt.Length; }
        string line = txt.Substring(0, eol);
        // 核心契约与语义定义。
        // 对数字做分词并求和：total = 全部，idle = 字段 4 + 5。
        long total = 0;
        long idle = 0;
        int idx = 0;
        int field = 0;
        while (idx < line.Length) {
            while (idx < line.Length && (line[idx] & 255) == 32) {
                idx = idx + 1;
            }
            if (idx >= line.Length) { break; }
            int start = idx;
            while (idx < line.Length && (line[idx] & 255) != 32) {
                idx = idx + 1;
            }
            string tok = line.Substring(start, idx - start);
            if (field >= 1) {
                long v = Cpu.ParseLong(tok);
                total = total + v;
                if (field == 4 || field == 5) { idle = idle + v; }
            }
            field = field + 1;
        }
        r[0] = total;
        r[1] = idle;
        return r;
    }
    #endif

    /// `hay` 中从 `from` 开始首次出现 `needle` 的索引，找不到返回 -1。
    static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }

    /// 解析十进制 long，格式错误返回 -1。
    static long ParseLong(string s) {
        if (s == null || s.Length == 0) { return -1; }
        bool neg = false;
        int i = 0;
        if (s[0] == 45) { neg = true; i = 1; } // '-'
        if (i >= s.Length) { return -1; }
        long v = 0;
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 0x30 || c > 0x39) { return -1; }
            v = v * 10 + (c - 0x30);
            i = i + 1;
        }
        if (neg) { v = 0 - v; }
        return v;
    }

    /// 解析十进制 int，格式错误返回 -1。
    static int ParseInt(string s) {
        long v = Cpu.ParseLong(s);
        if (v > 2147483647) { return -1; }
        return (int)v;
    }

    /// 单字符字符串的码点（ASCII 快速路径）。
    static int CodeOf(string ch) {
        if (ch == null || ch.Length == 0) { return 0; }
        return ch[0] & 255;
    }
}
