using System;

namespace System.Management;

/// <summary>
/// 机器与操作系统的静态身份信息。Windows 从 Win32 API 读取
/// 计算机/用户名和版本块；Linux 从
/// /etc/os-release、/proc/sys/kernel/* 和 USER 环境变量读取；macOS 读
/// sysctl（kern.hostname、kern.osproductversion、kern.boottime）和
/// USER 环境变量。其他平台返回空/0 而非抛异常——这些都是纯查询，
/// 安静的返回空结果比抛异常更友好。
/// </summary>
class SystemInfo {
    /// <summary>计算机（主机）名称。</summary>
    static string ComputerName() {
        #if WINDOWS
        nint buf = NativeMemory.Alloc(64 * 2 + 2);
        nint size = NativeMemory.Alloc(4);
        string s = "";
        try {
            new Span<int>(size, 1)[0] = 64;
            int ok = SystemInfo.WinGetComputerNameW(buf, size);
            if (ok != 0) { s = Wide.Read(buf); }
        } finally {
            NativeMemory.Free(buf);
            NativeMemory.Free(size);
        }
        return s;
        #elif LINUX
        return SystemInfo.ProcText("/proc/sys/kernel/hostname").Trim();
        #elif MACOS
        return SystemInfo.SysctlString("kern.hostname");
        #else
        return "";
        #endif
    }

    /// <summary>当前用户名。</summary>
    static string UserName() {
        #if WINDOWS
        nint buf = NativeMemory.Alloc(64 * 2 + 2);
        nint size = NativeMemory.Alloc(4);
        string s = "";
        try {
            new Span<int>(size, 1)[0] = 64;
            int ok = SystemInfo.WinGetUserNameW(buf, size);
            if (ok != 0) { s = Wide.Read(buf); }
        } finally {
            NativeMemory.Free(buf);
            NativeMemory.Free(size);
        }
        return s;
        #elif LINUX
        string v = Interop.getenv("USER");
        if (v == "") { v = Interop.getenv("LOGNAME"); }
        return v;
        #elif MACOS
        // macOS 图形会话不总是导出 USER，用 LOGNAME 兜底。
        string v = Interop.getenv("USER");
        if (v == "") { v = Interop.getenv("LOGNAME"); }
        return v;
        #else
        return "";
        #endif
    }

    /// <summary>操作系统名称，如 "Windows 11 Pro" 或 "Ubuntu 22.04.3 LTS"。</summary>
    static string OsName() {
        #if WINDOWS
        return SystemInfo.WinOsName();
        #elif LINUX
        string name = SystemInfo.OsRelease("NAME");
        string ver = SystemInfo.OsRelease("VERSION");
        if (name == "") { name = "Linux"; }
        if (ver == "") { return name; }
        return name + " " + ver;
        #elif MACOS
        // kern.osproductversion 形如 "14.5"（10.13.4 起可用）。
        string ver = SystemInfo.SysctlString("kern.osproductversion");
        if (ver == "") { return "macOS"; }
        return "macOS " + ver;
        #else
        return "";
        #endif
    }

    /// <summary>内核版本，如 "10.0.22631" 或 "6.5.0-14-generic"。</summary>
    static string KernelVersion() {
        #if WINDOWS
        return SystemInfo.WinKernelVersion();
        #elif LINUX
        return SystemInfo.ProcText("/proc/sys/kernel/osrelease").Trim();
        #elif MACOS
        // Darwin 内核版本，形如 "23.5.0"。
        return SystemInfo.SysctlString("kern.osrelease");
        #else
        return "";
        #endif
    }

    /// <summary>系统运行时间（秒）。</summary>
    static long UptimeSeconds() {
        #if WINDOWS
        return SystemInfo.WinGetTickCount64() / 1000;
        #elif LINUX
        // /proc/uptime: "<seconds> <idle>"，秒带小数（如 "1234.56"），
        // 截断到小数点再按整数解析。
        string t = SystemInfo.ProcText("/proc/uptime");
        int sp = SystemInfo.IndexOf(t, " ", 0);
        if (sp < 0) { sp = t.Length; }
        int dot = SystemInfo.IndexOf(t, ".", 0);
        if (dot >= 0 && dot < sp) { sp = dot; }
        string secs = t.Substring(0, sp).Trim();
        long v = SystemInfo.ParseLong(secs);
        if (v < 0) { v = 0; }
        return v;
        #elif MACOS
        // kern.boottime：struct timeval { tv_sec(8), tv_usec(8) }，
        // 运行时间 = 当前墙钟 - 启动时刻。
        nint buf = NativeMemory.Alloc(16);
        nint len = NativeMemory.Alloc(8);
        long up = 0;
        try {
            new Span<long>(len, 1)[0] = 16;
            if (SystemInfo.SysctlByName("kern.boottime", buf, len, 0, 0) == 0
                && new Span<long>(len, 1)[0] >= 8) {
                long boot = new Span<long>(buf, 2)[0];
                long now = SystemInfo.NowTime(0);
                if (now > boot) { up = now - boot; }
            }
        } finally {
            NativeMemory.Free(buf);
            NativeMemory.Free(len);
        }
        return up;
        #else
        return 0;
        #endif
    }

    /// <summary>系统目录（Windows 下为 C:\Windows\System32）。</summary>
    static string SystemDirectory() {
        #if WINDOWS
        nint buf = NativeMemory.Alloc(512 * 2 + 2);
        string s = "";
        try {
            int n = SystemInfo.WinGetSystemDirectoryW(buf, 512);
            if (n > 0) { s = Wide.Read(buf); }
        } finally {
            NativeMemory.Free(buf);
        }
        return s;
        #elif LINUX
        return "/usr";
        #elif MACOS
        // 与 Linux 口径一致：Unix 系统根。
        return "/usr";
        #else
        return "";
        #endif
    }

    /// <summary>Windows 目录（Windows 下为 C:\Windows）。</summary>
    static string WindowsDirectory() {
        #if WINDOWS
        nint buf = NativeMemory.Alloc(512 * 2 + 2);
        string s = "";
        try {
            int n = SystemInfo.WinGetWindowsDirectoryW(buf, 512);
            if (n > 0) { s = Wide.Read(buf); }
        } finally {
            NativeMemory.Free(buf);
        }
        return s;
        #else
        return "";
        #endif
    }

    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetComputerNameW")]
    static extern int WinGetComputerNameW(nint buf, nint size);

    [DllImport("advapi32", EntryPoint = "GetUserNameW")]
    static extern int WinGetUserNameW(nint buf, nint size);

    [DllImport("kernel32", EntryPoint = "GetSystemDirectoryW")]
    static extern int WinGetSystemDirectoryW(nint buf, int size);

    [DllImport("kernel32", EntryPoint = "GetWindowsDirectoryW")]
    static extern int WinGetWindowsDirectoryW(nint buf, int size);

    [DllImport("kernel32", EntryPoint = "GetTickCount64")]
    static extern long WinGetTickCount64();

    [DllImport("ntdll", EntryPoint = "RtlGetVersion")]
    static extern int WinRtlGetVersion(nint info);

    /// Windows 实现：RtlGetVersion 版本块映射为产品名（按 build 区分
    /// Win10/11），后接 Service Pack 名。
    static string WinOsName() {
        // RtlGetVersion -> OSVERSIONINFOW: dwOSVersionInfoSize(4) major(4)
        // minor(4) build(4) platform(4) servicePack(128 wide chars).
        nint info = NativeMemory.Alloc(276);
        string name = "Windows";
        try {
            new Span<int>(info, 2)[0] = 276;
            if (SystemInfo.WinRtlGetVersion(info) == 0) {
                Span<int> w = new Span<int>(info, 5);
                int major = w[1];
                int minor = w[2];
                int build = w[3];
                string sp = Wide.Read(info + 20);
                if (major == 10 && build >= 22000) { name = "Windows 11"; }
                else if (major == 10) { name = "Windows 10"; }
                else if (major == 6 && minor == 3) { name = "Windows 8.1"; }
                else if (major == 6 && minor == 2) { name = "Windows 8"; }
                else if (major == 6 && minor == 1) { name = "Windows 7"; }
                else if (major == 6 && minor == 0) { name = "Windows Vista"; }
                else if (major == 5 && minor == 1) { name = "Windows XP"; }
                if (sp != "") { name = name + " " + sp; }
            }
        } finally {
            NativeMemory.Free(info);
        }
        return name;
    }

    /// Windows 实现："major.minor.build" 形式；RtlGetVersion 失败返回 ""。
    static string WinKernelVersion() {
        nint info = NativeMemory.Alloc(276);
        string v = "";
        try {
            new Span<int>(info, 2)[0] = 276;
            if (SystemInfo.WinRtlGetVersion(info) == 0) {
                Span<int> w = new Span<int>(info, 5);
                int major = w[1];
                int minor = w[2];
                int build = w[3];
                v = Convert.ToString(major) + "." + Convert.ToString(minor)
                    + "." + Convert.ToString(build);
            }
        } finally {
            NativeMemory.Free(info);
        }
        return v;
    }
    #endif

    #if MACOS
    [DllImport("crt", EntryPoint = "sysctlbyname")]
    static extern int SysctlByName(string name, nint oldp, nint oldlenp,
                                    nint newp, int newlen);

    [DllImport("crt", EntryPoint = "time")]
    static extern long NowTime(nint tloc);

    /// 读取 sysctl 字符串值（UTF-8 C 串）；键不存在返回 ""。
    static string SysctlString(string name) {
        nint buf = NativeMemory.Alloc(256);
        nint len = NativeMemory.Alloc(8);
        string s = "";
        try {
            new Span<long>(len, 1)[0] = 256;
            if (SystemInfo.SysctlByName(name, buf, len, 0, 0) == 0) {
                int n = 0;
                while (n < 256 && new Span<byte>(buf + n, 1)[0] != 0) {
                    n = n + 1;
                }
                if (n > 0) { s = NativeMemory.GetString(buf, 0, n); }
            }
        } finally {
            NativeMemory.Free(buf);
            NativeMemory.Free(len);
        }
        return s;
    }
    #endif

    #if LINUX
    /// /etc/os-release 中第一个 `key="value"` 条目（已去除引号）。
    static string OsRelease(string key) {
        string txt = SystemInfo.ProcText("/etc/os-release");
        int i = 0;
        while (i < txt.Length) {
            int eol = SystemInfo.IndexOf(txt, "\n", i);
            if (eol < 0) { eol = txt.Length; }
            string line = txt.Substring(i, eol - i);
            if (line.StartsWith(key + "=")) {
                string val = line.Substring(key.Length + 1, line.Length - key.Length - 1);
                val = val.Trim();
                if (val.Length >= 2 && val.Substring(0, 1) == "\""
                    && val.Substring(val.Length - 1, 1) == "\"") {
                    val = val.Substring(1, val.Length - 2);
                }
                return val;
            }
            i = eol + 1;
        }
        return "";
    }

    /// 读取文本文件；读不到（路径不存在、权限不足）返回 ""。
    static string ProcText(string path) {
        try {
            return File.ReadAllText(path);
        } catch {
            return "";
        }
    }

    /// 从 `from` 起查找 `needle` 的首次出现，找不到返回 -1。
    static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }

    /// 十进制解析为 long；空串或含非数字返回 -1。
    static long ParseLong(string s) {
        if (s == null || s.Length == 0) { return -1; }
        long v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 0x30 || c > 0x39) { return -1; }
            v = v * 10 + (c - 0x30);
        }
        return v;
    }

    /// 取 `ch` 编码后首字节的值（用于判断 ASCII 数字）。
    static int CodeOf(string ch) {
        if (ch == null || ch.Length == 0) { return 0; }
        return ch[0] & 255;
    }
    #endif
}
