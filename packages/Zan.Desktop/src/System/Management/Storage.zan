using System;
using System.Diagnostics;

namespace System.Management;

// 磁盘/分区枚举与容量。Windows 遍历逻辑驱动器
// （GetLogicalDriveStringsW + GetDiskFreeSpaceExW）；Linux 解析
// /proc/mounts，macOS 解析 `mount` 输出，二者均对每个挂载点调用
// statvfs（两平台的 struct statvfs 容量字段布局一致）。跨平台原生实现。
public class Storage {
    // 所有固定/可移动磁盘（Windows）、真实文件系统挂载点
    // （Linux 会跳过 proc、sysfs、tmpfs、devpts、cgroup、overlay...）
    // 或真实磁盘文件系统挂载点（macOS 只保留 apfs/hfs/msdos/exfat/
    public static List<DiskUsage> Drives() {
        #if WINDOWS
        return Storage.WinDrives();
        #elif MACOS
        return Storage.MacDrives();
        #elif LINUX
        return Storage.LinuxDrives();
        #else
        Storage.ThrowNotSupported();
        return new List<DiskUsage>();
        #endif
    }

    // 系统盘（Windows）或根文件系统（Linux/macOS）。
    // 读取失败时返回空的 usage 对象。
    public static DiskUsage Root() {
        #if WINDOWS
        return Storage.Usage("C:");
        #elif LINUX || MACOS
        return Storage.Usage("/");
        #else
        Storage.ThrowNotSupported();
        return new DiskUsage();
        #endif
    }

    // 单个盘符（"C:"）或挂载点（"/"）的容量。
    public static DiskUsage Usage(string path) {
        if (path == null || path.Length == 0) { return new DiskUsage(); }
        #if WINDOWS
        return Storage.WinUsage(path);
        #elif LINUX || MACOS
        return Storage.Statvfs(path);
        #else
        Storage.ThrowNotSupported();
        return new DiskUsage();
        #endif
    }

    #if !WINDOWS && !LINUX && !MACOS
    private static void ThrowNotSupported() {
        throw new PlatformNotSupportedException(
            "Storage and disk query is only supported on Windows, Linux, and macOS.");
    }
    #endif

    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetLogicalDriveStringsW")]
    private static extern int WinGetLogicalDriveStringsW(int len, nint buf);

    [DllImport("kernel32", EntryPoint = "GetDriveTypeW")]
    private static extern int WinGetDriveTypeW(nint root);

    [DllImport("kernel32", EntryPoint = "GetDiskFreeSpaceExW")]
    private static extern int WinGetDiskFreeSpaceExW(nint dir, nint avail, nint total,
                                             nint free);

    // Windows 实现：枚举逻辑驱动器，只保留固定/可移动盘中有容量的。
    private static List<DiskUsage> WinDrives() {
        List<DiskUsage> list = new List<DiskUsage>();
        int need = Storage.WinGetLogicalDriveStringsW(0, 0);
        if (need <= 0 || need > 0x100000) { return list; }
        int bytes = need * 2 + 2;
        nint buf = NativeMemory.Alloc(bytes);
        try {
            NativeMemory.Fill(buf, 0, bytes);
            int got = Storage.WinGetLogicalDriveStringsW(need, buf);
            if (got <= 0 || got > need) { return list; }
            // 缓冲区是一系列以 NUL 结尾的宽字符串，末尾以
            // 双重 NUL 结束。每个形如 "C:\"。
            nint end = buf + (nint)(got * 2);
            nint p = buf;
            while (p < end) {
                int wlen = Storage.WideLenBounded(p, end);
                if (wlen <= 0) { break; }
                string root = Wide.Read(p);
                int type = Storage.WinGetDriveTypeW(p);
                if (type == 2 /*DRIVE_REMOVABLE*/ || type == 3 /*DRIVE_FIXED*/) {
                    DiskUsage u = Storage.WinUsage(root);
                    if (u.totalBytes > 0) { list.Add(u); }
                }
                p = p + (nint)((wlen + 1) * 2);
            }
        } finally {
            NativeMemory.Free(buf);
        }
        return list;
    }

    // 宽缓冲区中 NUL 终止符之前的 UTF-16 码元数（受 end 上界保护，不含终止符）。
    private static int WideLenBounded(nint p, nint end) {
        int n = 0;
        while (p + (nint)(n * 2 + 2) <= end && new Span<ushort>(p + (nint)(n * 2), 1)[0] != 0) {
            n = n + 1;
        }
        return n;
    }

    // Windows 实现：GetDiskFreeSpaceExW；调用失败时三个字节数保持 0。
    private static DiskUsage WinUsage(string root) {
        DiskUsage u = new DiskUsage();
        if (root == null || root.Length == 0) { return u; }
        nint wroot = Wide.Of(root);
        nint avail = NativeMemory.Alloc(8);
        nint total = NativeMemory.Alloc(8);
        nint free = NativeMemory.Alloc(8);
        u.name = root;
        try {
            int ok = Storage.WinGetDiskFreeSpaceExW(wroot, avail, total, free);
            if (ok != 0) {
                u.availBytes = new Span<long>(avail, 1)[0];
                u.totalBytes = new Span<long>(total, 1)[0];
                u.freeBytes = new Span<long>(free, 1)[0];
            }
        } finally {
            Wide.Free(wroot);
            NativeMemory.Free(avail);
            NativeMemory.Free(total);
            NativeMemory.Free(free);
        }
        return u;
    }
    #endif

    #if LINUX || MACOS
    [DllImport("crt", EntryPoint = "statvfs")]
    private static extern int StatvfsCall(nint path, nint stat);

    // Linux/macOS 实现：statvfs 读取挂载点容量；调用失败时三个字节数保持 0。
    // Linux 64 位 sizeof(struct statvfs) == 112（f_blocks/bfree/bavail 为 64 位 @ 16/24/32）；
    // macOS 64 位 fsblkcnt_t 为 32 位无符号整型（f_blocks/bfree/bavail @ 16/20/24）。
    // 按 POSIX 规范，块计数以 f_frsize 为单位（为 0 时回退 f_bsize）。
    private static DiskUsage Statvfs(string path) {
        DiskUsage u = new DiskUsage();
        if (path == null || path.Length == 0) { return u; }
        // 预留 128 字节，覆盖 Linux(112B) 与 macOS(64B) 两平台完整结构体。
        nint st = NativeMemory.Alloc(128);
        u.name = path;
        try {
            NativeMemory.Fill(st, 0, 128);
            int ok = Storage.StatvfsCall(path, st);
            if (ok == 0) {
                Span<long> q = new Span<long>(st, 14);
                long bsize = q[0];
                long frsize = q[1];
                long unit = frsize > 0 ? frsize : bsize;
                long blocks = 0;
                long bfree = 0;
                long bavail = 0;
                #if MACOS
                Span<int> d = new Span<int>(st, 8);
                blocks = (long)d[4] & 0xFFFFFFFFL;
                bfree = (long)d[5] & 0xFFFFFFFFL;
                bavail = (long)d[6] & 0xFFFFFFFFL;
                #else
                blocks = q[2];
                bfree = q[3];
                bavail = q[4];
                #endif
                if (unit > 0) {
                    long maxBlocks = 9223372036854775807L / unit;
                    if (blocks > 0) { u.totalBytes = blocks > maxBlocks ? 9223372036854775807L : blocks * unit; }
                    if (bfree > 0) { u.freeBytes = bfree > maxBlocks ? 9223372036854775807L : bfree * unit; }
                    if (bavail > 0) { u.availBytes = bavail > maxBlocks ? 9223372036854775807L : bavail * unit; }
                }
            }
        } finally {
            NativeMemory.Free(st);
        }
        return u;
    }
    #endif

    #if LINUX
    // Linux 实现：解析 /proc/mounts，对每个真实文件系统挂载点调 statvfs；
    // /proc/mounts 读不到返回空列表。
    private static List<DiskUsage> LinuxDrives() {
        List<DiskUsage> list = new List<DiskUsage>();
        string txt = "";
        try {
            txt = File.ReadAllText("/proc/mounts");
        } catch (Exception _ex) {
            // /proc/mounts 无法读取时返回空挂载列表
            return list;
        }
        int i = 0;
        while (i < txt.Length) {
            int eol = txt.IndexOf("\n", i);
            if (eol < 0) { eol = txt.Length; }
            string line = txt.Substring(i, eol - i);
            int sp1 = line.IndexOf(" ", 0);
            if (sp1 >= 0) {
                int sp2 = line.IndexOf(" ", sp1 + 1);
                if (sp2 >= 0) {
                    int sp3 = line.IndexOf(" ", sp2 + 1);
                    if (sp3 >= 0) {
                        string mount = line.Substring(sp1 + 1, sp2 - sp1 - 1);
                        string fstype = line.Substring(sp2 + 1, sp3 - sp2 - 1);
                        if (Storage.IsRealFs(fstype)) {
                            DiskUsage u = Storage.Statvfs(mount);
                            if (u.totalBytes > 0) { list.Add(u); }
                        }
                    }
                }
            }
            i = eol + 1;
        }
        return list;
    }

    // 对具有真实磁盘容量的文件系统返回 True。
    private static bool IsRealFs(string fstype) {
        if (fstype == "proc" || fstype == "sysfs" || fstype == "devpts"
            || fstype == "tmpfs" || fstype == "devtmpfs"
            || fstype == "cgroup" || fstype == "cgroup2"
            || fstype == "overlay" || fstype == "mqueue"
            || fstype == "securityfs" || fstype == "pstore"
            || fstype == "debugfs" || fstype == "tracefs"
            || fstype == "configfs" || fstype == "fusectl"
            || fstype == "binfmt_misc" || fstype == "autofs"
            || fstype == "hugetlbfs" || fstype == "bpf") {
            return false;
        }
        return true;
    }
    #endif

    #if MACOS
    // macOS 实现：`mount` 列出挂载点，对真实磁盘文件系统调 statvfs。
    // mount 不可用或无匹配时返回空列表。挂载点路径含 " on " 时
    // 解析不可靠（`mount` 不转义空格）——普通路径不受影响。
    private static List<DiskUsage> MacDrives() {
        List<DiskUsage> list = new List<DiskUsage>();
        List<string> margs = new List<string>();
        ProcessResult r = Process.CaptureSafe("mount", margs);
        if (!r.Ok() || r.lines == null) { return list; }
        for (int i = 0; i < r.lines.Count; i = i + 1) {
            string line = r.lines[i];
            if (line == null) { continue; }
            int on = line.IndexOf(" on ", 0);
            if (on < 0) { continue; }
            int par = line.IndexOf(" (", on);
            if (par < 0) { continue; }
            if (line.Length < par + 3
                || (line[line.Length - 1] & 255) != 41 /*')'*/) { continue; }
            string mount = line.Substring(on + 4, par - on - 4);
            string types = line.Substring(par + 2, line.Length - par - 3);
            int comma = types.IndexOf(",", 0);
            if (comma >= 0) { types = types.Substring(0, comma); }
            if (!Storage.IsMacDiskFs(types)) { continue; }
            DiskUsage u = Storage.Statvfs(mount);
            if (u.totalBytes > 0) { list.Add(u); }
        }
        return list;
    }

    // 是否 macOS 上的真实磁盘文件系统（白名单，排除 devfs/autofs 等）。
    private static bool IsMacDiskFs(string fstype) {
        return fstype == "apfs" || fstype == "hfs"
            || fstype == "hfs+" || fstype == "msdos"
            || fstype == "exfat" || fstype == "ntfs"
            || fstype == "ufs" || fstype == "zfs"
            || fstype == "udf";
    }
    #endif
}
