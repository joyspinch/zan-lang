using System;

namespace System.Management;

// 单个显示器：索引（0 = 主屏）、名称、像素尺寸、刷新率和
// 颜色深度。
class DisplayInfo {
    // 枚举序号（0 = 主屏）。
    public int index;
    // 系统设备名（Windows 为 "\\.\DISPLAY1" 等；其他平台为描述性名称）。
    public string name;
    // 宽度（像素）。
    public int width;
    // 高度（像素）。
    public int height;
    // 该显示器在虚拟桌面里的左上角坐标。macOS 为 CoreGraphics 桌面坐标，
    // 不等于混合缩放桌面上的设备像素偏移；负值表示主屏左侧。
    public int x;
    // 该显示器在虚拟桌面里的左上角 Y 坐标（macOS 主屏左上为零，向下为正）。
    public int y;
    // 是否为主显示器。
    public bool primary;
    // 刷新率（Hz；未知时为 0）。
    public int refreshHz;
    // 颜色深度（每像素位数；未知时为 0）。
    public int bitsPerPixel;
}
