using System;

namespace System.Management;

// 一个注册表值：`name`（默认值为 ""）、`type`（
// <see cref="Registry"/> 的类型常量之一）以及原始字节负载。
// 用带类型的 getter 进行解码。
class RegistryValue {
    // 值名；键的默认（未命名）值为 ""。
    public string name;
    // 值类型（<see cref="Registry"/> 的 Type* 常量之一）。
    public int type;
    // 原始字节负载，按 `type` 解释。
    public byte[] data;
}
