using System;
using System.Diagnostics;

namespace System.Management;

/// <summary>
/// 机器及其电池的电源状态。
/// </summary>
class PowerStatus {
    /// 使用电池供电（未接交流电）时为 True。
    public bool onBattery;
    /// 电池电量百分比（0..100；无电池时为 -1）。
    public int batteryPercent;
    /// 剩余电池续航时间（秒；未知/无限时为 -1）。
    public long batteryLifeSeconds;
}

/// <summary>
/// 电源/电池状态。Windows 调用 GetSystemPowerStatus；Linux 读取
/// /sys/class/power_supply（BAT* 条目）；macOS 解析 `pmset -g batt`
/// 输出（无电池的桌面 Mac：percent/life 为 -1）。其他平台抛出
/// PlatformNotSupportedException.
/// </summary>
class Power {
    /// <summary>当前电源状态快照。</summary>
    static PowerStatus GetStatus() {
        #if WINDOWS
        return Power.WinStatus();
        #elif LINUX
        return Power.LinuxStatus();
        #elif MACOS
        return Power.MacStatus();
        #else
        PowerStatus ps = new PowerStatus();
        ps.onBattery = false;
        ps.batteryPercent = -1;
        ps.batteryLifeSeconds = -1L;
        return ps;
        #endif
    }

    /// <summary>机器正在使用电池供电时为 True。</summary>
    static bool OnBattery() {
        return Power.GetStatus().onBattery;
    }

    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetSystemPowerStatus")]
    static extern int WinGetSystemPowerStatus(nint buf);

    /// Windows 实现：解析 GetSystemPowerStatus 的 SYSTEM_POWER_STATUS；
    /// 无电池或数值未知时 percent/life 为 -1。
    static PowerStatus WinStatus() {
        // 核心契约与语义定义。
        // BatteryLifePercent(1) SystemStatusFlag(1) BatteryLifeTime(4)
        // BatteryFullLifeTime(4).
        nint buf = NativeMemory.Alloc(16);
        PowerStatus s = new PowerStatus();
        try {
            Power.WinGetSystemPowerStatus(buf);
            Span<byte> b = new Span<byte>(buf, 16);
            Span<int> w = new Span<int>(buf + 4, 2);
            int ac = b[0];
            int flag = b[1];
            int pct = b[2];
            // ACLineStatus：1 = 在线（AC），0 = 离线（电池）。
            s.onBattery = ac != 1;
            if (pct == 255) { s.batteryPercent = -1; }  // 未知
            else { s.batteryPercent = pct; }
            if (flag == 255) {
                // 系统没有电池。
                s.batteryPercent = -1;
            }
            int life = w[0];
            if (life == 0xFFFFFFFF) { s.batteryLifeSeconds = -1; }
            else { s.batteryLifeSeconds = life; }
        } finally {
            NativeMemory.Free(buf);
        }
        return s;
    }
    #endif

    #if LINUX
    /// Linux 实现：读 /sys/class/power_supply 的第一个 BAT* 电源；
    /// 没有电池时 onBattery=false 且 percent/life 为 -1。
    static PowerStatus LinuxStatus() {
        PowerStatus s = new PowerStatus();
        s.batteryPercent = -1;
        s.batteryLifeSeconds = -1;
        string type = Power.SysClass("type");
        if (type != "Battery") {
            // 没有电池；正在使用交流电。
            s.onBattery = false;
            return s;
        }
        string status = Power.SysClass("status");
        s.onBattery = status == "Discharging";
        int energyNow = Power.SysInt("energy_now");
        int energyFull = Power.SysInt("energy_full");
        int powerNow = Power.SysInt("power_now");
        if (energyFull > 0 && energyNow >= 0) {
            s.batteryPercent = energyNow * 100 / energyFull;
            if (s.batteryPercent > 100) { s.batteryPercent = 100; }
        }
        if (powerNow > 0 && energyNow > 0) {
            // energy_now 单位为 µWh，power_now 单位为 µW -> 先得到小时，再换算为秒。
            s.batteryLifeSeconds = (long)energyNow * 3600 / powerNow;
        }
        return s;
    }

    /// 第一个 BAT* 电源：从 /sys/class/power_supply 读取 `field`。
    static string SysField(string field) {
        string txt = "";
        try {
            txt = File.ReadAllText("/sys/class/power_supply/BAT0/" + field);
        } catch {
            return "";
        }
        return txt.Trim();
    }

    /// 读第一个可用电池（BAT0 优先）的 `field` 属性；全缺时返回 ""。
    static string SysClass(string field) {
        string v = Power.SysField(field);
        if (v != "") { return v; }
        return Power.SysField2(field);
    }

    /// BAT0 不存在时依次尝试 BAT1..BAT9。
    static string SysField2(string field) {
        int i = 1;
        while (i <= 9) {
            string path = "/sys/class/power_supply/BAT" + Convert.ToString(i)
                + "/" + field;
            try {
                return File.ReadAllText(path).Trim();
            } catch {
            }
            i = i + 1;
        }
        return "";
    }

    /// 读数字属性；缺失或非法时为 -1。
    static int SysInt(string field) {
        string v = Power.SysClass(field);
        if (v == "") { return -1; }
        return Power.ParseInt(v);
    }

    /// 十进制解析为 int；空串或含非数字返回 -1。
    static int ParseInt(string s) {
        if (s == null || s.Length == 0) { return -1; }
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 0x30 || c > 0x39) { return -1; }
            v = v * 10 + (c - 0x30);
        }
        return v;
    }

    /// 取 `ch` 编码后首字节的值（用于判断 ASCII 数字）。
    static int CodeOf(string ch) {
        if (ch == null || ch.Length == 0) { return 0; }
        return ch[0] & 255;
    }
    #endif

    #if MACOS
    /// macOS 实现：`pmset -g batt` 文本。首行
    /// "Now drawing from 'Battery Power'" 判定供电来源；电池行
    /// "98%; discharging; 4:58 remaining present: true" 给出电量与
    /// 续航。桌面 Mac（无电池）没有百分号字段：percent/life 为 -1。
    /// pmset 不可用时 onBattery=false 且 percent/life 为 -1。
    static PowerStatus MacStatus() {
        PowerStatus s = new PowerStatus();
        s.batteryPercent = -1;
        s.batteryLifeSeconds = -1;
        List<string> args = new List<string>();
        args.Add("-g");
        args.Add("batt");
        ProcessResult r = Process.CaptureSafe("pmset", args);
        if (!r.Ok() || r.lines == null) { return s; }
        string text = "";
        for (int i = 0; i < r.lines.Count; i = i + 1) {
            text = text + r.lines[i] + "\n";
        }
        s.onBattery = text.IndexOf("Battery Power") >= 0;
        // 电量：'%;' 前的连续数字。
        int pctMark = Power.IndexOf(text, "%;", 0);
        if (pctMark > 0) {
            int e = pctMark - 1;
            int v = 0;
            int mul = 1;
            while (e >= 0 && (text[e] & 255) >= 48
                   && (text[e] & 255) <= 57) {
                v = v + ((text[e] & 255) - 48) * mul;
                mul = mul * 10;
                e = e - 1;
            }
            if (mul > 1) {
                s.batteryPercent = v;
                if (s.batteryPercent > 100) { s.batteryPercent = 100; }
            }
        }
        // 续航："H:MM remaining"；"(no estimate)" 时冒号缺失。
        int rem = Power.IndexOf(text, " remaining", 0);
        if (rem >= 0) {
            int colon = -1;
            int e = rem - 1;
            while (e >= 0) {
                int c = text[e] & 255;
                if (c == 58 /*':'*/) { colon = e; break; }
                if (c < 48 || c > 57) { break; }
                e = e - 1;
            }
            if (colon > 0) {
                int hours = 0;
                int mul = 1;
                int e2 = colon - 1;
                while (e2 >= 0 && (text[e2] & 255) >= 48
                       && (text[e2] & 255) <= 57) {
                    hours = hours + ((text[e2] & 255) - 48) * mul;
                    mul = mul * 10;
                    e2 = e2 - 1;
                }
                int minutes = -1;
                if (colon + 2 < rem
                    && (text[colon + 1] & 255) >= 48
                    && (text[colon + 1] & 255) <= 57
                    && (text[colon + 2] & 255) >= 48
                    && (text[colon + 2] & 255) <= 57) {
                    minutes = ((text[colon + 1] & 255) - 48) * 10
                        + ((text[colon + 2] & 255) - 48);
                }
                if (mul > 1 && minutes >= 0) {
                    s.batteryLifeSeconds = hours * 3600 + minutes * 60;
                }
            }
        }
        return s;
    }

    /// 从 `from` 起查找 `needle` 的首次出现，找不到返回 -1。
    static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }
    #endif
}
