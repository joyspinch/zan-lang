using System;
using System.Diagnostics;
using System.Text;

namespace System.Management;

// 电源/电池状态。Windows 调用 GetSystemPowerStatus；Linux 读取
// /sys/class/power_supply（BAT* 条目）；macOS 解析 `pmset -g batt`
// 输出（无电池的桌面 Mac：percent/life 为 -1）。其他平台抛出
// PlatformNotSupportedException.
public class Power {
    // 当前电源状态快照。
    public static PowerStatus GetStatus() {
        #if WINDOWS
        return Power.WinStatus();
        #elif LINUX
        return Power.LinuxStatus();
        #elif MACOS
        return Power.MacStatus();
        #else
        throw new PlatformNotSupportedException(
            "Power management is only supported on Windows, Linux, and macOS.");
        #endif
    }

    // 机器正在使用电池供电时为 True。
    public static bool OnBattery() {
        return Power.GetStatus().onBattery;
    }

    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetSystemPowerStatus")]
    private static extern int WinGetSystemPowerStatus(nint buf);

    // Windows 实现：解析 GetSystemPowerStatus 的 SYSTEM_POWER_STATUS；
    // 无电池或数值未知时 percent/life 为 -1。
    private static PowerStatus WinStatus() {
        // BatteryLifePercent(1) SystemStatusFlag(1) BatteryLifeTime(4)
        // BatteryFullLifeTime(4).
        nint buf = NativeMemory.Alloc(16);
        PowerStatus s = new PowerStatus();
        s.batteryPercent = -1;
        s.batteryLifeSeconds = -1;
        try {
            NativeMemory.Fill(buf, 0, 16);
            if (Power.WinGetSystemPowerStatus(buf) == 0) { return s; }
            Span<byte> b = new Span<byte>(buf, 16);
            Span<int> w = new Span<int>(buf + 4, 2);
            int ac = b[0] & 255;
            int flag = b[1] & 255;
            int pct = b[2] & 255;
            // ACLineStatus：1 = 在线（AC），0 = 离线（电池）。
            s.onBattery = ac == 0;
            if (pct == 255 || pct > 100) { s.batteryPercent = -1; }  // 未知
            else { s.batteryPercent = pct; }
            if (flag == 255 || (flag & 128) != 0) {
                // 系统没有电池（BATTERY_FLAG_NO_BATTERY = 128）或状态未知（255）。
                s.batteryPercent = -1;
            }
            int life = w[0];
            if (life == 0xFFFFFFFF || life < 0) { s.batteryLifeSeconds = -1; }
            else { s.batteryLifeSeconds = life; }
        } finally {
            NativeMemory.Free(buf);
        }
        return s;
    }
    #endif

    #if LINUX
    // Linux 实现：读 /sys/class/power_supply 的第一个 BAT* 电源；
    // 没有电池时 onBattery=false 且 percent/life 为 -1。
    private static PowerStatus LinuxStatus() {
        PowerStatus s = new PowerStatus();
        s.batteryPercent = -1;
        s.batteryLifeSeconds = -1;
        string type = Power.SysClass("type");
        if (type != "Battery") {
            // 没有电池；正在使用交流电。
            s.onBattery = false;
            return s;
        }
        string status = Power.SysClass("status");
        s.onBattery = status == "Discharging";
        long energyNow = Power.SysLong("energy_now");
        long energyFull = Power.SysLong("energy_full");
        long powerNow = Power.SysLong("power_now");
        if (energyFull > 0L && energyNow >= 0L) {
            long pct = energyNow > 92233720368547758L
                ? (energyNow / (energyFull / 100L > 0L ? energyFull / 100L : 1L))
                : (energyNow * 100L / energyFull);
            if (pct > 100L) { pct = 100L; }
            s.batteryPercent = (int)pct;
        }
        if (powerNow > 0L && energyNow > 0L) {
            // energy_now 单位为 µWh，power_now 单位为 µW -> 先得到小时，再换算为秒。
            long sec = energyNow > 2562047788015215L
                ? (energyNow / powerNow) * 3600L
                : (energyNow * 3600L) / powerNow;
            s.batteryLifeSeconds = sec;
        }
        return s;
    }

    // 第一个 BAT* 电源：从 /sys/class/power_supply 读取 `field`。
    private static string SysField(string field) {
        string txt = "";
        try {
            txt = File.ReadAllText("/sys/class/power_supply/BAT0/" + field);
        } catch (Exception _ex) {
            // BAT0 节点缺失时返回空串
            return "";
        }
        return txt.Trim();
    }

    // 读第一个可用电池（BAT0 优先）的 `field` 属性；全缺时返回 ""。
    private static string SysClass(string field) {
        string v = Power.SysField(field);
        if (v != "") { return v; }
        return Power.SysField2(field);
    }

    // BAT0 不存在时依次尝试 BAT1..BAT9。
    private static string SysField2(string field) {
        int i = 1;
        while (i <= 9) {
            string path = "/sys/class/power_supply/BAT" + Convert.ToString(i)
                + "/" + field;
            try {
                return File.ReadAllText(path).Trim();
            } catch (Exception _ex) {
                // 备用电池节点不存在时跳过该槽位
            }
            i = i + 1;
        }
        return "";
    }

    // 读长整型数字属性；缺失或非法时为 -1。
    private static long SysLong(string field) {
        string v = Power.SysClass(field);
        if (v == "") { return -1L; }
        return Power.ParseLong(v);
    }

    // 十进制解析为非负 long；空串、含非数字或溢出返回 -1。
    private static long ParseLong(string s) {
        if (s == null || s.Length == 0) { return -1L; }
        long v = 0L;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 0x30 || c > 0x39) { return -1L; }
            long d = (long)(c - 0x30);
            if (v > (9223372036854775807L - d) / 10L) { return -1L; }
            v = v * 10L + d;
        }
        return v;
    }
    #endif

    #if MACOS
    // macOS 实现：`pmset -g batt` 文本。首行
    // "Now drawing from 'Battery Power'" 判定供电来源；电池行
    // "98%; discharging; 4:58 remaining present: true" 给出电量与
    // 续航。桌面 Mac（无电池）没有百分号字段：percent/life 为 -1。
    // pmset 不可用时 onBattery=false 且 percent/life 为 -1。
    private static PowerStatus MacStatus() {
        PowerStatus s = new PowerStatus();
        s.batteryPercent = -1;
        s.batteryLifeSeconds = -1;
        List<string> args = new List<string>();
        args.Add("-g");
        args.Add("batt");
        ProcessResult r = Process.CaptureSafe("pmset", args);
        if (!r.Ok() || r.lines == null) { return s; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < r.lines.Count; i = i + 1) {
            sb.Append(r.lines[i]);
            sb.Append("\n");
        }
        string text = sb.ToString();
        s.onBattery = text.IndexOf("Battery Power") >= 0;
        // 电量：'%;' 前的连续数字。
        int pctMark = text.IndexOf("%;", 0);
        if (pctMark > 0) {
            int e = pctMark - 1;
            long v = 0L;
            long mul = 1L;
            while (e >= 0 && (text[e] & 255) >= 48
                   && (text[e] & 255) <= 57 && mul <= 1000L) {
                v = v + (long)((text[e] & 255) - 48) * mul;
                mul = mul * 10L;
                e = e - 1;
            }
            if (mul > 1L) {
                if (v > 100L) { v = 100L; }
                s.batteryPercent = (int)v;
            }
        }
        // 续航："H:MM remaining"；"(no estimate)" 时冒号缺失。
        int rem = text.IndexOf(" remaining", 0);
        if (rem >= 0) {
            int colon = -1;
            int e = rem - 1;
            while (e >= 0) {
                int c = text[e] & 255;
                if (c == 58 /*':'*/) { colon = e; break; }
                if (c < 48 || c > 57) { break; }
                e = e - 1;
            }
            if (colon > 0) {
                long hours = 0L;
                long mul = 1L;
                int e2 = colon - 1;
                while (e2 >= 0 && (text[e2] & 255) >= 48
                       && (text[e2] & 255) <= 57 && mul <= 100000L) {
                    hours = hours + (long)((text[e2] & 255) - 48) * mul;
                    mul = mul * 10L;
                    e2 = e2 - 1;
                }
                int minutes = -1;
                if (colon + 2 < rem
                    && (text[colon + 1] & 255) >= 48
                    && (text[colon + 1] & 255) <= 57
                    && (text[colon + 2] & 255) >= 48
                    && (text[colon + 2] & 255) <= 57) {
                    minutes = ((text[colon + 1] & 255) - 48) * 10
                        + ((text[colon + 2] & 255) - 48);
                }
                if (mul > 1L && minutes >= 0) {
                    s.batteryLifeSeconds = hours * 3600L + (long)minutes * 60L;
                }
            }
        }
        return s;
    }
    #endif
}
