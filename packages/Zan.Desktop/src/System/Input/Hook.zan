using System;
using System.Threading;

namespace System.Input;

/// <summary>
/// 返回 true 表示低级键盘事件已被消费（事件被吞掉，
/// 下游不会看到）。返回 false 则放行该事件。
/// `vk`/`scan` 是键码和硬件扫描码，`flags` 为 LLKHF_*
/// 标志位，`injected` 用于区分合成（SendInput）事件与物理
/// 按键，`keyUp` 为 true 表示按键释放。
/// </summary>
delegate bool KeyboardHookCallback(int vk, int scan, int flags, bool injected,
                                   bool keyUp);

/// <summary>
/// 返回 true 表示低级鼠标事件已被消费。`x`/`y` 是屏幕
/// 坐标，`msg` 为 WM_* 鼠标消息 ID（如 WM_LBUTTONDOWN），
/// `data` 为滚轮增量或 X 键索引，`injected` 标记合成
/// 事件。
/// </summary>
delegate bool MouseHookCallback(int x, int y, int msg, int data, bool injected);

#if WINDOWS
/// 原生低级钩子过程（WINAPI 调用约定）。
delegate nint HookProc(int code, nint wp, nint lp);
#endif

/// <summary>
/// 全局低级键盘/鼠标钩子（WH_KEYBOARD_LL / WH_MOUSE_LL）。
/// 由专用后台线程安装钩子并运行 GetMessage
/// 循环，操作系统在此分发低级钩子回调；
/// 回调即运行在该线程上。回调返回 true 可吞掉
/// 事件（例如不应同时送达当前活动应用的热键）。
///
/// 同一时刻只能安装一个钩子（键盘或鼠标）；需先
/// Uninstall 后再安装另一个。回调是普通静态方法——
/// delegate 无法捕获状态，因此请将回调数据保存在静态
/// 字段中，与 Thread.Start 工作线程的做法相同。
///
/// 非 Windows 版本暴露相同 API 并抛出
/// PlatformNotSupportedException。
/// </summary>
class Hook {
    #if WINDOWS
    [DllImport("user32", EntryPoint = "SetWindowsHookExW")]
    static extern nint SetWindowsHookExW(int idHook, HookProc lpfn, nint hmod,
                                         int dwThreadId);

    [DllImport("user32", EntryPoint = "UnhookWindowsHookEx")]
    static extern int UnhookWindowsHookEx(nint hhk);

    [DllImport("user32", EntryPoint = "CallNextHookEx")]
    static extern nint CallNextHookEx(nint hhk, int code, nint wp, nint lp);

    [DllImport("user32", EntryPoint = "GetMessageW")]
    static extern int GetMessageW(nint msg, nint hwnd, int min, int max);

    [DllImport("user32", EntryPoint = "PostThreadMessageW")]
    static extern int PostThreadMessageW(int threadId, int msg, nint wp, nint lp);

    [DllImport("kernel32", EntryPoint = "GetCurrentThreadId")]
    static extern int GetCurrentThreadId();

    /// 原生 hook proc。存放在静态字段中，确保 ARC 在 user32 仍持有其地址期间不会释放该
    /// delegate。
    static HookProc hookProc;

    static nint hookHandle;
    static int hookKind;       // 13 = 键盘，14 = 鼠标
    static int hookThreadId;
    static int wantUnhook;
    static int threadFailed;

    static KeyboardHookCallback keyboardCb;
    static MouseHookCallback mouseCb;
    #endif

    #if LINUX || MACOS
    [DllImport("zan_gui", EntryPoint = "zan_hook_install")]
    static extern int NativeHookInstall(int kind);

    [DllImport("zan_gui", EntryPoint = "zan_hook_uninstall")]
    static extern int NativeHookUninstall();

    [DllImport("zan_gui", EntryPoint = "zan_hook_next_event")]
    static extern int NativeHookNextEvent(int timeoutMs, nint p1, nint p2, nint p3, nint p4, nint p5);

    static int posixLive = 0;
    static int posixPumpStop = 0;
    static KeyboardHookCallback posixKeyboardCb;
    static MouseHookCallback posixMouseCb;
    static int posixKind = 0;

    static bool PosixInstall(int kind, KeyboardHookCallback kcb, MouseHookCallback mcb) {
        if (Hook.posixLive != 0) { return false; }
        Hook.posixKeyboardCb = kcb;
        Hook.posixMouseCb = mcb;
        Hook.posixKind = kind;
        if (Hook.NativeHookInstall(kind) == 0) {
            Hook.posixKeyboardCb = null;
            Hook.posixMouseCb = null;
            return false;
        }
        Hook.posixLive = 1;
        Hook.posixPumpStop = 0;
        Thread.Start(Hook.PosixPumpEntry);
        return true;
    }

    static void PosixPumpEntry() {
        nint buf = NativeMemory.Alloc(20);
        try {
            while (Hook.posixLive != 0) {
                int got = Hook.NativeHookNextEvent(100, buf, buf + 4, buf + 8, buf + 12, buf + 16);
                if (got == 0) { continue; }
                Span<int> sp = new Span<int>(buf, 5);
                int p1 = sp[0];
                int p2 = sp[1];
                int p3 = sp[2];
                int p4 = sp[3];
                int p5 = sp[4];
                if (p1 == -1) { break; }
                if (Hook.posixKind == 13 && Hook.posixKeyboardCb != null) {
                    Hook.posixKeyboardCb(p1, p2, p3, p4 != 0, p5 != 0);
                } else if (Hook.posixKind == 14 && Hook.posixMouseCb != null) {
                    Hook.posixMouseCb(p1, p2, p3, p4, p5 != 0);
                }
            }
        } finally {
            NativeMemory.Free(buf);
            Hook.posixPumpStop = 1;
        }
    }
    #endif

    /// <summary>安装低级键盘钩子。钩子已
    /// 生效时返回 true；若已有钩子安装则返回 false。</summary>
    static bool InstallKeyboard(KeyboardHookCallback cb) {
        #if WINDOWS
        return Hook.Install(13, cb, null);
        #elif LINUX || MACOS
        return Hook.PosixInstall(13, cb, null);
        #else
        return false;
        #endif
    }

    /// <summary>安装低级鼠标钩子。钩子已
    /// 生效时返回 true；若已有钩子安装则返回 false。</summary>
    static bool InstallMouse(MouseHookCallback cb) {
        #if WINDOWS
        return Hook.Install(14, null, cb);
        #elif LINUX || MACOS
        return Hook.PosixInstall(14, null, cb);
        #else
        return false;
        #endif
    }

    /// <summary>卸载钩子并等待钩子线程结束；
    /// 未安装任何钩子时调用也安全。</summary>
    static void Uninstall() {
        #if WINDOWS
        if (Hook.hookHandle == 0) { return; }
        Hook.wantUnhook = 1;
        // 唤醒 GetMessage 循环；线程自行卸载钩子并退出。
        Hook.PostThreadMessageW(Hook.hookThreadId, 0x0012 /*WM_QUIT*/, 0, 0);
        for (int waited = 0; Hook.hookHandle != 0 && waited < 500; waited = waited + 1) {
            Thread.Sleep(1);
        }
        Hook.wantUnhook = 0;
        Hook.keyboardCb = null;
        Hook.mouseCb = null;
        #elif LINUX || MACOS
        if (Hook.posixLive == 0) { return; }
        Hook.NativeHookUninstall();
        for (int waited = 0; Hook.posixPumpStop == 0 && waited < 500; waited = waited + 1) {
            Thread.Sleep(1);
        }
        Hook.posixLive = 0;
        Hook.posixKeyboardCb = null;
        Hook.posixMouseCb = null;
        #endif
    }

    /// <summary>异步卸载钩子并等待钩子线程结束（协程驱动，非阻塞等待）。</summary>
    static async Task UninstallAsync() {
        #if WINDOWS
        if (Hook.hookHandle == 0) { return; }
        Hook.wantUnhook = 1;
        Hook.PostThreadMessageW(Hook.hookThreadId, 0x0012 /*WM_QUIT*/, 0, 0);
        int waited = 0;
        while (Hook.hookHandle != 0 && waited < 2000) {
            await Task.Delay(10);
            waited = waited + 10;
        }
        Hook.wantUnhook = 0;
        Hook.keyboardCb = null;
        Hook.mouseCb = null;
        #elif LINUX || MACOS
        if (Hook.posixLive == 0) { return; }
        Hook.NativeHookUninstall();
        int waited = 0;
        while (Hook.posixPumpStop == 0 && waited < 2000) {
            await Task.Delay(10);
            waited = waited + 10;
        }
        Hook.posixLive = 0;
        Hook.posixKeyboardCb = null;
        Hook.posixMouseCb = null;
        #endif
    }

    #if WINDOWS
    /// 异步安装 `kind` 类型钩子（协程驱动，非阻塞等待）。
    static async Task<bool> InstallAsync(int kind, KeyboardHookCallback kcb, MouseHookCallback mcb) {
        if (Hook.hookHandle != 0) { return false; }
        Hook.keyboardCb = kcb;
        Hook.mouseCb = mcb;
        Hook.hookKind = kind;
        Hook.wantUnhook = 0;
        Hook.threadFailed = 0;
        Thread.Start(Hook.HookThreadEntry);
        int waited = 0;
        while (Hook.hookHandle == 0 && Hook.threadFailed == 0 && waited < 2000) {
            await Task.Delay(10);
            waited = waited + 10;
        }
        if (Hook.hookHandle == 0) {
            Hook.keyboardCb = null;
            Hook.mouseCb = null;
            return false;
        }
        return true;
    }

    /// 安装 `kind` 类型钩子（13 = WH_KEYBOARD_LL，14 = WH_MOUSE_LL）；
    /// 已有钩子或超时未安装成功返回 false。
    static bool Install(int kind, KeyboardHookCallback kcb, MouseHookCallback mcb) {
        if (Hook.hookHandle != 0) { return false; }
        Hook.keyboardCb = kcb;
        Hook.mouseCb = mcb;
        Hook.hookKind = kind;
        Hook.wantUnhook = 0;
        Hook.threadFailed = 0;
        Thread.Start(Hook.HookThreadEntry);
        // 等待钩子生效（或线程安装失败）。
        for (int waited = 0; Hook.hookHandle == 0 && Hook.threadFailed == 0 && waited < 500; waited = waited + 1) {
            Thread.Sleep(1);
        }
        if (Hook.hookHandle == 0) {
            Hook.keyboardCb = null;
            Hook.mouseCb = null;
            return false;
        }
        return true;
    }

    /// 运行在钩子线程上：安装后一直泵取 GetMessage。
    static void HookThreadEntry() {
        int kind = Hook.hookKind;
        int tid = Hook.GetCurrentThreadId();
        Hook.hookThreadId = tid;
        Hook.hookProc = Hook.HookProcImpl;
        nint h = Hook.SetWindowsHookExW(kind, Hook.hookProc, 0, 0);
        if (h == 0) {
            Hook.threadFailed = 1;
            return;
        }
        Hook.hookHandle = h;
        nint msg = NativeMemory.Alloc(64);
        try {
            while (Hook.wantUnhook == 0) {
                int r = Hook.GetMessageW(msg, 0, 0, 0);
                if (r <= 0) { break; }
                // 低级钩子回调在 GetMessage 内部触发；无需再分发其他内容
                // （低级钩子看到事件时，事件还没进入目标
                // 窗口的消息队列）。
            }
        } finally {
            NativeMemory.Free(msg);
            Hook.UnhookWindowsHookEx(h);
            Hook.hookHandle = 0;
        }
    }

    /// 由操作系统调用的 hook proc（运行在钩子线程上）。
    static nint HookProcImpl(int code, nint wp, nint lp) {
        if (code >= 0) {
            if (Hook.hookKind == 13 && Hook.keyboardCb != null) {
                // KBDLLHOOKSTRUCT（x64）：vkCode、scanCode、flags、time、extra。
                Span<int> k = new Span<int>(lp, 6);
                int vk = k[0];
                int scan = k[1];
                int flags = k[2];
                bool injected = (flags & 0x10) != 0;   // LLKHF_INJECTED
                bool up = (flags & 0x80) != 0;         // LLKHF_UP
                if (Hook.keyboardCb(vk, scan, flags, injected, up)) {
                    return (nint)1;   // 吞掉事件
                }
            } else if (Hook.hookKind == 14 && Hook.mouseCb != null) {
                // MSLLHOOKSTRUCT（x64）：pt.x、pt.y、mouseData、flags、time、
                // extra。
                Span<int> m = new Span<int>(lp, 8);
                int x = m[0];
                int y = m[1];
                int data = m[2];
                int flags = m[3];
                bool injected = (flags & 0x01) != 0;   // LLMHF_INJECTED
                if (Hook.mouseCb(x, y, (int)wp, data, injected)) {
                    return (nint)1;
                }
            }
        }
        return Hook.CallNextHookEx(0, code, wp, lp);
    }
    #endif
}
