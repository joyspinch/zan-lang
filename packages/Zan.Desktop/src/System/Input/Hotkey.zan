using System;
using System.Threading;

namespace System.Input;

// 注册的组合键
// 按下时，在热键线程上调用。
public delegate void HotkeyCallback();

// 通过 RegisterHotKey 实现全局热键。后台线程注册
// 组合键（hwnd = 0，因此 WM_HOTKEY 消息会投递到该线程的队列），
// 并泵取 GetMessage；回调在该线程上运行。
// ...
// Hotkey.Unregister();
// 组合键语法：修饰键用 '+' 连接，后跟一个来自
// <see cref="Keyboard.VK"/> 的键名（不区分大小写），如 "Ctrl+Alt+F2"、
// "Shift+Esc"。同一时刻只能有一个热键生效；注册另一个之前先 Unregister。
// 回调必须是静态方法（不能捕获状态）。
// 非 Windows 版本暴露相同 API 并抛出
// 跨平台原生实现。
public class Hotkey {
    // Register(int, int, ...) 接受的修饰键位 MOD_ALT(0x0001)。
    public static int ModAlt() { return 0x0001; }
    // 修饰键位 MOD_CONTROL(0x0002)。
    public static int ModCtrl() { return 0x0002; }
    // 修饰键位 MOD_SHIFT(0x0004)。
    public static int ModShift() { return 0x0004; }
    // 修饰键位 MOD_WIN(0x0008)。
    public static int ModWin() { return 0x0008; }

    #if WINDOWS
    [DllImport("user32", EntryPoint = "RegisterHotKey")]
    private static extern int RegisterHotKey(nint hwnd, int id, int mods, int vk);

    [DllImport("user32", EntryPoint = "UnregisterHotKey")]
    private static extern int UnregisterHotKey(nint hwnd, int id);

    [DllImport("user32", EntryPoint = "GetMessageW")]
    private static extern int GetMessageW(nint msg, nint hwnd, int min, int max);

    [DllImport("user32", EntryPoint = "PostThreadMessageW")]
    private static extern int PostThreadMessageW(int threadId, int msg, nint wp, nint lp);

    [DllImport("kernel32", EntryPoint = "GetCurrentThreadId")]
    private static extern int GetCurrentThreadId();

    static int hotkeyId;
    static int hotkeyMods;
    static int hotkeyVk;
    static int hotkeyThreadId;
    static int registered;
    static int wantExit;
    static int threadFailed;
    static HotkeyCallback callback;
    #elif LINUX || MACOS
    [DllImport("zan_gui", EntryPoint = "zan_hotkey_register")]
    private static extern int NativeRegister(int id, int mods, int vk);

    [DllImport("zan_gui", EntryPoint = "zan_hotkey_unregister")]
    private static extern int NativeUnregister(int id);

    [DllImport("zan_gui", EntryPoint = "zan_hotkey_next_event")]
    private static extern int NativeNextEvent(int timeoutMs);

    static int hotkeyId;
    static int hotkeyMods;
    static int hotkeyVk;
    static int registered;
    static int wantExit;
    static int threadFailed;
    static HotkeyCallback callback;
    #endif

    // 从 "Ctrl+Shift+A" 形式的组合键注册热键。组合键生效时
    // 返回 true；已注册其他热键或组合键格式错误
    // （或已被其他程序占用）时返回 false。
    public static bool Register(string combo, HotkeyCallback cb) {
        int mods = 0;
        string rest = combo;
        int plus = Hotkey.IndexOf(rest, "+", 0);
        while (plus >= 0) {
            string seg = rest.Substring(0, plus);
            rest = rest.Substring(plus + 1, rest.Length - plus - 1);
            string up = seg.ToUpper();
            if (up == "CTRL" || up == "CONTROL") { mods = mods | 2; }
            else if (up == "SHIFT") { mods = mods | 4; }
            else if (up == "ALT") { mods = mods | 1; }
            else if (up == "WIN" || up == "META") { mods = mods | 8; }
            else { return false; }  // 修饰键段必须是修饰键
            plus = Hotkey.IndexOf(rest, "+", 0);
        }
        int vk = Keyboard.VK(rest);
        if (vk == 0) { return false; }
        return Hotkey.Register(vk, mods, cb);
    }

    // 异步注册全局热键（协程驱动，非阻塞等待）。
    public static async Task<bool> RegisterAsync(int vk, int mods, HotkeyCallback cb) {
        #if WINDOWS
        if (Hotkey.registered != 0) { return false; }
        Hotkey.callback = cb;
        Hotkey.hotkeyVk = vk;
        Hotkey.hotkeyMods = mods;
        Hotkey.wantExit = 0;
        Hotkey.threadFailed = 0;
        Thread.Start(Hotkey.HotkeyThreadEntry);
        int waited = 0;
        while (Hotkey.registered == 0 && Hotkey.threadFailed == 0 && waited < 2000) {
            await Task.Delay(10);
            waited = waited + 10;
        }
        if (Hotkey.registered == 0) {
            Hotkey.callback = null;
            return false;
        }
        return true;
        #elif LINUX || MACOS
        if (Hotkey.registered != 0) { return false; }
        Hotkey.callback = cb;
        Hotkey.hotkeyVk = vk;
        Hotkey.hotkeyMods = mods;
        Hotkey.wantExit = 0;
        Hotkey.threadFailed = 0;
        Thread.Start(Hotkey.PosixHotkeyThreadEntry);
        int waited = 0;
        while (Hotkey.registered == 0 && Hotkey.threadFailed == 0 && waited < 2000) {
            await Task.Delay(10);
            waited = waited + 10;
        }
        if (Hotkey.registered == 0) {
            Hotkey.callback = null;
            return false;
        }
        return true;
        #else
        return Hotkey.Register(vk, mods, cb);
        #endif
    }

    // 从 VK 码和修饰键位注册热键（参见
    // <see cref="ModCtrl"/> 等）。组合键生效时返回 true。
    public static bool Register(int vk, int mods, HotkeyCallback cb) {
        #if WINDOWS
        if (Hotkey.registered != 0) { return false; }
        Hotkey.callback = cb;
        Hotkey.hotkeyVk = vk;
        Hotkey.hotkeyMods = mods;
        Hotkey.wantExit = 0;
        Hotkey.threadFailed = 0;
        Thread.Start(Hotkey.HotkeyThreadEntry);
        for (int waited = 0; Hotkey.registered == 0 && Hotkey.threadFailed == 0
               && waited < 500; waited = waited + 1) {
            Thread.Sleep(1);
        }
        if (Hotkey.registered == 0) {
            Hotkey.callback = null;
            return false;  // 组合键已被其他程序占用
        }
        return true;
        #elif LINUX || MACOS
        if (Hotkey.registered != 0) { return false; }
        Hotkey.callback = cb;
        Hotkey.hotkeyVk = vk;
        Hotkey.hotkeyMods = mods;
        Hotkey.wantExit = 0;
        Hotkey.threadFailed = 0;
        Thread.Start(Hotkey.PosixHotkeyThreadEntry);
        for (int waited = 0; Hotkey.registered == 0 && Hotkey.threadFailed == 0
               && waited < 500; waited = waited + 1) {
            Thread.Sleep(1);
        }
        if (Hotkey.registered == 0) {
            Hotkey.callback = null;
            return false;
        }
        return true;
        #else
        return false;
        #endif
    }

    // 注销当前生效的热键并等待其线程退出；
    // 未注册任何热键时调用也安全。
    public static void Unregister() {
        #if WINDOWS
        if (Hotkey.registered == 0) { return; }
        Hotkey.wantExit = 1;
        Hotkey.PostThreadMessageW(Hotkey.hotkeyThreadId, 0x0012 /*WM_QUIT*/,
                                  0, 0);
        for (int waited = 0; Hotkey.registered != 0 && waited < 500; waited = waited + 1) {
            Thread.Sleep(1);
        }
        Hotkey.wantExit = 0;
        Hotkey.callback = null;
        #elif LINUX || MACOS
        if (Hotkey.registered == 0) { return; }
        Hotkey.wantExit = 1;
        Hotkey.NativeUnregister(Hotkey.hotkeyId);
        for (int waited = 0; Hotkey.registered != 0 && waited < 500; waited = waited + 1) {
            Thread.Sleep(1);
        }
        Hotkey.wantExit = 0;
        Hotkey.callback = null;
        #else
        return;
        #endif
    }

    // 异步注销当前生效的热键并等待其线程退出（协程驱动，非阻塞等待）。
    public static async Task UnregisterAsync() {
        #if WINDOWS
        if (Hotkey.registered == 0) { return; }
        Hotkey.wantExit = 1;
        Hotkey.PostThreadMessageW(Hotkey.hotkeyThreadId, 0x0012 /*WM_QUIT*/,
                                  0, 0);
        int waited = 0;
        while (Hotkey.registered != 0 && waited < 2000) {
            await Task.Delay(10);
            waited = waited + 10;
        }
        Hotkey.wantExit = 0;
        Hotkey.callback = null;
        #elif LINUX || MACOS
        if (Hotkey.registered == 0) { return; }
        Hotkey.wantExit = 1;
        Hotkey.NativeUnregister(Hotkey.hotkeyId);
        int waited = 0;
        while (Hotkey.registered != 0 && waited < 2000) {
            await Task.Delay(10);
            waited = waited + 10;
        }
        Hotkey.wantExit = 0;
        Hotkey.callback = null;
        #else
        return Task.CompletedTask;
        #endif
    }

    #if WINDOWS
    // 运行在热键线程上：注册后泵取消息，直到 WM_HOTKEY 触发
    // 回调；退出时注销热键。
    private static void HotkeyThreadEntry() {
        Hotkey.hotkeyThreadId = Hotkey.GetCurrentThreadId();
        int id = 0x5A4E;  // 此热键槽位的任意应用 ID
        Hotkey.hotkeyId = id;
        if (Hotkey.RegisterHotKey(0, id, Hotkey.hotkeyMods, Hotkey.hotkeyVk)
                == 0) {
            Hotkey.threadFailed = 1;
            return;
        }
        Hotkey.registered = 1;
        nint msg = NativeMemory.Alloc(64);
        try {
            while (Hotkey.wantExit == 0) {
                int r = Hotkey.GetMessageW(msg, 0, 0, 0);
                if (r <= 0) { break; }
                // Span<int> 索引 2 是消息 ID。
                Span<int> m = new Span<int>(msg, 16);
                if (m[2] == 0x0312 /*WM_HOTKEY*/) {
                    if (Hotkey.callback != null) { Hotkey.callback(); }
                }
            }
        } finally {
            NativeMemory.Free(msg);
            Hotkey.UnregisterHotKey(0, Hotkey.hotkeyId);
            Hotkey.registered = 0;
        }
    }

    // `needle` 在 `hay` 中从 `from` 起的第一个索引，找不到返回 -1。
    private static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }
    #elif LINUX || MACOS
    private static void PosixHotkeyThreadEntry() {
        int id = 0x5A4E;
        Hotkey.hotkeyId = id;
        if (Hotkey.NativeRegister(id, Hotkey.hotkeyMods, Hotkey.hotkeyVk) == 0) {
            Hotkey.threadFailed = 1;
            return;
        }
        Hotkey.registered = 1;
        try {
            while (Hotkey.wantExit == 0) {
                int ev = Hotkey.NativeNextEvent(100);
                if (ev == id) {
                    if (Hotkey.callback != null) { Hotkey.callback(); }
                } else if (ev < 0) {
                    break;
                }
            }
        } finally {
            Hotkey.NativeUnregister(Hotkey.hotkeyId);
            Hotkey.registered = 0;
        }
    }

    // `needle` 在 `hay` 中从 `from` 起的第一个索引，找不到返回 -1。
    private static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }
    #endif
}
