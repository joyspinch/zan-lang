using System;
using System.Collections.Generic;

namespace System.Windows;

// 桌面天气联动枚举。
public enum DesktopWeatherKind {
    Sunny = 0,
    Rainy = 1,
    Snowy = 2,
    Windy = 3
}

// 天气驱动的伴侣穿搭与情绪建议结果。
public class WeatherOutfitAdvice {
    public string OutfitTag;
    public bool CarryUmbrella;
    public string MoodTag;

    public WeatherOutfitAdvice(string outfitTag, bool carryUmbrella, string moodTag) {
        this.OutfitTag = outfitTag;
        this.CarryUmbrella = carryUmbrella;
        this.MoodTag = moodTag;
    }
}

// 桌面伴侣天气感知穿搭与情绪适配器：按天气与实时温度推荐换装、雨具道具与交互语态。
public class CompanionWeatherMoodAdapter {
    public WeatherOutfitAdvice Advise(DesktopWeatherKind weather, int temperatureC) {
        if (weather == DesktopWeatherKind.Rainy) {
            string outfit = temperatureC < 14 ? "raincoat_warm" : "raincoat_light";
            return new WeatherOutfitAdvice(outfit, true, "cozy");
        }
        if (weather == DesktopWeatherKind.Snowy || temperatureC <= 5) {
            return new WeatherOutfitAdvice("winter_scarf", false, "snug");
        }
        if (temperatureC >= 28) {
            return new WeatherOutfitAdvice("summer_tee", false, "breezy");
        }
        if (weather == DesktopWeatherKind.Windy) {
            return new WeatherOutfitAdvice("windbreaker", false, "alert");
        }
        return new WeatherOutfitAdvice("casual_hoodie", false, "cheerful");
    }
}

// 桌面伴侣成长里程碑规则条目。
public class MilestoneRuleSpec {
    public string MilestoneId;
    public int TargetMinutes;
    public int RewardPoints;
    public bool Unlocked;

    public MilestoneRuleSpec(string milestoneId, int targetMinutes, int rewardPoints) {
        this.MilestoneId = milestoneId;
        this.TargetMinutes = targetMinutes > 0 ? targetMinutes : 30;
        this.RewardPoints = rewardPoints > 0 ? rewardPoints : 10;
        this.Unlocked = false;
    }
}

// 桌面伴侣累计专注里程碑账本：自动按阈值阶梯解锁成就、严格防重复领奖并汇总积分。
public class CompanionDailyMilestoneLedger {
    private List<MilestoneRuleSpec> rules;
    public int TotalFocusMinutes;
    public int TotalRewardPoints;

    public CompanionDailyMilestoneLedger() {
        this.rules = new List<MilestoneRuleSpec>();
        this.TotalFocusMinutes = 0;
        this.TotalRewardPoints = 0;
    }

    public void AddMilestone(string milestoneId, int targetMinutes, int rewardPoints) {
        this.rules.Add(new MilestoneRuleSpec(milestoneId, targetMinutes, rewardPoints));
    }

    // 累加专注分钟并返回本步新解锁的里程碑数量。
    public int RecordFocusMinutes(int minutes) {
        if (minutes <= 0) { return 0; }
        this.TotalFocusMinutes = this.TotalFocusMinutes + minutes;
        int newlyUnlocked = 0;
        for (int i = 0; i < this.rules.Count; i = i + 1) {
            MilestoneRuleSpec r = this.rules[i];
            if (!r.Unlocked && this.TotalFocusMinutes >= r.TargetMinutes) {
                r.Unlocked = true;
                this.TotalRewardPoints = this.TotalRewardPoints + r.RewardPoints;
                newlyUnlocked = newlyUnlocked + 1;
            }
        }
        return newlyUnlocked;
    }

    public int UnlockedCount() {
        int c = 0;
        for (int i = 0; i < this.rules.Count; i = i + 1) {
            if (this.rules[i].Unlocked) { c = c + 1; }
        }
        return c;
    }
}

// 桌面伴侣窗口磁吸对齐器：靠近屏幕四边或宿主窗口标题栏时自动吸附，同时保证永不越出屏幕边界。
public class CompanionWindowSnapMagnet {
    public int ScreenWidth;
    public int ScreenHeight;
    public int SnapThresholdPx;

    public CompanionWindowSnapMagnet(int screenWidth, int screenHeight, int snapThresholdPx) {
        this.ScreenWidth = screenWidth > 320 ? screenWidth : 1920;
        this.ScreenHeight = screenHeight > 240 ? screenHeight : 1080;
        this.SnapThresholdPx = snapThresholdPx > 0 ? snapThresholdPx : 20;
    }

    public void SnapToScreenEdges(int rawX, int rawY, int winW, int winH, out int outX, out int outY) {
        int x = rawX;
        int y = rawY;
        int maxX = this.ScreenWidth - winW;
        int maxY = this.ScreenHeight - winH;
        if (maxX < 0) { maxX = 0; }
        if (maxY < 0) { maxY = 0; }

        if (x < 0) { x = 0; }
        if (x > maxX) { x = maxX; }
        if (y < 0) { y = 0; }
        if (y > maxY) { y = maxY; }

        if (x <= this.SnapThresholdPx) { x = 0; }
        else if ((maxX - x) <= this.SnapThresholdPx) { x = maxX; }

        if (y <= this.SnapThresholdPx) { y = 0; }
        else if ((maxY - y) <= this.SnapThresholdPx) { y = maxY; }

        outX = x;
        outY = y;
    }

    // 当伴侣脚底接近宿主应用窗口标题栏顶部（hostTopY）时自动贴坐到标题栏上沿。
    public bool TrySnapToWindowTop(int rawX, int rawY, int winW, int winH,
                                   int hostLeft, int hostRight, int hostTopY,
                                   out int outX, out int outY) {
        int centerX = rawX + winW / 2;
        int footY = rawY + winH;
        int distY = footY - hostTopY;
        if (distY < 0) { distY = -distY; }
        if (centerX >= hostLeft && centerX <= hostRight && distY <= this.SnapThresholdPx) {
            int snappedY = hostTopY - winH;
            if (snappedY < 0) { snappedY = 0; }
            int sx;
            int sy;
            this.SnapToScreenEdges(rawX, snappedY, winW, winH, out sx, out sy);
            outX = sx;
            outY = snappedY;
            return true;
        }
        this.SnapToScreenEdges(rawX, rawY, winW, winH, out outX, out outY);
        return false;
    }
}
