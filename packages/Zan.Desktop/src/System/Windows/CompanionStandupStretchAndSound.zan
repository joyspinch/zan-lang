using System;
using System.Collections.Generic;

namespace System.Windows;

// 20-20-20 护眼提醒状态。
public enum EyeRestStage {
    Working = 0,
    RestPrompted = 1
}

// 商业桌面伴侣 20-20-20 护眼守护器：每工作 20 分钟提示远眺 20 秒，支持有限次延迟（防无限拖延）。
public class CompanionEyeRest202020Guard {
    public EyeRestStage Stage;
    public int WorkIntervalSec;
    public int RestDurationSec;
    public int SnoozeSec;
    public int MaxSnoozes;
    public int ElapsedWorkSec;
    public int RemainingRestSec;
    public int SnoozesUsed;
    public int CompletedRests;

    public CompanionEyeRest202020Guard(int workIntervalSec, int restDurationSec, int snoozeSec, int maxSnoozes) {
        this.WorkIntervalSec = workIntervalSec > 0 ? workIntervalSec : 1200;
        this.RestDurationSec = restDurationSec > 0 ? restDurationSec : 20;
        this.SnoozeSec = snoozeSec > 0 ? snoozeSec : 300;
        this.MaxSnoozes = maxSnoozes >= 0 ? maxSnoozes : 2;
        this.Stage = EyeRestStage.Working;
        this.ElapsedWorkSec = 0;
        this.RemainingRestSec = 0;
        this.SnoozesUsed = 0;
        this.CompletedRests = 0;
    }

    public void StepSeconds(int dtSec) {
        if (dtSec <= 0) { return; }
        if (this.Stage == EyeRestStage.Working) {
            this.ElapsedWorkSec = this.ElapsedWorkSec + dtSec;
            if (this.ElapsedWorkSec >= this.WorkIntervalSec) {
                this.Stage = EyeRestStage.RestPrompted;
                this.RemainingRestSec = this.RestDurationSec;
            }
        } else {
            this.RemainingRestSec = this.RemainingRestSec - dtSec;
            if (this.RemainingRestSec <= 0) {
                this.CompletedRests = this.CompletedRests + 1;
                this.Stage = EyeRestStage.Working;
                this.ElapsedWorkSec = 0;
                this.RemainingRestSec = 0;
                this.SnoozesUsed = 0;
            }
        }
    }

    public bool TrySnooze() {
        if (this.Stage != EyeRestStage.RestPrompted || this.SnoozesUsed >= this.MaxSnoozes) {
            return false;
        }
        this.SnoozesUsed = this.SnoozesUsed + 1;
        this.Stage = EyeRestStage.Working;
        int back = this.WorkIntervalSec - this.SnoozeSec;
        this.ElapsedWorkSec = back > 0 ? back : 0;
        this.RemainingRestSec = 0;
        return true;
    }
}

// 引导呼吸阶段。
public enum BreathingCadencePhase {
    Inhale = 0,
    HoldIn = 1,
    Exhale = 2,
    HoldOut = 3
}

// 商业桌面伴侣呼吸冥想引导器（方块呼吸 4-4-4-4 / 放松 4-7-8-0 自动步进与循环计数）。
public class CompanionBreathingCadenceGuide {
    public BreathingCadencePhase Phase;
    public int InhaleSec;
    public int HoldInSec;
    public int ExhaleSec;
    public int HoldOutSec;
    public int RemainingSec;
    public int CompletedCycles;

    public CompanionBreathingCadenceGuide(int inhaleSec, int holdInSec, int exhaleSec, int holdOutSec) {
        this.InhaleSec = inhaleSec > 0 ? inhaleSec : 4;
        this.HoldInSec = holdInSec >= 0 ? holdInSec : 4;
        this.ExhaleSec = exhaleSec > 0 ? exhaleSec : 4;
        this.HoldOutSec = holdOutSec >= 0 ? holdOutSec : 4;
        this.Phase = BreathingCadencePhase.Inhale;
        this.RemainingSec = this.InhaleSec;
        this.CompletedCycles = 0;
    }

    public void StepSeconds(int dtSec) {
        if (dtSec <= 0) { return; }
        int left = dtSec;
        while (left > 0) {
            if (left < this.RemainingSec) {
                this.RemainingSec = this.RemainingSec - left;
                left = 0;
            } else {
                left = left - this.RemainingSec;
                this.Advance();
            }
        }
    }

    private void Advance() {
        if (this.Phase == BreathingCadencePhase.Inhale) {
            if (this.HoldInSec > 0) { this.Phase = BreathingCadencePhase.HoldIn; this.RemainingSec = this.HoldInSec; }
            else { this.Phase = BreathingCadencePhase.Exhale; this.RemainingSec = this.ExhaleSec; }
        } else if (this.Phase == BreathingCadencePhase.HoldIn) {
            this.Phase = BreathingCadencePhase.Exhale;
            this.RemainingSec = this.ExhaleSec;
        } else if (this.Phase == BreathingCadencePhase.Exhale) {
            if (this.HoldOutSec > 0) { this.Phase = BreathingCadencePhase.HoldOut; this.RemainingSec = this.HoldOutSec; }
            else {
                this.CompletedCycles = this.CompletedCycles + 1;
                this.Phase = BreathingCadencePhase.Inhale;
                this.RemainingSec = this.InhaleSec;
            }
        } else {
            this.CompletedCycles = this.CompletedCycles + 1;
            this.Phase = BreathingCadencePhase.Inhale;
            this.RemainingSec = this.InhaleSec;
        }
    }
}

// 每日微目标项。
public class MicroGoalItem {
    public string Title;
    public bool Completed;

    public MicroGoalItem(string title) {
        this.Title = title;
        this.Completed = false;
    }
}

// 商业桌面伴侣每日微目标打卡单：完成百分比计算与全达成庆祝触发。
public class CompanionMicroGoalChecklist {
    private List<MicroGoalItem> items;

    public CompanionMicroGoalChecklist() {
        this.items = new List<MicroGoalItem>();
    }

    public int AddGoal(string title) {
        this.items.Add(new MicroGoalItem(title));
        return this.items.Count - 1;
    }

    public bool ToggleGoal(int index) {
        if (index < 0 || index >= this.items.Count) { return false; }
        this.items[index].Completed = !this.items[index].Completed;
        return this.items[index].Completed;
    }

    public int CompletionPercent() {
        if (this.items.Count == 0) { return 0; }
        int done = 0;
        for (int i = 0; i < this.items.Count; i = i + 1) {
            if (this.items[i].Completed) { done = done + 1; }
        }
        return (done * 100) / this.items.Count;
    }

    public bool AllCompletedCelebrationReady() {
        return this.items.Count > 0 && this.CompletionPercent() == 100;
    }
}
