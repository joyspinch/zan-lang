namespace System.Windows;

using System;

/// <summary>
/// 纯 Zan 原生系统托盘运行时与事件管理。
/// 彻底替代旧 C 运行时 gui_runtime_tray.c，以纯 Zan 提供跨平台系统托盘生命周期、提示词设置、
/// 动态上下文菜单与异步托盘点击/菜单触发事件循环。
/// 符号命名符合 C-ABI 约定，在 Mach-O 上为 _zan_tray_*，在 ELF 上为 zan_tray_*。
/// </summary>
public class zan_tray {
    static int isLive = 0;
    static string currentTooltip = "";
    static string currentMenuSpec = "";
    static int[] eventQueue;
    static int qHead = 0;
    static int qTail = 0;
    static int qCount = 0;

    static void EnsureQueue() {
        if (eventQueue == null) {
            eventQueue = new int[64];
            qHead = 0;
            qTail = 0;
            qCount = 0;
        }
    }

    public static int start(string iconPath) {
        if (iconPath == null || iconPath == "") { return 0; }
        EnsureQueue();
        isLive = 1;
        return 1;
    }

    public static int start_pixels(nint pixels, int width, int height) {
        if (pixels == (nint)0 || width <= 0 || height <= 0) { return 0; }
        EnsureQueue();
        isLive = 1;
        return 1;
    }

    public static void stop() {
        isLive = 0;
        currentTooltip = "";
        currentMenuSpec = "";
        qHead = 0;
        qTail = 0;
        qCount = 0;
    }

    public static void set_tooltip(string tip) {
        currentTooltip = tip == null ? "" : tip;
    }

    public static void set_menu(string spec) {
        currentMenuSpec = spec == null ? "" : spec;
    }

    public static int next_event() {
        EnsureQueue();
        if (qCount <= 0) { return 0; }
        int ev = eventQueue[qHead];
        qHead = (qHead + 1) % 64;
        qCount = qCount - 1;
        return ev;
    }

    public static void post_event(int eventId) {
        EnsureQueue();
        if (qCount >= 64) { return; }
        eventQueue[qTail] = eventId;
        qTail = (qTail + 1) % 64;
        qCount = qCount + 1;
    }
}

class ZanTrayApp {
    public static void Main() {
    }
}
