using System;
using System.Collections.Generic;

namespace System.Windows;

// 办公微拉伸动作卡片。
public class StretchExerciseCard {
    public string ExerciseId;
    public int HoldSeconds;

    public StretchExerciseCard(string exerciseId, int holdSeconds) {
        this.ExerciseId = exerciseId;
        this.HoldSeconds = holdSeconds > 0 ? holdSeconds : 30;
    }
}

// 商业桌面伴侣久坐拉伸卡片库：顺序轮换避免连续重复、按动作保持时长计时与每日完成计数。
public class CompanionDeskStretchDeck {
    private List<StretchExerciseCard> cards;
    public int CurrentIndex;
    public int RemainingHoldSec;
    public int CompletedCount;

    public CompanionDeskStretchDeck() {
        this.cards = new List<StretchExerciseCard>();
        this.CurrentIndex = -1;
        this.RemainingHoldSec = 0;
        this.CompletedCount = 0;
    }

    public void AddCard(string exerciseId, int holdSeconds) {
        this.cards.Add(new StretchExerciseCard(exerciseId, holdSeconds));
    }

    public StretchExerciseCard StartNextExercise() {
        if (this.cards.Count == 0) { return null; }
        this.CurrentIndex = (this.CurrentIndex + 1) % this.cards.Count;
        StretchExerciseCard c = this.cards[this.CurrentIndex];
        this.RemainingHoldSec = c.HoldSeconds;
        return c;
    }

    public bool StepHoldSeconds(int dtSec) {
        if (dtSec <= 0 || this.RemainingHoldSec <= 0) { return false; }
        this.RemainingHoldSec = this.RemainingHoldSec - dtSec;
        if (this.RemainingHoldSec <= 0) {
            this.RemainingHoldSec = 0;
            this.CompletedCount = this.CompletedCount + 1;
            return true;
        }
        return false;
    }
}

// 商业桌面伴侣宽容连签追踪器：内置断签保护盾（FreezeShields），单日漏签自动耗盾保连签，超盾则清零重计。
public class CompanionDailyLoginStreak {
    public int CurrentStreak;
    public int BestStreak;
    public int LastActiveDay;
    public int FreezeShields;

    public CompanionDailyLoginStreak(int initialFreezeShields) {
        this.CurrentStreak = 0;
        this.BestStreak = 0;
        this.LastActiveDay = -1;
        this.FreezeShields = initialFreezeShields >= 0 ? initialFreezeShields : 0;
    }

    public int CheckIn(int dayIndex) {
        if (this.LastActiveDay < 0) {
            this.CurrentStreak = 1;
            this.LastActiveDay = dayIndex;
        } else if (dayIndex <= this.LastActiveDay) {
            return this.CurrentStreak; // 同日重复签到不叠加
        } else {
            int gap = dayIndex - this.LastActiveDay;
            if (gap == 1) {
                this.CurrentStreak = this.CurrentStreak + 1;
            } else {
                int missed = gap - 1;
                if (missed <= this.FreezeShields) {
                    this.FreezeShields = this.FreezeShields - missed;
                    this.CurrentStreak = this.CurrentStreak + 1;
                } else {
                    this.CurrentStreak = 1;
                }
            }
            this.LastActiveDay = dayIndex;
        }
        if (this.CurrentStreak > this.BestStreak) {
            this.BestStreak = this.CurrentStreak;
        }
        return this.CurrentStreak;
    }
}

// 商业桌面伴侣整点/半点轻柔报时器：支持跨午夜免打扰时段（如 22:00..07:00）与同分钟防重响。
public class CompanionAmbientClockChime {
    public bool HalfHourEnabled;
    public int QuietStartHour;
    public int QuietEndHour;
    private int lastChimeSlot;

    public CompanionAmbientClockChime(bool halfHourEnabled, int quietStartHour, int quietEndHour) {
        this.HalfHourEnabled = halfHourEnabled;
        this.QuietStartHour = quietStartHour;
        this.QuietEndHour = quietEndHour;
        this.lastChimeSlot = -1;
    }

    public bool IsQuietHour(int hour24) {
        if (this.QuietStartHour == this.QuietEndHour) { return false; }
        if (this.QuietStartHour < this.QuietEndHour) {
            return hour24 >= this.QuietStartHour && hour24 < this.QuietEndHour;
        }
        // 跨午夜免打扰（例如 22..7）
        return hour24 >= this.QuietStartHour || hour24 < this.QuietEndHour;
    }

    // 返回 2=整点报时, 1=半点轻响, 0=静默或本分钟已响过。
    public int PollChime(int hour24, int minute) {
        if (this.IsQuietHour(hour24)) { return 0; }
        int kind = 0;
        if (minute == 0) { kind = 2; }
        else if (minute == 30 && this.HalfHourEnabled) { kind = 1; }
        if (kind == 0) { return 0; }
        int slot = hour24 * 60 + minute;
        if (slot == this.lastChimeSlot) { return 0; }
        this.lastChimeSlot = slot;
        return kind;
    }
}
