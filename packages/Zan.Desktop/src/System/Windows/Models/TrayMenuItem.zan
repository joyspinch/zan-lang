using System;

namespace System.Windows;

// 托盘右键菜单的一项。`id` 是选中时传给回调的编号，
// 必须大于 0（0 是“未选择”）；分隔线用 `TrayMenuItem.Separator()`。
public class TrayMenuItem {
    // 选中时传给回调的编号，必须大于 0。
    public int id;
    // 菜单文本。
    public string text;
    // 置灰（不可选），仍然显示。
    public bool disabled;
    // 左侧勾选标记，用于“开机启动”这类开关项。
    public bool checkMark;
    // 分隔线无文本也不可选中。
    public bool separator;

    // 构造普通菜单项。
    public TrayMenuItem(int itemId, string label) {
        id = itemId;
        text = label;
        disabled = false;
        checkMark = false;
        separator = false;
    }

    // 一条分隔线。
    public static TrayMenuItem Separator() {
        TrayMenuItem it = new TrayMenuItem(0, "");
        it.separator = true;
        return it;
    }

    // 置灰此项（链式）。
    public TrayMenuItem Disabled() { disabled = true; return this; }

    // 勾选此项（链式）。
    public TrayMenuItem Check(bool on) { checkMark = on; return this; }
}
