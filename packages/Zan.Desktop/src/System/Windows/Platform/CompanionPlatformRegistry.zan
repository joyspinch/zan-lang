using System;

namespace System.Windows;

// 桌面伴侣平台适配器单点装配入口（唯一一处按 OperatingSystem 选择平台实现类）。
public static class CompanionPlatformRegistry {
    public static ICompanionPlatformAdapter Current() {
        if (OperatingSystem.IsOhos()) { return new HarmonyOsCompanionPlatform(); }
        if (OperatingSystem.IsMacOS()) { return new MacOsCompanionPlatform(); }
        if (OperatingSystem.IsWindows()) { return new WindowsCompanionPlatform(); }
        return new LinuxCompanionPlatform();
    }
}
