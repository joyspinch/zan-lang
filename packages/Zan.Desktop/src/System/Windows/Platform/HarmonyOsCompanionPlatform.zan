using System;

namespace System.Windows;

// OpenHarmony / HarmonyOS 平台桌面伴侣适配器实现（独立文件，无跨平台分支）。
public class HarmonyOsCompanionPlatform : ICompanionPlatformAdapter {
    public string OsName() { return "ohos"; }
    public string PrimaryModifier() { return "Ctrl"; }
    public string TrayInteraction() { return "DockBadgeCard"; }
    public string AutostartMechanism() { return "OhosAbilityKeepAlive"; }
    public int TopBarInsetPx() { return 36; }
    public int BottomBarInsetPx() { return 48; }
    public bool SupportsBackdropBlur() { return true; }

    public string FormatShortcut(string keyName) {
        return "Ctrl+" + (keyName == null ? "" : keyName);
    }

    public string ResolveStorageDir(string appName, string bucket) {
        string app = (appName == null || appName.Length == 0) ? "ZanCompanion" : appName;
        string b = (bucket == null || bucket.Length == 0) ? "config" : bucket;
        if (b == "cache") { return "/data/storage/el2/base/cache/" + app; }
        return "/data/storage/el2/base/files/" + app + "/" + b;
    }
}
