using System;

namespace System.Windows;

// Linux 桌面平台（X11/Wayland + XDG + StatusNotifierItem）伴侣适配器实现。
public class LinuxCompanionPlatform : ICompanionPlatformAdapter {
    public string OsName() { return "linux"; }
    public string PrimaryModifier() { return "Ctrl"; }
    public string TrayInteraction() { return "StatusNotifierItem"; }
    public string AutostartMechanism() { return "XdgAutostartDesktop"; }
    public int TopBarInsetPx() { return 28; }
    public int BottomBarInsetPx() { return 0; }
    public bool SupportsBackdropBlur() { return false; }

    public string FormatShortcut(string keyName) {
        return "Ctrl+" + (keyName == null ? "" : keyName);
    }

    public string ResolveStorageDir(string appName, string bucket) {
        string app = (appName == null || appName.Length == 0) ? "ZanCompanion" : appName;
        string b = (bucket == null || bucket.Length == 0) ? "config" : bucket;
        if (b == "cache") { return "$XDG_CACHE_HOME/" + app; }
        if (b == "logs") { return "$XDG_STATE_HOME/" + app + "/logs"; }
        return "$XDG_CONFIG_HOME/" + app + "/" + b;
    }
}
