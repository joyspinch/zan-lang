using System;

namespace System.Windows;

// macOS 平台桌面伴侣适配器实现（独立文件，无跨平台分支）。
public class MacOsCompanionPlatform : ICompanionPlatformAdapter {
    public string OsName() { return "macos"; }
    public string PrimaryModifier() { return "Cmd"; }
    public string TrayInteraction() { return "MenuBarPopover"; }
    public string AutostartMechanism() { return "LaunchAgentPlist"; }
    public int TopBarInsetPx() { return 24; }
    public int BottomBarInsetPx() { return 64; }
    public bool SupportsBackdropBlur() { return true; }

    public string FormatShortcut(string keyName) {
        return "Cmd+" + (keyName == null ? "" : keyName);
    }

    public string ResolveStorageDir(string appName, string bucket) {
        string app = (appName == null || appName.Length == 0) ? "ZanCompanion" : appName;
        string b = (bucket == null || bucket.Length == 0) ? "config" : bucket;
        if (b == "cache") { return "~/Library/Caches/" + app; }
        if (b == "logs") { return "~/Library/Logs/" + app; }
        return "~/Library/Application Support/" + app + "/" + b;
    }
}
