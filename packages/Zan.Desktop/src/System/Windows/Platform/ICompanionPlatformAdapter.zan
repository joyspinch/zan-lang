using System;

namespace System.Windows;

// 商业桌面伴侣跨平台 OS 适配器统一接口（各平台独立文件实现，消除业务层 if (os == ...) 堆叠）。
public interface ICompanionPlatformAdapter {
    string OsName();
    string PrimaryModifier();
    string TrayInteraction();
    string AutostartMechanism();
    int TopBarInsetPx();
    int BottomBarInsetPx();
    bool SupportsBackdropBlur();
    string FormatShortcut(string keyName);
    string ResolveStorageDir(string appName, string bucket);
}
