using System;
using System.Collections.Generic;

namespace System.Windows;

public class TrayMenuEntry {
    public string ActionId;
    public string Label;
    public string Shortcut;
    public bool IsSeparator;
    public bool IsCheckable;
    public bool Checked;
    public bool Enabled;
    public int InvokeCount;

    public TrayMenuEntry(string actionId, string label, string shortcut, bool isCheckable, bool isChecked) {
        this.ActionId = actionId == null ? "" : actionId;
        this.Label = label == null ? "" : label;
        this.Shortcut = shortcut == null ? "" : shortcut;
        this.IsSeparator = false;
        this.IsCheckable = isCheckable;
        this.Checked = isChecked;
        this.Enabled = true;
        this.InvokeCount = 0;
    }
}

// 桌面伴侣系统托盘右键菜单模型：支持勾选切换、禁用保护、分隔符与动作触发计数。
public class CompanionTrayMenuModel {
    private List<TrayMenuEntry> items;

    public CompanionTrayMenuModel() {
        this.items = new List<TrayMenuEntry>();
    }

    public void AddCommand(string actionId, string label, string shortcut) {
        this.items.Add(new TrayMenuEntry(actionId, label, shortcut, false, false));
    }

    public void AddToggle(string actionId, string label, bool initialChecked) {
        this.items.Add(new TrayMenuEntry(actionId, label, "", true, initialChecked));
    }

    public void AddSeparator() {
        TrayMenuEntry sep = new TrayMenuEntry("", "", "", false, false);
        sep.IsSeparator = true;
        sep.Enabled = false;
        this.items.Add(sep);
    }

    public bool SetEnabled(string actionId, bool enabled) {
        TrayMenuEntry e = this.Find(actionId);
        if (e == null || e.IsSeparator) { return false; }
        e.Enabled = enabled;
        return true;
    }

    public bool Trigger(string actionId) {
        TrayMenuEntry e = this.Find(actionId);
        if (e == null || e.IsSeparator || !e.Enabled) { return false; }
        if (e.IsCheckable) {
            e.Checked = !e.Checked;
        }
        e.InvokeCount = e.InvokeCount + 1;
        return true;
    }

    public bool IsChecked(string actionId) {
        TrayMenuEntry e = this.Find(actionId);
        return e != null && e.Checked;
    }

    public int InvokeCount(string actionId) {
        TrayMenuEntry e = this.Find(actionId);
        return e == null ? 0 : e.InvokeCount;
    }

    public int ItemCount() {
        return this.items.Count;
    }

    private TrayMenuEntry Find(string actionId) {
        if (actionId == null || actionId == "") { return null; }
        for (int i = 0; i < this.items.Count; i = i + 1) {
            if (!this.items[i].IsSeparator && this.items[i].ActionId == actionId) {
                return this.items[i];
            }
        }
        return null;
    }
}

public class SkinSlotBinding {
    public string SlotName;
    public string CosmeticId;

    public SkinSlotBinding(string slotName, string cosmeticId) {
        this.SlotName = slotName == null ? "" : slotName;
        this.CosmeticId = cosmeticId == null ? "" : cosmeticId;
    }
}

internal class SkinWardrobePreset {
    public string PresetName;
    public List<SkinSlotBinding> Bindings;

    public SkinWardrobePreset(string name) {
        this.PresetName = name == null ? "" : name;
        this.Bindings = new List<SkinSlotBinding>();
    }
}

// 桌面伴侣换装衣柜：支持饰品拥有权解锁校验、多槽位装备与整套预设一键切换。
public class CompanionSkinWardrobe {
    private List<string> ownedCosmetics;
    private List<SkinSlotBinding> equipped;
    private List<SkinWardrobePreset> presets;

    public CompanionSkinWardrobe() {
        this.ownedCosmetics = new List<string>();
        this.equipped = new List<SkinSlotBinding>();
        this.presets = new List<SkinWardrobePreset>();
    }

    public void UnlockCosmetic(string cosmeticId) {
        if (cosmeticId == null || cosmeticId == "") { return; }
        if (this.IsOwned(cosmeticId)) { return; }
        this.ownedCosmetics.Add(cosmeticId);
    }

    public bool IsOwned(string cosmeticId) {
        if (cosmeticId == null || cosmeticId == "") { return false; }
        for (int i = 0; i < this.ownedCosmetics.Count; i = i + 1) {
            if (this.ownedCosmetics[i] == cosmeticId) { return true; }
        }
        return false;
    }

    public bool Equip(string slotName, string cosmeticId) {
        if (slotName == null || slotName == "" || !this.IsOwned(cosmeticId)) { return false; }
        for (int i = 0; i < this.equipped.Count; i = i + 1) {
            if (this.equipped[i].SlotName == slotName) {
                this.equipped[i].CosmeticId = cosmeticId;
                return true;
            }
        }
        this.equipped.Add(new SkinSlotBinding(slotName, cosmeticId));
        return true;
    }

    public string GetEquipped(string slotName) {
        for (int i = 0; i < this.equipped.Count; i = i + 1) {
            if (this.equipped[i].SlotName == slotName) {
                return this.equipped[i].CosmeticId;
            }
        }
        return "";
    }

    public void SavePreset(string presetName) {
        if (presetName == null || presetName == "") { return; }
        SkinWardrobePreset target = null;
        for (int i = 0; i < this.presets.Count; i = i + 1) {
            if (this.presets[i].PresetName == presetName) {
                target = this.presets[i];
                target.Bindings.Clear();
                break;
            }
        }
        if (target == null) {
            target = new SkinWardrobePreset(presetName);
            this.presets.Add(target);
        }
        for (int i = 0; i < this.equipped.Count; i = i + 1) {
            target.Bindings.Add(new SkinSlotBinding(this.equipped[i].SlotName, this.equipped[i].CosmeticId));
        }
    }

    public bool ApplyPreset(string presetName) {
        SkinWardrobePreset target = null;
        for (int i = 0; i < this.presets.Count; i = i + 1) {
            if (this.presets[i].PresetName == presetName) {
                target = this.presets[i];
                break;
            }
        }
        if (target == null) { return false; }
        this.equipped.Clear();
        for (int i = 0; i < target.Bindings.Count; i = i + 1) {
            this.Equip(target.Bindings[i].SlotName, target.Bindings[i].CosmeticId);
        }
        return true;
    }
}

public enum PomoPhaseKind {
    Focus = 0,
    ShortBreak = 1,
    LongBreak = 2
}

// 桌面伴侣商用番茄专注钟：Focus/ShortBreak/LongBreak 自动轮转、暂停恢复、跳过与累计专注统计。
public class CompanionPomodoroClock {
    public int FocusDurationSec;
    public int ShortBreakSec;
    public int LongBreakSec;
    public int CyclesPerLongBreak;

    public PomoPhaseKind Phase;
    public int RemainingSec;
    public bool Paused;
    public int CompletedFocusCycles;
    public int TotalFocusedSec;

    public CompanionPomodoroClock(int focusDurationSec, int shortBreakSec, int longBreakSec, int cyclesPerLongBreak) {
        this.FocusDurationSec = focusDurationSec > 0 ? focusDurationSec : 1500;
        this.ShortBreakSec = shortBreakSec > 0 ? shortBreakSec : 300;
        this.LongBreakSec = longBreakSec > 0 ? longBreakSec : 900;
        this.CyclesPerLongBreak = cyclesPerLongBreak > 0 ? cyclesPerLongBreak : 4;
        this.Phase = PomoPhaseKind.Focus;
        this.RemainingSec = this.FocusDurationSec;
        this.Paused = false;
        this.CompletedFocusCycles = 0;
        this.TotalFocusedSec = 0;
    }

    public void Pause() { this.Paused = true; }
    public void Resume() { this.Paused = false; }

    public int AdvanceSeconds(int dtSec) {
        if (this.Paused || dtSec <= 0) { return 0; }
        int transitions = 0;
        int left = dtSec;
        while (left > 0) {
            if (left < this.RemainingSec) {
                this.RemainingSec = this.RemainingSec - left;
                if (this.Phase == PomoPhaseKind.Focus) {
                    this.TotalFocusedSec = this.TotalFocusedSec + left;
                }
                left = 0;
            } else {
                int step = this.RemainingSec;
                if (this.Phase == PomoPhaseKind.Focus) {
                    this.TotalFocusedSec = this.TotalFocusedSec + step;
                }
                left = left - step;
                this.AdvancePhase();
                transitions = transitions + 1;
            }
        }
        return transitions;
    }

    public void SkipPhase() {
        this.AdvancePhase();
    }

    private void AdvancePhase() {
        if (this.Phase == PomoPhaseKind.Focus) {
            this.CompletedFocusCycles = this.CompletedFocusCycles + 1;
            if ((this.CompletedFocusCycles % this.CyclesPerLongBreak) == 0) {
                this.Phase = PomoPhaseKind.LongBreak;
                this.RemainingSec = this.LongBreakSec;
            } else {
                this.Phase = PomoPhaseKind.ShortBreak;
                this.RemainingSec = this.ShortBreakSec;
            }
        } else {
            this.Phase = PomoPhaseKind.Focus;
            this.RemainingSec = this.FocusDurationSec;
        }
    }
}
