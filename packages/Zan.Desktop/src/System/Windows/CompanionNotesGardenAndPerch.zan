using System;
using System.Collections.Generic;

namespace System.Windows;

// 桌面伴侣轻量便签条目。
public class DeskStickyNote {
    public int NoteId;
    public string Text;
    public string ColorTag;
    public bool Pinned;
    public bool Archived;
    public long UpdatedAtMs;

    public DeskStickyNote(int noteId, string text, string colorTag, long updatedAtMs) {
        this.NoteId = noteId;
        this.Text = text;
        this.ColorTag = colorTag;
        this.Pinned = false;
        this.Archived = false;
        this.UpdatedAtMs = updatedAtMs;
    }
}

// 桌面伴侣便签板管理器：置顶优先排序、归档隐藏、关键词检索与桌面最大展示数控流。
public class CompanionDeskStickyBoard {
    private List<DeskStickyNote> notes;
    private int nextNoteId;
    public int MaxVisibleNotes;

    public CompanionDeskStickyBoard(int maxVisibleNotes) {
        this.notes = new List<DeskStickyNote>();
        this.nextNoteId = 1;
        this.MaxVisibleNotes = maxVisibleNotes > 0 ? maxVisibleNotes : 6;
    }

    public int AddNote(string text, string colorTag, long nowMs) {
        int id = this.nextNoteId;
        this.nextNoteId = this.nextNoteId + 1;
        this.notes.Add(new DeskStickyNote(id, text, colorTag, nowMs));
        return id;
    }

    public DeskStickyNote Find(int noteId) {
        for (int i = 0; i < this.notes.Count; i = i + 1) {
            if (this.notes[i].NoteId == noteId) { return this.notes[i]; }
        }
        return null;
    }

    public bool SetPinned(int noteId, bool pinned, long nowMs) {
        DeskStickyNote n = this.Find(noteId);
        if (n == null) { return false; }
        n.Pinned = pinned;
        n.UpdatedAtMs = nowMs;
        return true;
    }

    public bool SetArchived(int noteId, bool archived) {
        DeskStickyNote n = this.Find(noteId);
        if (n == null) { return false; }
        n.Archived = archived;
        return true;
    }

    // 返回未归档便签：置顶优先，其次按最近更新时间降序，并受 MaxVisibleNotes 截断。
    public List<DeskStickyNote> VisibleNotes() {
        List<DeskStickyNote> active = new List<DeskStickyNote>();
        for (int i = 0; i < this.notes.Count; i = i + 1) {
            if (!this.notes[i].Archived) {
                active.Add(this.notes[i]);
            }
        }
        for (int i = 1; i < active.Count; i = i + 1) {
            DeskStickyNote key = active[i];
            int j = i - 1;
            while (j >= 0 && ShouldPrecede(key, active[j])) {
                active[j + 1] = active[j];
                j = j - 1;
            }
            active[j + 1] = key;
        }
        if (active.Count > this.MaxVisibleNotes) {
            List<DeskStickyNote> trimmed = new List<DeskStickyNote>();
            for (int i = 0; i < this.MaxVisibleNotes; i = i + 1) {
                trimmed.Add(active[i]);
            }
            return trimmed;
        }
        return active;
    }

    public List<DeskStickyNote> FindByColorTag(string colorTag) {
        List<DeskStickyNote> result = new List<DeskStickyNote>();
        for (int i = 0; i < this.notes.Count; i = i + 1) {
            DeskStickyNote n = this.notes[i];
            if (!n.Archived && n.ColorTag == colorTag) {
                result.Add(n);
            }
        }
        return result;
    }

    private static bool ShouldPrecede(DeskStickyNote a, DeskStickyNote b) {
        if (a.Pinned != b.Pinned) { return a.Pinned; }
        if (a.UpdatedAtMs != b.UpdatedAtMs) { return a.UpdatedAtMs > b.UpdatedAtMs; }
        return a.NoteId < b.NoteId;
    }
}

// 桌面放置窗台花盆作物状态。
public enum IdleCropState {
    Empty = 0,
    Growing = 1,
    Mature = 2
}

// 单个放置花盆槽位。
public class IdleCropSlot {
    public int SlotIndex;
    public string SeedId;
    public IdleCropState State;
    public double GrowthProgress; // [0..1]
    public double Moisture;       // [0..1]
    public double RequiredMinutes;

    public IdleCropSlot(int slotIndex) {
        this.SlotIndex = slotIndex;
        this.SeedId = "";
        this.State = IdleCropState.Empty;
        this.GrowthProgress = 0.0;
        this.Moisture = 0.0;
        this.RequiredMinutes = 60.0;
    }
}

// 桌面伴侣放置窗台花盆系统：水分衰减、浇水加速成长、零惩罚不枯萎（防焦虑商业化设计）与一键收获计数。
public class CompanionIdleWindowGarden {
    private List<IdleCropSlot> slots;
    public int TotalHarvested;

    public CompanionIdleWindowGarden(int slotCount) {
        this.slots = new List<IdleCropSlot>();
        int count = slotCount > 0 ? slotCount : 3;
        for (int i = 0; i < count; i = i + 1) {
            this.slots.Add(new IdleCropSlot(i));
        }
        this.TotalHarvested = 0;
    }

    public IdleCropSlot GetSlot(int index) {
        if (index < 0 || index >= this.slots.Count) { return null; }
        return this.slots[index];
    }

    public bool Plant(int slotIndex, string seedId, double requiredMinutes) {
        IdleCropSlot s = this.GetSlot(slotIndex);
        if (s == null || s.State != IdleCropState.Empty) { return false; }
        s.SeedId = seedId;
        s.State = IdleCropState.Growing;
        s.GrowthProgress = 0.0;
        s.Moisture = 1.0;
        s.RequiredMinutes = requiredMinutes > 1.0 ? requiredMinutes : 10.0;
        return true;
    }

    public bool Water(int slotIndex) {
        IdleCropSlot s = this.GetSlot(slotIndex);
        if (s == null || s.State != IdleCropState.Growing) { return false; }
        s.Moisture = 1.0;
        return true;
    }

    // 推进放置时长（分钟）：湿润状态 1.5x 成长倍率，干燥状态保持 0.5x 慢速成长且绝不枯萎。
    public void AdvanceMinutes(double minutes) {
        if (minutes <= 0.0) { return; }
        for (int i = 0; i < this.slots.Count; i = i + 1) {
            IdleCropSlot s = this.slots[i];
            if (s.State != IdleCropState.Growing) { continue; }
            double rate = s.Moisture > 0.2 ? 1.5 : 0.5;
            double delta = (minutes * rate) / s.RequiredMinutes;
            s.GrowthProgress = s.GrowthProgress + delta;
            if (s.GrowthProgress >= 1.0) {
                s.GrowthProgress = 1.0;
                s.State = IdleCropState.Mature;
            }
            s.Moisture = s.Moisture - minutes * 0.015;
            if (s.Moisture < 0.0) { s.Moisture = 0.0; }
        }
    }

    public string Harvest(int slotIndex) {
        IdleCropSlot s = this.GetSlot(slotIndex);
        if (s == null || s.State != IdleCropState.Mature) { return ""; }
        string crop = s.SeedId;
        s.SeedId = "";
        s.State = IdleCropState.Empty;
        s.GrowthProgress = 0.0;
        s.Moisture = 0.0;
        this.TotalHarvested = this.TotalHarvested + 1;
        return crop;
    }
}

// 屏边/任务栏栖息巡逻行为状态。
public enum EdgePerchBehavior {
    Walking = 0,
    Sitting = 1
}

// 桌面伴侣任务栏/屏幕边缘栖息巡逻控制器：巡逻到达边界自动折返、定时坐下休息、分辨率变化安全钳位。
public class CompanionScreenEdgePerch {
    public double PosX;
    public double MinX;
    public double MaxX;
    public double WalkSpeedPxPerSec;
    public int FacingDir; // 1=右, -1=左
    public EdgePerchBehavior Behavior;
    public double StateTimerSec;
    public double WalkBurstSec;
    public double SitRestSec;

    public CompanionScreenEdgePerch(double minX, double maxX, double startX, double speedPxPerSec) {
        this.MinX = minX;
        this.MaxX = maxX > minX ? maxX : minX + 100.0;
        this.PosX = ClampX(startX, this.MinX, this.MaxX);
        this.WalkSpeedPxPerSec = speedPxPerSec > 1.0 ? speedPxPerSec : 60.0;
        this.FacingDir = 1;
        this.Behavior = EdgePerchBehavior.Walking;
        this.StateTimerSec = 0.0;
        this.WalkBurstSec = 4.0;
        this.SitRestSec = 2.0;
    }

    public void UpdateBounds(double minX, double maxX) {
        this.MinX = minX;
        this.MaxX = maxX > minX ? maxX : minX + 100.0;
        this.PosX = ClampX(this.PosX, this.MinX, this.MaxX);
    }

    public void Step(double dtSec) {
        if (dtSec <= 0.0) { return; }
        this.StateTimerSec = this.StateTimerSec + dtSec;
        if (this.Behavior == EdgePerchBehavior.Walking) {
            this.PosX = this.PosX + (double)this.FacingDir * this.WalkSpeedPxPerSec * dtSec;
            if (this.PosX >= this.MaxX) {
                this.PosX = this.MaxX;
                this.FacingDir = -1;
            } else if (this.PosX <= this.MinX) {
                this.PosX = this.MinX;
                this.FacingDir = 1;
            }
            if (this.StateTimerSec >= this.WalkBurstSec) {
                this.Behavior = EdgePerchBehavior.Sitting;
                this.StateTimerSec = 0.0;
            }
        } else {
            if (this.StateTimerSec >= this.SitRestSec) {
                this.Behavior = EdgePerchBehavior.Walking;
                this.StateTimerSec = 0.0;
            }
        }
    }

    private static double ClampX(double x, double lo, double hi) {
        if (x < lo) { return lo; }
        if (x > hi) { return hi; }
        return x;
    }
}
