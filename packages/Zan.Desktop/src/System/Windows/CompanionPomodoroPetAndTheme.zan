using System;

namespace System.Windows;

// 番茄钟当前所处阶段。
public enum PomodoroCycleStage {
    Focus = 0,
    ShortBreak = 1,
    LongBreak = 2
}

// 商业桌面伴侣 4 轮番茄钟引擎：专注/短休/大休自动流转、暂停恢复与累计专注分钟统计。
public class CompanionPomodoroCycleEngine {
    public PomodoroCycleStage Phase;
    public int FocusMinutes;
    public int ShortBreakMinutes;
    public int LongBreakMinutes;
    public int CyclesPerLongBreak;
    public int RemainingSeconds;
    public int CompletedFocusCycles;
    public int TotalFocusMinutes;
    public bool Paused;

    public CompanionPomodoroCycleEngine(int focusMin, int shortBreakMin, int longBreakMin, int cyclesPerLong) {
        this.FocusMinutes = focusMin > 0 ? focusMin : 25;
        this.ShortBreakMinutes = shortBreakMin > 0 ? shortBreakMin : 5;
        this.LongBreakMinutes = longBreakMin > 0 ? longBreakMin : 15;
        this.CyclesPerLongBreak = cyclesPerLong > 1 ? cyclesPerLong : 4;
        this.Phase = PomodoroCycleStage.Focus;
        this.RemainingSeconds = this.FocusMinutes * 60;
        this.CompletedFocusCycles = 0;
        this.TotalFocusMinutes = 0;
        this.Paused = false;
    }

    public void TogglePause() { this.Paused = !this.Paused; }

    public void StepSeconds(int dtSec) {
        if (this.Paused || dtSec <= 0) { return; }
        int left = dtSec;
        while (left > 0) {
            if (left < this.RemainingSeconds) {
                this.RemainingSeconds = this.RemainingSeconds - left;
                left = 0;
            } else {
                left = left - this.RemainingSeconds;
                this.AdvancePhase();
            }
        }
    }

    private void AdvancePhase() {
        if (this.Phase == PomodoroCycleStage.Focus) {
            this.CompletedFocusCycles = this.CompletedFocusCycles + 1;
            this.TotalFocusMinutes = this.TotalFocusMinutes + this.FocusMinutes;
            if ((this.CompletedFocusCycles % this.CyclesPerLongBreak) == 0) {
                this.Phase = PomodoroCycleStage.LongBreak;
                this.RemainingSeconds = this.LongBreakMinutes * 60;
            } else {
                this.Phase = PomodoroCycleStage.ShortBreak;
                this.RemainingSeconds = this.ShortBreakMinutes * 60;
            }
        } else {
            this.Phase = PomodoroCycleStage.Focus;
            this.RemainingSeconds = this.FocusMinutes * 60;
        }
    }
}

// 桌宠亲密度羁绊等级。
public enum PetBondTier {
    Stranger = 0,
    Buddy = 1,
    CloseFriend = 2,
    Soulmate = 3
}

// 商业桌面伴侣桌宠亲密度羁绊系统：抚摸冷却防刷、喂食心情恢复与羁绊升级判定。
public class CompanionPetAffectionBond {
    public int BondXp;
    public int MoodPercent;
    public long PatCooldownMs;
    public long LastPatMs;

    public CompanionPetAffectionBond(long patCooldownMs) {
        this.BondXp = 0;
        this.MoodPercent = 60;
        this.PatCooldownMs = patCooldownMs > 0L ? patCooldownMs : 30000L;
        this.LastPatMs = -1000000L;
    }

    public bool TryPat(long nowMs) {
        if ((nowMs - this.LastPatMs) < this.PatCooldownMs) { return false; }
        this.LastPatMs = nowMs;
        this.BondXp = this.BondXp + 25;
        this.MoodPercent = this.MoodPercent + 10;
        if (this.MoodPercent > 100) { this.MoodPercent = 100; }
        return true;
    }

    public void FeedTreat(int moodBoost, int xpBoost) {
        if (moodBoost > 0) {
            this.MoodPercent = this.MoodPercent + moodBoost;
            if (this.MoodPercent > 100) { this.MoodPercent = 100; }
        }
        if (xpBoost > 0) {
            this.BondXp = this.BondXp + xpBoost;
        }
    }

    public PetBondTier CurrentTier() {
        if (this.BondXp >= 300) { return PetBondTier.Soulmate; }
        if (this.BondXp >= 150) { return PetBondTier.CloseFriend; }
        if (this.BondXp >= 50) { return PetBondTier.Buddy; }
        return PetBondTier.Stranger;
    }
}

// 昼夜节律主题档位。
public enum CircadianThemeMode {
    Dawn = 0,
    Daylight = 1,
    Sunset = 2,
    Midnight = 3
}

// 商业桌面伴侣昼夜节律自动配色路由：按本地小时自动切换视觉主题，支持用户手动锁定覆盖与恢复自动。
public class CompanionCircadianThemeRouter {
    public bool ManualOverride;
    public CircadianThemeMode PinnedMode;

    public CompanionCircadianThemeRouter() {
        this.ManualOverride = false;
        this.PinnedMode = CircadianThemeMode.Daylight;
    }

    public void PinTheme(CircadianThemeMode mode) {
        this.ManualOverride = true;
        this.PinnedMode = mode;
    }

    public void ResumeAuto() {
        this.ManualOverride = false;
    }

    public CircadianThemeMode ResolveForHour(int hour24) {
        if (this.ManualOverride) { return this.PinnedMode; }
        int h = hour24 % 24;
        if (h < 0) { h = h + 24; }
        if (h >= 5 && h < 9) { return CircadianThemeMode.Dawn; }
        if (h >= 9 && h < 17) { return CircadianThemeMode.Daylight; }
        if (h >= 17 && h < 21) { return CircadianThemeMode.Sunset; }
        return CircadianThemeMode.Midnight;
    }
}
