using System;
using System.Collections.Generic;

namespace System.Windows;

// 桌面边缘停靠方位。
public enum DockEdge {
    None = 0,
    Left = 1,
    Right = 2,
    Top = 3,
    Bottom = 4
}

// 商业桌面陪伴贴边吸附与自动藏匿（Peek-Hide Edge Docker）：
// - 支持多屏任意工作区偏移（WorkX, WorkY, WorkWidth, WorkHeight）
// - 拖拽靠近边缘 SnapThresholdPx 像素内自动磁吸贴边
// - 鼠标移开超过 AutoHideDelaySec 秒自动收起仅保留 PeekStripPx 像素探头，悬停即刻弹出
public class CompanionEdgeDocker {
    public int WorkX;
    public int WorkY;
    public int WorkWidth;
    public int WorkHeight;
    public int SnapThresholdPx;
    public int PeekStripPx;
    public float AutoHideDelaySec;

    public DockEdge CurrentEdge;
    public bool IsCollapsed;
    public float UnhoveredSec;

    public CompanionEdgeDocker(int workX, int workY, int workW, int workH,
                               int snapThresholdPx, int peekStripPx, float autoHideDelaySec) {
        this.WorkX = workX;
        this.WorkY = workY;
        this.WorkWidth = workW > 0 ? workW : 1920;
        this.WorkHeight = workH > 0 ? workH : 1080;
        this.SnapThresholdPx = snapThresholdPx >= 0 ? snapThresholdPx : 24;
        this.PeekStripPx = peekStripPx >= 2 ? peekStripPx : 12;
        this.AutoHideDelaySec = autoHideDelaySec >= 0.0f ? autoHideDelaySec : 1.5f;
        this.CurrentEdge = DockEdge.None;
        this.IsCollapsed = false;
        this.UnhoveredSec = 0.0f;
    }

    public DockEdge EvaluateSnap(int winX, int winY, int winW, int winH,
                                 out int snappedX, out int snappedY) {
        int rightEdge = this.WorkX + this.WorkWidth;
        int bottomEdge = this.WorkY + this.WorkHeight;
        int sx = winX;
        int sy = winY;
        if (sx < this.WorkX) { sx = this.WorkX; }
        if (sx + winW > rightEdge) { sx = rightEdge - winW; }
        if (sy < this.WorkY) { sy = this.WorkY; }
        if (sy + winH > bottomEdge) { sy = bottomEdge - winH; }

        int dLeft = sx - this.WorkX;
        int dRight = rightEdge - (sx + winW);
        int dTop = sy - this.WorkY;
        int dBottom = bottomEdge - (sy + winH);

        DockEdge best = DockEdge.None;
        int bestDist = this.SnapThresholdPx + 1;
        if (dLeft <= this.SnapThresholdPx && dLeft < bestDist) {
            best = DockEdge.Left;
            bestDist = dLeft;
        }
        if (dRight <= this.SnapThresholdPx && dRight < bestDist) {
            best = DockEdge.Right;
            bestDist = dRight;
        }
        if (dTop <= this.SnapThresholdPx && dTop < bestDist) {
            best = DockEdge.Top;
            bestDist = dTop;
        }
        if (dBottom <= this.SnapThresholdPx && dBottom < bestDist) {
            best = DockEdge.Bottom;
            bestDist = dBottom;
        }

        if (best == DockEdge.Left) { sx = this.WorkX; }
        else if (best == DockEdge.Right) { sx = rightEdge - winW; }
        else if (best == DockEdge.Top) { sy = this.WorkY; }
        else if (best == DockEdge.Bottom) { sy = bottomEdge - winH; }

        this.CurrentEdge = best;
        if (best == DockEdge.None) {
            this.IsCollapsed = false;
            this.UnhoveredSec = 0.0f;
        }
        snappedX = sx;
        snappedY = sy;
        return best;
    }

    public bool TickAutoHide(float dtSec, bool cursorHoverOrFocused,
                             int dockedX, int dockedY, int winW, int winH,
                             out int targetX, out int targetY) {
        targetX = dockedX;
        targetY = dockedY;
        if (this.CurrentEdge == DockEdge.None) {
            this.IsCollapsed = false;
            this.UnhoveredSec = 0.0f;
            return false;
        }
        if (cursorHoverOrFocused) {
            this.UnhoveredSec = 0.0f;
            this.IsCollapsed = false;
            return false;
        }
        if (dtSec > 0.0f) {
            this.UnhoveredSec = this.UnhoveredSec + dtSec;
        }
        if (this.UnhoveredSec >= this.AutoHideDelaySec) {
            this.IsCollapsed = true;
        }
        if (!this.IsCollapsed) { return false; }

        int rightEdge = this.WorkX + this.WorkWidth;
        int bottomEdge = this.WorkY + this.WorkHeight;
        if (this.CurrentEdge == DockEdge.Left) {
            targetX = this.WorkX - winW + this.PeekStripPx;
        } else if (this.CurrentEdge == DockEdge.Right) {
            targetX = rightEdge - this.PeekStripPx;
        } else if (this.CurrentEdge == DockEdge.Top) {
            targetY = this.WorkY - winH + this.PeekStripPx;
        } else if (this.CurrentEdge == DockEdge.Bottom) {
            targetY = bottomEdge - this.PeekStripPx;
        }
        return true;
    }
}

// 桌面宠物/虚拟伙伴当前情绪状态。
public enum CompanionMoodState {
    Happy = 0,
    Content = 1,
    Hungry = 2,
    Sleepy = 3,
    Grumpy = 4
}

// 商业桌面宠物养成需求模拟器（Tamagotchi Virtual Needs Simulator）：
// - 四维生理与情绪指标（饱食度 Hunger、精力 Energy、心情 Mood、清洁 Hygiene，范围 0..100）
// - 连续时间衰减 + 饥饿联动心情下滑 + 喂食/玩耍/休息/清洁交互动作 + 确定性情绪状态推导
public class CompanionNeedsSimulator {
    public float Hunger;
    public float Energy;
    public float Mood;
    public float Hygiene;

    public float HungerDecayPerHour;
    public float EnergyDecayPerHour;
    public float MoodDecayPerHour;
    public float HygieneDecayPerHour;

    public CompanionNeedsSimulator() {
        this.Hunger = 85.0f;
        this.Energy = 85.0f;
        this.Mood = 85.0f;
        this.Hygiene = 85.0f;
        this.HungerDecayPerHour = 12.0f;
        this.EnergyDecayPerHour = 8.0f;
        this.MoodDecayPerHour = 5.0f;
        this.HygieneDecayPerHour = 4.0f;
    }

    private static float Clamp100(float v) {
        if (v < 0.0f) { return 0.0f; }
        if (v > 100.0f) { return 100.0f; }
        return v;
    }

    public void AdvanceHours(float hours) {
        if (hours <= 0.0f) { return; }
        this.Hunger = Clamp100(this.Hunger - this.HungerDecayPerHour * hours);
        this.Energy = Clamp100(this.Energy - this.EnergyDecayPerHour * hours);
        this.Hygiene = Clamp100(this.Hygiene - this.HygieneDecayPerHour * hours);
        float moodPenalty = this.Hunger < 25.0f ? 2.0f : 1.0f;
        this.Mood = Clamp100(this.Mood - this.MoodDecayPerHour * moodPenalty * hours);
    }

    public void Feed(float nutrition) {
        if (nutrition <= 0.0f) { return; }
        this.Hunger = Clamp100(this.Hunger + nutrition);
        this.Mood = Clamp100(this.Mood + nutrition * 0.25f);
    }

    public void Rest(float recovery) {
        if (recovery <= 0.0f) { return; }
        this.Energy = Clamp100(this.Energy + recovery);
        this.Mood = Clamp100(this.Mood + recovery * 0.15f);
    }

    public void Play(float joy) {
        if (joy <= 0.0f) { return; }
        this.Mood = Clamp100(this.Mood + joy);
        this.Energy = Clamp100(this.Energy - joy * 0.3f);
        this.Hygiene = Clamp100(this.Hygiene - joy * 0.15f);
    }

    public void Clean(float freshness) {
        if (freshness <= 0.0f) { return; }
        this.Hygiene = Clamp100(this.Hygiene + freshness);
        this.Mood = Clamp100(this.Mood + freshness * 0.1f);
    }

    public CompanionMoodState EvaluateMoodState() {
        if (this.Hunger < 25.0f) { return CompanionMoodState.Hungry; }
        if (this.Energy < 25.0f) { return CompanionMoodState.Sleepy; }
        if (this.Mood < 30.0f || this.Hygiene < 25.0f) { return CompanionMoodState.Grumpy; }
        if (this.Hunger >= 75.0f && this.Energy >= 75.0f
            && this.Mood >= 75.0f && this.Hygiene >= 75.0f) {
            return CompanionMoodState.Happy;
        }
        return CompanionMoodState.Content;
    }
}

// 免打扰折叠后的按来源摘要条目。
public class NotificationDigestItem {
    public string Source;
    public string LatestMessage;
    public int MaxPriority;
    public int Count;

    public NotificationDigestItem(string source, string message, int priority) {
        this.Source = source != null ? source : "";
        this.LatestMessage = message != null ? message : "";
        this.MaxPriority = priority;
        this.Count = 1;
    }
}

// 商业桌面陪伴防打扰通知折叠摘要器（DND Digest & Urgent Bypass）：
// - 专注/免打扰开启时，普通通知按来源（Source）自动合并计数静默入队，杜绝频繁弹窗打断心流
// - 紧急级别通知（priority >= UrgentPriorityThreshold）穿透免打扰立即提醒
// - 专注结束后一键 FlushDigest 吐出聚合摘要并清空队列
public class CompanionNotificationDigest {
    public bool DoNotDisturb;
    public int UrgentPriorityThreshold;
    private List<NotificationDigestItem> queue;

    public CompanionNotificationDigest() {
        this.DoNotDisturb = false;
        this.UrgentPriorityThreshold = 2;
        this.queue = new List<NotificationDigestItem>();
    }

    public int DeferredSourceCount { get { return this.queue.Count; } }

    public int TotalDeferredEvents() {
        int sum = 0;
        for (int i = 0; i < this.queue.Count; i = i + 1) {
            sum = sum + this.queue[i].Count;
        }
        return sum;
    }

    public void Ingest(string source, string message, int priority, out bool immediateAlert) {
        if (!this.DoNotDisturb || priority >= this.UrgentPriorityThreshold) {
            immediateAlert = true;
            return;
        }
        immediateAlert = false;
        string src = source != null ? source : "System";
        string msg = message != null ? message : "";
        for (int i = 0; i < this.queue.Count; i = i + 1) {
            if (this.queue[i].Source == src) {
                this.queue[i].Count = this.queue[i].Count + 1;
                this.queue[i].LatestMessage = msg;
                if (priority > this.queue[i].MaxPriority) {
                    this.queue[i].MaxPriority = priority;
                }
                return;
            }
        }
        this.queue.Add(new NotificationDigestItem(src, msg, priority));
    }

    public List<NotificationDigestItem> FlushDigest() {
        List<NotificationDigestItem> outList = new List<NotificationDigestItem>();
        for (int i = 0; i < this.queue.Count; i = i + 1) {
            outList.Add(this.queue[i]);
        }
        this.queue.Clear();
        return outList;
    }
}
