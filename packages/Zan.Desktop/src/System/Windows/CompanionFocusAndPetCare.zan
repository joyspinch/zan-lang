using System;
using System.Collections.Generic;

namespace System.Windows;

// 日历会议时段记录。
public class ScheduledMeetingWindow {
    public int StartMinute;
    public int EndMinute;

    public ScheduledMeetingWindow(int startMinute, int endMinute) {
        this.StartMinute = startMinute;
        this.EndMinute = endMinute;
    }
}

// 商业桌面伴侣日历会议与投屏免打扰守卫：会前缓冲自动静音、投屏演示中零弹窗打扰。
public class CompanionMeetingDndGuard {
    private List<ScheduledMeetingWindow> meetings;
    public int PreBufferMinutes;
    public bool ScreenSharingActive;

    public CompanionMeetingDndGuard(int preBufferMinutes) {
        this.meetings = new List<ScheduledMeetingWindow>();
        this.PreBufferMinutes = preBufferMinutes >= 0 ? preBufferMinutes : 3;
        this.ScreenSharingActive = false;
    }

    public void AddMeeting(int startMinute, int endMinute) {
        this.meetings.Add(new ScheduledMeetingWindow(startMinute, endMinute));
    }

    public bool ShouldSuppressAlerts(int minuteOfDay) {
        if (this.ScreenSharingActive) { return true; }
        for (int i = 0; i < this.meetings.Count; i = i + 1) {
            ScheduledMeetingWindow m = this.meetings[i];
            if (minuteOfDay >= (m.StartMinute - this.PreBufferMinutes) && minuteOfDay < m.EndMinute) {
                return true;
            }
        }
        return false;
    }
}

// 商业桌面伴侣宠物饱食/精力/情绪养成循环：真实时长衰减、防暴食冷却与优先需求状态提示。
public class CompanionPetMealAndEnergy {
    public float Hunger; // 100=饱足, 0=饥饿
    public float Energy; // 100=精力充沛, 0=困倦
    public float FeedCooldownMin;
    private float cooldownLeftMin;

    public CompanionPetMealAndEnergy(float feedCooldownMin) {
        this.Hunger = 80.0f;
        this.Energy = 85.0f;
        this.FeedCooldownMin = feedCooldownMin >= 0.0f ? feedCooldownMin : 10.0f;
        this.cooldownLeftMin = 0.0f;
    }

    public void StepMinutes(float dtMin) {
        if (dtMin <= 0.0f) { return; }
        this.Hunger = this.Hunger - dtMin * 0.6f;
        this.Energy = this.Energy - dtMin * 0.4f;
        if (this.Hunger < 0.0f) { this.Hunger = 0.0f; }
        if (this.Energy < 0.0f) { this.Energy = 0.0f; }
        if (this.cooldownLeftMin > 0.0f) {
            this.cooldownLeftMin = this.cooldownLeftMin - dtMin;
            if (this.cooldownLeftMin < 0.0f) { this.cooldownLeftMin = 0.0f; }
        }
    }

    public bool TryFeed(float nutrition) {
        if (this.cooldownLeftMin > 0.0f || nutrition <= 0.0f) { return false; }
        this.Hunger = this.Hunger + nutrition;
        if (this.Hunger > 100.0f) { this.Hunger = 100.0f; }
        this.cooldownLeftMin = this.FeedCooldownMin;
        return true;
    }

    public void RestNap(float minutes) {
        if (minutes <= 0.0f) { return; }
        this.Energy = this.Energy + minutes * 2.5f;
        if (this.Energy > 100.0f) { this.Energy = 100.0f; }
    }

    public string PrimaryNeedCue() {
        if (this.Hunger < 30.0f) { return "hungry"; }
        if (this.Energy < 30.0f) { return "sleepy"; }
        return "happy";
    }
}

// 预设倒计时项。
public class CountdownTimerPreset {
    public string PresetId;
    public int DurationSeconds;

    public CountdownTimerPreset(string presetId, int durationSeconds) {
        this.PresetId = presetId;
        this.DurationSeconds = durationSeconds > 0 ? durationSeconds : 60;
    }
}

// 商业桌面伴侣快捷多预设倒计时器（泡茶/拉伸/午休/深度专注）：支持暂停续跑、百分比进度与完成事件。
public class CompanionQuickTimerPresets {
    private List<CountdownTimerPreset> presets;
    public string ActivePresetId;
    public int TotalSeconds;
    public int RemainingSeconds;
    public bool Paused;
    public bool CompletedFlag;

    public CompanionQuickTimerPresets() {
        this.presets = new List<CountdownTimerPreset>();
        this.ActivePresetId = "";
        this.TotalSeconds = 0;
        this.RemainingSeconds = 0;
        this.Paused = false;
        this.CompletedFlag = false;
    }

    public void RegisterPreset(string presetId, int durationSeconds) {
        this.presets.Add(new CountdownTimerPreset(presetId, durationSeconds));
    }

    public bool StartPreset(string presetId) {
        for (int i = 0; i < this.presets.Count; i = i + 1) {
            if (this.presets[i].PresetId == presetId) {
                this.ActivePresetId = presetId;
                this.TotalSeconds = this.presets[i].DurationSeconds;
                this.RemainingSeconds = this.TotalSeconds;
                this.Paused = false;
                this.CompletedFlag = false;
                return true;
            }
        }
        return false;
    }

    public bool TickSeconds(int dtSec) {
        if (dtSec <= 0 || this.Paused || this.RemainingSeconds <= 0) { return false; }
        this.RemainingSeconds = this.RemainingSeconds - dtSec;
        if (this.RemainingSeconds <= 0) {
            this.RemainingSeconds = 0;
            this.CompletedFlag = true;
            return true;
        }
        return false;
    }

    public int ProgressPercent() {
        if (this.TotalSeconds <= 0) { return 0; }
        return ((this.TotalSeconds - this.RemainingSeconds) * 100) / this.TotalSeconds;
    }
}
