using System;
using System.Collections.Generic;

namespace System.Windows;

// 单条专注中断归因记录。
public class DistractionInterruptEntry {
    public string Reason;
    public bool IsExternal;
    public int LostSeconds;

    public DistractionInterruptEntry(string reason, bool isExternal, int lostSeconds) {
        this.Reason = reason;
        this.IsExternal = isExternal;
        this.LostSeconds = lostSeconds > 0 ? lostSeconds : 0;
    }
}

// 商业桌面伴侣专注中断日志与纯度评分器：区分内因走神与外因打断，实时输出 0..100 专注纯度分。
public class CompanionPomodoroDistractionLog {
    private List<DistractionInterruptEntry> entries;
    public int PlannedFocusSeconds;

    public CompanionPomodoroDistractionLog(int plannedFocusSeconds) {
        this.entries = new List<DistractionInterruptEntry>();
        this.PlannedFocusSeconds = plannedFocusSeconds > 0 ? plannedFocusSeconds : 1500;
    }

    public void RecordInterruption(string reason, bool isExternal, int lostSeconds) {
        this.entries.Add(new DistractionInterruptEntry(reason, isExternal, lostSeconds));
    }

    public int ExternalCount() {
        int c = 0;
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            if (this.entries[i].IsExternal) { c = c + 1; }
        }
        return c;
    }

    public int InternalCount() {
        return this.entries.Count - this.ExternalCount();
    }

    public int FocusIntegrityScore() {
        int totalLost = 0;
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            totalLost = totalLost + this.entries[i].LostSeconds;
        }
        // 按流失时长占比 + 每次打断固定上下文切换惩罚（4 分/次）扣分
        int timePenalty = (totalLost * 100) / this.PlannedFocusSeconds;
        int switchPenalty = this.entries.Count * 4;
        int score = 100 - timePenalty - switchPenalty;
        if (score < 0) { score = 0; }
        if (score > 100) { score = 100; }
        return score;
    }
}

// 桌面伴侣便签条目。
public class StickyNoteItem {
    public int NoteId;
    public string Text;
    public bool Pinned;
    public bool Completed;

    public StickyNoteItem(int noteId, string text) {
        this.NoteId = noteId;
        this.Text = text;
        this.Pinned = false;
        this.Completed = false;
    }
}

// 商业桌面伴侣轻量便签置顶归档板：支持创建、置顶排前、勾选完成与一键归档已完成条目。
public class CompanionDesktopNotePinboard {
    private List<StickyNoteItem> activeNotes;
    private List<StickyNoteItem> archivedNotes;
    private int nextId;

    public CompanionDesktopNotePinboard() {
        this.activeNotes = new List<StickyNoteItem>();
        this.archivedNotes = new List<StickyNoteItem>();
        this.nextId = 1;
    }

    public int AddNote(string text) {
        int id = this.nextId;
        this.nextId = this.nextId + 1;
        this.activeNotes.Add(new StickyNoteItem(id, text));
        return id;
    }

    public bool SetPinned(int noteId, bool pinned) {
        for (int i = 0; i < this.activeNotes.Count; i = i + 1) {
            if (this.activeNotes[i].NoteId == noteId) {
                this.activeNotes[i].Pinned = pinned;
                return true;
            }
        }
        return false;
    }

    public bool MarkCompleted(int noteId, bool done) {
        for (int i = 0; i < this.activeNotes.Count; i = i + 1) {
            if (this.activeNotes[i].NoteId == noteId) {
                this.activeNotes[i].Completed = done;
                return true;
            }
        }
        return false;
    }

    // 返回置顶优先、其余按创建顺序排列的活跃便签 ID 列表。
    public List<int> OrderedActiveNoteIds() {
        List<int> ids = new List<int>();
        for (int i = 0; i < this.activeNotes.Count; i = i + 1) {
            if (this.activeNotes[i].Pinned) { ids.Add(this.activeNotes[i].NoteId); }
        }
        for (int i = 0; i < this.activeNotes.Count; i = i + 1) {
            if (!this.activeNotes[i].Pinned) { ids.Add(this.activeNotes[i].NoteId); }
        }
        return ids;
    }

    public int ArchiveCompletedNotes() {
        int moved = 0;
        List<StickyNoteItem> kept = new List<StickyNoteItem>();
        for (int i = 0; i < this.activeNotes.Count; i = i + 1) {
            if (this.activeNotes[i].Completed) {
                this.archivedNotes.Add(this.activeNotes[i]);
                moved = moved + 1;
            } else {
                kept.Add(this.activeNotes[i]);
            }
        }
        this.activeNotes = kept;
        return moved;
    }

    public int ActiveCount() { return this.activeNotes.Count; }
    public int ArchivedCount() { return this.archivedNotes.Count; }
}

// 商业桌面伴侣昼夜节律亮度与暖色温调度器：日间全亮冷白，黄昏平滑过渡，深夜自动柔和暖光防刺眼。
public class CompanionAmbientLightSchedule {
    public int DuskStartMin;
    public int NightStartMin;
    public int DawnStartMin;
    public float DayBrightness;
    public float NightBrightness;

    public CompanionAmbientLightSchedule(int duskStartMin, int nightStartMin, int dawnStartMin,
    float dayBrightness, float nightBrightness) {
        this.DuskStartMin = duskStartMin;
        this.NightStartMin = nightStartMin;
        this.DawnStartMin = dawnStartMin;
        this.DayBrightness = dayBrightness > 0.0f ? dayBrightness : 1.0f;
        this.NightBrightness = nightBrightness >= 0.0f ? nightBrightness : 0.45f;
    }

    // 返回给定分钟时刻（0..1439）的夜间因子 0.0（全亮日间）.. 1.0（柔和深夜）。
    public float NightFactorAt(int minuteOfDay) {
        int m = minuteOfDay % 1440;
        if (m < 0) { m = m + 1440; }
        if (m >= this.NightStartMin || m < this.DawnStartMin) { return 1.0f; }
        if (m >= this.DuskStartMin && m < this.NightStartMin) {
            int span = this.NightStartMin - this.DuskStartMin;
            return span > 0 ? (float)(m - this.DuskStartMin) / (float)span : 1.0f;
        }
        return 0.0f;
    }

    public float BrightnessAt(int minuteOfDay) {
        float nf = this.NightFactorAt(minuteOfDay);
        return this.DayBrightness + (this.NightBrightness - this.DayBrightness) * nf;
    }

    // 6500K（日间日光）平滑过渡至 2900K（深夜护眼暖光）。
    public int ColorKelvinAt(int minuteOfDay) {
        float nf = this.NightFactorAt(minuteOfDay);
        return (int)(6500.0f - 3600.0f * nf);
    }
}
