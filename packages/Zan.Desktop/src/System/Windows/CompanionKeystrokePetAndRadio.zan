using System;
using System.Collections.Generic;

namespace System.Windows;

// 桌面伴侣打字节奏活力档位（仅统计按键频次，绝不记录任何按键内容）。
public enum TypingCadenceTier {
    Idle = 0,
    Steady = 1,
    FlowState = 2,
    Overdrive = 3
}

// 隐私优先的桌面伴侣打字节奏活力计：滑窗统计每分钟击键频次，驱动桌宠敲键盘/加油动画。
public class CompanionTypingCadenceMeter {
    private List<long> eventTimestampsMs;
    public long WindowMs;

    public CompanionTypingCadenceMeter(long windowMs) {
        this.eventTimestampsMs = new List<long>();
        this.WindowMs = windowMs > 1000L ? windowMs : 60000L;
    }

    public void RecordPulse(long nowMs) {
        this.Prune(nowMs);
        this.eventTimestampsMs.Add(nowMs);
    }

    private void Prune(long nowMs) {
        int i = 0;
        while (i < this.eventTimestampsMs.Count) {
            if ((nowMs - this.eventTimestampsMs[i]) > this.WindowMs) {
                this.eventTimestampsMs.RemoveAt(i);
            } else {
                i = i + 1;
            }
        }
    }

    public int PulsesPerMinute(long nowMs) {
        this.Prune(nowMs);
        if (this.WindowMs <= 0L) { return 0; }
        return (int)((long)this.eventTimestampsMs.Count * 60000L / this.WindowMs);
    }

    public TypingCadenceTier EvaluateTier(long nowMs) {
        int kpm = this.PulsesPerMinute(nowMs);
        if (kpm <= 0) { return TypingCadenceTier.Idle; }
        if (kpm < 120) { return TypingCadenceTier.Steady; }
        if (kpm < 260) { return TypingCadenceTier.FlowState; }
        return TypingCadenceTier.Overdrive;
    }
}

// 内置 Lo-Fi / 专注电台频道。
public class RadioStationChannel {
    public string StationId;
    public string Title;
    public bool Favorite;

    public RadioStationChannel(string stationId, string title) {
        this.StationId = stationId;
        this.Title = title;
        this.Favorite = false;
    }
}

// 桌面伴侣 Lo-Fi 电台播放台控制器：频道轮切、收藏标记、静音保留原音量与睡眠倒计时自动停止。
public class CompanionLoFiRadioDeck {
    private List<RadioStationChannel> stations;
    public int CurrentIndex;
    public bool Playing;
    public bool Muted;
    public int VolumePercent;
    public int SleepTimerRemainingSec;

    public CompanionLoFiRadioDeck() {
        this.stations = new List<RadioStationChannel>();
        this.CurrentIndex = -1;
        this.Playing = false;
        this.Muted = false;
        this.VolumePercent = 70;
        this.SleepTimerRemainingSec = 0;
    }

    public void AddStation(string stationId, string title) {
        this.stations.Add(new RadioStationChannel(stationId, title));
        if (this.CurrentIndex < 0) { this.CurrentIndex = 0; }
    }

    public RadioStationChannel CurrentStation() {
        if (this.CurrentIndex < 0 || this.CurrentIndex >= this.stations.Count) { return null; }
        return this.stations[this.CurrentIndex];
    }

    public void NextStation() {
        if (this.stations.Count == 0) { return; }
        this.CurrentIndex = (this.CurrentIndex + 1) % this.stations.Count;
    }

    public void ToggleMute() {
        this.Muted = !this.Muted;
    }

    public int EffectiveVolume() {
        if (!this.Playing || this.Muted) { return 0; }
        return this.VolumePercent;
    }

    public void StartWithSleepTimer(int sleepSeconds) {
        if (this.stations.Count == 0) { return; }
        this.Playing = true;
        this.SleepTimerRemainingSec = sleepSeconds > 0 ? sleepSeconds : 0;
    }

    public void StepSeconds(int dtSec) {
        if (dtSec <= 0 || !this.Playing || this.SleepTimerRemainingSec <= 0) { return; }
        this.SleepTimerRemainingSec = this.SleepTimerRemainingSec - dtSec;
        if (this.SleepTimerRemainingSec <= 0) {
            this.SleepTimerRemainingSec = 0;
            this.Playing = false;
        }
    }
}

// 每日运势/鼓励签文卡片记录。
public class FortuneCardRecord {
    public int DayIndex;
    public int CardId;
    public string Text;

    public FortuneCardRecord(int dayIndex, int cardId, string text) {
        this.DayIndex = dayIndex;
        this.CardId = cardId;
        this.Text = text;
    }
}

// 桌面伴侣每日一签抽卡器：同日锁定不重抽、确定性签号生成与历史图鉴收集统计。
public class CompanionDailyFortuneCard {
    private List<string> pool;
    private List<FortuneCardRecord> history;
    private List<int> collectedIds;

    public CompanionDailyFortuneCard() {
        this.pool = new List<string>();
        this.history = new List<FortuneCardRecord>();
        this.collectedIds = new List<int>();
    }

    public void AddFortuneText(string text) {
        if (text != null && text != "") {
            this.pool.Add(text);
        }
    }

    public FortuneCardRecord DrawForDay(int dayIndex) {
        if (this.pool.Count == 0) { return null; }
        for (int i = 0; i < this.history.Count; i = i + 1) {
            if (this.history[i].DayIndex == dayIndex) {
                return this.history[i]; // 同日返回同一张签，防重复刷签
            }
        }
        int hash = dayIndex * 265443576 + 17;
        if (hash < 0) { hash = -hash; }
        int cardId = hash % this.pool.Count;
        FortuneCardRecord rec = new FortuneCardRecord(dayIndex, cardId, this.pool[cardId]);
        this.history.Add(rec);
        bool seen = false;
        for (int i = 0; i < this.collectedIds.Count; i = i + 1) {
            if (this.collectedIds[i] == cardId) { seen = true; break; }
        }
        if (!seen) { this.collectedIds.Add(cardId); }
        return rec;
    }

    public int UniqueCollectedCount() { return this.collectedIds.Count; }
}
