using System;
using System.Collections.Generic;
using System.Input;
using System.Management;

namespace System.Windows;

// 桌面可用工作区矩形（已自动扣除 Windows 任务栏等系统保留区）。
public class WorkAreaRect {
    public int Left;
    public int Top;
    public int Right;
    public int Bottom;

    public WorkAreaRect(int left, int top, int right, int bottom) {
        this.Left = left;
        this.Top = top;
        this.Right = right;
        this.Bottom = bottom;
    }

    public int Width { get { return this.Right - this.Left; } }
    public int Height { get { return this.Bottom - this.Top; } }
}

// 桌面停靠目标坐标。
public class DockPosition {
    public int X;
    public int Y;

    public DockPosition(int x, int y) {
        this.X = x;
        this.Y = y;
    }
}

// 桌面挂机/桌宠四角停靠锚点常量。
public static class DockCorner {
    public const int TopLeft = 0;
    public const int TopRight = 1;
    public const int BottomLeft = 2;
    public const int BottomRight = 3;
    public const int Center = 4;
}

// 单台物理显示器的边界与扣除任务栏后的工作区（支持负坐标副屏与竖屏）。
public class MonitorWorkArea {
    public int Index;
    public string Name;
    public bool IsPrimary;
    public WorkAreaRect Bounds;
    public WorkAreaRect WorkArea;

    public MonitorWorkArea(int index, string name, bool isPrimary,
                           WorkAreaRect bounds, WorkAreaRect workArea) {
        this.Index = index;
        this.Name = name == null ? "" : name;
        this.IsPrimary = isPrimary;
        this.Bounds = bounds;
        this.WorkArea = workArea;
    }
}

// 桌面工作区探测与窗口安全停靠/拖拽钳位工具（零 Gui 依赖，可与任意窗口壳组合）。
public static class DesktopDock {
    #if WINDOWS
    [DllImport("user32", EntryPoint = "SystemParametersInfoW")]
    private static extern int WinSystemParametersInfoW(int uiAction, int uiParam, nint pvParam, int fWinIni);

    [DllImport("user32", EntryPoint = "MonitorFromRect")]
    private static extern nint WinMonitorFromRect(nint lprc, int dwFlags);

    [DllImport("user32", EntryPoint = "GetMonitorInfoW")]
    private static extern int WinGetMonitorInfoW(nint hMonitor, nint lpmi);

    private static bool TryQueryMonitorRects(nint hmon, out WorkAreaRect bounds, out WorkAreaRect work) {
        bounds = null;
        work = null;
        if (hmon == 0) { return false; }
        // MONITORINFO: cbSize(4) + rcMonitor(16) + rcWork(16) + dwFlags(4) = 40 bytes
        nint mi = NativeMemory.Alloc(40);
        try {
            Span<int> sp = new Span<int>(mi, 10);
            for (int i = 0; i < 10; i = i + 1) { sp[i] = 0; }
            sp[0] = 40;
            if (DesktopDock.WinGetMonitorInfoW(hmon, mi) != 0) {
                bounds = new WorkAreaRect(sp[1], sp[2], sp[3], sp[4]);
                work = new WorkAreaRect(sp[5], sp[6], sp[7], sp[8]);
                return work.Width > 0 && work.Height > 0;
            }
        } finally {
            NativeMemory.Free(mi);
        }
        return false;
    }
    #endif

    // 查询主显示器扣除任务栏后的可用工作区；不支持或失败时回退到 ScreenWidth x ScreenHeight。
    public static WorkAreaRect GetPrimaryWorkArea() {
        #if WINDOWS
        nint rectBuf = NativeMemory.Alloc(16);
        try {
            int ok = DesktopDock.WinSystemParametersInfoW(0x0030 /* SPI_GETWORKAREA */, 0, rectBuf, 0);
            if (ok != 0) {
                Span<int> sp = new Span<int>(rectBuf, 4);
                int left = sp[0];
                int top = sp[1];
                int right = sp[2];
                int bottom = sp[3];
                if (right > left && bottom > top) {
                    return new WorkAreaRect(left, top, right, bottom);
                }
            }
        } finally {
            NativeMemory.Free(rectBuf);
        }
        #endif
        int w = Screen.ScreenWidth();
        int h = Screen.ScreenHeight();
        if (w <= 0) { w = 1920; }
        if (h <= 0) { h = 1080; }
        return new WorkAreaRect(0, 0, w, h);
    }

    // 枚举所有物理显示器及其各自扣除任务栏后的工作区（复用 System.Management.Display 拓扑）。
    public static List<MonitorWorkArea> GetMonitors() {
        List<MonitorWorkArea> result = new List<MonitorWorkArea>();
        List<DisplayInfo> displays = Display.Monitors();
        for (int i = 0; i < displays.Count; i = i + 1) {
            DisplayInfo d = displays[i];
            if (d == null) { continue; }
            WorkAreaRect bounds = new WorkAreaRect(d.x, d.y, d.x + d.width, d.y + d.height);
            WorkAreaRect work = bounds;
            #if WINDOWS
            nint probe = NativeMemory.Alloc(16);
            try {
                Span<int> sp = new Span<int>(probe, 4);
                int cx = d.x + d.width / 2;
                int cy = d.y + d.height / 2;
                sp[0] = cx;
                sp[1] = cy;
                sp[2] = cx + 1;
                sp[3] = cy + 1;
                nint hmon = DesktopDock.WinMonitorFromRect(probe, 2 /* MONITOR_DEFAULTTONEAREST */);
                WorkAreaRect qBounds;
                WorkAreaRect qWork;
                if (DesktopDock.TryQueryMonitorRects(hmon, out qBounds, out qWork)) {
                    bounds = qBounds;
                    work = qWork;
                }
            } finally {
                NativeMemory.Free(probe);
            }
            #endif
            result.Add(new MonitorWorkArea(d.index, d.name, d.primary, bounds, work));
        }
        if (result.Count == 0) {
            WorkAreaRect primary = DesktopDock.GetPrimaryWorkArea();
            result.Add(new MonitorWorkArea(0, "PRIMARY", true, primary, primary));
        }
        return result;
    }

    // 查询包含（或最接近）虚拟桌面坐标 (x, y) 的显示器工作区（天然支持左副屏负坐标）。
    public static WorkAreaRect GetWorkAreaAt(int x, int y) {
        #if WINDOWS
        nint probe = NativeMemory.Alloc(16);
        try {
            Span<int> sp = new Span<int>(probe, 4);
            sp[0] = x;
            sp[1] = y;
            sp[2] = x + 1;
            sp[3] = y + 1;
            nint hmon = DesktopDock.WinMonitorFromRect(probe, 2 /* MONITOR_DEFAULTTONEAREST */);
            WorkAreaRect qBounds;
            WorkAreaRect qWork;
            if (DesktopDock.TryQueryMonitorRects(hmon, out qBounds, out qWork)) {
                return qWork;
            }
        } finally {
            NativeMemory.Free(probe);
        }
        #endif
        return DesktopDock.GetPrimaryWorkArea();
    }

    // 计算窗口停靠在指定显示器索引（0 = 主屏，1..N = 副屏）四角/居中时的安全坐标。
    public static DockPosition ComputeMonitorCorner(int monitorIndex, int winW, int winH,
                                                    int corner, int marginX, int marginY) {
        List<MonitorWorkArea> mons = DesktopDock.GetMonitors();
        WorkAreaRect area = DesktopDock.GetPrimaryWorkArea();
        if (monitorIndex >= 0 && monitorIndex < mons.Count) {
            area = mons[monitorIndex].WorkArea;
        }
        return DesktopDock.ComputeCorner(area, winW, winH, corner, marginX, marginY);
    }

    // 按窗口中心点自动定位所在显示器并钳位，适合多屏环境拖拽桌宠窗口。
    public static DockPosition ClampToMonitorAt(int x, int y, int winW, int winH) {
        WorkAreaRect area = DesktopDock.GetWorkAreaAt(x + winW / 2, y + winH / 2);
        return DesktopDock.ClampToArea(area, x, y, winW, winH);
    }

    // 计算窗口停靠在指定工作区四角/居中时的安全坐标（自动钳位防止越界）。
    public static DockPosition ComputeCorner(WorkAreaRect area, int winW, int winH,
                                             int corner, int marginX, int marginY) {
        if (area == null) { area = DesktopDock.GetPrimaryWorkArea(); }
        if (winW < 0) { winW = 0; }
        if (winH < 0) { winH = 0; }
        int x = area.Left + marginX;
        int y = area.Top + marginY;
        if (corner == DockCorner.TopRight) {
            x = area.Right - winW - marginX;
            y = area.Top + marginY;
        } else if (corner == DockCorner.BottomLeft) {
            x = area.Left + marginX;
            y = area.Bottom - winH - marginY;
        } else if (corner == DockCorner.BottomRight) {
            x = area.Right - winW - marginX;
            y = area.Bottom - winH - marginY;
        } else if (corner == DockCorner.Center) {
            x = area.Left + (area.Width - winW) / 2;
            y = area.Top + (area.Height - winH) / 2;
        }
        return DesktopDock.ClampToArea(area, x, y, winW, winH);
    }

    public static DockPosition ComputePrimaryCorner(int winW, int winH, int corner,
                                                    int marginX, int marginY) {
        return DesktopDock.ComputeCorner(DesktopDock.GetPrimaryWorkArea(), winW, winH,
                                         corner, marginX, marginY);
    }

    // 将拖拽中的桌宠窗口坐标钳位到工作区内部，避免被拖出屏幕或压在任务栏后方。
    public static DockPosition ClampToArea(WorkAreaRect area, int x, int y, int winW, int winH) {
        if (area == null) { return new DockPosition(x, y); }
        int maxX = area.Right - winW;
        int maxY = area.Bottom - winH;
        if (maxX < area.Left) { maxX = area.Left; }
        if (maxY < area.Top) { maxY = area.Top; }
        if (x < area.Left) { x = area.Left; }
        if (x > maxX) { x = maxX; }
        if (y < area.Top) { y = area.Top; }
        if (y > maxY) { y = maxY; }
        return new DockPosition(x, y);
    }
}

// 桌面挂机/桌宠全局键鼠活跃度与闲置时长追踪器（基于 Hook.InstallBoth，只读观测绝不吞事件）。
public static class CompanionActivityTracker {
    private static bool running = false;
    private static long keyDownCount = 0L;
    private static long mouseClickCount = 0L;
    private static long mouseWheelCount = 0L;
    private static long mouseMoveCount = 0L;
    private static int lastKeyVk = 0;
    private static int lastMouseX = 0;
    private static int lastMouseY = 0;
    private static long lastActiveTickMs = 0L;

    public static bool IsRunning { get { return CompanionActivityTracker.running; } }
    public static long KeyDownCount { get { return CompanionActivityTracker.keyDownCount; } }
    public static long MouseClickCount { get { return CompanionActivityTracker.mouseClickCount; } }
    public static long MouseWheelCount { get { return CompanionActivityTracker.mouseWheelCount; } }
    public static long MouseMoveCount { get { return CompanionActivityTracker.mouseMoveCount; } }
    public static int LastKeyVk { get { return CompanionActivityTracker.lastKeyVk; } }
    public static int LastMouseX { get { return CompanionActivityTracker.lastMouseX; } }
    public static int LastMouseY { get { return CompanionActivityTracker.lastMouseY; } }

    // 启动全局键鼠双钩子监听，记录最后活跃时间戳。
    public static bool Start() {
        if (CompanionActivityTracker.running) { return true; }
        CompanionActivityTracker.lastActiveTickMs = Environment.TickCount64;
        bool ok = Hook.InstallBoth(CompanionActivityTracker.OnKeyboard, CompanionActivityTracker.OnMouse);
        if (ok) {
            CompanionActivityTracker.running = true;
        }
        return ok;
    }

    // 卸载全局钩子并停止监听。
    public static void Stop() {
        if (!CompanionActivityTracker.running) { return; }
        Hook.Uninstall();
        CompanionActivityTracker.running = false;
    }

    // 清零统计计数并刷新活跃时间戳。
    public static void Reset() {
        CompanionActivityTracker.keyDownCount = 0L;
        CompanionActivityTracker.mouseClickCount = 0L;
        CompanionActivityTracker.mouseWheelCount = 0L;
        CompanionActivityTracker.mouseMoveCount = 0L;
        CompanionActivityTracker.lastKeyVk = 0;
        CompanionActivityTracker.lastMouseX = 0;
        CompanionActivityTracker.lastMouseY = 0;
        CompanionActivityTracker.lastActiveTickMs = Environment.TickCount64;
    }

    // 距离上次键鼠活动的闲置毫秒数（便于桌宠在用户离开 N 秒后切入打盹/待机动画）。
    public static long IdleMs() {
        if (CompanionActivityTracker.lastActiveTickMs <= 0L) { return 0L; }
        long delta = Environment.TickCount64 - CompanionActivityTracker.lastActiveTickMs;
        if (delta < 0L) { delta = 0L; }
        return delta;
    }

    // 手动注入一次按键活动（供自定义输入源或无头自动化测试使用）。
    public static void RecordKeyDown(int vk) {
        CompanionActivityTracker.keyDownCount = CompanionActivityTracker.keyDownCount + 1L;
        CompanionActivityTracker.lastKeyVk = vk;
        CompanionActivityTracker.lastActiveTickMs = Environment.TickCount64;
    }

    // 手动注入一次鼠标活动（兼容 Win32 WM_* 消息号）。
    public static void RecordMouseEvent(int x, int y, int msg, int data) {
        CompanionActivityTracker.lastMouseX = x;
        CompanionActivityTracker.lastMouseY = y;
        if (msg == 0x0201 || msg == 0x0204 || msg == 0x0207) {
            CompanionActivityTracker.mouseClickCount = CompanionActivityTracker.mouseClickCount + 1L;
        } else if (msg == 0x020A) {
            CompanionActivityTracker.mouseWheelCount = CompanionActivityTracker.mouseWheelCount + 1L;
        } else if (msg == 0x0200) {
            CompanionActivityTracker.mouseMoveCount = CompanionActivityTracker.mouseMoveCount + 1L;
        }
        CompanionActivityTracker.lastActiveTickMs = Environment.TickCount64;
    }

    private static bool OnKeyboard(int vk, int scan, int flags, bool injected, bool keyUp) {
        if (!keyUp) {
            CompanionActivityTracker.RecordKeyDown(vk);
        }
        return false;
    }

    private static bool OnMouse(int x, int y, int msg, int data, bool injected) {
        CompanionActivityTracker.RecordMouseEvent(x, y, msg, data);
        return false;
    }
}

// 前台全屏游戏/视频自动躲避检测器（商业桌宠在全屏场景自动隐藏或降帧休眠的核心机制）。
public static class ForegroundFullscreenDetector {
    #if WINDOWS
    [DllImport("user32", EntryPoint = "GetForegroundWindow")]
    private static extern nint WinGetForegroundWindow();

    [DllImport("user32", EntryPoint = "GetDesktopWindow")]
    private static extern nint WinGetDesktopWindow();

    [DllImport("user32", EntryPoint = "GetShellWindow")]
    private static extern nint WinGetShellWindow();

    [DllImport("user32", EntryPoint = "GetWindowRect")]
    private static extern int WinGetWindowRect(nint hwnd, nint lpRect);

    [DllImport("user32", EntryPoint = "MonitorFromWindow")]
    private static extern nint WinMonitorFromWindow(nint hwnd, int dwFlags);

    [DllImport("user32", EntryPoint = "GetMonitorInfoW")]
    private static extern int WinGetMonitorInfoW(nint hMonitor, nint lpmi);

    [DllImport("user32", EntryPoint = "GetClassNameW")]
    private static extern int WinGetClassNameW(nint hwnd, nint lpClassName, int nMaxCount);
    #endif

    // 纯几何覆盖判定：窗口矩形是否完全覆盖目标显示器物理边界。
    public static bool IsRectCoveringMonitor(WorkAreaRect winRect, WorkAreaRect monBounds) {
        if (winRect == null || monBounds == null) { return false; }
        if (monBounds.Width <= 0 || monBounds.Height <= 0) { return false; }
        return winRect.Left <= monBounds.Left
            && winRect.Top <= monBounds.Top
            && winRect.Right >= monBounds.Right
            && winRect.Bottom >= monBounds.Bottom;
    }

    // 探测当前前台活动窗口是否处于独占/无边框全屏状态（自动排除桌面壳 Progman/WorkerW/任务栏）。
    public static bool IsFullscreenActive() {
        #if WINDOWS
        nint fg = ForegroundFullscreenDetector.WinGetForegroundWindow();
        if (fg == 0) { return false; }
        if (fg == ForegroundFullscreenDetector.WinGetDesktopWindow()
            || fg == ForegroundFullscreenDetector.WinGetShellWindow()) {
            return false;
        }
        nint clsBuf = NativeMemory.Alloc(128 * 2);
        string clsName = "";
        try {
            int n = ForegroundFullscreenDetector.WinGetClassNameW(fg, clsBuf, 128);
            if (n > 0) { clsName = Wide.Read(clsBuf); }
        } finally {
            NativeMemory.Free(clsBuf);
        }
        if (clsName == "Progman" || clsName == "WorkerW"
            || clsName == "Shell_TrayWnd" || clsName == "Shell_SecondaryTrayWnd") {
            return false;
        }
        nint wr = NativeMemory.Alloc(16);
        nint mi = NativeMemory.Alloc(40);
        try {
            if (ForegroundFullscreenDetector.WinGetWindowRect(fg, wr) == 0) { return false; }
            nint mon = ForegroundFullscreenDetector.WinMonitorFromWindow(fg, 2 /* MONITOR_DEFAULTTONEAREST */);
            if (mon == 0) { return false; }
            Span<int> msp = new Span<int>(mi, 10);
            for (int i = 0; i < 10; i = i + 1) { msp[i] = 0; }
            msp[0] = 40;
            if (ForegroundFullscreenDetector.WinGetMonitorInfoW(mon, mi) == 0) { return false; }
            Span<int> wsp = new Span<int>(wr, 4);
            WorkAreaRect winRect = new WorkAreaRect(wsp[0], wsp[1], wsp[2], wsp[3]);
            WorkAreaRect monBounds = new WorkAreaRect(msp[1], msp[2], msp[3], msp[4]);
            return ForegroundFullscreenDetector.IsRectCoveringMonitor(winRect, monBounds);
        } finally {
            NativeMemory.Free(wr);
            NativeMemory.Free(mi);
        }
        #else
        return false;
        #endif
    }
}

// 跨进程单实例防双开互斥锁（Win32 CreateMutexW + ERROR_ALREADY_EXISTS；非 Windows 进程内兜底）。
public class SingleInstanceGuard : IDisposable {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "CreateMutexW")]
    private static extern nint WinCreateMutexW(nint attrs, int initialOwner, nint name);

    [DllImport("kernel32", EntryPoint = "GetLastError")]
    private static extern int WinGetLastError();

    [DllImport("kernel32", EntryPoint = "CloseHandle")]
    private static extern int WinCloseHandle(nint handle);
    #endif

    private static List<string> localHeld = new List<string>();
    private nint handle;
    private string key;

    private SingleInstanceGuard(nint handle, string key) {
        this.handle = handle;
        this.key = key;
    }

    // 尝试获取应用单实例锁；成功返回持锁对象（退出前 Dispose 释放），已被其他实例持有返回 null。
    public static SingleInstanceGuard TryAcquire(string appId) {
        if (appId == null || appId == "") { return null; }
        string fullKey = "Local\\ZanSingleInstance_" + appId;
        #if WINDOWS
        nint wname = Wide.Of(fullKey);
        nint h = 0;
        int err = 0;
        try {
            h = SingleInstanceGuard.WinCreateMutexW(0, 1, wname);
            err = SingleInstanceGuard.WinGetLastError();
        } finally {
            Wide.Free(wname);
        }
        if (h == 0) { return null; }
        if (err == 183 /* ERROR_ALREADY_EXISTS */) {
            SingleInstanceGuard.WinCloseHandle(h);
            return null;
        }
        return new SingleInstanceGuard(h, fullKey);
        #else
        for (int i = 0; i < SingleInstanceGuard.localHeld.Count; i = i + 1) {
            if (SingleInstanceGuard.localHeld[i] == fullKey) { return null; }
        }
        SingleInstanceGuard.localHeld.Add(fullKey);
        return new SingleInstanceGuard(1, fullKey);
        #endif
    }

    public bool IsHeld { get { return this.handle != 0; } }

    public void Dispose() {
        if (this.handle == 0) { return; }
        #if WINDOWS
        SingleInstanceGuard.WinCloseHandle(this.handle);
        #else
        for (int i = SingleInstanceGuard.localHeld.Count - 1; i >= 0; i = i - 1) {
            if (SingleInstanceGuard.localHeld[i] == this.key) {
                SingleInstanceGuard.localHeld.RemoveAt(i);
                break;
            }
        }
        #endif
        this.handle = 0;
    }
}

// 开机自启注册管理（Windows 读写 HKCU\Software\Microsoft\Windows\CurrentVersion\Run）。
public static class StartupRegistration {
    private const string RUN_KEY = "Software\\Microsoft\\Windows\\CurrentVersion\\Run";

    public static bool Enable(string appName, string commandLine) {
        if (appName == null || appName == "" || commandLine == null || commandLine == "") {
            return false;
        }
        #if WINDOWS
        nint k = Registry.CreateKey(Registry.Hkcu(), RUN_KEY);
        if (k == 0) { return false; }
        try {
            Registry.SetString(k, appName, commandLine);
            return true;
        } finally {
            Registry.CloseKey(k);
        }
        #else
        return false;
        #endif
    }

    public static bool Disable(string appName) {
        if (appName == null || appName == "") { return false; }
        #if WINDOWS
        nint k = Registry.OpenKey(Registry.Hkcu(), RUN_KEY, true);
        if (k == 0) { return false; }
        try {
            Registry.DeleteValue(k, appName);
            return true;
        } finally {
            Registry.CloseKey(k);
        }
        #else
        return false;
        #endif
    }

    public static string GetCommand(string appName) {
        if (appName == null || appName == "") { return ""; }
        #if WINDOWS
        nint k = Registry.OpenKey(Registry.Hkcu(), RUN_KEY, false);
        if (k == 0) { return ""; }
        try {
            return Registry.GetString(k, appName);
        } finally {
            Registry.CloseKey(k);
        }
        #else
        return "";
        #endif
    }

    public static bool IsEnabled(string appName) {
        return StartupRegistration.GetCommand(appName) != "";
    }
}
