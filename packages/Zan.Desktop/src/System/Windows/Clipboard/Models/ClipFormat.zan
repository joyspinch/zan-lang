using System;

namespace System.Windows.Clipboard;

// 剪贴板格式常量（winuser.h）。
public class ClipFormat {
    // 剪贴板格式：CF_TEXT（ANSI 文本）。
    public static int Text() { return 1; }        // CF_TEXT
    // 剪贴板格式：CF_BITMAP（位图句柄）。
    public static int Bitmap() { return 2; }      // CF_BITMAP
    // 剪贴板格式：CF_UNICODETEXT（UTF-16 文本）。
    public static int UnicodeText() { return 13; }   // CF_UNICODETEXT
    // 剪贴板格式：CF_HDROP（文件列表）。
    public static int Hdrop() { return 15; }      // CF_HDROP（文件列表）
    // 已注册的 "HTML Format" 格式 id。
    public static int Html() { return 0x0D01; }   // 已注册的 "HTML Format" 格式 id
    // 已注册的 "Rich Text Format" 格式 id。
    public static int Rtf() { return 0x0D02; }    // 已注册的 "Rich Text Format" 格式 id
}
