using System;
using System.Diagnostics;

namespace System.Automation;

// Window.Instance.zan - 面向对象原生窗口实体与生命周期封装
public partial class Window {
    protected nint handle;

    public Window(nint handle) {
        this.handle = handle;
    }

    public nint Handle {
        get { return this.handle; }
    }

    public static Window FromHandle(nint hwnd) {
        if (hwnd == (nint)0) { return null; }
        return new Window(hwnd);
    }

    public static Window Find(string title) {
        nint hwnd = Window.FindWindowByTitle(title);
        if (hwnd == (nint)0) { return null; }
        return new Window(hwnd);
    }

    public string GetText() { return Window.GetText(this.handle); }
    public bool SetText(string text) { return Window.SetText(this.handle, text); }
    public string GetClassName() { return Window.GetClassName(this.handle); }
    public int GetId() { return Window.GetId(this.handle); }
    public bool IsWindow() { return Window.IsWindow(this.handle); }
    public bool IsVisible() { return Window.IsVisible(this.handle); }
    public bool IsEnabled() { return Window.IsEnabled(this.handle); }
    public bool IsMinimized() { return Window.IsMinimized(this.handle); }
    public bool IsMaximized() { return Window.IsMaximized(this.handle); }
    public Window GetParent() { return Window.FromHandle(Window.GetParent(this.handle)); }
    public WindowRect GetRect() { return Window.GetRect(this.handle); }
    public WindowRect GetClientRect() { return Window.GetClientRect(this.handle); }
    public bool Move(int x, int y, int w, int h, bool repaint) { return Window.Move(this.handle, x, y, w, h, repaint); }
    public bool Resize(int w, int h) { return Window.Resize(this.handle, w, h); }
    public bool CenterOnScreen() { return Window.CenterOnScreen(this.handle); }
    public bool SetForeground() { return Window.SetForeground(this.handle); }
    public bool SetTopmost(bool top) { return Window.SetTopmost(this.handle, top); }
    public bool Close() { return Window.Close(this.handle); }
    public bool Quit() { return Window.Quit(this.handle); }
    public bool Flash(int count, int timeoutMs) { return Window.Flash(this.handle, count, timeoutMs); }
    public bool Enable(bool enable) { return Window.Enable(this.handle, enable); }
    public bool Click() { return Window.Click(this.handle); }
    public bool Show(int cmd) { return Window.Show(this.handle, cmd); }
    public bool ShowNormal() { return Window.ShowNormal(this.handle); }
    public bool Minimize() { return Window.Minimize(this.handle); }
    public bool Maximize() { return Window.Maximize(this.handle); }
    public bool Restore() { return Window.Restore(this.handle); }
    public bool Hide() { return Window.Hide(this.handle); }
    public bool ClickMenu(string path) { return Window.ClickMenu(this.handle, path); }
}
