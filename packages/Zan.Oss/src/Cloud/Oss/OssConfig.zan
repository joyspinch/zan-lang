using System;
using System.Net;

namespace Cloud.Oss;

// 对象存储连接参数。driver 决定协议与签名方式：
// aliyun_oss（阿里云 OSS V1）、tencent_cos（腾讯云 COS XML）、s3（AWS SigV4 / MinIO）。
public class OssConfig {
    // 驱动名：aliyun_oss / tencent_cos / s3。
    public string driver;
    // 端点（http:// 或 https:// 开头，可含端口）。空表示由提供方按 bucket+region 推导。
    public string endpoint;
    // 区域：如 oss-cn-hangzhou、ap-guangzhou、us-east-1。
    public string region;
    // 桶名。
    public string bucket;
    // 对象键前缀（可空）。
    public string basePath;
    // 访问密钥 ID。
    public string accessKey;
    // 访问密钥。
    public string secretKey;
    // 单次请求超时（毫秒）。
    public int timeoutMs;
    // S3 风格：true = path style，false = 虚拟主机风格；端点含 {bucket} 时强制虚拟主机风格。
    public bool pathStyle;
    // 解析后的端点主机（Parse 之后有效）。
    public string endpointHost;
    // 解析后的端点端口（Parse 之后有效）。
    public int endpointPort;
    // 端点是否走 TLS（Parse 之后有效）。
    public bool endpointTls;
    // 端点主机中是否含 {bucket} 占位（Parse 时已替换；为 true 时不再拼桶名前缀）。
    public bool hostHasBucket;
    // 外呼策略（可空）；默认禁止回环地址，测试或内网端点需显式 AllowLoopback()。
    public ExternalCallPolicy callPolicy;

    public OssConfig() {
        this.driver = "";
        this.endpoint = "";
        this.region = "";
        this.bucket = "";
        this.basePath = "";
        this.accessKey = "";
        this.secretKey = "";
        this.timeoutMs = 30000;
        this.pathStyle = false;
        this.endpointHost = "";
        this.endpointPort = 0;
        this.endpointTls = true;
        this.hostHasBucket = false;
        this.callPolicy = null;
    }

    private static bool IsSafeHostSpan(Span<byte> sp, int start, int end) {
        if (start >= end) { return false; }
        for (int i = start; i < end; i = i + 1) {
            int c = (int)sp[i];
            bool ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                || (c >= 97 && c <= 122) || c == 45 || c == 46;
            if (!ok) { return false; }
        }
        return true;
    }

    private static bool IsSafeIpv6Span(Span<byte> sp, int start, int end) {
        if (start >= end) { return false; }
        for (int i = start; i < end; i = i + 1) {
            int c = (int)sp[i];
            bool ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 70)
                || (c >= 97 && c <= 102) || c == 58 || c == 46;
            if (!ok) { return false; }
        }
        return true;
    }

    private static int FindBucketTokenSpan(Span<byte> sp, int start, int end) {
        int limit = end - 8;
        for (int i = start; i <= limit; i = i + 1) {
            if (sp[i] == 123 && sp[i + 1] == 98 && sp[i + 2] == 117
                && sp[i + 3] == 99 && sp[i + 4] == 107 && sp[i + 5] == 101
                && sp[i + 6] == 116 && sp[i + 7] == 125) {
                return i;
            }
        }
        return -1;
    }

    // 校验主机名 / 桶名 / 区域标签（只允许 [A-Za-z0-9.-]，禁止 URL authority/Host/SSRF 注入字符）。
    internal static bool IsSafeHostText(string s) {
        if (s == null || s.Length == 0) { return false; }
        int n = s.Length;
        return OssConfig.IsSafeHostSpan(new Span<byte>((nint)s, n), 0, n);
    }

    internal static bool IsSafeIpv6Host(string s) {
        if (s == null || s.Length == 0) { return false; }
        int n = s.Length;
        return OssConfig.IsSafeIpv6Span(new Span<byte>((nint)s, n), 0, n);
    }

    // 解析端点。返回 false 表示端点为空或格式非法；无 scheme 时默认按 HTTPS 处理。
    public bool Parse() {
        string raw = this.endpoint;
        if (raw == null) { return false; }
        int rawLen = raw.Length;
        if (rawLen == 0) { return false; }
        nint rp = (nint)raw;
        Span<byte> sp = new Span<byte>(rp, rawLen);
        int start = 0;
        int end = rawLen;
        while (start < end) {
            int c = (int)sp[start];
            if (c != 32 && (c < 9 || c > 13)) { break; }
            start = start + 1;
        }
        while (end > start) {
            int c = (int)sp[end - 1];
            if (c != 32 && (c < 9 || c > 13)) { break; }
            end = end - 1;
        }
        if (start >= end) { return false; }

        int len = end - start;
        bool tls = true;
        int authStart = start;
        if (len >= 8 && sp[start] == 104 && sp[start + 1] == 116
            && sp[start + 2] == 116 && sp[start + 3] == 112
            && sp[start + 4] == 115 && sp[start + 5] == 58
            && sp[start + 6] == 47 && sp[start + 7] == 47) {
            authStart = start + 8;
        } else if (len >= 7 && sp[start] == 104 && sp[start + 1] == 116
            && sp[start + 2] == 116 && sp[start + 3] == 112
            && sp[start + 4] == 58 && sp[start + 5] == 47
            && sp[start + 6] == 47) {
            authStart = start + 7;
            tls = false;
        } else if (len >= 2 && sp[start] == 47 && sp[start + 1] == 47) {
            authStart = start + 2;
        }

        // 单遍扫描：同时校验控制/非法字符、定位首个 '/'、追踪 ':' / '{' 与主机合法性。
        int slash = -1;
        int firstColon = -1;
        int lastColon = -1;
        bool sawBrace = false;
        bool hostSafeBeforeColon = true;
        for (int i = authStart; i < end; i = i + 1) {
            int c = (int)sp[i];
            if (c <= 32 || c == 127 || c == 63 || c == 35 || c == 92) { return false; }
            if (slash < 0) {
                if (c == 47) {
                    slash = i;
                } else if (c == 58) {
                    if (firstColon < 0) { firstColon = i; }
                    lastColon = i;
                } else {
                    if (c == 123) { sawBrace = true; }
                    if (firstColon < 0 && hostSafeBeforeColon) {
                        bool ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                            || (c >= 97 && c <= 122) || c == 45 || c == 46;
                        if (!ok) { hostSafeBeforeColon = false; }
                    }
                }
            }
        }
        int hpEnd = slash >= 0 ? slash : end;
        if (hpEnd <= authStart) { return false; }

        int port = tls ? 443 : 80;
        bool isIpv6 = false;
        int hostStart = authStart;
        int hostEnd = hpEnd;

        if (sp[authStart] == 91) {
            int close = -1;
            for (int i = authStart + 1; i < hpEnd; i = i + 1) {
                if (sp[i] == 93) { close = i; break; }
            }
            if (close <= authStart + 1) { return false; }
            if (!OssConfig.IsSafeIpv6Span(sp, authStart + 1, close)) { return false; }
            if (close + 1 < hpEnd) {
                if (sp[close + 1] != 58 || close + 2 >= hpEnd) { return false; }
                int p = 0;
                for (int i = close + 2; i < hpEnd; i = i + 1) {
                    int c = (int)sp[i];
                    if (c < 48 || c > 57) { return false; }
                    p = p * 10 + (c - 48);
                    if (p >= 65536) { return false; }
                }
                if (p <= 0) { return false; }
                port = p;
            }
            hostStart = authStart + 1;
            hostEnd = close;
            isIpv6 = true;
        } else if (firstColon >= 0) {
            // 仅在单冒号时剥离 :port，非法端口（如 :0 / :99999 / :abc）必须直接拒绝而非静默拼入主机名。
            if (firstColon == authStart || firstColon != lastColon) {
                if (!OssConfig.IsSafeIpv6Span(sp, authStart, hpEnd)) { return false; }
                isIpv6 = true;
            } else {
                if (lastColon >= hpEnd - 1) { return false; }
                int p = 0;
                for (int i = lastColon + 1; i < hpEnd; i = i + 1) {
                    int c = (int)sp[i];
                    if (c < 48 || c > 57) { return false; }
                    p = p * 10 + (c - 48);
                    if (p >= 65536) { return false; }
                }
                if (p <= 0 || p >= 65536) { return false; }
                port = p;
                hostEnd = lastColon;
            }
        }
        if (hostEnd <= hostStart) { return false; }

        // 端点里带 {bucket} 占位 = 用户指定了完整的桶主机：替换占位，
        // 并按虚拟主机风格走（客户端不再自己拼桶名前缀）。
        string hostPort;
        int tokAt = sawBrace ? OssConfig.FindBucketTokenSpan(sp, hostStart, hostEnd) : -1;
        if (tokAt >= 0) {
            string bkt = this.bucket;
            if (!OssConfig.IsSafeHostText(bkt)) { return false; }
            this.hostHasBucket = true;
            this.pathStyle = false;
            int preLen = tokAt - hostStart;
            int sufStart = tokAt + 8;
            int sufLen = hostEnd - sufStart;
            if (!isIpv6) {
                if (preLen > 0 && !OssConfig.IsSafeHostSpan(sp, hostStart, tokAt)) { return false; }
                if (sufLen > 0 && !OssConfig.IsSafeHostSpan(sp, sufStart, hostEnd)) { return false; }
            }
            int blen = bkt.Length;
            int total = preLen + blen + sufLen;
            byte[] buf = new byte[total];
            nint bp = (nint)buf;
            if (preLen > 0) { NativeMemory.Copy(bp, rp + (nint)hostStart, preLen); }
            if (blen > 0) { NativeMemory.Copy(bp + (nint)preLen, (nint)bkt, blen); }
            if (sufLen > 0) { NativeMemory.Copy(bp + (nint)(preLen + blen), rp + (nint)sufStart, sufLen); }
            hostPort = NativeMemory.GetString(bp, 0, total);
        } else {
            if (!isIpv6 && !hostSafeBeforeColon) { return false; }
            hostPort = (hostStart == 0 && hostEnd == rawLen)
                ? raw
                : NativeMemory.GetString(rp, hostStart, hostEnd - hostStart);
        }
        this.endpointHost = hostPort;
        this.endpointPort = port;
        this.endpointTls = tls;
        return true;
    }

    // 端点串中是否包含 {bucket} 占位（带占位按虚拟主机风格，否则按服务主机风格）。
    public static bool HasBucketPlaceholder(string endpoint) {
        if (endpoint == null) { return false; }
        int n = endpoint.Length;
        if (n < 8) { return false; }
        return OssConfig.FindBucketTokenSpan(new Span<byte>((nint)endpoint, n), 0, n) >= 0;
    }

    // 是否走虚拟主机风格（桶名在主机名中，路径不带桶前缀）。
    public bool VirtualHost() { return this.hostHasBucket || !this.pathStyle; }

    // 请求路径是否需要桶名前缀（仅路径风格且端点不含 {bucket} 时为 true）。
    public bool UsesBucketPrefix() { return this.pathStyle && !this.hostHasBucket; }

    // 将字符串中的第一处 token 占位替换为 value。
    public static string Substitute(string s, string token, string value) {
        if (s == null || token == null) { return s; }
        int at = s.IndexOf(token);
        if (at < 0) { return s; }
        string val = value == null ? "" : value;
        int slen = s.Length;
        int tlen = token.Length;
        int vlen = val.Length;
        int sufStart = at + tlen;
        int sufLen = slen - sufStart;
        int total = at + vlen + sufLen;
        if (total == 0) { return ""; }
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        nint sp = (nint)s;
        if (at > 0) { NativeMemory.Copy(bp, sp, at); }
        if (vlen > 0) { NativeMemory.Copy(bp + (nint)at, (nint)val, vlen); }
        if (sufLen > 0) { NativeMemory.Copy(bp + (nint)(at + vlen), sp + (nint)sufStart, sufLen); }
        return NativeMemory.GetString(bp, 0, total);
    }

    // 生成对象键：basePath 前缀 + 相对键（单次扫描去除两侧多余空白与斜杠，零中间子串分配）。
    public string ObjectKey(string key) {
        string rawBase = this.basePath;
        int pStart = 0;
        int pEnd = rawBase == null ? 0 : rawBase.Length;
        if (pEnd > 0) {
            Span<byte> bpSpan = new Span<byte>((nint)rawBase, pEnd);
            while (pStart < pEnd) {
                int c = (int)bpSpan[pStart];
                if (c != 32 && (c < 9 || c > 13)) { break; }
                pStart = pStart + 1;
            }
            while (pEnd > pStart) {
                int c = (int)bpSpan[pEnd - 1];
                if (c != 32 && (c < 9 || c > 13)) { break; }
                pEnd = pEnd - 1;
            }
            while (pStart < pEnd && bpSpan[pStart] == 47) { pStart = pStart + 1; }
            while (pEnd > pStart && bpSpan[pEnd - 1] == 47) { pEnd = pEnd - 1; }
        }

        string rawKey = key == null ? "" : key;
        int kStart = 0;
        int kLen = rawKey.Length;
        if (kLen > 0) {
            Span<byte> kpSpan = new Span<byte>((nint)rawKey, kLen);
            while (kStart < kLen && kpSpan[kStart] == 47) { kStart = kStart + 1; }
        }

        int pLen = pEnd - pStart;
        int kTail = kLen - kStart;
        if (pLen == 0) {
            if (kTail == 0) { return ""; }
            return kStart == 0 ? rawKey : NativeMemory.GetString((nint)rawKey, kStart, kTail);
        }
        if (kTail == 0) {
            return (pStart == 0 && pEnd == rawBase.Length)
                ? rawBase
                : NativeMemory.GetString((nint)rawBase, pStart, pLen);
        }
        int total = pLen + 1 + kTail;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        NativeMemory.Copy(bp, (nint)rawBase + (nint)pStart, pLen);
        buf[pLen] = 47;
        NativeMemory.Copy(bp + (nint)(pLen + 1), (nint)rawKey + (nint)kStart, kTail);
        return NativeMemory.GetString(bp, 0, total);
    }
}
