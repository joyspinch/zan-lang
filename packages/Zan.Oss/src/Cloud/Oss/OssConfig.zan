using System;
using System.Net;

namespace Cloud.Oss;

// 对象存储连接参数。driver 决定协议与签名方式：
// aliyun_oss（阿里云 OSS V1）、tencent_cos（腾讯云 COS XML）、s3（AWS SigV4 / MinIO）。
public class OssConfig {
    // 驱动名：aliyun_oss / tencent_cos / s3。
    public string driver;
    // 端点（http:// 或 https:// 开头，可含端口）。空表示由提供方按 bucket+region 推导。
    public string endpoint;
    // 区域：如 oss-cn-hangzhou、ap-guangzhou、us-east-1。
    public string region;
    // 桶名。
    public string bucket;
    // 对象键前缀（可空）。
    public string basePath;
    // 访问密钥 ID。
    public string accessKey;
    // 访问密钥。
    public string secretKey;
    // 单次请求超时（毫秒）。
    public int timeoutMs;
    // S3 风格：true = path style，false = 虚拟主机风格；端点含 {bucket} 时强制虚拟主机风格。
    public bool pathStyle;
    // 解析后的端点主机（Parse 之后有效）。
    public string endpointHost;
    // 解析后的端点端口（Parse 之后有效）。
    public int endpointPort;
    // 端点是否走 TLS（Parse 之后有效）。
    public bool endpointTls;
    // 端点主机中是否含 {bucket} 占位（Parse 时已替换；为 true 时不再拼桶名前缀）。
    public bool hostHasBucket;
    // 外呼策略（可空）；默认禁止回环地址，测试或内网端点需显式 AllowLoopback()。
    public ExternalCallPolicy callPolicy;

    public OssConfig() {
        this.driver = "";
        this.endpoint = "";
        this.region = "";
        this.bucket = "";
        this.basePath = "";
        this.accessKey = "";
        this.secretKey = "";
        this.timeoutMs = 30000;
        this.pathStyle = false;
        this.endpointHost = "";
        this.endpointPort = 0;
        this.endpointTls = true;
        this.hostHasBucket = false;
        this.callPolicy = null;
    }

    // 解析端点。返回 false 表示端点为空或格式非法；无 scheme 时默认按 HTTPS 处理。
    public bool Parse() {
        string url = this.endpoint == null ? "" : this.endpoint.Trim();
        if (url.Length == 0) { return false; }
        bool tls = true;
        if (url.StartsWith("https://")) { url = url.Substring(8); }
        else if (url.StartsWith("http://")) { url = url.Substring(7); tls = false; }
        else if (url.StartsWith("//")) { url = url.Substring(2); }
        int slash = url.IndexOf("/");
        string hostPort = slash >= 0 ? url.Substring(0, slash) : url;
        if (hostPort.Length == 0) { return false; }
        int port = tls ? 443 : 80;
        int colon = -1;
        for (int i = hostPort.Length - 1; i >= 0; i = i - 1) {
            int c = hostPort[i] & 255;
            if (c == 58) { colon = i; break; }
            if (c < 48 || c > 57) { break; }
        }
        if (colon > 0 && colon < hostPort.Length - 1) {
            int p = 0;
            bool digits = true;
            for (int i = colon + 1; i < hostPort.Length; i = i + 1) {
                int c = hostPort[i] & 255;
                if (c < 48 || c > 57) { digits = false; break; }
                p = p * 10 + (c - 48);
            }
            if (digits && p > 0 && p < 65536) {
                port = p;
                hostPort = hostPort.Substring(0, colon);
            }
        }
        if (hostPort.Length == 0) { return false; }
        // 端点里带 {bucket} 占位 = 用户指定了完整的桶主机：替换占位，
        // 并按虚拟主机风格走（客户端不再自己拼桶名前缀）。
        if (hostPort.Contains("{bucket}")) {
            hostPort = OssConfig.Substitute(hostPort, "{bucket}", this.bucket);
            this.hostHasBucket = true;
            this.pathStyle = false;
        }
        this.endpointHost = hostPort;
        this.endpointPort = port;
        this.endpointTls = tls;
        return true;
    }

    // 端点串中是否包含 {bucket} 占位（带占位按虚拟主机风格，否则按服务主机风格）。
    public static bool HasBucketPlaceholder(string endpoint) {
        if (endpoint == null) { return false; }
        return endpoint.Contains("{bucket}");
    }

    // 是否走虚拟主机风格（桶名在主机名中，路径不带桶前缀）。
    public bool VirtualHost() { return this.hostHasBucket || !this.pathStyle; }

    // 请求路径是否需要桶名前缀（仅路径风格且端点不含 {bucket} 时为 true）。
    public bool UsesBucketPrefix() { return this.pathStyle && !this.hostHasBucket; }

    // 将字符串中的第一处 token 占位替换为 value。
    public static string Substitute(string s, string token, string value) {
        if (s == null || token == null) { return s; }
        int at = s.IndexOf(token);
        if (at < 0) { return s; }
        return s.Substring(0, at) + (value == null ? "" : value)
            + s.Substring(at + token.Length);
    }

    // 生成对象键：basePath 前缀 + 相对键（去除两侧多余斜杠）。
    public string ObjectKey(string key) {
        string prefix = this.basePath == null ? "" : this.basePath.Trim();
        while (prefix.StartsWith("/")) { prefix = prefix.Substring(1); }
        while (prefix.EndsWith("/")) { prefix = prefix.Substring(0, prefix.Length - 1); }
        string k = key == null ? "" : key;
        while (k.StartsWith("/")) { k = k.Substring(1); }
        if (prefix.Length == 0) { return k; }
        if (k.Length == 0) { return prefix; }
        return prefix + "/" + k;
    }
}
