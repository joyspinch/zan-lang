using System;

namespace Cloud.Oss;

// 阿里云 OSS V1 签名：Base64(HMAC-SHA1(AccessKeySecret, StringToSign))。
public class AliyunOssSigner {
    // 构造待签串；contentMd5 可为空串，resource 为 "/桶名/对象键"（不含 query）。
    public static string StringToSign(string verb, string contentMd5, string contentType,
                                      string date, string resource) {
        string v = verb == null ? "" : verb;
        string md5 = contentMd5 == null ? "" : contentMd5;
        string ct = contentType == null ? "" : contentType;
        string dt = date == null ? "" : date;
        string res = resource == null ? "" : resource;
        int total = v.Length + md5.Length + ct.Length + dt.Length + res.Length + 4;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        int pos = 0;
        if (v.Length > 0) { NativeMemory.Copy(bp, (nint)v, v.Length); pos = v.Length; }
        buf[pos] = 10; pos = pos + 1;
        if (md5.Length > 0) { NativeMemory.Copy(bp + (nint)pos, (nint)md5, md5.Length); pos = pos + md5.Length; }
        buf[pos] = 10; pos = pos + 1;
        if (ct.Length > 0) { NativeMemory.Copy(bp + (nint)pos, (nint)ct, ct.Length); pos = pos + ct.Length; }
        buf[pos] = 10; pos = pos + 1;
        if (dt.Length > 0) { NativeMemory.Copy(bp + (nint)pos, (nint)dt, dt.Length); pos = pos + dt.Length; }
        buf[pos] = 10; pos = pos + 1;
        if (res.Length > 0) { NativeMemory.Copy(bp + (nint)pos, (nint)res, res.Length); }
        return NativeMemory.GetString(bp, 0, total);
    }

    // 计算签名（Base64 文本）。
    public static string Sign(string secretKey, string stringToSign) {
        if (secretKey == null || stringToSign == null) { return ""; }
        byte[] mac = OssSigner.HmacSha1(secretKey, stringToSign);
        if (mac == null) { return ""; }
        return OssSigner.Base64(mac);
    }

    // 一步生成 Authorization 头值。
    public static string Authorization(string accessKey, string secretKey, string verb,
                                       string contentType, string date, string bucket, string key) {
        string v = verb == null ? "" : verb;
        string ct = contentType == null ? "" : contentType;
        string dt = date == null ? "" : date;
        string b = bucket == null ? "" : bucket;
        string k = key == null ? "" : key;
        int resLen = 1 + b.Length + (k.Length > 0 ? (1 + k.Length) : 0);
        int stsLen = v.Length + 2 + ct.Length + 1 + dt.Length + 1 + resLen;
        byte[] sbuf = new byte[stsLen];
        nint sbp = (nint)sbuf;
        int pos = 0;
        if (v.Length > 0) { NativeMemory.Copy(sbp, (nint)v, v.Length); pos = v.Length; }
        sbuf[pos] = 10; sbuf[pos + 1] = 10; pos = pos + 2;
        if (ct.Length > 0) { NativeMemory.Copy(sbp + (nint)pos, (nint)ct, ct.Length); pos = pos + ct.Length; }
        sbuf[pos] = 10; pos = pos + 1;
        if (dt.Length > 0) { NativeMemory.Copy(sbp + (nint)pos, (nint)dt, dt.Length); pos = pos + dt.Length; }
        sbuf[pos] = 10; pos = pos + 1;
        sbuf[pos] = 47; pos = pos + 1;
        if (b.Length > 0) { NativeMemory.Copy(sbp + (nint)pos, (nint)b, b.Length); pos = pos + b.Length; }
        if (k.Length > 0) {
            sbuf[pos] = 47; pos = pos + 1;
            NativeMemory.Copy(sbp + (nint)pos, (nint)k, k.Length);
        }
        string sts = NativeMemory.GetString(sbp, 0, stsLen);
        string sig = AliyunOssSigner.Sign(secretKey, sts);
        string ak = accessKey == null ? "" : accessKey;
        int outLen = 4 + ak.Length + 1 + sig.Length;
        byte[] obuf = new byte[outLen];
        nint obp = (nint)obuf;
        NativeMemory.Copy(obp, (nint)"OSS ", 4);
        if (ak.Length > 0) { NativeMemory.Copy(obp + (nint)4, (nint)ak, ak.Length); }
        obuf[4 + ak.Length] = 58;
        if (sig.Length > 0) { NativeMemory.Copy(obp + (nint)(5 + ak.Length), (nint)sig, sig.Length); }
        return NativeMemory.GetString(obp, 0, outLen);
    }
}
