using System;

namespace Cloud.Oss;

/// <summary>分块上传中的单块元数据（块编号与服务端计算的 ETag）。</summary>
public class OssUploadPart {
    /// <summary>分块编号（从 1 开始，1 到 10000）。</summary>
    public int partNumber;
    /// <summary>该分块上传成功后服务端返回的 ETag。</summary>
    public string etag;

    public OssUploadPart(int partNumber, string etag) {
        this.partNumber = partNumber;
        this.etag = etag == null ? "" : etag;
    }
}
