using System;
using System.Collections.Generic;

namespace Cloud.Oss;

/// <summary>分块上传操作的复合回执，包含 UploadId 与分块列表。</summary>
public class OssMultipartResult : OssResult {
    /// <summary>本次分块上传唯一事务标识 UploadId。</summary>
    public string uploadId;
    /// <summary>已上传或已完成的分块清单。</summary>
    public List<OssUploadPart> parts;

    public OssMultipartResult() : base() {
        this.uploadId = "";
        this.parts = new List<OssUploadPart>();
    }

    /// <summary>构造初始化分块成功回执。</summary>
    public static OssMultipartResult Success(string uploadId) {
        OssMultipartResult r = new OssMultipartResult();
        r.ok = true;
        r.statusCode = 200;
        r.uploadId = uploadId == null ? "" : uploadId;
        return r;
    }
}
