using System;
using System.Net.Http;

namespace Cloud.Oss;

// 腾讯云 COS 客户端（XML API 签名，q-sign-algorithm=sha1）。
public class TencentCosClient : OssClient {
    public TencentCosClient(OssConfig cfg) : base(cfg) {
        // 端点留空时按 桶名.cos.区域.myqcloud.com 推导；{bucket} 占位由基类解析替换。
        if (this.config.endpoint == null || this.config.endpoint.Length == 0) {
            this.config.endpointHost = this.config.bucket + ".cos." + this.config.region + ".myqcloud.com";
            this.config.endpointPort = 443;
            this.config.endpointTls = true;
            this.config.hostHasBucket = true;
            this.config.pathStyle = false;
        }
    }

    public override string ProviderName() { return "tencent_cos"; }

    public override string HostName() {
        return this.config.endpointHost;
    }

    public override string RequestPath(string key) {
        string prefix = this.config.UsesBucketPrefix() ? "/" + OssSigner.Rfc3986(this.config.bucket) + "/" : "/";
        return (key == null || key.Length == 0) ? prefix : prefix + OssClient.EncodePathSegments(key);
    }

    public override string BucketRequestPath() {
        return this.RequestPath("");
    }

    // 参与签名的路径（路径风格含桶名前缀）。
    public override string SignPath(string key) {
        string k = key == null ? "" : key;
        if (this.config.UsesBucketPrefix()) { return this.config.bucket + "/" + k; }
        return k;
    }

    public override void SignRequest(HttpClient http, string method, string key,
                                     string contentType, byte[] body, long now) {
        this.SignRequestWithQuery(http, method, key, null, contentType, body, now);
    }

    public override void SignRequestWithQuery(HttpClient http, string method, string key,
                                             List<string> queryPairs, string contentType, byte[] body, long now) {
        string keyTime = TencentCosSigner.KeyTime(now, 900);
        http.SetHeader("Date", OssSigner.GmtDate(now));
        http.SetHeader("Authorization",
            TencentCosSigner.AuthorizationWithQuery(this.config.accessKey, this.config.secretKey,
                method, this.SignPath(key), queryPairs, keyTime));
    }

    public override string GeneratePresignedUrl(string key, long expiresSeconds = 900, string method = "GET") {
        if (key == null || key.Length == 0) { return ""; }
        string objKey = this.config.ObjectKey(key);
        long now = DateTime.UtcNow().ToUnixSeconds();
        int exp = expiresSeconds <= 0 ? 900 : (expiresSeconds > 2147483647L ? 2147483647 : (int)expiresSeconds);
        string keyTime = TencentCosSigner.KeyTime(now, exp);
        string authQuery = TencentCosSigner.AuthorizationWithQuery(
            this.config.accessKey, this.config.secretKey, method, this.SignPath(objKey), null, keyTime);
        return this.OriginUrl() + this.RequestPath(objKey) + "?" + authQuery;
    }

    public override string PublicUrlFor(string fullKey) {
        if (fullKey == null || fullKey.Length == 0) { return ""; }
        return this.OriginUrl() + this.RequestPath(fullKey);
    }
}
