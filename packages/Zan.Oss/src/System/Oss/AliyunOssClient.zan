using System;
using System.Net.Http;

namespace System.Oss;

/// <summary>阿里云 OSS 客户端（V1 签名）。
/// pathStyle=true 时走 https://端点/桶名/键 的路径风格（与站点现有行为一致）；
/// pathStyle=false 时走虚拟主机风格 https://桶名.端点/键。</summary>
public class AliyunOssClient : OssClient {
    public AliyunOssClient(OssConfig cfg) : base(cfg) { }

    public override string ProviderName() { return "aliyun_oss"; }

    public override string HostName() {
        if (this.config.pathStyle) { return this.config.endpointHost; }
        return this.config.bucket + "." + this.config.endpointHost;
    }

    public override string RequestPath(string key) {
        if (this.config.pathStyle) {
            if (key == null || key.Length == 0) { return "/" + this.config.bucket + "/"; }
            return "/" + this.config.bucket + "/" + key;
        }
        if (key == null || key.Length == 0) { return "/"; }
        return "/" + key;
    }

    public override string BucketRequestPath() {
        if (this.config.pathStyle) { return "/" + this.config.bucket + "/"; }
        return "/";
    }

    public override void SignRequest(HttpClient http, string method, string key,
                                     string contentType, byte[] body, long now) {
        string date = OssSigner.GmtDate(now);
        http.SetHeader("Date", date);
        string resource = "/" + this.config.bucket + "/" + (key == null ? "" : key);
        string sts = AliyunOssSigner.StringToSign(method, "", contentType, date, resource);
        string sig = AliyunOssSigner.Sign(this.config.secretKey, sts);
        http.SetHeader("Authorization", "OSS " + this.config.accessKey + ":" + sig);
    }

    public override string PublicUrlFor(string fullKey) {
        if (fullKey == null || fullKey.Length == 0) { return ""; }
        string scheme = this.config.endpointTls ? "https://" : "http://";
        return scheme + this.config.bucket + "." + this.config.endpointHost + "/" + fullKey;
    }
}
