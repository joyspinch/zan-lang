using System;

namespace System.Oss;

/// <summary>阿里云 OSS V1 签名。待签串固定为
/// VERB\nContent-MD5\nContent-Type\nDate\nCanonicalizedResource，
/// 签名 = Base64(HMAC-SHA1(AccessKeySecret, 待签串))，
/// 头值 = "OSS " + AccessKeyId + ":" + 签名。</summary>
public class AliyunOssSigner {
    /// <summary>构造待签串。contentMd5 可空（不上传 MD5 时留空串）。
    /// resource 是 "/桶名/对象键" 形式的规范化资源（不含 query）。</summary>
    public static string StringToSign(string verb, string contentMd5, string contentType,
                                      string date, string resource) {
        return verb + "\n"
            + (contentMd5 == null ? "" : contentMd5) + "\n"
            + (contentType == null ? "" : contentType) + "\n"
            + (date == null ? "" : date) + "\n"
            + (resource == null ? "" : resource);
    }

    /// <summary>计算签名（Base64 文本）。</summary>
    public static string Sign(string secretKey, string stringToSign) {
        if (secretKey == null || stringToSign == null) { return ""; }
        byte[] mac = OssSigner.HmacSha1(secretKey, stringToSign);
        if (mac == null) { return ""; }
        return OssSigner.Base64(mac);
    }

    /// <summary>一步算出 Authorization 头值。</summary>
    public static string Authorization(string accessKey, string secretKey, string verb,
                                       string contentType, string date, string bucket, string key) {
        string resource = "/" + (bucket == null ? "" : bucket);
        if (key != null && key.Length > 0) { resource = resource + "/" + key; }
        string sts = AliyunOssSigner.StringToSign(verb, "", contentType, date, resource);
        string sig = AliyunOssSigner.Sign(secretKey, sts);
        return "OSS " + (accessKey == null ? "" : accessKey) + ":" + sig;
    }
}
