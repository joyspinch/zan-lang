using System;
using System.Collections.Generic;

namespace Game.Particles;

// 曲线：归一化时间 [0, 1] → 值。用来驱动粒子的尺寸、透明度、颜色等
// "随寿命变化"的量。
//
// 关键帧按时间递增插入；Evaluate 对时间做**线性插值**（EvaluateSmooth 做
// 平滑插值），超出两端时钳到端点值。
public class Curve {
    public List<double> times;
    public List<double> values;

    public Curve() {
        this.times = new List<double>();
        this.values = new List<double>();
    }

    // 追加关键帧（时间必须递增——乱序会被忽略）。
    public void AddKey(double time, double value) {
        int count = this.times.Count;
        if (count > 0 && time <= this.times[count - 1]) { return; }
        this.times.Add(time);
        this.values.Add(value);
    }

    public bool IsEmpty() { return this.times.Count == 0; }
    public int Count() { return this.times.Count; }

    // 线性插值求值。
    public double Evaluate(double t) {
        int count = this.times.Count;
        if (count == 0) { return 0.0; }
        if (count == 1) { return this.values[0]; }
        if (t <= this.times[0]) { return this.values[0]; }
        if (t >= this.times[count - 1]) { return this.values[count - 1]; }
        for (int i = 1; i < count; i = i + 1) {
            if (t <= this.times[i]) {
                double t0 = this.times[i - 1];
                double t1 = this.times[i];
                double span = t1 - t0;
                if (span <= 0.0) { return this.values[i]; }
                double k = (t - t0) / span;
                return this.values[i - 1] + (this.values[i] - this.values[i - 1]) * k;
            }
        }
        return this.values[count - 1];
    }

    // 平滑插值求值（smoothstep：两端导数为 0，曲线在关键帧处不折角）。
    public double EvaluateSmooth(double t) {
        int count = this.times.Count;
        if (count == 0) { return 0.0; }
        if (count == 1) { return this.values[0]; }
        if (t <= this.times[0]) { return this.values[0]; }
        if (t >= this.times[count - 1]) { return this.values[count - 1]; }
        for (int i = 1; i < count; i = i + 1) {
            if (t <= this.times[i]) {
                double t0 = this.times[i - 1];
                double t1 = this.times[i];
                double span = t1 - t0;
                if (span <= 0.0) { return this.values[i]; }
                double k = (t - t0) / span;
                k = k * k * (3.0 - 2.0 * k);
                return this.values[i - 1] + (this.values[i] - this.values[i - 1]) * k;
            }
        }
        return this.values[count - 1];
    }
}
