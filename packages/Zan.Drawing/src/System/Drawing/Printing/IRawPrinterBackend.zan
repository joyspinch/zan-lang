using System;
using System.Diagnostics;
using System.IO;

namespace System.Drawing.Printing;

// RAW 打印状态机使用的后台打印程序操作。Open/StartDoc/
// StartPage/Write/EndPage/EndDoc/Close 按此顺序调用；失败路径用
// Abort 替代 EndDoc。一个文档一页一份数据的简化协议。
public interface IRawPrinterBackend {
    // 打开与打印机的连接；失败返回 false。
    public bool Open(string printerName);
    // 开始一个 RAW 文档；失败返回 false。
    public bool StartDoc(string documentName);
    // 开始一页；失败返回 false。
    public bool StartPage();
    // 写入一页数据，返回实际写入的字节数；失败返回 -1。
    public int Write(byte[] data);
    // 结束当前页；失败返回 false。
    public bool EndPage();
    // 正常结束文档并提交打印；失败返回 false。
    public bool EndDoc();
    // 放弃当前文档（StartDoc 成功而后续失败时替代 EndDoc）。
    public void Abort();
    // 关闭连接；关闭失败时整体结果按失败计。
    public bool Close();
}
