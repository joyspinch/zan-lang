using System;
using System.Diagnostics;
using System.IO;

namespace System.Drawing.Printing;

// 只读访问当前用户已安装的打印机。Windows 上走
// winspool（EnumPrintersW/GetDefaultPrinterW），Linux/macOS 上走 CUPS
// 的 lpstat。不含网络发现，仅本地与已连接打印机。
public class PrinterSettings {
    // 枚举本地打印机及打印机连接。列表可能为空
    // （无打印机或 lpstat 不可用），不为 null。
    public static List<string> InstalledPrinters() {
        #if WINDOWS
        return PrinterSettings.WinInstalledPrinters();
        #else
        List<string> printers = new List<string>();
        // lpstat -e 每行一个目的地名（含类和远程连接）。
        List<string> lpArgs = new List<string>();
        lpArgs.Add("-e");
        ProcessResult r = Process.CaptureSafe("lpstat", lpArgs);
        if (r.exitCode != 0) { return printers; }
        for (int i = 0; i < r.lines.Count; i = i + 1) {
            string name = r.lines[i].Trim();
            if (name != "") { printers.Add(name); }
        }
        return printers;
        #endif
    }

    // 返回默认打印机名称；未配置时返回空字符串。
    public static string DefaultPrinterName() {
        #if WINDOWS
        nint charsOut = NativeMemory.Alloc(4);
        string name = "";
        try {
            new Span<int>(charsOut, 1)[0] = 0;
            PrinterSettings.GetDefaultPrinterW(0, charsOut);
            int chars = new Span<int>(charsOut, 1)[0];
            if (chars > 0) {
                nint buffer = NativeMemory.Alloc(chars * 2);
                try {
                    int ok = PrinterSettings.GetDefaultPrinterW(buffer, charsOut);
                    if (ok != 0) { name = Wide.Read(buffer); }
                } finally {
                    NativeMemory.Free(buffer);
                }
            }
        } finally {
            NativeMemory.Free(charsOut);
        }
        return name;
        #else
        // "system default destination: name"，未配置时为
        List<string> lpArgs = new List<string>();
        lpArgs.Add("-d");
        ProcessResult r = Process.CaptureSafe("lpstat", lpArgs);
        if (r.exitCode != 0) { return ""; }
        for (int i = 0; i < r.lines.Count; i = i + 1) {
            string line = r.lines[i].Trim();
            int colon = line.IndexOf(":");
            if (colon < 0) { continue; }
            return line.Substring(colon + 1, line.Length - colon - 1).Trim();
        }
        return "";
        #endif
    }

    #if WINDOWS
    [DllImport("winspool", EntryPoint = "EnumPrintersW")]
    private static extern int EnumPrintersW(int flags, nint name, int level,
                                    nint buffer, int bufferBytes,
                                    nint neededBytes, nint returnedCount);

    [DllImport("winspool", EntryPoint = "GetDefaultPrinterW")]
    private static extern int GetDefaultPrinterW(nint buffer, nint chars);

    // EnumPrintersW（PRINTER_INFO_4）两段式枚举：先探缓冲区大小再取数据。
    private static List<string> WinInstalledPrinters() {
        List<string> printers = new List<string>();
        nint neededOut = NativeMemory.Alloc(4);
        nint countOut = NativeMemory.Alloc(4);
        try {
            new Span<int>(neededOut, 1)[0] = 0;
            new Span<int>(countOut, 1)[0] = 0;
            PrinterSettings.EnumPrintersW(6, 0, 4, 0, 0, neededOut, countOut);
            int needed = new Span<int>(neededOut, 1)[0];
            if (needed > 0) {
                nint buffer = NativeMemory.Alloc(needed);
                try {
                    int ok = PrinterSettings.EnumPrintersW(
                        6, 0, 4, buffer, needed, neededOut, countOut);
                    if (ok != 0) {
                        int count = new Span<int>(countOut, 1)[0];
                        // 在 Win64 目标上 PRINTER_INFO_4W 为 24 字节；pPrinterName 是
                        // 其第一个指针。
                        for (int i = 0; i < count; i = i + 1) {
                            nint name = new Span<nint>(buffer + i * 24, 1)[0];
                            if (name != 0) { printers.Add(Wide.Read(name)); }
                        }
                    }
                } finally {
                    NativeMemory.Free(buffer);
                }
            }
        } finally {
            NativeMemory.Free(countOut);
            NativeMemory.Free(neededOut);
        }
        return printers;
    }
    #endif
}
