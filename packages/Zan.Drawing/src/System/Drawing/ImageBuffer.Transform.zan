using System;

namespace System.Drawing;

public partial class ImageBuffer {
    // 水平镜像翻转（原地修改，零额外分配）。
    public void FlipHorizontal() {
        if (this.IsEmpty || this.Width <= 1) return;
        int w = this.Width;
        int half = w / 2;
        for (int y = 0; y < this.Height; y = y + 1) {
            Span<int> row = new Span<int>(this.Pixels + (nint)(y * this.Stride), w);
            for (int x = 0; x < half; x = x + 1) {
                int rx = w - 1 - x;
                int tmp = row[x];
                row[x] = row[rx];
                row[rx] = tmp;
            }
        }
    }

    // 垂直镜像翻转（原地按行交换）。
    public void FlipVertical() {
        if (this.IsEmpty || this.Height <= 1) return;
        int rowBytes = this.Width * 4;
        nint tmp = NativeMemory.Alloc(rowBytes);
        if (tmp == 0) return;
        try {
            int half = this.Height / 2;
            for (int y = 0; y < half; y = y + 1) {
                int ry = this.Height - 1 - y;
                nint top = this.Pixels + (nint)(y * this.Stride);
                nint bot = this.Pixels + (nint)(ry * this.Stride);
                NativeMemory.Copy(tmp, top, rowBytes);
                NativeMemory.Copy(top, bot, rowBytes);
                NativeMemory.Copy(bot, tmp, rowBytes);
            }
        } finally {
            NativeMemory.Free(tmp);
        }
    }

    // 顺时针旋转 90 度，返回新 ImageBuffer（宽高互换）。
    public ImageBuffer Rotate90() {
        if (this.IsEmpty) return new ImageBuffer(0, 0);
        int sw = this.Width;
        int sh = this.Height;
        ImageBuffer dst = new ImageBuffer(sh, sw);
        if (dst.Pixels == 0) return dst;
        Span<int> srcSp = new Span<int>(this.Pixels, sw * sh);
        Span<int> dstSp = new Span<int>(dst.Pixels, sw * sh);
        for (int y = 0; y < sh; y = y + 1) {
            int dstX = sh - 1 - y;
            int srcRow = y * sw;
            for (int x = 0; x < sw; x = x + 1) {
                dstSp[x * sh + dstX] = srcSp[srcRow + x];
            }
        }
        return dst;
    }

    // 旋转 180 度，返回新 ImageBuffer。
    public ImageBuffer Rotate180() {
        if (this.IsEmpty) return new ImageBuffer(0, 0);
        int count = this.Width * this.Height;
        ImageBuffer dst = new ImageBuffer(this.Width, this.Height);
        if (dst.Pixels == 0) return dst;
        Span<int> srcSp = new Span<int>(this.Pixels, count);
        Span<int> dstSp = new Span<int>(dst.Pixels, count);
        for (int i = 0; i < count; i = i + 1) {
            dstSp[count - 1 - i] = srcSp[i];
        }
        return dst;
    }

    // 顺时针旋转 270 度（逆时针 90 度），返回新 ImageBuffer。
    public ImageBuffer Rotate270() {
        if (this.IsEmpty) return new ImageBuffer(0, 0);
        int sw = this.Width;
        int sh = this.Height;
        ImageBuffer dst = new ImageBuffer(sh, sw);
        if (dst.Pixels == 0) return dst;
        Span<int> srcSp = new Span<int>(this.Pixels, sw * sh);
        Span<int> dstSp = new Span<int>(dst.Pixels, sw * sh);
        for (int y = 0; y < sh; y = y + 1) {
            int srcRow = y * sw;
            for (int x = 0; x < sw; x = x + 1) {
                dstSp[(sw - 1 - x) * sh + y] = srcSp[srcRow + x];
            }
        }
        return dst;
    }

    // 最近邻缩放（适合像素风与二维码无模糊放大）。
    public ImageBuffer ResizeNearest(int newWidth, int newHeight) {
        if (this.IsEmpty || newWidth <= 0 || newHeight <= 0) return new ImageBuffer(0, 0);
        ImageBuffer dst = new ImageBuffer(newWidth, newHeight);
        if (dst.Pixels == 0) return dst;
        int sw = this.Width;
        int sh = this.Height;
        Span<int> srcSp = new Span<int>(this.Pixels, sw * sh);
        Span<int> dstSp = new Span<int>(dst.Pixels, newWidth * newHeight);
        for (int dy = 0; dy < newHeight; dy = dy + 1) {
            int sy = (int)((long)dy * (long)sh / (long)newHeight);
            if (sy >= sh) sy = sh - 1;
            int srcRow = sy * sw;
            int dstRow = dy * newWidth;
            for (int dx = 0; dx < newWidth; dx = dx + 1) {
                int sx = (int)((long)dx * (long)sw / (long)newWidth);
                if (sx >= sw) sx = sw - 1;
                dstSp[dstRow + dx] = srcSp[srcRow + sx];
            }
        }
        return dst;
    }

    // 等比缩放至不超出 maxWidth x maxHeight 边框内。
    public ImageBuffer ResizeFit(int maxWidth, int maxHeight) {
        if (this.IsEmpty || maxWidth <= 0 || maxHeight <= 0) return new ImageBuffer(0, 0);
        double sx = (double)maxWidth / (double)this.Width;
        double sy = (double)maxHeight / (double)this.Height;
        double scale = sx < sy ? sx : sy;
        int nw = (int)((double)this.Width * scale + 0.5);
        int nh = (int)((double)this.Height * scale + 0.5);
        if (nw < 1) nw = 1;
        if (nh < 1) nh = 1;
        return this.ResizeLanczos(nw, nh);
    }

    // 等比缩放并居中裁切填满目标尺寸（封面/头像缩略图标准做法）。
    public ImageBuffer ResizeCover(int targetWidth, int targetHeight) {
        if (this.IsEmpty || targetWidth <= 0 || targetHeight <= 0) return new ImageBuffer(0, 0);
        double sx = (double)targetWidth / (double)this.Width;
        double sy = (double)targetHeight / (double)this.Height;
        double scale = sx > sy ? sx : sy;
        int sw = (int)((double)this.Width * scale + 0.5);
        int sh = (int)((double)this.Height * scale + 0.5);
        if (sw < targetWidth) sw = targetWidth;
        if (sh < targetHeight) sh = targetHeight;
        ImageBuffer scaled = this.ResizeLanczos(sw, sh);
        if (scaled.IsEmpty) return scaled;
        try {
            int cx = (sw - targetWidth) / 2;
            int cy = (sh - targetHeight) / 2;
            return scaled.Crop(cx, cy, targetWidth, targetHeight);
        } finally {
            scaled.Dispose();
        }
    }

    // 高质量可分离 Lanczos-3 缩放（先水平后垂直，适合大幅缩图保留锐度）。
    public ImageBuffer ResizeLanczos(int newWidth, int newHeight) {
        if (this.IsEmpty || newWidth <= 0 || newHeight <= 0) return new ImageBuffer(0, 0);
        if (newWidth == this.Width && newHeight == this.Height) return this.Clone();
        if (this.Width == 1 && this.Height == 1) {
            ImageBuffer single = new ImageBuffer(newWidth, newHeight);
            single.Clear(this.GetPixel(0, 0));
            return single;
        }

        int sw = this.Width;
        int sh = this.Height;
        ImageBuffer mid = new ImageBuffer(newWidth, sh);
        if (mid.Pixels == 0) return mid;
        try {
            ImageBuffer.LanczosPassH(this.Pixels, sw, sh, mid.Pixels, newWidth);
            ImageBuffer dst = new ImageBuffer(newWidth, newHeight);
            if (dst.Pixels == 0) return dst;
            ImageBuffer.LanczosPassV(mid.Pixels, newWidth, sh, dst.Pixels, newHeight);
            return dst;
        } finally {
            mid.Dispose();
        }
    }

    private static double Lanczos3(double x) {
        if (x < 0.0) x = -x;
        if (x < 1e-9) return 1.0;
        if (x >= 3.0) return 0.0;
        double piX = 3.14159265358979323846 * x;
        double piX3 = piX / 3.0;
        return (Math.Sin(piX) / piX) * (Math.Sin(piX3) / piX3);
    }

    private static void LanczosPassH(nint src, int sw, int sh, nint dst, int dw) {
        double ratio = (double)sw / (double)dw;
        double filterScale = ratio > 1.0 ? ratio : 1.0;
        double support = 3.0 * filterScale;
        int maxTaps = (int)(support * 2.0) + 4;
        int[] tapIdx = new int[maxTaps];
        double[] tapW = new double[maxTaps];
        Span<byte> srcB = new Span<byte>(src, sw * sh * 4);
        Span<byte> dstB = new Span<byte>(dst, dw * sh * 4);

        for (int dx = 0; dx < dw; dx = dx + 1) {
            double center = ((double)dx + 0.5) * ratio - 0.5;
            int left = (int)Math.Floor(center - support);
            int right = (int)Math.Ceiling(center + support);
            int taps = 0;
            double wSum = 0.0;
            for (int sx = left; sx <= right; sx = sx + 1) {
                int cx = sx;
                if (cx < 0) cx = 0;
                else if (cx >= sw) cx = sw - 1;
                double w = ImageBuffer.Lanczos3(((double)sx - center) / filterScale);
                if (w != 0.0 && taps < maxTaps) {
                    tapIdx[taps] = cx;
                    tapW[taps] = w;
                    wSum = wSum + w;
                    taps = taps + 1;
                }
            }
            if (wSum == 0.0) { wSum = 1.0; }
            double invSum = 1.0 / wSum;
            for (int t = 0; t < taps; t = t + 1) {
                tapW[t] = tapW[t] * invSum;
            }
            for (int y = 0; y < sh; y = y + 1) {
                int sRow = y * sw * 4;
                double sb = 0.0; double sg = 0.0; double sr = 0.0; double sa = 0.0;
                for (int t = 0; t < taps; t = t + 1) {
                    int off = sRow + tapIdx[t] * 4;
                    double w = tapW[t];
                    sb = sb + (double)srcB[off] * w;
                    sg = sg + (double)srcB[off + 1] * w;
                    sr = sr + (double)srcB[off + 2] * w;
                    sa = sa + (double)srcB[off + 3] * w;
                }
                int dOff = (y * dw + dx) * 4;
                dstB[dOff] = ImageBuffer.ClampByte(sb);
                dstB[dOff + 1] = ImageBuffer.ClampByte(sg);
                dstB[dOff + 2] = ImageBuffer.ClampByte(sr);
                dstB[dOff + 3] = ImageBuffer.ClampByte(sa);
            }
        }
    }

    private static void LanczosPassV(nint src, int w, int sh, nint dst, int dh) {
        double ratio = (double)sh / (double)dh;
        double filterScale = ratio > 1.0 ? ratio : 1.0;
        double support = 3.0 * filterScale;
        int maxTaps = (int)(support * 2.0) + 4;
        int[] tapIdx = new int[maxTaps];
        double[] tapW = new double[maxTaps];
        Span<byte> srcB = new Span<byte>(src, w * sh * 4);
        Span<byte> dstB = new Span<byte>(dst, w * dh * 4);

        for (int dy = 0; dy < dh; dy = dy + 1) {
            double center = ((double)dy + 0.5) * ratio - 0.5;
            int top = (int)Math.Floor(center - support);
            int bot = (int)Math.Ceiling(center + support);
            int taps = 0;
            double wSum = 0.0;
            for (int sy = top; sy <= bot; sy = sy + 1) {
                int cy = sy;
                if (cy < 0) cy = 0;
                else if (cy >= sh) cy = sh - 1;
                double w = ImageBuffer.Lanczos3(((double)sy - center) / filterScale);
                if (w != 0.0 && taps < maxTaps) {
                    tapIdx[taps] = cy;
                    tapW[taps] = w;
                    wSum = wSum + w;
                    taps = taps + 1;
                }
            }
            if (wSum == 0.0) { wSum = 1.0; }
            double invSum = 1.0 / wSum;
            for (int t = 0; t < taps; t = t + 1) {
                tapW[t] = tapW[t] * invSum;
            }
            int dRow = dy * w * 4;
            for (int x = 0; x < w; x = x + 1) {
                double sb = 0.0; double sg = 0.0; double sr = 0.0; double sa = 0.0;
                int xOff = x * 4;
                for (int t = 0; t < taps; t = t + 1) {
                    int off = tapIdx[t] * w * 4 + xOff;
                    double w = tapW[t];
                    sb = sb + (double)srcB[off] * w;
                    sg = sg + (double)srcB[off + 1] * w;
                    sr = sr + (double)srcB[off + 2] * w;
                    sa = sa + (double)srcB[off + 3] * w;
                }
                int dOff = dRow + xOff;
                dstB[dOff] = ImageBuffer.ClampByte(sb);
                dstB[dOff + 1] = ImageBuffer.ClampByte(sg);
                dstB[dOff + 2] = ImageBuffer.ClampByte(sr);
                dstB[dOff + 3] = ImageBuffer.ClampByte(sa);
            }
        }
    }

    // 调整对比度（contrastPercent: -100..100，0 不变）。保留 Alpha。
    public void AdjustContrast(int contrastPercent) {
        if (this.IsEmpty || contrastPercent == 0) return;
        if (contrastPercent < -100) contrastPercent = -100;
        if (contrastPercent > 100) contrastPercent = 100;
        double f = (100.0 + (double)contrastPercent) / 100.0;
        f = f * f;
        int factor256 = (int)(f * 256.0 + 0.5);
        int count = this.Width * this.Height;
        Span<byte> sp = new Span<byte>(this.Pixels, count * 4);
        int off = 0;
        for (int i = 0; i < count; i = i + 1) {
            sp[off] = ImageBuffer.ClampInt((((int)sp[off] - 128) * factor256 >> 8) + 128);
            sp[off + 1] = ImageBuffer.ClampInt((((int)sp[off + 1] - 128) * factor256 >> 8) + 128);
            sp[off + 2] = ImageBuffer.ClampInt((((int)sp[off + 2] - 128) * factor256 >> 8) + 128);
            off = off + 4;
        }
    }

    // 调整饱和度（saturationPercent: -100 为完全灰度，0 不变，100 为加倍饱和）。保留 Alpha。
    public void AdjustSaturation(int saturationPercent) {
        if (this.IsEmpty || saturationPercent == 0) return;
        if (saturationPercent < -100) saturationPercent = -100;
        if (saturationPercent > 200) saturationPercent = 200;
        int s256 = (100 + saturationPercent) * 256 / 100;
        int count = this.Width * this.Height;
        Span<byte> sp = new Span<byte>(this.Pixels, count * 4);
        int off = 0;
        for (int i = 0; i < count; i = i + 1) {
            int b = (int)sp[off];
            int g = (int)sp[off + 1];
            int r = (int)sp[off + 2];
            int lum = (b * 29 + g * 150 + r * 77) >> 8;
            sp[off] = ImageBuffer.ClampInt(lum + (((b - lum) * s256) >> 8));
            sp[off + 1] = ImageBuffer.ClampInt(lum + (((g - lum) * s256) >> 8));
            sp[off + 2] = ImageBuffer.ClampInt(lum + (((r - lum) * s256) >> 8));
            off = off + 4;
        }
    }

    // 复古棕褐色滤镜（Sepia），保留 Alpha。
    public void Sepia() {
        if (this.IsEmpty) return;
        int count = this.Width * this.Height;
        Span<byte> sp = new Span<byte>(this.Pixels, count * 4);
        int off = 0;
        for (int i = 0; i < count; i = i + 1) {
            int b = (int)sp[off];
            int g = (int)sp[off + 1];
            int r = (int)sp[off + 2];
            int nr = (r * 101 + g * 197 + b * 48) >> 8;
            int ng = (r * 89 + g * 176 + b * 43) >> 8;
            int nb = (r * 70 + g * 137 + b * 34) >> 8;
            sp[off] = ImageBuffer.ClampInt(nb);
            sp[off + 1] = ImageBuffer.ClampInt(ng);
            sp[off + 2] = ImageBuffer.ClampInt(nr);
            off = off + 4;
        }
    }

    // 3x3 锐化滤镜（strength: 1..100），保留 Alpha。
    public void Sharpen(int strength) {
        if (this.IsEmpty || this.Width < 3 || this.Height < 3 || strength <= 0) return;
        if (strength > 100) strength = 100;
        int w = this.Width;
        int h = this.Height;
        int totalBytes = w * h * 4;
        nint copy = NativeMemory.Alloc(totalBytes);
        if (copy == 0) return;
        try {
            NativeMemory.Copy(copy, this.Pixels, totalBytes);
            Span<byte> src = new Span<byte>(copy, totalBytes);
            Span<byte> dst = new Span<byte>(this.Pixels, totalBytes);
            int k256 = strength * 256 / 100;
            for (int y = 1; y < h - 1; y = y + 1) {
                for (int x = 1; x < w - 1; x = x + 1) {
                    int c = (y * w + x) * 4;
                    int l = c - 4;
                    int r = c + 4;
                    int u = c - w * 4;
                    int d = c + w * 4;
                    for (int ch = 0; ch < 3; ch = ch + 1) {
                        int cv = (int)src[c + ch];
                        int lap = cv * 4 - (int)src[l + ch] - (int)src[r + ch]
                                - (int)src[u + ch] - (int)src[d + ch];
                        dst[c + ch] = ImageBuffer.ClampInt(cv + ((lap * k256) >> 8));
                    }
                }
            }
        } finally {
            NativeMemory.Free(copy);
        }
    }

    private static byte ClampByte(double v) {
        int iv = (int)(v + 0.5);
        if (iv < 0) return 0;
        if (iv > 255) return 255;
        return (byte)iv;
    }

    private static byte ClampInt(int v) {
        if (v < 0) return 0;
        if (v > 255) return 255;
        return (byte)v;
    }
}
