using System;
using System.Runtime.Intrinsics;

namespace System.Drawing;

// 纯 Zan 自举的托管 32 位 ARGB 图像缓冲区。
// 封装内存管理、边界安全与高性能图像处理流水线（Crop、Resize、Blit、Fill）。
// 所有热路径计算全部下沉至底层物理原语（NativeMemory.Copy2D 与 PixelOps），
// 杜绝 C 业务胶水依赖，具备工业级运行效率。
public partial class ImageBuffer : IDisposable {
    public int Width;
    public int Height;
    public int Stride;
    public nint Pixels;

    public ImageBuffer(int width, int height) {
        if (width <= 0 || height <= 0) {
            this.Width = 0;
            this.Height = 0;
            this.Stride = 0;
            this.Pixels = 0;
            return;
        }
        long stride64 = (long)width * 4L;
        long bytes64 = stride64 * (long)height;
        if (stride64 > 2147483647L || bytes64 <= 0L || bytes64 > 2147483647L) {
            this.Width = 0;
            this.Height = 0;
            this.Stride = 0;
            this.Pixels = 0;
            return;
        }
        this.Width = width;
        this.Height = height;
        this.Stride = (int)stride64;
        this.Pixels = NativeMemory.Alloc((int)bytes64);
    }

    public void Dispose() {
        if (this.Pixels != 0) {
            NativeMemory.Free(this.Pixels);
            this.Pixels = 0;
        }
    }

    // 以指定 32 位 ARGB 颜色清空图像。
    public void Clear(int color) {
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0) return;
        PixelOps.FillRect(this.Pixels, this.Stride, 0, 0, this.Width, this.Height, color);
    }

    // 在指定矩形区域填充 32 位 ARGB 颜色（自动边界裁剪）。
    public void FillRect(int x, int y, int w, int h, int color) {
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0 || w <= 0 || h <= 0) return;
        long x0 = (long)x;
        long y0 = (long)y;
        long x1 = x0 + (long)w;
        long y1 = y0 + (long)h;
        if (x0 < 0L) { x0 = 0L; }
        if (y0 < 0L) { y0 = 0L; }
        if (x1 > (long)this.Width) { x1 = (long)this.Width; }
        if (y1 > (long)this.Height) { y1 = (long)this.Height; }
        if (x1 <= x0 || y1 <= y0) return;

        PixelOps.FillRect(this.Pixels, this.Stride, (int)x0, (int)y0, (int)(x1 - x0), (int)(y1 - y0), color);
    }

    // 裁剪子区域并返回新的 ImageBuffer（由 Copy2D 物理加速，零冗余遍历）。
    public ImageBuffer Crop(int x, int y, int w, int h) {
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0 || w <= 0 || h <= 0) return new ImageBuffer(0, 0);
        long x0 = (long)x;
        long y0 = (long)y;
        long x1 = x0 + (long)w;
        long y1 = y0 + (long)h;
        if (x0 < 0L) { x0 = 0L; }
        if (y0 < 0L) { y0 = 0L; }
        if (x1 > (long)this.Width) { x1 = (long)this.Width; }
        if (y1 > (long)this.Height) { y1 = (long)this.Height; }
        if (x1 <= x0 || y1 <= y0) return new ImageBuffer(0, 0);

        int cx = (int)x0;
        int cy = (int)y0;
        int cw = (int)(x1 - x0);
        int ch = (int)(y1 - y0);
        ImageBuffer sub = new ImageBuffer(cw, ch);
        if (sub.Pixels == 0) { return sub; }
        nint srcOff = this.Pixels + (nint)((long)cy * (long)this.Stride + (long)cx * 4L);
        NativeMemory.Copy2D(sub.Pixels, sub.Stride, srcOff, this.Stride, cw * 4, ch);
        return sub;
    }

    // 双线性重采样拉伸到目标尺寸（由 ResampleBilinearRow 向量化物理加速）。
    public ImageBuffer Resize(int newWidth, int newHeight) {
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0 || newWidth <= 0 || newHeight <= 0) {
            return new ImageBuffer(0, 0);
        }

        ImageBuffer dst = new ImageBuffer(newWidth, newHeight);
        if (dst.Pixels == 0) { return dst; }
        if (this.Width == 1 && this.Height == 1) {
            Span<int> sp = new Span<int>(this.Pixels, 1);
            dst.Clear(sp[0]);
            return dst;
        }
        if (this.Width == 1) {
            // 单列源图：仅做垂直线性插值并整行填充，避免 ResampleBilinearRow 越界读取 sx+1。
            Span<int> col = new Span<int>(this.Pixels, this.Height);
            for (int dy = 0; dy < newHeight; dy++) {
                int fpY = (int)(((long)dy * (long)(this.Height - 1) << 16) / (long)(newHeight > 1 ? newHeight - 1 : 1));
                int sy = fpY >> 16;
                int wy = (fpY & 0xFFFF) >> 8;
                if (sy >= this.Height - 1) { sy = this.Height - 2; wy = 256; }
                if (sy < 0) { sy = 0; wy = 0; }
                int c0 = col[sy];
                int c1 = col[sy + 1];
                int inv = 256 - wy;
                int a = ((((c0 >> 24) & 255) * inv) + (((c1 >> 24) & 255) * wy)) >> 8;
                int r = ((((c0 >> 16) & 255) * inv) + (((c1 >> 16) & 255) * wy)) >> 8;
                int g = ((((c0 >> 8) & 255) * inv) + (((c1 >> 8) & 255) * wy)) >> 8;
                int b = (((c0 & 255) * inv) + ((c1 & 255) * wy)) >> 8;
                int color = (a << 24) | (r << 16) | (g << 8) | b;
                PixelOps.FillRect(dst.Pixels, dst.Stride, 0, dy, newWidth, 1, color);
            }
            return dst;
        }

        nint xIdxBuf = NativeMemory.Alloc(newWidth * 4);
        nint xWeightBuf = NativeMemory.Alloc(newWidth * 4);
        try {
            Span<int> xIndices = new Span<int>(xIdxBuf, newWidth);
            Span<int> xWeights = new Span<int>(xWeightBuf, newWidth);

            // 预计算 X 轴坐标与插值权重 (16.16 定点数)
            for (int dx = 0; dx < newWidth; dx++) {
                int fp = (int)(((long)dx * (long)(this.Width - 1) << 16) / (long)(newWidth > 1 ? newWidth - 1 : 1));
                int sx = fp >> 16;
                int wx = (fp & 0xFFFF) >> 8;  // 0..256
                if (sx >= this.Width - 1) {
                    sx = this.Width - 2;
                    wx = 256;
                }
                if (sx < 0) {
                    sx = 0;
                    wx = 0;
                }
                xIndices[dx] = sx;
                xWeights[dx] = wx;
            }

            // 逐行调度物理插值微内核（Height == 1 时 sy1 钳位为 sy，避免 src1 越界一行）。
            for (int dy = 0; dy < newHeight; dy++) {
                int fpY = (int)(((long)dy * (long)(this.Height - 1) << 16) / (long)(newHeight > 1 ? newHeight - 1 : 1));
                int sy = fpY >> 16;
                int wy = (fpY & 0xFFFF) >> 8;  // 0..256
                if (sy >= this.Height - 1) {
                    sy = this.Height - 2;
                    wy = 256;
                }
                if (sy < 0) {
                    sy = 0;
                    wy = 0;
                }
                int sy1 = (sy + 1 < this.Height) ? (sy + 1) : sy;

                nint src0 = this.Pixels + (nint)((long)sy * (long)this.Stride);
                nint src1 = this.Pixels + (nint)((long)sy1 * (long)this.Stride);
                nint dstRow = dst.Pixels + (nint)((long)dy * (long)dst.Stride);

                PixelOps.ResampleBilinearRow(dstRow, src0, src1, xIdxBuf, xWeightBuf, wy, newWidth);
            }
        } finally {
            NativeMemory.Free(xIdxBuf);
            NativeMemory.Free(xWeightBuf);
        }
        return dst;
    }

    // 将另一个 ImageBuffer 绘制到当前图像（支持直接覆盖与 Porter-Duff Over 混合）。
    public void Blit(ImageBuffer src, int dx, int dy, bool alphaBlend) {
        if (src == null || src.Pixels == 0 || src.Width <= 0 || src.Height <= 0) return;
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0) return;

        long dx0 = (long)dx;
        long dy0 = (long)dy;
        long dx1 = dx0 + (long)src.Width;
        long dy1 = dy0 + (long)src.Height;
        long sx0 = 0L;
        long sy0 = 0L;
        if (dx0 < 0L) {
            sx0 = -dx0;
            dx0 = 0L;
        }
        if (dy0 < 0L) {
            sy0 = -dy0;
            dy0 = 0L;
        }
        if (dx1 > (long)this.Width) {
            dx1 = (long)this.Width;
        }
        if (dy1 > (long)this.Height) {
            dy1 = (long)this.Height;
        }
        long cw = dx1 - dx0;
        long ch = dy1 - dy0;
        if (cw <= 0L || ch <= 0L) return;

        int sx = (int)sx0;
        int sy = (int)sy0;
        int cdx = (int)dx0;
        int cdy = (int)dy0;
        int w = (int)cw;
        int h = (int)ch;

        if (!alphaBlend) {
            nint dOff = this.Pixels + (nint)((long)cdy * (long)this.Stride + (long)cdx * 4L);
            nint sOff = src.Pixels + (nint)((long)sy * (long)src.Stride + (long)sx * 4L);
            NativeMemory.Copy2D(dOff, this.Stride, sOff, src.Stride, w * 4, h);
        } else {
            for (int r = 0; r < h; r++) {
                nint dRow = this.Pixels + (nint)((long)(cdy + r) * (long)this.Stride + (long)cdx * 4L);
                nint sRow = src.Pixels + (nint)((long)(sy + r) * (long)src.Stride + (long)sx * 4L);
                PixelOps.BlendOver(dRow, sRow, w);
            }
        }
    }

    // 带整图透明度缩放（opacity: 0..100）的 Porter-Duff Over 合成（供图片水印叠加使用）。
    public void Blit(ImageBuffer src, int dx, int dy, int opacityPercent) {
        if (src == null || src.Pixels == 0 || src.Width <= 0 || src.Height <= 0) return;
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0 || opacityPercent <= 0) return;
        if (opacityPercent > 100) opacityPercent = 100;
        int alphaScale = (opacityPercent * 255 + 50) / 100;
        System.Drawing.Imaging.ImageCodec.BlitArgb(
            this.Pixels, this.Width, this.Height,
            src.Pixels, src.Width, src.Height,
            dx, dy, alphaScale);
    }

    // 将当前图像的通道在 RGBA 与 BGRA 之间翻转。
    public void SwapRB() {
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0) return;
        PixelOps.SwapRB(this.Pixels, this.Pixels, this.Width * this.Height);
    }

    // 调整整幅图像的明暗度（delta 为 -255..255）。基于 AVX2 饱和加减硬件指令，保留 Alpha 通道不变。
    public void AdjustBrightness(int delta) {
        if (this.Pixels == 0 || delta == 0) return;
        int totalBytes = this.Width * this.Height * 4;
        int i = 0;
        if (delta > 0) {
            int dv = delta > 255 ? 255 : delta;
            int maskInt = (dv << 16) | (dv << 8) | dv;
            Vector256 d256 = Vector256.Create(maskInt);
            Vector128 d128 = Vector128.Create(maskInt);
            while (i + 32 <= totalBytes) {
                Vector256 v = Vector256.Load(this.Pixels + (nint)i);
                Vector256 sat = Vector256.AddSaturate(v, d256);
                Vector256.Store(this.Pixels + (nint)i, sat);
                i = i + 32;
            }
            while (i + 16 <= totalBytes) {
                Vector128 v = Vector128.Load(this.Pixels + (nint)i);
                Vector128 sat = Vector128.AddSaturate(v, d128);
                Vector128.Store(this.Pixels + (nint)i, sat);
                i = i + 16;
            }
            Span<byte> sp = new Span<byte>(this.Pixels, totalBytes);
            while (i + 3 < totalBytes) {
                int b = (int)sp[i] + dv;
                int g = (int)sp[i + 1] + dv;
                int r = (int)sp[i + 2] + dv;
                sp[i] = (byte)(b > 255 ? 255 : b);
                sp[i + 1] = (byte)(g > 255 ? 255 : g);
                sp[i + 2] = (byte)(r > 255 ? 255 : r);
                i = i + 4;
            }
        } else {
            int pos = -delta;
            int dv = pos > 255 ? 255 : pos;
            int maskInt = (dv << 16) | (dv << 8) | dv;
            Vector256 d256 = Vector256.Create(maskInt);
            Vector128 d128 = Vector128.Create(maskInt);
            while (i + 32 <= totalBytes) {
                Vector256 v = Vector256.Load(this.Pixels + (nint)i);
                Vector256 sat = Vector256.SubtractSaturate(v, d256);
                Vector256.Store(this.Pixels + (nint)i, sat);
                i = i + 32;
            }
            while (i + 16 <= totalBytes) {
                Vector128 v = Vector128.Load(this.Pixels + (nint)i);
                Vector128 sat = Vector128.SubtractSaturate(v, d128);
                Vector128.Store(this.Pixels + (nint)i, sat);
                i = i + 16;
            }
            Span<byte> sp = new Span<byte>(this.Pixels, totalBytes);
            while (i + 3 < totalBytes) {
                int b = (int)sp[i] - dv;
                int g = (int)sp[i + 1] - dv;
                int r = (int)sp[i + 2] - dv;
                sp[i] = (byte)(b < 0 ? 0 : b);
                sp[i + 1] = (byte)(g < 0 ? 0 : g);
                sp[i + 2] = (byte)(r < 0 ? 0 : r);
                i = i + 4;
            }
        }
    }

    // 50% 均值混合（基于 AVX2 vpavgb 32 字节并行硬件指令）。
    public void Blend50(ImageBuffer other) {
        if (this.Pixels == 0 || other == null || other.Pixels == 0) return;
        int count = this.Width * this.Height;
        if (other.Width * other.Height < count) count = other.Width * other.Height;
        int totalBytes = count * 4;
        int i = 0;
        while (i + 32 <= totalBytes) {
            Vector256 v1 = Vector256.Load(this.Pixels + (nint)i);
            Vector256 v2 = Vector256.Load(other.Pixels + (nint)i);
            Vector256 avg = Vector256.Average(v1, v2);
            Vector256.Store(this.Pixels + (nint)i, avg);
            i = i + 32;
        }
        while (i + 16 <= totalBytes) {
            Vector128 v1 = Vector128.Load(this.Pixels + (nint)i);
            Vector128 v2 = Vector128.Load(other.Pixels + (nint)i);
            Vector128 avg = Vector128.Average(v1, v2);
            Vector128.Store(this.Pixels + (nint)i, avg);
            i = i + 16;
        }
        Span<byte> s1 = new Span<byte>(this.Pixels, totalBytes);
        Span<byte> s2 = new Span<byte>(other.Pixels, totalBytes);
        while (i < totalBytes) {
            s1[i] = (byte)(((int)s1[i] + (int)s2[i] + 1) / 2);
            i = i + 1;
        }
    }

    // 变暗混合（Min 滤镜，基于 AVX2 vpminub 32 字节并行硬件指令）。
    public void Darken(ImageBuffer other) {
        if (this.Pixels == 0 || other == null || other.Pixels == 0) return;
        int count = this.Width * this.Height;
        if (other.Width * other.Height < count) count = other.Width * other.Height;
        int totalBytes = count * 4;
        int i = 0;
        while (i + 32 <= totalBytes) {
            Vector256 v1 = Vector256.Load(this.Pixels + (nint)i);
            Vector256 v2 = Vector256.Load(other.Pixels + (nint)i);
            Vector256 r = Vector256.Min(v1, v2);
            Vector256.Store(this.Pixels + (nint)i, r);
            i = i + 32;
        }
        while (i + 16 <= totalBytes) {
            Vector128 v1 = Vector128.Load(this.Pixels + (nint)i);
            Vector128 v2 = Vector128.Load(other.Pixels + (nint)i);
            Vector128 r = Vector128.Min(v1, v2);
            Vector128.Store(this.Pixels + (nint)i, r);
            i = i + 16;
        }
        Span<byte> s1 = new Span<byte>(this.Pixels, totalBytes);
        Span<byte> s2 = new Span<byte>(other.Pixels, totalBytes);
        while (i < totalBytes) {
            s1[i] = s1[i] < s2[i] ? s1[i] : s2[i];
            i = i + 1;
        }
    }

    // 变亮混合（Max 滤镜，基于 AVX2 vpmaxub 32 字节并行硬件指令）。
    public void Lighten(ImageBuffer other) {
        if (this.Pixels == 0 || other == null || other.Pixels == 0) return;
        int count = this.Width * this.Height;
        if (other.Width * other.Height < count) count = other.Width * other.Height;
        int totalBytes = count * 4;
        int i = 0;
        while (i + 32 <= totalBytes) {
            Vector256 v1 = Vector256.Load(this.Pixels + (nint)i);
            Vector256 v2 = Vector256.Load(other.Pixels + (nint)i);
            Vector256 r = Vector256.Max(v1, v2);
            Vector256.Store(this.Pixels + (nint)i, r);
            i = i + 32;
        }
        while (i + 16 <= totalBytes) {
            Vector128 v1 = Vector128.Load(this.Pixels + (nint)i);
            Vector128 v2 = Vector128.Load(other.Pixels + (nint)i);
            Vector128 r = Vector128.Max(v1, v2);
            Vector128.Store(this.Pixels + (nint)i, r);
            i = i + 16;
        }
        Span<byte> s1 = new Span<byte>(this.Pixels, totalBytes);
        Span<byte> s2 = new Span<byte>(other.Pixels, totalBytes);
        while (i < totalBytes) {
            s1[i] = s1[i] > s2[i] ? s1[i] : s2[i];
            i = i + 1;
        }
    }

    // 颜色反相（基于 AVX2 32 字节并行 XOR 硬件流水线，保留 Alpha 通道不变）。
    public void Invert() {
        if (this.Pixels == 0) return;
        int totalBytes = this.Width * this.Height * 4;
        int i = 0;
        Vector256 rgb256 = Vector256.Create(0x00FFFFFF);
        Vector128 rgb128 = Vector128.Create(0x00FFFFFF);
        while (i + 32 <= totalBytes) {
            Vector256 v = Vector256.Load(this.Pixels + (nint)i);
            Vector256 inv = Vector256.Xor(v, rgb256);
            Vector256.Store(this.Pixels + (nint)i, inv);
            i = i + 32;
        }
        while (i + 16 <= totalBytes) {
            Vector128 v = Vector128.Load(this.Pixels + (nint)i);
            Vector128 inv = Vector128.Xor(v, rgb128);
            Vector128.Store(this.Pixels + (nint)i, inv);
            i = i + 16;
        }
        Span<byte> sp = new Span<byte>(this.Pixels, totalBytes);
        while (i + 3 < totalBytes) {
            sp[i] = (byte)(sp[i] ^ 255);
            sp[i + 1] = (byte)(sp[i + 1] ^ 255);
            sp[i + 2] = (byte)(sp[i + 2] ^ 255);
            i = i + 4;
        }
    }

    // 灰度化（原生 C11 定点数单遍融合，保留 Alpha 通道不变）。
    public void Grayscale() {
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0) return;
        System.Drawing.Imaging.ImageCodec.ColorAdjustArgb(this.Pixels, this.Width * this.Height, 0, 0, true);
    }

    // 高性能双向可分离均值盒式模糊（原生 C11 行主序 O(1) 滑窗实现，消除列遍历 Cache 抖动）。
    public void BoxBlur(int radius) {
        if (this.Pixels == 0 || this.Width <= 1 || this.Height <= 1 || radius <= 0) return;
        System.Drawing.Imaging.ImageCodec.BoxBlurArgb(this.Pixels, this.Width, this.Height, radius, 1);
    }

    // 快速近似高斯模糊（原生 C11 三遍行主序可分离盒式滤波，商用毛玻璃与柔化首选）。
    public void GaussianBlur(int radius) {
        if (this.Pixels == 0 || this.Width <= 1 || this.Height <= 1 || radius <= 0) return;
        System.Drawing.Imaging.ImageCodec.BoxBlurArgb(this.Pixels, this.Width, this.Height, radius, 3);
    }
}
