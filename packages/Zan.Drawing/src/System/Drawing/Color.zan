using System;

namespace System.Drawing;

// 表示一个包含 RGBA 分量的颜色。分量取 0..255；
// 整型颜色约定见 <see cref="Chart.Rgb"/>（0xFFRRGGBB）。
public class Color {
    public int r;
    public int g;
    public int b;
    public int a;

    // 从 RGB 分量构造不透明颜色（alpha 固定 255）。分量取 0..255。
    public static Color FromRGB(int r, int g, int b) {
        Color c = new Color();
        c.r = r;
        c.g = g;
        c.b = b;
        c.a = 255;
        return c;
    }

    // 从 ARGB 分量构造颜色（a=0 全透明，a=255 不透明）。
    public static Color FromARGB(int a, int r, int g, int b) {
        Color c = new Color();
        c.r = r;
        c.g = g;
        c.b = b;
        c.a = a;
        return c;
    }

    // 打包为 Windows COLORREF（0x00BBGGRR），供原生 API 直接使用。
    public int ToColorRef() {
        return r + g * 256 + b * 65536;
    }

    // 不透明红。
    public static Color Red() { return Color.FromRGB(255, 0, 0); }
    // 不透明绿。
    public static Color Green() { return Color.FromRGB(0, 255, 0); }
    // 不透明蓝。
    public static Color Blue() { return Color.FromRGB(0, 0, 255); }
    // 不透明白。
    public static Color White() { return Color.FromRGB(255, 255, 255); }
    // 不透明黑。
    public static Color Black() { return Color.FromRGB(0, 0, 0); }
    // 不透明灰（128,128,128）。
    public static Color Gray() { return Color.FromRGB(128, 128, 128); }
    // 不透明黄。
    public static Color Yellow() { return Color.FromRGB(255, 255, 0); }
    // 不透明青。
    public static Color Cyan() { return Color.FromRGB(0, 255, 255); }
    // 不透明品红。
    public static Color Magenta() { return Color.FromRGB(255, 0, 255); }
    // 不透明橙（255,165,0）。
    public static Color Orange() { return Color.FromRGB(255, 165, 0); }
}
