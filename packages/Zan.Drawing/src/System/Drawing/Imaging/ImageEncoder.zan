    // 启动期一次性预构建（只读、天然多线程安全）
    private static uint[] Crc32Table = ImageEncoder.MakeCrc32Table();
    private static uint[] DefLitCode = ImageEncoder.MakeDefLitCode();
    private static int[] DefLitBits = ImageEncoder.MakeDefLitBits();
    private static uint[] DefDistRev = ImageEncoder.MakeDefDistRev();
    private static JpgHuffTable HuffDcLum = ImageEncoder.BuildJpgHuff(ImageEncoder.DcLumBits, ImageEncoder.DcLumVals);
    private static JpgHuffTable HuffDcChr = ImageEncoder.BuildJpgHuff(ImageEncoder.DcChrBits, ImageEncoder.DcChrVals);
    private static JpgHuffTable HuffAcLum = ImageEncoder.BuildJpgHuff(ImageEncoder.AcLumBits, ImageEncoder.AcLumVals);
    private static JpgHuffTable HuffAcChr = ImageEncoder.BuildJpgHuff(ImageEncoder.AcChrBits, ImageEncoder.AcChrVals);

    private static bool DimensionsOk(int w, int h) {
        if (w <= 0 || h <= 0 || w > 32768 || h > 32768) return false;
        return (long)w * (long)h * 4L <= 2147483591L;
    }

    private static uint BitRev(uint v, int bits) {
        uint r = 0u;
        for (int i = 0; i < bits; i = i + 1) {
            r = (r << 1) | (v & 1u);
            v = v >> 1;
        }
        return r;
    }

    private static uint[] MakeCrc32Table() {
        uint[] tbl = new uint[256];
        for (uint i = 0u; i < 256u; i = i + 1u) {
            uint c = i;
            for (int k = 0; k < 8; k = k + 1) {
                c = (c & 1u) != 0u ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
            }
            tbl[(int)i] = c;
        }
        return tbl;
    }

    private static uint[] MakeDefLitCode() {
        uint[] codes = new uint[288];
        for (int sym = 0; sym < 288; sym = sym + 1) {
            if (sym <= 143) {
                codes[sym] = ImageEncoder.BitRev((uint)(0x30 + sym), 8);
            } else if (sym <= 255) {
                codes[sym] = ImageEncoder.BitRev((uint)(0x190 + (sym - 144)), 9);
            } else if (sym <= 279) {
                codes[sym] = ImageEncoder.BitRev((uint)(sym - 256), 7);
            } else {
                codes[sym] = ImageEncoder.BitRev((uint)(0xC0 + (sym - 280)), 8);
            }
        }
        return codes;
    }

    private static int[] MakeDefLitBits() {
        int[] bits = new int[288];
        for (int sym = 0; sym < 288; sym = sym + 1) {
            if (sym <= 143) bits[sym] = 8;
            else if (sym <= 255) bits[sym] = 9;
            else if (sym <= 279) bits[sym] = 7;
            else bits[sym] = 8;
        }
        return bits;
    }

    private static uint[] MakeDefDistRev() {
        uint[] rev = new uint[30];
        for (int i = 0; i < 30; i = i + 1) {
            rev[i] = ImageEncoder.BitRev((uint)i, 5);
        }
        return rev;
    }

    private static JpgHuffTable BuildJpgHuff(byte[] bits, byte[] vals) {
        JpgHuffTable h = new JpgHuffTable();
        h.Code = new int[256];
        h.Size = new int[256];
        int code = 0;
        int k = 0;
        for (int len = 1; len <= 16; len = len + 1) {
            int cnt = (int)bits[len - 1];
            for (int i = 0; i < cnt; i = i + 1) {
                int sym = (int)vals[k];
                k = k + 1;
                h.Code[sym] = code;
                h.Size[sym] = len;
                code = code + 1;
            }
            code = code << 1;
        }
        return h;
    }

    private static void WriteLe16(byte[] dst, int off, int v) {
        dst[off] = (byte)(v & 0xFF);
        dst[off + 1] = (byte)((v >> 8) & 0xFF);
    }

    private static void WriteLe32(byte[] dst, int off, uint v) {
        dst[off] = (byte)(v & 0xFFu);
        dst[off + 1] = (byte)((v >> 8) & 0xFFu);
        dst[off + 2] = (byte)((v >> 16) & 0xFFu);
        dst[off + 3] = (byte)((v >> 24) & 0xFFu);
    }

    // ---- BMP (32-bit BGRA / 24-bit BGR, top-down) ----
    private static byte[] EncodeBmp(nint pixels, int w, int h, int stride, bool withAlpha) {
        int bpp = withAlpha ? 4 : 3;
        long rowBytesL = ((long)w * (long)bpp + 3L) & ~3L;
        long imgBytesL = rowBytesL * (long)h;
        long totalL = 54L + imgBytesL;
        if (totalL <= 54L || totalL > 2147483591L) return null;

        int rowBytes = (int)rowBytesL;
        byte[] outBytes = new byte[(int)totalL];

        // BITMAPFILEHEADER (14 bytes)
        outBytes[0] = 66; // 'B'
        outBytes[1] = 77; // 'M'
        ImageEncoder.WriteLe32(outBytes, 2, (uint)totalL);
        ImageEncoder.WriteLe16(outBytes, 6, 0);
        ImageEncoder.WriteLe16(outBytes, 8, 0);
        ImageEncoder.WriteLe32(outBytes, 10, 54u);

        // BITMAPINFOHEADER (40 bytes), top-down negative height
        ImageEncoder.WriteLe32(outBytes, 14, 40u);
        ImageEncoder.WriteLe32(outBytes, 18, (uint)w);
        ImageEncoder.WriteLe32(outBytes, 22, (uint)(-h));
        ImageEncoder.WriteLe16(outBytes, 26, 1);
        ImageEncoder.WriteLe16(outBytes, 28, bpp * 8);
        ImageEncoder.WriteLe32(outBytes, 30, 0u);
        ImageEncoder.WriteLe32(outBytes, 34, (uint)imgBytesL);
        ImageEncoder.WriteLe32(outBytes, 38, 2835u);
        ImageEncoder.WriteLe32(outBytes, 42, 2835u);
        ImageEncoder.WriteLe32(outBytes, 46, 0u);
        ImageEncoder.WriteLe32(outBytes, 50, 0u);

        if (withAlpha) {
            int copyBytes = w * 4;
            nint dstBase = (nint)outBytes + (nint)54;
            for (int y = 0; y < h; y = y + 1) {
                NativeMemory.Copy(dstBase + (nint)((long)y * (long)rowBytes),
                                  pixels + (nint)((long)y * (long)stride * 4L),
                                  copyBytes);
            }
        } else {
            for (int y = 0; y < h; y = y + 1) {
                Span<uint> row = new Span<uint>(pixels + (nint)((long)y * (long)stride * 4L), w);
                int pos = 54 + y * rowBytes;
                for (int x = 0; x < w; x = x + 1) {
                    uint p = row[x];
                    outBytes[pos] = (byte)(p & 0xFFu);
                    outBytes[pos + 1] = (byte)((p >> 8) & 0xFFu);
                    outBytes[pos + 2] = (byte)((p >> 16) & 0xFFu);
                    pos = pos + 3;
                }
            }
        }
        return outBytes;
    }

    // ---- TGA (32-bit uncompressed BGRA, top-left origin) ----
    private static byte[] EncodeTga(nint pixels, int w, int h, int stride) {
        if (w > 65535 || h > 65535) return null;
        long totalL = 18L + (long)w * (long)h * 4L;
        if (totalL <= 18L || totalL > 2147483591L) return null;

        byte[] outBytes = new byte[(int)totalL];
        outBytes[2] = 2; // uncompressed true-color
        outBytes[12] = (byte)(w & 0xFF);
        outBytes[13] = (byte)((w >> 8) & 0xFF);
        outBytes[14] = (byte)(h & 0xFF);
        outBytes[15] = (byte)((h >> 8) & 0xFF);
        outBytes[16] = 32;
        outBytes[17] = 0x28; // top-left origin (0x20) + 8-bit alpha (0x08)

        int rowBytes = w * 4;
        nint dstBase = (nint)outBytes + (nint)18;
        for (int y = 0; y < h; y = y + 1) {
            NativeMemory.Copy(dstBase + (nint)((long)y * (long)rowBytes),
                              pixels + (nint)((long)y * (long)stride * 4L),
                              rowBytes);
        }
        return outBytes;
    }

    // ---- JPEG Baseline (4:4:4 YCbCr, AAN 1D 分离式 8x8 FDCT) ----
    private static void JpgPutBits(BitWriter bw, uint bits, int n) {
        if (n <= 0) return;
        bw.Acc = (bw.Acc << n) | (bits & ((1u << n) - 1u));
        bw.Count = bw.Count + n;
        while (bw.Count >= 8) {
            bw.Count = bw.Count - 8;
            byte bv = (byte)((bw.Acc >> bw.Count) & 0xFFu);
            bw.Out.Put1(bv);
            if (bv == 0xFF) bw.Out.Put1(0x00);
        }
    }

    private static void JpgFlushBits(BitWriter bw) {
        if (bw.Count > 0) {
            int pad = 8 - bw.Count;
            ImageEncoder.JpgPutBits(bw, (1u << pad) - 1u, pad);
        }
    }

    private static void JpgWriteDht(EncBuf b, byte tcTh, byte[] bits, byte[] vals, int nvals) {
        b.Put1(0xFF);
        b.Put1(0xC4);
        b.PutBe16(2 + 1 + 16 + nvals);
        b.Put1(tcTh);
        b.PutBytes(bits, 16);
        b.PutBytes(vals, nvals);
    }

    private static int JpgBitLen(int v) {
        int n = 0;
        while (v > 0) {
            v = v >> 1;
            n = n + 1;
        }
        return n;
    }

    private static void JpgFdct8x8(float[] inp, float[] tmp, float[] outp) {
        for (int i = 0; i < 8; i = i + 1) {
            int r = i * 8;
            float r0 = inp[r];
            float r1 = inp[r + 1];
            float r2 = inp[r + 2];
            float r3 = inp[r + 3];
            float r4 = inp[r + 4];
            float r5 = inp[r + 5];
            float r6 = inp[r + 6];
            float r7 = inp[r + 7];

            float t0 = r0 + r7;
            float t7 = r0 - r7;
            float t1 = r1 + r6;
            float t6 = r1 - r6;
            float t2 = r2 + r5;
            float t5 = r2 - r5;
            float t3 = r3 + r4;
            float t4 = r3 - r4;

            float t10 = t0 + t3;
            float t13 = t0 - t3;
            float t11 = t1 + t2;
            float t12 = t1 - t2;

            tmp[r] = t10 + t11;
            tmp[r + 4] = t10 - t11;

            float z1 = (t12 + t13) * 0.707106781f;
            tmp[r + 2] = t13 + z1;
            tmp[r + 6] = t13 - z1;

            t10 = t4 + t5;
            t11 = t5 + t6;
            t12 = t6 + t7;

            float z5 = (t10 - t12) * 0.382683433f;
            float z2 = 0.541196100f * t10 + z5;
            float z4 = 1.306562965f * t12 + z5;
            float z3 = t11 * 0.707106781f;

            float z11 = t7 + z3;
            float z13 = t7 - z3;
            tmp[r + 5] = z13 + z2;
            tmp[r + 3] = z13 - z2;
            tmp[r + 1] = z11 + z4;
            tmp[r + 7] = z11 - z4;
        }

        for (int i = 0; i < 8; i = i + 1) {
            float s0 = tmp[i];
            float s1 = tmp[8 + i];
            float s2 = tmp[16 + i];
            float s3 = tmp[24 + i];
            float s4 = tmp[32 + i];
            float s5 = tmp[40 + i];
            float s6 = tmp[48 + i];
            float s7 = tmp[56 + i];

            float t0 = s0 + s7;
            float t7 = s0 - s7;
            float t1 = s1 + s6;
            float t6 = s1 - s6;
            float t2 = s2 + s5;
            float t5 = s2 - s5;
            float t3 = s3 + s4;
            float t4 = s3 - s4;

            float t10 = t0 + t3;
            float t13 = t0 - t3;
            float t11 = t1 + t2;
            float t12 = t1 - t2;

            outp[i] = t10 + t11;
            outp[32 + i] = t10 - t11;

            float z1 = (t12 + t13) * 0.707106781f;
            outp[16 + i] = t13 + z1;
            outp[48 + i] = t13 - z1;

            t10 = t4 + t5;
            t11 = t5 + t6;
            t12 = t6 + t7;

            float z5 = (t10 - t12) * 0.382683433f;
            float z2 = 0.541196100f * t10 + z5;
            float z4 = 1.306562965f * t12 + z5;
            float z3 = t11 * 0.707106781f;

            float z11 = t7 + z3;
            float z13 = t7 - z3;
            outp[40 + i] = z13 + z2;
            outp[24 + i] = z13 - z2;
            outp[8 + i] = z11 + z4;
            outp[56 + i] = z11 - z4;
        }
    }

    private static void JpgEncodeBlock(BitWriter bw, float[] block, float[] tmp, float[] dct,
                                       int[] qcoef, float[] invQ, int[] prevDc, int compIdx,
                                       JpgHuffTable dcH, JpgHuffTable acH) {
        ImageEncoder.JpgFdct8x8(block, tmp, dct);
        int[] zz = ImageEncoder.Zigzag;
        for (int i = 0; i < 64; i = i + 1) {
            float v = dct[zz[i]] * invQ[i];
            qcoef[i] = (int)(v >= 0.0f ? (v + 0.5f) : (v - 0.5f));
        }

        // 单 8x8 块含 0xFF 填充最坏不超过 512 字节：块首一次性扩容，内层零检查
        EncBuf outb = bw.Out;
        outb.Reserve(512);
        if (outb.Oom) return;
        byte[] data = outb.Data;
        int len = outb.Len;
        uint acc = bw.Acc;
        int cnt = bw.Count;
        int[] dcCode = dcH.Code;
        int[] dcSize = dcH.Size;
        int[] acCode = acH.Code;
        int[] acSize = acH.Size;

        int diff = qcoef[0] - prevDc[compIdx];
        prevDc[compIdx] = qcoef[0];
        if (diff == 0) {
            int n = dcSize[0];
            acc = (acc << n) | ((uint)dcCode[0] & ((1u << n) - 1u));
            cnt = cnt + n;
            while (cnt >= 8) {
                cnt = cnt - 8;
                byte bv = (byte)((acc >> cnt) & 0xFFu);
                data[len] = bv;
                len = len + 1;
                if (bv == 0xFF) { data[len] = 0x00; len = len + 1; }
            }
        } else {
            int absD = diff < 0 ? -diff : diff;
            int s = ImageEncoder.JpgBitLen(absD);
            int bits = diff < 0 ? (diff + (1 << s) - 1) : diff;
            int n1 = dcSize[s];
            acc = (acc << n1) | ((uint)dcCode[s] & ((1u << n1) - 1u));
            cnt = cnt + n1;
            while (cnt >= 8) {
                cnt = cnt - 8;
                byte bv = (byte)((acc >> cnt) & 0xFFu);
                data[len] = bv;
                len = len + 1;
                if (bv == 0xFF) { data[len] = 0x00; len = len + 1; }
            }
            acc = (acc << s) | ((uint)bits & ((1u << s) - 1u));
            cnt = cnt + s;
            while (cnt >= 8) {
                cnt = cnt - 8;
                byte bv = (byte)((acc >> cnt) & 0xFFu);
                data[len] = bv;
                len = len + 1;
                if (bv == 0xFF) { data[len] = 0x00; len = len + 1; }
            }
        }

        int lastNz = 63;
        while (lastNz > 0 && qcoef[lastNz] == 0) lastNz = lastNz - 1;
        int idx = 1;
        while (idx <= lastNz) {
            int zeros = 0;
            while (idx <= lastNz && qcoef[idx] == 0) {
                zeros = zeros + 1;
                idx = idx + 1;
            }
            while (zeros >= 16) {
                int nz = acSize[0xF0];
                acc = (acc << nz) | ((uint)acCode[0xF0] & ((1u << nz) - 1u));
                cnt = cnt + nz;
                while (cnt >= 8) {
                    cnt = cnt - 8;
                    byte bv = (byte)((acc >> cnt) & 0xFFu);
                    data[len] = bv;
                    len = len + 1;
                    if (bv == 0xFF) { data[len] = 0x00; len = len + 1; }
                }
                zeros = zeros - 16;
            }
            int val = qcoef[idx];
            idx = idx + 1;
            int absV = val < 0 ? -val : val;
            int s = ImageEncoder.JpgBitLen(absV);
            int sym = (zeros << 4) | s;
            int bits = val < 0 ? (val + (1 << s) - 1) : val;
            int na = acSize[sym];
            acc = (acc << na) | ((uint)acCode[sym] & ((1u << na) - 1u));
            cnt = cnt + na;
            while (cnt >= 8) {
                cnt = cnt - 8;
                byte bv = (byte)((acc >> cnt) & 0xFFu);
                data[len] = bv;
                len = len + 1;
                if (bv == 0xFF) { data[len] = 0x00; len = len + 1; }
            }
            acc = (acc << s) | ((uint)bits & ((1u << s) - 1u));
            cnt = cnt + s;
            while (cnt >= 8) {
                cnt = cnt - 8;
                byte bv = (byte)((acc >> cnt) & 0xFFu);
                data[len] = bv;
                len = len + 1;
                if (bv == 0xFF) { data[len] = 0x00; len = len + 1; }
            }
        }
        if (lastNz < 63) {
            int ne = acSize[0];
            acc = (acc << ne) | ((uint)acCode[0] & ((1u << ne) - 1u));
            cnt = cnt + ne;
            while (cnt >= 8) {
                cnt = cnt - 8;
                byte bv = (byte)((acc >> cnt) & 0xFFu);
                data[len] = bv;
                len = len + 1;
                if (bv == 0xFF) { data[len] = 0x00; len = len + 1; }
            }
        }

        outb.Len = len;
        bw.Acc = acc;
        bw.Count = cnt;
    }

    private static byte[] EncodeJpeg(nint pixels, int w, int h, int stride, int quality) {
        if (w <= 0 || h <= 0 || w > 65535 || h > 65535) return null;
        if (quality < 1) quality = 1;
        if (quality > 100) quality = 100;

        int scale = quality < 50 ? (5000 / quality) : (200 - quality * 2);
        byte[] qLum = new byte[64];
        byte[] qChr = new byte[64];
        float[] invQLum = new float[64];
        float[] invQChr = new float[64];
        int[] zzTbl = ImageEncoder.Zigzag;
        int[] stdLum = ImageEncoder.StdLumQ;
        int[] stdChr = ImageEncoder.StdChrQ;
        float[] aanTbl = ImageEncoder.AanScale;

        for (int i = 0; i < 64; i = i + 1) {
            int zz = zzTbl[i];
            int row = zz >> 3;
            int col = zz & 7;
            float aan = 8.0f * aanTbl[row] * aanTbl[col];
            int ql = (stdLum[zz] * scale + 50) / 100;
            int qc = (stdChr[zz] * scale + 50) / 100;
            if (ql < 1) ql = 1;
            else if (ql > 255) ql = 255;
            if (qc < 1) qc = 1;
            else if (qc > 255) qc = 255;
            qLum[i] = (byte)ql;
            qChr[i] = (byte)qc;
            invQLum[i] = 1.0f / ((float)ql * aan);
            invQChr[i] = 1.0f / ((float)qc * aan);
        }

        EncBuf b = new EncBuf(4096);

        // SOI + APP0 (JFIF 1.01)
        b.Put1(0xFF);
        b.Put1(0xD8);
        b.PutBytes(ImageEncoder.JpegApp0, 18);

        // DQT (table 0: lum, table 1: chr)
        b.Put1(0xFF);
        b.Put1(0xDB);
        b.PutBe16(67);
        b.Put1(0);
        b.PutBytes(qLum, 64);

        b.Put1(0xFF);
        b.Put1(0xDB);
        b.PutBe16(67);
        b.Put1(1);
        b.PutBytes(qChr, 64);

        // SOF0 (8-bit, 3 components, 4:4:4)
        b.Put1(0xFF);
        b.Put1(0xC0);
        b.PutBe16(17);
        b.Put1(8);
        b.PutBe16(h);
        b.PutBe16(w);
        b.Put1(3);
        b.Put1(1); b.Put1(0x11); b.Put1(0);
        b.Put1(2); b.Put1(0x11); b.Put1(1);
        b.Put1(3); b.Put1(0x11); b.Put1(1);

        // DHT
        ImageEncoder.JpgWriteDht(b, 0x00, ImageEncoder.DcLumBits, ImageEncoder.DcLumVals, 12);
        ImageEncoder.JpgWriteDht(b, 0x10, ImageEncoder.AcLumBits, ImageEncoder.AcLumVals, 162);
        ImageEncoder.JpgWriteDht(b, 0x01, ImageEncoder.DcChrBits, ImageEncoder.DcChrVals, 12);
        ImageEncoder.JpgWriteDht(b, 0x11, ImageEncoder.AcChrBits, ImageEncoder.AcChrVals, 162);

        // SOS
        b.PutBytes(ImageEncoder.JpegSos, 14);

        BitWriter bw = new BitWriter(b);
        int[] prevDc = new int[3];
        float[] yb = new float[64];
        float[] cbb = new float[64];
        float[] crb = new float[64];
        float[] tmp = new float[64];
        float[] dct = new float[64];
        int[] qcoef = new int[64];

        JpgHuffTable dcLum = ImageEncoder.HuffDcLum;
        JpgHuffTable dcChr = ImageEncoder.HuffDcChr;
        JpgHuffTable acLum = ImageEncoder.HuffAcLum;
        JpgHuffTable acChr = ImageEncoder.HuffAcChr;

        for (int by = 0; by < h; by = by + 8) {
            for (int bx = 0; bx < w; bx = bx + 8) {
                for (int dy = 0; dy < 8; dy = dy + 1) {
                    int py = by + dy;
                    if (py >= h) py = h - 1;
                    Span<uint> row = new Span<uint>(pixels + (nint)((long)py * (long)stride * 4L), w);
                    int baseIdx = dy * 8;
                    for (int dx = 0; dx < 8; dx = dx + 1) {
                        int px = bx + dx;
                        if (px >= w) px = w - 1;
                        uint p = row[px];
                        float r = (float)((p >> 16) & 0xFFu);
                        float g = (float)((p >> 8) & 0xFFu);
                        float bl = (float)(p & 0xFFu);
                        int idx = baseIdx + dx;
                        yb[idx] = 0.299000f * r + 0.587000f * g + 0.114000f * bl - 128.0f;
                        cbb[idx] = -0.168736f * r - 0.331264f * g + 0.500000f * bl;
                        crb[idx] = 0.500000f * r - 0.418688f * g - 0.081312f * bl;
                    }
                }
                ImageEncoder.JpgEncodeBlock(bw, yb, tmp, dct, qcoef, invQLum, prevDc, 0, dcLum, acLum);
                ImageEncoder.JpgEncodeBlock(bw, cbb, tmp, dct, qcoef, invQChr, prevDc, 1, dcChr, acChr);
                ImageEncoder.JpgEncodeBlock(bw, crb, tmp, dct, qcoef, invQChr, prevDc, 2, dcChr, acChr);
                if (b.Oom) return null;
            }
        }

        ImageEncoder.JpgFlushBits(bw);
        b.Put1(0xFF);
        b.Put1(0xD9);
        return b.ToExactBytes();
    }

    // ---- PNG (Sub 滤波 + 4096 哈希 LZ77 + Fixed Huffman Deflate) ----
    private static uint PngCrc32(byte[] buf, int start, int len) {
        uint[] tbl = ImageEncoder.Crc32Table;
        uint c = 0xFFFFFFFFu;
        int end = start + len;
        for (int i = start; i < end; i = i + 1) {
            c = tbl[(int)((c ^ (uint)buf[i]) & 0xFFu)] ^ (c >> 8);
        }
        return c ^ 0xFFFFFFFFu;
    }

    private static uint PngAdler32(Span<byte> buf, int len) {
        uint s1 = 1u;
        uint s2 = 0u;
        int i = 0;
        while (i < len) {
            int chunk = len - i;
            if (chunk > 5552) chunk = 5552;
            int end = i + chunk;
            while (i < end) {
                s1 = s1 + (uint)buf[i];
                s2 = s2 + s1;
                i = i + 1;
            }
            s1 = s1 % 65521u;
            s2 = s2 % 65521u;
        }
        return (s2 << 16) | s1;
    }

    private static void PngWriteChunk(EncBuf b, byte[] tag, byte[] payload, int len) {
        b.PutBe32((uint)len);
        int start = b.Len;
        b.PutBytes(tag, 4);
        if (len > 0 && payload != null) {
            b.PutBytes(payload, len);
        }
        if (!b.Oom) {
            uint crc = ImageEncoder.PngCrc32(b.Data, start, 4 + len);
            b.PutBe32(crc);
        }
    }

    private static byte[] EncodePng(nint pixels, int w, int h, int stride) {
        long rowRawL = 1L + (long)w * 4L;
        long rawSizeL = rowRawL * (long)h;
        if (rawSizeL <= 0L || rawSizeL > 0x3FFFFFFFL) return null;

        int rowRaw = (int)rowRawL;
        int n = (int)rawSizeL;
        nint rawPtr = NativeMemory.Alloc(n);
        if (rawPtr == 0) return null;

        try {
            Span<byte> raw = new Span<byte>(rawPtr, n);
            // 单遍 ARGB32 -> RGBA + PNG Sub 滤波
            for (int y = 0; y < h; y = y + 1) {
                Span<uint> srow = new Span<uint>(pixels + (nint)((long)y * (long)stride * 4L), w);
                int off = y * rowRaw;
                raw[off] = 1; // Filter type 1 = Sub
                int pr = 0;
                int pg = 0;
                int pb = 0;
                int pa = 0;
                int p = off + 1;
                for (int x = 0; x < w; x = x + 1) {
                    uint px = srow[x];
                    int b = (int)(px & 0xFFu);
                    int g = (int)((px >> 8) & 0xFFu);
                    int r = (int)((px >> 16) & 0xFFu);
                    int a = (int)((px >> 24) & 0xFFu);
                    raw[p] = (byte)((r - pr) & 0xFF);
                    raw[p + 1] = (byte)((g - pg) & 0xFF);
                    raw[p + 2] = (byte)((b - pb) & 0xFF);
                    raw[p + 3] = (byte)((a - pa) & 0xFF);
                    pr = r;
                    pg = g;
                    pb = b;
                    pa = a;
                    p = p + 4;
                }
            }

            int initCap = n / 2 + 1024;
            EncBuf zbuf = new EncBuf(initCap);
            // zlib header: CMF=0x78 (deflate 32K), FLG=0x01
            zbuf.Put1(0x78);
            zbuf.Put1(0x01);

            int[] head = new int[4096];
            for (int i = 0; i < 4096; i = i + 1) head[i] = -1;

            uint[] litCode = ImageEncoder.DefLitCode;
            int[] litBits = ImageEncoder.DefLitBits;
            uint[] distRev = ImageEncoder.DefDistRev;
            int[] lb = ImageEncoder.LenBase;
            int[] leb = ImageEncoder.LenEb;
            int[] db = ImageEncoder.DistBase;
            int[] deb = ImageEncoder.DistEb;

            byte[] zdata = zbuf.Data;
            int zlen = zbuf.Len;
            int zcap = zbuf.Cap;
            uint acc = 1u | (1u << 1); // BFINAL=1 (1 bit) + BTYPE=01 (2 bits)
            int bcnt = 3;

            int pos = 0;
            while (pos < n) {
                if (zlen + 16 > zcap) {
                    zbuf.Len = zlen;
                    zbuf.Reserve(16);
                    if (zbuf.Oom) break;
                    zdata = zbuf.Data;
                    zcap = zbuf.Cap;
                }
                int bestLen = 0;
                int bestDist = 0;
                if (pos + 3 <= n) {
                    uint h3 = ((uint)raw[pos] << 16) | ((uint)raw[pos + 1] << 8) | (uint)raw[pos + 2];
                    int hv = (int)((h3 * 2654435761u) >> 20);
                    int prev = head[hv];
                    head[hv] = pos;
                    if (prev >= 0) {
                        int dist = pos - prev;
                        if (dist > 0 && dist <= 32768) {
                            int maxL = n - pos;
                            if (maxL > 258) maxL = 258;
                            int l = 0;
                            while (l < maxL && raw[prev + l] == raw[pos + l]) l = l + 1;
                            if (l >= 3) {
                                bestLen = l;
                                bestDist = dist;
                            }
                        }
                    }
                }
                if (bestLen >= 3) {
                    int li = 0;
                    while (li < 28 && bestLen >= lb[li + 1]) li = li + 1;
                    int lsym = 257 + li;
                    acc = acc | (litCode[lsym] << bcnt);
                    bcnt = bcnt + litBits[lsym];
                    while (bcnt >= 8) {
                        zdata[zlen] = (byte)(acc & 0xFFu);
                        zlen = zlen + 1;
                        acc = acc >> 8;
                        bcnt = bcnt - 8;
                    }
                    int le = leb[li];
                    if (le > 0) {
                        acc = acc | ((uint)(bestLen - lb[li]) << bcnt);
                        bcnt = bcnt + le;
                        while (bcnt >= 8) {
                            zdata[zlen] = (byte)(acc & 0xFFu);
                            zlen = zlen + 1;
                            acc = acc >> 8;
                            bcnt = bcnt - 8;
                        }
                    }
                    int di = 0;
                    while (di < 29 && bestDist >= db[di + 1]) di = di + 1;
                    acc = acc | (distRev[di] << bcnt);
                    bcnt = bcnt + 5;
                    while (bcnt >= 8) {
                        zdata[zlen] = (byte)(acc & 0xFFu);
                        zlen = zlen + 1;
                        acc = acc >> 8;
                        bcnt = bcnt - 8;
                    }
                    int de = deb[di];
                    if (de > 0) {
                        acc = acc | ((uint)(bestDist - db[di]) << bcnt);
                        bcnt = bcnt + de;
                        while (bcnt >= 8) {
                            zdata[zlen] = (byte)(acc & 0xFFu);
                            zlen = zlen + 1;
                            acc = acc >> 8;
                            bcnt = bcnt - 8;
                        }
                    }

                    int endM = pos + bestLen;
                    pos = pos + 1;
                    while (pos < endM && pos + 3 <= n) {
                        uint h3 = ((uint)raw[pos] << 16) | ((uint)raw[pos + 1] << 8) | (uint)raw[pos + 2];
                        head[(int)((h3 * 2654435761u) >> 20)] = pos;
                        pos = pos + 1;
                    }
                    pos = endM;
                } else {
                    int sym = (int)raw[pos];
                    pos = pos + 1;
                    acc = acc | (litCode[sym] << bcnt);
                    bcnt = bcnt + litBits[sym];
                    while (bcnt >= 8) {
                        zdata[zlen] = (byte)(acc & 0xFFu);
                        zlen = zlen + 1;
                        acc = acc >> 8;
                        bcnt = bcnt - 8;
                    }
                }
            }

            zbuf.Len = zlen;
            zbuf.Reserve(16);
            if (!zbuf.Oom) {
                zdata = zbuf.Data;
                acc = acc | (litCode[256] << bcnt); // EOB
                bcnt = bcnt + litBits[256];
                while (bcnt >= 8) {
                    zdata[zlen] = (byte)(acc & 0xFFu);
                    zlen = zlen + 1;
                    acc = acc >> 8;
                    bcnt = bcnt - 8;
                }
                if (bcnt > 0) {
                    zdata[zlen] = (byte)(acc & 0xFFu);
                    zlen = zlen + 1;
                }
                zbuf.Len = zlen;
            }

            uint adler = ImageEncoder.PngAdler32(raw, n);
            zbuf.PutBe32(adler);
            if (zbuf.Oom) return null;

            EncBuf outBuf = new EncBuf(zbuf.Len + 128);
            outBuf.PutBytes(ImageEncoder.PngSig, 8);

            byte[] ihdr = new byte[13];
            ihdr[0] = (byte)((w >> 24) & 0xFF);
            ihdr[1] = (byte)((w >> 16) & 0xFF);
            ihdr[2] = (byte)((w >> 8) & 0xFF);
            ihdr[3] = (byte)(w & 0xFF);
            ihdr[4] = (byte)((h >> 24) & 0xFF);
            ihdr[5] = (byte)((h >> 16) & 0xFF);
            ihdr[6] = (byte)((h >> 8) & 0xFF);
            ihdr[7] = (byte)(h & 0xFF);
            ihdr[8] = 8; // bit depth
            ihdr[9] = 6; // RGBA
            ihdr[10] = 0;
            ihdr[11] = 0;
            ihdr[12] = 0;

            ImageEncoder.PngWriteChunk(outBuf, ImageEncoder.TagIhdr, ihdr, 13);
            ImageEncoder.PngWriteChunk(outBuf, ImageEncoder.TagIdat, zbuf.Data, zbuf.Len);
            ImageEncoder.PngWriteChunk(outBuf, ImageEncoder.TagIend, null, 0);
            return outBuf.ToExactBytes();
        } finally {
            NativeMemory.Free(rawPtr);
        }
    }

    public static byte[] EncodeArgb(nint pixels, int w, int h, int stride, int format, int quality) {
        if (pixels == 0 || !ImageEncoder.DimensionsOk(w, h) || stride < w) return null;
        if ((long)stride * (long)h * 4L > 2147483591L) return null;
        if (format == 1) return ImageEncoder.EncodePng(pixels, w, h, stride);
        if (format == 2) return ImageEncoder.EncodeJpeg(pixels, w, h, stride, quality);
        if (format == 3) return ImageEncoder.EncodeBmp(pixels, w, h, stride, true);
        if (format == 4) return ImageEncoder.EncodeTga(pixels, w, h, stride);
        if (format == 5) return ImageEncoder.EncodeBmp(pixels, w, h, stride, false);
        return null;
    }
}
