using System;

namespace System.Drawing.Imaging;

internal class EncBuf {
    public byte[] Data;
    public int Len;
    public int Cap;
    public bool Oom;

    public EncBuf(int initialCap) {
        if (initialCap < 64) initialCap = 64;
        this.Data = new byte[initialCap];
        this.Len = 0;
        this.Cap = initialCap;
        this.Oom = false;
    }

    public void Reserve(int extra) {
        if (this.Oom || extra <= 0) return;
        if (extra > 2147483591 - this.Len) {
            this.Oom = true;
            return;
        }
        int need = this.Len + extra;
        if (need <= this.Cap) return;
        int ncap = this.Cap > 0 ? this.Cap : 4096;
        while (ncap < need) {
            if (ncap > 1073741795) {
                ncap = need;
                break;
            }
            ncap = ncap * 2;
        }
        byte[] next = new byte[ncap];
        if (this.Len > 0) {
            NativeMemory.Copy((nint)next, (nint)this.Data, this.Len);
        }
        this.Data = next;
        this.Cap = ncap;
    }

    public void Put1(byte v) {
        if (this.Len >= this.Cap) this.Reserve(1);
        if (!this.Oom) {
            this.Data[this.Len] = v;
            this.Len = this.Len + 1;
        }
    }

    public void PutBytes(byte[] src, int count) {
        if (count <= 0) return;
        this.Reserve(count);
        if (!this.Oom) {
            NativeMemory.Copy((nint)this.Data + (nint)this.Len, (nint)src, count);
            this.Len = this.Len + count;
        }
    }

    public void PutBe16(int v) {
        this.Put1((byte)((v >> 8) & 0xFF));
        this.Put1((byte)(v & 0xFF));
    }

    public void PutBe32(uint v) {
        this.Put1((byte)((v >> 24) & 0xFFu));
        this.Put1((byte)((v >> 16) & 0xFFu));
        this.Put1((byte)((v >> 8) & 0xFFu));
        this.Put1((byte)(v & 0xFFu));
    }

    public byte[] ToExactBytes() {
        if (this.Oom || this.Len <= 0) return null;
        if (this.Len == this.Cap) return this.Data;
        byte[] result = new byte[this.Len];
        NativeMemory.Copy((nint)result, (nint)this.Data, this.Len);
        return result;
    }
}

internal class JpgHuffTable {
    public int[] Code;
    public int[] Size;
}

internal class BitWriter {
    public EncBuf Out;
    public uint Acc;
    public int Count;

    public BitWriter(EncBuf buf) {
        this.Out = buf;
        this.Acc = 0u;
        this.Count = 0;
    }
}

// 纯 Zan 零外部依赖 ARGB32 图像编码器（PNG / JPEG Baseline / BMP32 / TGA32 / BMP24）：
// - PNG：Sub 滤波 + 4096 哈希 LZ77 + 预计算 Fixed Huffman Deflate + IEEE CRC-32 + Adler-32
// - JPEG：ITU-T T.81 Annex K 量化/哈夫曼表 + AAN 1D 分离 8x8 FDCT + 4:4:4 YCbCr
// - BMP / TGA：预分配定长缓冲 + 小端整行 memcpy 零多余拷贝
