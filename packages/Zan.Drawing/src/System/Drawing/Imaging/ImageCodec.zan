using System;

namespace System.Drawing.Imaging;

// 独立图片解码与缓存，不需要窗口或渲染器。像素为直通 alpha
// 的 ARGB32；内存图片 key 约定用 "mem:" 前缀。
public class ImageCodec {
    // 文件或已注册 key 的像素宽度；首次读取文件时解码，失败返回 0。
    public static int Width(string key) {
        if (key == null || key.Length == 0) return 0;
        return ImageCodec.zan_image_width(key);
    }

    // 文件或已注册 key 的像素高度，失败返回 0。
    public static int Height(string key) {
        if (key == null || key.Length == 0) return 0;
        return ImageCodec.zan_image_height(key);
    }

    // 同步读取 len 字节并解码到 key，返回宽度，失败返回 0。
    // 支持 PNG/JPEG/BMP/GIF/TGA/PNM/PSD/WebP 与 PNG 压缩 ICO 子图。
    // 调用后可以释放源字节；重复注册活跃 key 保留首次图像。
    public static int LoadMem(string key, string data, int len) {
        if (key == null || key.Length == 0 || data == null || len <= 0 || len > data.Length) return 0;
        return ImageCodec.zan_image_load_mem(key, data, len);
    }

    // byte[] 重载；len 为有效数据字节数。
    public static int LoadMem(string key, byte[] data, int len) {
        if (key == null || key.Length == 0 || data == null || len <= 0 || len > data.Length) return 0;
        return ImageCodec.zan_image_load_mem_bytes(key, data, len);
    }

    // SVG 按原比例适配 rasterW/rasterH，返回宽度，失败返回 0。
    // 目标尺寸 <= 0 时使用文档固有尺寸；活跃 key 不重复光栅化。
    public static int LoadSvg(string key, string svg, int rasterW, int rasterH) {
        if (key == null || key.Length == 0 || svg == null) return 0;
        return ImageCodec.zan_image_load_svg(key, svg, -1, rasterW, rasterH);
    }

    // SVG 字节重载；len 为有效数据字节数。
    public static int LoadSvg(string key, byte[] svg, int len, int rasterW, int rasterH) {
        if (key == null || key.Length == 0 || svg == null || len <= 0 || len > svg.Length) return 0;
        return ImageCodec.zan_image_load_svg_bytes(key, svg, len, rasterW, rasterH);
    }

    // 丢弃文件或内存 key 的缓存及失败记录。
    public static void Evict(string key) {
        if (key == null || key.Length == 0) return;
        ImageCodec.zan_image_evict(key);
    }

    // 借用 native zan_bitmap 描述符；失败返回 0。仅供 graphics
    // bridge 同步转发，Zan 不得读取或释放。描述符及像素只有效到下一次
    // 图片缓存变动（解码、注册、替换或驱逐），不得跨该边界保留。
    public static nint View(string key) {
        if (key == null || key.Length == 0) return 0;
        return ImageCodec.zan_image_get(key);
    }

    // 文件与内存图片的缓存条目数及像素内存统计。
    public static string MemReport() {
        return ImageCodec.zan_image_mem_report();
    }

    // 把 ARGB32 像素注册/替换到 "mem:" 图像键，供 Canvas/GUI 直接渲染。成功返回宽度，失败返回 0。
    public static int RegisterArgb(string key, nint pixels, int width, int height, int stride) {
        if (key == null || key.Length == 0 || pixels == 0 || width <= 0 || height <= 0 || stride < width) return 0;
        if ((long)width * (long)height * 4L > 2147483591L || (long)stride * (long)height * 4L > 2147483591L) return 0;
        return ImageCodec.zan_image_register_argb(key, pixels, width, height, stride);
    }

    // 把已解码图像键的像素复制到调用方 ARGB32 缓冲区，返回复制的像素数。
    public static int CopyArgb(string key, nint dst, int maxPixels) {
        if (key == null || key.Length == 0 || dst == 0 || maxPixels <= 0) return 0;
        return ImageCodec.zan_image_copy_argb(key, dst, maxPixels);
    }

    // 将 ARGB32 像素缓冲编码为指定格式字节数组（format: 1=PNG, 2=JPEG, 3=BMP32, 4=TGA32, 5=BMP24）。
    public static byte[] EncodeArgb(nint pixels, int width, int height, int stride, int format, int quality) {
        return ImageEncoder.EncodeArgb(pixels, width, height, stride, format, quality);
    }

    // 无缓存、线程安全的多帧/静态图解码原语（供 ImageBuffer.FromFile/FromBytes 与 AnimatedImage 使用）。
    public static nint AnimOpenMem(byte[] data, int len) {
        if (data == null || len <= 0 || len > data.Length) return 0;
        return ImageCodec.zan_image_anim_open_mem(data, len);
    }

    public static nint AnimOpenFile(string path) {
        if (path == null || path == "") return 0;
        return ImageCodec.zan_image_anim_open_file(path);
    }

    public static int AnimWidth(nint handle) {
        return handle == 0 ? 0 : ImageCodec.zan_image_anim_width(handle);
    }

    public static int AnimHeight(nint handle) {
        return handle == 0 ? 0 : ImageCodec.zan_image_anim_height(handle);
    }

    public static int AnimFrameCount(nint handle) {
        return handle == 0 ? 0 : ImageCodec.zan_image_anim_frame_count(handle);
    }

    public static int AnimFrameDelayMs(nint handle, int index) {
        if (handle == 0 || index < 0) return 0;
        return ImageCodec.zan_image_anim_frame_delay_ms(handle, index);
    }

    public static int AnimCopyFrame(nint handle, int index, nint dst, int maxPixels) {
        if (handle == 0 || index < 0 || dst == 0 || maxPixels <= 0) return 0;
        return ImageCodec.zan_image_anim_copy_frame(handle, index, dst, maxPixels);
    }

    public static void AnimClose(nint handle) {
        if (handle != 0) { ImageCodec.zan_image_anim_close(handle); }
    }

    // 纯 Zan 高性能像素算子封装（filter: 0=Nearest, 1=Bilinear, 2=Area/Box, 3=Lanczos-3）。
    public static bool ResizeArgb(nint src, int sw, int sh, nint dst, int dw, int dh, int filter) {
        return ImagePixelOps.ResizeArgb(src, sw, sh, dst, dw, dh, filter);
    }

    public static bool RotateArgb(nint src, int sw, int sh, nint dst, int mode) {
        return ImagePixelOps.RotateArgb(src, sw, sh, dst, mode);
    }

    public static void ColorAdjustArgb(nint pixels, int count, int contrastPercent, int saturationPercent, bool grayscale) {
        ImagePixelOps.ColorAdjustArgb(pixels, count, contrastPercent, saturationPercent, grayscale);
    }

    public static bool BoxBlurArgb(nint pixels, int w, int h, int radius, int passes) {
        return ImagePixelOps.BoxBlurArgb(pixels, w, h, radius, passes);
    }

    public static bool SharpenArgb(nint pixels, int w, int h, int amountPercent) {
        return ImagePixelOps.SharpenArgb(pixels, w, h, amountPercent);
    }

    public static bool BlitArgb(nint dst, int dw, int dh, nint src, int sw, int sh, int dx, int dy, int alphaScale) {
        return ImagePixelOps.BlitArgb(dst, dw, dh, src, sw, sh, dx, dy, alphaScale);
    }

    [DllImport("zan_image")]
    private static extern int zan_image_width(string key);

    [DllImport("zan_image")]
    private static extern int zan_image_height(string key);

    [DllImport("zan_image")]
    private static extern int zan_image_load_mem(string key, string data, int len);

    [DllImport("zan_image")]
    private static extern int zan_image_load_mem_bytes(string key, byte[] data, int len);

    [DllImport("zan_image")]
    private static extern int zan_image_load_svg(string key, string text, int len,
                                          int rasterW, int rasterH);

    [DllImport("zan_image", EntryPoint = "zan_image_load_svg")]
    private static extern int zan_image_load_svg_bytes(string key, byte[] text, int len,
                                                int rasterW, int rasterH);

    [DllImport("zan_image")]
    private static extern void zan_image_evict(string key);

    [DllImport("zan_image")]
    private static extern nint zan_image_get(string key);

    [DllImport("zan_image")]
    private static extern string zan_image_mem_report();

    [DllImport("zan_image")]
    private static extern int zan_image_register_argb(string key, nint pixels, int w, int h, int stride);

    [DllImport("zan_image")]
    private static extern int zan_image_copy_argb(string key, nint dst, int maxPixels);

    [DllImport("zan_image")]
    private static extern nint zan_image_anim_open_mem(byte[] data, int len);

    [DllImport("zan_image")]
    private static extern nint zan_image_anim_open_file(string path);

    [DllImport("zan_image")]
    private static extern int zan_image_anim_width(nint handle);

    [DllImport("zan_image")]
    private static extern int zan_image_anim_height(nint handle);

    [DllImport("zan_image")]
    private static extern int zan_image_anim_frame_count(nint handle);

    [DllImport("zan_image")]
    private static extern int zan_image_anim_frame_delay_ms(nint handle, int index);

    [DllImport("zan_image")]
    private static extern int zan_image_anim_copy_frame(nint handle, int index, nint dst, int maxPixels);

    [DllImport("zan_image")]
    private static extern void zan_image_anim_close(nint handle);
}
