using System;
using System.Collections.Generic;
using System.IO;
using System.Threading;
using System.Drawing;

namespace System.Drawing.Imaging;

public enum ImageResizeMode {
    None = 0,
    Fit = 1,
    Cover = 2,
    Exact = 3
}

public enum WatermarkAnchor {
    TopLeft = 0,
    TopRight = 1,
    BottomLeft = 2,
    BottomRight = 3,
    Center = 4
}

public delegate void ImageBatchProgressCallback(int completed, int total, string inputPath, bool succeeded);

// 批量图像处理任务配置（强类型配置实体，支持目录扫描或显式文件列表）。
public class ImageBatchOptions {
    public string InputDirectory = "";
    public bool Recursive = false;
    public List<string> InputFiles = null;
    public string OutputDirectory = "";
    public ImageFormat OutputFormat = ImageFormat.Jpeg;
    public int Quality = 88;
    public ImageResizeMode ResizeMode = ImageResizeMode.None;
    public int TargetWidth = 0;
    public int TargetHeight = 0;
    public int RotateDegrees = 0; // 0 / 90 / 180 / 270
    public bool FlipHorizontal = false;
    public bool FlipVertical = false;
    public bool Grayscale = false;
    public int BrightnessDelta = 0;
    public int ContrastPercent = 0;
    public int SaturationPercent = 0;
    public ImageBuffer Watermark = null;
    public WatermarkAnchor WatermarkAnchor = WatermarkAnchor.BottomRight;
    public int WatermarkMargin = 16;
    public int WatermarkOpacity = 100; // 1..100 透明度百分比
    public int Concurrency = 1;
    public ImageBatchProgressCallback OnProgress = null;
}

public class ImageBatchItemResult {
    public string InputPath = "";
    public string OutputPath = "";
    public bool Succeeded = false;
    public string Error = "";
    public int Width = 0;
    public int Height = 0;
}

public class ImageBatchResult {
    public int Total = 0;
    public int Succeeded = 0;
    public int Failed = 0;
    public List<ImageBatchItemResult> Items = new List<ImageBatchItemResult>();
}

// 多线程/单线程图片批处理流水线（无 GUI 依赖，适用于服务端与 CLI 工具）。
public class ImageBatch {
    public static bool IsSupportedInputExtension(string path) {
        string ext = Path.GetExtension(path);
        if (ext == null || ext == "") return false;
        string lower = ext.ToLower();
        return lower == ".png" || lower == ".jpg" || lower == ".jpeg"
            || lower == ".bmp" || lower == ".webp" || lower == ".gif"
            || lower == ".tga" || lower == ".psd" || lower == ".ppm"
            || lower == ".pgm" || lower == ".ico";
    }

    public static string ExtensionForFormat(ImageFormat fmt) {
        if (fmt == ImageFormat.Jpeg) return ".jpg";
        if (fmt == ImageFormat.Bmp || fmt == ImageFormat.Bmp24) return ".bmp";
        if (fmt == ImageFormat.Tga) return ".tga";
        return ".png";
    }

    public static ImageBatchResult Run(ImageBatchOptions options) {
        ImageBatchResult result = new ImageBatchResult();
        if (options == null || options.OutputDirectory == null || options.OutputDirectory == "") {
            return result;
        }
        Directory.CreateDirectoryRecursive(options.OutputDirectory);

        List<string> files = new List<string>();
        if (options.InputFiles != null && options.InputFiles.Count > 0) {
            for (int i = 0; i < options.InputFiles.Count; i = i + 1) {
                files.Add(options.InputFiles[i]);
            }
        } else if (options.InputDirectory != null && options.InputDirectory != ""
                   && Directory.Exists(options.InputDirectory)) {
            List<string> found = Directory.GetFiles(options.InputDirectory, "*", options.Recursive);
            for (int i = 0; i < found.Count; i = i + 1) {
                if (ImageBatch.IsSupportedInputExtension(found[i])) {
                    files.Add(found[i]);
                }
            }
        }

        int total = files.Count;
        result.Total = total;
        if (total == 0) return result;

        string[] outPaths = ImageBatch.BuildOutputPaths(files, options);
        ImageBatchItemResult[] slots = new ImageBatchItemResult[total];
        int workers = options.Concurrency;
        if (workers < 1) workers = 1;
        if (workers > total) workers = total;
        if (workers > 16) workers = 16;

        if (workers == 1) {
            for (int i = 0; i < total; i = i + 1) {
                ImageBatchItemResult item = ImageBatch.ProcessOne(files[i], outPaths[i], options);
                slots[i] = item;
                if (options.OnProgress != null) {
                    try {
                        options.OnProgress(i + 1, total, item.InputPath, item.Succeeded);
                    } catch (Exception) {
                        // 进度回调异常不影响批处理继续执行
                    }
                }
            }
        } else {
            nint nextIdx = AtomicInt.NativeCreate(0);
            nint doneCount = AtomicInt.NativeCreate(0);
            nint activeWorkers = AtomicInt.NativeCreate(0);
            try {
                for (int w = 0; w < workers; w = w + 1) {
                    AtomicInt.NativeAdd(activeWorkers, 1);
                    bool started = false;
                    try {
                        started = Thread.Start(() => {
                            try {
                                while (true) {
                                    int idx = (int)AtomicInt.NativeAdd(nextIdx, 1) - 1;
                                    if (idx >= total) break;
                                    ImageBatchItemResult item = ImageBatch.ProcessOne(files[idx], outPaths[idx], options);
                                    slots[idx] = item;
                                    int done = (int)AtomicInt.NativeAdd(doneCount, 1);
                                    if (options.OnProgress != null) {
                                        try {
                                            options.OnProgress(done, total, item.InputPath, item.Succeeded);
                                        } catch (Exception) {
                                            // 进度回调异常不终止当前工作线程
                                        }
                                    }
                                }
                            } finally {
                                AtomicInt.NativeAdd(activeWorkers, -1);
                            }
                        });
                    } catch (Exception) {
                        started = false;
                    }
                    if (!started) {
                        AtomicInt.NativeAdd(activeWorkers, -1);
                    }
                }
            } finally {
                // 等待全部已启动工作线程退出后再销毁原生原子句柄，杜绝 UAF
                while (AtomicInt.NativeLoad(activeWorkers) > 0) {
                    Thread.Sleep(2);
                }
                AtomicInt.NativeDestroy(nextIdx);
                AtomicInt.NativeDestroy(doneCount);
                AtomicInt.NativeDestroy(activeWorkers);
            }
        }

        for (int i = 0; i < total; i = i + 1) {
            ImageBatchItemResult item = slots[i];
            if (item == null) {
                item = new ImageBatchItemResult();
                item.InputPath = files[i];
                item.Error = "worker aborted";
            }
            result.Items.Add(item);
            if (item.Succeeded) { result.Succeeded = result.Succeeded + 1; }
            else { result.Failed = result.Failed + 1; }
        }
        return result;
    }

    private static string[] BuildOutputPaths(List<string> files, ImageBatchOptions opt) {
        int n = files.Count;
        string[] paths = new string[n];
        string ext = ImageBatch.ExtensionForFormat(opt.OutputFormat);
        HashSet<string> used = new HashSet<string>();
        string baseDir = opt.InputDirectory != null ? opt.InputDirectory : "";
        while (baseDir.Length > 0 && (baseDir[baseDir.Length - 1] == '/' || baseDir[baseDir.Length - 1] == '\\')) {
            baseDir = baseDir.Substring(0, baseDir.Length - 1);
        }

        for (int i = 0; i < n; i = i + 1) {
            string inputPath = files[i];
            string stem = Path.GetFileNameWithoutExtension(inputPath);
            string targetDir = opt.OutputDirectory;
            if (opt.Recursive && baseDir.Length > 0 && inputPath.Length > baseDir.Length
                && inputPath.StartsWith(baseDir)) {
                char sep = inputPath[baseDir.Length];
                if (sep == '/' || sep == '\\') {
                    string rel = inputPath.Substring(baseDir.Length + 1);
                    string relDir = Path.GetDirectoryName(rel);
                    if (relDir != null && relDir != "" && relDir != ".") {
                        targetDir = Path.Combine(opt.OutputDirectory, relDir);
                        Directory.CreateDirectoryRecursive(targetDir);
                    }
                }
            }
            string candidate = Path.Combine(targetDir, stem + ext);
            string key = candidate.ToLower();
            if (!used.Add(key)) {
                int suffix = 2;
                while (true) {
                    candidate = Path.Combine(targetDir, stem + "_" + suffix.ToString() + ext);
                    key = candidate.ToLower();
                    if (used.Add(key)) { break; }
                    suffix = suffix + 1;
                }
            }
            paths[i] = candidate;
        }
        return paths;
    }

    private static ImageBatchItemResult ProcessOne(string inputPath, string outputPath, ImageBatchOptions opt) {
        ImageBatchItemResult res = new ImageBatchItemResult();
        res.InputPath = inputPath;
        res.OutputPath = outputPath;

        ImageBuffer cur = null;
        try {
            cur = ImageBuffer.FromFile(inputPath);
            if (cur == null || cur.IsEmpty) {
                res.Error = "decode failed";
                return res;
            }
            if (opt.RotateDegrees == 90 || opt.RotateDegrees == 180 || opt.RotateDegrees == 270) {
                ImageBuffer rot = opt.RotateDegrees == 90 ? cur.Rotate90()
                    : (opt.RotateDegrees == 180 ? cur.Rotate180() : cur.Rotate270());
                cur.Dispose();
                cur = rot;
            }
            if (opt.FlipHorizontal) { cur.FlipHorizontal(); }
            if (opt.FlipVertical) { cur.FlipVertical(); }

            if (opt.ResizeMode != ImageResizeMode.None && opt.TargetWidth > 0 && opt.TargetHeight > 0) {
                ImageBuffer resized = null;
                if (opt.ResizeMode == ImageResizeMode.Fit) {
                    resized = cur.ResizeFit(opt.TargetWidth, opt.TargetHeight);
                } else if (opt.ResizeMode == ImageResizeMode.Cover) {
                    resized = cur.ResizeCover(opt.TargetWidth, opt.TargetHeight);
                } else if (opt.ResizeMode == ImageResizeMode.Exact) {
                    resized = cur.ResizeLanczos(opt.TargetWidth, opt.TargetHeight);
                }
                if (resized != null && !resized.IsEmpty) {
                    cur.Dispose();
                    cur = resized;
                } else if (resized != null) {
                    resized.Dispose();
                }
            }

            if (opt.BrightnessDelta != 0) { cur.AdjustBrightness(opt.BrightnessDelta); }
            if (opt.ContrastPercent != 0) { cur.AdjustContrast(opt.ContrastPercent); }
            if (opt.SaturationPercent != 0) { cur.AdjustSaturation(opt.SaturationPercent); }
            if (opt.Grayscale) { cur.Grayscale(); }

            if (opt.Watermark != null && !opt.Watermark.IsEmpty) {
                int wx = opt.WatermarkMargin;
                int wy = opt.WatermarkMargin;
                if (opt.WatermarkAnchor == WatermarkAnchor.TopRight) {
                    wx = cur.Width - opt.Watermark.Width - opt.WatermarkMargin;
                } else if (opt.WatermarkAnchor == WatermarkAnchor.BottomLeft) {
                    wy = cur.Height - opt.Watermark.Height - opt.WatermarkMargin;
                } else if (opt.WatermarkAnchor == WatermarkAnchor.BottomRight) {
                    wx = cur.Width - opt.Watermark.Width - opt.WatermarkMargin;
                    wy = cur.Height - opt.Watermark.Height - opt.WatermarkMargin;
                } else if (opt.WatermarkAnchor == WatermarkAnchor.Center) {
                    wx = (cur.Width - opt.Watermark.Width) / 2;
                    wy = (cur.Height - opt.Watermark.Height) / 2;
                }
                if (opt.WatermarkOpacity >= 100) {
                    cur.Blit(opt.Watermark, wx, wy, true);
                } else if (opt.WatermarkOpacity > 0) {
                    cur.Blit(opt.Watermark, wx, wy, opt.WatermarkOpacity);
                }
            }

            res.Width = cur.Width;
            res.Height = cur.Height;
            bool saved = cur.Save(res.OutputPath, opt.OutputFormat, opt.Quality);
            if (!saved) {
                res.Error = "encode/save failed";
                return res;
            }
            res.Succeeded = true;
            return res;
        } catch (Exception ex) {
            res.Succeeded = false;
            res.Error = ex.Message != null && ex.Message != "" ? ex.Message : "processing failed";
            return res;
        } finally {
            if (cur != null) {
                cur.Dispose();
            }
        }
    }
}
