using System;
using System.Collections.Generic;

namespace Game.Ecs;

// 遍历回调：实体 id。
public delegate void EcsEach1<T1>(T1 first);

// 遍历回调：实体 id + 一个组件的值。
public delegate void EcsEach2<T1, T2>(T1 first, T2 second);

// 遍历回调：实体 id + 两个组件的值。
public delegate void EcsEach3<T1, T2, T3>(T1 first, T2 second, T3 third);

// 单组件查询：遍历所有拥有该组件的实体。
//
// 回调收到（实体 id, 组件值）。值类型组件拿到的是**副本**——要写回
// 还得调 store.Set(entity, value)；引用类型组件拿到的是对象本身。
public class Query1<T> {
    private ComponentStore<T> store;

    public Query1(ComponentStore<T> store) {
        this.store = store;
    }

    // 命中的实体数。
    public int Count() {
        return this.store.SlotCount();
    }

    // 遍历（只给实体 id）。
    public void Each(EcsEach1<int> fn) {
        if (fn == null) { return; }
        int n = this.store.SlotCount();
        for (int i = 0; i < n; i = i + 1) {
            fn(this.store.EntityAt(i));
        }
    }

    // 遍历并带上组件值。
    public void EachValue(EcsEach2<int, T> fn) {
        if (fn == null) { return; }
        int n = this.store.SlotCount();
        for (int i = 0; i < n; i = i + 1) {
            int entity = this.store.EntityAt(i);
            fn(entity, this.store.Get(entity));
        }
    }
}

// 双组件查询：遍历同时拥有两个组件的实体。
//
// 以**元素较少**的那个池为基准遍历（另一池用哈希查），这是 ECS 的
// 标准做法：命中集小的一方决定遍历量。
public class Query2<T, U> {
    private ComponentStore<T> first;
    private ComponentStore<U> second;

    public Query2(ComponentStore<T> first, ComponentStore<U> second) {
        this.first = first;
        this.second = second;
    }

    // 同时拥有两个组件的实体数。
    public int Count() {
        int n = 0;
        int slots = this.first.SlotCount();
        for (int i = 0; i < slots; i = i + 1) {
            if (this.second.Has(this.first.EntityAt(i))) { n = n + 1; }
        }
        return n;
    }

    // 遍历并带上两个组件的值。
    public void Each(EcsEach3<int, T, U> fn) {
        if (fn == null) { return; }
        int slots = this.first.SlotCount();
        for (int i = 0; i < slots; i = i + 1) {
            int entity = this.first.EntityAt(i);
            if (!this.second.Has(entity)) { continue; }
            fn(entity, this.first.Get(entity), this.second.Get(entity));
        }
    }
}
