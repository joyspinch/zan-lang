using System;
using System.Collections.Generic;

namespace Game.Ecs;

// 系统基类：一类逻辑（移动、战斗、AI、动画）跑在一个更新组里。
//
// 抽象方法由编译器保证"必须实现"：漏实现的派生类在编译期就被拒，
// 不会等到运行期撞上空桩。
public abstract class System {
    // 系统名（调试与剖析用）。
    public string name;
    // 是否参与更新。
    public bool enabled;
    // 所属更新组。
    public EcsGroup group;

    public System() {
        this.name = "";
        this.enabled = true;
        this.group = EcsGroup.Update;
    }

    // 系统的逻辑入口。dt 是本帧的时间步（秒）。
    public abstract void Update(World world, double dt);
}
