using System;

namespace Game.Board;

// 网格寻路器：广度优先搜索，按步数最短（未加权网格）求一条
// 从起点到终点的路径；格子值等于 blockedValue 的格子视为障碍。
class GridPathfinder {
    static int[] s_dx4 = new int[4] { 0, -1, 1, 0 };
    static int[] s_dy4 = new int[4] { -1, 0, 0, 1 };
    static int[] s_dx8 = new int[8] { -1, 0, 1, -1, 1, -1, 0, 1 };
    static int[] s_dy8 = new int[8] { -1, -1, -1, 0, 0, 1, 1, 1 };

    // 在 board 上寻找 (startX, startY) 到 (targetX, targetY) 的路径：
    // allowDiagonal 为 true 时允许 8 方向，否则仅 4 方向；终点本身
    // 为障碍值时视为不可达。board 为 null、起终点越界或不可达时
    // 返回空路径（Found 为 false）；找到时路径含起点与终点两端。
    static GridPath Find(
        GridBoard board,
        int startX,
        int startY,
        int targetX,
        int targetY,
        int blockedValue,
        bool allowDiagonal
    ) {
        GridPath empty = GridPath.Empty();
        if (board == null
            || !board.Inside(startX, startY)
            || !board.Inside(targetX, targetY)
            || board.Get(targetX, targetY) == blockedValue) {
            return empty;
        }

        int bw = board.Width();
        int bh = board.Height();
        int total = bw * bh;
        int[] previous = new int[total];
        int[] queue = new int[total];

        int start = startY * bw + startX;
        int target = targetY * bw + targetX;
        previous[start] = -1;
        queue[0] = start;
        int head = 0;
        int tail = 1;

        int[] dirsX = allowDiagonal ? s_dx8 : s_dx4;
        int[] dirsY = allowDiagonal ? s_dy8 : s_dy4;
        int dirCount = allowDiagonal ? 8 : 4;

        while (head < tail && previous[target] == 0) {
            int current = queue[head];
            head = head + 1;
            int cy = current / bw;
            int cx = current - cy * bw;

            for (int d = 0; d < dirCount; d = d + 1) {
                int nx = cx + dirsX[d];
                int ny = cy + dirsY[d];
                if (nx >= 0 && nx < bw && ny >= 0 && ny < bh
                    && board.Get(nx, ny) != blockedValue) {
                    int next = ny * bw + nx;
                    if (previous[next] == 0) {
                        previous[next] = current + 1;
                        queue[tail] = next;
                        tail = tail + 1;
                    }
                }
            }
        }

        if (previous[target] == 0) { return empty; }
        // 复用已完成 BFS 遍历的 queue 数组回溯路径，彻底消除 List<int> 堆分配与动态扩容开销
        int pathLen = 0;
        int cursor = target;
        while (cursor >= 0) {
            queue[pathLen] = cursor;
            pathLen = pathLen + 1;
            if (previous[cursor] == -1) { break; }
            cursor = previous[cursor] - 1;
        }

        GridPath path = GridPath.Empty();
        int i = pathLen - 1;
        while (i >= 0) {
            int cell = queue[i];
            int y = cell / bw;
            int x = cell - y * bw;
            path.Add(x, y);
            i = i - 1;
        }
        return path;
    }
}
