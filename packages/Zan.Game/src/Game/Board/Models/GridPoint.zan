using System;

namespace Game.Board;

// 整数格点（寻路结果中的坐标单元）。
public class GridPoint {
    public int x;
    public int y;

    // 创建格点 (x, y)。
    public static GridPoint At(int x, int y) {
        GridPoint point = new GridPoint();
        point.x = x;
        point.y = y;
        return point;
    }

    // 格点 X 坐标（列）。
    public int X() { return this.x; }
    // 格点 Y 坐标（行）。
    public int Y() { return this.y; }
}
