using System;

namespace Game.Board;

// 整数格点（寻路结果中的坐标单元）。
class GridPoint {
    int x;
    int y;

    // 创建格点 (x, y)。
    static GridPoint At(int x, int y) {
        GridPoint point = new GridPoint();
        point.x = x;
        point.y = y;
        return point;
    }

    // 格点 X 坐标（列）。
    int X() { return this.x; }
    // 格点 Y 坐标（行）。
    int Y() { return this.y; }
}
