using System;
using System.Collections.Generic;

namespace Game.Board;

// 棋类 AI 的搜索接口：alpha-beta 搜索靠这五个动作驱动游戏。
//
// 约定：
//   GenerateMoves —— 当前行棋方的**全部**合法着法（int 编码，含义由游戏自定；
//                    同一个游戏里必须能唯一标识一个着法）；
//   ApplyMove    —— 落子并推进行棋方；
//   UndoMove     —— 撤销上一步（与 ApplyMove 成对，搜索会严格配对调用）；
//   Evaluate     —— 从**当前行棋方**视角给局面打分（正数 = 当前行棋方占优）；
//   IsTerminal   —— 是否终局（分出胜负或和棋）。终局的分数由 Evaluate 给出
//                    （例如赢 +1000000、输 -1000000），搜索会按行棋方取反。
//
// 搜索只认这五个动作，不关心棋盘长什么样——所以象棋、围棋、五子棋、
// 井字棋都能用同一套 negamax。
public interface ISearchGame {
    // 生成当前行棋方的全部合法着法。
    public List<int> GenerateMoves();
    // 落子（并推进行棋方/状态机）。
    public void ApplyMove(int move);
    // 撤销上一步（必须与 ApplyMove 成对）。
    public void UndoMove();
    // 局面评估：从当前行棋方视角打分，正数表示占优。
    public int Evaluate();
    // 是否已是终局。
    public bool IsTerminal();
}
