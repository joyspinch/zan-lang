using System;
using System.Collections.Generic;

namespace Game.Board;

// 围棋规则棋盘：落子、提子、禁着（打劫 / 自杀）、气数、数子（中国规则）。
//
// 设计口径：**只管规则，不管表现**。
// 提子动画、音效、飘字由调用方拿 returned 提子坐标自己播；
// 这里不引用任何 Gui/渲染类型，游戏可以跑在无头服务端。
//
// 坐标：(x, y) 原点在棋盘左上，x 向右、y 向下；
// Cells 是行主序（index = y * Size + x），外部可直读做渲染。
//
// 颜色：Empty=0 / Black=1 / White=2。
public class GoBoard {
    public const int Empty = 0;
    public const int Black = 1;
    public const int White = 2;

    public int Size;
    public int[] Cells;

    // 打劫禁着点（sq），-1 = 无。落子后由规则自动维护。
    public int KoPoint;
    // 最后一手（sq），-1 = 无（停一手后清空）。
    public int LastMove;
    // 连续停手次数：两次停手 = 对局结束（数子）。
    public int ConsecutivePasses;
    // 各方提掉的子数（不是自己被提的）。
    public int CapturedByBlack;
    public int CapturedByWhite;

    public GoBoard(int size) {
        if (size < 2) { size = 9; }
        this.Size = size;
        this.Cells = new int[size * size];
        this.KoPoint = -1;
        this.LastMove = -1;
    }

    // 清空棋盘并复位所有计数。
    public void Reset() {
        for (int i = 0; i < this.Cells.Length; i = i + 1) {
            this.Cells[i] = GoBoard.Empty;
        }
        this.KoPoint = -1;
        this.LastMove = -1;
        this.ConsecutivePasses = 0;
        this.CapturedByBlack = 0;
        this.CapturedByWhite = 0;
    }

    // 另一个颜色（黑白互换）。传入非黑非白时返回 Empty。
    public static int Other(int color) {
        if (color == GoBoard.Black) { return GoBoard.White; }
        if (color == GoBoard.White) { return GoBoard.Black; }
        return GoBoard.Empty;
    }

    // 越界返回 -1（不是 Empty——调用方要能区分"界外"和"空点"）。
    public int At(int x, int y) {
        if (x < 0 || y < 0 || x >= this.Size || y >= this.Size) { return -1; }
        return this.Cells[y * this.Size + x];
    }

    // 连通块的气数（**唯一**空点数，不是空点总数）。
    // squares 收集块内所有点的 sq；返回气数。
    public int Group(int x, int y, List<int> squares) {
        int n = this.Size;
        int c = this.At(x, y);
        if (c <= 0) { return 0; }
        bool[] seen = new bool[n * n];
        bool[] libSeen = new bool[n * n];
        List<int> stack = new List<int>();
        int start = y * n + x;
        stack.Add(start);
        seen[start] = true;
        int libs = 0;
        while (stack.Count > 0) {
            int sq = stack[stack.Count - 1];
            stack.RemoveAt(stack.Count - 1);
            if (squares != null) { squares.Add(sq); }
            int sx = sq % n;
            int sy = sq / n;
            for (int d = 0; d < 4; d = d + 1) {
                int tx = sx + GoBoard.StepX(d);
                int ty = sy + GoBoard.StepY(d);
                int v = this.At(tx, ty);
                if (v == GoBoard.Empty) {
                    int tsq = ty * n + tx;
                    if (!libSeen[tsq]) { libSeen[tsq] = true; libs = libs + 1; }
                } else if (v == c) {
                    int tsq = ty * n + tx;
                    if (!seen[tsq]) { seen[tsq] = true; stack.Add(tsq); }
                }
            }
        }
        return libs;
    }

    // 落子：成功返回提掉的子数（0 = 没提子），非法返回 -1 且棋盘不变。
    public int Play(int x, int y, int color) {
        return this.Play(x, y, color, null);
    }

    // 落子并把被提子的坐标写进 captured（可为 null）。
    // 非法（占位 / 打劫禁着 / 自杀无气）返回 -1，棋盘与计数都不变。
    public int Play(int x, int y, int color, List<int> captured) {
        return this.ApplyMove(x, y, color, captured, true);
    }

    // 落子核心。applyState=false 时只演算、不落状态（试探用）：
    // 不写 KoPoint / LastMove / pass 计数 / 提子计数。
    public int ApplyMove(int x, int y, int color, List<int> captured, bool applyState) {
        if (color != GoBoard.Black && color != GoBoard.White) { return -1; }
        if (this.At(x, y) != GoBoard.Empty) { return -1; }
        int n = this.Size;
        int sq = y * n + x;
        if (sq == this.KoPoint) { return -1; }
        this.Cells[sq] = color;
        int other = GoBoard.Other(color);
        int count = 0;
        int lastCaptured = -1;
        for (int d = 0; d < 4; d = d + 1) {
            int tx = x + GoBoard.StepX(d);
            int ty = y + GoBoard.StepY(d);
            if (this.At(tx, ty) == other) {
                List<int> g = new List<int>();
                int libs = this.Group(tx, ty, g);
                if (libs == 0) {
                    for (int i = 0; i < g.Count; i = i + 1) {
                        this.Cells[g[i]] = GoBoard.Empty;
                        lastCaptured = g[i];
                        count = count + 1;
                        if (captured != null) { captured.Add(g[i]); }
                    }
                }
            }
        }
        // 自杀禁手：没提到子且自己一气都没有 = 非法（提到子就必然有气）。
        List<int> own = new List<int>();
        int ownLibs = this.Group(x, y, own);
        if (count == 0 && ownLibs == 0) {
            this.Cells[sq] = GoBoard.Empty;
            return -1;
        }
        if (applyState) {
            // 打劫：单子提单子且自己只剩一气 —— 提掉的那点下一手不能立刻回提。
            this.KoPoint = -1;
            if (count == 1 && own.Count == 1 && ownLibs == 1) { this.KoPoint = lastCaptured; }
            this.LastMove = sq;
            this.ConsecutivePasses = 0;
            if (color == GoBoard.Black) {
                this.CapturedByBlack = this.CapturedByBlack + count;
            } else {
                this.CapturedByWhite = this.CapturedByWhite + count;
            }
        }
        return count;
    }

    // 无副作用试探：返回这手能提几个子（非法返回 -1），
    // 棋盘、Ko、提子计数全部保持原样——AI 试算与 UI 提示都用它。
    public int Probe(int x, int y, int color) {
        int n = this.Size * this.Size;
        int[] save = new int[n];
        for (int i = 0; i < n; i = i + 1) { save[i] = this.Cells[i]; }
        int saveKo = this.KoPoint;
        int saveLast = this.LastMove;
        int savePass = this.ConsecutivePasses;
        int saveByBlack = this.CapturedByBlack;
        int saveByWhite = this.CapturedByWhite;
        int res = this.Play(x, y, color, null);
        for (int i = 0; i < n; i = i + 1) { this.Cells[i] = save[i]; }
        this.KoPoint = saveKo;
        this.LastMove = saveLast;
        this.ConsecutivePasses = savePass;
        this.CapturedByBlack = saveByBlack;
        this.CapturedByWhite = saveByWhite;
        return res;
    }

    // 一次探测给出 AI 需要的全部信息：能不能下、能提几个、落下后己方多大几气。
    // 棋盘与所有计数保持原样——这是围棋 AI 评估一手棋的标准问法。
    public GoProbe ProbeMove(int x, int y, int color) {
        GoProbe probe = new GoProbe();
        int n = this.Size * this.Size;
        int[] save = new int[n];
        for (int i = 0; i < n; i = i + 1) { save[i] = this.Cells[i]; }
        int saveKo = this.KoPoint;
        int saveLast = this.LastMove;
        int savePass = this.ConsecutivePasses;
        int saveByBlack = this.CapturedByBlack;
        int saveByWhite = this.CapturedByWhite;
        int captured = this.ApplyMove(x, y, color, null, false);
        if (captured >= 0) {
            List<int> own = new List<int>();
            probe.Liberties = this.Group(x, y, own);
            probe.GroupSize = own.Count;
        }
        for (int i = 0; i < n; i = i + 1) { this.Cells[i] = save[i]; }
        this.KoPoint = saveKo;
        this.LastMove = saveLast;
        this.ConsecutivePasses = savePass;
        this.CapturedByBlack = saveByBlack;
        this.CapturedByWhite = saveByWhite;
        probe.Captured = captured;
        probe.Legal = captured >= 0;
        return probe;
    }

    // 停一手：清打劫禁着，pass 计数 +1。连续两次停手 = 对局结束。
    public void Pass(int color) {
        this.KoPoint = -1;
        this.LastMove = -1;
        this.ConsecutivePasses = this.ConsecutivePasses + 1;
    }

    // 两次停手后是否该数子收官。
    public bool IsOverByPasses() {
        return this.ConsecutivePasses >= 2;
    }

    // 中国规则数子（子空皆地）：空点被双方同时围住算争议，不计入任一方。
    // komi 是白方贴目（中国规则常贴 7.5 子）。
    public GoScore Score(double komi) {
        int n = this.Size * this.Size;
        int black = 0;
        int white = 0;
        bool[] seen = new bool[n];
        for (int i = 0; i < n; i = i + 1) {
            int v = this.Cells[i];
            if (v == GoBoard.Black) { black = black + 1; continue; }
            if (v == GoBoard.White) { white = white + 1; continue; }
            if (seen[i]) { continue; }
            List<int> region = new List<int>();
            List<int> stack = new List<int>();
            stack.Add(i);
            seen[i] = true;
            bool touchBlack = false;
            bool touchWhite = false;
            while (stack.Count > 0) {
                int sq = stack[stack.Count - 1];
                stack.RemoveAt(stack.Count - 1);
                region.Add(sq);
                int sx = sq % this.Size;
                int sy = sq / this.Size;
                for (int d = 0; d < 4; d = d + 1) {
                    int tx = sx + GoBoard.StepX(d);
                    int ty = sy + GoBoard.StepY(d);
                    int v2 = this.At(tx, ty);
                    if (v2 == GoBoard.Empty) {
                        int tsq = ty * this.Size + tx;
                        if (!seen[tsq]) { seen[tsq] = true; stack.Add(tsq); }
                    } else if (v2 == GoBoard.Black) { touchBlack = true; }
                    else if (v2 == GoBoard.White) { touchWhite = true; }
                }
            }
            if (touchBlack && !touchWhite) { black = black + region.Count; }
            else if (touchWhite && !touchBlack) { white = white + region.Count; }
        }
        return new GoScore(black, white, komi);
    }

    // 四邻方向的步长：0=右 1=左 2=下 3=上。
    public static int StepX(int dir) {
        if (dir == 0) { return 1; }
        if (dir == 1) { return -1; }
        return 0;
    }

    public static int StepY(int dir) {
        if (dir == 2) { return 1; }
        if (dir == 3) { return -1; }
        return 0;
    }
}

// 一次探测的结果（ProbeMove 的返回）。
public class GoProbe {
    // 这手是否合法（不撞禁着、不自杀、有空位）。
    public bool Legal;
    // 能提掉的子数。
    public int Captured;
    // 落下后己方连通块的气数。
    public int Liberties;
    // 落下后己方连通块的子数。
    public int GroupSize;
}

// 数子结果（贴目后可直接比较）。
public class GoScore {
    public int Black;
    public int White;
    public double Komi;

    public GoScore(int black, int white, double komi) {
        this.Black = black;
        this.White = white;
        this.Komi = komi;
    }

    // 黑方总数（无贴目）。
    public double BlackTotal() { return (double)this.Black; }

    // 白方总数（含贴目）。
    public double WhiteTotal() { return (double)this.White + this.Komi; }

    // 胜方：Black / White / 0（和棋）。
    public int Winner() {
        if (this.BlackTotal() > this.WhiteTotal()) { return GoBoard.Black; }
        if (this.WhiteTotal() > this.BlackTotal()) { return GoBoard.White; }
        return 0;
    }
}
