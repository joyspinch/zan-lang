using System;

namespace Game.Board;

/// <summary>整数格点（寻路结果中的坐标单元）。</summary>
class GridPoint {
    int x;
    int y;

    /// 创建格点 (x, y)。
    static GridPoint At(int x, int y) {
        GridPoint point = new GridPoint();
        point.x = x;
        point.y = y;
        return point;
    }

    /// 格点 X 坐标（列）。
    int X() { return this.x; }
    /// 格点 Y 坐标（行）。
    int Y() { return this.y; }
}

/// <summary>
/// 整数网格，供棋类、战棋、推箱子类解谜及
/// 确定性地图模拟共用。
/// </summary>
class GridBoard {
    int width;
    int height;
    List<int> cells;

    GridBoard(int width, int height, int initialValue) {
        this.width = width;
        this.height = height;
        if (this.width < 1) { this.width = 1; }
        if (this.height < 1) { this.height = 1; }
        this.cells = new List<int>();
        for (int i = 0; i < this.width * this.height; i = i + 1) {
            this.cells.Add(initialValue);
        }
    }

    /// 坐标 (x, y) 是否位于网格内。
    bool Inside(int x, int y) {
        return x >= 0 && y >= 0 && x < this.width && y < this.height;
    }

    /// 行优先展开的一维索引（= y * Width + x）；越界坐标会产生越界索引。
    int Index(int x, int y) { return y * this.width + x; }

    /// 读取格子值；坐标越界时返回 0（而非报错），
    /// 因此 0 不应被用作需要区分"格外"的语义值。
    int Get(int x, int y) {
        if (!this.Inside(x, y)) { return 0; }
        return this.cells[this.Index(x, y)];
    }

    /// 写入格子值；坐标越界时返回 false 不修改，成功返回 true。
    bool Set(int x, int y, int cellValue) {
        if (!this.Inside(x, y)) { return false; }
        this.cells[this.Index(x, y)] = cellValue;
        return true;
    }

    /// 将全部格子置为 cellValue。
    void Fill(int cellValue) {
        for (int i = 0; i < this.cells.Count; i = i + 1) {
            this.cells[i] = cellValue;
        }
    }

    /// 统计值等于 cellValue 的格子数。
    int CountValue(int cellValue) {
        int count = 0;
        for (int i = 0; i < this.cells.Count; i = i + 1) {
            if (this.cells[i] == cellValue) { count = count + 1; }
        }
        return count;
    }

    /// 深拷贝当前网格（尺寸与全部格子值独立，互不影响）。
    GridBoard Clone() {
        GridBoard clone = new GridBoard(this.width, this.height, 0);
        for (int i = 0; i < this.cells.Count; i = i + 1) {
            clone.cells[i] = this.cells[i];
        }
        return clone;
    }

    /// <summary>
    /// 确定性状态哈希（FNV 风格：异或后乘大质数，依次混入宽、
    /// 高与全部格子值）。相同内容恒得相同哈希，供回放校验。
    /// </summary>
    int Hash() {
        int hash = 0x739D0383;
        hash = (hash ^ this.width) * 1099511628211;
        hash = (hash ^ this.height) * 1099511628211;
        for (int i = 0; i < this.cells.Count; i = i + 1) {
            hash = (hash ^ this.cells[i]) * 1099511628211;
        }
        return hash;
    }

    /// 列数。
    int Width() { return this.width; }
    /// 行数。
    int Height() { return this.height; }
    /// 格子总数（= Width * Height）。
    int CellCount() { return this.cells.Count; }
    /// 按行优先一维索引直接读格子（配合 Index 使用）；越界行为由底层 List 决定（抛错）。
    int CellAt(int index) { return this.cells[index]; }
}

/// <summary>
/// 寻路结果：格子坐标点序列（起点到终点，含两端）。
/// 通过 Found 区分"找到路径"与"不可达/参数非法"（二者都是空路径）。
/// </summary>
class GridPath {
    List<GridPoint> points;

    /// 创建空路径（Found 为 false）。
    static GridPath Empty() {
        GridPath path = new GridPath();
        path.points = new List<GridPoint>();
        return path;
    }

    /// 追加一个路径点（由寻路器按起点到终点顺序调用）。
    void Add(int x, int y) { this.points.Add(GridPoint.At(x, y)); }
    /// 路径点数（0 表示空路径）。
    int Count() { return this.points.Count; }
    /// 第 index 个路径点；越界行为由底层 List 决定（抛错）。
    GridPoint At(int index) { return this.points[index]; }
    /// 是否找到路径（路径非空；不可达与参数非法均为空路径）。
    bool Found() { return this.points.Count > 0; }
}

/// <summary>
/// 网格寻路器：广度优先搜索，按步数最短（未加权网格）求一条
/// 从起点到终点的路径；格子值等于 blockedValue 的格子视为障碍。
/// </summary>
class GridPathfinder {
    /// <summary>
    /// 在 board 上寻找 (startX, startY) 到 (targetX, targetY) 的路径：
    /// allowDiagonal 为 true 时允许 8 方向，否则仅 4 方向；终点本身
    /// 为障碍值时视为不可达。board 为 null、起终点越界或不可达时
    /// 返回空路径（Found 为 false）；找到时路径含起点与终点两端。
    /// </summary>
    static GridPath Find(
        GridBoard board,
        int startX,
        int startY,
        int targetX,
        int targetY,
        int blockedValue,
        bool allowDiagonal
    ) {
        GridPath empty = GridPath.Empty();
        if (board == null
            || !board.Inside(startX, startY)
            || !board.Inside(targetX, targetY)
            || board.Get(targetX, targetY) == blockedValue) {
            return empty;
        }

        int total = board.Width() * board.Height();
        List<int> previous = new List<int>();
        List<int> queue = new List<int>();
        int i = 0;
        for (; i < total; i = i + 1) {
            previous.Add(-2);
        }

        int start = startY * board.Width() + startX;
        int target = targetY * board.Width() + targetX;
        previous[start] = -1;
        queue.Add(start);
        int head = 0;

        while (head < queue.Count && previous[target] == -2) {
            int current = queue[head];
            head = head + 1;
            int cx = current - (current / board.Width()) * board.Width();
            int cy = current / board.Width();
            int dy = -1;
            while (dy <= 1) {
                int dx = -1;
                while (dx <= 1) {
                    bool cardinal = dx == 0 || dy == 0;
                    if (!(dx == 0 && dy == 0)
                        && (allowDiagonal || cardinal)) {
                        int nx = cx + dx;
                        int ny = cy + dy;
                        if (board.Inside(nx, ny)
                            && board.Get(nx, ny) != blockedValue) {
                            int next = ny * board.Width() + nx;
                            if (previous[next] == -2) {
                                previous[next] = current;
                                queue.Add(next);
                            }
                        }
                    }
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
        }

        if (previous[target] == -2) { return empty; }
        List<int> reverse = new List<int>();
        int cursor = target;
        while (cursor >= 0) {
            reverse.Add(cursor);
            cursor = previous[cursor];
        }

        GridPath path = GridPath.Empty();
        i = reverse.Count - 1;
        while (i >= 0) {
            int cell = reverse[i];
            int x = cell - (cell / board.Width()) * board.Width();
            int y = cell / board.Width();
            path.Add(x, y);
            i = i - 1;
        }
        return path;
    }
}
