using System;
using System.Collections.Generic;
using System.Numerics;
using Game.Animation;

namespace Game.Combat3D;

// 战术射击角色解剖受击部位常量。
public static class HitboxRegion3D {
    public const int Unknown = 0;
    public const int Head = 1;
    public const int Neck = 2;
    public const int Chest = 3;
    public const int Stomach = 4;
    public const int Pelvis = 5;
    public const int UpperArm = 6;
    public const int Forearm = 7;
    public const int Thigh = 8;
    public const int Calf = 9;
}

// 挂接在单根骨骼局部空间下的胶囊体受击盒定义。
public struct HitboxCapsuleDef3D {
    public int BoneIndex;
    public int RegionId;
    public Vector3 LocalPointA;
    public Vector3 LocalPointB;
    public float Radius;
    public float DamageMultiplier;
}

// 骨骼受击盒命中详情（值类型，零堆分配）。
public struct HitboxRayHit3D {
    public bool Hit;
    public int ActorId;
    public int TeamId;
    public int CapsuleIndex;
    public int BoneIndex;
    public int RegionId;
    public float DamageMultiplier;
    public float Distance;
    public Vector3 Point;
    public Vector3 Normal;
    public double RewoundTimestamp;
}

// 可复用的角色骨骼受击盒配置模板（内部采用连续值数组存储，内层求交零集合包装开销）。
public class SkeletalHitboxRig3D {
    internal HitboxCapsuleDef3D[] Defs;
    internal int DefCount;

    public SkeletalHitboxRig3D() {
        this.Defs = new HitboxCapsuleDef3D[12];
        this.DefCount = 0;
    }

    public int Count() { return this.DefCount; }

    public HitboxCapsuleDef3D At(int index) {
        return this.Defs[index];
    }

    public int AddCapsule(int boneIndex, int regionId, Vector3 localA, Vector3 localB,
                          float radius, float damageMultiplier) {
        if (this.DefCount >= this.Defs.Length) {
            HitboxCapsuleDef3D[] grown = new HitboxCapsuleDef3D[this.Defs.Length * 2];
            for (int i = 0; i < this.DefCount; i = i + 1) {
                grown[i] = this.Defs[i];
            }
            this.Defs = grown;
        }
        HitboxCapsuleDef3D def = new HitboxCapsuleDef3D();
        def.BoneIndex = boneIndex;
        def.RegionId = regionId;
        def.LocalPointA = localA;
        def.LocalPointB = localB;
        def.Radius = Math.Max(radius, 0.001f);
        def.DamageMultiplier = damageMultiplier;
        int idx = this.DefCount;
        this.Defs[idx] = def;
        this.DefCount = idx + 1;
        return idx;
    }

    // 按骨骼名称挂接胶囊体（若骨骼不存在返回 -1）。
    public int AddCapsuleByBoneName(Skeleton skeleton, string boneName, int regionId,
                                    Vector3 localA, Vector3 localB, float radius, float damageMultiplier) {
        if (skeleton == null) { return -1; }
        int idx = skeleton.IndexOf(boneName);
        if (idx < 0) { return -1; }
        return this.AddCapsule(idx, regionId, localA, localB, radius, damageMultiplier);
    }
}

// 单个战斗实体的预分配 2 的幂扁平历史姿势环形缓冲槽位（位掩码寻址，Tick 写入与回溯插值全程零堆分配）。
internal class ActorHitboxHistorySlot {
    public int ActorId;
    public int TeamId;
    public bool Active;
    public SkeletalHitboxRig3D Rig;

    public int HistoryCapacity; // 严格为 2 的幂
    public int CapacityMask;    // HistoryCapacity - 1
    public int CapsuleCount;
    public int Head;            // 下一次写入的环下标
    public int Count;           // 已记录的有效帧数 (<= HistoryCapacity)

    public double[] Timestamps;   // [HistoryCapacity]
    public float[] ActorBounds;   // [HistoryCapacity * 6] minX,minY,minZ, maxX,maxY,maxZ
    public float[] CapsuleWorld;  // [HistoryCapacity * CapsuleCount * 7] ax,ay,az, bx,by,bz, worldRadius

    public ActorHitboxHistorySlot(int actorId, int teamId, SkeletalHitboxRig3D rig, int minHistoryCapacity) {
        this.ActorId = actorId;
        this.TeamId = teamId;
        this.Active = true;
        this.Rig = rig;

        int pow2 = 4;
        while (pow2 < minHistoryCapacity) { pow2 = pow2 * 2; }
        this.HistoryCapacity = pow2;
        this.CapacityMask = pow2 - 1;
        this.CapsuleCount = rig.DefCount;
        this.Head = 0;
        this.Count = 0;
        this.Timestamps = new double[pow2];
        this.ActorBounds = new float[pow2 * 6];
        this.CapsuleWorld = new float[pow2 * this.CapsuleCount * 7];
    }

    public void ClearHistory() {
        this.Head = 0;
        this.Count = 0;
    }
}

// 权威服务端延迟补偿（Server-Side Rewind Lag Compensation）与全身骨骼受击盒判定世界：
// - 2 的幂环形历史快照 + O(1) Tick 步长直测帧定位 + 象限符号无分支角色 AABB 粗筛
// - 单分支解析式射线-胶囊体求交（Inigo Quilez 无限圆柱包络淘汰：未命中 0 次开方，命中柱面仅 1 次 MathF.Sqrt）
// - 支持同角色躯体穿透高倍率优先（防止角色抬枪手臂遮挡后方近距离头部导致爆头被吞）
public class LagCompensatedHitboxWorld3D {
    public double MaxRewindSeconds;
    public float IntraActorPriorityDepth;

    private ActorHitboxHistorySlot[] slotArray;
    private int slotCount;
    private Dictionary<int, int> actorToSlot;
    private int defaultHistoryCapacity;

    public LagCompensatedHitboxWorld3D() : this(64) {
    }

    public LagCompensatedHitboxWorld3D(int historyTicksPerActor) {
        this.MaxRewindSeconds = 0.30;
        this.IntraActorPriorityDepth = 0.28f;
        this.defaultHistoryCapacity = historyTicksPerActor > 4 ? historyTicksPerActor : 4;
        this.slotArray = new ActorHitboxHistorySlot[16];
        this.slotCount = 0;
        this.actorToSlot = new Dictionary<int, int>();
    }

    public void RegisterActor(int actorId, int teamId, SkeletalHitboxRig3D rig) {
        if (rig == null || rig.Count() <= 0) { return; }
        int existingIdx;
        if (this.actorToSlot.TryGetValue(actorId, out existingIdx)) {
            ActorHitboxHistorySlot existing = this.slotArray[existingIdx];
            if (existing.CapsuleCount == rig.Count()) {
                existing.TeamId = teamId;
                existing.Rig = rig;
                existing.Active = true;
                existing.ClearHistory();
                return;
            }
            this.slotArray[existingIdx] = new ActorHitboxHistorySlot(actorId, teamId, rig, this.defaultHistoryCapacity);
            return;
        }
        if (this.slotCount >= this.slotArray.Length) {
            ActorHitboxHistorySlot[] grown = new ActorHitboxHistorySlot[this.slotArray.Length * 2];
            for (int i = 0; i < this.slotCount; i = i + 1) {
                grown[i] = this.slotArray[i];
            }
            this.slotArray = grown;
        }
        ActorHitboxHistorySlot slot = new ActorHitboxHistorySlot(actorId, teamId, rig, this.defaultHistoryCapacity);
        int newIdx = this.slotCount;
        this.slotArray[newIdx] = slot;
        this.slotCount = newIdx + 1;
        this.actorToSlot.Add(actorId, newIdx);
    }

    public void SetActorActive(int actorId, bool active) {
        int idx;
        if (this.actorToSlot.TryGetValue(actorId, out idx)) {
            ActorHitboxHistorySlot slot = this.slotArray[idx];
            slot.Active = active;
            if (!active) {
                slot.ClearHistory();
            }
        }
    }

    public void UnregisterActor(int actorId) {
        this.SetActorActive(actorId, false);
    }

    // 在服务端固定物理/网络 Tick 末尾记录角色当前骨骼世界受击盒快照（全程零堆分配）。
    public void RecordSnapshot(int actorId, double serverTimestamp,
                               Transform3D actorWorldTransform, Skeleton posedSkeleton) {
        if (posedSkeleton == null) { return; }
        int slotIdx;
        if (!this.actorToSlot.TryGetValue(actorId, out slotIdx)) { return; }
        ActorHitboxHistorySlot slot = this.slotArray[slotIdx];
        int capCount = slot.CapsuleCount;
        if (!slot.Active || capCount <= 0) { return; }

        posedSkeleton.ComputeWorldPoses();
        int writeIdx = slot.Head;
        slot.Timestamps[writeIdx] = serverTimestamp;

        float minX = 1e30f; float minY = 1e30f; float minZ = 1e30f;
        float maxX = -1e30f; float maxY = -1e30f; float maxZ = -1e30f;

        float[] cw = slot.CapsuleWorld;
        HitboxCapsuleDef3D[] defs = slot.Rig.Defs;
        int capBase = writeIdx * capCount * 7;
        int skelCount = posedSkeleton.Count();

        for (int c = 0; c < capCount; c = c + 1) {
            HitboxCapsuleDef3D def = defs[c];
            Transform3D boneWorld = actorWorldTransform;
            if (def.BoneIndex >= 0 && def.BoneIndex < skelCount) {
                boneWorld = Transform3D.Compose(actorWorldTransform, posedSkeleton.WorldPose(def.BoneIndex));
            }
            Vector3 wa = boneWorld.TransformPoint(def.LocalPointA);
            Vector3 wb = boneWorld.TransformPoint(def.LocalPointB);
            float maxScale = Math.Max(Math.Abs(boneWorld.Scale.X), Math.Max(Math.Abs(boneWorld.Scale.Y), Math.Abs(boneWorld.Scale.Z)));
            float wr = def.Radius * (maxScale > 1e-4f ? maxScale : 1.0f);

            int o = capBase + c * 7;
            cw[o + 0] = wa.X; cw[o + 1] = wa.Y; cw[o + 2] = wa.Z;
            cw[o + 3] = wb.X; cw[o + 4] = wb.Y; cw[o + 5] = wb.Z;
            cw[o + 6] = wr;

            minX = Math.Min(minX, Math.Min(wa.X, wb.X) - wr);
            minY = Math.Min(minY, Math.Min(wa.Y, wb.Y) - wr);
            minZ = Math.Min(minZ, Math.Min(wa.Z, wb.Z) - wr);
            maxX = Math.Max(maxX, Math.Max(wa.X, wb.X) + wr);
            maxY = Math.Max(maxY, Math.Max(wa.Y, wb.Y) + wr);
            maxZ = Math.Max(maxZ, Math.Max(wa.Z, wb.Z) + wr);
        }

        float[] ab = slot.ActorBounds;
        int bOff = writeIdx * 6;
        ab[bOff + 0] = minX; ab[bOff + 1] = minY; ab[bOff + 2] = minZ;
        ab[bOff + 3] = maxX; ab[bOff + 4] = maxY; ab[bOff + 5] = maxZ;

        slot.Head = (writeIdx + 1) & slot.CapacityMask;
        if (slot.Count < slot.HistoryCapacity) {
            slot.Count = slot.Count + 1;
        }
    }

    // 执行延迟补偿亚帧回溯射击判定。
    public bool RaycastLagCompensated(Vector3 origin, Vector3 direction, float maxRange,
                                      int shooterActorId, int shooterTeamId, bool ignoreTeammates,
                                      double serverCurrentTime, double requestedTargetTime,
                                      StaticMeshBvh3D staticWorld,
                                      out HitboxRayHit3D hit) {
        hit = new HitboxRayHit3D();
        hit.Hit = false;
        hit.ActorId = -1;
        hit.CapsuleIndex = -1;
        hit.BoneIndex = -1;
        if (maxRange <= 0.0f || this.slotCount <= 0) { return false; }

        float dLenSq = direction.LengthSquared();
        if (dLenSq <= 1e-12f) { return false; }
        float invLen = Math.Abs(dLenSq - 1.0f) > 1e-5f ? (1.0f / MathF.Sqrt(dLenSq)) : 1.0f;
        float dx = direction.X * invLen;
        float dy = direction.Y * invLen;
        float dz = direction.Z * invLen;
        Vector3 dir = new Vector3(dx, dy, dz);

        // 1. 反作弊回溯窗口钳制
        double minAllowed = serverCurrentTime - this.MaxRewindSeconds;
        double targetTime = requestedTargetTime;
        if (targetTime > serverCurrentTime) { targetTime = serverCurrentTime; }
        if (targetTime < minAllowed) { targetTime = minAllowed; }

        // 2. 静态世界墙壁遮挡截断（直接走已归一化方向快速通道）
        float effectiveMaxDist = maxRange;
        if (staticWorld != null) {
            MeshRayHit3D wallHit;
            if (staticWorld.RaycastUnitDir(origin, dx, dy, dz, maxRange, false, out wallHit)) {
                effectiveMaxDist = wallHit.Distance;
            }
        }
        if (effectiveMaxDist <= 1e-5f) { return false; }

        float invDx = StaticMeshBvh3D.SafeInvDir(dx);
        float invDy = StaticMeshBvh3D.SafeInvDir(dy);
        float invDz = StaticMeshBvh3D.SafeInvDir(dz);
        int nearX = invDx >= 0.0f ? 0 : 3; int farX = 3 - nearX;
        int nearY = invDy >= 0.0f ? 1 : 4; int farY = 5 - nearY;
        int nearZ = invDz >= 0.0f ? 2 : 5; int farZ = 7 - nearZ;

        float bestDist = effectiveMaxDist;
        bool foundAny = false;
        float prioDepth = this.IntraActorPriorityDepth;

        ActorHitboxHistorySlot[] slots = this.slotArray;
        int nSlots = this.slotCount;
        float ox = origin.X; float oy = origin.Y; float oz = origin.Z;

        // 3. 遍历存活敌方槽位：O(1) 历史帧定位 + 无分支象限 AABB 粗筛 + 单分支胶囊求交
        for (int s = 0; s < nSlots; s = s + 1) {
            ActorHitboxHistorySlot slot = slots[s];
            if (!slot.Active || slot.Count <= 0) { continue; }
            if (slot.ActorId == shooterActorId) { continue; }
            if (ignoreTeammates && shooterTeamId != 0 && slot.TeamId == shooterTeamId) { continue; }

            int idxOld;
            int idxNew;
            float alpha;
            double actualSampleTime;
            LagCompensatedHitboxWorld3D.FindBracketingSnapshots(slot, targetTime, out idxOld, out idxNew, out alpha, out actualSampleTime);

            float[] ab = slot.ActorBounds;
            int b0 = idxOld * 6;
            float aBounds0; float aBounds1; float aBounds2;
            float aBounds3; float aBounds4; float aBounds5;

            if (idxOld == idxNew || alpha <= 1e-6f) {
                aBounds0 = ab[b0 + 0]; aBounds1 = ab[b0 + 1]; aBounds2 = ab[b0 + 2];
                aBounds3 = ab[b0 + 3]; aBounds4 = ab[b0 + 4]; aBounds5 = ab[b0 + 5];
                alpha = 0.0f;
            } else {
                int b1 = idxNew * 6;
                aBounds0 = ab[b0 + 0] + (ab[b1 + 0] - ab[b0 + 0]) * alpha;
                aBounds1 = ab[b0 + 1] + (ab[b1 + 1] - ab[b0 + 1]) * alpha;
                aBounds2 = ab[b0 + 2] + (ab[b1 + 2] - ab[b0 + 2]) * alpha;
                aBounds3 = ab[b0 + 3] + (ab[b1 + 3] - ab[b0 + 3]) * alpha;
                aBounds4 = ab[b0 + 4] + (ab[b1 + 4] - ab[b0 + 4]) * alpha;
                aBounds5 = ab[b0 + 5] + (ab[b1 + 5] - ab[b0 + 5]) * alpha;
            }

            float bxNear = nearX == 0 ? aBounds0 : aBounds3;
            float bxFar  = nearX == 0 ? aBounds3 : aBounds0;
            float byNear = nearY == 1 ? aBounds1 : aBounds4;
            float byFar  = nearY == 1 ? aBounds4 : aBounds1;
            float bzNear = nearZ == 2 ? aBounds2 : aBounds5;
            float bzFar  = nearZ == 2 ? aBounds5 : aBounds2;

            float tMin = Math.Max(0.0f, Math.Max((bxNear - ox) * invDx, Math.Max((byNear - oy) * invDy, (bzNear - oz) * invDz)));
            float tMax = Math.Min(bestDist, Math.Min((bxFar - ox) * invDx, Math.Min((byFar - oy) * invDy, (bzFar - oz) * invDz)));
            if (tMin > tMax) { continue; }

            float actorEntryDist = bestDist;
            int actorBestCap = -1;
            float actorBestMult = -1.0f;
            Vector3 actorBestPt = Vector3.Zero;
            Vector3 actorBestNrm = Vector3.Zero;

            int capCount = slot.CapsuleCount;
            float[] cw = slot.CapsuleWorld;
            HitboxCapsuleDef3D[] defs = slot.Rig.Defs;
            int cBase0 = idxOld * capCount * 7;

            if (alpha == 0.0f) {
                for (int c = 0; c < capCount; c = c + 1) {
                    int o0 = cBase0 + c * 7;
                    Vector3 ca = new Vector3(cw[o0 + 0], cw[o0 + 1], cw[o0 + 2]);
                    Vector3 cb = new Vector3(cw[o0 + 3], cw[o0 + 4], cw[o0 + 5]);
                    float cr = cw[o0 + 6];

                    float capT;
                    Vector3 capNrm;
                    if (LagCompensatedHitboxWorld3D.IntersectRayCapsule(origin, dir, bestDist, ca, cb, cr, out capT, out capNrm)) {
                        float mult = defs[c].DamageMultiplier;
                        if (actorBestCap < 0) {
                            actorEntryDist = capT;
                            actorBestCap = c;
                            actorBestMult = mult;
                            actorBestPt = new Vector3(ox + dx * capT, oy + dy * capT, oz + dz * capT);
                            actorBestNrm = capNrm;
                        } else if (capT < actorEntryDist) {
                            bool keepHigherBehind = (actorEntryDist - capT) <= prioDepth && actorBestMult > mult;
                            actorEntryDist = capT;
                            if (!keepHigherBehind) {
                                actorBestCap = c;
                                actorBestMult = mult;
                                actorBestPt = new Vector3(ox + dx * capT, oy + dy * capT, oz + dz * capT);
                                actorBestNrm = capNrm;
                            }
                        } else if ((capT - actorEntryDist) <= prioDepth && mult > actorBestMult) {
                            actorBestCap = c;
                            actorBestMult = mult;
                            actorBestPt = new Vector3(ox + dx * capT, oy + dy * capT, oz + dz * capT);
                            actorBestNrm = capNrm;
                        }
                    }
                }
            } else {
                int cBase1 = idxNew * capCount * 7;
                for (int c = 0; c < capCount; c = c + 1) {
                    int o0 = cBase0 + c * 7;
                    int o1 = cBase1 + c * 7;
                    Vector3 ca = new Vector3(
                        cw[o0 + 0] + (cw[o1 + 0] - cw[o0 + 0]) * alpha,
                        cw[o0 + 1] + (cw[o1 + 1] - cw[o0 + 1]) * alpha,
                        cw[o0 + 2] + (cw[o1 + 2] - cw[o0 + 2]) * alpha);
                    Vector3 cb = new Vector3(
                        cw[o0 + 3] + (cw[o1 + 3] - cw[o0 + 3]) * alpha,
                        cw[o0 + 4] + (cw[o1 + 4] - cw[o0 + 4]) * alpha,
                        cw[o0 + 5] + (cw[o1 + 5] - cw[o0 + 5]) * alpha);
                    float cr = cw[o0 + 6] + (cw[o1 + 6] - cw[o0 + 6]) * alpha;

                    float capT;
                    Vector3 capNrm;
                    if (LagCompensatedHitboxWorld3D.IntersectRayCapsule(origin, dir, bestDist, ca, cb, cr, out capT, out capNrm)) {
                        float mult = defs[c].DamageMultiplier;
                        if (actorBestCap < 0) {
                            actorEntryDist = capT;
                            actorBestCap = c;
                            actorBestMult = mult;
                            actorBestPt = new Vector3(ox + dx * capT, oy + dy * capT, oz + dz * capT);
                            actorBestNrm = capNrm;
                        } else if (capT < actorEntryDist) {
                            bool keepHigherBehind = (actorEntryDist - capT) <= prioDepth && actorBestMult > mult;
                            actorEntryDist = capT;
                            if (!keepHigherBehind) {
                                actorBestCap = c;
                                actorBestMult = mult;
                                actorBestPt = new Vector3(ox + dx * capT, oy + dy * capT, oz + dz * capT);
                                actorBestNrm = capNrm;
                            }
                        } else if ((capT - actorEntryDist) <= prioDepth && mult > actorBestMult) {
                            actorBestCap = c;
                            actorBestMult = mult;
                            actorBestPt = new Vector3(ox + dx * capT, oy + dy * capT, oz + dz * capT);
                            actorBestNrm = capNrm;
                        }
                    }
                }
            }

            if (actorBestCap >= 0 && actorEntryDist <= bestDist) {
                bestDist = actorEntryDist;
                HitboxCapsuleDef3D chosenDef = defs[actorBestCap];
                hit.Hit = true;
                hit.ActorId = slot.ActorId;
                hit.TeamId = slot.TeamId;
                hit.CapsuleIndex = actorBestCap;
                hit.BoneIndex = chosenDef.BoneIndex;
                hit.RegionId = chosenDef.RegionId;
                hit.DamageMultiplier = chosenDef.DamageMultiplier;
                hit.Distance = actorEntryDist;
                hit.Point = actorBestPt;
                hit.Normal = actorBestNrm;
                hit.RewoundTimestamp = actualSampleTime;
                foundAny = true;
            }
        }

        return foundAny;
    }

    // O(1) 步长预测环形缓冲帧定位（固定 Tickrate 下 0 次循环直达，抖动帧率下微调 1~2 步收敛）。
    private static void FindBracketingSnapshots(ActorHitboxHistorySlot slot, double targetTime,
                                                out int outOlder, out int outNewer, out float outAlpha,
                                                out double outSampleTime) {
        int cap = slot.HistoryCapacity;
        int mask = slot.CapacityMask;
        int count = slot.Count;
        double[] ts = slot.Timestamps;

        int newestIdx = (slot.Head - 1 + cap) & mask;
        double tNewest = ts[newestIdx];
        if (count == 1 || targetTime >= tNewest) {
            outOlder = newestIdx;
            outNewer = newestIdx;
            outAlpha = 0.0f;
            outSampleTime = tNewest;
            return;
        }

        int oldestIdx = (slot.Head - count + cap) & mask;
        double tOldest = ts[oldestIdx];
        if (targetTime <= tOldest) {
            outOlder = oldestIdx;
            outNewer = oldestIdx;
            outAlpha = 0.0f;
            outSampleTime = tOldest;
            return;
        }

        // 按首尾总跨度直接估算回退步数，瞬间落到包围区间附近
        double totalSpan = tNewest - tOldest;
        int estBack = 0;
        if (totalSpan > 1e-9 && count > 2) {
            estBack = (int)(((tNewest - targetTime) / totalSpan) * (double)(count - 1));
            if (estBack < 0) { estBack = 0; }
            if (estBack > count - 2) { estBack = count - 2; }
        }

        int curNew = (newestIdx - estBack + cap) & mask;
        for (int guard = 0; guard < count; guard = guard + 1) {
            int curOld = (curNew - 1 + cap) & mask;
            double t0 = ts[curOld];
            double t1 = ts[curNew];
            if (targetTime < t0) {
                if (curOld == oldestIdx) { break; }
                curNew = curOld;
            } else if (targetTime > t1) {
                if (curNew == newestIdx) { break; }
                curNew = (curNew + 1) & mask;
            } else {
                outOlder = curOld;
                outNewer = curNew;
                double span = t1 - t0;
                outAlpha = span > 1e-9 ? (float)((targetTime - t0) / span) : 0.0f;
                outSampleTime = targetTime;
                return;
            }
        }

        outOlder = oldestIdx;
        outNewer = oldestIdx;
        outAlpha = 0.0f;
        outSampleTime = tOldest;
    }

    private static bool IntersectRaySphere(Vector3 origin, Vector3 dir, Vector3 center, float radius,
                                           float maxDist, out float outT, out Vector3 outNormal) {
        outT = 0.0f;
        outNormal = Vector3.Zero;
        float ocx = origin.X - center.X;
        float ocy = origin.Y - center.Y;
        float ocz = origin.Z - center.Z;
        float ocLenSq = ocx * ocx + ocy * ocy + ocz * ocz;
        float c = ocLenSq - radius * radius;
        if (c <= 0.0f) {
            outT = 0.0f;
            float dLen = MathF.Sqrt(ocLenSq);
            outNormal = dLen > 1e-5f
                ? new Vector3(ocx / dLen, ocy / dLen, ocz / dLen)
                : Vector3.Negate(dir);
            return true;
        }
        float b = ocx * dir.X + ocy * dir.Y + ocz * dir.Z;
        if (b > 0.0f) { return false; }
        float disc = b * b - c;
        if (disc < 0.0f) { return false; }
        float t = -b - MathF.Sqrt(disc);
        if (t < 0.0f || t > maxDist) { return false; }
        outT = t;
        float invR = 1.0f / radius;
        outNormal = new Vector3(
            (ocx + dir.X * t) * invR,
            (ocy + dir.Y * t) * invR,
            (ocz + dir.Z * t) * invR);
        return true;
    }

    // 单分支解析式射线-有限胶囊体求交（Inigo Quilez 无限圆柱包络定理：未命中 0 次开方，柱面命中 1 次 MathF.Sqrt）。
    public static bool IntersectRayCapsule(Vector3 origin, Vector3 unitDir, float maxDist,
                                           Vector3 capA, Vector3 capB, float radius,
                                           out float outT, out Vector3 outNormal) {
        outT = maxDist;
        outNormal = Vector3.Zero;
        if (radius <= 0.0f || maxDist < 0.0f) { return false; }

        float bax = capB.X - capA.X;
        float bay = capB.Y - capA.Y;
        float baz = capB.Z - capA.Z;
        float baba = bax * bax + bay * bay + baz * baz;

        if (baba <= 1e-10f) {
            return LagCompensatedHitboxWorld3D.IntersectRaySphere(origin, unitDir, capA, radius, maxDist, out outT, out outNormal);
        }

        float oax = origin.X - capA.X;
        float oay = origin.Y - capA.Y;
        float oaz = origin.Z - capA.Z;
        float baoa = bax * oax + bay * oay + baz * oaz;
        float rSq = radius * radius;

        // 1. 起点已在有限胶囊体内部快速检测
        float projStart = Math.Clamp(baoa / baba, 0.0f, 1.0f);
        float dx0 = oax - bax * projStart;
        float dy0 = oay - bay * projStart;
        float dz0 = oaz - baz * projStart;
        float d0Sq = dx0 * dx0 + dy0 * dy0 + dz0 * dz0;
        if (d0Sq <= rSq) {
            outT = 0.0f;
            float d0 = MathF.Sqrt(d0Sq);
            outNormal = d0 > 1e-5f ? new Vector3(dx0 / d0, dy0 / d0, dz0 / d0) : Vector3.Negate(unitDir);
            return true;
        }

        // 2. 无限圆柱包络二次方程：胶囊体严格包含于无限圆柱，不交无限圆柱则绝不可能碰任何端球帽
        float bard = bax * unitDir.X + bay * unitDir.Y + baz * unitDir.Z;
        float rdoa = unitDir.X * oax + unitDir.Y * oay + unitDir.Z * oaz;
        float oaoa = oax * oax + oay * oay + oaz * oaz;

        float k2 = baba - bard * bard;
        float k1 = baba * rdoa - baoa * bard;
        float k0 = baba * (oaoa - rSq) - baoa * baoa;

        // 起点在无限圆柱外部且射线背离圆柱轴线：0 次开方直接淘汰
        if (k0 > 0.0f && k1 >= 0.0f) {
            return false;
        }

        if (k2 > 1e-9f) {
            float h = k1 * k1 - k2 * k0;
            if (h < 0.0f) {
                return false;
            }
            float tCyl = (-k1 - MathF.Sqrt(h)) / k2;
            if (tCyl > maxDist) {
                return false;
            }
            float y = baoa + tCyl * bard;
            if (y >= 0.0f && y <= baba) {
                if (tCyl < 0.0f) { return false; }
                outT = tCyl;
                float s = y / baba;
                float invR = 1.0f / radius;
                outNormal = new Vector3(
                    (oax + unitDir.X * tCyl - bax * s) * invR,
                    (oay + unitDir.Y * tCyl - bay * s) * invR,
                    (oaz + unitDir.Z * tCyl - baz * s) * invR);
                return true;
            }
            // 仅与射线迎向的那一端球帽求交（绝不重复测另一端）
            Vector3 capCenter = y < 0.0f ? capA : capB;
            return LagCompensatedHitboxWorld3D.IntersectRaySphere(origin, unitDir, capCenter, radius, maxDist, out outT, out outNormal);
        }

        // 射线严格平行于胶囊轴线奇异情形
        if (k0 > 0.0f) { return false; }
        Vector3 parallelCap = bard > 0.0f ? capA : capB;
        return LagCompensatedHitboxWorld3D.IntersectRaySphere(origin, unitDir, parallelCap, radius, maxDist, out outT, out outNormal);
    }
}
