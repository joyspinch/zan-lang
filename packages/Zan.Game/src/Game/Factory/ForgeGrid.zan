using System;
using System.Numerics;

namespace Game.Factory;

public class ForgeGrid {
    public static int TileSize() { return 32; }
    public static int Unit() { return 1000; }
    public static int Dx(int direction) { if (direction == 0) { return 1; } if (direction == 2) { return -1; } return 0; }
    public static int Dy(int direction) { if (direction == 1) { return 1; } if (direction == 3) { return -1; } return 0; }
    public static int WorldToCell(int world) { return world < 0 ? -1 : world / 1000; }
    public static int Center(int cell) { return cell * 1000 + 500; }
    public static int Max(int a, int b) { return a > b ? a : b; }
    public static int Min(int a, int b) { return a < b ? a : b; }
    public static int Abs(int v) { return v < 0 ? -v : v; }
    public static int DroneLimit() { return 24; }
}
