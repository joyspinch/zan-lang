using System;

namespace Game.Arcade2D;

/// <summary>
/// 帧表动画的单帧：帧表图集中的一个子矩形与持续时长。
/// 坐标单位为帧表图集上的像素。
/// </summary>
class AnimationFrame {
    int x;
    int y;
    int width;
    int height;
    int duration;

    /// 创建一帧：x/y/width/height 为帧表图集上的像素子矩形，
    /// duration 为展示毫秒数（小于 1 按 1 钳制）。
    AnimationFrame(int x, int y, int width, int height, int duration) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        this.duration = duration;
        if (this.duration <= 0) { this.duration = 1; }
    }

    /// 帧在帧表图集上的左上角 X（像素）。
    int X() { return this.x; }
    /// 帧在帧表图集上的左上角 Y（像素）。
    int Y() { return this.y; }
    /// 帧宽度（像素）。
    int Width() { return this.width; }
    /// 帧高度（像素）。
    int Height() { return this.height; }
    /// 该帧的展示时长（毫秒），构造时已保证至少为 1。
    int Duration() { return this.duration; }
}

/// <summary>
/// 有序动画帧序列，附带名称与是否循环标记。
/// 通过 Add 链式追加帧。
/// </summary>
class AnimationClip {
    string name;
    bool loop;
    List<AnimationFrame> frames;

    /// 创建空片段；name 仅为标识用途，loop 决定播放到末尾后是否回到第 0 帧。
    AnimationClip(string name, bool loop) {
        this.name = name;
        this.loop = loop;
        this.frames = new List<AnimationFrame>();
    }

    /// 追加一帧（参数同 AnimationFrame，duration 会被钳制为至少 1 毫秒）；
    /// 返回自身以便链式调用。
    AnimationClip Add(
        int x,
        int y,
        int width,
        int height,
        int duration
    ) {
        this.frames.Add(
            new AnimationFrame(x, y, width, height, duration));
        return this;
    }

    /// 片段名称（构造时传入的标识字符串）。
    string Name() { return this.name; }
    /// 是否循环播放。
    bool Loop() { return this.loop; }
    /// 已追加的帧数。
    int FrameCount() { return this.frames.Count; }
    /// 返回第 index 帧；index 越界时行为由底层 List 决定（抛错），调用方需保证 0 <= index < FrameCount()。
    AnimationFrame FrameAt(int index) { return this.frames[index]; }
}

/// <summary>
/// 单片段动画播放器：按 Update 累积的毫秒数推进帧。
/// 非循环片段播完后停在最后一帧并置 Finished；循环片段回到第 0 帧。
/// 需在每帧循环中手动调用 Update 传入流逝毫秒。
/// </summary>
class AnimationPlayer {
    AnimationClip clip;
    int frameIndex;
    int elapsed;
    bool playing;
    bool finished;

    /// 创建播放器并立即开始播放 clip（等价于 Play(clip)）。
    AnimationPlayer(AnimationClip clip) {
        this.Play(clip);
    }

    /// 从第 0 帧开始（或重新开始）播放 clip；
    /// clip 为 null 或无帧时进入非播放状态。
    void Play(AnimationClip clip) {
        this.clip = clip;
        this.frameIndex = 0;
        this.elapsed = 0;
        this.playing = clip != null && clip.FrameCount() > 0;
        this.finished = false;
    }

    /// 推进动画：deltaMilliseconds 为流逝毫秒（非正数时被忽略）。
    /// 单帧时长耗尽即切到下一帧，剩余毫秒结转；非循环播完置 Finished，
    /// 循环片段从第 0 帧继续。
    void Update(int deltaMilliseconds) {
        if (!this.playing || this.clip == null || deltaMilliseconds <= 0) {
            return;
        }
        this.elapsed = this.elapsed + deltaMilliseconds;
        AnimationFrame frame = this.Current();
        while (this.playing && frame != null
            && this.elapsed >= frame.Duration()) {
            this.elapsed = this.elapsed - frame.Duration();
            this.frameIndex = this.frameIndex + 1;
            if (this.frameIndex >= this.clip.FrameCount()) {
                if (this.clip.Loop()) {
                    this.frameIndex = 0;
                } else {
                    this.frameIndex = this.clip.FrameCount() - 1;
                    this.playing = false;
                    this.finished = true;
                }
            }
            frame = this.Current();
        }
    }

    /// 当前帧；片段为 null 或无帧时返回 null。
    AnimationFrame Current() {
        if (this.clip == null || this.clip.FrameCount() == 0) { return null; }
        return this.clip.FrameAt(this.frameIndex);
    }

    /// 当前帧索引（非循环播完后停留在最后一帧的索引）。
    int FrameIndex() { return this.frameIndex; }
    /// 是否正在播放（非循环播完后为 false）。
    bool Playing() { return this.playing; }
    /// 非循环片段是否已播放完毕；循环片段恒为 false。
    bool Finished() { return this.finished; }
}
