using System;

namespace Game.Arcade2D;

// 轴对齐矩形，(x, y) 为左上角，宽高向右/向下延伸。
// 坐标单位与 <see cref="Vector2"/> 一致（通常为像素）。
class Rect2 {
    double x;
    double y;
    double width;
    double height;

    // 创建左上角 (x, y)、尺寸 width x height 的矩形；不做合法性检查（负宽高原样保留）。
    Rect2(double x, double y, double width, double height) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
    }

    // 左上角 X。
    double X() { return this.x; }
    // 左上角 Y。
    double Y() { return this.y; }
    // 宽度。
    double Width() { return this.width; }
    // 高度。
    double Height() { return this.height; }
    // 右边界 X（= X + Width；负宽时小于 X）。
    double Right() { return this.x + this.width; }
    // 下边界 Y（= Y + Height；负高时小于 Y）。
    double Bottom() { return this.y + this.height; }

    // 点 (px, py) 是否位于矩形内（含边界，直接字段比较与 X 轴短路）。
    bool Contains(double px, double py) {
        if (px < this.x || px > this.x + this.width) { return false; }
        return py >= this.y && py <= this.y + this.height;
    }

    // 与另一个 AABB 矩形是否相交（直接字段访问与 X 轴短路）。
    bool Intersects(Rect2 other) {
        if (other == null) { return false; }
        double ar = this.x + this.width;
        double br = other.x + other.width;
        if (this.x >= br || ar <= other.x) { return false; }
        double ab = this.y + this.height;
        double bb = other.y + other.height;
        return this.y < bb && ab > other.y;
    }
}
