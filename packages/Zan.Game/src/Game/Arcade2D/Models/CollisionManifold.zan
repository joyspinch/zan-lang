using System;

namespace Game.Arcade2D;

// 2D 碰撞接触流形（Collision Manifold）。
// 包含两物体相交时的法线方向与重叠穿透深度，供物理位移分离（Depenetration）使用。
class CollisionManifold {
    bool collided;
    double normalX;
    double normalY;
    double depth;

    CollisionManifold(bool collided, double nx, double ny, double depth) {
        this.collided = collided;
        this.normalX = nx;
        this.normalY = ny;
        this.depth = depth;
    }

    // 创建未碰撞流形
    static CollisionManifold None() {
        return new CollisionManifold(false, 0.0, 0.0, 0.0);
    }

    // 是否发生碰撞接触
    bool Collided() { return this.collided; }
    // 物体 A 推开物体 B 的分离法线 X（从 A 指向 B）
    double NormalX() { return this.normalX; }
    // 物体 A 推开物体 B 的分离法线 Y（从 A 指向 B）
    double NormalY() { return this.normalY; }
    // 沿法线方向的重叠穿透深度
    double Depth() { return this.depth; }
}
