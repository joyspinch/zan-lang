using System;

namespace Game.Arcade2D;

// 帧表动画的单帧：帧表图集中的一个子矩形与持续时长。
// 坐标单位为帧表图集上的像素。
class AnimationFrame {
    int x;
    int y;
    int width;
    int height;
    int duration;

    // 创建一帧：x/y/width/height 为帧表图集上的像素子矩形，
    // duration 为展示毫秒数（小于 1 按 1 钳制）。
    AnimationFrame(int x, int y, int width, int height, int duration) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        this.duration = duration;
        if (this.duration <= 0) { this.duration = 1; }
    }

    // 帧在帧表图集上的左上角 X（像素）。
    int X() { return this.x; }
    // 帧在帧表图集上的左上角 Y（像素）。
    int Y() { return this.y; }
    // 帧宽度（像素）。
    int Width() { return this.width; }
    // 帧高度（像素）。
    int Height() { return this.height; }
    // 该帧的展示时长（毫秒），构造时已保证至少为 1。
    int Duration() { return this.duration; }
}
