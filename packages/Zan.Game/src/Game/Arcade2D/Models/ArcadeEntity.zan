using System;

namespace Game.Arcade2D;

// 街机世界中的单个实体（敌人/子弹/粒子等）：极简物理（速度按
// 秒积分）、碰撞体、生命与冷却等通用槽位。实体不自我构造，
// 由 ArcadeWorld.Spawn 分配并复用失活槽位。
public class ArcadeEntity {
    public int id;
    public int kind;
    public int team;
    public bool active;
    public double x;
    public double y;
    public double previousX;
    public double previousY;
    public double velocityX;
    public double velocityY;
    public double width;
    public double height;
    public double radius;
    public int hp;
    public int maxHp;
    public int targetId;
    public int cooldown;
    public int lifetime;
    public int pathIndex;
    public int data;

    // （重）初始化实体：写入 id/kind/team/位置与碰撞矩形，清零
    // 速度与各槽位，激活实体；碰撞半径重置为 (宽+高)/4，生命
    // 重置为 1，寿命重置为无限（-1）。由 Spawn 调用。
    public void Reset(
        int id,
        int kind,
        int team,
        double x,
        double y,
        double width,
        double height
    ) {
        this.id = id;
        this.kind = kind;
        this.team = team;
        this.active = true;
        this.x = x;
        this.y = y;
        this.previousX = x;
        this.previousY = y;
        this.velocityX = 0.0;
        this.velocityY = 0.0;
        this.width = width;
        this.height = height;
        this.radius = (width + height) * 0.25;
        this.hp = 1;
        this.maxHp = 1;
        this.targetId = 0;
        this.cooldown = 0;
        this.lifetime = -1;
        this.pathIndex = 0;
        this.data = 0;
    }

    // 推进一帧：记录上一帧位置后按速度积分位移（速度单位为
    // 单位/秒），冷却毫秒递减到 0，寿命毫秒递减、减到 0 即失活。
    // 失活实体或 deltaMilliseconds ≤ 0 时无操作。
    public void Step(int deltaMilliseconds) {
        if (!this.active || deltaMilliseconds <= 0) { return; }
        this.previousX = this.x;
        this.previousY = this.y;
        double seconds = (double)deltaMilliseconds * 0.001;
        this.x = this.x + this.velocityX * seconds;
        this.y = this.y + this.velocityY * seconds;
        if (this.cooldown > 0) {
            this.cooldown = this.cooldown - deltaMilliseconds;
            if (this.cooldown < 0) { this.cooldown = 0; }
        }
        if (this.lifetime >= 0) {
            this.lifetime = this.lifetime - deltaMilliseconds;
            if (this.lifetime <= 0) { this.active = false; }
        }
    }

    // 把速度设为指向 (targetX, targetY) 的 speed（单位/秒）。已到
    // 达目标（距离平方 ≤ 0.0001）或 speed ≤ 0 时清零速度。
    // 只改速度不移动，位移在 Step 中积分。
    public void MoveTowards(double targetX, double targetY, double speed) {
        double dx = targetX - this.x;
        double dy = targetY - this.y;
        double lengthSquared = dx * dx + dy * dy;
        if (lengthSquared <= 0.0001 || speed <= 0.0) {
            this.velocityX = 0.0;
            this.velocityY = 0.0;
            return;
        }
        double invLength = 1.0 / Math.Sqrt(lengthSquared);
        double s = speed * invLength;
        this.velocityX = dx * s;
        this.velocityY = dy * s;
    }

    // 结算一次伤害：失活或 amount ≤ 0 时返回 0 无副作用；实际
    // 生效量按剩余生命钳制，生命减到 0 即失活。返回实际扣除的
    // 生命值。
    public int Damage(int amount) {
        if (!this.active || amount <= 0) { return 0; }
        int applied = amount;
        if (applied > this.hp) { applied = this.hp; }
        this.hp = this.hp - applied;
        if (this.hp <= 0) {
            this.hp = 0;
            this.active = false;
        }
        return applied;
    }

    // 以中心点为准的碰撞矩形（宽高为 Width × Height）。
    public Rect2 Bounds() {
        return new Rect2(
            this.x - this.width / 2.0,
            this.y - this.height / 2.0,
            this.width,
            this.height);
    }

    // 直接判断与另一实体的轴对齐包围盒是否相交（1D 分离轴短路，零临时 Rect2 堆分配）。
    public bool IntersectsBounds(ArcadeEntity other) {
        if (other == null || !other.active || !this.active) { return false; }
        double hwSum = (this.width + other.width) * 0.5;
        double dx = this.x - other.x;
        if (dx < 0.0) { dx = -dx; }
        if (dx > hwSum) { return false; }

        double hhSum = (this.height + other.height) * 0.5;
        double dy = this.y - other.y;
        if (dy < 0.0) { dy = -dy; }
        return dy <= hhSum;
    }

    // 以中心为圆心的碰撞圆（半径可被 SetRadius 覆盖）。
    public Circle2 Circle() { return new Circle2(this.x, this.y, this.radius); }

    // 直接判断与另一实体的碰撞圆是否相交（分离轴盒预判 + 距离平方，零临时 Circle2 堆分配）。
    public bool IntersectsCircle(ArcadeEntity other) {
        if (other == null || !other.active || !this.active) { return false; }
        double rSum = this.radius + other.radius;
        double dx = this.x - other.x;
        if (dx > rSum || dx < -rSum) { return false; }
        double dy = this.y - other.y;
        if (dy > rSum || dy < -rSum) { return false; }
        return (dx * dx + dy * dy) <= (rSum * rSum);
    }

    // 实例唯一 ID（由 World.Spawn 分配，递增且不复用）。
    public int Id() { return this.id; }
    // 类型标签（调用方自定义的枚举值）。
    public int Kind() { return this.kind; }
    // 阵营标签（同队互为目标查找排除）。
    public int Team() { return this.team; }
    // 是否活跃（失活槽位会被 Spawn 回收复用）。
    public bool Active() { return this.active; }
    // 当前世界坐标 X（单位由调用方约定，通常像素）。
    public double X() { return this.x; }
    // 当前世界坐标 Y。
    public double Y() { return this.y; }
    // 上一帧的 X（Step 前的位置）。
    public double PreviousX() { return this.previousX; }
    // 上一帧的 Y。
    public double PreviousY() { return this.previousY; }
    // X 方向速度（单位/秒）。
    public double VelocityX() { return this.velocityX; }
    // Y 方向速度（单位/秒）。
    public double VelocityY() { return this.velocityY; }
    // 宽度（碰撞矩形尺寸）。
    public double Width() { return this.width; }
    // 高度（碰撞矩形尺寸）。
    public double Height() { return this.height; }
    // 碰撞半径（默认 (宽+高)/4）。
    public double Radius() { return this.radius; }
    // 当前生命值（0 表示已死亡/失活）。
    public int Hp() { return this.hp; }
    // 生命上限（SetHealth 设置的值）。
    public int MaxHp() { return this.maxHp; }
    // 目标实体 ID（0 表示未设置；由调用方维护语义）。
    public int TargetId() { return this.targetId; }
    // 剩余冷却毫秒（Step 中递减到 0）。
    public int Cooldown() { return this.cooldown; }
    // 剩余寿命毫秒；-1 表示无限。
    public int Lifetime() { return this.lifetime; }
    // 当前路径点索引（ArcadePath.Follow 使用）。
    public int PathIndex() { return this.pathIndex; }
    // 调用方自定义整数槽位（如伤害值、掉落类型）。
    public int Value() { return this.data; }

    // 设置活跃状态；设为 false 后 Step/Damage 均无操作。
    public void SetActive(bool active) { this.active = active; }
    // 直接设置世界坐标（不影响上一帧位置的记录时序）。
    public void SetPosition(double x, double y) { this.x = x; this.y = y; }
    // 设置速度分量（单位/秒）。
    public void SetVelocity(double x, double y) {
        this.velocityX = x;
        this.velocityY = y;
    }
    // 覆盖碰撞半径（默认 (宽+高)/4，Reset 时重置）。
    public void SetRadius(double radius) { this.radius = radius; }
    // 设置生命值并回满：小于 1 时钳制为 1，maxHp 与 hp 同时置为该值。
    public void SetHealth(int hp) {
        if (hp < 1) { hp = 1; }
        this.maxHp = hp;
        this.hp = hp;
    }
    // 设置目标实体 ID（语义由调用方维护，0 表示未设置）。
    public void SetTargetId(int targetId) { this.targetId = targetId; }
    // 设置冷却毫秒数，负值钳制为 0；Step 中递减。
    public void SetCooldown(int cooldown) {
        this.cooldown = cooldown;
        if (this.cooldown < 0) { this.cooldown = 0; }
    }
    // 设置剩余寿命（毫秒）；负值表示无限（Step 不再递减失活）。
    public void SetLifetime(int lifetime) { this.lifetime = lifetime; }
    // 设置当前路径点索引（配合 ArcadePath.Follow 使用）。
    public void SetPathIndex(int pathIndex) { this.pathIndex = pathIndex; }
    // 写入调用方自定义整数槽位。
    public void SetValue(int data) { this.data = data; }
}
