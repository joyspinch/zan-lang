using System;

namespace Game.Arcade2D;

// 有序动画帧序列，附带名称与是否循环标记。
// 通过 Add 链式追加帧。
class AnimationClip {
    string name;
    bool loop;
    List<AnimationFrame> frames;

    // 创建空片段；name 仅为标识用途，loop 决定播放到末尾后是否回到第 0 帧。
    AnimationClip(string name, bool loop) {
        this.name = name;
        this.loop = loop;
        this.frames = new List<AnimationFrame>();
    }

    // 追加一帧（参数同 AnimationFrame，duration 会被钳制为至少 1 毫秒）；
    // 返回自身以便链式调用。
    AnimationClip Add(
        int x,
        int y,
        int width,
        int height,
        int duration
    ) {
        this.frames.Add(
            new AnimationFrame(x, y, width, height, duration));
        return this;
    }

    // 片段名称（构造时传入的标识字符串）。
    string Name() { return this.name; }
    // 是否循环播放。
    bool Loop() { return this.loop; }
    // 已追加的帧数。
    int FrameCount() { return this.frames.Count; }
    // 返回第 index 帧；index 越界时行为由底层 List 决定（抛错），调用方需保证 0 <= index < FrameCount()。
    AnimationFrame FrameAt(int index) { return this.frames[index]; }
}
