using System;

namespace Game.Arcade2D;

// 二维碰撞判定工具集；任一形状参数为 null 时判定为不相交。
class Collision2D {
    // 点 (x, y) 是否位于矩形内（含边界，委托 Rect2.Contains 快速直接字段判定与 X 轴短路）。
    static bool PointInRect(double x, double y, Rect2 rect) {
        if (rect == null) { return false; }
        return rect.Contains(x, y);
    }

    // 两轴对齐矩形是否相交（委托 Rect2.Intersects 快速直接字段判定与 X 轴短路）。
    static bool Rects(Rect2 a, Rect2 b) {
        if (a == null || b == null) { return false; }
        return a.Intersects(b);
    }

    // 两圆是否相交（委托 Circle2.Intersects 快速直接字段判定与 1D 分离轴短路）。
    static bool Circles(Circle2 a, Circle2 b) {
        if (a == null || b == null) { return false; }
        return a.Intersects(b);
    }

    // 两点间距离的平方（避免开方）；比较距离时用它配对同侧平方阈值。
    static double DistanceSquared(
        double ax,
        double ay,
        double bx,
        double by
    ) {
        double dx = ax - bx;
        double dy = ay - by;
        return dx * dx + dy * dy;
    }
}
