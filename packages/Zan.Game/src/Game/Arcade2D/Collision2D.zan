using System;

namespace Game.Arcade2D;

// 二维碰撞判定工具集；任一形状参数为 null 时判定为不相交。
class Collision2D {
    // 点 (x, y) 是否位于矩形内（含边界，X 轴短路优化）。
    static bool PointInRect(double x, double y, Rect2 rect) {
        if (rect == null) { return false; }
        if (x < rect.X() || x > rect.Right()) { return false; }
        return y >= rect.Y() && y <= rect.Bottom();
    }

    // 两轴对齐矩形是否相交（仅边缘相触不算，X 轴短路与边界缓存优化）。
    static bool Rects(Rect2 a, Rect2 b) {
        if (a == null || b == null) { return false; }
        double ax = a.X();
        double ar = a.Right();
        double bx = b.X();
        double br = b.Right();
        if (ax >= br || ar <= bx) { return false; }
        double ay = a.Y();
        double ab = a.Bottom();
        double by = b.Y();
        double bb = b.Bottom();
        return ay < bb && ab > by;
    }

    // 两圆是否相交（圆心距 ≤ 半径之和，含恰好相切，1D 分离轴短路优化）。
    static bool Circles(Circle2 a, Circle2 b) {
        if (a == null || b == null) { return false; }
        double radius = a.Radius() + b.Radius();
        double rSq = radius * radius;
        double dx = a.X() - b.X();
        double dx2 = dx * dx;
        if (dx2 > rSq) { return false; }
        double dy = a.Y() - b.Y();
        return dx2 + dy * dy <= rSq;
    }

    // 两点间距离的平方（避免开方）；比较距离时用它配对同侧平方阈值。
    static double DistanceSquared(
        double ax,
        double ay,
        double bx,
        double by
    ) {
        double dx = ax - bx;
        double dy = ay - by;
        return dx * dx + dy * dy;
    }
}
