using System;

namespace Game.Arcade2D;

// 二维碰撞判定工具集；任一形状参数为 null 时判定为不相交。
class Collision2D {
    // 点 (x, y) 是否位于矩形内（含边界）。
    static bool PointInRect(double x, double y, Rect2 rect) {
        return rect != null
            && x >= rect.X()
            && y >= rect.Y()
            && x <= rect.Right()
            && y <= rect.Bottom();
    }

    // 两轴对齐矩形是否相交（仅边缘相触不算）。
    static bool Rects(Rect2 a, Rect2 b) {
        if (a == null || b == null) { return false; }
        return a.X() < b.Right()
            && a.Right() > b.X()
            && a.Y() < b.Bottom()
            && a.Bottom() > b.Y();
    }

    // 两圆是否相交（圆心距 ≤ 半径之和，含恰好相切）。
    static bool Circles(Circle2 a, Circle2 b) {
        if (a == null || b == null) { return false; }
        double dx = a.X() - b.X();
        double dy = a.Y() - b.Y();
        double radius = a.Radius() + b.Radius();
        return dx * dx + dy * dy <= radius * radius;
    }

    // 两点间距离的平方（避免开方）；比较距离时用它配对同侧平方阈值。
    static double DistanceSquared(
        double ax,
        double ay,
        double bx,
        double by
    ) {
        double dx = ax - bx;
        double dy = ay - by;
        return dx * dx + dy * dy;
    }
}
