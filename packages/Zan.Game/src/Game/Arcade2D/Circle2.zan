using System;

namespace Game.Arcade2D;

// 以圆心 (x, y) 与半径 radius 定义的圆形碰撞体。
public class Circle2 {
    public double x;
    public double y;
    public double radius;

    public Circle2(double x, double y, double radius) {
        this.x = x;
        this.y = y;
        this.radius = radius;
    }

    // 圆心 X。
    public double X() { return this.x; }
    // 圆心 Y。
    public double Y() { return this.y; }
    // 半径（不校验非负）。
    public double Radius() { return this.radius; }

    // 点 (px, py) 是否位于圆内（1D 分离轴短路与避免开方）。
    public bool Contains(double px, double py) {
        double rSq = this.radius * this.radius;
        double dx = px - this.x;
        double dx2 = dx * dx;
        if (dx2 > rSq) { return false; }
        double dy = py - this.y;
        return dx2 + dy * dy <= rSq;
    }

    // 与另一个圆是否相交（直接字段访问与 1D 分离轴短路）。
    public bool Intersects(Circle2 other) {
        if (other == null) { return false; }
        double r = this.radius + other.radius;
        double rSq = r * r;
        double dx = this.x - other.x;
        double dx2 = dx * dx;
        if (dx2 > rSq) { return false; }
        double dy = this.y - other.y;
        return dx2 + dy * dy <= rSq;
    }
}
