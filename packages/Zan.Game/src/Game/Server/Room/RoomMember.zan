using System;

namespace Game.Server.Room;

// 房间内成员状态信息。
public class RoomMember {
    public long playerId;
    public int teamId;
    public bool isReady;
    public bool isOnline;
    public int lastInputSeq;
    public long joinTime;

    public RoomMember(long playerId, int teamId, long joinTime) {
        this.playerId = playerId;
        this.teamId = teamId;
        this.isReady = false;
        this.isOnline = true;
        this.lastInputSeq = 0;
        this.joinTime = joinTime;
    }

    public RoomMember(long playerId) : this(playerId, 0, 0L) {
    }
}
