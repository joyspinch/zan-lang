using System;

namespace Game.Server.Aoi;

// AOI 场景实体坐标与网格索引记录。
public class AoiEntity {
    public long id;
    public float x;
    public float y;
    public int cellX;
    public int cellY;

    public AoiEntity(long id, float x, float y, int cellX, int cellY) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.cellX = cellX;
        this.cellY = cellY;
    }
}

// 移动引起的视野差集计算结果。
public class AoiDiff {
    public long[] enters;
    public int entersCount;
    public long[] leaves;
    public int leavesCount;

    public AoiDiff(int cap) {
        int c = cap > 8 ? cap : 32;
        this.enters = new long[c];
        this.entersCount = 0;
        this.leaves = new long[c];
        this.leavesCount = 0;
    }

    public void AddEnter(long entityId) {
        if (this.entersCount >= this.enters.Length) {
            long[] n = new long[this.enters.Length * 2];
            for (int i = 0; i < this.entersCount; i = i + 1) {
                n[i] = this.enters[i];
            }
            this.enters = n;
        }
        this.enters[this.entersCount] = entityId;
        this.entersCount = this.entersCount + 1;
    }

    public void AddLeave(long entityId) {
        if (this.leavesCount >= this.leaves.Length) {
            long[] n = new long[this.leaves.Length * 2];
            for (int i = 0; i < this.leavesCount; i = i + 1) {
                n[i] = this.leaves[i];
            }
            this.leaves = n;
        }
        this.leaves[this.leavesCount] = entityId;
        this.leavesCount = this.leavesCount + 1;
    }
}
