using System;

namespace Game.Server.Storage;

// 待落盘的脏数据记录条目。
public class WriteBackItem {
    public long entityId;
    public int dirtyMask;
    public byte[] payload;
    public int payloadLength;
    public long firstDirtyTime;
    public long lastUpdateTime;

    public WriteBackItem(long entityId, int dirtyMask, byte[] payload, int length, long nowMs) {
        this.entityId = entityId;
        this.dirtyMask = dirtyMask;
        this.payload = payload;
        this.payloadLength = length;
        this.firstDirtyTime = nowMs;
        this.lastUpdateTime = nowMs;
    }

    public void Update(int newMask, byte[] newPayload, int newLength, long nowMs) {
        this.dirtyMask = this.dirtyMask | newMask;
        this.payload = newPayload;
        this.payloadLength = newLength;
        this.lastUpdateTime = nowMs;
    }
}
