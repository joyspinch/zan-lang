using System;

namespace Game.Server.Core;

// Actor 间通信消息体。
public class ActorMessage {
    public int msgType;
    public long senderId;
    public long targetId;
    public int seq;
    public byte[] data;
    public int dataLength;

    public ActorMessage() {
        this.msgType = 0;
        this.senderId = 0L;
        this.targetId = 0L;
        this.seq = 0;
        this.data = null;
        this.dataLength = 0;
    }

    public ActorMessage(int msgType, long senderId, long targetId, int seq, byte[] data, int length) {
        this.msgType = msgType;
        this.senderId = senderId;
        this.targetId = targetId;
        this.seq = seq;
        this.data = data;
        this.dataLength = length;
    }

    public static ActorMessage Create(int msgType, long senderId, long targetId, byte[] data) {
        int len = data != null ? data.Length : 0;
        return new ActorMessage(msgType, senderId, targetId, 0, data, len);
    }

    public static ActorMessage CreateRpc(int msgType, long senderId, long targetId, int seq, byte[] data) {
        int len = data != null ? data.Length : 0;
        return new ActorMessage(msgType, senderId, targetId, seq, data, len);
    }
}
