using System;

namespace Game.Server.Core;

// Actor 私有信箱（环形无锁/受保缓冲队列）。
public class Mailbox {
    private ActorMessage[] items;
    private int head;
    private int tail;
    private int count;
    private int capacity;

    public Mailbox(int initialCapacity) {
        int cap = initialCapacity > 8 ? initialCapacity : 32;
        this.capacity = cap;
        this.items = new ActorMessage[cap];
        this.head = 0;
        this.tail = 0;
        this.count = 0;
    }

    public Mailbox() : this(64) {
    }

    public int Count() {
        return this.count;
    }

    public bool IsEmpty() {
        return this.count == 0;
    }

    public bool Enqueue(ActorMessage msg) {
        if (msg == null) { return false; }
        if (this.count >= this.capacity) {
            this.Grow();
        }
        this.items[this.tail] = msg;
        this.tail = (this.tail + 1) % this.capacity;
        this.count = this.count + 1;
        return true;
    }

    public ActorMessage Dequeue() {
        if (this.count == 0) {
            return null;
        }
        ActorMessage msg = this.items[this.head];
        this.items[this.head] = null;
        this.head = (this.head + 1) % this.capacity;
        this.count = this.count - 1;
        return msg;
    }

    public void Clear() {
        for (int i = 0; i < this.capacity; i = i + 1) {
            this.items[i] = null;
        }
        this.head = 0;
        this.tail = 0;
        this.count = 0;
    }

    private void Grow() {
        int newCap = this.capacity * 2;
        ActorMessage[] newItems = new ActorMessage[newCap];
        for (int i = 0; i < this.count; i = i + 1) {
            newItems[i] = this.items[(this.head + i) % this.capacity];
        }
        this.items = newItems;
        this.head = 0;
        this.tail = this.count;
        this.capacity = newCap;
    }
}
