using System;
using System.Collections.Generic;

namespace Game.Foundation;

// 标准缓动方程求值器。将 [0, 1] 的线性归一化进度映射为指定曲线的插值因子。
class Easing {
    const double PI = 3.14159265358979323846;
    const double HALF_PI = 1.57079632679489661923;

    // 对指定缓动类型计算归一化时间 t 在 [0, 1] 上的插值因子。
    // 若 t &lt;= 0 返回 0；t &gt;= 1 返回 1（弹性/回弹曲线中间允许超出边界）。
    static double Evaluate(int easeType, double t) {
        if (t <= 0.0) { return 0.0; }
        if (t >= 1.0) { return 1.0; }

        if (easeType == EaseType.Linear) {
            return t;
        }

        // Quad
        if (easeType == EaseType.QuadIn) {
            return t * t;
        }
        if (easeType == EaseType.QuadOut) {
            return t * (2.0 - t);
        }
        if (easeType == EaseType.QuadInOut) {
            if (t < 0.5) { return 2.0 * t * t; }
            return -1.0 + (4.0 - 2.0 * t) * t;
        }

        // Cubic
        if (easeType == EaseType.CubicIn) {
            return t * t * t;
        }
        if (easeType == EaseType.CubicOut) {
            double f = t - 1.0;
            return f * f * f + 1.0;
        }
        if (easeType == EaseType.CubicInOut) {
            if (t < 0.5) { return 4.0 * t * t * t; }
            double f = 2.0 * t - 2.0;
            return 0.5 * f * f * f + 1.0;
        }

        // Quart
        if (easeType == EaseType.QuartIn) {
            return t * t * t * t;
        }
        if (easeType == EaseType.QuartOut) {
            double f = t - 1.0;
            return 1.0 - f * f * f * f;
        }
        if (easeType == EaseType.QuartInOut) {
            if (t < 0.5) { return 8.0 * t * t * t * t; }
            double f = t - 1.0;
            return 1.0 - 8.0 * f * f * f * f;
        }

        // Quint
        if (easeType == EaseType.QuintIn) {
            return t * t * t * t * t;
        }
        if (easeType == EaseType.QuintOut) {
            double f = t - 1.0;
            return f * f * f * f * f + 1.0;
        }
        if (easeType == EaseType.QuintInOut) {
            if (t < 0.5) { return 16.0 * t * t * t * t * t; }
            double f = 2.0 * t - 2.0;
            return 0.5 * f * f * f * f * f + 1.0;
        }

        // Sine
        if (easeType == EaseType.SineIn) {
            return 1.0 - Math.Cos(t * HALF_PI);
        }
        if (easeType == EaseType.SineOut) {
            return Math.Sin(t * HALF_PI);
        }
        if (easeType == EaseType.SineInOut) {
            return 0.5 * (1.0 - Math.Cos(PI * t));
        }

        // Expo
        if (easeType == EaseType.ExpoIn) {
            return Math.Pow(2.0, 10.0 * (t - 1.0));
        }
        if (easeType == EaseType.ExpoOut) {
            return 1.0 - Math.Pow(2.0, -10.0 * t);
        }
        if (easeType == EaseType.ExpoInOut) {
            if (t < 0.5) {
                return 0.5 * Math.Pow(2.0, 10.0 * (2.0 * t - 1.0));
            }
            return 0.5 * (2.0 - Math.Pow(2.0, -10.0 * (2.0 * t - 1.0)));
        }

        // Circ
        if (easeType == EaseType.CircIn) {
            return 1.0 - Math.Sqrt(1.0 - t * t);
        }
        if (easeType == EaseType.CircOut) {
            return Math.Sqrt(1.0 - (t - 1.0) * (t - 1.0));
        }
        if (easeType == EaseType.CircInOut) {
            if (t < 0.5) {
                return 0.5 * (1.0 - Math.Sqrt(1.0 - 4.0 * t * t));
            }
            double f = 2.0 * t - 2.0;
            return 0.5 * (Math.Sqrt(1.0 - f * f) + 1.0);
        }

        // Back
        double s = 1.70158;
        if (easeType == EaseType.BackIn) {
            return t * t * ((s + 1.0) * t - s);
        }
        if (easeType == EaseType.BackOut) {
            double f = t - 1.0;
            return f * f * ((s + 1.0) * f + s) + 1.0;
        }
        if (easeType == EaseType.BackInOut) {
            double s2 = s * 1.525;
            double t2 = t * 2.0;
            if (t2 < 1.0) {
                return 0.5 * (t2 * t2 * ((s2 + 1.0) * t2 - s2));
            }
            double f = t2 - 2.0;
            return 0.5 * (f * f * ((s2 + 1.0) * f + s2) + 2.0);
        }

        // Bounce
        if (easeType == EaseType.BounceOut) {
            return Easing.BounceOutCore(t);
        }
        if (easeType == EaseType.BounceIn) {
            return 1.0 - Easing.BounceOutCore(1.0 - t);
        }
        if (easeType == EaseType.BounceInOut) {
            if (t < 0.5) {
                return 0.5 * (1.0 - Easing.BounceOutCore(1.0 - 2.0 * t));
            }
            return 0.5 * Easing.BounceOutCore(2.0 * t - 1.0) + 0.5;
        }

        // Elastic
        if (easeType == EaseType.ElasticIn) {
            double f = t - 1.0;
            return -Math.Pow(2.0, 10.0 * f) * Math.Sin((f - 0.075) * 20.943951023931955);
        }
        if (easeType == EaseType.ElasticOut) {
            return Math.Pow(2.0, -10.0 * t) * Math.Sin((t - 0.075) * 20.943951023931955) + 1.0;
        }
        if (easeType == EaseType.ElasticInOut) {
            double f = 2.0 * t - 1.0;
            if (f < 0.0) {
                return -0.5 * Math.Pow(2.0, 10.0 * f) * Math.Sin((f - 0.1125) * 13.962634015954637);
            }
            return 0.5 * Math.Pow(2.0, -10.0 * f) * Math.Sin((f - 0.1125) * 13.962634015954637) + 1.0;
        }

        return t;
    }

    const double BOUNCE_B1 = 0.36363636363636365;  // 1.0 / 2.75
    const double BOUNCE_B2 = 0.7272727272727273;   // 2.0 / 2.75
    const double BOUNCE_B3 = 0.9090909090909091;   // 2.5 / 2.75
    const double BOUNCE_F1 = 0.5454545454545454;   // 1.5 / 2.75
    const double BOUNCE_F2 = 0.8181818181818182;   // 2.25 / 2.75
    const double BOUNCE_F3 = 0.9545454545454546;   // 2.625 / 2.75

    static double BounceOutCore(double t) {
        if (t < BOUNCE_B1) {
            return 7.5625 * t * t;
        }
        if (t < BOUNCE_B2) {
            double f = t - BOUNCE_F1;
            return 7.5625 * f * f + 0.75;
        }
        if (t < BOUNCE_B3) {
            double f = t - BOUNCE_F2;
            return 7.5625 * f * f + 0.9375;
        }
        double f2 = t - BOUNCE_F3;
        return 7.5625 * f2 * f2 + 0.984375;
    }
}
