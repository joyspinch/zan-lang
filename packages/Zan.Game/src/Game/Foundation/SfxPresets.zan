using System;
using Game.Audio;

namespace Game.Foundation;

// 街机/休闲游戏的通用程序化音效配方。
//
// 判据（换个游戏还成立吗）：点按、拾取、命中、爆炸、升级、失败……几乎
// 每个游戏都要这一组"事件音"。模板不带音频素材也能有完整的声音反馈：
// 启动时用 Game.Audio.Synth 合成进 SfxBank（`bank.AddSynth(名字, 配方)`），
// 发布包零音频文件；项目想换成录制素材时，同名 WAV 用 LoadAll 覆盖即可。
//
// 每个配方都是一个新的 SynthOptions（可继续链式微调音高/时长再交给
// AddSynth）。参数刻意保持短促（≤0.5s）、峰值 ≤0.4，多个同时响也不爆音。
public class SfxPresets {
    // 名字 → 配方；不认识的名字返回 null。
    public static SynthOptions ByName(string name) {
        if (name == "click") { return SfxPresets.Click(); }
        if (name == "select") { return SfxPresets.Select(); }
        if (name == "coin") { return SfxPresets.Coin(); }
        if (name == "hit") { return SfxPresets.Hit(); }
        if (name == "explode") { return SfxPresets.Explode(); }
        if (name == "launch") { return SfxPresets.Launch(); }
        if (name == "powerup") { return SfxPresets.PowerUp(); }
        if (name == "success") { return SfxPresets.Success(); }
        if (name == "fail") { return SfxPresets.Fail(); }
        if (name == "error") { return SfxPresets.Error(); }
        return null;
    }

    // 全部内置配方名（AddSynthAll 用）。
    public static string[] Names() {
        return new string[] { "click", "select", "coin", "hit", "explode",
            "launch", "powerup", "success", "fail", "error" };
    }

    // UI 点按：极短方波脉冲。
    public static SynthOptions Click() {
        return new SynthOptions().WithWaveform(Waveform.Square).WithFrequency(880.0)
            .WithDuration(0.012).WithEnvelope(0.001, 0.010, 0.0, 0.015).WithGain(0.18);
    }

    // 选中/放置：三角波小上扬。
    public static SynthOptions Select() {
        return new SynthOptions().WithWaveform(Waveform.Triangle).WithSweep(620.0, 920.0)
            .WithDuration(0.045).WithEnvelope(0.002, 0.030, 0.3, 0.030).WithGain(0.30);
    }

    // 拾取/得分：明亮的上扫。
    public static SynthOptions Coin() {
        return new SynthOptions().WithWaveform(Waveform.Square).WithSweep(990.0, 1760.0)
            .WithDuration(0.070).WithEnvelope(0.001, 0.050, 0.35, 0.060).WithGain(0.16);
    }

    // 命中：短促噪声冲击。
    public static SynthOptions Hit() {
        SynthOptions o = new SynthOptions().WithWaveform(Waveform.Noise)
            .WithDuration(0.035).WithEnvelope(0.001, 0.030, 0.0, 0.040).WithGain(0.30);
        o.filter = new BiquadFilter(FilterKind.LowPass, 2600.0, 0.8, 44100, 1);
        return o;
    }

    // 爆炸/大消除：长衰减的低通噪声。
    public static SynthOptions Explode() {
        SynthOptions o = new SynthOptions().WithWaveform(Waveform.Noise)
            .WithDuration(0.12).WithEnvelope(0.002, 0.120, 0.25, 0.260).WithGain(0.40);
        o.filter = new BiquadFilter(FilterKind.LowPass, 900.0, 0.7, 44100, 1);
        return o;
    }

    // 发射/冲刺：锯齿上扫。
    public static SynthOptions Launch() {
        SynthOptions o = new SynthOptions().WithWaveform(Waveform.Saw).WithSweep(240.0, 760.0)
            .WithDuration(0.090).WithEnvelope(0.004, 0.060, 0.4, 0.060).WithGain(0.16);
        o.filter = new BiquadFilter(FilterKind.LowPass, 3200.0, 0.7, 44100, 1);
        return o;
    }

    // 升级/连击：长一点的上扬方波。
    public static SynthOptions PowerUp() {
        return new SynthOptions().WithWaveform(Waveform.Square).WithSweep(440.0, 1320.0)
            .WithDuration(0.26).WithEnvelope(0.004, 0.080, 0.55, 0.120).WithGain(0.14);
    }

    // 过关/胜利：三角波八度上滑。
    public static SynthOptions Success() {
        return new SynthOptions().WithWaveform(Waveform.Triangle).WithSweep(523.0, 1046.0)
            .WithDuration(0.32).WithEnvelope(0.006, 0.100, 0.65, 0.220).WithGain(0.32);
    }

    // 失败/死亡：低通锯齿下滑。
    public static SynthOptions Fail() {
        SynthOptions o = new SynthOptions().WithWaveform(Waveform.Saw).WithSweep(330.0, 92.0)
            .WithDuration(0.42).WithEnvelope(0.004, 0.150, 0.55, 0.200).WithGain(0.22);
        o.filter = new BiquadFilter(FilterKind.LowPass, 1400.0, 0.7, 44100, 1);
        return o;
    }

    // 非法操作：低沉蜂鸣。
    public static SynthOptions Error() {
        return new SynthOptions().WithWaveform(Waveform.Square).WithFrequency(150.0)
            .WithDuration(0.090).WithEnvelope(0.002, 0.040, 0.6, 0.050).WithGain(0.14);
    }
}
