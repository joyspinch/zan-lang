using Gui;
using System.Collections.Generic;

namespace Game.Foundation.Gui;

// 输入聚合与绘制共用原控件几何，不收养或重新绘制任何内容节点。
class HudInputRoot : InputRootAdapter {
    weak HudLayer hud;

    public HudInputRoot(HudLayer hud) : base("game_hud_input") { this.hud = hud; }

    public override Control HitTest(int x, int y, int pointerType) {
        Control hit = this.hud != null ? this.hud.HitTest(x, y, pointerType) : null;
        if (hit != null) { return hit; }
        return this.content != null ? this.content.HitTest(x, y, pointerType) : null;
    }

    public override bool ContainsHostedControl(Control control) {
        if (control == null) { return false; }
        if (base.ContainsHostedControl(control)) { return true; }
        if (hud != null) {
            for (int i = 0; i < hud.controls.Count; i = i + 1) {
                Control root = hud.controls[i];
                if (root != null && root.ContainsHostedControl(control)) { return true; }
            }
        }
        return false;
    }

    public override bool ContainsInputControl(Control control) {
        if (control == this) { return true; }
        if (this.hud != null && this.hud.IsVisible() && this.hud.ContainsControl(control)) { return true; }
        return this.content != null && this.content.ContainsInputControl(control);
    }

    public override void CollectInputFocus(App app, List<Control> controls) {
        if (hud != null && hud.IsVisible()) {
            for (int i = 0; i < hud.controls.Count; i = i + 1) {
                Control control = hud.controls[i];
                if (control != null) { control.CollectInputFocus(app, controls); }
            }
        }
        base.CollectInputFocus(app, controls);
    }

    public override Control FindInputFocus(App app) {
        Control focused = this.hud != null ? this.hud.FindInputFocus(app) : null;
        if (focused != null) { return focused; }
        return this.content != null ? this.content.FindInputFocus(app) : null;
    }

    void ReleaseInput(Control control) {
        if (this.inputApp == null || control == null) { return; }
        this.inputApp.ReleaseInputSubtree(control);
    }

    protected override void OnReleaseInput(App app) {
        if (this.hud != null) { this.hud.ReleaseInput(app); }
    }

    public override void Bind(App app) {
        base.Bind(app);
        if (app == null) { return; }
        this.bx = 0;
        this.by = 0;
        this.bw = app.ClientWidth();
        this.bh = app.ClientHeight();
    }
}
