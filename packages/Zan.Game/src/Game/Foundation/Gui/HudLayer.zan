using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Game.Foundation.Gui;

// 声明式游戏 HUD 挂载层。
// 允许在游戏世界画布之上挂载标准的 Zan GUI 控件（按钮、背包面板、血条、设置对话框等）。
// 既享受游戏循环的高帧率与低延迟，又拥有标准 GUI 组件的精美排版与事件响应。
public class HudLayer {
    public List<Control> controls;
    public bool visible;
    HudInputRoot inputRoot;
    HudInputPreparation preparation;
    weak App inputApp;
    bool useDefaultBounds;
    int boundsX;
    int boundsY;
    int boundsWidth;
    int boundsHeight;
    int bindingGeneration;

    public HudLayer() {
        this.controls = new List<Control>();
        this.visible = true;
        this.useDefaultBounds = true;
    }

    // 输入顺序与合成一致：HUD 后加者在上，其下才是宿主原来的内容树。
    // 只查询现有树，不收养/重排内容节点，也不让透明 HUD 空区吞掉世界输入。
    Control HitTest(int x, int y, int pointerType, List<Control> excludedSubtrees) {
        if (this.visible && this.controls != null) {
            for (int i = this.controls.Count - 1; i >= 0; i--) {
                Control control = this.controls[i];
                if (control != null && control.visible) {
                    Control hit = control.HitTest(x, y, pointerType, excludedSubtrees);
                    if (hit != null) { return hit; }
                }
            }
        }
        return null;
    }

    public void Bind(App app) {
        if (app == null || !app.isRunning) { return; }
        bindingGeneration = bindingGeneration + 1;
        int generation = bindingGeneration;
        if (this.inputApp != app) {
            if (this.preparation != null) { this.preparation.RetireViews(); }
            if (this.inputRoot != null) { this.inputRoot.Detach(); }
            if (generation != bindingGeneration) { return; }
            this.inputApp = app;
        }
        if (!this.visible) { return; }
        if (this.inputRoot == null) { this.inputRoot = new HudInputRoot(this); }
        this.inputRoot.Bind(app);
        if (generation != bindingGeneration || this.inputApp != app || !this.visible
        || !this.inputRoot.IsBoundTo(app)) { return; }
        if (this.preparation == null) { this.preparation = new HudInputPreparation(this); }
        this.preparation.Bind(app);
        this.preparation.LayoutNow(app);
    }

    // Update fallback without displacing already-bound HUD or Layer adapters.
    public bool SetContentRoot(App app, Control root) {
        if (app == null || root is InputRootAdapter) { return false; }
        this.Bind(app);
        if (!this.visible) { app.SetRootControl(root); return app.rootControl == root; }
        return this.inputRoot != null && this.inputRoot.IsBoundTo(app) && this.inputRoot.SetContentRoot(root);
    }

    public int BoundsX(App app) { return useDefaultBounds ? 0 : boundsX; }
    public int BoundsY(App app) { return useDefaultBounds ? app.ContentTop() : boundsY; }
    public int BoundsWidth(App app) { return useDefaultBounds ? app.ClientWidth() : boundsWidth; }
    public int BoundsHeight(App app) {
        return useDefaultBounds ? app.ClientHeight() - app.ContentTop() : boundsHeight;
    }

    // HUD 是否可见。
    public bool IsVisible() {
        return this.visible;
    }

    // 设置 HUD 显示/隐藏。
    public void SetVisible(bool v) {
        if (this.visible == v) { return; }
        this.visible = v;
        bindingGeneration = bindingGeneration + 1;
        if (!v) {
            if (this.preparation != null) { this.preparation.RetireViews(); }
            if (this.inputRoot != null) { this.inputRoot.Detach(); }
        } else if (this.inputApp != null) { this.Bind(this.inputApp); }
    }

    public bool ContainsControl(Control control) {
        if (control == null) { return false; }
        for (int i = 0; i < this.controls.Count; i = i + 1) {
            if (this.controls[i].ContainsInputControl(control)) { return true; }
        }
        return false;
    }

    Control FindInputFocus(App app) {
        if (!this.visible) { return null; }
        for (int i = this.controls.Count - 1; i >= 0; i = i - 1) {
            Control focused = this.controls[i].FindInputFocus(app);
            if (focused != null) { return focused; }
        }
        return null;
    }

    void ReleaseInput(App app) {
        int generation = bindingGeneration;
        List<Control> snapshot = new List<Control>();
        for (int i = 0; i < this.controls.Count; i = i + 1) { snapshot.Add(this.controls[i]); }
        for (int i = 0; i < snapshot.Count; i = i + 1) {
            if (generation != bindingGeneration || this.inputApp != app) { return; }
            app.ReleaseInputSubtree(snapshot[i]);
        }
    }

    // App-space region, consumed by the existing view scopes before input and paint.
    public void SetBounds(int x, int y, int width, int height) {
        this.useDefaultBounds = false;
        this.boundsX = x;
        this.boundsY = y;
        this.boundsWidth = width > 0 ? width : 0;
        this.boundsHeight = height > 0 ? height : 0;
    }

    public void UseDefaultBounds() {
        this.useDefaultBounds = true;
    }

    // 挂载一个 GUI 控件至 HUD 层。
    public void Add(Control control) {
        if (control != null) {
            this.controls.Add(control);
            if (this.preparation != null && this.inputApp != null) {
                // A newly registered scope has no proof in the already-prepared frame.
                this.inputApp.InvalidatePreparation();
                this.preparation.Bind(this.inputApp);
            }
        }
    }

    // 从 HUD 层移除控件。
    public bool Remove(Control control) {
        if (control == null) { return false; }
        int idx = this.controls.IndexOf(control);
        if (idx >= 0) {
            // Commit membership before focus/cancel callbacks can re-enter Add/Remove/Clear.
            this.controls.RemoveAt(idx);
            if (this.preparation != null) { this.preparation.Remove(control); }
            if (this.inputRoot != null) { this.inputRoot.ReleaseInput(control); }
            return true;
        }
        return false;
    }

    // 清空所有 HUD 控件。
    public void Clear() {
        List<Control> previous = this.controls;
        this.controls = new List<Control>();
        if (this.preparation != null) { this.preparation.RetireViews(); }
        App app = this.inputApp;
        int generation = bindingGeneration;
        if (app == null) { return; }
        for (int i = 0; i < previous.Count; i = i + 1) {
            if (generation != bindingGeneration || this.inputApp != app) { return; }
            Control root = previous[i];
            if (this.controls.IndexOf(root) < 0) { app.ReleaseInputSubtree(root); }
        }
    }

    // 当前挂载的控件数量。
    public int Count() {
        return this.controls.Count;
    }

    // Bind and configure bounds before the shared App preparation. Painting only
    // consumes that borrowed tree; it never reinstalls a hidden or detached adapter.
    public void Paint(App app) {
        if (!this.PaintCurrent(app)) { return; }
        int generation = bindingGeneration;
        List<Control> prepared = this.controls;
        for (int i = 0; i < prepared.Count; i = i + 1) {
            Control c = prepared[i];
            if (c != null && c.visible) { c.RenderTree(app); }
            if (generation != bindingGeneration || prepared != this.controls || !this.PaintCurrent(app)) { return; }
        }
    }

    bool PaintCurrent(App app) {
        if (app == null || !this.visible || this.inputApp != app || this.inputRoot == null
        || !this.inputRoot.IsBoundTo(app) || !app.ContinuePreparedFrame()) { return false; }
        InputRootAdapter root = app.rootControl is InputRootAdapter ? (InputRootAdapter)app.rootControl : null;
        return root != null && root.ContainsAdapter(this.inputRoot);
    }
}
