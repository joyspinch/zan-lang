using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Game.Foundation.Gui;

// 声明式游戏 HUD 挂载层。
// 允许在游戏世界画布之上挂载标准的 Zan GUI 控件（按钮、背包面板、血条、设置对话框等）。
// 既享受游戏循环的高帧率与低延迟，又拥有标准 GUI 组件的精美排版与事件响应。
public class HudLayer {
    public List<Control> controls;
    public bool visible;

    public HudLayer() {
        this.controls = new List<Control>();
        this.visible = true;
    }

    // HUD 是否可见。
    public bool IsVisible() {
        return this.visible;
    }

    // 设置 HUD 显示/隐藏。
    public void SetVisible(bool v) {
        this.visible = v;
    }

    // 挂载一个 GUI 控件至 HUD 层。
    public void Add(Control control) {
        if (control != null) {
            this.controls.Add(control);
        }
    }

    // 从 HUD 层移除控件。
    public bool Remove(Control control) {
        if (control == null) { return false; }
        int idx = this.controls.IndexOf(control);
        if (idx >= 0) {
            this.controls.RemoveAt(idx);
            return true;
        }
        return false;
    }

    // 清空所有 HUD 控件。
    public void Clear() {
        this.controls.Clear();
    }

    // 当前挂载的控件数量。
    public int Count() {
        return this.controls.Count;
    }

    // 在游戏画面渲染完成后调用，将 HUD 控件分层叠画至画布上。
    // 支持自动根据视口大小（vw x vh）执行弹性盒/浮动锚点布局后绘制。
    //
    // 布局在这一层做（Measure + Arrange）而不是交给项目：控件没排过版
    // 就 RenderTree，等于画一棵没有尺寸的树——设置浮层这类"根填满窗口
    // + 内部居中"的结构整层是空的，**Esc 打开等于没打开**。项目侧
    // 再排一次是重复劳动，且十个游戏各写一遍还会各写各的。
    public void Render(App app, Canvas canvas) {
        if (!this.visible || this.controls.Count == 0) {
            return;
        }

        int vw = app.ClientWidth();
        int vh = app.ClientHeight();
        int count = this.controls.Count;
        for (int i = 0; i < count; i = i + 1) {
            Control c = this.controls[i];
            if (c != null && c.visible) {
                c.MeasureTree(app);
                c.Arrange(0, 0, vw, vh);
                c.RenderTree(app);
            }
        }
    }

    // 视口尺寸感知渲染：自动针对指定尺寸视口（如 1920x1080）执行 Arrange 与绘制。
    public void RenderViewport(App app, Canvas canvas, int vw, int vh) {
        if (!this.visible || this.controls.Count == 0) {
            return;
        }

        int count = this.controls.Count;
        for (int i = 0; i < count; i = i + 1) {
            Control c = this.controls[i];
            if (c != null && c.visible) {
                c.MeasureTree(app);
                c.Arrange(0, 0, vw, vh);
                c.RenderTree(app);
            }
        }
    }
}
