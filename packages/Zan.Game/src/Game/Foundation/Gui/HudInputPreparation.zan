using System.Collections.Generic;
using Gui;

namespace Game.Foundation.Gui;

// Each borrowed HUD root gets a view scope so App prepares its geometry before input.
class HudInputPreparation : UiViewOwner {
    private weak HudLayer hud;
    private weak App app;
    private List<UiViewScope> views;

    public HudInputPreparation(HudLayer hud) {
        this.hud = hud;
        this.views = new List<UiViewScope>();
    }

    public void Bind(App app) {
        if (app == null) { return; }
        if (this.app != app) { this.RetireViews(); this.app = app; }
        HudLayer layer = hud;
        if (layer == null || !layer.IsVisible()) { return; }
        for (int i = views.Count - 1; i >= 0; i = i - 1) {
            UiViewScope view = views[i];
            if (!view.IsActive() || layer.controls.IndexOf(view.Root()) < 0) {
                views.RemoveAt(i);
                view.Retire();
            }
        }
        for (int i = 0; i < layer.controls.Count; i = i + 1) {
            Control root = layer.controls[i];
            if (root != null && this.FindView(root) == null) {
                views.Add(new UiViewScope(app, this, root));
            }
        }
    }

    UiViewScope FindView(Control root) {
        for (int i = 0; i < views.Count; i = i + 1) {
            UiViewScope view = views[i];
            if (view != null && view.IsActive() && view.Root() == root) { return view; }
        }
        return null;
    }

    public void PrepareView(UiViewScope view, App app) {
        HudLayer layer = hud;
        if (layer == null || !layer.IsVisible() || app != this.app || layer.inputApp != app
        || view == null || !view.IsActive()) { return; }
        Control root = view.Root();
        if (root == null || !root.visible || layer.controls.IndexOf(root) < 0) { return; }
        int x = layer.BoundsX(app);
        int y = layer.BoundsY(app);
        int width = layer.BoundsWidth(app);
        int height = layer.BoundsHeight(app);
        view.Layout(x, y, width, height);
    }

    public void LayoutNow(App app) {
        if (app == null || app != this.app) { return; }
        this.Bind(app);
        List<UiViewScope> snapshot = new List<UiViewScope>();
        for (int i = 0; i < views.Count; i = i + 1) { snapshot.Add(views[i]); }
        for (int i = 0; i < snapshot.Count; i = i + 1) {
            HudLayer layer = hud;
            if (this.app != app || layer == null || !layer.IsVisible() || layer.inputApp != app) { return; }
            UiViewScope view = snapshot[i];
            if (view != null) { this.PrepareView(view, app); }
        }
    }

    public void Remove(Control root) {
        if (root == null) { return; }
        for (int i = views.Count - 1; i >= 0; i = i - 1) {
            UiViewScope view = views[i];
            if (view != null && view.Root() == root) {
                views.RemoveAt(i);
                view.Retire();
            }
        }
    }

    public void RetireViews() {
        List<UiViewScope> previous = views;
        views = new List<UiViewScope>();
        for (int i = 0; i < previous.Count; i = i + 1) {
            UiViewScope view = previous[i];
            if (view != null) { view.Retire(); }
        }
    }

    public void ViewAction(string name, Control sender) { }
    public void ViewPointer(Control sender, RoutedEventArgs args) { }
}
