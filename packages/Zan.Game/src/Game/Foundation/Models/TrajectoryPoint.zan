using System;
using System.Collections.Generic;

namespace Game.Foundation;

// 轨迹采样点。
class TrajectoryPoint {
    double time;
    double x;
    double y;
    double vx;
    double vy;

    TrajectoryPoint(double time, double x, double y, double vx, double vy) {
        this.time = time;
        this.x = x;
        this.y = y;
        this.vx = vx;
        this.vy = vy;
    }

    double GetTime() { return this.time; }
    double GetX() { return this.x; }
    double GetY() { return this.y; }
    double GetVx() { return this.vx; }
    double GetVy() { return this.vy; }
}
