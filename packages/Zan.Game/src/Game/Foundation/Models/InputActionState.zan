using System;

namespace Game.Foundation;

// 单个语义动作的运行时状态。pressed/released 是边沿标志：
// Set 只在按下的转换沿置位，之后保持锁存，直到 BeginFrame 清除，
// 因此每帧开头必须调用一次 BeginFrame 才能读到正确的边沿。
class InputActionState {
    string name;
    bool down;
    bool pressed;
    bool released;
    double amount;

    InputActionState(string name) {
        this.name = name;
        this.down = false;
        this.pressed = false;
        this.released = false;
        this.amount = 0.0;
    }

    // 动作名，即创建时的标识符。
    string Name() { return this.name; }

    // 当前是否处于按住状态（持续为 true，非边沿）。
    bool Down() { return this.down; }

    // 本帧内是否发生了按下动作；锁存直到 BeginFrame。
    bool Pressed() { return this.pressed; }

    // 本帧内是否发生了抬起动作；锁存直到 BeginFrame。
    bool Released() { return this.released; }

    // 模拟量强度（键盘按下为 1.0，抬起时清零）。
    double Value() { return this.amount; }

    // 清除 pressed/released 边沿标志；每帧开头调用一次。
    void BeginFrame() {
        this.pressed = false;
        this.released = false;
    }

    // 更新状态并做边沿检测：down 从 false 变 true 置 pressed，
    // 从 true 变 false 置 released 并将强度清零。
    void Set(bool down, double amount) {
        if (down && !this.down) { this.pressed = true; }
        if (!down && this.down) { this.released = true; }
        this.down = down;
        this.amount = amount;
        if (!down) { this.amount = 0.0; }
    }
}
