using System;

namespace Game.Foundation;

// 一个"动作-按键"绑定项；用静态 Key 工厂创建。
public class InputBinding {
    public string action;
    public int key;
    public bool down;

    // 创建绑定：动作名 + 后端按键码。
    public static InputBinding Key(string action, int key) {
        InputBinding binding = new InputBinding();
        binding.action = action;
        binding.key = key;
        binding.down = false;
        return binding;
    }

    // 绑定的动作名。
    public string Action() { return this.action; }

    // 绑定的后端按键码。
    public int KeyCode() { return this.key; }

    // 该按键当前是否按住。
    public bool Down() { return this.down; }

    // 由 InputMap 内部更新；一般不必直接调用。
    public void SetDown(bool down) { this.down = down; }
}
