using System;

namespace Game.Foundation;

// 逐字段累加的状态校验和（FNV-1a，与 Game.Netcode.Checksum 同一算法）：
// 仿真的 StateChecksum() 把决定局面的字段依次喂进来，不必先编码成字节数组。
// 顺序即语义——同样的字段换个顺序是另一个值；集合按下标顺序喂，不要遍历哈希表。
//
//   StateHasher h = new StateHasher();
//   h.Int(cat); h.Int(moves); for (...) { h.Bool(blocked[i]); }
//   return h.Value();
public class StateHasher {
    long h;

    public StateHasher() { this.h = 2166136261L; }

    void Byte(long b) {
        this.h = (this.h ^ (b & 255L)) & 4294967295L;
        this.h = (this.h * 16777619L) & 4294967295L;
    }

    public StateHasher Int(int v) {
        long x = (long)v;
        this.Byte(x); this.Byte(x >> 8); this.Byte(x >> 16); this.Byte(x >> 24);
        return this;
    }

    public StateHasher Long(long v) {
        this.Int((int)(v & 4294967295L));
        this.Int((int)((v >> 32) & 4294967295L));
        return this;
    }

    public StateHasher Bool(bool v) {
        this.Byte(v ? 1L : 0L);
        return this;
    }

    // 浮点按定点（1e-4）折算后喂入：同一二进制逐帧一致即可，避免把最低位噪声
    // 当成分叉；需要逐位比对时自行 Long(BitConverter…)。
    public StateHasher Real(double v) {
        return this.Long((long)(v * 10000.0));
    }

    public StateHasher Text(string s) {
        if (s == null) { return this.Int(-1); }
        this.Int(s.Length);
        for (int i = 0; i < s.Length; i = i + 1) { this.Int((int)s[i]); }
        return this;
    }

    // 0..2^31-1 的非负值（与 Checksum.Of 同口径，便于打印与比较）
    public int Value() { return (int)(this.h & 2147483647L); }
}
