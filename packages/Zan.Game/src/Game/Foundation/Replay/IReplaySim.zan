using System;

namespace Game.Foundation;

// S26（docs/ZAN_STANDARD.md §6）：可回放的仿真。
//
// 游戏把"逻辑"收成一个只认种子与逐帧输入的对象：同一种子 + 同一输入流，
// 任何一次运行逐帧得到同一状态。表现层（窗口、绘制、音效）不进来——
// 回放与回归在无头进程里跑，不开窗口。
//
//   Reset(seed)           回到开局，随机源只从 seed 派生（DeterministicRandom）
//   Step(frame, input)    推进一帧；input 是本帧玩家输入编码成的 int
//                         （按键位掩码、格子下标……由游戏自定，0 = 无输入）
//   StateChecksum()       当前状态的校验和（Checksum / StateHasher），两次运行
//                         逐帧比对，不一致即分叉
public interface IReplaySim {
    void Reset(long seed);
    void Step(int frame, int input);
    int StateChecksum();
}
