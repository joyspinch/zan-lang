using System;
using System.Collections.Generic;

namespace Game.Foundation;

// S27（docs/ZAN_STANDARD.md §6）：规则即不变量。
//
// 仿真类上标 [Invariant] 的无参 bool 方法就是一条游戏规则，回放校验与机器人
// 模糊测试每帧都查一遍；返回 false 即违反：
//
//   [Invariant] public bool GoldConserved() { return gold == initialGold + minted - spent; }
//   [Invariant] public bool HpValid() { return hp >= 0 && hp <= maxHp; }
//
// 方法须是 public（反射按名调用）。返回第一条不成立的规则名，全部成立返回 ""。
public class Invariants {
    // 按类型缓存规则名：反射扫一遍方法表只做一次
    static Dictionary<string, List<string>> cache;

    public static List<string> Of(object sim) {
        if (Invariants.cache == null) { Invariants.cache = new Dictionary<string, List<string>>(); }
        TypeInfo t = sim.GetType();
        string key = t.FullName;
        if (Invariants.cache.ContainsKey(key)) { return Invariants.cache[key]; }
        List<string> names = new List<string>();
        for (int i = 0; i < t.MethodCount; i = i + 1) {
            string attrs = t.GetMethodCustomAttributes(i);
            if (attrs != null && (attrs.StartsWith("Invariant=") || attrs.Contains(";Invariant="))
                && t.GetMethodParamCount(i) == 0 && !t.IsMethodStatic(i)) {
                string n = t.GetMethodName(i);
                if (!names.Contains(n)) { names.Add(n); }
            }
        }
        Invariants.cache[key] = names;
        return names;
    }

    public static string Check(object sim) {
        List<string> names = Invariants.Of(sim);
        for (int i = 0; i < names.Count; i = i + 1) {
            if (sim.InvokeInt(names[i]) == 0) { return names[i]; }
        }
        return "";
    }
}
