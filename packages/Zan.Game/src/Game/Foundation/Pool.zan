using System;
using System.Collections.Generic;

namespace Game.Foundation;

// 高性能通用对象池，供高频分配与丢弃的对象（粒子、弹幕、飘字文本、音效请求等）复用。
// 避免反复 new / ARC 回收带来的缓存未命中与内存抖动。
class ObjectPool<T> {
    List<T> items;
    int maxCapacity;

    ObjectPool(int maxCapacity) {
        this.items = new List<T>();
        this.maxCapacity = maxCapacity > 0 ? maxCapacity : 1024;
    }

    ObjectPool() {
        this.items = new List<T>();
        this.maxCapacity = 1024;
    }

    // 当前池内空闲可用对象数。
    int Count() {
        return this.items.Count;
    }

    // 从池中借出一个对象；若池为空返回 null，由调用方负责构造新实例。
    T Rent() {
        if (this.items.Count > 0) {
            int lastIndex = this.items.Count - 1;
            T item = this.items[lastIndex];
            this.items.RemoveAt(lastIndex);
            return item;
        }
        return null;
    }

    // 将使用完毕的对象归还池中；若池已达上限则直接丢弃交由垃圾回收。
    bool Return(T item) {
        if (item == null) { return false; }
        if (this.items.Count >= this.maxCapacity) {
            return false;
        }
        this.items.Add(item);
        return true;
    }

    // 清空池内所有缓存对象。
    void Clear() {
        this.items.Clear();
    }
}
