using System;
using System.Collections.Generic;

namespace Game.Foundation;

// 缓动类型枚举常数。
// 涵盖主流曲线族：线性、二次、三次、四次、五次、正弦、指数、圆弧、回弹、弹跳与弹性。
class EaseType {
    const int Linear = 0;
    const int QuadIn = 1;
    const int QuadOut = 2;
    const int QuadInOut = 3;
    const int CubicIn = 4;
    const int CubicOut = 5;
    const int CubicInOut = 6;
    const int QuartIn = 7;
    const int QuartOut = 8;
    const int QuartInOut = 9;
    const int QuintIn = 10;
    const int QuintOut = 11;
    const int QuintInOut = 12;
    const int SineIn = 13;
    const int SineOut = 14;
    const int SineInOut = 15;
    const int ExpoIn = 16;
    const int ExpoOut = 17;
    const int ExpoInOut = 18;
    const int CircIn = 19;
    const int CircOut = 20;
    const int CircInOut = 21;
    const int BackIn = 22;
    const int BackOut = 23;
    const int BackInOut = 24;
    const int BounceIn = 25;
    const int BounceOut = 26;
    const int BounceInOut = 27;
    const int ElasticIn = 28;
    const int ElasticOut = 29;
    const int ElasticInOut = 30;
}

// 缓动循环模式。
class TweenLoop {
    const int Once = 0;
    const int Loop = 1;
    const int Yoyo = 2;
}

// 标准缓动方程求值器。将 [0, 1] 的线性归一化进度映射为指定曲线的插值因子。
class Easing {
    const double PI = 3.14159265358979323846;
    const double HALF_PI = 1.57079632679489661923;

    // 对指定缓动类型计算归一化时间 t 在 [0, 1] 上的插值因子。
    // 若 t &lt;= 0 返回 0；t &gt;= 1 返回 1（弹性/回弹曲线中间允许超出边界）。
    static double Evaluate(int easeType, double t) {
        if (t <= 0.0) { return 0.0; }
        if (t >= 1.0) { return 1.0; }

        if (easeType == EaseType.Linear) {
            return t;
        }

        // Quad
        if (easeType == EaseType.QuadIn) {
            return t * t;
        }
        if (easeType == EaseType.QuadOut) {
            return t * (2.0 - t);
        }
        if (easeType == EaseType.QuadInOut) {
            if (t < 0.5) { return 2.0 * t * t; }
            return -1.0 + (4.0 - 2.0 * t) * t;
        }

        // Cubic
        if (easeType == EaseType.CubicIn) {
            return t * t * t;
        }
        if (easeType == EaseType.CubicOut) {
            double f = t - 1.0;
            return f * f * f + 1.0;
        }
        if (easeType == EaseType.CubicInOut) {
            if (t < 0.5) { return 4.0 * t * t * t; }
            double f = 2.0 * t - 2.0;
            return 0.5 * f * f * f + 1.0;
        }

        // Quart
        if (easeType == EaseType.QuartIn) {
            return t * t * t * t;
        }
        if (easeType == EaseType.QuartOut) {
            double f = t - 1.0;
            return 1.0 - f * f * f * f;
        }
        if (easeType == EaseType.QuartInOut) {
            if (t < 0.5) { return 8.0 * t * t * t * t; }
            double f = t - 1.0;
            return 1.0 - 8.0 * f * f * f * f;
        }

        // Quint
        if (easeType == EaseType.QuintIn) {
            return t * t * t * t * t;
        }
        if (easeType == EaseType.QuintOut) {
            double f = t - 1.0;
            return f * f * f * f * f + 1.0;
        }
        if (easeType == EaseType.QuintInOut) {
            if (t < 0.5) { return 16.0 * t * t * t * t * t; }
            double f = 2.0 * t - 2.0;
            return 0.5 * f * f * f * f * f + 1.0;
        }

        // Sine
        if (easeType == EaseType.SineIn) {
            return 1.0 - Math.Cos(t * HALF_PI);
        }
        if (easeType == EaseType.SineOut) {
            return Math.Sin(t * HALF_PI);
        }
        if (easeType == EaseType.SineInOut) {
            return 0.5 * (1.0 - Math.Cos(PI * t));
        }

        // Expo
        if (easeType == EaseType.ExpoIn) {
            return Math.Pow(2.0, 10.0 * (t - 1.0));
        }
        if (easeType == EaseType.ExpoOut) {
            return 1.0 - Math.Pow(2.0, -10.0 * t);
        }
        if (easeType == EaseType.ExpoInOut) {
            if (t < 0.5) {
                return 0.5 * Math.Pow(2.0, 10.0 * (2.0 * t - 1.0));
            }
            return 0.5 * (2.0 - Math.Pow(2.0, -10.0 * (2.0 * t - 1.0)));
        }

        // Circ
        if (easeType == EaseType.CircIn) {
            return 1.0 - Math.Sqrt(1.0 - t * t);
        }
        if (easeType == EaseType.CircOut) {
            return Math.Sqrt(1.0 - (t - 1.0) * (t - 1.0));
        }
        if (easeType == EaseType.CircInOut) {
            if (t < 0.5) {
                return 0.5 * (1.0 - Math.Sqrt(1.0 - 4.0 * t * t));
            }
            double f = 2.0 * t - 2.0;
            return 0.5 * (Math.Sqrt(1.0 - f * f) + 1.0);
        }

        // Back
        double s = 1.70158;
        if (easeType == EaseType.BackIn) {
            return t * t * ((s + 1.0) * t - s);
        }
        if (easeType == EaseType.BackOut) {
            double f = t - 1.0;
            return f * f * ((s + 1.0) * f + s) + 1.0;
        }
        if (easeType == EaseType.BackInOut) {
            double s2 = s * 1.525;
            double t2 = t * 2.0;
            if (t2 < 1.0) {
                return 0.5 * (t2 * t2 * ((s2 + 1.0) * t2 - s2));
            }
            double f = t2 - 2.0;
            return 0.5 * (f * f * ((s2 + 1.0) * f + s2) + 2.0);
        }

        // Bounce
        if (easeType == EaseType.BounceOut) {
            return Easing.BounceOutCore(t);
        }
        if (easeType == EaseType.BounceIn) {
            return 1.0 - Easing.BounceOutCore(1.0 - t);
        }
        if (easeType == EaseType.BounceInOut) {
            if (t < 0.5) {
                return 0.5 * (1.0 - Easing.BounceOutCore(1.0 - 2.0 * t));
            }
            return 0.5 * Easing.BounceOutCore(2.0 * t - 1.0) + 0.5;
        }

        // Elastic
        if (easeType == EaseType.ElasticIn) {
            double p = 0.3;
            double f = t - 1.0;
            return -Math.Pow(2.0, 10.0 * f) * Math.Sin((f - p / 4.0) * (2.0 * PI) / p);
        }
        if (easeType == EaseType.ElasticOut) {
            double p = 0.3;
            return Math.Pow(2.0, -10.0 * t) * Math.Sin((t - p / 4.0) * (2.0 * PI) / p) + 1.0;
        }
        if (easeType == EaseType.ElasticInOut) {
            double p = 0.45;
            double f = 2.0 * t - 1.0;
            if (f < 0.0) {
                return -0.5 * Math.Pow(2.0, 10.0 * f) * Math.Sin((f - p / 4.0) * (2.0 * PI) / p);
            }
            return 0.5 * Math.Pow(2.0, -10.0 * f) * Math.Sin((f - p / 4.0) * (2.0 * PI) / p) + 1.0;
        }

        return t;
    }

    static double BounceOutCore(double t) {
        if (t < (1.0 / 2.75)) {
            return 7.5625 * t * t;
        }
        if (t < (2.0 / 2.75)) {
            double f = t - (1.5 / 2.75);
            return 7.5625 * f * f + 0.75;
        }
        if (t < (2.5 / 2.75)) {
            double f = t - (2.25 / 2.75);
            return 7.5625 * f * f + 0.9375;
        }
        double f2 = t - (2.625 / 2.75);
        return 7.5625 * f2 * f2 + 0.984375;
    }
}

// 独立的补间动画实例。管理从起始值向目标值的平滑过渡，
// 支持延迟等待、循环/往复、单步增量更新与完成态查询。
class Tween {
    double fromValue;
    double toValue;
    int durationMs;
    int delayMs;
    int easeType;
    int loopMode;

    int elapsedMs;
    bool finished;
    bool paused;
    bool reverse;
    double currentValue;

    // 创建数值补间动画实例。
    Tween(double from, double to, int durationMs, int easeType) {
        this.fromValue = from;
        this.toValue = to;
        this.durationMs = durationMs;
        if (this.durationMs <= 0) { this.durationMs = 1; }
        this.delayMs = 0;
        this.easeType = easeType;
        this.loopMode = TweenLoop.Once;

        this.elapsedMs = 0;
        this.finished = false;
        this.paused = false;
        this.reverse = false;
        this.currentValue = from;
    }

    // 设置延迟毫秒数
    Tween SetDelay(int delayMs) {
        if (delayMs < 0) { delayMs = 0; }
        this.delayMs = delayMs;
        return this;
    }

    // 设置循环模式：Once / Loop / Yoyo
    Tween SetLoop(int loopMode) {
        this.loopMode = loopMode;
        return this;
    }

    // 暂停补间更新
    void Pause() { this.paused = true; }
    // 恢复补间更新
    void Resume() { this.paused = false; }
    // 是否处于暂停状态
    bool IsPaused() { return this.paused; }

    // 重置补间回到初始状态
    void Reset() {
        this.elapsedMs = 0;
        this.finished = false;
        this.reverse = false;
        this.currentValue = this.fromValue;
    }

    // 立即完成补间并跳至最终目标值
    void Complete() {
        this.elapsedMs = this.delayMs + this.durationMs;
        this.finished = true;
        this.currentValue = this.toValue;
    }

    // 推进补间动画时间。以毫秒为增量。
    void Update(int deltaMs) {
        if (this.finished || this.paused || deltaMs <= 0) {
            return;
        }

        this.elapsedMs = this.elapsedMs + deltaMs;
        if (this.elapsedMs <= this.delayMs) {
            this.currentValue = this.fromValue;
            return;
        }

        int activeTime = this.elapsedMs - this.delayMs;
        if (activeTime >= this.durationMs) {
            if (this.loopMode == TweenLoop.Once) {
                this.finished = true;
                this.currentValue = this.toValue;
                return;
            }
            if (this.loopMode == TweenLoop.Loop) {
                this.elapsedMs = this.delayMs + (activeTime - (activeTime / this.durationMs) * this.durationMs);
                activeTime = this.elapsedMs - this.delayMs;
            } else if (this.loopMode == TweenLoop.Yoyo) {
                int cycle = activeTime / this.durationMs;
                int rem = activeTime - cycle * this.durationMs;
                this.elapsedMs = this.delayMs + rem;
                activeTime = rem;
                this.reverse = (cycle % 2 != 0);
            }
        }

        double normalized = (double)activeTime / (double)this.durationMs;
        if (normalized > 1.0) { normalized = 1.0; }
        if (normalized < 0.0) { normalized = 0.0; }

        if (this.reverse) {
            normalized = 1.0 - normalized;
        }

        double factor = Easing.Evaluate(this.easeType, normalized);
        this.currentValue = this.fromValue + (this.toValue - this.fromValue) * factor;
    }

    // 获取当前计算插值结果
    double Value() { return this.currentValue; }
    // 获取归一化进度 [0.0, 1.0]
    double Progress() {
        if (this.elapsedMs <= this.delayMs) { return 0.0; }
        int active = this.elapsedMs - this.delayMs;
        if (active >= this.durationMs) { return 1.0; }
        return (double)active / (double)this.durationMs;
    }
    // 是否已播放完毕
    bool IsFinished() { return this.finished; }
}

// 补间动画管理器。集中批量推进多个动画，并在动效播放完毕后自动清理。
class TweenGroup {
    List<Tween> tweens;

    TweenGroup() {
        this.tweens = new List<Tween>();
    }

    // 注册一个补间实例
    Tween Add(Tween tween) {
        if (tween != null) {
            this.tweens.Add(tween);
        }
        return tween;
    }

    // 创建并添加一个缓动实例
    Tween To(double from, double to, int durationMs, int easeType) {
        Tween t = new Tween(from, to, durationMs, easeType);
        this.tweens.Add(t);
        return t;
    }

    // 集中推进所有补间并移除已完成的一次性动效
    void Update(int deltaMs) {
        if (deltaMs <= 0) { return; }
        int i = 0;
        while (i < this.tweens.Count) {
            Tween t = this.tweens[i];
            t.Update(deltaMs);
            if (t.IsFinished()) {
                this.tweens.RemoveAt(i);
            } else {
                i = i + 1;
            }
        }
    }

    // 当前托管的动效数量
    int Count() { return this.tweens.Count; }

    // 清空所有托管的动效
    void Clear() { this.tweens.Clear(); }
}
