using System;

namespace Game.Foundation;

// 收缩圈 QTE：一枚从外圈往里收缩的环，玩家在命中窗口内按下算命中。
//
// 判据（换个游戏还成立）：所有"时机判定"玩法共用这一套——挖矿拉重物、
// 钓鱼收线、拆弹、节奏游戏的判定圈。差别只在半径、速度和窗口数值，
// 这些都是参数；判定语义（收缩、窗口命中、到底重置、命中计数）是共用的。
//
// 典型用法：
//   RingQte q = new RingQte().WithTiming(96.0, 14.0, 340.0, 34.0, 54.0).WithNeed(3);
//   q.Update(dtMs);        // 每帧推进收缩
//   if (q.Hit()) { ... }   // 玩家按下：命中窗口内才算
//   if (q.Complete()) { ... }
//
// 表现层（画圈、画进度点）由游戏自己画，本类不碰像素：
// 读 radius 画当前环，读 done/need 画进度。
public class RingQte {
    // 当前半径（表现层照这个画）。
    public double radius = 96.0;
    // 起始半径（命中或漏按后复位到这里）。
    public double maxRadius = 96.0;
    // 收缩到底的半径。
    public double minRadius = 14.0;
    // 每秒收缩多少。
    public double speed = 340.0;
    // 命中窗口：半径落在 [hitLo, hitHi] 内按下算命中。
    public double hitLo = 34.0;
    public double hitHi = 54.0;
    // 需要命中几次才算通过。
    public int need = 1;
    // 已命中次数。
    public int done = 0;
    // 漏按次数（收缩到底没按、或按早了）。
    public int miss = 0;

    // 圈的几何与节奏：起始半径 / 收缩到底半径 / 每秒收缩量 / 命中窗口。
    public RingQte WithTiming(double maxR, double minR, double speedPerSecond,
                              double lo, double hi) {
        this.maxRadius = maxR;
        this.minRadius = minR;
        this.speed = speedPerSecond;
        this.hitLo = lo;
        this.hitHi = hi;
        this.radius = maxR;
        return this;
    }

    // 需要命中几次。
    public RingQte WithNeed(int count) {
        this.need = count;
        return this;
    }

    // 每帧推进：半径收缩；缩到底就复位并记一次漏按。
    // 返回 true 表示这一帧缩到底复位了（表现层可以据此抖一下）。
    public bool Update(int deltaMilliseconds) {
        if (deltaMilliseconds <= 0) { return false; }
        double dt = deltaMilliseconds / 1000.0;
        this.radius = this.radius - dt * this.speed;
        if (this.radius > this.maxRadius) { this.radius = this.maxRadius; }
        if (this.radius > this.minRadius) { return false; }
        this.radius = this.maxRadius;
        this.miss = this.miss + 1;
        return true;
    }

    // 当前半径是否落在命中窗口里（表现层与 AI 自瞄都用它）。
    public bool InWindow() {
        return this.radius >= this.hitLo && this.radius <= this.hitHi;
    }

    // 玩家按下：半径在命中窗口内算命中（计数 +1、半径复位），
    // 否则算漏按（漏按也复位，让玩家重来这一下）。
    // 返回是否命中。
    public bool Hit() {
        if (this.radius >= this.hitLo && this.radius <= this.hitHi) {
            this.done = this.done + 1;
            this.radius = this.maxRadius;
            return true;
        }
        this.miss = this.miss + 1;
        this.radius = this.maxRadius;
        return false;
    }

    // 是否已完成（命中次数够）。
    public bool Complete() { return this.done >= this.need; }

    // 复位到"一次都没打"的状态（关卡重来用）。
    public void Reset() {
        this.radius = this.maxRadius;
        this.done = 0;
        this.miss = 0;
    }
}
