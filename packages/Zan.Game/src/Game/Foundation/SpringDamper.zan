using System;

namespace Game.Foundation;

/// <summary>
/// 二阶弹簧阻尼振荡器（Spring-Damper Model）。
/// 用于丝滑的相机跟随、UI 弹跳弹性动效、角色物理阻尼手感，彻底替代容易产生超调抖动的普通线性 Lerp。
/// 基于隐式欧拉半积分数值解，在变帧率 dt 下仍保持极高数值稳定性。
/// </summary>
class SpringDamper {
    double current;
    double target;
    double velocity;
    double stiffness; // 刚度/频率 (角频率 omega_n，推荐 10.0 ~ 30.0)
    double damping;   // 阻尼比 zeta (1.0 为临界阻尼无震荡，0.7 为轻微回弹手感，0.3 为明显弹簧跳跃)

    SpringDamper(double initialValue, double stiffness, double damping) {
        this.current = initialValue;
        this.target = initialValue;
        this.velocity = 0.0;
        this.stiffness = stiffness > 0.0 ? stiffness : 15.0;
        this.damping = damping >= 0.0 ? damping : 0.8;
    }

    SpringDamper(double initialValue) {
        this.current = initialValue;
        this.target = initialValue;
        this.velocity = 0.0;
        this.stiffness = 18.0;
        this.damping = 0.75;
    }

    /// <summary>设置目标位置（激励源）。</summary>
    void SetTarget(double target) {
        this.target = target;
    }

    /// <summary>瞬间重置当前位置与速度（如场景切换或瞬移）。</summary>
    void SnapTo(double val) {
        this.current = val;
        this.target = val;
        this.velocity = 0.0;
    }

    /// <summary>给系统施加一个瞬时冲量（如受击震动、开火后座力）。</summary>
    void AddImpulse(double impulse) {
        this.velocity = this.velocity + impulse;
    }

    /// <summary>
    /// 推进物理时间 dt 秒，返回当前帧插值后的值。
    /// </summary>
    double Update(double dt) {
        if (dt <= 0.0) { return this.current; }
        // 限制最大 dt 防物理爆破（如系统睡眠唤醒）
        if (dt > 0.05) { dt = 0.05; }

        double f = 1.0 + 2.0 * dt * this.damping * this.stiffness;
        double oo = this.stiffness * this.stiffness;
        double hoo = dt * oo;
        double hhoo = dt * hoo;
        double detInv = 1.0 / (f + hhoo);

        double detPos = f * this.current + dt * this.velocity + hhoo * this.target;
        double detVel = this.velocity + hoo * (this.target - this.current);

        this.current = detPos * detInv;
        this.velocity = detVel * detInv;

        return this.current;
    }

    double GetValue() { return this.current; }
    double GetVelocity() { return this.velocity; }
    double GetTarget() { return this.target; }
    
    /// <summary>判断振荡是否已基本静止（位置贴近且速度极小）。</summary>
    bool IsAtRest(double tolerance) {
        double diff = this.current - this.target;
        if (diff < 0.0) { diff = -diff; }
        double v = this.velocity;
        if (v < 0.0) { v = -v; }
        return diff < tolerance && v < tolerance;
    }
}
