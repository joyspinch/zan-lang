using System;

namespace Game.Foundation;

// 栈式场景生命周期契约：只有栈顶场景接收 FixedUpdate/Update
// （由 SceneStack 转发）。Push 时旧栈顶收到 Pause、本场景收到
// Enter；Pop 时本场景收到 Exit、新栈顶收到 Resume。
public class SceneStack {
    public List<IGameScene> scenes;

    public SceneStack() {
        this.scenes = new List<IGameScene>();
    }

    // 压入新场景：旧栈顶 Pause，新场景 Enter 后成为栈顶。
    // null 直接忽略。
    public void Push(IGameScene scene) {
        if (scene == null) { return; }
        if (this.scenes.Count > 0) {
            this.scenes[this.scenes.Count - 1].Pause();
        }
        this.scenes.Add(scene);
        scene.Enter();
    }

    // 弹出栈顶场景（收到 Exit）并返回它；下层场景收到 Resume。
    // 栈空时返回 null 且无副作用。
    public IGameScene Pop() {
        if (this.scenes.Count == 0) { return null; }
        int index = this.scenes.Count - 1;
        IGameScene scene = this.scenes[index];
        scene.Exit();
        this.scenes.RemoveAt(index);
        if (this.scenes.Count > 0) {
            this.scenes[this.scenes.Count - 1].Resume();
        }
        return scene;
    }

    // 弹出当前栈顶并压入新场景（旧栈顶 Exit、新场景 Enter）。
    public void Replace(IGameScene scene) {
        this.Pop();
        this.Push(scene);
    }

    // 当前栈顶场景；栈空返回 null。
    public IGameScene Current() {
        if (this.scenes.Count == 0) { return null; }
        return this.scenes[this.scenes.Count - 1];
    }

    // 栈中场景数。
    public int Count() { return this.scenes.Count; }

    // 把固定步长更新转发给栈顶场景（栈空时忽略）。
    public void FixedUpdate(int deltaMilliseconds) {
        IGameScene scene = this.Current();
        if (scene != null) { scene.FixedUpdate(deltaMilliseconds); }
    }

    // 把每帧更新转发给栈顶场景（栈空时忽略）。
    public void Update(int deltaMilliseconds) {
        IGameScene scene = this.Current();
        if (scene != null) { scene.Update(deltaMilliseconds); }
    }

    // 依次弹出全部场景（每个都收到 Exit），清空栈。
    public void Clear() {
        while (this.scenes.Count > 0) { this.Pop(); }
    }
}
