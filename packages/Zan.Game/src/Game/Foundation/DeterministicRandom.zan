using System;

namespace Game.Foundation;

// 小型可复现随机源（64 位线性同余推进 + splitmix64 输出混合），状态对外暴露——保存
// state 即可完整恢复随机序列，用于存档、确定性回放与网络同步。
// 同一种子的序列永远一致；种子 0 视为 1（避免全零序列）。
public class DeterministicRandom {
    public long state;

    // 用种子构造；种子 0 自动改为 1。
    public DeterministicRandom(long seed) {
        this.state = seed;
        if (this.state == 0) { this.state = 1; }
    }

    // 原始 64 位 LCG 状态推进（含符号位，可直接做哈希/噪声）。
    public long NextRaw() {
        this.state =
            this.state * 6364136223846793005 + 1442695040888963407;
        return this.state;
    }

    // 非负 64 位随机数（0..2^63-1）。
    //
    // 输出必须经过混合：2^64 模的 LCG 低位周期极短（最低位 0/1 严格交替，低 k 位
    // 周期 2^k），直接取模会让 NextBelow(2) 变成 0101…、NextBelow(256) 只出一半的值
    // ——回放机器人与洗牌都会被这种规律锁死。这里对状态做 splitmix64 收尾混合
    // （高低位充分搅拌），状态推进与 State()/Restore() 不变，存档照旧可恢复。
    public long Next() {
        long x = this.NextRaw();
        x = x ^ ((x >> 33) & 2147483647L);
        x = x * -49064778989728563L;
        x = x ^ ((x >> 33) & 2147483647L);
        x = x * -4265267296055464877L;
        x = x ^ ((x >> 33) & 2147483647L);
        return x & 9223372036854775807L;
    }

    // [0, bound) 的随机整数；bound≤0 返回 0。
    public int NextBelow(int bound) {
        if (bound <= 0) { return 0; }
        long result = this.Next();
        return (int)(result - (result / bound) * bound);
    }

    // [minimum, maximumExclusive) 的随机整数；
    // 上界不大于下界时恒返回 minimum。
    public int Between(int minimum, int maximumExclusive) {
        if (maximumExclusive <= minimum) { return minimum; }
        return minimum + this.NextBelow(maximumExclusive - minimum);
    }

    // [0,1) 的随机小数（精度 1e-6）。
    public double NextDouble() {
        return (double)this.NextBelow(1000000) / 1000000.0;
    }

    // 当前 LCG 状态（存档这个值即可完整恢复序列）。
    public long State() { return this.state; }

    // 恢复到指定状态（0 自动改为 1），后续序列与保存时一致。
    public void Restore(long state) {
        this.state = state;
        if (this.state == 0) { this.state = 1; }
    }
}
