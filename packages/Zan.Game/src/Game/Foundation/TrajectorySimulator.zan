using System;
using System.Collections.Generic;

namespace Game.Foundation;

// 离线手感物理轨迹仿真器。
// 专供游戏手感调参（跳跃手感、重力加速度、阻力曲线），可在无游戏窗口环境下直接输出物理曲线指标。
class TrajectorySimulator {
    // 仿真跳跃手感轨迹并输出诊断分析。
    // gravity: 重力加速度 (如 980.0 px/s^2)
    // jumpVelocity: 起跳初速度 (向上为负或正，此处统一按向上初速度标量值计算)
    // airDrag: 空气阻力系数 (0.0 ~ 1.0)
    // maxSteps: 最大仿真帧数 (如 120 帧，约 2 秒)
    // dt: 单帧步长 (默认 1/60 秒)
    static List<TrajectoryPoint> SimulateJump(double gravity, double jumpVelocity, double airDrag, int maxSteps, double dt) {
        List<TrajectoryPoint> list = new List<TrajectoryPoint>();
        if (dt <= 0.0) { dt = 1.0 / 60.0; }
        if (maxSteps <= 0) { maxSteps = 120; }

        double t = 0.0;
        double y = 0.0;  // 起跳点为 0
        double vy = -jumpVelocity;  // 假设向上为负 y
        double x = 0.0;
        double vx = 0.0;

        list.Add(new TrajectoryPoint(t, x, y, vx, vy));

        double dragFactor = airDrag > 0.0 ? (1.0 - airDrag * dt) : 1.0;
        double gravDt = gravity * dt;

        for (int i = 0; i < maxSteps; i = i + 1) {
            // 空气阻力
            if (airDrag > 0.0) {
                vy = vy * dragFactor;
            }
            // 重力积分
            vy = vy + gravDt;
            y = y + vy * dt;
            t = t + dt;

            list.Add(new TrajectoryPoint(t, x, y, vx, vy));

            // 回到地面（着陆）
            if (y >= 0.0 && i > 2) {
                break;
            }
        }
        return list;
    }

    // 计算跳跃手感属性摘要：返回 [最高点高度(像素), 达到最高点耗时(秒), 滞空总时长(秒)]
    static double[] AnalyzeJumpMetrics(double gravity, double jumpVelocity, double airDrag) {
        double dt = 1.0 / 120.0;  // 细粒度积分
        double apexHeight = 0.0;
        double timeToApex = 0.0;
        double totalAirTime = 0.0;

        double t = 0.0;
        double y = 0.0;
        double vy = -jumpVelocity;
        double dragFactor = airDrag > 0.0 ? (1.0 - airDrag * dt) : 1.0;
        double gravDt = gravity * dt;

        for (int i = 0; i < 240; i = i + 1) {
            if (airDrag > 0.0) {
                vy = vy * dragFactor;
            }
            vy = vy + gravDt;
            y = y + vy * dt;
            t = t + dt;

            double h = -y;
            if (h > apexHeight) {
                apexHeight = h;
                timeToApex = t;
            }
            if (y >= 0.0 && i > 2) {
                totalAirTime = t;
                break;
            }
        }
        if (totalAirTime == 0.0) {
            totalAirTime = t;
        }

        double[] res = new double[3];
        res[0] = apexHeight;
        res[1] = timeToApex;
        res[2] = totalAirTime;
        return res;
    }
}
