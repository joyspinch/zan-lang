using System;
using System.Collections.Generic;
using System.Media;

namespace Game.Foundation;

// 2.5D / 2D 空间立体声与声相衰减系统（Spatial Audio 2D）。
// 专为 ARPG 传奇打怪听声辨位、RTS 战场侧翼交火与射击弹道音效打造：
// 1. 距离平方反比与线性衰减（随与听者/相机中心距离降低增益）；
// 2. 屏幕左右声相偏转（Stereo Panning: -1.0 极左 ~ +1.0 极右）；
// 3. 等功率立体声能量法则（Constant Power Panning）；
// 4. 移动音源追踪与视区外超远距静音裁剪。
public class SpatialAudio2D {
    public double listenerX;
    public double listenerY;
    public double panSpanWidth;  // 产生最大偏相的水平半跨度（如 640px 对应半屏宽）
    public double invPanSpanWidth;
    public double minDistance;  // 满音量无衰减半径（如 80px）
    public double maxDistance;  // 最大可听半径（超出则裁切静音，如 1200px）
    public double minDistSq;
    public double maxDistSq;
    public double invDistRange;
    public AudioBus audioBus;

    public SpatialAudio2D(AudioBus bus, double spanW, double minD, double maxD) {
        this.audioBus = bus;
        this.listenerX = 0.0;
        this.listenerY = 0.0;
        this.panSpanWidth = spanW > 50.0 ? spanW : 640.0;
        this.minDistance = minD > 0.0 ? minD : 80.0;
        this.maxDistance = maxD > minD ? maxD : 1200.0;
        this.UpdateCachedMetrics();
    }

    public static SpatialAudio2D Create(AudioBus bus, double spanW, double minD, double maxD) {
        return new SpatialAudio2D(bus, spanW, minD, maxD);
    }

    public double ListenerX { get { return listenerX; } set { listenerX = value; } }
    public double ListenerY { get { return listenerY; } set { listenerY = value; } }
    public double MinDistance { get { return minDistance; } set { minDistance = value; UpdateCachedMetrics(); } }
    public double MaxDistance { get { return maxDistance; } set { maxDistance = value; UpdateCachedMetrics(); } }

    public void UpdateCachedMetrics() {
        this.invPanSpanWidth = 1.0 / this.panSpanWidth;
        this.minDistSq = this.minDistance * this.minDistance;
        this.maxDistSq = this.maxDistance * this.maxDistance;
        double range = this.maxDistance - this.minDistance;
        this.invDistRange = range > 0.001 ? (1.0 / range) : 1.0;
    }

    public void SetListenerPosition(double x, double y) {
        this.listenerX = x;
        this.listenerY = y;
    }

    // 计算指定世界坐标处的声相值与距离衰减增益。
    // outPan: -1.0 (极左) ~ +1.0 (极右)
    // outGain: 0.0 ~ 1.0
    public void CalculateSpatial(double sourceX, double sourceY, double baseGain, out double outPan, out double outGain) {
        double dx = sourceX - listenerX;
        double dy = sourceY - listenerY;
        double distSq = dx * dx + dy * dy;

        // 1. 声相计算（水平偏移跨度归一化，乘倒数消除除法）
        double rawPan = dx * invPanSpanWidth;
        if (rawPan < -1.0) { rawPan = -1.0; }
        if (rawPan > 1.0) { rawPan = 1.0; }
        outPan = rawPan;

        // 2. 距离衰减计算（基于平方距离短路判断，避免无谓的 Math.Sqrt 开销）
        if (distSq >= maxDistSq) {
            outGain = 0.0;
            return;
        }

        if (distSq <= minDistSq) {
            outGain = baseGain;
        } else {
            double dist = Math.Sqrt(distSq);
            // 平滑线性插值（乘倒数消除除法）
            double t = (dist - minDistance) * invDistRange;
            double atten = 1.0 - t;
            // 平滑衰减曲线 (SmoothStep 体验更佳)
            atten = atten * atten;
            outGain = baseGain * atten;
        }

        if (outGain < 0.0) { outGain = 0.0; }
        if (outGain > 1.0) { outGain = 1.0; }
    }

    // 在指定空间坐标处触发一次具有立体声空间感的音效。
    public AudioVoice PlayAt(AudioClip clip, double sourceX, double sourceY, double baseGain, int loop) {
        if (clip == null || !clip.IsValid()) { return null; }

        double pan;
        double effectiveGain;
        CalculateSpatial(sourceX, sourceY, baseGain, out pan, out effectiveGain);

        if (effectiveGain <= 0.001) {
            // 超出听音半径直接跳过，零 CPU 开销
            return null;
        }

        double finalVolume = effectiveGain;
        if (audioBus != null) {
            finalVolume = finalVolume * audioBus.SfxVolume() * audioBus.MasterVolume();
            if (audioBus.IsSfxMuted() || audioBus.IsMasterMuted()) {
                return null;
            }
        }

        // 调用底层起播
        return clip.Play(finalVolume, loop);
    }
}
