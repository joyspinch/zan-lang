using System;
using System.Collections.Generic;

namespace Game.Foundation;

// 缓动类型枚举常数。
// 涵盖主流曲线族：线性、二次、三次、四次、五次、正弦、指数、圆弧、回弹、弹跳与弹性。
public class EaseType {
    public const int Linear = 0;
    public const int QuadIn = 1;
    public const int QuadOut = 2;
    public const int QuadInOut = 3;
    public const int CubicIn = 4;
    public const int CubicOut = 5;
    public const int CubicInOut = 6;
    public const int QuartIn = 7;
    public const int QuartOut = 8;
    public const int QuartInOut = 9;
    public const int QuintIn = 10;
    public const int QuintOut = 11;
    public const int QuintInOut = 12;
    public const int SineIn = 13;
    public const int SineOut = 14;
    public const int SineInOut = 15;
    public const int ExpoIn = 16;
    public const int ExpoOut = 17;
    public const int ExpoInOut = 18;
    public const int CircIn = 19;
    public const int CircOut = 20;
    public const int CircInOut = 21;
    public const int BackIn = 22;
    public const int BackOut = 23;
    public const int BackInOut = 24;
    public const int BounceIn = 25;
    public const int BounceOut = 26;
    public const int BounceInOut = 27;
    public const int ElasticIn = 28;
    public const int ElasticOut = 29;
    public const int ElasticInOut = 30;
}
