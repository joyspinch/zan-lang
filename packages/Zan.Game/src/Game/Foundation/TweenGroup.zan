using System;
using System.Collections.Generic;

namespace Game.Foundation;

// 补间动画管理器。集中批量推进多个动画，并在动效播放完毕后自动清理。
class TweenGroup {
    List<Tween> tweens;

    TweenGroup() {
        this.tweens = new List<Tween>();
    }

    // 注册一个补间实例
    Tween Add(Tween tween) {
        if (tween != null) {
            this.tweens.Add(tween);
        }
        return tween;
    }

    // 创建并添加一个缓动实例
    Tween To(double from, double to, int durationMs, int easeType) {
        Tween t = new Tween(from, to, durationMs, easeType);
        this.tweens.Add(t);
        return t;
    }

    // 集中推进所有补间并移除已完成的一次性动效
    void Update(int deltaMs) {
        if (deltaMs <= 0) { return; }
        int i = 0;
        while (i < this.tweens.Count) {
            Tween t = this.tweens[i];
            t.Update(deltaMs);
            if (t.IsFinished()) {
                this.tweens.RemoveAt(i);
            } else {
                i = i + 1;
            }
        }
    }

    // 当前托管的动效数量
    int Count() { return this.tweens.Count; }

    // 清空所有托管的动效
    void Clear() { this.tweens.Clear(); }
}
