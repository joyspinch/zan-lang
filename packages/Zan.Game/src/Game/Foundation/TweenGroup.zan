using System;
using System.Collections.Generic;

namespace Game.Foundation;

// 补间动画管理器。集中批量推进多个动画，并在动效播放完毕后自动清理。
class TweenGroup {
    List<Tween> tweens;

    TweenGroup() {
        this.tweens = new List<Tween>();
    }

    // 注册一个补间实例
    Tween Add(Tween tween) {
        if (tween != null) {
            this.tweens.Add(tween);
        }
        return tween;
    }

    // 创建并添加一个缓动实例
    Tween To(double from, double to, int durationMs, int easeType) {
        Tween t = new Tween(from, to, durationMs, easeType);
        this.tweens.Add(t);
        return t;
    }

    // 集中推进所有补间并移除已完成的一次性动效（O(N) 原地紧凑双指针，消除逐项 RemoveAt 元素重排）
    void Update(int deltaMs) {
        if (deltaMs <= 0) { return; }
        int count = this.tweens.Count;
        int writeIdx = 0;
        for (int readIdx = 0; readIdx < count; readIdx = readIdx + 1) {
            Tween t = this.tweens[readIdx];
            t.Update(deltaMs);
            if (!t.IsFinished()) {
                if (writeIdx != readIdx) {
                    this.tweens[writeIdx] = t;
                }
                writeIdx = writeIdx + 1;
            }
        }
        while (this.tweens.Count > writeIdx) {
            this.tweens.RemoveAt(this.tweens.Count - 1);
        }
    }

    // 当前托管的动效数量
    int Count() { return this.tweens.Count; }

    // 清空所有托管的动效
    void Clear() { this.tweens.Clear(); }
}
