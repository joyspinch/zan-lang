using System;

namespace Game.Tactics;

/// 生成怪物回调：波次号、怪物类型。
delegate void SpawnMonsterFn(int wave, int mobType);
/// 波次完成回调：波次号。
delegate void WaveCompleteFn(int wave);

/// <summary>
/// 塔防与战术游戏波次控制器。
/// 控制怪物定时生成波次、关卡难度递增与通关奖励触发。
/// </summary>
class WaveSpawner {
    int currentWave;
    int totalWaves;
    bool isWaveActive;

    int monstersInCurrentWave;
    int monstersSpawned;
    double spawnInterval;
    double spawnTimer;

    double wavePreparationTimer;
    double preparationDuration;

    WaveSpawner(int totalWaves, double prepDuration) {
        this.totalWaves = totalWaves > 0 ? totalWaves : 20;
        this.currentWave = 0;
        this.isWaveActive = false;
        this.monstersInCurrentWave = 0;
        this.monstersSpawned = 0;
        this.spawnInterval = 1.0;
        this.spawnTimer = 0.0;
        this.preparationDuration = prepDuration > 1.0 ? prepDuration : 10.0;
        this.wavePreparationTimer = this.preparationDuration;
    }

    static WaveSpawner Create(int totalWaves, double prepDuration) {
        return new WaveSpawner(totalWaves, prepDuration);
    }

    int CurrentWave { get { return currentWave; } }
    int TotalWaves { get { return totalWaves; } }
    bool IsWaveActive { get { return isWaveActive; } }
    double PrepTimeLeft { get { return wavePreparationTimer; } }

    /// <summary>跳过准备倒计时，立即开启下一波怪物进击。</summary>
    void StartNextWaveImmediately() {
        if (!isWaveActive && currentWave < totalWaves) {
            wavePreparationTimer = 0.0;
        }
    }

    /// <summary>
    /// 逐物理帧推进波次状态机。
    /// 当需要生成怪物时触发 onSpawnMonster 委托。
    /// </summary>
    void Update(double dt, int aliveMonsterCount, SpawnMonsterFn onSpawnMonster, WaveCompleteFn onWaveCompleted) {
        if (!isWaveActive) {
            if (currentWave >= totalWaves) {
                // 全部波次已结束
                return;
            }

            // 备战倒计时
            wavePreparationTimer = wavePreparationTimer - dt;
            if (wavePreparationTimer <= 0.0) {
                // 开启新波次
                currentWave = currentWave + 1;
                isWaveActive = true;
                monstersSpawned = 0;
                // 波次怪物数量随波次递增
                monstersInCurrentWave = 10 + currentWave * 5;
                spawnInterval = Math.Max(0.2, 1.2 - (double)currentWave * 0.05);
                spawnTimer = 0.0;
            }
            return;
        }

        // 当前波次进行中：生成怪物
        if (monstersSpawned < monstersInCurrentWave) {
            spawnTimer = spawnTimer - dt;
            if (spawnTimer <= 0.0) {
                spawnTimer = spawnInterval;
                int mobType = (currentWave % 5 == 0 && monstersSpawned == monstersInCurrentWave - 1) ? 2 : (monstersSpawned % 3);  // 逢5波出现 Boss
                monstersSpawned = monstersSpawned + 1;

                if (onSpawnMonster != null) {
                    onSpawnMonster(currentWave, mobType);
                }
            }
        } else {
            // 所有怪物已生成完毕，等待场上怪物全部被消灭
            if (aliveMonsterCount <= 0) {
                isWaveActive = false;
                wavePreparationTimer = preparationDuration;
                if (onWaveCompleted != null) {
                    onWaveCompleted(currentWave);
                }
            }
        }
    }
}
