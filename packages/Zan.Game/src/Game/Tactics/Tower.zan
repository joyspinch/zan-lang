using System;
using Game.Core;

namespace Game.Tactics;

/// <summary>
/// 防御塔索敌策略。
/// </summary>
enum TargetPriority {
    First,  // 进击距离最远（最接近终点）
    Closest,  // 离防御塔直线距离最近
    Strongest,  // 生命值最高
    Weakest  // 残血收割
}

/// <summary>
/// 通用防御塔基类。
/// 内置射程检测、冷却倒计时、索敌策略与开火动画角度解算。
/// </summary>
class Tower {
    int id;
    int towerType;
    int level;
    double x;  // 世界坐标 X
    double y;  // 世界坐标 Y
    double range;  // 攻击半径
    double fireRate;  // 攻击间隔（秒）
    double damage;  // 基础伤害
    int cost;  // 建造或升级费用

    double cooldown;  // 冷却倒计时
    int currentTargetId;  // 当前锁定的敌人 ID
    double aimAngleRad;  // 当前瞄准炮口旋转弧度
    TargetPriority priority;

    Tower(int id, int type, double x, double y, double range, double fireRate, double damage, int cost) {
        this.id = id;
        this.towerType = type;
        this.level = 1;
        this.x = x;
        this.y = y;
        this.range = range;
        this.fireRate = fireRate > 0.05 ? fireRate : 0.5;
        this.damage = damage;
        this.cost = cost;

        this.cooldown = 0.0;
        this.currentTargetId = -1;
        this.aimAngleRad = 0.0;
        this.priority = TargetPriority.First;
    }

    static Tower Create(int id, int type, double x, double y, double range, double fireRate, double damage, int cost) {
        return new Tower(id, type, x, y, range, fireRate, damage, cost);
    }

    int Id { get { return id; } }
    int TowerType { get { return towerType; } }
    int Level { get { return level; } }
    double X { get { return x; } }
    double Y { get { return y; } }
    double Range { get { return range; } }
    double Damage { get { return damage; } }
    double AimAngle { get { return aimAngleRad; } }
    int TargetId { get { return currentTargetId; } }
    bool CanFire { get { return cooldown <= 0.0; } }

    void SetPriority(TargetPriority p) {
        this.priority = p;
    }

    void Upgrade(double rangeMul, double damageMul, double speedMul, int upgradeCost) {
        level = level + 1;
        range = range * rangeMul;
        damage = damage * damageMul;
        fireRate = fireRate / speedMul;
        cost = cost + upgradeCost;
    }

    /// <summary>
    /// 更新冷却时间，并向目标旋转炮口。
    /// </summary>
    void Update(double dt) {
        if (cooldown > 0.0) {
            cooldown = cooldown - dt;
            if (cooldown < 0.0) { cooldown = 0.0; }
        }
    }

    /// <summary>
    /// 将炮口对准目标实体位置。
    /// </summary>
    void AimAt(double targetX, double targetY) {
        double dx = targetX - x;
        double dy = targetY - y;
        aimAngleRad = Math.Atan2(dy, dx);
    }

    /// <summary>
    /// 触发开火，重置冷却时间。
    /// </summary>
    void TriggerFire() {
        cooldown = fireRate;
    }
}
