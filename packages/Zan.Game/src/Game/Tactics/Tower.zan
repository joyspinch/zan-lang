using System;
using Game.Core;

namespace Game.Tactics;

// 防御塔索敌策略。
public class Tower {
    public int id;
    public int towerType;
    public int level;
    public double x;  // 世界坐标 X
    public double y;  // 世界坐标 Y
    public double range;  // 攻击半径
    public double rangeSq; // 攻击半径平方（缓存避免开方）
    public double fireRate;  // 攻击间隔（秒）
    public double damage;  // 基础伤害
    public int cost;  // 建造或升级费用

    public double cooldown;  // 冷却倒计时
    public int currentTargetId;  // 当前锁定的敌人 ID
    public double aimAngleRad;  // 当前瞄准炮口旋转弧度
    public TargetPriority priority;

    public Tower(int id, int type, double x, double y, double range, double fireRate, double damage, int cost) {
        this.id = id;
        this.towerType = type;
        this.level = 1;
        this.x = x;
        this.y = y;
        this.range = range;
        this.rangeSq = range * range;
        this.fireRate = fireRate > 0.05 ? fireRate : 0.5;
        this.damage = damage;
        this.cost = cost;

        this.cooldown = 0.0;
        this.currentTargetId = -1;
        this.aimAngleRad = 0.0;
        this.priority = TargetPriority.First;
    }

    public static Tower Create(int id, int type, double x, double y, double range, double fireRate, double damage, int cost) {
        return new Tower(id, type, x, y, range, fireRate, damage, cost);
    }

    public int Id { get { return id; } }
    public int TowerType { get { return towerType; } }
    public int Level { get { return level; } }
    public double X { get { return x; } }
    public double Y { get { return y; } }
    public double Range { get { return range; } }
    public double RangeSq { get { return rangeSq; } }
    public double Damage { get { return damage; } }
    public double AimAngle { get { return aimAngleRad; } }
    public int TargetId { get { return currentTargetId; } }
    public bool CanFire { get { return cooldown <= 0.0; } }

    public void SetPriority(TargetPriority p) {
        this.priority = p;
    }

    public void Upgrade(double rangeMul, double damageMul, double speedMul, int upgradeCost) {
        level = level + 1;
        range = range * rangeMul;
        rangeSq = range * range;
        damage = damage * damageMul;
        fireRate = fireRate / speedMul;
        cost = cost + upgradeCost;
    }

    // 更新冷却时间，并向目标旋转炮口。
    public void Update(double dt) {
        if (cooldown > 0.0) {
            cooldown = cooldown - dt;
            if (cooldown < 0.0) { cooldown = 0.0; }
        }
    }

    // 将炮口对准目标实体位置。
    public void AimAt(double targetX, double targetY) {
        double dx = targetX - x;
        double dy = targetY - y;
        aimAngleRad = Math.Atan2(dy, dx);
    }

    // 触发开火，重置冷却时间。
    public void TriggerFire() {
        cooldown = fireRate;
    }
}
