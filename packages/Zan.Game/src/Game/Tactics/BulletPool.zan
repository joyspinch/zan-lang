using System;

namespace Game.Tactics;

// 子弹命中回调：子弹槽位、命中点 x/y、伤害、溅射半径。
delegate void BulletHitFn(int bulletIndex, double x, double y, double damage, double splashRadius);

// 子弹弹药类型。
enum BulletType {
    Normal,  // 直线普通子弹
    Homing,  // 制导追踪导弹
    Artillery,  // 抛物线高抛落地 AOE 榴弹炮
    Laser  // 瞬间贯通激光射线
}

// 零 GC 内存预分配弹道投射物对象池。
// 支持单机千枚子弹高频模拟，支持直线投射、追踪制导与范围溅射爆炸。
class BulletPool {
    int capacity;
    int activeCount;

    bool[] active;
    int[] bulletType;
    double[] posX;
    double[] posY;
    double[] velX;
    double[] velY;
    int[] targetId;
    double[] targetX;
    double[] targetY;
    double[] damage;
    double[] splashRadius;
    double[] lifeTime;

    // 空闲槽位栈 + 活跃槽位紧凑表：Spawn O(1) 弹栈、Kill O(1) 归还，
    // Update 只遍历活跃段——替换"Spawn 线性扫全容量、Update 空转全容量"的
    // 每帧固定开销（容量 512、活跃 10 颗时原先每帧仍检查 512 槽）
    int[] freeStack;  // [capacity] 空闲槽位号栈
    int freeTop;  // 栈内元素数
    int[] activeList;  // [activeCount] 活跃槽位紧凑表
    int[] activePos;  // [capacity] 槽位在 activeList 中的下标，-1=不活跃

    BulletPool(int cap) {
        this.capacity = cap > 0 ? cap : 512;
        this.activeCount = 0;

        this.active = new bool[capacity];
        this.bulletType = new int[capacity];
        this.posX = new double[capacity];
        this.posY = new double[capacity];
        this.velX = new double[capacity];
        this.velY = new double[capacity];
        this.targetId = new int[capacity];
        this.targetX = new double[capacity];
        this.targetY = new double[capacity];
        this.damage = new double[capacity];
        this.splashRadius = new double[capacity];
        this.lifeTime = new double[capacity];

        this.freeStack = new int[capacity];
        for (int i = 0; i < capacity; i = i + 1) {
            this.freeStack[i] = capacity - 1 - i;
        }
        this.freeTop = capacity;
        this.activeList = new int[capacity];
        this.activePos = new int[capacity];
        for (int i = 0; i < capacity; i = i + 1) {
            this.activePos[i] = -1;
        }
    }

    static BulletPool Create(int capacity) {
        return new BulletPool(capacity);
    }

    int Capacity { get { return capacity; } }
    int ActiveCount { get { return activeCount; } }

    bool IsActive(int idx) { return active[idx]; }
    int GetType(int idx) { return bulletType[idx]; }
    double GetX(int idx) { return posX[idx]; }
    double GetY(int idx) { return posY[idx]; }
    double GetDamage(int idx) { return damage[idx]; }
    double GetSplash(int idx) { return splashRadius[idx]; }

    // 发射一枚直线或追踪子弹。
    int Spawn(BulletType type, double spawnX, double spawnY, int tgtId, double tgtX, double tgtY, double speed, double dmg, double splashR, double maxLife) {
        // 从空闲栈弹出槽位（O(1)，替换线性扫描）
        if (freeTop <= 0) { return -1; }
        freeTop = freeTop - 1;
        int slot = freeStack[freeTop];

        active[slot] = true;
        bulletType[slot] = (int)type;
        posX[slot] = spawnX;
        posY[slot] = spawnY;
        targetId[slot] = tgtId;
        targetX[slot] = tgtX;
        targetY[slot] = tgtY;
        damage[slot] = dmg;
        splashRadius[slot] = splashR;
        lifeTime[slot] = maxLife;

        double dx = tgtX - spawnX;
        double dy = tgtY - spawnY;
        double len = Math.Sqrt(dx * dx + dy * dy);
        if (len > 0.001) {
            velX[slot] = (dx / len) * speed;
            velY[slot] = (dy / len) * speed;
        } else {
            velX[slot] = speed;
            velY[slot] = 0.0;
        }

        activePos[slot] = activeCount;
        activeList[activeCount] = slot;
        activeCount = activeCount + 1;
        return slot;
    }

    // 逐物理步长更新所有活动子弹位置，命中目标时回调。
    // 只遍历活跃段（activeList），消亡槽位 swap-with-last 移出，
    // 换上来的槽位当帧继续处理。
    void Update(double dt, BulletHitFn onHitCallback) {
        int ai = 0;
        while (ai < activeCount) {
            int i = activeList[ai];

            lifeTime[i] = lifeTime[i] - dt;
            if (lifeTime[i] <= 0.0) {
                // 超时消亡
                DespawnAt(ai);
                continue;
            }

            // 移动
            posX[i] = posX[i] + velX[i] * dt;
            posY[i] = posY[i] + velY[i] * dt;

            // 检测是否到达目标点（20 像素以内判定命中）
            double dist2 = (posX[i] - targetX[i]) * (posX[i] - targetX[i]) + (posY[i] - targetY[i]) * (posY[i] - targetY[i]);
            if (dist2 <= 400.0) {
                if (onHitCallback != null) {
                    onHitCallback(i, posX[i], posY[i], damage[i], splashRadius[i]);
                }
                DespawnAt(ai);
                continue;
            }
            ai = ai + 1;
        }
    }

    // 把 activeList[ai] 的槽位归还空闲栈（swap-with-last，O(1)）。
    void DespawnAt(int ai) {
        int slot = activeList[ai];
        int last = activeCount - 1;
        int moving = activeList[last];
        activeList[ai] = moving;
        activePos[moving] = ai;
        activeCount = last;
        active[slot] = false;
        activePos[slot] = -1;
        freeStack[freeTop] = slot;
        freeTop = freeTop + 1;
    }

    void Kill(int idx) {
        if (idx >= 0 && idx < capacity && active[idx]) {
            DespawnAt(activePos[idx]);
        }
    }
}
