using System;

namespace Game.Tactics;

// 海量单位集群流场寻路系统（Flow Field Pathfinding）。
// 解决红警、帝国时代、千万塔防怪群的寻路 CPU 爆炸问题。
// 算法原理：
// 1. 代价图（Cost Field）：障碍物与地形通行阻力。
// 2. 集成场（Integration Field）：以目标点为基准的波前扩散（Dijkstra/BFS）。
// 3. 向量场（Vector Field / Flow Field）：每个格子预先计算出指向最小代价邻居的移动方向向量。
// 无论视野内有 100 只怪还是 10,000 只怪，每个单位只需要 O(1) 地读取所在格子的向量即可完美避障并直奔目标！
public class FlowField {
    public int cols;
    public int rows;
    public int cellSize;
    public double invCellSize;

    public byte[] costField;  // 0~254: 通行代价(默认1), 255: 不可通行障碍
    public int[] integrationField;  // 到达目标的累计总代价(65535 为不可达)
    public float[] flowDirX;  // X 方向单位流动向量 [-1.0 .. 1.0]
    public float[] flowDirY;  // Y 方向单位流动向量 [-1.0 .. 1.0]

    // 广度优先循环队列（一维紧凑索引，零堆分配复用）
    public int[] queue;
    public int queueHead;
    public int queueTail;
    public int queueCap;

    public int targetCol;
    public int targetRow;
    public bool isDirty;

    public static int[] s_n8C = new int[8] { 0, 1, 1, 1, 0, -1, -1, -1 };
    public static int[] s_n8R = new int[8] { -1, -1, 0, 1, 1, 1, 0, -1 };
    public static float[] s_n8DirX = new float[8] {
        0.0f, 0.70710678f, 1.0f, 0.70710678f, 0.0f, -0.70710678f, -1.0f, -0.70710678f
    };
    public static float[] s_n8DirY = new float[8] {
        -1.0f, -0.70710678f, 0.0f, 0.70710678f, 1.0f, 0.70710678f, 0.0f, -0.70710678f
    };

    public FlowField(int cols, int rows, int cellSize) {
        this.cols = cols > 0 ? cols : 64;
        this.rows = rows > 0 ? rows : 64;
        this.cellSize = cellSize > 0 ? cellSize : 32;
        this.invCellSize = 1.0 / (double)this.cellSize;

        int totalCells = this.cols * this.rows;
        this.costField = new byte[totalCells];
        this.integrationField = new int[totalCells];
        this.flowDirX = new float[totalCells];
        this.flowDirY = new float[totalCells];

        this.queueCap = totalCells + 1;
        this.queue = new int[queueCap];
        this.queueHead = 0;
        this.queueTail = 0;

        this.targetCol = -1;
        this.targetRow = -1;
        this.isDirty = true;

        ResetCost();
    }

    public static FlowField Create(int cols, int rows, int cellSize) {
        return new FlowField(cols, rows, cellSize);
    }

    public int Cols { get { return cols; } }
    public int Rows { get { return rows; } }
    public int CellSize { get { return cellSize; } }

    public int Index(int c, int r) {
        return r * cols + c;
    }

    // 重置整个地图代价（默认全部通行代价为 1）。
    public void ResetCost() {
        int total = cols * rows;
        for (int i = 0; i < total; i = i + 1) {
            costField[i] = (byte)1;
            integrationField[i] = 65535;
            flowDirX[i] = 0.0f;
            flowDirY[i] = 0.0f;
        }
        isDirty = true;
    }

    // 设置指定格子的代价（255 代表不可通行的墙壁或建筑物）。
    public void SetCost(int col, int row, byte cost) {
        if (col < 0 || col >= cols || row < 0 || row >= rows) { return; }
        int idx = Index(col, row);
        if (costField[idx] != cost) {
            costField[idx] = cost;
            isDirty = true;
        }
    }

    // 判断指定格子是否为障碍物。
    public bool IsBlocked(int col, int row) {
        if (col < 0 || col >= cols || row < 0 || row >= rows) { return true; }
        return costField[Index(col, row)] >= (byte)255;
    }

    // 指定流场汇聚的目的地（例如水晶、基地、领袖角色）。
    public void SetTarget(int col, int row) {
        if (col < 0 || col >= cols || row < 0 || row >= rows) { return; }
        if (targetCol != col || targetRow != row) {
            targetCol = col;
            targetRow = row;
            isDirty = true;
        }
    }

    // 重构集成场与向量场。
    // 只有在障碍物发生变化或目标移动时才需调用。
    public void Rebuild() {
        if (targetCol < 0 || targetRow < 0) { return; }

        int total = cols * rows;
        for (int i = 0; i < total; i = i + 1) {
            integrationField[i] = 65535;
            flowDirX[i] = 0.0f;
            flowDirY[i] = 0.0f;
        }

        // 目标点集成代价为 0
        int targetIdx = Index(targetCol, targetRow);
        integrationField[targetIdx] = 0;

        // BFS 队列初始化（单数组紧凑 1D 索引，零分配）
        queueHead = 0;
        queueTail = 0;
        queue[queueTail] = targetIdx;
        queueTail = queueTail + 1;

        // 1. 波前扩散计算集成场 (Integration Field)
        while (queueHead != queueTail) {
            int curIdx = queue[queueHead];
            queueHead = queueHead + 1;
            if (queueHead >= queueCap) { queueHead = 0; }

            int curIntCost = integrationField[curIdx];
            int curC = curIdx % cols;
            int curR = curIdx / cols;

            // 4-邻居遍历：展开 1D 偏移快速索引，规避重复乘法与数组开销
            if (curC + 1 < cols) {
                int nIdx = curIdx + 1;
                byte cCost = costField[nIdx];
                if (cCost < (byte)255) {
                    int newCost = curIntCost + (int)cCost;
                    if (newCost < integrationField[nIdx]) {
                        integrationField[nIdx] = newCost;
                        queue[queueTail] = nIdx;
                        queueTail = queueTail + 1;
                        if (queueTail >= queueCap) { queueTail = 0; }
                    }
                }
            }
            if (curC > 0) {
                int nIdx = curIdx - 1;
                byte cCost = costField[nIdx];
                if (cCost < (byte)255) {
                    int newCost = curIntCost + (int)cCost;
                    if (newCost < integrationField[nIdx]) {
                        integrationField[nIdx] = newCost;
                        queue[queueTail] = nIdx;
                        queueTail = queueTail + 1;
                        if (queueTail >= queueCap) { queueTail = 0; }
                    }
                }
            }
            if (curR + 1 < rows) {
                int nIdx = curIdx + cols;
                byte cCost = costField[nIdx];
                if (cCost < (byte)255) {
                    int newCost = curIntCost + (int)cCost;
                    if (newCost < integrationField[nIdx]) {
                        integrationField[nIdx] = newCost;
                        queue[queueTail] = nIdx;
                        queueTail = queueTail + 1;
                        if (queueTail >= queueCap) { queueTail = 0; }
                    }
                }
            }
            if (curR > 0) {
                int nIdx = curIdx - cols;
                byte cCost = costField[nIdx];
                if (cCost < (byte)255) {
                    int newCost = curIntCost + (int)cCost;
                    if (newCost < integrationField[nIdx]) {
                        integrationField[nIdx] = newCost;
                        queue[queueTail] = nIdx;
                        queueTail = queueTail + 1;
                        if (queueTail >= queueCap) { queueTail = 0; }
                    }
                }
            }
        }

        // 2. 计算向量场 (Vector Field)
        // 遍历所有 8 个邻居寻找集成代价最小的邻居，求出下坡方向向量
        for (int r = 0; r < rows; r = r + 1) {
            int rBase = r * cols;
            for (int c = 0; c < cols; c = c + 1) {
                int idx = rBase + c;
                if (costField[idx] >= (byte)255 || (c == targetCol && r == targetRow)) {
                    continue;
                }

                int bestCost = integrationField[idx];
                int bestDir = -1;

                for (int d = 0; d < 8; d = d + 1) {
                    int nc = c + s_n8C[d];
                    int nr = r + s_n8R[d];

                    if (nc >= 0 && nc < cols && nr >= 0 && nr < rows) {
                        int nIdx = nr * cols + nc;
                        if (costField[nIdx] < (byte)255) {
                            int nCost = integrationField[nIdx];
                            if (nCost < bestCost) {
                                bestCost = nCost;
                                bestDir = d;
                            }
                        }
                    }
                }

                if (bestDir >= 0) {
                    flowDirX[idx] = s_n8DirX[bestDir];
                    flowDirY[idx] = s_n8DirY[bestDir];
                }
            }
        }

        isDirty = false;
    }

    // O(1) 采样任意世界坐标处的流场速度方向向量。
    // 输出单位化向量 (vx, vy)。
    public void SampleWorldVelocity(double wx, double wy, out float vx, out float vy) {
        if (isDirty) {
            Rebuild();
        }

        int c = (int)Math.Floor(wx * invCellSize);
        int r = (int)Math.Floor(wy * invCellSize);

        if (c < 0 || c >= cols || r < 0 || r >= rows) {
            vx = 0.0f;
            vy = 0.0f;
            return;
        }

        int idx = Index(c, r);
        vx = flowDirX[idx];
        vy = flowDirY[idx];
    }
}
