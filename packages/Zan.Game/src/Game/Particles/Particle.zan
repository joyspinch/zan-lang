using System;

namespace Game.Particles;

// 粒子（**类**，不是 struct——对象池要就地改字段，结构体元素取出来是副本）。
//
// 生命周期：age 从 0 增长到 lifetime，超时即回收。
// 颜色/大小由"起止值 + 曲线"驱动，渲染方只读 CurrentColor()/CurrentSize()。
public class Particle {
    // 位置与速度。
    public double x;
    public double y;
    public double vx;
    public double vy;
    // 旋转。
    public double rotation;
    public double angularVelocity;
    // 存活时间。
    public double age;
    public double lifetime;
    // 尺寸：baseSize 是初值，sizeCurve 非空时按寿命比例取曲线值 × baseSize。
    public double baseSize;
    public Curve sizeCurve;
    // 颜色：起止 ARGB，按寿命比例插值。
    public int colorStart;
    public int colorEnd;
    // 阻力（每秒比例）与重力缩放。
    public double drag;
    public double gravityScale;
    // 噪声扰动：振幅、频率与采样相位。
    public double noiseAmplitude;
    public double noiseFrequency;
    public double noiseOffset;
    // 渲染用的精灵句柄（由调用方解释；-1 = 未指定）。
    public int sprite;
    // 是否活跃（池里的空闲粒子为 false）。
    public bool active;

    public Particle() {
        this.Reset();
    }

    // 复位成"空粒子"（放回池里之前的标准动作）。
    public void Reset() {
        this.x = 0.0;
        this.y = 0.0;
        this.vx = 0.0;
        this.vy = 0.0;
        this.rotation = 0.0;
        this.angularVelocity = 0.0;
        this.age = 0.0;
        this.lifetime = 1.0;
        this.baseSize = 1.0;
        this.sizeCurve = null;
        this.colorStart = 0xFFFFFFFF;
        this.colorEnd = 0xFFFFFFFF;
        this.drag = 0.0;
        this.gravityScale = 1.0;
        this.noiseAmplitude = 0.0;
        this.noiseFrequency = 0.0;
        this.noiseOffset = 0.0;
        this.sprite = -1;
        this.active = false;
    }

    // 寿命进度 [0, 1]。
    public double AgeRatio() {
        if (this.lifetime <= 0.0) { return 1.0; }
        return this.age / this.lifetime;
    }

    // 当前尺寸（曲线驱动）。
    public double CurrentSize() {
        if (this.sizeCurve == null) { return this.baseSize; }
        return this.sizeCurve.Evaluate(this.AgeRatio()) * this.baseSize;
    }

    // 当前颜色（起止色按寿命比例插值）。
    public int CurrentColor() {
        return Particle.LerpColor(this.colorStart, this.colorEnd, this.AgeRatio());
    }

    // ARGB 线性插值。
    public static int LerpColor(int from, int to, double t) {
        if (t < 0.0) { t = 0.0; }
        if (t > 1.0) { t = 1.0; }
        int a0 = (from >> 24) & 255;
        int r0 = (from >> 16) & 255;
        int g0 = (from >> 8) & 255;
        int b0 = from & 255;
        int a1 = (to >> 24) & 255;
        int r1 = (to >> 16) & 255;
        int g1 = (to >> 8) & 255;
        int b1 = to & 255;
        int a = a0 + (int)((a1 - a0) * t);
        int r = r0 + (int)((r1 - r0) * t);
        int g = g0 + (int)((g1 - g0) * t);
        int b = b0 + (int)((b1 - b0) * t);
        return (a << 24) | (r << 16) | (g << 8) | b;
    }
}
