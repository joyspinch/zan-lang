using System;
using System.Collections.Generic;

namespace Game.AutoChess;

// 自走棋三合一升星升级器（StarUpgrader）。
// 对应《云顶之弈》经典的“3个一星合一个二星，3个二星合一个三星”核心规则，
// 支持在拥有棋子列表中自动寻找可合成项，并支持级联连环升星（如合成 2 星后立刻触发升 3 星）。
public class StarUpgrader {
    public const int MAX_STAR = 3;

    public class UpgradeEvent {
        public string heroId;
        public int fromStar;
        public int toStar;

        public UpgradeEvent(string heroId, int fromStar, int toStar) {
            this.heroId = heroId;
            this.fromStar = fromStar;
            this.toStar = toStar;
        }
    }

    // 尝试在列表中寻找并执行三合一升星。
    // 返回本次升级的事件列表（若未发生任何升级则返回空列表）。
    public static List<UpgradeEvent> TryUpgrade(List<SynergyMatrix.ChessUnit> units) {
        List<UpgradeEvent> events = new List<UpgradeEvent>();
        if (units == null || units.Count < 3) {
            return events;
        }

        bool hasAnyUpgrade = true;
        // 循环直到无法继续触发任何三合一升星
        while (hasAnyUpgrade) {
            hasAnyUpgrade = false;

            // 按照星级从小到大 (1 -> 2) 检查
            for (int targetStar = 1; targetStar < MAX_STAR; targetStar = targetStar + 1) {
                // 寻找是否有 3 个相同 heroId 且星级为 targetStar 的棋子
                int foundIdx1 = -1;
                int foundIdx2 = -1;
                int foundIdx3 = -1;
                string upgradeHeroId = "";

                for (int i = 0; i < units.Count; i = i + 1) {
                    SynergyMatrix.ChessUnit u1 = units[i];
                    if (u1 == null || u1.star != targetStar) { continue; }

                    int count = 1;
                    int i2 = -1;
                    int i3 = -1;

                    for (int j = i + 1; j < units.Count; j = j + 1) {
                        SynergyMatrix.ChessUnit u2 = units[j];
                        if (u2 != null && u2.star == targetStar && u2.heroId == u1.heroId) {
                            if (count == 1) {
                                i2 = j;
                                count = 2;
                            } else if (count == 2) {
                                i3 = j;
                                count = 3;
                                break;
                            }
                        }
                    }

                    if (count >= 3) {
                        foundIdx1 = i;
                        foundIdx2 = i2;
                        foundIdx3 = i3;
                        upgradeHeroId = u1.heroId;
                        break;
                    }
                }

                if (foundIdx1 >= 0 && foundIdx2 >= 0 && foundIdx3 >= 0) {
                    // 升星：升级第 1 个棋子为 targetStar + 1，移除另外 2 个棋子
                    units[foundIdx1].star = targetStar + 1;
                    // 从后往前移除，防止下标错位
                    units.RemoveAt(foundIdx3);
                    units.RemoveAt(foundIdx2);

                    events.Add(new UpgradeEvent(upgradeHeroId, targetStar, targetStar + 1));
                    hasAnyUpgrade = true;
                    break; // 触发后重新扫描（支持连环级联升星）
                }
            }
        }

        return events;
    }
}
