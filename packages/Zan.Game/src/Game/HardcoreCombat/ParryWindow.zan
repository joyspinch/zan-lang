using System;

namespace Game.HardcoreCombat;

// 毫秒级招架/完美弹反判定器（ParryWindow）。
// 对应硬核动作游戏的招架弹反（如《只狼》、《艾尔登法环》战技）：
// 区分完美弹反（Parry，免疫伤害并弹开敌方）、普通格挡（Block，减免部分伤害）与直接受创（Hit）。
public class ParryWindow {
    public const int ResultHit = 0;     // 未格挡，直接全额受创
    public const int ResultBlocked = 1; // 普通格挡，承受部分减免伤害
    public const int ResultParried = 2; // 完美弹反，自身免伤并弹反攻击者

    public bool isBlocking;            // 是否处于格挡态
    public double parryWindowTimer;    // 完美弹反窗口剩余时间（秒）
    public double defaultParryWindow;  // 默认弹反窗口时长（默认 0.15s，即 150 毫秒）
    public double blockDamageReduction;// 普通格挡免伤比例（默认 0.7，即吸收 70% 伤害）

    public ParryWindow() {
        this.isBlocking = false;
        this.parryWindowTimer = 0.0;
        this.defaultParryWindow = 0.15;
        this.blockDamageReduction = 0.7;
    }

    public static ParryWindow Create() {
        return new ParryWindow();
    }

    public bool IsBlocking { get { return isBlocking; } }
    public bool IsInParryWindow { get { return isBlocking && parryWindowTimer > 0.0; } }

    // 玩家按下招架/格挡键（触发弹反窗口）
    public void StartBlock() {
        this.isBlocking = true;
        this.parryWindowTimer = defaultParryWindow;
    }

    // 玩家松开招架/格挡键
    public void StopBlock() {
        this.isBlocking = false;
        this.parryWindowTimer = 0.0;
    }

    // 时钟步进更新：弹反窗口倒计时递减
    public void Update(double dt) {
        if (isBlocking && parryWindowTimer > 0.0) {
            parryWindowTimer = parryWindowTimer - dt;
            if (parryWindowTimer < 0.0) {
                parryWindowTimer = 0.0;
            }
        }
    }

    // 受到攻击时的判定解算。
    // rawDamage: 攻击原本伤害
    // outTakenDamage: 自身最终实际承受的伤害
    // 返回招架结果标志：ResultHit / ResultBlocked / ResultParried
    public int ResolveIncomingAttack(int rawDamage, out int outTakenDamage) {
        if (!isBlocking) {
            // 未格挡：承受全额伤害
            outTakenDamage = rawDamage;
            return ResultHit;
        }

        if (parryWindowTimer > 0.0) {
            // 处于完美弹反窗口：自身承受 0 伤害，成功弹反！
            outTakenDamage = 0;
            return ResultParried;
        }

        // 普通格挡：吸收固定比例伤害
        int absorbed = (int)((double)rawDamage * blockDamageReduction);
        outTakenDamage = rawDamage - absorbed;
        if (outTakenDamage < 0) { outTakenDamage = 0; }
        return ResultBlocked;
    }
}
