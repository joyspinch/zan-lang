using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Game.Scene;

public partial class SceneDesigner {
    int canvasX; int canvasY; int canvasW; int canvasH;
    int canvasOX; int canvasOY; int canvasCW; int canvasCH; int canvasScale = 1;
    int canvasPointerX; int canvasPointerY;
    int canvasButton = -1;
    bool canvasUndo;
    bool canvasMoved;
    weak SceneElement canvasPressed;

    public bool CanvasContains(int x, int y) {
        return SceneDesigner.InRect(x, y, canvasX, canvasY, canvasW, canvasH)
            && SceneDesigner.InRect(x, y, canvasOX, canvasOY, canvasCW, canvasCH);
    }
    public void PrepareCanvas(App app, int x, int y, int w, int h) {
        int dw = this.doc.DesignWidth();
        int dh = this.doc.DesignHeight();
        if (dw <= 0) { dw = 1; }
        if (dh <= 0) { dh = 1; }
        // 设计画布上方条带中的功能区式小按钮工具栏
        // （该区域此前是空的信箱式留白）。
        int barH = this.BarH(app) + app.Scale(6);

        int inX = x + app.Scale(12);
        int inY = y + app.Scale(8) + barH;
        int inW = w - app.Scale(24);
        int inH = h - app.Scale(8) - barH - app.Scale(12);

        // 将设计画布适配到编辑器视口（信箱式预览）。
        int psNumW = inW * 1000 / dw;
        int psNumH = inH * 1000 / dh;
        int psMilli = psNumW;
        if (psNumH < psMilli) { psMilli = psNumH; }
        if (psMilli < 1) { psMilli = 1; }
        // 「适应」只算一次：算完就固化成一个缩放值，之后画布
        // 尺寸只由设计尺寸和缩放决定，不再跟着宿主窗口变大变小。
        if (this.zoom <= 0) {
            this.zoom = psMilli * 100 / app.dpiScale;
            if (this.zoom < 100) { this.zoom = 100; }
        }
        psMilli = this.zoom * app.dpiScale / 100;
        if (psMilli < 1) { psMilli = 1; }
        int cw = dw * psMilli / 1000;
        int ch = dh * psMilli / 1000;

        // 平移钳制：画布永远有一块留在视口里（画布和视口里
        // 较小的那个的一半），所以抓手怎么拖都拖不飞。
        int keepX = cw;
        if (inW < keepX) { keepX = inW; }
        keepX = keepX / 2;
        int keepY = ch;
        if (inH < keepY) { keepY = inH; }
        keepY = keepY / 2;
        int panMaxX = (inW + cw) / 2 - keepX;
        if (panMaxX < 0) { panMaxX = 0; }
        if (this.panX > panMaxX) { this.panX = panMaxX; }
        if (this.panX < 0 - panMaxX) { this.panX = 0 - panMaxX; }
        // 纵向不是居中而是顶对齐（oy = inY - panY），上下界不对称。
        int panMinY = keepY - inH;
        int panMaxY = ch - keepY;
        if (panMaxY < 0) { panMaxY = 0; }
        if (panMinY > 0) { panMinY = 0; }
        if (this.panY > panMaxY) { this.panY = panMaxY; }
        if (this.panY < panMinY) { this.panY = panMinY; }

        int ox = inX + (inW - cw) / 2 - this.panX;
        // 将场景锚定到视口顶部（紧贴
        // 工具栏下方）而非居中，避免上方留出空白带。
        int oy = inY - this.panY;

        canvasX = inX; canvasY = inY; canvasW = inW; canvasH = inH;
        canvasOX = ox; canvasOY = oy; canvasCW = cw; canvasCH = ch; canvasScale = psMilli;
    }

    public void PaintCanvas(App app, Canvas c, Theme t, int x, int y, int w, int h) {
        app.FillChrome(x, y, w, h, t.borderRadiusLarge, t.bgTertiary);
        c.DrawRect(x, y, w, h, t.borderPrimary, 1);
        int dw = (int)Math.Max(1, this.doc.DesignWidth());
        int dh = (int)Math.Max(1, this.doc.DesignHeight());
        int inX = canvasX; int inY = canvasY; int inW = canvasW; int inH = canvasH;
        int ox = canvasOX; int oy = canvasOY; int cw = canvasCW; int ch = canvasCH; int psMilli = canvasScale;
        // 设计画布背景（清除色）+ 可选背景参考图。
        // 设计视图中，很暗的清除色会被提亮到中灰色，
        // 仅限编辑时，以保证组件清晰可辨（实际
        // 场景运行时仍渲染精确的清除色）。
        int bgR = this.doc.ClearR();
        int bgG = this.doc.ClearG();
        int bgB = this.doc.ClearB();
        if (bgR + bgG + bgB < 210) {
            bgR = bgR + (110 - bgR) * 45 / 100;
            bgG = bgG + (112 - bgG) * 45 / 100;
            bgB = bgB + (122 - bgB) * 45 / 100;
        }
        // 画布可能比视口大（放大或平移后），一律裁剪到视口，
        // 否则背景和网格会画到设计器面板外面去。
        c.PushClip(inX, inY, inW, inH);
        c.FillRect(ox, oy, cw, ch, SceneDesigner.PackColor(bgR, bgG, bgB, 255));
        c.DrawRect(ox, oy, cw, ch, t.borderSecondary, 1);
        if (this.doc.Background().Length > 0) {
            Style.Of(app, "label", "small", Style.SNormal()).DrawText(
                app.canvas,
                ox + app.Scale(6), oy + app.Scale(6), "bg: " + this.doc.Background(),
                app.theme.textPrimary, app.theme.fontSizeMedium);
        }

        // 网格叠加层：每个网格单元一条线（吸附单位）。当
        // 预览缩小到单元几乎塌缩（屏幕上 < ~6px）时，
        // 每隔 2/4…… 条线绘制一条，保持可读性。
        if (this.showGrid && this.grid > 0) {
            int gstep = this.grid;
            while (gstep * psMilli / 1000 < app.Scale(6)) { gstep = gstep * 2; }
            int gx = 0;
            while (gx <= dw) {
                int sx = ox + gx * psMilli / 1000;
                c.FillRect(sx, oy, 1, ch, t.borderSecondary);
                gx = gx + gstep;
            }
            int gy = 0;
            while (gy <= dh) {
                int sy = oy + gy * psMilli / 1000;
                c.FillRect(ox, sy, cw, 1, t.borderSecondary);
                gy = gy + gstep;
            }
        }

        // 元素从后到前绘制（z 小者先），命中测试从前往后。
        // 层过滤：只画当前编辑层；其它层在 Ghost 开启时画成
        // 半透明（单独一遍、不参与命中），关闭时完全不画。
        // 幽灵透明用每元素 Tint 的 alpha 通道近似（DrawElement
        // 的填充都吃 e.A()），不改全局合成器。
        List<SceneElement> ordered = this.OrderedByZ();
        if (this.showGhost && this.editLayer.Length > 0) {
            c.PushClip(ox, oy, cw, ch);
            for (int i = 0; i < ordered.Count; i = i + 1) {
                SceneElement e = ordered[i];
                if (this.InEditLayer(e)) { continue; }
                int ex = ox + this.DesignLeft(e) * psMilli / 1000;
                int ey = oy + this.DesignTop(e) * psMilli / 1000;
                int exw = e.TotalW() * psMilli / 1000;
                int exh = e.TotalH() * psMilli / 1000;
                SceneElement ghost = new SceneElement(e.Kind(), "");
                ghost.At(e.X(), e.Y()).Size(e.W(), e.H());
                ghost.Caption(e.Text()).Image(e.ImageId());
                ghost.Tint(e.R(), e.G(), e.B(), e.A() * 28 / 100);
                ghost.Grid(e.Rows(), e.Cols(), e.GapX(), e.GapY());
                ghost.SetValue(e.Value()).SetItems(e.Items());
                SceneView.DrawElement(app, c, t, ghost, ex, ey, exw, exh, psMilli);
            }
            c.PopClip();
        }
        c.PushClip(ox, oy, cw, ch);
        for (int i = 0; i < ordered.Count; i = i + 1) {
            SceneElement e = ordered[i];
            if (!this.InEditLayer(e)) { continue; }
            int ex = ox + this.DesignLeft(e) * psMilli / 1000;
            int ey = oy + this.DesignTop(e) * psMilli / 1000;
            int exw = e.TotalW() * psMilli / 1000;
            int exh = e.TotalH() * psMilli / 1000;
            SceneView.DrawElement(app, c, t, e, ex, ey, exw, exh, psMilli);
            // 设计期辅助：每个元素周围的双色描边（深色内圈 + 浅色
            // 外圈），使组件在任意画布背景上都清晰可见
            // 。
            if (e != this.sel) {
                c.DrawRect(ex + 1, ey + 1, exw - 2, exh - 2,
                    SceneDesigner.PackColor(10, 12, 20, 255), 1);
                c.DrawRect(ex, ey, exw, exh,
                    SceneDesigner.PackColor(150, 168, 210, 255), 1);
            }
            if (e == this.sel) {
                c.DrawRect(ex - 1, ey - 1, exw + 2, exh + 2, t.primary, 1);
                c.DrawRect(ex - 2, ey - 2, exw + 4, exh + 4, t.primary, 1);
                if (!e.Locked()) {
                    // 八个缩放手柄（角 + 边中点）
                    int hs = app.Scale(8);
                    int hh2 = hs / 2;
                    for (int hnum = 0; hnum < 8; hnum = hnum + 1) {
                        int hx = SceneDesigner.HandleX(hnum, ex, exw) - hh2;
                        int hy = SceneDesigner.HandleY(hnum, ey, exh) - hh2;
                        c.FillRect(hx, hy, hs, hs, t.primary);
                    }
                }
            } else if (this.IsExtraSel(e)) {
                // 多选的其余成员：同色描边 + 四角实心块，
                // 只是不带缩放手柄（手柄跟着主选中项），
                // 一眼能看出它们同样在选中集里。
                c.DrawRect(ex - 1, ey - 1, exw + 2, exh + 2, t.primary, 1);
                c.DrawRect(ex - 2, ey - 2, exw + 4, exh + 4, t.primary, 1);
                int cs = app.Scale(6);
                c.FillRect(ex - 1, ey - 1, cs, cs, t.primary);
                c.FillRect(ex + exw + 1 - cs, ey - 1, cs, cs, t.primary);
                c.FillRect(ex - 1, ey + exh + 1 - cs, cs, cs, t.primary);
                c.FillRect(ex + exw + 1 - cs, ey + exh + 1 - cs, cs, cs, t.primary);
            }
            // 锁定标记独立于选中状态绘制，锁上的元素
            // 一直看得见自己被锁着（选中时也不会被手柄顶掉）。
            if (e.Locked()) {
                int lsz = t.iconSizeSmall;
                int lpad = app.Scale(3);
                c.FillRoundRect(ex + lpad, ey + lpad, lsz + lpad * 2, lsz + lpad * 2,
                    app.Scale(3), SceneDesigner.PackColor(24, 30, 52, 235));
                c.DrawGlyphIn("lock", ex + lpad * 2, ey + lpad * 2, lsz, lsz, lsz,
                    t.warning);
            }
            if (this.showTags) {
                // 小型标识徽标，使外观相同的元素
                // 一眼即可区分。
                // 徽标位于元素左上角内部，不会
                // 遮住缩放手柄或上方的相邻元素；过小的
                // 元素完全跳过徽标。
                string tag = SceneDesigner.KindLabel(e.Kind());
                if (e.Name().Length > 0) { tag = tag + " · " + e.Name(); }
                int tgw = Canvas.MeasureText(tag, t.fontSizeTiny) + app.Scale(8);
                int tgh = Canvas.FontHeight(t.fontSizeTiny) + app.Scale(4);
                if (tgh + app.Scale(6) <= exh && tgw + app.Scale(6) <= exw) {
                    int tgx = ex + app.Scale(3);
                    int tgy = ey + app.Scale(3);
                    c.FillRoundRect(tgx, tgy, tgw, tgh, app.Scale(3),
                        SceneDesigner.PackColor(24, 30, 52, 235));
                    c.DrawRect(tgx, tgy, tgw, tgh,
                        SceneDesigner.PackColor(90, 120, 190, 160), 1);
                    c.DrawText(tgx + app.Scale(4), tgy + app.Scale(2), tag,
                        SceneDesigner.PackColor(225, 235, 255, 255), t.fontSizeTiny);
                }
            }
        }
        c.PopClip();
        c.PopClip();

        // 在整个画布上绘制当前激活的智能参考线。
        if (this.guideX >= 0) {
            int gsx = ox + this.guideX * psMilli / 1000;
            c.FillRect(gsx, oy, 1, ch, SceneDesigner.PackColor(255, 80, 200, 220));
        }
        if (this.guideY >= 0) {
            int gsy = oy + this.guideY * psMilli / 1000;
            c.FillRect(ox, gsy, cw, 1, SceneDesigner.PackColor(255, 80, 200, 220));
        }

        if (this.marquee) {
            int rx = (int)Math.Min(this.mqSX, canvasPointerX);
            int ry = (int)Math.Min(this.mqSY, canvasPointerY);
            int rw = (int)Math.Abs(canvasPointerX - this.mqSX);
            int rh = (int)Math.Abs(canvasPointerY - this.mqSY);
            c.FillRect(rx, ry, rw, rh, SceneDesigner.PackColor(80, 130, 220, 40));
            c.DrawRect(rx, ry, rw, rh, t.primary, 1);
        }
    }
    // 缩放手柄 hnum 的屏幕空间 X 坐标（0=TL 1=T 2=TR 3=R 4=BR 5=B 6=BL 7=L；ex/exw 为元素屏幕矩形）。
    public static int HandleX(int hnum, int ex, int exw) {
        if (hnum == 0 || hnum == 6 || hnum == 7) { return ex; }
        if (hnum == 1 || hnum == 5) { return ex + exw / 2; }
        return ex + exw;
    }
    // 缩放手柄 hnum 的屏幕空间 Y 坐标（编号同 HandleX；ey/exh 为元素屏幕矩形）。
    public static int HandleY(int hnum, int ey, int exh) {
        if (hnum == 0 || hnum == 1 || hnum == 2) { return ey; }
        if (hnum == 3 || hnum == 7) { return ey + exh / 2; }
        return ey + exh;
    }

    // 将提议的设计空间 left 吸附到邻近元素或画布中心的对齐线上（容差 6 设计像素，自身 left/centre/right 三种候选）。返回吸附后的值；若无任何线在范围内则返回 -100000；匹配的参考线记录到 guideX 供绘制。
    public int SnapAxisX(int left, int tw) {
        int thr = 6;
        int best = 0 - 100000;
        int bestD = thr + 1;
        List<int> lines = new List<int>();
        lines.Add(this.doc.DesignWidth() / 2);
        for (int i = 0; i < this.doc.Count(); i = i + 1) {
            SceneElement e = this.doc.ElementAt(i);
            if (e != this.sel) {
                int l = this.DesignLeft(e);
                lines.Add(l);
                lines.Add(l + e.TotalW() / 2);
                lines.Add(l + e.TotalW());
            }
        }
        for (int j = 0; j < lines.Count; j = j + 1) {
            int ln = lines[j];
            // 候选位置：自身的 left、centre 或 right 落在线
            for (int k = 0; k < 3; k = k + 1) {
                int cand = ln;
                if (k == 1) { cand = ln - tw / 2; }
                if (k == 2) { cand = ln - tw; }
                int d = left - cand;
                if (d < 0) { d = 0 - d; }
                if (d <= thr && d < bestD) { bestD = d; best = cand; this.guideX = ln; }
            }
        }
        if (best == 0 - 100000) { this.guideX = 0 - 1; }
        return best;
    }
    // 垂直方向的智能吸附（逻辑同 SnapAxisX），匹配的参考线记录到 guideY。
    public int SnapAxisY(int top, int th) {
        int thr = 6;
        int best = 0 - 100000;
        int bestD = thr + 1;
        List<int> lines = new List<int>();
        lines.Add(this.doc.DesignHeight() / 2);
        for (int i = 0; i < this.doc.Count(); i = i + 1) {
            SceneElement e = this.doc.ElementAt(i);
            if (e != this.sel) {
                int tp = this.DesignTop(e);
                lines.Add(tp);
                lines.Add(tp + e.TotalH() / 2);
                lines.Add(tp + e.TotalH());
            }
        }
        for (int j = 0; j < lines.Count; j = j + 1) {
            int ln = lines[j];
            for (int k = 0; k < 3; k = k + 1) {
                int cand = ln;
                if (k == 1) { cand = ln - th / 2; }
                if (k == 2) { cand = ln - th; }
                int d = top - cand;
                if (d < 0) { d = 0 - d; }
                if (d <= thr && d < bestD) { bestD = d; best = cand; this.guideY = ln; }
            }
        }
        if (best == 0 - 100000) { this.guideY = 0 - 1; }
        return best;
    }

    // 当设计器自身的某个文本输入框持有键盘焦点时返回 true（宿主据此让出快捷键）。
    public bool AnyInputFocused(App app) {
        if (this.InspectorInputFocused(app)) { return true; }
        if (app.focus.IsFocused(this.inpIdName)) { return true; }
        if (app.focus.IsFocused(this.inpIdImg)) { return true; }
        if (app.focus.IsFocused(this.inpIdText)) { return true; }
        if (app.focus.IsFocused(this.inpIdBg)) { return true; }
        if (app.focus.IsFocused(this.inpIdItems)) { return true; }
        if (app.focus.IsFocused(this.inpIdTitle)) { return true; }
        if (app.focus.IsFocused(this.inpIdClick)) { return true; }
        if (app.focus.IsFocused(this.inpIdClass)) { return true; }
        if (app.focus.IsFocused(this.inpIdColor)) { return true; }
        return false;
    }

    // 文档元素的 z 顺序副本（按 Z 升序稳定插入排序，元素数少）。
    public List<SceneElement> OrderedByZ() {
        List<SceneElement> o = new List<SceneElement>();
        for (int i = 0; i < this.doc.Count(); i = i + 1) {
            o.Add(this.doc.ElementAt(i));
        }
        // 按 z 插入排序（稳定，n 小）
        int a = 1;
        while (a < o.Count) {
            SceneElement key = o[a];
            int b = a - 1;
            while (b >= 0 && o[b].Z() > key.Z()) {
                o[b + 1] = o[b];
                b = b - 1;
            }
            o[b + 1] = key;
            a = a + 1;
        }
        return o;
    }

}
