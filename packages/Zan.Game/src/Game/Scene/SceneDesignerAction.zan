using System;
using Gui;
using Gui.Widget;

namespace Game.Scene;

// Every retained callback borrows the designer. Queued old popup actions expire
// with their originating menu; they never keep the document owner alive.
public class SceneDesignerAction {
    public weak SceneDesigner owner;
    public weak ContextMenu menu;
    public string name;
    public string value;
    public int index;
    public int generation;
    public int popupGeneration;

    public SceneDesignerAction(SceneDesigner owner, string name) {
        this.owner = owner; this.name = name; this.generation = owner.InputGeneration();
    }
    public void Run() {
        SceneDesigner d = owner;
        if (d == null || generation != d.InputGeneration() || !d.InputVisible()) { return; }
        if (name == "ribbon") { d.RunBarCommand(d.RetainedRibbon().lastAct); }
        else if (name == "resource") {
            if (!d.ResourceActionCurrent(popupGeneration)) { return; }
            d.ResourcePicked();
        }
        else if (name == "context") {
            if (!d.PopupActionCurrent(menu, false)) { return; }
            d.ApplyContextAction(index, value);
        }
        else if (name == "layer") {
            if (!d.PopupActionCurrent(menu, true)) { return; }
            d.ChooseLayer(value, index == 1);
        }
        else if (name == "fold") { d.PalToggleFold(value); d.RefreshPalette(); }
        d.RequestViewRedraw();
    }
}
