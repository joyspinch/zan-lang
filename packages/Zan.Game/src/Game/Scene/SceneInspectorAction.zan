using Gui;
using Gui.Widget;

namespace Game.Scene;

// Controls own their handlers; the handler must never retain the designer.
public class SceneInspectorAction {
    public weak SceneDesigner owner;
    public string key;
    public int kind;
    public int value;

    public SceneInspectorAction(SceneDesigner designer, string field, int actionKind, int arg) {
        owner = designer;
        key = field;
        kind = actionKind;
        value = arg;
    }

    public void Invoke(Control sender) {
        SceneDesigner d = owner;
        if (d == null || d.inspectorSyncing) { return; }
        if (kind == 0) { d.CommitInspectorText(key); }
        if (kind == 1 && sender is InputNumber) {
            InputNumber number = (InputNumber)sender;
            d.CommitInspectorNumber(key, number.Value());
        }
        if (kind == 2) { d.RunInspectorAction(key, value); }
        if (kind == 3) { d.CommitInspectorColor(); }
        App app = sender.App;
        if (app != null) { app.RequestRedraw(); }
    }
}
