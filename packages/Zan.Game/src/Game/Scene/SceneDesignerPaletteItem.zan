using System;
using Gui;
using Gui.Widget;

namespace Game.Scene;

// A standard Button tree with a routed drag capability, never a painted hit row.
public class SceneDesignerPaletteItem : Button {
    public weak SceneDesigner owner;
    public string elementKind;
    public SceneDesignerPaletteItem(SceneDesigner owner, string kind) : base() {
        this.owner = owner; elementKind = kind;
        this.Class = "ghost small row align-center";
        this.Prefer(0, 24);
        this.Add(new IconView(SceneDesigner.KindIcon(kind), 16));
        this.Add(new Label(SceneDesigner.KindLabel(kind)));
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        SceneDesigner d = owner; App app = this.FindApp();
        if (d != null && app != null && !e.handled && !this.IsDisabled()) { d.PaletteDown(app, this, e); }
    }
    public override void OnPointerMove(RoutedEventArgs e) {
        SceneDesigner d = owner; App app = this.FindApp();
        if (d != null && app != null && !e.handled) { d.PaletteMove(app, this, e); }
    }
    public override void OnPointerUp(RoutedEventArgs e) {
        SceneDesigner d = owner; App app = this.FindApp();
        if (d != null && app != null && !e.handled) { d.PaletteUp(app, this, e); }
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        SceneDesigner d = owner;
        if (d != null) { d.CancelPaletteGesture(); }
    }
    public override void OnClick(RoutedEventArgs e) { e.Handle(); }
}
