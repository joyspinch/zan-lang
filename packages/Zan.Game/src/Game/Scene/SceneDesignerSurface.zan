using System;
using Gui;
using Gui.Widget;

namespace Game.Scene;

// Only the design surface is custom painted; its toolbar remains a standard tree.
public class SceneDesignerSurface : Control {
    public weak SceneDesigner owner;
    public Ribbon ribbon;

    public SceneDesignerSurface(SceneDesigner owner, Ribbon ribbon) {
        this.InitControl("scene_designer_surface");
        this.owner = owner; this.ribbon = ribbon;
        this.Add(ribbon);
    }
    public override string Kind() { return "SceneDesignerSurface"; }
    public override int InputFocusCapabilities() { return 1; }
    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = (int)Math.Max(0, w); bh = (int)Math.Max(0, h);
        App app = this.FindApp(); SceneDesigner d = owner;
        if (app == null || d == null) { return; }
        ribbon.Arrange(x + app.Scale(12), y + app.Scale(8),
            (int)Math.Max(0, w - app.Scale(24)), d.BarH(app));
        d.PrepareCanvas(app, bx, by, bw, bh);
    }
    public override void OnPaint(App app) {
        SceneDesigner d = owner;
        if (d != null) { d.PaintCanvas(app, app.canvas, app.theme, bx, by, bw, bh); }
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        SceneDesigner d = owner; App app = this.FindApp();
        if (d == null || app == null || e.handled || e.originalSource != this || this.IsDisabled()) { return; }
        d.CanvasDown(app, this, e);
    }
    public override void OnPointerMove(RoutedEventArgs e) {
        SceneDesigner d = owner; App app = this.FindApp();
        if (d != null && app != null && !e.handled) { d.CanvasMove(app, this, e); }
    }
    public override void OnPointerUp(RoutedEventArgs e) {
        SceneDesigner d = owner; App app = this.FindApp();
        if (d != null && app != null && !e.handled) { d.CanvasUp(app, this, e); }
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        SceneDesigner d = owner;
        if (d != null) { d.CancelCanvasGesture(); }
    }
    public override void OnClick(RoutedEventArgs e) {
        SceneDesigner d = owner;
        if (d != null && !e.handled && e.originalSource == this) { d.CanvasClick(e); }
    }
    public override void OnWheel(RoutedEventArgs e) {
        SceneDesigner d = owner; App app = this.FindApp();
        if (d != null && app != null && !e.handled) { d.CanvasWheel(app, e); }
    }
    public override void OnKeyDown(RoutedEventArgs e) {
        SceneDesigner d = owner; App app = this.FindApp();
        if (d != null && app != null && !e.handled) { d.CanvasKey(app, e, false); }
    }
    public override void OnTextInput(RoutedEventArgs e) {
        SceneDesigner d = owner; App app = this.FindApp();
        if (d != null && app != null && !e.handled) { d.CanvasKey(app, e, true); }
    }
}
