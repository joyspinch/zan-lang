using System;
using System.Globalization;
using System.Collections.Generic;
using System.IO;
using Gui;
using Gui.Component;
// 检查器行的输入框用的是裸 `new Input(...)`——该类型在 Gui.Widget
// 命名空间里，必须显式 import；不写就靠 binder 的全局唯一简单名
// 兜底，用户项目一旦定义同名全局类就会编译报错。
using Gui.Widget;
using Gui.Backend;

namespace Game.Scene;

// `.html` 游戏窗口/场景文档的可视化编辑器，由
// Zan IDE 承载，方式与 Gui.Designer 承载窗口设计稿相同。与表单设计器
// （面向工具的停靠/锚点/流式布局）不同，这是自由画布：元素按
// 设计空间绝对坐标放置，可选背景
// 参考图，并相对于九宫格锚点定位，使 HUD 在不同
// 分辨率下保持布局。游戏 UI 位于一个主窗口内，因此
// 整个场景是单一画布而非多个子窗口。
// // 面板：游戏控件（标签、按钮、图片/动画框、进度条、
// 以行 x 列网格组出现的格子族、头像、复选框、选项卡、容器、
// 小地图、滑块、滚动条、下拉框、输入框、列表框）以及绘制
// 组件（文本、美术文本、精灵、矩形、圆形、动画）。拖动移动，
// 拖角落手柄缩放，吸附网格，在
// 检查器中编辑属性、调整 z 顺序、复制，然后保存写出标准 HTML 设计稿。
public partial class SceneDesigner {
    // UI 语言码（"zh" / "en"）；IDE 根据其界面语言设置。
    public static string lang = "zh";
    // 项目的资源目录；IDE 设置它，使检查器的资源选择器能浏览打包文件。"" = 未打开项目。
    // 项目的资源目录；IDE 设置它，使检查器的
    // 资源选择器能浏览打包文件。"" = 未打开项目。
    public static string assetsDir;

    // 正在编辑的场景文档（设计器的数据源与保存目标）。
    public SceneDoc doc;
    // 当前主选中元素；null 表示无选中。
    public SceneElement sel;
    // 上一次的主选中元素，用于检测选中变化以同步检查器。
    public SceneElement lastSel;
    // 宿主（IDE）把元素面板和属性面板挂在自己的 dock 里时置位：设计器本体只留功能区 + 画布。
    // 宿主（IDE）把元素面板和属性面板挂在自己的 dock 里时置位：
    // 设计器本体只留功能区 + 画布。
    public bool hostPanels;

    // 交互状态标记：正在拖动元素（resizing 为正在缩放）。
    public bool dragging;
    public bool resizing;
    // 当前缩放手柄 0-7（TL、T、TR、R、BR、B、BL、L）。
    public int resizeH;         // 当前缩放手柄 0-7（TL、T、TR、R、BR、B、BL、L）
    // 正在从面板拖出的元素种类（"" = 无）。
    public string palDrag;      // 正在从面板拖出的元素种类（"" = 无）
    // 面板按下后已移出芯片（真正的拖拽）。
    public bool palMoved;       // 面板按下后已移出芯片（真正的拖拽）
    // 元素左上角到光标的拖拽偏移（设计空间），dx/dy 为水平/垂直分量。
    public int dragDx;          // 元素左上角到光标的拖拽偏移（设计空间）
    public int dragDy;
    // 设计空间中的智能参考线位置（-1 = 无）：guideX 为垂直线，guideY 为水平线。
    public int guideX;          // 设计空间中的垂直智能参考线（-1 = 无）
    public int guideY;          // 设计空间中的水平智能参考线（-1 = 无）
    // 检查器输入控件 id（其中一个获得焦点时键盘被忽略）。
    public int inpIdName;       // 检查器输入控件 id（其中一个获得焦点时
    public int inpIdImg;        // 键盘被忽略）
    public int inpIdText;
    public int inpIdBg;
    public int inpIdItems;
    public int inpIdLayer;
    public int inpIdTitle;
    public int inpIdClick;
    // 额外的多选元素（Ctrl+点击 / 框选），不含主选中。
    public List<SceneElement> selExtra;  // 额外的多选元素（Ctrl+点击 / 框选）
    // 双击场景元素跳转 code-behind 源码请求
    public string openCodeBehindElement;
    public bool openCodeBehindRequested;
    // 正在进行的橡皮筋框选拖拽；mqSX/mqSY 为框选起点（屏幕空间）。
    public bool marquee;        // 正在进行的橡皮筋框选拖拽
    public int mqSX;            // 框选起点（屏幕空间）
    public int mqSY;
    // 在元素上绘制种类/名称徽标。
    public bool showTags;       // 在元素上绘制种类/名称徽标
    // 画布缩放千分比；0 = 适应视口（首次渲染后固化为具体值）。
    public int zoom;            // 画布缩放千分比；0 = 适应视口
    // 画布平移（屏幕像素，右/下为正，渲染时钳制保画布可见）。
    public int panX;            // 画布平移（屏幕像素，右为正）
    public int panY;
    // 抓手模式：左键拖动即平移画布（panning 为拖拽进行中，panSX/panSY 为按下位置，panOX/panOY 为按下时平移量）。
    public bool hand;           // 抓手模式：左键拖动即平移画布
    public bool panning;        // 正在用抓手拖动画布
    public int panSX;           // 抓手按下位置与按下时的平移量
    public int panSY;
    public int panOX;
    public int panOY;
    // 折叠起来的面板分组标题列表。
    public List<string> palFolded;  // 折叠起来的面板分组标题
    // 面板内部滚动偏移（像素，0 = 顶部）。
    public int palScroll;           // 面板内部滚动偏移（像素）
    // 撤销/重做历史：整份文档的 JSON 快照。
    public List<string> undoStack;  // 文档 JSON 快照（撤销历史）
    public List<string> redoStack;
    // 复制的元素（单元素场景 JSON，粘贴时重新解析）。
    public string clipJson;     // 复制的元素（单元素场景 JSON）
    // 资源选择弹窗：0 关闭，1 图片，2 背景。
    public int resPick;         // 资源选择弹窗：0 关闭，1 图片，2 背景
    // 资源选择列表：绑定到文件名，拥有其选中项。
    public ListView<string> resList;
    public bool ctxOpen;        // 画布右键上下文菜单
    public int ctxX;
    public int ctxY;
    public int ctxHover;
    public bool showGrid;
    public bool snap;
    public int grid;            // 网格尺寸（设计像素）
    public string msg;

    // ---- 层编辑（弹窗/菜单页） -------------------------------------
    // layer 为空 = 基础层，永远渲染；命名层在文档里是元素的
    // 归属标签，在编辑器里通过 editLayer 决定"正在编辑哪一层"：
    // 其它层的元素画成半透明幽灵，不参与命中。
    // 正在编辑的层名；"" = 基础层（永远渲染）。其它层元素以幽灵显示且不参与命中。
    public string editLayer;        // "" = 基础层
    // 层下拉菜单展开状态。
    public bool layerMenuOpen;      // 层下拉菜单展开状态
    // 非编辑层幽灵显示开关。
    public bool showGhost;          // 非编辑层幽灵显示开关
    // 检查器"层"行输入框。
    public Input layerIn;           // 检查器"层"行输入框

    // 文档里出现过的层名列表（保持首次出现顺序；"" 不含）。
    public List<string> DocLayers() {
        List<string> ls = new List<string>();
        for (int i = 0; i < this.doc.Count(); i = i + 1) {
            string ly = this.doc.ElementAt(i).Layer();
            if (ly.Length == 0) { continue; }
            bool has = false;
            for (int k = 0; k < ls.Count; k = k + 1) {
                if (ls[k] == ly) { has = true; break; }
            }
            if (!has) { ls.Add(ly); }
        }
        return ls;
    }

    // 选中指定元素为当前主选中，并清空额外选中；同步检查器状态。
    public void Select(SceneElement e) {
        this.sel = e;
        this.selExtra = new List<SceneElement>();
        if (e != null) {
            this.nameIn.SetText(e.Name());
            this.imgIn.SetText(e.ImageId());
            this.textIn.SetText(e.Text());
            this.itemsIn.SetText(e.Items());
            this.layerIn.SetText(e.Layer());
            this.clickIn.SetText(e.OnAction("Click"));
            this.classIn.SetText(e.CssClass());
            this.colorIn.SetText(SceneDesigner.RgbaToHex(e.R(), e.G(), e.B()));
        }
        this.lastSel = e;
    }

    // e 是否属于当前编辑层（基础层元素只在编辑基础层时可见可点）。
    public bool InEditLayer(SceneElement e) {
        return e.Layer() == this.editLayer;
    }

    // 检查器各字段输入框：名称 / 图片 / 文本 / 背景 / 选项 / 窗口标题 / 点击动作 / 样式类 / 颜色。
    public Input nameIn;
    public Input imgIn;
    public Input textIn;
    public Input bgIn;
    public Input itemsIn;
    public Input titleIn;
    public Input clickIn;
    public Input classIn;
    public int inpIdClass;
    public Input colorIn;
    public int inpIdColor;
    // 颜色行的真取色器（Gui.Widget.ColorPicker）：色块是它的触发条，
    // 点开是 SV/色相面板。跨帧持有——弹层的展开态与拖动状态都在
    // 控件里，每帧新建会把弹层吃掉。
    public ColorPicker colorPick;
    // 取色器上一次的模型值：变了就写回文本框（靠值轮询发现拖动，
    // 不用事件——弹层在覆盖阶段绘制，事件要等下一帧）。
    public int colorPickVal;
    // 文本框上一次的取值：区分"用户改了文本"与"我们写回的文本"——
    // 两条同步路径共用一个值，没有影子值就会互相顶掉（用户刚挑的色
    // 被上一帧的旧文本顶回去）。
    public string colorTextShadow;

    public static string HexByte(int b) {
        if (b < 0) { b = 0; }
        if (b > 255) { b = 255; }
        string hexDigits = "0123456789abcdef";
        int h = b / 16;
        int l = b % 16;
        return hexDigits.Substring(h, 1) + hexDigits.Substring(l, 1);
    }

    public static string RgbaToHex(int r, int g, int b) {
        return "#" + SceneDesigner.HexByte(r) + SceneDesigner.HexByte(g) + SceneDesigner.HexByte(b);
    }

    public static string NextPresetHex(string cur) {
        if (cur == null || cur == "") { return "#1890ff"; }
        string c = cur.Trim().ToLower();
        if (c == "#1890ff") { return "#52c41a"; }
        if (c == "#52c41a") { return "#faad14"; }
        if (c == "#faad14") { return "#f5222d"; }
        if (c == "#f5222d") { return "#722ed1"; }
        if (c == "#722ed1") { return "#13c2c2"; }
        if (c == "#13c2c2") { return "#000000"; }
        if (c == "#000000") { return "#ffffff"; }
        if (c == "#ffffff") { return "#8c8c8c"; }
        return "#1890ff";
    }
    // 选取当前界面语言对应的字符串：键式查找（System.Globalization.Lang），
    // 英文原文作键、内置中文为缺省串；语言包未加载时回退缺省串。
    public static string T(string en, string zh) {
        return Lang.Tr(en, zh);
    }

    // 上一次 LoadJson 是否失败（文档损坏被拒绝）。宿主据此额外提示；设计器状态栏的 msg 也带原因。
    public bool loadError;

    // 选中的资源写入选择器为之打开的字段；
    // 第一行表示"无资源"。
    public void ResourcePicked() {
        if (this.resList == null) { return; }
        if (!this.resList.HasSelection()) { return; }
        string val = this.resList.Selected();
        if (this.resList.SelectedIndex() == 0) { val = ""; }
        if (this.resPick == 1) {
            this.imgIn.SetText(val);
            this.CommitInspectorText("image");
        } else {
            this.bgIn.SetText(val);
            this.CommitInspectorText("background");
        }
        this.resPick = 0;
        this.resList.ClearSelection();
    }

    // 构造设计器：新建 1280x720 的空白场景文档，网格 8px、显示网格并吸附，编辑基础层。
    public SceneDesigner() {
        this.doc = new SceneDoc("scene", 1280, 720);
        this.loadError = false;
        this.sel = null;
        this.lastSel = null;
        this.dragging = false;
        this.resizing = false;
        this.resizeH = 4;
        this.palDrag = "";
        this.palMoved = false;
        this.dragDx = 0;
        this.dragDy = 0;
        this.zoom = 0;
        this.panX = 0;
        this.panY = 0;
        this.hand = false;
        this.panning = false;
        this.panSX = 0;
        this.panSY = 0;
        this.panOX = 0;
        this.panOY = 0;
        this.palFolded = new List<string>();
        this.palScroll = 0;
        this.guideX = 0 - 1;
        this.guideY = 0 - 1;
        this.inpIdName = 0 - 1;
        this.inpIdImg = 0 - 1;
        this.inpIdText = 0 - 1;
        this.inpIdBg = 0 - 1;
        this.inpIdItems = 0 - 1;
        this.inpIdTitle = 0 - 1;
        this.inpIdClick = 0 - 1;
        this.selExtra = new List<SceneElement>();
        this.marquee = false;
        this.mqSX = 0;
        this.mqSY = 0;
        this.showTags = true;
        this.undoStack = new List<string>();
        this.redoStack = new List<string>();
        this.clipJson = "";
        this.resPick = 0;
        this.ctxOpen = false;
        this.ctxX = 0;
        this.ctxY = 0;
        this.ctxHover = 0 - 1;
        this.showGrid = true;
        this.snap = true;
        this.grid = 8;
        this.msg = "";
        this.editLayer = "";
        this.layerMenuOpen = false;
        this.showGhost = true;
        this.layerIn = new Input("(base)");
        this.nameIn = new Input("name");
        this.imgIn = new Input("image / resource id");
        this.textIn = new Input("text");
        this.bgIn = new Input("background image");
        this.itemsIn = new Input("a;b;c");
        this.titleIn = new Input("(scene name)");
        this.clickIn = new Input("ShowLayer:bag / OnBuy");
        this.classIn = new Input("game-btn gold-border");
        this.colorIn = new Input("#ffffff");
    }

    // 从 JSON 装载场景文档：解析失败时保持空白文档并置 loadError（原因见 SceneDoc.LastError）；成功与否都会清空选中、撤销历史与编辑层。
    public void LoadJson(string json) {
        SceneDoc d = new SceneDoc("", 1280, 720);
        // 拒绝损坏/截断的文档：宽松解析会把坏设计稿静默降级成
        // 半份文档，下一次编辑就把它覆盖回盘，比打开失败糟糕得多。
        // 失败原因留在 SceneDoc.LastError() 供宿主（IDE）展示。
        this.loadError = false;
        if (SceneDoc.TryParse(json, d)) {
            this.doc = d;
            this.msg = "loaded";
        } else {
            this.doc = new SceneDoc("", 1280, 720);
            this.loadError = true;
            this.msg = SceneDesigner.T("load failed: ", "加载失败：")
                + SceneDoc.LastError();
        }
        this.sel = null;
        this.lastSel = null;
        this.selExtra = new List<SceneElement>();
        this.ctxOpen = false;
        this.editLayer = "";
        this.layerMenuOpen = false;
        this.undoStack = new List<string>();
        this.redoStack = new List<string>();
        this.bgIn.SetText(this.doc.Background());
        this.titleIn.SetText(this.doc.WinTitle());
    }

    // 将当前文档序列化为标准 HTML 场景设计稿字符串（保存时由宿主写盘）。
    public string SaveHtml() {
        return this.doc.ToHtml();
    }

    // --- 撤销 / 重做（整份文档 JSON 快照） ---------------------

    // 记录当前文档；在任何修改前调用。快照栈上限 60 条（超出丢最旧），并清空重做栈。
    public void PushUndo() {
        this.undoStack.Add(this.doc.ToJson());
        if (this.undoStack.Count > 60) { this.undoStack.RemoveAt(0); }
        this.redoStack = new List<string>();
    }

    // 撤销：恢复上一个快照；无历史时仅在状态栏提示，不改文档。撤销会清空选中。
    public void Undo() {
        if (this.undoStack.Count == 0) {
            this.msg = SceneDesigner.T("nothing to undo", "没有可撤销的操作");
            return;
        }
        this.redoStack.Add(this.doc.ToJson());
        string j = this.undoStack[this.undoStack.Count - 1];
        this.undoStack.RemoveAt(this.undoStack.Count - 1);
        this.doc = SceneDoc.Parse(j);
        this.sel = null;
        this.selExtra = new List<SceneElement>();
        this.msg = SceneDesigner.T("undone", "已撤销");
    }

    // 重做：恢复被撤销前的状态；无可重做时仅在状态栏提示。会清空选中。
    public void Redo() {
        if (this.redoStack.Count == 0) {
            this.msg = SceneDesigner.T("nothing to redo", "没有可重做的操作");
            return;
        }
        this.undoStack.Add(this.doc.ToJson());
        string j = this.redoStack[this.redoStack.Count - 1];
        this.redoStack.RemoveAt(this.redoStack.Count - 1);
        this.doc = SceneDoc.Parse(j);
        this.sel = null;
        this.selExtra = new List<SceneElement>();
        this.msg = SceneDesigner.T("redone", "已重做");
    }

