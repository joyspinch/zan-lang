using System;
using Gui;

namespace Game.Scene;

// The designer owns this region and its tree; the shared loop and input chain borrow it.
public class SceneDesignerRegion : UiViewOwner {
    public weak SceneDesigner owner;
    public Control root;
    public string name;
    public UiViewScope scope;
    public ControlInputHost input;
    public weak App app;
    public Rect bounds;
    int generation;

    public SceneDesignerRegion(SceneDesigner owner, string name, Control root) {
        this.owner = owner; this.name = name; this.root = root;
    }

    public void InitializeInput(App host) {
        if (host == null || !host.isRunning) { return; }
        if (app == host && scope != null && scope.IsActive()) { return; }
        int previous = generation;
        this.Hide();
        if (generation != previous + 1 || app != null) { return; }
        app = host;
        root.Visible = false;
        scope = new UiViewScope(host, this, root);
        input = new ControlInputHost(root);
        input.Bind(host);
    }

    public void SetBounds(App host, int x, int y, int w, int h) {
        if (host == null || w <= 1 || h <= 1) { this.Suspend(); return; }
        this.InitializeInput(host);
        if (app != host || scope == null || !scope.IsActive()) { return; }
        bounds = new Rect(x, y, w, h);
        root.Visible = true;
        this.PrepareView(scope, host);
    }

    public void Suspend() {
        bounds = null;
        bool shown = root.Visible; root.Visible = false;
        App host = app;
        if (shown && host != null) { host.ReleaseInputSubtree(root); }
    }

    public void Hide() {
        generation = generation + 1;
        UiViewScope oldScope = scope; ControlInputHost oldInput = input;
        scope = null; input = null; app = null; bounds = null;
        if (oldScope != null) { oldScope.Retire(); }
        if (oldInput != null) { oldInput.Hide(); }
    }

    public void PrepareView(UiViewScope view, App host) {
        SceneDesigner current = owner;
        if (current == null) { this.Hide(); return; }
        if (view != scope || app != host || bounds == null) { return; }
        current.PrepareRegion(this, host);
        if (view != scope || app != host || bounds == null) { return; }
        Rect area = bounds;
        view.Layout(area.x, area.y, area.width, area.height);
    }

    public void Paint(App host) {
        if (app != host || scope == null || !scope.IsActive() || bounds == null) { return; }
        root.RenderTree(host);
    }
    public void ViewAction(string name, Control sender) { }
    public void ViewPointer(Control sender, RoutedEventArgs args) { }
}
