using System;
using Gui;
using Gui.Widget;

namespace Game.Scene;

public partial class SceneDesigner {
    public SceneInspectorView inspector;
    public bool inspectorSyncing;

    // Obtain before measuring: identity, parentage and subscriptions stay stable.
    public Control InspectorRoot() {
        if (this.inspector == null) { this.inspector = new SceneInspectorView(this); }
        return this.inspector.root;
    }

    public bool InspectorInputFocused(App app) {
        if (this.inspector == null) { return false; }
        return SceneInspectorView.InputFocused(app, this.inspector.root);
    }

    public void RenderInspector(App app, Canvas c, Theme t, int x, int y, int w, int h) {
        Control root = this.InspectorRoot();
        this.SyncInspector();
        this.RenderInspectorTree(app, root, x, y, w, h);
    }

    public void SyncInspector() {
        if (this.inspector == null) { return; }
        SceneInspectorView view = this.inspector;
        this.inspectorSyncing = true;
        if (view.document != this.doc) {
            this.titleIn.SetText(this.doc.WinTitle());
            this.bgIn.SetText(this.doc.Background());
            view.document = this.doc;
        }
        if (view.selection != this.sel) {
            if (this.colorPick != null) { this.colorPick.open = false; }
            if (this.sel != null) {
                this.nameIn.SetText(this.sel.Name());
                this.layerIn.SetText(this.sel.Layer());
                this.clickIn.SetText(this.sel.OnAction("Click"));
                this.imgIn.SetText(this.sel.ImageId());
                this.textIn.SetText(this.sel.Text());
                this.itemsIn.SetText(this.sel.Items());
                this.classIn.SetText(this.sel.CssClass());
                this.colorIn.SetText(SceneDesigner.RgbaToHex(this.sel.R(), this.sel.G(), this.sel.B()));
                this.colorTextShadow = this.colorIn.GetText();
                this.colorPick.SetColor(SceneView.PackColor(this.sel.R(), this.sel.G(), this.sel.B(), 255));
                this.colorPickVal = this.colorPick.Value();
            }
            view.selection = this.sel;
        }
        view.manual.SetShown(this.doc.WinCenter() == 0);
        view.element.SetShown(this.sel != null);
        view.empty.SetShown(this.sel == null);
        if (this.sel != null) {
            string title = SceneDesigner.T("ELEMENT · ", "元素 · ") + SceneDesigner.KindLabel(this.sel.Kind());
            view.elementTitle.Text = title;
        }
        for (int i = 0; i < view.fields.Count; i = i + 1) {
            SceneInspectorField field = view.fields[i];
            int value = this.InspectorNumberValue(field.key);
            // Refresh the signal silently; SetValue commits the edit buffer and
            // raises Change, which would create an undo entry during rendering.
            if (field.input.Value() != value) { field.input.model.Set(value); }
        }
        for (int i = 0; i < view.choices.Count; i = i + 1) {
            SceneInspectorChoice choice = view.choices[i];
            this.SyncInspectorButton(choice.button, choice.key, choice.argument);
        }
        this.inspectorSyncing = false;
        this.SyncInspectorColor();
    }

    public void SyncInspectorButton(Button b, string key, int arg) {
        bool active = false;
        if (key == "mode") { active = this.doc.Mode() == arg; }
        if (key == "center") { active = this.doc.WinCenter() == arg; }
        if (key == "resizable") { active = this.doc.WinResizable(); }
        if (key == "chrome") { active = this.doc.WinChrome(); }
        if (this.sel != null) {
            if (key == "position") { active = this.sel.Position() == arg; }
            if (key == "anchor") {
                active = this.sel.AnchorX() == (arg % 3) * 500 && this.sel.AnchorY() == (arg / 3) * 500;
                b.Text = active ? "●" : "·";
            }
            if (key == "visible") { string text = this.VisLabel(); b.Text = text; }
            if (key == "locked") {
                string text = this.sel.Locked() ? SceneDesigner.T("Unlock", "解锁") : SceneDesigner.T("Lock", "锁定");
                b.Text = text;
            }
        }
        if (key == "mode" || key == "center" || key == "resizable" || key == "chrome" || key == "position" || key == "anchor") {
            b.SetClassIn("primary", active ? "primary" : "");
        }
    }

    public int InspectorNumberValue(string key) {
        if (key == "designW") { return this.doc.DesignWidth(); }
        if (key == "designH") { return this.doc.DesignHeight(); }
        if (key == "winX") { return this.doc.WinPosX(); }
        if (key == "winY") { return this.doc.WinPosY(); }
        if (this.sel == null) { return 0; }
        if (key == "alpha") { return this.sel.A(); }
        if (key == "x") { return this.sel.X(); }
        if (key == "y") { return this.sel.Y(); }
        if (key == "w") { return this.sel.W(); }
        if (key == "h") { return this.sel.H(); }
        if (key == "rows") { return this.sel.Rows(); }
        if (key == "cols") { return this.sel.Cols(); }
        if (key == "gapX") { return this.sel.GapX(); }
        if (key == "gapY") { return this.sel.GapY(); }
        if (key == "z") { return this.sel.Z(); }
        if (key == "value") { return this.sel.Value(); }
        return 0;
    }

    public void CommitInspectorNumber(string key, int value) {
        if (this.inspectorSyncing || this.InspectorNumberValue(key) == value) { return; }
        bool scene = key == "designW" || key == "designH" || key == "winX" || key == "winY";
        if (!scene && this.sel == null) { return; }
        if ((key == "designW" || key == "designH") && value < 16) { return; }
        if ((key == "w" || key == "h" || key == "rows" || key == "cols") && value < 1) { return; }
        if ((key == "gapX" || key == "gapY" || key == "value" || key == "alpha") && value < 0) { return; }
        if (key == "alpha" && value > 255) { return; }
        this.PushUndo();
        if (key == "designW") { this.doc.designWidth = value; return; }
        if (key == "designH") { this.doc.designHeight = value; return; }
        if (key == "winX") { this.doc.SetWinPos(value, this.doc.WinPosY()); return; }
        if (key == "winY") { this.doc.SetWinPos(this.doc.WinPosX(), value); return; }
        if (key == "alpha") { this.sel.Tint(this.sel.R(), this.sel.G(), this.sel.B(), value); }
        if (key == "x") { this.sel.x = value; }
        if (key == "y") { this.sel.y = value; }
        if (key == "w" || key == "h") {
            int left = this.DesignLeft(this.sel);
            int top = this.DesignTop(this.sel);
            if (key == "w") { this.sel.w = value; }
            if (key == "h") { this.sel.h = value; }
            this.SetDesignPos(this.sel, left, top);
        }
        if (key == "rows") { this.sel.Grid(value, this.sel.Cols(), this.sel.GapX(), this.sel.GapY()); }
        if (key == "cols") { this.sel.Grid(this.sel.Rows(), value, this.sel.GapX(), this.sel.GapY()); }
        if (key == "gapX") { this.sel.gapX = value; }
        if (key == "gapY") { this.sel.gapY = value; }
        if (key == "z") { this.sel.z = value; }
        if (key == "value") { this.sel.SetValue(value); }
    }

    // ResourcePicked uses this endpoint because SetText does not raise Change.
    public void CommitInspectorText(string key) {
        if (this.inspectorSyncing) { return; }
        if (key == "background") { key = "bg"; }
        if (key == "bg") {
            string value = this.bgIn.GetText();
            if (value == this.doc.Background()) { return; }
            this.PushUndo(); this.doc.SetBackground(value); return;
        }
        if (key == "title") {
            string value = this.titleIn.GetText();
            if (value == this.doc.WinTitle()) { return; }
            this.PushUndo(); this.doc.SetWinTitle(value); return;
        }
        if (this.sel == null) { return; }
        if (key == "color") { this.CommitInspectorColorText(); return; }
        string text = "";
        string previous = "";
        if (key == "name") { text = this.nameIn.GetText(); previous = this.sel.Name(); }
        else if (key == "layer") { text = this.layerIn.GetText(); previous = this.sel.Layer(); }
        else if (key == "click") { text = this.clickIn.GetText(); previous = this.sel.OnAction("Click"); }
        else if (key == "image") { text = this.imgIn.GetText(); previous = this.sel.ImageId(); }
        else if (key == "text") { text = this.textIn.GetText(); previous = this.sel.Text(); }
        else if (key == "items") { text = this.itemsIn.GetText(); previous = this.sel.Items(); }
        else if (key == "class") { text = this.classIn.GetText(); previous = this.sel.CssClass(); }
        else { return; }
        if (text == previous) { return; }
        if (key == "name" && this.UsedName(text)) {
            this.msg = SceneDesigner.T("name already used: ", "名称已被使用：") + text;
            this.nameIn.SetText(previous); return;
        }
        this.PushUndo();
        if (key == "name") { this.sel.ename = text; }
        if (key == "layer") {
            this.sel.layer = text;
            if (text.Length > 0 && this.editLayer.Length == 0) { this.editLayer = text; }
        }
        if (key == "click") { this.sel.On("Click", text); }
        if (key == "image") { this.sel.image = text; }
        if (key == "text") { this.sel.text = text; }
        if (key == "items") { this.sel.items = text; }
        if (key == "class") { this.sel.cssClass = text; }
    }

    public void RunInspectorAction(string key, int arg) {
        if (key == "browse") { this.resPick = arg; return; }
        if (key == "mode") {
            if (this.doc.Mode() == arg) { return; }
            this.PushUndo(); this.doc.SetMode(arg); return;
        }
        if (key == "center") {
            if (this.doc.WinCenter() == arg) { return; }
            this.PushUndo(); this.doc.SetWinCenter(arg); return;
        }
        if (key == "resizable") { this.PushUndo(); this.doc.SetWinResizable(!this.doc.WinResizable()); return; }
        if (key == "chrome") { this.PushUndo(); this.doc.SetWinChrome(!this.doc.WinChrome()); return; }
        if (this.sel == null) { return; }
        if (key == "duplicate") { this.DuplicateSel(); return; }
        if (key == "delete") { this.DeleteSel(); return; }
        if (key == "raise") { this.RaiseSel(arg); return; }
        if (key == "code") { this.NavigateInspectorHandler(); return; }
        if (key == "position") {
            if (this.sel.Position() == arg) { return; }
            this.PushUndo(); this.sel.SetPosition(arg); return;
        }
        if (key == "anchor") {
            int ax = (arg % 3) * 500;
            int ay = (arg / 3) * 500;
            if (this.sel.AnchorX() == ax && this.sel.AnchorY() == ay) { return; }
            this.PushUndo();
            int left = this.DesignLeft(this.sel);
            int top = this.DesignTop(this.sel);
            this.sel.AnchorTo(ax, ay);
            this.SetDesignPos(this.sel, left, top); return;
        }
        if (key == "visible") { this.PushUndo(); this.sel.SetVisible(!this.sel.Visible()); }
        if (key == "locked") { this.PushUndo(); this.sel.SetLocked(!this.sel.Locked()); }
    }

    public void NavigateInspectorHandler() {
        if (this.sel == null) { return; }
        string handler = this.clickIn.GetText();
        if (handler == "") {
            string name = this.sel.Name();
            if (name == "") { name = "Element"; }
            handler = "On" + name + "Click";
            this.clickIn.SetText(handler);
            this.CommitInspectorText("click");
        }
        this.openCodeBehindElement = "handler:" + handler;
        this.openCodeBehindRequested = true;
        this.msg = SceneDesigner.T("navigating to handler: ", "跳转到事件处理器: ") + handler;
    }

    public void ApplyInspectorRgb(int packed) {
        if (this.sel == null) { return; }
        int rgb = ColorPicker.RgbOf(packed);
        int r = (rgb / 65536) % 256;
        int g = (rgb / 256) % 256;
        int b = rgb % 256;
        if (r == this.sel.R() && g == this.sel.G() && b == this.sel.B()) { return; }
        this.PushUndo();
        this.sel.Tint(r, g, b, this.sel.A());
    }

    public void CommitInspectorColorText() {
        if (this.sel == null || this.colorPick == null) { return; }
        string text = this.colorIn.GetText();
        this.colorTextShadow = text;
        ColorParseResult parsed = ColorPicker.HexParse(text);
        if (!parsed.ok) { return; }
        // Even an eight-digit input cannot change the independent scene alpha.
        int rgb = ColorPicker.RgbOf(parsed.packed);
        this.colorPick.SetColor(ColorPicker.Opaque((rgb / 65536) % 256, (rgb / 256) % 256, rgb % 256));
        this.colorPickVal = this.colorPick.Value();
        this.ApplyInspectorRgb(parsed.packed);
    }

    public void CommitInspectorColor() {
        if (this.sel == null || this.colorPick == null) { return; }
        this.colorPickVal = this.colorPick.Value();
        string text = this.colorPick.FormatAs("hex");
        this.colorIn.SetText(text);
        this.colorTextShadow = text;
        this.ApplyInspectorRgb(this.colorPickVal);
    }

    // Overlay changes occur after the host paint pass. Keep programmatic row
    // synchronization compatible while routed changes commit immediately.
    public void SyncInspectorColor() {
        if (this.sel == null || this.colorPick == null) { return; }
        if (this.colorIn.GetText() != this.colorTextShadow) { this.CommitInspectorColorText(); }
        else if (this.colorPick.Value() != this.colorPickVal) { this.CommitInspectorColor(); }
    }

    // Independent probes render the existing row, without reparenting inputs.
    public int RenderColorRow(App app, Canvas c, Theme t, int ix, int iy, int iw) {
        Control root = this.InspectorRoot();
        this.SyncInspector();
        Panel row = this.inspector.colorRow;
        row.SetShown(true);
        row.MeasureTree(app);
        row.Arrange(ix, iy, iw, t.heightSmall);
        row.RenderTree(app);
        this.inpIdColor = this.colorIn.WidgetId();
        return t.heightSmall + t.gapMedium;
    }

    public string VisLabel() {
        if (this.sel != null && this.sel.Visible()) { return SceneDesigner.T("Visible", "显示"); }
        return SceneDesigner.T("Hidden", "隐藏");
    }

    public int ModeType(int m) {
        if (m == this.doc.Mode()) { return 1; }
        return 0;
    }

    public int CenterType(int want) {
        if (want == this.doc.WinCenter()) { return 1; }
        return 0;
    }

    public void RenderStatus(App app, Canvas c, Theme t, int x, int y, int w) {
        c.DrawText(x, y, ".html · " + SceneDoc.IntStr(this.doc.Count())
            + SceneDesigner.T(" elements   ", " 个元素   ") + this.msg,
            t.textTertiary, t.fontSizeTiny);
    }
}
