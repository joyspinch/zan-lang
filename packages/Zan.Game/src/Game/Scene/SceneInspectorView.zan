using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Game.Scene;

// A designer owns exactly one tree. Selection changes update values/visibility,
// never recreate or reparent the editor inputs.
public class SceneInspectorView {
    public ScrollColumn root;
    public Panel content;
    public Panel element;
    public Panel manual;
    public Panel colorRow;
    public Label elementTitle;
    public Label empty;
    public List<SceneInspectorField> fields;
    public List<SceneInspectorChoice> choices;
    public SceneElement selection;
    public SceneDoc document;

    public SceneInspectorView(SceneDesigner d) {
        fields = new List<SceneInspectorField>();
        choices = new List<SceneInspectorChoice>();
        root = new ScrollColumn();
        root.SetProp("style", "background:var(--surface-bg); border:1px solid var(--border-secondary); padding:var(--padding-small)");
        content = SceneInspectorView.Column();
        root.Add(content);
        this.BuildScene(d);
        empty = new Label(SceneDesigner.T("Select an element to edit", "选中一个元素进行编辑"));
        empty.Class = "secondary small";
        content.Add(empty);
        element = SceneInspectorView.Column();
        content.Add(element);
        this.BuildElement(d);
        this.BuildGeometry(d);
        selection = null;
        document = null;
    }

    public static Panel Column() {
        Panel p = Panel.Column();
        p.SetProp("style", "gap:var(--gap-medium); flex-shrink:0; min-width:0");
        return p;
    }

    public static Panel Row() {
        Panel p = Panel.Row();
        p.SetProp("style", "gap:var(--gap-small); padding:0; margin:0; border:0; flex-shrink:0; min-width:0; align-items:center");
        return p;
    }

    public Panel Field(Panel parent, string text) {
        Panel p = SceneInspectorView.Row();
        Label label = new Label(text);
        label.Class = "secondary small";
        label.SetProp("style", "width:52px; flex-shrink:0");
        p.Add(label);
        parent.Add(p);
        return p;
    }

    public Input Text(SceneDesigner d, Panel parent, string label, string key, Input input) {
        Panel row = this.Field(parent, label);
        input.Class = "small";
        input.SetProp("style", "flex-grow:1; flex-basis:0; min-width:0; height:var(--height-small)");
        row.Add(input);
        SceneInspectorAction action = new SceneInspectorAction(d, key, 0, 0);
        input.Change.AddS(action.Invoke);
        return input;
    }

    public InputNumber Number(SceneDesigner d, Panel parent, string label, string key, int lo, int hi, int step) {
        Panel row = this.Field(parent, label);
        InputNumber input = new InputNumber(lo, hi);
        input.Size = "small";
        input.Class = "small";
        input.stepV = step;
        input.SetProp("style", "flex-grow:1; flex-basis:0; min-width:0; height:var(--height-small)");
        row.Add(input);
        fields.Add(new SceneInspectorField(key, input));
        SceneInspectorAction action = new SceneInspectorAction(d, key, 1, 0);
        input.Change.AddS(action.Invoke);
        return input;
    }

    public Button ButtonFor(SceneDesigner d, Panel parent, string text, string key, int arg) {
        Button b = new Button(text);
        b.Class = "small";
        b.SetProp("style", "flex-grow:1; flex-basis:0; min-width:0; height:var(--height-small)");
        SceneInspectorAction action = new SceneInspectorAction(d, key, 2, arg);
        b.Click.AddS(action.Invoke);
        parent.Add(b);
        choices.Add(new SceneInspectorChoice(key, arg, b));
        return b;
    }

    public void Browse(SceneDesigner d, Input input, int target) {
        Control parent = input.parent;
        if (parent == null || !(parent is Panel)) { return; }
        Button b = this.ButtonFor(d, (Panel)parent, "…", "browse", target);
        b.SetProp("style", "width:var(--height-small); height:var(--height-small); flex-shrink:0");
    }

    public void BuildScene(SceneDesigner d) {
        Label title = new Label(SceneDesigner.T("SCENE", "场景"));
        title.Class = "secondary small";
        content.Add(title);
        this.Number(d, content, "W", "designW", 16, 2147483647, 20);
        this.Number(d, content, "H", "designH", 16, 2147483647, 20);
        Panel modes = this.Field(content, SceneDesigner.T("scale", "缩放"));
        this.ButtonFor(d, modes, "Fit", "mode", 0);
        this.ButtonFor(d, modes, "Fill", "mode", 1);
        this.ButtonFor(d, modes, "Str", "mode", 2);
        this.ButtonFor(d, modes, "1:1", "mode", 3);
        Panel pos = this.Field(content, SceneDesigner.T("pos", "位置"));
        this.ButtonFor(d, pos, SceneDesigner.T("Center", "居中"), "center", 1);
        this.ButtonFor(d, pos, SceneDesigner.T("Manual", "手动"), "center", 0);
        manual = SceneInspectorView.Column();
        content.Add(manual);
        this.Number(d, manual, "X", "winX", (-2147483647 - 1), 2147483647, 20);
        this.Number(d, manual, "Y", "winY", (-2147483647 - 1), 2147483647, 20);
        this.Text(d, content, SceneDesigner.T("title", "标题"), "title", d.titleIn);
        Panel flags = SceneInspectorView.Row();
        content.Add(flags);
        this.ButtonFor(d, flags, SceneDesigner.T("Resizable", "可缩放"), "resizable", 0);
        this.ButtonFor(d, flags, SceneDesigner.T("Title bar", "标题栏"), "chrome", 0);
        this.Text(d, content, SceneDesigner.T("bg", "背景"), "bg", d.bgIn);
        this.Browse(d, d.bgIn, 2);
    }

    public void BuildElement(SceneDesigner d) {
        elementTitle = new Label("");
        elementTitle.Class = "secondary small";
        element.Add(elementTitle);
        this.Text(d, element, SceneDesigner.T("name", "名称"), "name", d.nameIn);
        this.Text(d, element, SceneDesigner.T("layer", "层"), "layer", d.layerIn);
        this.Text(d, element, SceneDesigner.T("click", "点击"), "click", d.clickIn);
        Control clickParent = d.clickIn.parent;
        if (clickParent != null && clickParent is Panel) {
            this.ButtonFor(d, (Panel)clickParent, SceneDesigner.T("code", "代码"), "code", 0);
        }
        this.Text(d, element, SceneDesigner.T("image", "图片"), "image", d.imgIn);
        this.Browse(d, d.imgIn, 1);
        this.Text(d, element, SceneDesigner.T("text", "文本"), "text", d.textIn);
        this.Text(d, element, SceneDesigner.T("items", "选项"), "items", d.itemsIn);
        this.Text(d, element, SceneDesigner.T("class", "类名"), "class", d.classIn);
        this.Text(d, element, SceneDesigner.T("color", "颜色"), "color", d.colorIn);
        colorRow = (Panel)d.colorIn.parent;
        d.colorPick = new ColorPicker(ColorPicker.Opaque(255, 255, 255));
        d.colorPick.Mode = "hex";
        d.colorPick.SetShowAlpha(false);
        d.colorPick.Class = "small";
        d.colorPick.SetProp("style", "width:var(--height-small); height:var(--height-small); flex-shrink:0");
        SceneInspectorAction action = new SceneInspectorAction(d, "color", 3, 0);
        d.colorPick.Change.AddS(action.Invoke);
        colorRow.Add(d.colorPick);
        this.Number(d, element, SceneDesigner.T("alpha", "透明度"), "alpha", 0, 255, 15);
    }

    public void BuildGeometry(SceneDesigner d) {
        Panel pos = this.Field(element, SceneDesigner.T("pos", "定位"));
        this.ButtonFor(d, pos, SceneDesigner.T("Flow", "流式"), "position", 0);
        this.ButtonFor(d, pos, SceneDesigner.T("Float", "浮动"), "position", 1);
        this.Number(d, element, "x", "x", (-2147483647 - 1), 2147483647, 1);
        this.Number(d, element, "y", "y", (-2147483647 - 1), 2147483647, 1);
        this.Number(d, element, "w", "w", 1, 2147483647, 1);
        this.Number(d, element, "h", "h", 1, 2147483647, 1);
        this.Number(d, element, SceneDesigner.T("rows", "行"), "rows", 1, 2147483647, 1);
        this.Number(d, element, SceneDesigner.T("cols", "列"), "cols", 1, 2147483647, 1);
        this.Number(d, element, SceneDesigner.T("gapX", "横距"), "gapX", 0, 2147483647, 1);
        this.Number(d, element, SceneDesigner.T("gapY", "纵距"), "gapY", 0, 2147483647, 1);
        this.Number(d, element, "z", "z", (-2147483647 - 1), 2147483647, 1);
        this.Number(d, element, SceneDesigner.T("val", "值"), "value", 0, 2147483647, 5);
        Panel anchors = this.Field(element, SceneDesigner.T("anchor", "锚点"));
        Panel grid = SceneInspectorView.Column();
        anchors.Add(grid);
        for (int r = 0; r < 3; r = r + 1) {
            Panel row = SceneInspectorView.Row();
            grid.Add(row);
            for (int col = 0; col < 3; col = col + 1) {
                Button b = this.ButtonFor(d, row, "·", "anchor", r * 3 + col);
                b.SetProp("style", "width:var(--height-small); height:var(--height-small); flex-shrink:0");
            }
        }
        Panel first = SceneInspectorView.Row();
        element.Add(first);
        this.ButtonFor(d, first, SceneDesigner.T("Visible", "显示"), "visible", 0);
        this.ButtonFor(d, first, SceneDesigner.T("Duplicate", "复制"), "duplicate", 0);
        Panel second = SceneInspectorView.Row();
        element.Add(second);
        this.ButtonFor(d, second, SceneDesigner.T("Lock", "锁定"), "locked", 0);
        this.ButtonFor(d, second, SceneDesigner.T("forward", "上移一层"), "raise", 1);
        Panel third = SceneInspectorView.Row();
        element.Add(third);
        this.ButtonFor(d, third, SceneDesigner.T("back", "下移一层"), "raise", -1);
        Button remove = this.ButtonFor(d, third, SceneDesigner.T("Delete", "删除"), "delete", 0);
        remove.Class = "error small";
    }

    public InputNumber FindNumber(string key) {
        for (int i = 0; i < fields.Count; i = i + 1) {
            SceneInspectorField field = fields[i];
            if (field.key == key) { return field.input; }
        }
        return null;
    }

    public static bool InputFocused(App app, Control node) {
        if (node == null || !node.visible) { return false; }
        if ((node is Input || node is InputNumber) && node.IsFocused(app)) { return true; }
        for (int i = 0; i < node.Children.Count; i = i + 1) {
            if (SceneInspectorView.InputFocused(app, node.Children[i])) { return true; }
        }
        return false;
    }
}
