using System;
using System.Json;
using Gui;

namespace Game.Scene;

class ScenePreparedDocument {
    SceneDoc document = new SceneDoc("", 1280, 720);
    bool loadError;
    string lastError = "";
    bool applied;
}

partial class SceneDesigner {
    /// worker 独立解析，错误保存在请求上，避免 SceneDoc.LastError 的全局跨线程竞态。
    static ScenePreparedDocument PrepareJson(string text) {
        ScenePreparedDocument prepared = new ScenePreparedDocument();
        JsonValue root = null;
        try { root = JsonValue.Parse(text); }
        catch (JsonException error) {
            // 坏设计稿返回显式空白失败模型，宿主不得自动覆盖源文件。
            prepared.loadError = true; prepared.lastError = error.Message; return prepared;
        }
        if (root == null || !root.IsObject()) {
            prepared.loadError = true; prepared.lastError = "document is not a JSON object"; return prepared;
        }
        prepared.document = SceneDoc.FromRoot(root);
        return prepared;
    }

    /// UI 单次消费字段树；安装不执行 JSON 解析或序列化。
    bool ApplyPreparedDocument(ScenePreparedDocument prepared) {
        if (prepared == null || prepared.applied) { return false; }
        prepared.applied = true;
        doc = prepared.document; loadError = prepared.loadError;
        msg = loadError ? SceneDesigner.T("load failed: ", "加载失败：") + prepared.lastError : "loaded";
        sel = null; lastSel = null; selExtra = new List<SceneElement>();
        ctxOpen = false; editLayer = ""; layerMenuOpen = false;
        undoStack = new List<string>(); redoStack = new List<string>();
        bgIn.SetText(doc.Background()); titleIn.SetText(doc.WinTitle());
        return true;
    }

    SceneDoc CaptureDocumentSnapshot() { return doc.CaptureSnapshot(); }
    bool DocumentMatchesSnapshot(SceneDoc snapshot) { return doc.SnapshotEquals(snapshot); }
}

partial class SceneDoc {
    /// UI 捕获全部持久化数据；actions/extra/动作实体与原文档不共享可变对象。
    SceneDoc CaptureSnapshot() {
        SceneDoc copy = new SceneDoc(sname, designWidth, designHeight);
        copy.adopt(this);
        copy.elements = new List<SceneElement>();
        for (int i = 0; i < elements.Count; i = i + 1) {
            SceneElement e = elements[i];
            SceneElement c = new SceneElement(e.kind, e.ename);
            c.x = e.x; c.y = e.y; c.w = e.w; c.h = e.h; c.anchorX = e.anchorX; c.anchorY = e.anchorY;
            c.z = e.z; c.image = e.image; c.text = e.text; c.cr = e.cr; c.cg = e.cg; c.cb = e.cb; c.ca = e.ca;
            c.visible = e.visible; c.rows = e.rows; c.cols = e.cols; c.gapX = e.gapX; c.gapY = e.gapY;
            c.val = e.val; c.items = e.items; c.locked = e.locked; c.layer = e.layer;
            c.cssClass = e.cssClass; c.position = e.position; c.flexGrow = e.flexGrow;
            c.actions = e.actions == null ? null : e.actions.Clone();
            c.extra = e.extra == null ? null : e.extra.Clone();
            if (e.actionList != null) {
                for (int k = 0; k < e.actionList.Count; k = k + 1) {
                    SceneActionBinding action = e.actionList[k];
                    c.actionList.Add(new SceneActionBinding(action.event, action.action));
                }
            }
            copy.elements.Add(c);
        }
        return copy;
    }

    bool SnapshotEquals(SceneDoc s) {
        if (s == null || sname != s.sname || designWidth != s.designWidth || designHeight != s.designHeight
            || scaleMode != s.scaleMode || background != s.background || bgR != s.bgR || bgG != s.bgG || bgB != s.bgB
            || winCenter != s.winCenter || winPosX != s.winPosX || winPosY != s.winPosY || winTitle != s.winTitle
            || winResizable != s.winResizable || winChrome != s.winChrome || elements.Count != s.elements.Count) { return false; }
        for (int i = 0; i < elements.Count; i = i + 1) {
            SceneElement e = elements[i]; SceneElement c = s.elements[i];
            if (e.kind != c.kind || e.ename != c.ename || e.x != c.x || e.y != c.y || e.w != c.w || e.h != c.h
                || e.anchorX != c.anchorX || e.anchorY != c.anchorY || e.z != c.z || e.image != c.image || e.text != c.text
                || e.cr != c.cr || e.cg != c.cg || e.cb != c.cb || e.ca != c.ca || e.visible != c.visible
                || e.rows != c.rows || e.cols != c.cols || e.gapX != c.gapX || e.gapY != c.gapY
                || e.val != c.val || e.items != c.items || e.locked != c.locked || e.layer != c.layer
                || e.cssClass != c.cssClass || e.position != c.position || e.flexGrow != c.flexGrow
                || !SceneDoc.SnapshotJsonEqual(e.actions, c.actions) || !SceneDoc.SnapshotJsonEqual(e.extra, c.extra)) { return false; }
            int count = e.actionList == null ? 0 : e.actionList.Count;
            if (count != c.actionList.Count) { return false; }
            for (int k = 0; k < count; k = k + 1) {
                if (e.actionList[k].event != c.actionList[k].event || e.actionList[k].action != c.actionList[k].action) { return false; }
            }
        }
        return true;
    }

    static bool SnapshotJsonEqual(JsonValue a, JsonValue b) {
        if (a == b) { return true; }
        if (a == null || b == null || a.kind != b.kind || a.Count() != b.Count()) { return false; }
        if (a.IsObject()) {
            for (int i = 0; i < a.Count(); i = i + 1) {
                if (a.KeyAt(i) != b.KeyAt(i) || !SceneDoc.SnapshotJsonEqual(a.ValAt(i), b.ValAt(i))) { return false; }
            }
        } else if (a.IsArray()) {
            for (int i = 0; i < a.Count(); i = i + 1) {
                if (!SceneDoc.SnapshotJsonEqual(a.At(i), b.At(i))) { return false; }
            }
        } else if (a.AsString("") != b.AsString("")) { return false; }
        return true;
    }
}
