using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Gui;

namespace Game.Scene;

// 动作方法注册绑定实体（消除 handlerNames / handlerFns 平行列表反模式）。
public class SceneHandlerBinding {
    public string name;
    public Action fn;

    public SceneHandlerBinding(string name, Action fn) {
        this.name = name;
        this.fn = fn;
    }
}
