using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Gui;

namespace Game.Scene;

// 强类型事件动作实体：代替弱类型 JsonValue 键值对
class SceneActionBinding {
    string event;
    string action;

    SceneActionBinding(string evt, string act) {
        this.event = evt;
        this.action = act;
    }
}
