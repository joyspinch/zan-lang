using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Gui;

namespace Game.Scene;

// 当前窗口的缩放画布布局：设计画布渲染在 (offX, offY)，
// 尺寸为 (canvasW, canvasH)，各轴缩放为 (scaleX, scaleY)。
// 由 SceneDoc.Metrics 依据缩放模式计算，单位为设备像素。
public class SceneMetrics {
    public double offX;
    public double offY;
    public double canvasW;
    public double canvasH;
    public double scaleX;
    public double scaleY;

    // 画布左上角在窗口内的设备像素偏移 X。
    public double OffX() { return this.offX; }
    // 画布左上角在窗口内的设备像素偏移 Y。
    public double OffY() { return this.offY; }
    // 画布缩放后的实际宽度（设备像素）。
    public double CanvasW() { return this.canvasW; }
    // 画布缩放后的实际高度（设备像素）。
    public double CanvasH() { return this.canvasH; }
    // 水平缩放系数（设计像素 -> 设备像素；Stretch 模式下两轴可不同）。
    public double ScaleX() { return this.scaleX; }
    // 垂直缩放系数（设计像素 -> 设备像素）。
    public double ScaleY() { return this.scaleY; }
}
