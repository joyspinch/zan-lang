namespace Game.Scene;

// 场景设计器快速排版命令实体（消除 aIcons / aLabels / aGrp / aIdx 平行列表反模式）。
public class SceneAlignCommand {
    public string icon;
    public string label;
    public int group;
    public int index;

    public SceneAlignCommand(string icon, string label, int group, int index) {
        this.icon = icon != null ? icon : "";
        this.label = label != null ? label : "";
        this.group = group;
        this.index = index;
    }
}
