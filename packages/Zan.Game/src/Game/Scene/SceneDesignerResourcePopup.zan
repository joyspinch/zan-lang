using System;
using Gui;
using Gui.Widget;

namespace Game.Scene;

public class SceneDesignerResourcePopup : Panel {
    public weak SceneDesigner owner;
    public Label title;
    public ListView<string> list;
    public SceneDesignerResourcePopup(SceneDesigner owner, ListView<string> list) : base() {
        this.owner = owner; this.list = list;
        this.Class = "col";
        this.Pad(Space.S);
        title = new Label();
        title.Class = "small";
        this.Add(title); this.Add(list);
        this.Prefer(300, 320);
        list.Prefer(0, 280); list.Grow();
    }
    public override void OnPopupDismissed() {
        SceneDesigner d = owner;
        if (d != null) { d.ResourcePopupDismissed(this); }
    }
}
