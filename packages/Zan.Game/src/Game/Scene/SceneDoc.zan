using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Gui;

namespace Game.Scene;

// 游戏场景文档：设计分辨率画布、背景，以及一个扁平的、
// 按 z 排序的绝对定位 HUD/场景元素列表。这是
// Zan IDE 场景设计器（.html）读写所依据的运行时契约；同时承载运行时的层（弹窗/
// 菜单页）激活状态与声明式动作解释。
partial class SceneDoc {
    public string sname;
    public int designWidth;
    public int designHeight;
    public int scaleMode;
    public string background;   // 背景图片资源 id / 路径（可为空）
    public int bgR;
    public int bgG;
    public int bgB;
    public int winCenter;   // 1 = 显示时窗口居中（默认）；0 = 手动位置
    public int winPosX;     // 手动窗口 X（winCenter == 0 时使用）
    public int winPosY;     // 手动窗口 Y（winCenter == 0 时使用）
    // 窗口基础属性：标题（默认用场景名）、可调整大小、标题栏。
    // 与 Gui.Designer 的 winTitle/winResizable/winChrome 同名同义。
    public string winTitle;
    public int winResizable;   // 1 = 可拖边框缩放（默认）；0 = 固定尺寸
    public int winChrome;      // 1 = 显示标题栏（默认）；0 = 无边框
    public List<SceneElement> elements;

    SceneDoc(string name, int designWidth, int designHeight) {
        this.sname = name;
        this.designWidth = designWidth;
        this.designHeight = designHeight;
        this.scaleMode = 0;
        this.background = "";
        this.bgR = 18; this.bgG = 20; this.bgB = 32;
        this.winCenter = 1;
        this.winPosX = 0;
        this.winPosY = 0;
        this.winTitle = "";
        this.winResizable = 1;
        this.winChrome = 1;
        this.elements = new List<SceneElement>();
    }

    // 追加一个元素到文档末尾；返回该元素（便于链式配置）。
    public SceneElement Add(SceneElement e) {
        this.elements.Add(e);
        return e;
    }

    // 按名字查找元素；不存在时返回 null。
    public SceneElement Find(string name) {
        for (int i = 0; i < this.elements.Count; i = i + 1) {
            if (this.elements[i].Name() == name) { return this.elements[i]; }
        }
        return null;
    }

    // 元素数量。
    public int Count() { return this.elements.Count; }
    // 返回第 i 个元素（按添加顺序；i 越界行为未定义，调用方保证 0 <= i < Count）。
    public SceneElement ElementAt(int i) { return this.elements[i]; }
    // 场景名（场景设计稿的 name 属性）。
    public string Name() { return this.sname; }
    // 设计画布宽（设计像素）。
    public int DesignWidth() { return this.designWidth; }
    // 设计画布高（设计像素）。
    public int DesignHeight() { return this.designHeight; }
    // 缩放模式（0 Fit / 1 Fill / 2 Stretch / 3 None，见 ScaleMode）。
    public int Mode() { return this.scaleMode; }
    // 窗口显示时是否居中：1 = 居中（默认），0 = 用手动位置。
    public int WinCenter() { return this.winCenter; }
    // 设置窗口是否居中：1 = 居中，0 = 用 SetWinPos 设置的手动位置。
    public void SetWinCenter(int v) { this.winCenter = v; }
    // 手动窗口位置 X（仅 winCenter == 0 时生效）。
    public int WinPosX() { return this.winPosX; }
    // 手动窗口位置 Y（仅 winCenter == 0 时生效）。
    public int WinPosY() { return this.winPosY; }
    // 设置手动窗口位置（仅 winCenter == 0 时生效）。
    public void SetWinPos(int x, int y) { this.winPosX = x; this.winPosY = y; }
    // 背景图片资源 id 或路径（"" = 无背景图）。
    public string Background() { return this.background; }

    // 窗口标题；空 = 用场景名。
    public string WinTitle() {
        if (this.winTitle == null) { return ""; }
        return this.winTitle;
    }
    // 设置窗口标题（写入场景设计稿的 winTitle / title；空 = 运行时用场景名）。
    public void SetWinTitle(string s) { this.winTitle = s; }

    // 窗口可调整大小（默认 true）。
    public bool WinResizable() { return this.winResizable != 0; }
    // 设置窗口可否拖边框缩放（默认 true）。
    public void SetWinResizable(bool v) { this.winResizable = v ? 1 : 0; }

    // 显示标题栏（默认 true）；关闭后窗口无边框，由场景自绘。
    public bool WinChrome() { return this.winChrome != 0; }
    // 设置是否显示系统标题栏（默认 true）；关闭后窗口无边框，由场景自绘。
    public void SetWinChrome(bool v) { this.winChrome = v ? 1 : 0; }

    // ---- 运行时层（弹窗/菜单页）激活 --------------------------------

    // 激活的层名集合（';' 分隔）。空串 = 只有基础层（layer == ""
    // 的元素）可见。基础层永远渲染；这里只列"额外"打开的浮层。
    public string openLayers;
    // 命中测试/事件分发是否遵循层：默认 false（Find/Resolve 对
    // 整份文档工作，纯数据查询）。运行时交互开启后，隐藏层的
    // 元素不响应命中。
    public bool layersActive;
    // 元素 on* 动作串里的方法名 -> 业务 Action 表（以 SceneHandlerBinding 强类型实体承载，消除平行列表）。
    public List<SceneHandlerBinding> handlers;

    // 注册（或替换）动作方法名 `name` 的 Action，供元素
    // on* 绑定里的非内置动作触发。
    public void SetHandler(string name, Action a) {
        if (this.handlers == null) {
            this.handlers = new List<SceneHandlerBinding>();
        }
        for (int i = 0; i < this.handlers.Count; i = i + 1) {
            if (this.handlers[i].name == name) { this.handlers[i].fn = a; return; }
        }
        this.handlers.Add(new SceneHandlerBinding(name, a));
    }

    // 触发为 `name` 注册的 Action；未注册的名字是空操作。
    public void CallHandler(string name) {
        if (this.handlers == null) { return; }
        for (int i = 0; i < this.handlers.Count; i = i + 1) {
            if (this.handlers[i].name == name) {
                Action a = this.handlers[i].fn;
                if (a != null) { a(); }
                return;
            }
        }
    }

    // 打开交互模式：LayerHit 开始按激活层过滤。纯渲染
    // （SceneView.Render）无需开启——渲染本来就按层过滤。
    public void SetLayersActive(bool v) { this.layersActive = v; }

    // 命中测试语义下元素是否可交互：visible 且其层处于
    // 打开状态。设计器/运行时点击分发共用这一判定。
    public bool ElementHit(SceneElement e) {
        return e.Visible() && this.LayerOpen(e.Layer());
    }

    // layer 的元素是否参与本帧渲染：基础层永远 true，其它层
    // 需要被 OpenLayer 打开过。
    public bool LayerOpen(string layer) {
        if (layer.Length == 0) { return true; }
        string cur = this.openLayers;
        if (cur == null || cur.Length == 0) { return false; }
        int start = 0;
        while (start <= cur.Length) {
            int end = cur.IndexOf(";", start);
            string part;
            if (end < 0) {
                part = cur.Substring(start, cur.Length - start);
            } else {
                part = cur.Substring(start, end - start);
            }
            if (part == layer && part.Length > 0) { return true; }
            if (end < 0) { break; }
            start = end + 1;
        }
        return false;
    }

    // 打开一个层（弹窗/菜单页）；重复打开是幂等的。
    public void OpenLayer(string layer) {
        if (layer.Length == 0 || this.LayerOpen(layer)) { return; }
        if (this.openLayers == null || this.openLayers.Length == 0) {
            this.openLayers = layer;
        } else {
            this.openLayers = this.openLayers + ";" + layer;
        }
    }

    // 关闭一个层；本来就没开是幂等的。
    public void CloseLayer(string layer) {
        if (layer.Length == 0) { return; }
        string outp = "";
        string cur = this.openLayers;
        if (cur == null || cur.Length == 0) { return; }
        int start = 0;
        while (start <= cur.Length) {
            int end = cur.IndexOf(";", start);
            string part;
            if (end < 0) {
                part = cur.Substring(start, cur.Length - start);
            } else {
                part = cur.Substring(start, end - start);
            }
            if (part.Length > 0 && part != layer) {
                if (outp.Length > 0) { outp = outp + ";"; }
                outp = outp + part;
            }
            if (end < 0) { break; }
            start = end + 1;
        }
        this.openLayers = outp;
    }

    // 层开关切换；返回切换后是否打开。
    public bool ToggleLayer(string layer) {
        if (this.LayerOpen(layer)) {
            this.CloseLayer(layer);
            return false;
        }
        this.OpenLayer(layer);
        return true;
    }

    // 关闭所有已打开的浮层（回基础层）。
    public void CloseAllLayers() { this.openLayers = ""; }

    // ---- 声明式动作（元素 on* 绑定的解释器）-------------------------

    // 场景切换动作（"OpenScene:xxx"）触发时记录目标场景名：
    // RunActions 自己不能建窗口（它运行在当前窗口的帧循环里），
    // 由生成的 Run() 循环检查该标记并在帧尾换场景——与
    // App.isRunning 同一模式。"" = 无待处理切换。
    public string pendingScene;

    // 待切换的目标场景名（"OpenScene:xxx" 排队的目标）；
    // "" = 无待处理切换。生成的主循环读它换场景。
    public string PendingScene() {
        if (this.pendingScene == null) { return ""; }
        return this.pendingScene;
    }

    // 清除待处理场景切换（主循环消费后调用）。
    public void ClearPendingScene() { this.pendingScene = ""; }

    // 最近一次 RunActions 执行的内置动作数（测试观测点）。
    public int actionsRun;

    // 上一帧（每次 HandleClicks）触发的方法名处理器记录的最后
    // 一个名字；测试观测点，"" = 未触发方法名。
    public string lastHandler;

    // 执行一个动作串：内置动作立即生效，方法名查 handlers 表。
    // `selfLayer` 是发起元素所属层，供 "HideLayer:self" /
    // "ToggleLayer:self" 相对引用。多个动作用 ';' 串接按序执行。
    public void RunActions(string actions, string selfLayer) {
        if (actions == null || actions.Length == 0) { return; }
        int start = 0;
        while (start <= actions.Length) {
            int end = actions.IndexOf(";", start);
            string part;
            if (end < 0) {
                part = actions.Substring(start, actions.Length - start);
            } else {
                part = actions.Substring(start, end - start);
            }
            this.RunOneAction(part.Trim(), selfLayer);
            if (end < 0) { break; }
            start = end + 1;
        }
    }

    // 执行单个动作（RunActions 的内部分派）：识别 "动作:参数"
    // 与 "动作"（无参）两种形态；未识别的名字按代码后置方法名
    // 查 handlers 表，未注册时为空操作。
    public void RunOneAction(string act, string selfLayer) {
        if (act.Length == 0) { return; }
        // "动作:参数" 与 "动作"（无参）两种形态。
        string name = act;
        string arg = "";
        int colon = act.IndexOf(":");
        if (colon >= 0) {
            name = act.Substring(0, colon);
            arg = act.Substring(colon + 1, act.Length - colon - 1);
        }
        if (name == "ShowLayer") {
            this.OpenLayer(arg);
        } else if (name == "HideLayer") {
            this.CloseLayer(arg == "self" ? selfLayer : arg);
        } else if (name == "ToggleLayer") {
            this.ToggleLayer(arg == "self" ? selfLayer : arg);
        } else if (name == "CloseAllLayers") {
            this.CloseAllLayers();
        } else if (name == "OpenScene") {
            if (arg.Length > 0) { this.pendingScene = arg; }
        } else {
            // 方法名：代码后置注册的 Action；未注册的名字自然跳过。
            this.CallHandler(act);
        }
        this.actionsRun = this.actionsRun + 1;
    }

    // 设置缩放模式（0 Fit / 1 Fill / 2 Stretch / 3 None，见 ScaleMode）。
    public void SetMode(int m) { this.scaleMode = m; }
    // 设置背景图片资源 id 或路径（"" = 无背景图）。
    public void SetBackground(string img) { this.background = img; }
    // 设置清除色 RGB（各 0..255），运行时窗口的背景清除色。
    public void SetClearColor(int r, int g, int b) { this.bgR = r; this.bgG = g; this.bgB = b; }
    // 清除色红分量（0..255）。
    public int ClearR() { return this.bgR; }
    // 清除色绿分量（0..255）。
    public int ClearG() { return this.bgG; }
    // 清除色蓝分量（0..255）。
    public int ClearB() { return this.bgB; }

    // 计算当前窗口/后备缓冲区尺寸下的画布布局与缩放（坐标换算
    // 的唯一依据）。winW/winH 为窗口尺寸（设备像素）；设计尺寸
    // 非 正 时按 1 处理。返回的 SceneMetrics 含偏移、画布尺寸与
    // 两轴缩放系数。
    public SceneMetrics Metrics(int winW, int winH) {
        SceneMetrics m = new SceneMetrics();
        double dw = (double)this.designWidth;
        double dh = (double)this.designHeight;
        double ww = (double)winW;
        double wh = (double)winH;
        if (dw <= 0.0) { dw = 1.0; }
        if (dh <= 0.0) { dh = 1.0; }
        if (this.scaleMode == 2) {
            // 拉伸
            m.scaleX = ww / dw;
            m.scaleY = wh / dh;
            m.canvasW = ww;
            m.canvasH = wh;
            m.offX = 0.0;
            m.offY = 0.0;
            return m;
        }
        if (this.scaleMode == 3) {
            // 无缩放 (1:1)
            m.scaleX = 1.0;
            m.scaleY = 1.0;
            m.canvasW = dw;
            m.canvasH = dh;
            m.offX = (ww - dw) / 2.0;
            m.offY = (wh - dh) / 2.0;
            return m;
        }
        double sx = ww / dw;
        double sy = wh / dh;
        double s = sx;
        if (this.scaleMode == 1) {
            // 填充：覆盖式（取最大）
            if (sy > s) { s = sy; }
        } else {
            // 适应：信箱式（取最小）
            if (sy < s) { s = sy; }
        }
        m.scaleX = s;
        m.scaleY = s;
        m.canvasW = dw * s;
        m.canvasH = dh * s;
        m.offX = (ww - m.canvasW) / 2.0;
        m.offY = (wh - m.canvasH) / 2.0;
        return m;
    }

    // 将单个元素解析为给定窗口尺寸下的真实设备像素矩形
    // （含网格组总占地）。坐标换算遵循 Metrics 的缩放模式；
    // 返回矩形以元素锚点对齐，适合直接渲染与命中测试。
    public SceneRect Resolve(SceneElement e, int winW, int winH) {
        SceneMetrics m = this.Metrics(winW, winH);
        double ax = (double)e.AnchorX() / 1000.0;
        double ay = (double)e.AnchorY() / 1000.0;
        double ew = (double)e.TotalW() * m.ScaleX();
        double eh = (double)e.TotalH() * m.ScaleY();
        double anchorPxX = m.OffX() + ax * m.CanvasW();
        double anchorPxY = m.OffY() + ay * m.CanvasH();
        double px = anchorPxX + (double)e.X() * m.ScaleX() - ax * ew;
        double py = anchorPxY + (double)e.Y() * m.ScaleY() - ay * eh;
        return SceneRect.Of(px, py, ew, eh);
    }

    // ---- 序列化 -------------------------------------------------

    // int 的十进制字符串（"" 情况不会出现：值已被钳制）。
    public static string IntStr(int v) {
        if (v == 0) { return "0"; }
        bool neg = v < 0;
        int n = v;
        if (neg) { n = 0 - n; }
        string digits = "0123456789";
        string o = "";
        while (n > 0) {
            int d = n % 10;
            o = digits.Substring(d, 1) + o;
            n = n / 10;
        }
        if (neg) { o = "-" + o; }
        return o;
    }

    // 宽松解析场景设计文档（标准 .html 格式）：
    // 优先探测 HTML 格式并解析；解析失败或根非对象时返回字段取默认值的文档。
    // 严格校验请用 TryParse（失败原因见 LastError）。
    public static SceneDoc Parse(string text) {
        if (text != null && (text.IndexOf("<body") >= 0 || text.IndexOf("data-zan-scene") >= 0 || text.IndexOf("<!doctype") >= 0)) {
            SceneDoc hd = new SceneDoc("", 1280, 720);
            if (SceneDoc.FromHtml(text, hd)) { return hd; }
        }
        JsonValue root = JsonValue.ParseLenient(text);
        return SceneDoc.FromRoot(root);
    }

    // 最近一次 Parse 的失败原因（"" = 成功或尚未解析）。
    // Parse 走宽松路径不会置位；TryParse 失败时携带原因。
    public static string lastError;

    // 严格解析：文档必须是完整合法的标准 HTML 场景设计稿或 JSON 对象，
    // 否则返回 false 且 SceneDoc.LastError() 给出原因。
    public static bool TryParse(string text, SceneDoc outDoc) {
        SceneDoc.lastError = "";
        if (text != null && (text.IndexOf("<body") >= 0 || text.IndexOf("data-zan-scene") >= 0 || text.IndexOf("<!doctype") >= 0)) {
            if (SceneDoc.FromHtml(text, outDoc)) {
                return true;
            }
        }
        JsonValue root = null;
        try {
            root = JsonValue.Parse(text);
        } catch (JsonException ex) {
            SceneDoc.lastError = ex.Message;
            return false;
        }
        if (root == null || !root.IsObject()) {
            SceneDoc.lastError = "document is not a valid scene document";
            return false;
        }
        SceneDoc parsed = SceneDoc.FromRoot(root);
        outDoc.adopt(parsed);
        return true;
    }

    // 最近一次 Parse/TryParse 的失败原因（"" = 成功或尚未解析）。
    // Parse 走宽松路径不会置位；TryParse 失败时携带原因。
    public static string LastError() { return SceneDoc.lastError; }

    // 用 parsed 的内容替换 this 的全部字段（TryParse 的
    // out 参数语义：Zan 没有 out 参数，调用方先 new 一个
    // 空文档传入，成功后它就是解析结果）。
    public void adopt(SceneDoc parsed) {
        this.sname = parsed.sname;
        this.designWidth = parsed.designWidth;
        this.designHeight = parsed.designHeight;
        this.scaleMode = parsed.scaleMode;
        this.background = parsed.background;
        this.bgR = parsed.bgR;
        this.bgG = parsed.bgG;
        this.bgB = parsed.bgB;
        this.winCenter = parsed.winCenter;
        this.winPosX = parsed.winPosX;
        this.winPosY = parsed.winPosY;
        this.winTitle = parsed.winTitle;
        this.winResizable = parsed.winResizable;
        this.winChrome = parsed.winChrome;
        this.elements = parsed.elements;
    }

    // 当前激活层集合的快照（';' 分隔，供 SaveJson 之外的
    // 调用方检查）；运行时状态，不写进场景设计文档。
    public string OpenLayers() { return this.openLayers; }

    // 从已解析的 JSON 根对象填充文档字段（Parse / TryParse 共用
    // 的构建路径）。各字段带缺省值：name ""、designWidth 1280、
    // winResizable/winChrome 1、clearColor (18,20,32)。
    public static SceneDoc FromRoot(JsonValue root) {
        SceneDoc d = new SceneDoc(
            root.Str("name", ""),
            root.Int("designWidth", 1280),
            root.Int("designHeight", 720));
        d.scaleMode = root.Int("scaleMode", 0);
        d.winCenter = root.Int("winCenter", 1);
        d.winPosX = root.Int("winPosX", 0);
        d.winPosY = root.Int("winPosY", 0);
        d.winTitle = root.Str("winTitle", "");
        d.winResizable = root.Int("winResizable", 1);
        d.winChrome = root.Int("winChrome", 1);
        d.background = root.Str("background", "");
        JsonValue clear = root.Get("clearColor");
        if (clear != null && clear.IsArray() && clear.Count() >= 3) {
            d.bgR = clear.At(0).AsInt(18);
            d.bgG = clear.At(1).AsInt(20);
            d.bgB = clear.At(2).AsInt(32);
        }
        JsonValue els = root.Get("elements");
        if (els != null && els.IsArray()) {
            for (int i = 0; i < els.Count(); i = i + 1) {
                JsonValue je = els.At(i);
                SceneElement e = new SceneElement(
                    je.Str("kind", "sprite"),
                    je.Str("name", ""));
                e.x = je.Int("x", 0);
                e.y = je.Int("y", 0);
                e.w = je.Int("w", 0);
                e.h = je.Int("h", 0);
                e.anchorX = je.Int("anchorX", 0);
                e.anchorY = je.Int("anchorY", 0);
                e.z = je.Int("z", 0);
                e.image = je.Str("image", "");
                e.text = je.Str("text", "");
                JsonValue col = je.Get("color");
                if (col != null && col.IsArray() && col.Count() >= 4) {
                    e.cr = col.At(0).AsInt(255);
                    e.cg = col.At(1).AsInt(255);
                    e.cb = col.At(2).AsInt(255);
                    e.ca = col.At(3).AsInt(255);
                }
                e.visible = je.Bool("visible", true);
                e.rows = je.Int("rows", 1);
                e.cols = je.Int("cols", 1);
                if (e.rows < 1) { e.rows = 1; }
                if (e.cols < 1) { e.cols = 1; }
                e.gapX = je.Int("gapX", 0);
                e.gapY = je.Int("gapY", 0);
                e.val = je.Int("value", 0);
                e.items = je.Str("items", "");
                e.locked = je.Bool("locked", false);
                e.layer = je.Str("layer", "");
                e.cssClass = je.Str("class", "");
                e.position = je.Int("position", 1);
                e.flexGrow = je.Int("flexGrow", 0);
                e.actions = SceneDoc.OnKeysOf(je);
                // 同步填充强类型实体列表 actionList
                if (e.actions != null && e.actions.IsObject()) {
                    for (int ak = 0; ak < e.actions.Count(); ak = ak + 1) {
                        string akey = e.actions.KeyAt(ak);
                        JsonValue aval = e.actions.ValAt(ak);
                        if (aval != null && aval.IsString()) {
                            e.actionList.Add(new SceneActionBinding(akey, aval.AsString("")));
                        }
                    }
                }
                e.extra = SceneDoc.UnmodeledKeys(je);
                d.elements.Add(e);
            }
        }
        return d;
    }

    // 收集元素对象里运行时未建模的键（含未来版本的扩展声明），
    // 供 ToJson 原样写回（旧运行时打开新设计稿不丢数据）。
    // 没有未建模键时返回 null。
    public static JsonValue UnmodeledKeys(JsonValue o) {
        JsonValue extra = null;
        for (int i = 0; i < o.Count(); i = i + 1) {
            string key = o.KeyAt(i);
            if (SceneDoc.IsModeledKey(key)) { continue; }
            if (extra == null) { extra = JsonValue.NewObject(); }
            extra.Put(key, o.ValAt(i));
        }
        return extra;
    }

    // 提取元素对象里的 on* 键为 {事件名: 动作串} 对象；没有时为
    // null。与 Gui.Designer 的 on<Event> 动态键同一约定。
    // 提取元素对象里的 on* 键为 {事件名: 动作串} 对象（"onClick"
    // 存为键 "Click"）；非字符串值跳过，没有时返回 null。
    // 与 Gui.Designer 的 on<Event> 动态键同一约定。
    public static JsonValue OnKeysOf(JsonValue o) {
        JsonValue acts = null;
        for (int i = 0; i < o.Count(); i = i + 1) {
            string key = o.KeyAt(i);
            if (key.Length < 2 || key.Substring(0, 2) != "on") { continue; }
            JsonValue v = o.ValAt(i);
            if (v == null || !v.IsString()) { continue; }
            if (acts == null) { acts = JsonValue.NewObject(); }
            acts.Put(key.Substring(2), v);
        }
        return acts;
    }

    // k 是否为 SceneElement 建模的键（新增建模键时同步加上，
    // 否则会被 UnmodeledKeys 收集导致 ToJson 重复写出）；
    // on* 动作键也按已建模处理（经 OnKeysOf 单独往返）。
    public static bool IsModeledKey(string k) {
        if (k.Length > 2 && k.Substring(0, 2) == "on") { return true; }
        return k == "kind" || k == "name" || k == "x" || k == "y"
            || k == "w" || k == "h" || k == "anchorX" || k == "anchorY"
            || k == "z" || k == "image" || k == "text" || k == "color"
            || k == "visible" || k == "rows" || k == "cols" || k == "gapX"
            || k == "gapY" || k == "value" || k == "items" || k == "locked"
            || k == "layer" || k == "class" || k == "position" || k == "flexGrow";
    }

    // k 是否为文档级（根对象）已建模的键；ToJson 全量写出，
    // 因此无需参与 UnmodeledKeys，但 FromRoot 之外的手写工具
    // 可据此区分建模键与扩展键。
    public static bool IsModeledDocKey(string k) {
        return k == "name" || k == "designWidth" || k == "designHeight"
            || k == "scaleMode" || k == "winCenter" || k == "winPosX"
            || k == "winPosY" || k == "winTitle" || k == "winResizable"
            || k == "winChrome" || k == "background" || k == "clearColor"
            || k == "elements";
    }

    // 序列化为稳定、便于人工 diff 的兼容 JSON（Pretty 格式）。规范格式请用 ToHtml()。
    // 全量写出文档级字段；元素级省略缺省项（网格/值/条目/锁定/
    // 层为默认时不写），未建模键与 on* 动作键原样往返。
    public string ToJson() {
        JsonValue o = JsonValue.NewObject();
        o.Put("name", JsonValue.NewStr(this.sname));
        o.Put("designWidth", JsonValue.NewNum(Convert.ToString(this.designWidth)));
        o.Put("designHeight", JsonValue.NewNum(Convert.ToString(this.designHeight)));
        o.Put("scaleMode", JsonValue.NewNum(Convert.ToString(this.scaleMode)));
        o.Put("winCenter", JsonValue.NewNum(Convert.ToString(this.winCenter)));
        o.Put("winPosX", JsonValue.NewNum(Convert.ToString(this.winPosX)));
        o.Put("winPosY", JsonValue.NewNum(Convert.ToString(this.winPosY)));
        if (this.WinTitle().Length > 0) {
            o.Put("winTitle", JsonValue.NewStr(this.winTitle));
        }
        o.Put("winResizable", JsonValue.NewNum(Convert.ToString(this.winResizable)));
        o.Put("winChrome", JsonValue.NewNum(Convert.ToString(this.winChrome)));
        o.Put("background", JsonValue.NewStr(this.background));
        JsonValue clear = JsonValue.NewArray();
        clear.Append(JsonValue.NewNum(Convert.ToString(this.bgR)));
        clear.Append(JsonValue.NewNum(Convert.ToString(this.bgG)));
        clear.Append(JsonValue.NewNum(Convert.ToString(this.bgB)));
        o.Put("clearColor", clear);
        JsonValue elems = JsonValue.NewArray();
        for (int i = 0; i < this.elements.Count; i = i + 1) {
            SceneElement e = this.elements[i];
            JsonValue el = JsonValue.NewObject();
            el.Put("kind", JsonValue.NewStr(e.Kind()));
            el.Put("name", JsonValue.NewStr(e.Name()));
            el.Put("x", JsonValue.NewNum(Convert.ToString(e.X())));
            el.Put("y", JsonValue.NewNum(Convert.ToString(e.Y())));
            el.Put("w", JsonValue.NewNum(Convert.ToString(e.W())));
            el.Put("h", JsonValue.NewNum(Convert.ToString(e.H())));
            el.Put("anchorX", JsonValue.NewNum(Convert.ToString(e.AnchorX())));
            el.Put("anchorY", JsonValue.NewNum(Convert.ToString(e.AnchorY())));
            el.Put("z", JsonValue.NewNum(Convert.ToString(e.Z())));
            el.Put("image", JsonValue.NewStr(e.ImageId()));
            el.Put("text", JsonValue.NewStr(e.Text()));
            JsonValue color = JsonValue.NewArray();
            color.Append(JsonValue.NewNum(Convert.ToString(e.R())));
            color.Append(JsonValue.NewNum(Convert.ToString(e.G())));
            color.Append(JsonValue.NewNum(Convert.ToString(e.B())));
            color.Append(JsonValue.NewNum(Convert.ToString(e.A())));
            el.Put("color", color);
            if (e.IsGrid() || e.GapX() != 0 || e.GapY() != 0) {
                el.Put("rows", JsonValue.NewNum(Convert.ToString(e.Rows())));
                el.Put("cols", JsonValue.NewNum(Convert.ToString(e.Cols())));
                el.Put("gapX", JsonValue.NewNum(Convert.ToString(e.GapX())));
                el.Put("gapY", JsonValue.NewNum(Convert.ToString(e.GapY())));
            }
            if (e.Value() != 0) {
                el.Put("value", JsonValue.NewNum(Convert.ToString(e.Value())));
            }
            if (e.Items().Length > 0) {
                el.Put("items", JsonValue.NewStr(e.Items()));
            }
            if (e.Locked()) {
                el.Put("locked", JsonValue.NewBool(true));
            }
            if (e.Layer().Length > 0) {
                el.Put("layer", JsonValue.NewStr(e.Layer()));
            }
            if (e.CssClass().Length > 0) {
                el.Put("class", JsonValue.NewStr(e.CssClass()));
            }
            if (e.Position() != 1) {
                el.Put("position", JsonValue.NewNum(Convert.ToString(e.Position())));
            }
            if (e.FlexGrow() > 0) {
                el.Put("flexGrow", JsonValue.NewNum(Convert.ToString(e.FlexGrow())));
            }
            // on* 动作键原样写回（空串跳过，视为未绑定）。
            if (e.actions != null && e.actions.IsObject()) {
                for (int ak = 0; ak < e.actions.Count(); ak = ak + 1) {
                    JsonValue av = e.actions.ValAt(ak);
                    if (av == null || !av.IsString()) { continue; }
                    string hv = av.AsString("");
                    if (hv.Length == 0) { continue; }
                    el.Put("on" + e.actions.KeyAt(ak), av);
                }
            }
            el.Put("visible", JsonValue.NewBool(e.Visible()));
            // 未建模的键原样写回：手写/新版设计稿里运行时
            // 不认识的声明不能因为一次往返就消失。
            if (e.extra != null && e.extra.IsObject()) {
                for (int xk = 0; xk < e.extra.Count(); xk = xk + 1) {
                    el.Put(e.extra.KeyAt(xk), e.extra.ValAt(xk));
                }
            }
            elems.Append(el);
        }
        o.Put("elements", elems);
        return o.PrettyToJson();
    }

    // HTML 属性转义辅助函数。
    public static string EscAttr(string s) {
        if (s == null) { return ""; }
        StringBuilder b = new StringBuilder();
        for (int i = 0; i < s.Length; i = i + 1) {
            char c = s[i];
            if (c == '&') { b.Append("&amp;"); }
            else if (c == '"') { b.Append("&quot;"); }
            else if (c == '<') { b.Append("&lt;"); }
            else if (c == '>') { b.Append("&gt;"); }
            else { b.Append(c); }
        }
        return b.ToString();
    }

    // 从 HTML 标签串中提取属性值，支持 attr="value" 与 attr='value'。
    public static string ExtractAttr(string tag, string name) {
        if (tag == null || name == null) { return ""; }
        string pattern = " " + name + "=";
        int idx = tag.IndexOf(pattern);
        if (idx < 0) {
            pattern = "\t" + name + "=";
            idx = tag.IndexOf(pattern);
        }
        if (idx < 0) {
            pattern = "\n" + name + "=";
            idx = tag.IndexOf(pattern);
        }
        if (idx < 0) { return ""; }
        int valStart = idx + pattern.Length;
        if (valStart >= tag.Length) { return ""; }
        char quote = tag[valStart];
        if (quote == '"' || quote == '\'') {
            valStart = valStart + 1;
            int endIdx = tag.IndexOf(Convert.ToString(quote), valStart);
            if (endIdx < 0) { return ""; }
            string raw = tag.Substring(valStart, endIdx - valStart);
            return raw.Replace("&quot;", "\"").Replace("&lt;", "<").Replace("&gt;", ">").Replace("&amp;", "&");
        }
        int spaceIdx = tag.IndexOf(" ", valStart);
        int closeIdx = tag.IndexOf(">", valStart);
        int end = spaceIdx;
        if (end < 0 || (closeIdx >= 0 && closeIdx < end)) { end = closeIdx; }
        if (end < 0) { end = tag.Length; }
        return tag.Substring(valStart, end - valStart);
    }

    // 将场景文档序列化为标准 HTML5 设计稿。
    public string ToHtml() {
        StringBuilder b = new StringBuilder();
        b.Append("<!doctype html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>");
        string title = this.WinTitle();
        if (title.Length == 0) { title = this.sname; }
        b.Append(SceneDoc.EscAttr(title));
        b.Append("</title>\n</head>\n<body data-zan-scene=\"");
        b.Append(SceneDoc.EscAttr(this.sname));
        b.Append("\" data-design-width=\"");
        b.Append(Convert.ToString(this.designWidth));
        b.Append("\" data-design-height=\"");
        b.Append(Convert.ToString(this.designHeight));
        b.Append("\" data-scale-mode=\"");
        b.Append(Convert.ToString(this.scaleMode));
        b.Append("\" data-win-center=\"");
        b.Append(Convert.ToString(this.winCenter));
        b.Append("\" data-win-pos-x=\"");
        b.Append(Convert.ToString(this.winPosX));
        b.Append("\" data-win-pos-y=\"");
        b.Append(Convert.ToString(this.winPosY));
        if (this.WinTitle().Length > 0) {
            b.Append("\" data-win-title=\"");
            b.Append(SceneDoc.EscAttr(this.winTitle));
        }
        b.Append("\" data-win-resizable=\"");
        b.Append(Convert.ToString(this.winResizable));
        b.Append("\" data-win-chrome=\"");
        b.Append(Convert.ToString(this.winChrome));
        if (this.background.Length > 0) {
            b.Append("\" data-background=\"");
            b.Append(SceneDoc.EscAttr(this.background));
        }
        b.Append("\" data-clear-color=\"");
        b.Append(Convert.ToString(this.bgR) + "," + Convert.ToString(this.bgG) + "," + Convert.ToString(this.bgB));
        b.Append("\">\n");

        for (int i = 0; i < this.elements.Count; i = i + 1) {
            SceneElement e = this.elements[i];
            b.Append("  <div id=\"");
            b.Append(SceneDoc.EscAttr(e.Name()));
            b.Append("\" data-kind=\"");
            b.Append(SceneDoc.EscAttr(e.Kind()));
            b.Append("\" data-x=\"");
            b.Append(Convert.ToString(e.X()));
            b.Append("\" data-y=\"");
            b.Append(Convert.ToString(e.Y()));
            b.Append("\" data-w=\"");
            b.Append(Convert.ToString(e.W()));
            b.Append("\" data-h=\"");
            b.Append(Convert.ToString(e.H()));
            b.Append("\" data-anchor-x=\"");
            b.Append(Convert.ToString(e.AnchorX()));
            b.Append("\" data-anchor-y=\"");
            b.Append(Convert.ToString(e.AnchorY()));
            b.Append("\" data-z=\"");
            b.Append(Convert.ToString(e.Z()));
            if (e.ImageId().Length > 0) {
                b.Append("\" data-image=\"");
                b.Append(SceneDoc.EscAttr(e.ImageId()));
            }
            if (e.Text().Length > 0) {
                b.Append("\" data-text=\"");
                b.Append(SceneDoc.EscAttr(e.Text()));
            }
            b.Append("\" data-color=\"");
            b.Append(Convert.ToString(e.R()) + "," + Convert.ToString(e.G()) + "," + Convert.ToString(e.B()) + "," + Convert.ToString(e.A()));
            if (e.IsGrid() || e.GapX() != 0 || e.GapY() != 0) {
                b.Append("\" data-rows=\"");
                b.Append(Convert.ToString(e.Rows()));
                b.Append("\" data-cols=\"");
                b.Append(Convert.ToString(e.Cols()));
                b.Append("\" data-gap-x=\"");
                b.Append(Convert.ToString(e.GapX()));
                b.Append("\" data-gap-y=\"");
                b.Append(Convert.ToString(e.GapY()));
            }
            if (e.Value() != 0) {
                b.Append("\" data-value=\"");
                b.Append(Convert.ToString(e.Value()));
            }
            if (e.Items().Length > 0) {
                b.Append("\" data-items=\"");
                b.Append(SceneDoc.EscAttr(e.Items()));
            }
            if (e.Locked()) {
                b.Append("\" data-locked=\"true");
            }
            if (e.Layer().Length > 0) {
                b.Append("\" data-layer=\"");
                b.Append(SceneDoc.EscAttr(e.Layer()));
            }
            if (e.CssClass().Length > 0) {
                b.Append("\" class=\"");
                b.Append(SceneDoc.EscAttr(e.CssClass()));
            }
            if (e.Position() != 1) {
                b.Append("\" data-position=\"");
                b.Append(Convert.ToString(e.Position()));
            }
            if (e.FlexGrow() > 0) {
                b.Append("\" data-flex-grow=\"");
                b.Append(Convert.ToString(e.FlexGrow()));
            }
            if (!e.Visible()) {
                b.Append("\" data-visible=\"false");
            }
            if (e.actions != null && e.actions.IsObject()) {
                for (int ak = 0; ak < e.actions.Count(); ak = ak + 1) {
                    JsonValue av = e.actions.ValAt(ak);
                    if (av == null || !av.IsString()) { continue; }
                    string hv = av.AsString("");
                    if (hv.Length == 0) { continue; }
                    b.Append("\" data-on-" + e.actions.KeyAt(ak).ToLower() + "=\"");
                    b.Append(SceneDoc.EscAttr(hv));
                }
            }
            b.Append("\"></div>\n");
        }
        b.Append("</body>\n</html>\n");
        return b.ToString();
    }

    // 十进制字符串转 int，解析失败或空串返回 defVal。
    public static int ParseInt(string s, int defVal) {
        if (s == null || s.Length == 0) { return defVal; }
        string t = s.Trim();
        if (t.Length == 0) { return defVal; }
        bool neg = false;
        int idx = 0;
        if (t[0] == '-') {
            neg = true;
            idx = 1;
        } else if (t[0] == '+') {
            idx = 1;
        }
        if (idx >= t.Length) { return defVal; }
        int val = 0;
        while (idx < t.Length) {
            char c = t[idx];
            if (c < '0' || c > '9') { return defVal; }
            val = val * 10 + ((int)c - (int)'0');
            idx = idx + 1;
        }
        return neg ? (0 - val) : val;
    }

    // 从标准 HTML 设计稿反序列化场景文档。
    public static bool FromHtml(string html, SceneDoc outDoc) {
        if (html == null || html.Length == 0) { return false; }
        int bodyStart = html.IndexOf("<body");
        if (bodyStart < 0) { return false; }
        int bodyTagEnd = html.IndexOf(">", bodyStart);
        if (bodyTagEnd < 0) { return false; }
        string bodyTag = html.Substring(bodyStart, bodyTagEnd - bodyStart);

        string sname = SceneDoc.ExtractAttr(bodyTag, "data-zan-scene");
        if (sname.Length == 0) { sname = SceneDoc.ExtractAttr(bodyTag, "data-scene"); }
        if (sname.Length == 0) { sname = SceneDoc.ExtractAttr(bodyTag, "id"); }
        int dw = SceneDoc.ParseInt(SceneDoc.ExtractAttr(bodyTag, "data-design-width"), 1280);
        int dh = SceneDoc.ParseInt(SceneDoc.ExtractAttr(bodyTag, "data-design-height"), 720);

        outDoc.sname = sname;
        outDoc.designWidth = dw;
        outDoc.designHeight = dh;
        outDoc.scaleMode = SceneDoc.ParseInt(SceneDoc.ExtractAttr(bodyTag, "data-scale-mode"), 0);
        outDoc.winCenter = SceneDoc.ParseInt(SceneDoc.ExtractAttr(bodyTag, "data-win-center"), 1);
        outDoc.winPosX = SceneDoc.ParseInt(SceneDoc.ExtractAttr(bodyTag, "data-win-pos-x"), 0);
        outDoc.winPosY = SceneDoc.ParseInt(SceneDoc.ExtractAttr(bodyTag, "data-win-pos-y"), 0);
        outDoc.winTitle = SceneDoc.ExtractAttr(bodyTag, "data-win-title");
        outDoc.winResizable = SceneDoc.ParseInt(SceneDoc.ExtractAttr(bodyTag, "data-win-resizable"), 1);
        outDoc.winChrome = SceneDoc.ParseInt(SceneDoc.ExtractAttr(bodyTag, "data-win-chrome"), 1);
        outDoc.background = SceneDoc.ExtractAttr(bodyTag, "data-background");

        string clearStr = SceneDoc.ExtractAttr(bodyTag, "data-clear-color");
        if (clearStr.Length > 0) {
            List<string> parts = clearStr.Split(",");
            if (parts.Count >= 3) {
                outDoc.bgR = SceneDoc.ParseInt(parts[0], 18);
                outDoc.bgG = SceneDoc.ParseInt(parts[1], 20);
                outDoc.bgB = SceneDoc.ParseInt(parts[2], 32);
            }
        }

        outDoc.elements = new List<SceneElement>();
        int searchPos = bodyTagEnd;
        while (searchPos < html.Length) {
            int divStart = html.IndexOf("<div", searchPos);
            if (divStart < 0) { break; }
            int divTagEnd = html.IndexOf(">", divStart);
            if (divTagEnd < 0) { break; }
            string divTag = html.Substring(divStart, divTagEnd - divStart);

            string ename = SceneDoc.ExtractAttr(divTag, "id");
            string kind = SceneDoc.ExtractAttr(divTag, "data-kind");
            if (kind.Length == 0) { kind = "panel"; }
            if (ename.Length == 0) { ename = kind + SceneDoc.IntStr(outDoc.elements.Count + 1); }

            SceneElement e = new SceneElement(kind, ename);
            e.x = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-x"), 0);
            e.y = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-y"), 0);
            e.w = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-w"), 0);
            e.h = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-h"), 0);
            e.anchorX = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-anchor-x"), 0);
            e.anchorY = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-anchor-y"), 0);
            e.z = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-z"), 0);
            e.image = SceneDoc.ExtractAttr(divTag, "data-image");
            e.text = SceneDoc.ExtractAttr(divTag, "data-text");

            string cStr = SceneDoc.ExtractAttr(divTag, "data-color");
            if (cStr.Length > 0) {
                List<string> cp = cStr.Split(",");
                if (cp.Count >= 4) {
                    e.cr = SceneDoc.ParseInt(cp[0], 255);
                    e.cg = SceneDoc.ParseInt(cp[1], 255);
                    e.cb = SceneDoc.ParseInt(cp[2], 255);
                    e.ca = SceneDoc.ParseInt(cp[3], 255);
                }
            }

            e.rows = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-rows"), 1);
            e.cols = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-cols"), 1);
            e.gapX = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-gap-x"), 0);
            e.gapY = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-gap-y"), 0);
            e.val = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-value"), 0);
            e.items = SceneDoc.ExtractAttr(divTag, "data-items");
            if (SceneDoc.ExtractAttr(divTag, "data-locked") == "true") { e.locked = true; }
            e.layer = SceneDoc.ExtractAttr(divTag, "data-layer");
            e.cssClass = SceneDoc.ExtractAttr(divTag, "class");
            e.position = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-position"), 1);
            e.flexGrow = SceneDoc.ParseInt(SceneDoc.ExtractAttr(divTag, "data-flex-grow"), 0);
            if (SceneDoc.ExtractAttr(divTag, "data-visible") == "false") { e.visible = false; }

            string onClick = SceneDoc.ExtractAttr(divTag, "data-on-click");
            if (onClick.Length > 0) { e.On("Click", onClick); }

            outDoc.elements.Add(e);
            searchPos = divTagEnd + 1;
        }

        return true;
    }
}
