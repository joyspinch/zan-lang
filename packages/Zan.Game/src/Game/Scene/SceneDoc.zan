using System;
using System.Collections.Generic;
using System.Json;
using Gui;

namespace Game.Scene;

/// <summary>
/// 作者定义的设计分辨率如何映射到实际窗口/后备缓冲区。
/// 取值：Fit 等比缩放信箱式（保持宽高比，可能黑边）、Fill 等比
/// 缩放覆盖式（保持宽高比，可能裁边）、Stretch 非等比完全填充
/// （可能变形）、None 1:1 不缩放（设计像素等于屏幕像素）。
/// </summary>
class ScaleMode {
    /// 缩放模式常量：Fit（等比信箱式），返回 0。
    static int Fit() { return 0; }
    /// 缩放模式常量：Fill（等比覆盖式），返回 1。
    static int Fill() { return 1; }
    /// 缩放模式常量：Stretch（非等比拉伸填满），返回 2。
    static int Stretch() { return 2; }
    /// 缩放模式常量：None（1:1 不缩放），返回 3。
    static int None() { return 3; }
}

/// <summary>
/// 以千分比（0..1000）表示的九宫格锚点预设，500 为中心。
/// 元素的锚点同时决定画布上的参考点和元素自身的轴心：
/// (0,0)=左上角、(1000,1000)=右下角、(500,500)=与分辨率
/// 无关的完美居中。
/// </summary>
class Anchor {
    /// 锚点常量：最小值（左/上边缘），返回 0。
    static int Min() { return 0; }
    /// 锚点常量：中心，返回 500（千分比）。
    static int Mid() { return 500; }
    /// 锚点常量：最大值（右/下边缘），返回 1000。
    static int Max() { return 1000; }
}

// 解析到屏幕上的矩形，单位为真实设备像素。
/// <summary>
/// 解析到屏幕上的矩形，单位为真实设备像素（非设计像素）。
/// 由 SceneDoc.Resolve 依据当前缩放模式计算得出。
/// </summary>
class SceneRect {
    double x;
    double y;
    double w;
    double h;

    /// 构造矩形：x/y 为左上角设备像素坐标，w/h 为宽高。
    static SceneRect Of(double x, double y, double w, double h) {
        SceneRect r = new SceneRect();
        r.x = x; r.y = y; r.w = w; r.h = h;
        return r;
    }
    /// 左上角设备像素 X（浮点）。
    double X() { return this.x; }
    /// 左上角设备像素 Y（浮点）。
    double Y() { return this.y; }
    /// 宽（设备像素，浮点）。
    double W() { return this.w; }
    /// 高（设备像素，浮点）。
    double H() { return this.h; }
    /// 左上角 X 的整数截断（向零取整）。
    int Xi() { return (int)this.x; }
    /// 左上角 Y 的整数截断（向零取整）。
    int Yi() { return (int)this.y; }
    /// 宽的整数截断（向零取整）。
    int Wi() { return (int)this.w; }
    /// 高的整数截断（向零取整）。
    int Hi() { return (int)this.h; }
}

/// <summary>
/// 当前窗口的缩放画布布局：设计画布渲染在 (offX, offY)，
/// 尺寸为 (canvasW, canvasH)，各轴缩放为 (scaleX, scaleY)。
/// 由 SceneDoc.Metrics 依据缩放模式计算，单位为设备像素。
/// </summary>
class SceneMetrics {
    double offX;
    double offY;
    double canvasW;
    double canvasH;
    double scaleX;
    double scaleY;

    /// 画布左上角在窗口内的设备像素偏移 X。
    double OffX() { return this.offX; }
    /// 画布左上角在窗口内的设备像素偏移 Y。
    double OffY() { return this.offY; }
    /// 画布缩放后的实际宽度（设备像素）。
    double CanvasW() { return this.canvasW; }
    /// 画布缩放后的实际高度（设备像素）。
    double CanvasH() { return this.canvasH; }
    /// 水平缩放系数（设计像素 -> 设备像素；Stretch 模式下两轴可不同）。
    double ScaleX() { return this.scaleX; }
    /// 垂直缩放系数（设计像素 -> 设备像素）。
    double ScaleY() { return this.scaleY; }
}

// 单个放置的元素。位置/尺寸以*设计*像素编写。anchorX /
// anchorY 为千分比（0..1000）。x/y 是相对锚点的偏移，因此
// 锚定左上角的血条在任何分辨率下都保持角偏移，
// 而居中的准星（锚点 500/500，x=0，y=0）始终居中。
/// <summary>
/// 单个放置的元素。位置/尺寸以设计像素编写；anchorX/anchorY
/// 为千分比（0..1000），x/y 是相对锚点的偏移，因此锚定左上角
/// 的血条在任何分辨率下都保持角偏移，而居中的准星（锚点
/// 500/500，x=0，y=0）始终居中。
///
/// 种类 kind 为设计器与运行时渲染器可识别的名字：控件有
/// label/button/imagebox/animbox/textbox/progressbar/skillslot/
/// quickslot/bagslot/itemslot/avatarbox/checkbox/tabbox/container/
/// minimap/slider/scrollbar/combobox/input/listbox，绘制组件有
/// text/arttext/sprite/rect/circle/anim；旧种类（"bar"、"panel"）
/// 仍可解析。格子类元素可组成网格组：rows x cols 个 w x h 单元，
/// 间距为 (gapX, gapY)。
/// </summary>
class SceneElement {
    string kind;
    string ename;
    int x;
    int y;
    int w;
    int h;
    int anchorX;      // 千分比 0..1000
    int anchorY;      // 千分比 0..1000
    int z;            // 绘制顺序（小的先）
    string image;     // 精灵/按钮/面板的资源 id / 路径
    string text;      // 标签/按钮/条的标题文本
    int cr;
    int cg;
    int cb;
    int ca;
    bool visible;
    int rows;         // 网格组行数（>=1）；1x1 = 单个元素
    int cols;         // 网格组列数（>=1）
    int gapX;         // 网格单元之间的水平间距（设计像素）
    int gapY;         // 网格单元之间的垂直间距（设计像素）
    int val;          // 进度条/滑块/滚动条 0..100，复选框 0/1
    string items;     // 下拉框/列表框/选项卡框的 ';' 分隔条目
    bool locked;      // 仅设计器使用：元素不可移动/缩放
    // 归属层名（"" = 基础层）。同一层的元素作为一个浮层整体
    // 显隐（弹窗/菜单页/对话框），运行时按激活层集合过滤渲染。
    string layer;
    // 声明式事件绑定（on* 键，如 "onClick"），值是动作串。动作串
    // 可以是内置动作（"ShowLayer:bag"、"HideLayer:self"、
    // "ToggleLayer:equip"、"CloseTopLayer"）或代码后置方法名
    // （"OnBuyClicked"，经 handlers 注册的 Action 触发）。
    // 多个动作用 ';' 串接，按序执行。与 Gui.Designer 的 on<Event>
    // 键同一形状：存储动作名，运行时解释，设计器只管编辑。
    JsonValue actions;
    // 设计器未建模的键（未来版本/手写设计稿的额外声明）。
    // 往返时原样写回，使旧运行时打开新设计稿不丢数据——
    // 与 Gui.Designer 的 FormField.extra 同一策略。
    JsonValue extra;

    SceneElement(string kind, string name) {
        this.kind = kind;
        this.ename = name;
        this.x = 0; this.y = 0; this.w = 0; this.h = 0;
        this.anchorX = 0; this.anchorY = 0;
        this.z = 0;
        this.image = "";
        this.text = "";
        this.cr = 255; this.cg = 255; this.cb = 255; this.ca = 255;
        this.visible = true;
        this.rows = 1; this.cols = 1;
        this.gapX = 0; this.gapY = 0;
        this.val = 0;
        this.items = "";
        this.locked = false;
        this.layer = "";
        this.actions = null;
    }

    /// 设置设计空间位置（x/y 为相对锚点的偏移），返回自身以链式调用。
    SceneElement At(int x, int y) { this.x = x; this.y = y; return this; }
    /// 设置单个单元的设计像素尺寸，返回自身以链式调用。
    SceneElement Size(int w, int h) { this.w = w; this.h = h; return this; }
    /// 设置九宫格锚点（ax/ay 千分比 0..1000），返回自身以链式调用。
    SceneElement AnchorTo(int ax, int ay) { this.anchorX = ax; this.anchorY = ay; return this; }
    /// 设置绘制顺序 z（小者先画），返回自身以链式调用。
    SceneElement Order(int z) { this.z = z; return this; }
    /// 设置精灵/按钮/面板的资源 id 或路径，返回自身以链式调用。
    SceneElement Image(string img) { this.image = img; return this; }
    /// 设置标签/按钮等的标题文本，返回自身以链式调用。
    SceneElement Caption(string t) { this.text = t; return this; }
    /// 设置着色 RGBA（各分量 0..255），作用于填充与精灵染色，返回自身以链式调用。
    SceneElement Tint(int r, int g, int b, int a) {
        this.cr = r; this.cg = g; this.cb = b; this.ca = a; return this;
    }
    /// 设置可见性（false 的元素不渲染也不参与命中），返回自身以链式调用。
    SceneElement SetVisible(bool v) { this.visible = v; return this; }
    /// 设置网格组行列数与单元间距（设计像素）；rows/cols 小于 1 时钳制为 1，返回自身以链式调用。
    SceneElement Grid(int rows, int cols, int gapX, int gapY) {
        this.rows = rows; this.cols = cols;
        this.gapX = gapX; this.gapY = gapY;
        if (this.rows < 1) { this.rows = 1; }
        if (this.cols < 1) { this.cols = 1; }
        return this;
    }
    /// 设置值：进度条/滑块/滚动条为 0..100，复选框为 0/1，返回自身以链式调用。
    SceneElement SetValue(int v) { this.val = v; return this; }
    /// 设置下拉框/列表框/选项卡的 ';' 分隔条目串，返回自身以链式调用。
    SceneElement SetItems(string s) { this.items = s; return this; }
    /// 设置设计器锁定标记（锁定后不可拖动/缩放），返回自身以链式调用。
    SceneElement SetLocked(bool v) { this.locked = v; return this; }
    /// 设置归属层名（"" = 基础层），返回自身以链式调用。
    SceneElement SetLayer(string layer) { this.layer = layer; return this; }

    /// 绑定一个 on* 动作串（如 On("onClick", "ShowLayer:bag")）。
    /// 空值清除该事件的绑定。
    SceneElement On(string evt, string actions) {
        if (this.actions == null) { this.actions = JsonValue.NewObject(); }
        this.actions.Set(evt, JsonValue.NewStr(actions == null ? "" : actions));
        return this;
    }

    /// 绑定到 `evt` 的动作串（如 "onClick" -> "ShowLayer:bag"），
    /// 无绑定为 ""。空串视为未绑定。
    string OnAction(string evt) {
        if (this.actions == null) { return ""; }
        JsonValue v = this.actions.Get(evt);
        if (v == null || !v.IsString()) { return ""; }
        return v.AsString("");
    }

    /// 元素种类名（如 "label"、"sprite"），与文档里的 kind 字段一致。
    string Kind() { return this.kind; }
    /// 元素名（文档内唯一；重名会导致编译期投影生成重复字段）。
    string Name() { return this.ename; }
    /// 相对锚点的水平偏移（设计像素）。
    int X() { return this.x; }
    /// 相对锚点的垂直偏移（设计像素）。
    int Y() { return this.y; }
    /// 单个单元宽（设计像素；总占地见 TotalW）。
    int W() { return this.w; }
    /// 单个单元高（设计像素；总占地见 TotalH）。
    int H() { return this.h; }
    /// 水平锚点千分比（0..1000）。
    int AnchorX() { return this.anchorX; }
    /// 垂直锚点千分比（0..1000）。
    int AnchorY() { return this.anchorY; }
    /// 绘制顺序（小者先画）。
    int Z() { return this.z; }
    /// 精灵/按钮/面板的资源 id 或路径（"" = 无）。
    string ImageId() { return this.image; }
    /// 标签/按钮等的标题文本。
    string Text() { return this.text; }
    /// 着色红分量（0..255）。
    int R() { return this.cr; }
    /// 着色绿分量（0..255）。
    int G() { return this.cg; }
    /// 着色蓝分量（0..255）。
    int B() { return this.cb; }
    /// 着色 alpha 分量（0..255；设计器的幽灵元素也用它近似半透明）。
    int A() { return this.ca; }
    /// 是否可见（false 不渲染且不参与命中）。
    bool Visible() { return this.visible; }
    /// 网格组行数（>=1；1 = 单行）。
    int Rows() { return this.rows; }
    /// 网格组列数（>=1；1 = 单列）。
    int Cols() { return this.cols; }
    /// 网格单元水平间距（设计像素）。
    int GapX() { return this.gapX; }
    /// 网格单元垂直间距（设计像素）。
    int GapY() { return this.gapY; }
    /// 值：进度条/滑块/滚动条 0..100，复选框 0/1。
    int Value() { return this.val; }
    /// 下拉框/列表框/选项卡的 ';' 分隔条目串。
    string Items() { return this.items; }
    /// 设计器锁定标记（锁定后不可拖动/缩放）。
    bool Locked() { return this.locked; }
    /// 归属层名（"" = 基础层；命名层需被打开才渲染/命中）。
    string Layer() { return this.layer; }
    /// 是否为网格组（rows 或 cols 大于 1）。
    bool IsGrid() { return this.rows > 1 || this.cols > 1; }

    /// 网格组总占地宽（设计像素）：cols 个单元加列间间距；单个元素等于 w。
    int TotalW() { return this.cols * this.w + (this.cols - 1) * this.gapX; }
    /// 网格组总占地高（设计像素）：rows 个单元加行间间距；单个元素等于 h。
    int TotalH() { return this.rows * this.h + (this.rows - 1) * this.gapY; }
}

// `.zscene` 文档：设计分辨率画布、背景，以及一个扁平的、
// 按 z 排序的绝对定位 HUD/场景元素列表。这是
// Zan IDE 场景设计器读写所依据的运行时契约。
/// <summary>
/// `.zscene` 文档：设计分辨率画布、背景，以及一个扁平的、
/// 按 z 排序的绝对定位 HUD/场景元素列表。这是 Zan IDE 场景
/// 设计器读写所依据的运行时契约；同时承载运行时的层（弹窗/
/// 菜单页）激活状态与声明式动作解释。
/// </summary>
class SceneDoc {
    string sname;
    int designWidth;
    int designHeight;
    int scaleMode;
    string background;   // 背景图片资源 id / 路径（可为空）
    int bgR;
    int bgG;
    int bgB;
    int winCenter;   // 1 = 显示时窗口居中（默认）；0 = 手动位置
    int winPosX;     // 手动窗口 X（winCenter == 0 时使用）
    int winPosY;     // 手动窗口 Y（winCenter == 0 时使用）
    // 窗口基础属性：标题（默认用场景名）、可调整大小、标题栏。
    // 与 Gui.Designer 的 winTitle/winResizable/winChrome 同名同义。
    string winTitle;
    int winResizable;   // 1 = 可拖边框缩放（默认）；0 = 固定尺寸
    int winChrome;      // 1 = 显示标题栏（默认）；0 = 无边框
    List<SceneElement> elements;

    SceneDoc(string name, int designWidth, int designHeight) {
        this.sname = name;
        this.designWidth = designWidth;
        this.designHeight = designHeight;
        this.scaleMode = 0;
        this.background = "";
        this.bgR = 18; this.bgG = 20; this.bgB = 32;
        this.winCenter = 1;
        this.winPosX = 0;
        this.winPosY = 0;
        this.winTitle = "";
        this.winResizable = 1;
        this.winChrome = 1;
        this.elements = new List<SceneElement>();
    }

    /// 追加一个元素到文档末尾；返回该元素（便于链式配置）。
    SceneElement Add(SceneElement e) {
        this.elements.Add(e);
        return e;
    }

    /// 按名字查找元素；不存在时返回 null。
    SceneElement Find(string name) {
        for (int i = 0; i < this.elements.Count; i = i + 1) {
            if (this.elements[i].Name() == name) { return this.elements[i]; }
        }
        return null;
    }

    /// 元素数量。
    int Count() { return this.elements.Count; }
    /// 返回第 i 个元素（按添加顺序；i 越界行为未定义，调用方保证 0 <= i < Count）。
    SceneElement ElementAt(int i) { return this.elements[i]; }
    /// 场景名（.zscene 的 name 字段）。
    string Name() { return this.sname; }
    /// 设计画布宽（设计像素）。
    int DesignWidth() { return this.designWidth; }
    /// 设计画布高（设计像素）。
    int DesignHeight() { return this.designHeight; }
    /// 缩放模式（0 Fit / 1 Fill / 2 Stretch / 3 None，见 ScaleMode）。
    int Mode() { return this.scaleMode; }
    /// 窗口显示时是否居中：1 = 居中（默认），0 = 用手动位置。
    int WinCenter() { return this.winCenter; }
    /// 设置窗口是否居中：1 = 居中，0 = 用 SetWinPos 设置的手动位置。
    void SetWinCenter(int v) { this.winCenter = v; }
    /// 手动窗口位置 X（仅 winCenter == 0 时生效）。
    int WinPosX() { return this.winPosX; }
    /// 手动窗口位置 Y（仅 winCenter == 0 时生效）。
    int WinPosY() { return this.winPosY; }
    /// 设置手动窗口位置（仅 winCenter == 0 时生效）。
    void SetWinPos(int x, int y) { this.winPosX = x; this.winPosY = y; }
    /// 背景图片资源 id 或路径（"" = 无背景图）。
    string Background() { return this.background; }

    /// 窗口标题；空 = 用场景名。
    string WinTitle() {
        if (this.winTitle == null) { return ""; }
        return this.winTitle;
    }
    /// 设置窗口标题（写入 .zscene 的 winTitle；空 = 运行时用场景名）。
    void SetWinTitle(string s) { this.winTitle = s; }

    /// 窗口可调整大小（默认 true）。
    bool WinResizable() { return this.winResizable != 0; }
    /// 设置窗口可否拖边框缩放（默认 true）。
    void SetWinResizable(bool v) { this.winResizable = v ? 1 : 0; }

    /// 显示标题栏（默认 true）；关闭后窗口无边框，由场景自绘。
    bool WinChrome() { return this.winChrome != 0; }
    /// 设置是否显示系统标题栏（默认 true）；关闭后窗口无边框，由场景自绘。
    void SetWinChrome(bool v) { this.winChrome = v ? 1 : 0; }

    // ---- 运行时层（弹窗/菜单页）激活 --------------------------------

    // 激活的层名集合（';' 分隔）。空串 = 只有基础层（layer == ""
    // 的元素）可见。基础层永远渲染；这里只列"额外"打开的浮层。
    string openLayers;
    // 命中测试/事件分发是否遵循层：默认 false（Find/Resolve 对
    // 整份文档工作，纯数据查询）。运行时交互开启后，隐藏层的
    // 元素不响应命中。
    bool layersActive;
    // 元素 on* 动作串里的方法名 -> 业务 Action 表（与 Gui 的
    // HandlerRegistry 契约相同）：设计只存名字，代码后置用
    // SetHandler("OnBuyClicked", ...) 注册；未注册的名字触发时
    // 自然跳过。
    List<string> handlerNames;
    List<Action> handlerFns;

    /// 注册（或替换）动作方法名 `name` 的 Action，供元素
    /// on* 绑定里的非内置动作触发。
    void SetHandler(string name, Action a) {
        if (this.handlerNames == null) {
            this.handlerNames = new List<string>();
            this.handlerFns = new List<Action>();
        }
        for (int i = 0; i < this.handlerNames.Count; i = i + 1) {
            if (this.handlerNames[i] == name) { this.handlerFns[i] = a; return; }
        }
        this.handlerNames.Add(name);
        this.handlerFns.Add(a);
    }

    /// 触发为 `name` 注册的 Action；未注册的名字是空操作。
    void CallHandler(string name) {
        if (this.handlerNames == null) { return; }
        for (int i = 0; i < this.handlerNames.Count; i = i + 1) {
            if (this.handlerNames[i] == name) {
                Action a = this.handlerFns[i];
                if (a != null) { a(); }
                return;
            }
        }
    }

    /// 打开交互模式：LayerHit 开始按激活层过滤。纯渲染
    /// （SceneView.Render）无需开启——渲染本来就按层过滤。
    void SetLayersActive(bool v) { this.layersActive = v; }

    /// 命中测试语义下元素是否可交互：visible 且其层处于
    /// 打开状态。设计器/运行时点击分发共用这一判定。
    bool ElementHit(SceneElement e) {
        return e.Visible() && this.LayerOpen(e.Layer());
    }

    /// layer 的元素是否参与本帧渲染：基础层永远 true，其它层
    /// 需要被 OpenLayer 打开过。
    bool LayerOpen(string layer) {
        if (layer.Length == 0) { return true; }
        string cur = this.openLayers;
        if (cur == null || cur.Length == 0) { return false; }
        int start = 0;
        while (start <= cur.Length) {
            int end = cur.IndexOf(";", start);
            string part;
            if (end < 0) {
                part = cur.Substring(start, cur.Length - start);
            } else {
                part = cur.Substring(start, end - start);
            }
            if (part == layer && part.Length > 0) { return true; }
            if (end < 0) { break; }
            start = end + 1;
        }
        return false;
    }

    /// 打开一个层（弹窗/菜单页）；重复打开是幂等的。
    void OpenLayer(string layer) {
        if (layer.Length == 0 || this.LayerOpen(layer)) { return; }
        if (this.openLayers == null || this.openLayers.Length == 0) {
            this.openLayers = layer;
        } else {
            this.openLayers = this.openLayers + ";" + layer;
        }
    }

    /// 关闭一个层；本来就没开是幂等的。
    void CloseLayer(string layer) {
        if (layer.Length == 0) { return; }
        string outp = "";
        string cur = this.openLayers;
        if (cur == null || cur.Length == 0) { return; }
        int start = 0;
        while (start <= cur.Length) {
            int end = cur.IndexOf(";", start);
            string part;
            if (end < 0) {
                part = cur.Substring(start, cur.Length - start);
            } else {
                part = cur.Substring(start, end - start);
            }
            if (part.Length > 0 && part != layer) {
                if (outp.Length > 0) { outp = outp + ";"; }
                outp = outp + part;
            }
            if (end < 0) { break; }
            start = end + 1;
        }
        this.openLayers = outp;
    }

    /// 层开关切换；返回切换后是否打开。
    bool ToggleLayer(string layer) {
        if (this.LayerOpen(layer)) {
            this.CloseLayer(layer);
            return false;
        }
        this.OpenLayer(layer);
        return true;
    }

    /// 关闭所有已打开的浮层（回基础层）。
    void CloseAllLayers() { this.openLayers = ""; }

    // ---- 声明式动作（元素 on* 绑定的解释器）-------------------------

    // 场景切换动作（"OpenScene:xxx"）触发时记录目标场景名：
    // RunActions 自己不能建窗口（它运行在当前窗口的帧循环里），
    // 由生成的 Run() 循环检查该标记并在帧尾换场景——与
    // App.isRunning 同一模式。"" = 无待处理切换。
    string pendingScene;

    /// 待切换的目标场景名（"OpenScene:xxx" 排队的目标）；
    /// "" = 无待处理切换。生成的主循环读它换场景。
    string PendingScene() {
        if (this.pendingScene == null) { return ""; }
        return this.pendingScene;
    }

    /// 清除待处理场景切换（主循环消费后调用）。
    void ClearPendingScene() { this.pendingScene = ""; }

    /// 最近一次 RunActions 执行的内置动作数（测试观测点）。
    int actionsRun;

    /// 上一帧（每次 HandleClicks）触发的方法名处理器记录的最后
    /// 一个名字；测试观测点，"" = 未触发方法名。
    string lastHandler;

    /// 执行一个动作串：内置动作立即生效，方法名查 handlers 表。
    /// `selfLayer` 是发起元素所属层，供 "HideLayer:self" /
    /// "ToggleLayer:self" 相对引用。多个动作用 ';' 串接按序执行。
    void RunActions(string actions, string selfLayer) {
        if (actions == null || actions.Length == 0) { return; }
        int start = 0;
        while (start <= actions.Length) {
            int end = actions.IndexOf(";", start);
            string part;
            if (end < 0) {
                part = actions.Substring(start, actions.Length - start);
            } else {
                part = actions.Substring(start, end - start);
            }
            this.RunOneAction(part.Trim(), selfLayer);
            if (end < 0) { break; }
            start = end + 1;
        }
    }

    /// 执行单个动作（RunActions 的内部分派）：识别 "动作:参数"
    /// 与 "动作"（无参）两种形态；未识别的名字按代码后置方法名
    /// 查 handlers 表，未注册时为空操作。
    void RunOneAction(string act, string selfLayer) {
        if (act.Length == 0) { return; }
        // "动作:参数" 与 "动作"（无参）两种形态。
        string name = act;
        string arg = "";
        int colon = act.IndexOf(":");
        if (colon >= 0) {
            name = act.Substring(0, colon);
            arg = act.Substring(colon + 1, act.Length - colon - 1);
        }
        if (name == "ShowLayer") {
            this.OpenLayer(arg);
        } else if (name == "HideLayer") {
            this.CloseLayer(arg == "self" ? selfLayer : arg);
        } else if (name == "ToggleLayer") {
            this.ToggleLayer(arg == "self" ? selfLayer : arg);
        } else if (name == "CloseAllLayers") {
            this.CloseAllLayers();
        } else if (name == "OpenScene") {
            if (arg.Length > 0) { this.pendingScene = arg; }
        } else {
            // 方法名：代码后置注册的 Action；未注册的名字自然跳过。
            this.CallHandler(act);
        }
        this.actionsRun = this.actionsRun + 1;
    }

    /// 设置缩放模式（0 Fit / 1 Fill / 2 Stretch / 3 None，见 ScaleMode）。
    void SetMode(int m) { this.scaleMode = m; }
    /// 设置背景图片资源 id 或路径（"" = 无背景图）。
    void SetBackground(string img) { this.background = img; }
    /// 设置清除色 RGB（各 0..255），运行时窗口的背景清除色。
    void SetClearColor(int r, int g, int b) { this.bgR = r; this.bgG = g; this.bgB = b; }
    /// 清除色红分量（0..255）。
    int ClearR() { return this.bgR; }
    /// 清除色绿分量（0..255）。
    int ClearG() { return this.bgG; }
    /// 清除色蓝分量（0..255）。
    int ClearB() { return this.bgB; }

    /// 计算当前窗口/后备缓冲区尺寸下的画布布局与缩放（坐标换算
    /// 的唯一依据）。winW/winH 为窗口尺寸（设备像素）；设计尺寸
    /// 非 正 时按 1 处理。返回的 SceneMetrics 含偏移、画布尺寸与
    /// 两轴缩放系数。
    SceneMetrics Metrics(int winW, int winH) {
        SceneMetrics m = new SceneMetrics();
        double dw = (double)this.designWidth;
        double dh = (double)this.designHeight;
        double ww = (double)winW;
        double wh = (double)winH;
        if (dw <= 0.0) { dw = 1.0; }
        if (dh <= 0.0) { dh = 1.0; }
        if (this.scaleMode == 2) {
            // 拉伸
            m.scaleX = ww / dw;
            m.scaleY = wh / dh;
            m.canvasW = ww;
            m.canvasH = wh;
            m.offX = 0.0;
            m.offY = 0.0;
            return m;
        }
        if (this.scaleMode == 3) {
            // 无缩放 (1:1)
            m.scaleX = 1.0;
            m.scaleY = 1.0;
            m.canvasW = dw;
            m.canvasH = dh;
            m.offX = (ww - dw) / 2.0;
            m.offY = (wh - dh) / 2.0;
            return m;
        }
        double sx = ww / dw;
        double sy = wh / dh;
        double s = sx;
        if (this.scaleMode == 1) {
            // 填充：覆盖式（取最大）
            if (sy > s) { s = sy; }
        } else {
            // 适应：信箱式（取最小）
            if (sy < s) { s = sy; }
        }
        m.scaleX = s;
        m.scaleY = s;
        m.canvasW = dw * s;
        m.canvasH = dh * s;
        m.offX = (ww - m.canvasW) / 2.0;
        m.offY = (wh - m.canvasH) / 2.0;
        return m;
    }

    /// 将单个元素解析为给定窗口尺寸下的真实设备像素矩形
    /// （含网格组总占地）。坐标换算遵循 Metrics 的缩放模式；
    /// 返回矩形以元素锚点对齐，适合直接渲染与命中测试。
    SceneRect Resolve(SceneElement e, int winW, int winH) {
        SceneMetrics m = this.Metrics(winW, winH);
        double ax = (double)e.AnchorX() / 1000.0;
        double ay = (double)e.AnchorY() / 1000.0;
        double ew = (double)e.TotalW() * m.ScaleX();
        double eh = (double)e.TotalH() * m.ScaleY();
        double anchorPxX = m.OffX() + ax * m.CanvasW();
        double anchorPxY = m.OffY() + ay * m.CanvasH();
        double px = anchorPxX + (double)e.X() * m.ScaleX() - ax * ew;
        double py = anchorPxY + (double)e.Y() * m.ScaleY() - ay * eh;
        return SceneRect.Of(px, py, ew, eh);
    }

    // ---- 序列化 -------------------------------------------------

    /// int 的十进制字符串（"" 情况不会出现：值已被钳制）。
    static string IntStr(int v) {
        if (v == 0) { return "0"; }
        bool neg = v < 0;
        int n = v;
        if (neg) { n = 0 - n; }
        string digits = "0123456789";
        string o = "";
        while (n > 0) {
            int d = n % 10;
            o = digits.Substring(d, 1) + o;
            n = n / 10;
        }
        if (neg) { o = "-" + o; }
        return o;
    }

    /// 宽松解析 `.zscene` JSON 文档（尽力而为，面向工具生成的
    /// 输入）：解析失败或根非对象时返回字段取默认值的文档。
    /// 严格校验请用 TryParse（失败原因见 LastError）。
    static SceneDoc Parse(string json) {
        JsonValue root = JsonValue.ParseLenient(json);
        return SceneDoc.FromRoot(root);
    }

    // 最近一次 Parse 的失败原因（"" = 成功或尚未解析）。
    // Parse 走宽松路径不会置位；TryParse 失败时携带原因。
    static string lastError;

    /// 严格解析：文档必须是完整合法的 JSON 对象，否则返回
    /// false 且 SceneDoc.LastError() 给出原因。设计器打开文档
    /// 走这条路径——截断/损坏的设计稿被静默降级成半份文档、
    /// 再在用户下一次编辑时覆盖回盘，比直接拒绝打开糟糕得多。
    /// 返回的文档经 FromRoot 构建，调用方拿到后照常使用。
    static bool TryParse(string json, SceneDoc outDoc) {
        SceneDoc.lastError = "";
        JsonValue root = null;
        try {
            root = JsonValue.Parse(json);
        } catch (JsonException ex) {
            SceneDoc.lastError = ex.Message;
            return false;
        }
        if (root == null || !root.IsObject()) {
            SceneDoc.lastError = "document is not a JSON object";
            return false;
        }
        SceneDoc parsed = SceneDoc.FromRoot(root);
        outDoc.adopt(parsed);
        return true;
    }

    /// 最近一次 Parse/TryParse 的失败原因（"" = 成功或尚未解析）。
    /// Parse 走宽松路径不会置位；TryParse 失败时携带原因。
    static string LastError() { return SceneDoc.lastError; }

    /// 用 parsed 的内容替换 this 的全部字段（TryParse 的
    /// out 参数语义：Zan 没有 out 参数，调用方先 new 一个
    /// 空文档传入，成功后它就是解析结果）。
    void adopt(SceneDoc parsed) {
        this.sname = parsed.sname;
        this.designWidth = parsed.designWidth;
        this.designHeight = parsed.designHeight;
        this.scaleMode = parsed.scaleMode;
        this.background = parsed.background;
        this.bgR = parsed.bgR;
        this.bgG = parsed.bgG;
        this.bgB = parsed.bgB;
        this.winCenter = parsed.winCenter;
        this.winPosX = parsed.winPosX;
        this.winPosY = parsed.winPosY;
        this.winTitle = parsed.winTitle;
        this.winResizable = parsed.winResizable;
        this.winChrome = parsed.winChrome;
        this.elements = parsed.elements;
    }

    /// 当前激活层集合的快照（';' 分隔，供 SaveJson 之外的
    /// 调用方检查）；运行时状态，不进 .zscene 文档。
    string OpenLayers() { return this.openLayers; }

    /// 从已解析的 JSON 根对象填充文档字段（Parse / TryParse 共用
    /// 的构建路径）。各字段带缺省值：name ""、designWidth 1280、
    /// designHeight 720、scaleMode 0（Fit）、winCenter 1、
    /// winResizable/winChrome 1、clearColor (18,20,32)。
    static SceneDoc FromRoot(JsonValue root) {
        SceneDoc d = new SceneDoc(
            root.Str("name", ""),
            root.Int("designWidth", 1280),
            root.Int("designHeight", 720));
        d.scaleMode = root.Int("scaleMode", 0);
        d.winCenter = root.Int("winCenter", 1);
        d.winPosX = root.Int("winPosX", 0);
        d.winPosY = root.Int("winPosY", 0);
        d.winTitle = root.Str("winTitle", "");
        d.winResizable = root.Int("winResizable", 1);
        d.winChrome = root.Int("winChrome", 1);
        d.background = root.Str("background", "");
        JsonValue clear = root.Get("clearColor");
        if (clear != null && clear.IsArray() && clear.Count() >= 3) {
            d.bgR = clear.At(0).AsInt(18);
            d.bgG = clear.At(1).AsInt(20);
            d.bgB = clear.At(2).AsInt(32);
        }
        JsonValue els = root.Get("elements");
        if (els != null && els.IsArray()) {
            for (int i = 0; i < els.Count(); i = i + 1) {
                JsonValue je = els.At(i);
                SceneElement e = new SceneElement(
                    je.Str("kind", "sprite"),
                    je.Str("name", ""));
                e.x = je.Int("x", 0);
                e.y = je.Int("y", 0);
                e.w = je.Int("w", 0);
                e.h = je.Int("h", 0);
                e.anchorX = je.Int("anchorX", 0);
                e.anchorY = je.Int("anchorY", 0);
                e.z = je.Int("z", 0);
                e.image = je.Str("image", "");
                e.text = je.Str("text", "");
                JsonValue col = je.Get("color");
                if (col != null && col.IsArray() && col.Count() >= 4) {
                    e.cr = col.At(0).AsInt(255);
                    e.cg = col.At(1).AsInt(255);
                    e.cb = col.At(2).AsInt(255);
                    e.ca = col.At(3).AsInt(255);
                }
                e.visible = je.Bool("visible", true);
                e.rows = je.Int("rows", 1);
                e.cols = je.Int("cols", 1);
                if (e.rows < 1) { e.rows = 1; }
                if (e.cols < 1) { e.cols = 1; }
                e.gapX = je.Int("gapX", 0);
                e.gapY = je.Int("gapY", 0);
                e.val = je.Int("value", 0);
                e.items = je.Str("items", "");
                e.locked = je.Bool("locked", false);
                e.layer = je.Str("layer", "");
                e.actions = SceneDoc.OnKeysOf(je);
                e.extra = SceneDoc.UnmodeledKeys(je);
                d.elements.Add(e);
            }
        }
        return d;
    }

    /// 收集元素对象里运行时未建模的键（含未来版本的扩展声明），
    /// 供 ToJson 原样写回（旧运行时打开新设计稿不丢数据）。
    /// 没有未建模键时返回 null。
    static JsonValue UnmodeledKeys(JsonValue o) {
        JsonValue extra = null;
        for (int i = 0; i < o.Count(); i = i + 1) {
            string key = o.KeyAt(i);
            if (SceneDoc.IsModeledKey(key)) { continue; }
            if (extra == null) { extra = JsonValue.NewObject(); }
            extra.Put(key, o.ValAt(i));
        }
        return extra;
    }

    // 提取元素对象里的 on* 键为 {事件名: 动作串} 对象；没有时为
    // null。与 Gui.Designer 的 on<Event> 动态键同一约定。
    /// 提取元素对象里的 on* 键为 {事件名: 动作串} 对象（"onClick"
    /// 存为键 "Click"）；非字符串值跳过，没有时返回 null。
    /// 与 Gui.Designer 的 on<Event> 动态键同一约定。
    static JsonValue OnKeysOf(JsonValue o) {
        JsonValue acts = null;
        for (int i = 0; i < o.Count(); i = i + 1) {
            string key = o.KeyAt(i);
            if (key.Length < 2 || key.Substring(0, 2) != "on") { continue; }
            JsonValue v = o.ValAt(i);
            if (v == null || !v.IsString()) { continue; }
            if (acts == null) { acts = JsonValue.NewObject(); }
            acts.Put(key.Substring(2), v);
        }
        return acts;
    }

    /// k 是否为 SceneElement 建模的键（新增建模键时同步加上，
    /// 否则会被 UnmodeledKeys 收集导致 ToJson 重复写出）；
    /// on* 动作键也按已建模处理（经 OnKeysOf 单独往返）。
    static bool IsModeledKey(string k) {
        if (k.Length > 2 && k.Substring(0, 2) == "on") { return true; }
        return k == "kind" || k == "name" || k == "x" || k == "y"
            || k == "w" || k == "h" || k == "anchorX" || k == "anchorY"
            || k == "z" || k == "image" || k == "text" || k == "color"
            || k == "visible" || k == "rows" || k == "cols" || k == "gapX"
            || k == "gapY" || k == "value" || k == "items" || k == "locked"
            || k == "layer";
    }

    /// k 是否为文档级（根对象）已建模的键；ToJson 全量写出，
    /// 因此无需参与 UnmodeledKeys，但 FromRoot 之外的手写工具
    /// 可据此区分建模键与扩展键。
    static bool IsModeledDocKey(string k) {
        return k == "name" || k == "designWidth" || k == "designHeight"
            || k == "scaleMode" || k == "winCenter" || k == "winPosX"
            || k == "winPosY" || k == "winTitle" || k == "winResizable"
            || k == "winChrome" || k == "background" || k == "clearColor"
            || k == "elements";
    }

    /// 序列化为稳定、便于人工 diff 的 `.zscene` JSON（Pretty 格式）。
    /// 全量写出文档级字段；元素级省略缺省项（网格/值/条目/锁定/
    /// 层为默认时不写），未建模键与 on* 动作键原样往返。
    string ToJson() {
        JsonValue o = JsonValue.NewObject();
        o.Put("name", JsonValue.NewStr(this.sname));
        o.Put("designWidth", JsonValue.NewNum(Convert.ToString(this.designWidth)));
        o.Put("designHeight", JsonValue.NewNum(Convert.ToString(this.designHeight)));
        o.Put("scaleMode", JsonValue.NewNum(Convert.ToString(this.scaleMode)));
        o.Put("winCenter", JsonValue.NewNum(Convert.ToString(this.winCenter)));
        o.Put("winPosX", JsonValue.NewNum(Convert.ToString(this.winPosX)));
        o.Put("winPosY", JsonValue.NewNum(Convert.ToString(this.winPosY)));
        if (this.WinTitle().Length > 0) {
            o.Put("winTitle", JsonValue.NewStr(this.winTitle));
        }
        o.Put("winResizable", JsonValue.NewNum(Convert.ToString(this.winResizable)));
        o.Put("winChrome", JsonValue.NewNum(Convert.ToString(this.winChrome)));
        o.Put("background", JsonValue.NewStr(this.background));
        JsonValue clear = JsonValue.NewArray();
        clear.Append(JsonValue.NewNum(Convert.ToString(this.bgR)));
        clear.Append(JsonValue.NewNum(Convert.ToString(this.bgG)));
        clear.Append(JsonValue.NewNum(Convert.ToString(this.bgB)));
        o.Put("clearColor", clear);
        JsonValue elems = JsonValue.NewArray();
        for (int i = 0; i < this.elements.Count; i = i + 1) {
            SceneElement e = this.elements[i];
            JsonValue el = JsonValue.NewObject();
            el.Put("kind", JsonValue.NewStr(e.Kind()));
            el.Put("name", JsonValue.NewStr(e.Name()));
            el.Put("x", JsonValue.NewNum(Convert.ToString(e.X())));
            el.Put("y", JsonValue.NewNum(Convert.ToString(e.Y())));
            el.Put("w", JsonValue.NewNum(Convert.ToString(e.W())));
            el.Put("h", JsonValue.NewNum(Convert.ToString(e.H())));
            el.Put("anchorX", JsonValue.NewNum(Convert.ToString(e.AnchorX())));
            el.Put("anchorY", JsonValue.NewNum(Convert.ToString(e.AnchorY())));
            el.Put("z", JsonValue.NewNum(Convert.ToString(e.Z())));
            el.Put("image", JsonValue.NewStr(e.ImageId()));
            el.Put("text", JsonValue.NewStr(e.Text()));
            JsonValue color = JsonValue.NewArray();
            color.Append(JsonValue.NewNum(Convert.ToString(e.R())));
            color.Append(JsonValue.NewNum(Convert.ToString(e.G())));
            color.Append(JsonValue.NewNum(Convert.ToString(e.B())));
            color.Append(JsonValue.NewNum(Convert.ToString(e.A())));
            el.Put("color", color);
            if (e.IsGrid() || e.GapX() != 0 || e.GapY() != 0) {
                el.Put("rows", JsonValue.NewNum(Convert.ToString(e.Rows())));
                el.Put("cols", JsonValue.NewNum(Convert.ToString(e.Cols())));
                el.Put("gapX", JsonValue.NewNum(Convert.ToString(e.GapX())));
                el.Put("gapY", JsonValue.NewNum(Convert.ToString(e.GapY())));
            }
            if (e.Value() != 0) {
                el.Put("value", JsonValue.NewNum(Convert.ToString(e.Value())));
            }
            if (e.Items().Length > 0) {
                el.Put("items", JsonValue.NewStr(e.Items()));
            }
            if (e.Locked()) {
                el.Put("locked", JsonValue.NewBool(true));
            }
            if (e.Layer().Length > 0) {
                el.Put("layer", JsonValue.NewStr(e.Layer()));
            }
            // on* 动作键原样写回（空串跳过，视为未绑定）。
            if (e.actions != null && e.actions.IsObject()) {
                for (int ak = 0; ak < e.actions.Count(); ak = ak + 1) {
                    JsonValue av = e.actions.ValAt(ak);
                    if (av == null || !av.IsString()) { continue; }
                    string hv = av.AsString("");
                    if (hv.Length == 0) { continue; }
                    el.Put("on" + e.actions.KeyAt(ak), av);
                }
            }
            el.Put("visible", JsonValue.NewBool(e.Visible()));
            // 未建模的键原样写回：手写/新版设计稿里运行时
            // 不认识的声明不能因为一次往返就消失。
            if (e.extra != null && e.extra.IsObject()) {
                for (int xk = 0; xk < e.extra.Count(); xk = xk + 1) {
                    el.Put(e.extra.KeyAt(xk), e.extra.ValAt(xk));
                }
            }
            elems.Append(el);
        }
        o.Put("elements", elems);
        return o.PrettyToJson();
    }
}
