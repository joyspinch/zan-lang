using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Game.Scene;

public partial class SceneDesigner {
    weak SceneDesignerPaletteItem paletteGesture;
    int paletteX;
    int paletteY;

    void BuildPalette() {
        paletteRoot = new ScrollColumn();
        paletteRoot.Class = "scene-designer-palette";
        paletteRoot.Pad(Space.S);
        controlsHeader = this.PaletteHeaderButton(SceneDesigner.T("CONTROLS", "控件"));
        controlsSection = this.PaletteItems(SceneDesigner.ControlKinds());
        componentsHeader = this.PaletteHeaderButton(SceneDesigner.T("COMPONENTS", "组件"));
        componentsSection = this.PaletteItems(SceneDesigner.ComponentKinds());
        Panel content = SceneInspectorView.Column();
        content.Add(controlsHeader); content.Add(controlsSection);
        content.Add(componentsHeader); content.Add(componentsSection);
        paletteRoot.Add(content);
    }
    Button PaletteHeaderButton(string title) {
        Button button = new Button(title);
        button.Class = "ghost small";
        button.Prefer(0, 24);
        SceneDesignerAction action = new SceneDesignerAction(this, "fold"); action.value = title;
        button.Click.Add(action.Run);
        return button;
    }
    Panel PaletteItems(List<string> kinds) {
        Panel column = SceneInspectorView.Column();
        for (int i = 0; i < kinds.Count; i = i + 1) { column.Add(new SceneDesignerPaletteItem(this, kinds[i])); }
        return column;
    }
    public void RefreshPalette() {
        if (paletteRoot == null) { return; }
        bool controls = !this.PalFolded(SceneDesigner.T("CONTROLS", "控件"));
        bool components = !this.PalFolded(SceneDesigner.T("COMPONENTS", "组件"));
        controlsSection.SetShown(controls);
        componentsSection.SetShown(components);
    }
    public void PaletteDown(App app, SceneDesignerPaletteItem item, RoutedEventArgs e) {
        if (app.window.EventButton() != 0 || viewApp != app || !viewVisible) { return; }
        this.CancelPaletteGesture();
        paletteGesture = item; palDrag = item.elementKind; palMoved = false;
        paletteX = e.x; paletteY = e.y;
        app.CapturePointer(item, true);
        msg = SceneDesigner.T("click to add at centre, or drag onto the canvas", "单击添加到画布中心，或拖到画布指定位置");
        e.Handle(); app.RequestRedraw();
    }
    public void PaletteMove(App app, SceneDesignerPaletteItem item, RoutedEventArgs e) {
        if (paletteGesture != item || app.GetCapturedPointer() != item) { return; }
        if (e.x != paletteX || e.y != paletteY) { palMoved = true; }
        paletteX = e.x; paletteY = e.y;
        e.Handle(); app.RequestRedraw();
    }
    public void PaletteUp(App app, SceneDesignerPaletteItem item, RoutedEventArgs e) {
        if (app.window.EventButton() != 0 || paletteGesture != item || app.GetCapturedPointer() != item) { return; }
        string kind = palDrag;
        bool moved = palMoved || e.x != paletteX || e.y != paletteY;
        bool click = !moved && SceneDesigner.InRect(e.x, e.y, item.bx, item.by, item.bw, item.bh);
        bool drop = surface != null && surface.StyleVisible() && this.CanvasContains(e.x, e.y);
        int session = inputGeneration; SceneDoc currentDocument = doc;
        this.CancelPaletteGesture();
        app.ReleasePointerCapture();
        if (session != inputGeneration || !viewVisible || viewApp != app || currentDocument != doc) { return; }
        if (click) { this.AddElement(kind); }
        else if (drop) { this.AddElementAt(kind, (e.x - canvasOX) * 1000 / canvasScale, (e.y - canvasOY) * 1000 / canvasScale); }
        else { msg = SceneDesigner.T("drop cancelled", "已取消拖放"); }
        e.Handle(); app.RequestRedraw();
    }
    public void CancelPaletteGesture() {
        paletteGesture = null; palDrag = ""; palMoved = false;
    }
    void PaintPaletteGhost(App app) {
        if (palDrag == "" || !palMoved) { return; }
        // A standard Button renders the same palette content at the drag location.
        if (paletteGhost == null) { paletteGhost = new Button(); paletteGhost.Class = "small primary"; }
        paletteGhost.Text = SceneDesigner.KindLabel(palDrag);
        paletteGhost.MeasureTree(app);
        paletteGhost.Arrange(paletteX + app.Scale(12), paletteY + app.Scale(12), paletteGhost.prefW, app.Scale(24));
        paletteGhost.RenderTree(app);
    }
    Button paletteGhost;
}
