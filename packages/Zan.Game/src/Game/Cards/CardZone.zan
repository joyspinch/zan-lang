using System;
using Game.Foundation;

namespace Game.Cards;

// 卡牌区域（牌堆槽位）：有名字的有序卡牌集合，可作抽牌堆、
// 手牌、弃牌堆或消耗堆使用。null 卡不会被加入。
public class CardZone {
    public string name;
    public List<CardInstance> cards;

    // 构造区域：name 为区域显示名（如 "draw"/"hand"），初始为空。
    public CardZone(string name) {
        this.name = name;
        this.cards = new List<CardInstance>();
    }

    // 将卡追加到区域末尾：null 卡被忽略。
    public void Add(CardInstance card) {
        if (card != null) { this.cards.Add(card); }
    }

    // 移除并返回指定索引的卡：索引越界返回 null 且不改动区域。
    public CardInstance TakeAt(int index) {
        if (index < 0 || index >= this.cards.Count) { return null; }
        CardInstance card = this.cards[index];
        this.cards.RemoveAt(index);
        return card;
    }

    // 移除并返回最后一张卡：区域为空时返回 null。
    public CardInstance TakeLast() {
        return this.TakeAt(this.cards.Count - 1);
    }

    // 按实例 id 查找卡在区域中的索引：找到返回下标，未找到返回 -1。
    public int IndexOfInstance(int instanceId) {
        for (int i = 0; i < this.cards.Count; i = i + 1) {
            if (this.cards[i].InstanceId() == instanceId) { return i; }
        }
        return -1;
    }

    // 原地洗牌（Fisher-Yates）：使用确定性随机源保证同种子同序列；random 为 null 时不洗牌。
    public void Shuffle(DeterministicRandom random) {
        if (random == null) { return; }
        int i = this.cards.Count - 1;
        while (i > 0) {
            int j = random.NextBelow(i + 1);
            CardInstance swap = this.cards[i];
            this.cards[i] = this.cards[j];
            this.cards[j] = swap;
            i = i - 1;
        }
    }

    // 区域名称（构造时传入，不变）。
    public string Name() { return this.name; }
    // 区域内卡牌数。
    public int Count() { return this.cards.Count; }
    // 查看第 index 张卡（不移除）；索引越界行为由 List 决定（调用方应保证 0 <= index < Count）。
    public CardInstance At(int index) { return this.cards[index]; }
    // 清空区域内全部卡牌。
    public void Clear() { this.cards.Clear(); }

    // 将区域内全部卡牌批量转移至目标区域并清空自身。
    // 逆序追加以保持与逐张 TakeLast 一致的拓扑顺序，单次清空消除 O(N) 步循环 RemoveAt 重复边界检查。
    public void MoveAllToReversed(CardZone target) {
        if (target == null || target == this) { return; }
        for (int i = this.cards.Count - 1; i >= 0; i = i - 1) {
            target.cards.Add(this.cards[i]);
        }
        this.cards.Clear();
    }
}
