using System;

namespace Game.Cards;

/// <summary>
/// 卡牌区域类型。
/// </summary>
enum ZoneType {
    Deck,  // 牌库
    Hand,  // 手牌
    Board,  // 战场随从槽位
    Discard,  // 墓地弃牌堆
    Exile  // 放逐区
}

/// <summary>
/// 战场卡槽或交互区域。
/// </summary>
class BoardSlot {
    int slotIndex;
    double x;
    double y;
    double width;
    double height;
    int occupantCardId;  // 当前放置在此槽位上的卡牌 ID (-1 为空)

    BoardSlot(int idx, double x, double y, double w, double h) {
        this.slotIndex = idx;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.occupantCardId = -1;
    }

    static BoardSlot Create(int idx, double x, double y, double w, double h) {
        return new BoardSlot(idx, x, y, w, h);
    }

    int Index { get { return slotIndex; } }
    double X { get { return x; } }
    double Y { get { return y; } }
    double Width { get { return width; } }
    double Height { get { return height; } }
    int OccupantCardId { get { return occupantCardId; } set { occupantCardId = value; } }
    bool IsEmpty { get { return occupantCardId == -1; } }

    /// <summary>判断点 (px, py) 是否落在卡槽范围内。</summary>
    bool Contains(double px, double py) {
        return px >= x && px <= x + width && py >= y && py <= y + height;
    }

    /// <summary>计算点到卡槽中心点的欧氏距离平方，用于磁吸距离计算。</summary>
    double DistanceSqToCenter(double px, double py) {
        double cx = x + width * 0.5;
        double cy = y + height * 0.5;
        double dx = px - cx;
        double dy = py - cy;
        return dx * dx + dy * dy;
    }
}

/// <summary>
/// 卡牌容器与拖拽磁吸判定管理器。
/// </summary>
class CardZoneManager {
    BoardSlot[] playerSlots;
    BoardSlot[] enemySlots;
    int slotCapacity;

    CardZoneManager(int maxSlots) {
        this.slotCapacity = maxSlots > 0 ? maxSlots : 7;
        this.playerSlots = new BoardSlot[slotCapacity];
        this.enemySlots = new BoardSlot[slotCapacity];
    }

    static CardZoneManager Create(int maxSlots) {
        return new CardZoneManager(maxSlots);
    }

    void SetupPlayerSlot(int index, double x, double y, double w, double h) {
        if (index >= 0 && index < slotCapacity) {
            playerSlots[index] = BoardSlot.Create(index, x, y, w, h);
        }
    }

    void SetupEnemySlot(int index, double x, double y, double w, double h) {
        if (index >= 0 && index < slotCapacity) {
            enemySlots[index] = BoardSlot.Create(index, x, y, w, h);
        }
    }

    BoardSlot GetPlayerSlot(int index) {
        if (index >= 0 && index < slotCapacity) { return playerSlots[index]; }
        return null;
    }

    /// <summary>
    /// 寻找玩家拖拽卡牌时距离最近且合法的空置卡槽。
    /// snapThresholdPx: 磁吸感应门限像素。
    /// 未命中或超出磁吸范围返回 -1。
    /// </summary>
    int FindSnapPlayerSlot(double cardCenterX, double cardCenterY, double snapThresholdPx) {
        double maxDistSq = snapThresholdPx * snapThresholdPx;
        double bestDistSq = maxDistSq;
        int bestIdx = -1;

        for (int i = 0; i < slotCapacity; i = i + 1) {
            BoardSlot slot = playerSlots[i];
            if (slot != null && slot.IsEmpty) {
                // 如果直接在卡槽盒体内，优先判定
                if (slot.Contains(cardCenterX, cardCenterY)) {
                    return slot.Index;
                }
                double d2 = slot.DistanceSqToCenter(cardCenterX, cardCenterY);
                if (d2 <= bestDistSq) {
                    bestDistSq = d2;
                    bestIdx = slot.Index;
                }
            }
        }

        return bestIdx;
    }
}
