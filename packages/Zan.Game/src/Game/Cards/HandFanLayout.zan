using System;

namespace Game.Cards;

/// <summary>
/// 手牌扇形弧度自然排布算法（类似《炉石传说》《杀戮尖塔》）。
/// 解决卡牌平铺呆板重叠的问题，根据持牌张数自适应计算每张牌的位置、拱起弧度与旋转倾角。
/// </summary>
class HandFanLayout {
    double arcRadius;       // 拱形虚拟圆盘半径
    double maxSpreadAngle;  // 最大两翼展开扇面总角度（度数）
    double cardSpacing;     // 卡牌基础横向间距
    double hoverLift;       // 鼠标悬停时卡牌向上浮起的高度 (像素)
    double hoverScale;      // 悬停缩放比率 (例如 1.2)

    HandFanLayout(double radius, double maxAngle, double spacing) {
        this.arcRadius = radius > 100.0 ? radius : 600.0;
        this.maxSpreadAngle = maxAngle > 5.0 ? maxAngle : 40.0;
        this.cardSpacing = spacing > 20.0 ? spacing : 70.0;
        this.hoverLift = 40.0;
        this.hoverScale = 1.2;
    }

    static HandFanLayout Create(double radius, double maxAngle, double spacing) {
        return new HandFanLayout(radius, maxAngle, spacing);
    }

    /// <summary>
    /// 为拥有 count 张手牌的序列计算第 index 张牌的目标变换。
    /// 输出：目标世界坐标 (outX, outY), 倾斜角弧度 outRotRad, 缩放比率 outScale。
    /// </summary>
    void CalculateCardTransform(
        int index,
        int count,
        int hoveredIndex,
        double centerX,
        double bottomY,
        out double outX,
        out double outY,
        out double outRotRad,
        out double outScale
    ) {
        if (count <= 0 || index < 0 || index >= count) {
            outX = centerX;
            outY = bottomY;
            outRotRad = 0.0;
            outScale = 1.0;
            return;
        }

        if (count == 1) {
            outX = centerX;
            outY = (hoveredIndex == 0) ? (bottomY - hoverLift) : bottomY;
            outRotRad = 0.0;
            outScale = (hoveredIndex == 0) ? hoverScale : 1.0;
            return;
        }

        // 计算每张牌在 [-0.5 .. 0.5] 范围内的归一化对称分布
        double t = ((double)index / (double)(count - 1)) - 0.5;

        // 根据手牌总数动态压缩展开角
        double currentSpreadAngle = Math.Min(maxSpreadAngle, (double)(count - 1) * 6.5);
        double angleDeg = t * currentSpreadAngle;
        double angleRad = (angleDeg / 180.0) * 3.14159265;

        // 沿圆弧计算 X 和 Y 坐标（虚拟圆心在屏幕下方 arcRadius 处）
        double pivotY = bottomY + arcRadius;
        double cx = centerX + Math.Sin(angleRad) * arcRadius;
        double cy = pivotY - Math.Cos(angleRad) * arcRadius;

        // 悬停聚焦效果：浮起、摆正倾角并适当推开两侧卡牌
        if (index == hoveredIndex) {
            cy = cy - hoverLift;
            angleRad = angleRad * 0.2; // 悬停牌几乎摆正，方便阅读牌面文字
            outScale = hoverScale;
        } else if (hoveredIndex >= 0) {
            // 给被悬停牌留出展示视野空间
            double push = (index < hoveredIndex) ? -20.0 : 20.0;
            cx = cx + push;
            outScale = 1.0;
        } else {
            outScale = 1.0;
        }

        outX = cx;
        outY = cy;
        outRotRad = angleRad;
    }
}
