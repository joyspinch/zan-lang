using System;
using Game.Foundation;

namespace Game.Cards;

// 卡牌实例：一次具体掉落/获得的卡，引用共享的 CardDefinition
// 并携带独立状态（实例 id、升级等级、保留标记）。instanceId
// 全局递增且不复用。
class CardInstance {
    int instanceId;
    CardDefinition definition;
    int upgrade;
    bool retained;

    // 构造实例：instanceId 由牌堆分配（从 1 递增），definition 为共享模板；升级等级 0、保留标记 false。
    CardInstance(int instanceId, CardDefinition definition) {
        this.instanceId = instanceId;
        this.definition = definition;
        this.upgrade = 0;
        this.retained = false;
    }

    // 实例唯一 id（牌堆内递增分配，不复用）。
    int InstanceId() { return this.instanceId; }
    // 共享的卡牌定义模板。
    CardDefinition Definition() { return this.definition; }
    // 升级等级，0 表示未升级。
    int Upgrade() { return this.upgrade; }
    // 保留标记：为 true 时回合结束弃牌阶段不弃此牌。
    bool Retained() { return this.retained; }
    // 设置升级等级（无钳制）。
    void SetUpgrade(int upgrade) { this.upgrade = upgrade; }
    // 设置保留标记。
    void SetRetained(bool retained) { this.retained = retained; }
}
