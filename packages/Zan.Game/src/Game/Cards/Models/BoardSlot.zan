using System;

namespace Game.Cards;

// 战场卡槽或交互区域。
class BoardSlot {
    int slotIndex;
    double x;
    double y;
    double width;
    double height;
    int occupantCardId;  // 当前放置在此槽位上的卡牌 ID (-1 为空)

    BoardSlot(int idx, double x, double y, double w, double h) {
        this.slotIndex = idx;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.occupantCardId = -1;
    }

    static BoardSlot Create(int idx, double x, double y, double w, double h) {
        return new BoardSlot(idx, x, y, w, h);
    }

    int Index { get { return slotIndex; } }
    double X { get { return x; } }
    double Y { get { return y; } }
    double Width { get { return width; } }
    double Height { get { return height; } }
    int OccupantCardId { get { return occupantCardId; } set { occupantCardId = value; } }
    bool IsEmpty { get { return occupantCardId == -1; } }

    // 判断点 (px, py) 是否落在卡槽范围内。
    bool Contains(double px, double py) {
        return px >= x && px <= x + width && py >= y && py <= y + height;
    }

    // 计算点到卡槽中心点的欧氏距离平方，用于磁吸距离计算。
    double DistanceSqToCenter(double px, double py) {
        double cx = x + width * 0.5;
        double cy = y + height * 0.5;
        double dx = px - cx;
        double dy = py - cy;
        return dx * dx + dy * dy;
    }
}
