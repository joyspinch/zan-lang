using System;

namespace Game.Cards;

// 战场卡槽或交互区域。
public class BoardSlot {
    public int slotIndex;
    public double x;
    public double y;
    public double width;
    public double height;
    public int occupantCardId;  // 当前放置在此槽位上的卡牌 ID (-1 为空)

    public BoardSlot(int idx, double x, double y, double w, double h) {
        this.slotIndex = idx;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.occupantCardId = -1;
    }

    public static BoardSlot Create(int idx, double x, double y, double w, double h) {
        return new BoardSlot(idx, x, y, w, h);
    }

    public int Index { get { return slotIndex; } }
    public double X { get { return x; } }
    public double Y { get { return y; } }
    public double Width { get { return width; } }
    public double Height { get { return height; } }
    public int OccupantCardId { get { return occupantCardId; } set { occupantCardId = value; } }
    public bool IsEmpty { get { return occupantCardId == -1; } }

    // 判断点 (px, py) 是否落在卡槽范围内。
    public bool Contains(double px, double py) {
        return px >= x && px <= x + width && py >= y && py <= y + height;
    }

    // 计算点到卡槽中心点的欧氏距离平方，用于磁吸距离计算。
    public double DistanceSqToCenter(double px, double py) {
        double cx = x + width * 0.5;
        double cy = y + height * 0.5;
        double dx = px - cx;
        double dy = py - cy;
        return dx * dx + dy * dy;
    }
}
