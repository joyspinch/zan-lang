using System;

namespace Game.Cards;

// 卡牌战斗中的单位（玩家或敌人）：维护生命、格挡、力量、易伤。
// 伤害结算顺序为：易伤增伤 → 格挡吸收 → 扣血，血量钳制在
// [0, maxHp]。格挡在本方回合开始时清零，易伤在回合结束时递减。
public class CardActor {
    public string id;
    public int hp;
    public int maxHp;
    public int block;
    public int strength;
    public int vulnerable;

    // 构造单位：id 为唯一标识，maxHp 为初始与最大生命，小于 1 时钳制为 1；初始血量等于 maxHp，格挡/力量/易伤为 0。
    public CardActor(string id, int maxHp) {
        this.id = id;
        this.maxHp = maxHp;
        if (this.maxHp < 1) { this.maxHp = 1; }
        this.hp = this.maxHp;
        this.block = 0;
        this.strength = 0;
        this.vulnerable = 0;
    }

    // 结算一次伤害：负值按 0 处理，易伤状态加成 50%，先消耗格挡再扣血；返回实际扣减的生命值（不含被格挡部分），血量下限为 0。
    public int TakeDamage(int amount) {
        if (amount < 0) { amount = 0; }
        if (this.vulnerable > 0) {
            amount = amount + amount / 2;
        }
        int blocked = amount;
        if (blocked > this.block) { blocked = this.block; }
        this.block = this.block - blocked;
        int damage = amount - blocked;
        this.hp = this.hp - damage;
        if (this.hp < 0) { this.hp = 0; }
        return damage;
    }

    // 治疗单位：负值直接返回 0 不生效；返回实际恢复量，血量上限钳制到 maxHp。
    public int Heal(int amount) {
        if (amount < 0) { return 0; }
        int before = this.hp;
        this.hp = this.hp + amount;
        if (this.hp > this.maxHp) { this.hp = this.maxHp; }
        return this.hp - before;
    }

    // 增加格挡值：仅正数生效，格挡在下次本方回合开始时清零。
    public void AddBlock(int amount) {
        if (amount > 0) { this.block = this.block + amount; }
    }

    // 增加力量：可为负（削弱），力量会加成后续伤害类效果的目标结算。
    public void AddStrength(int amount) { this.strength = this.strength + amount; }

    // 施加易伤：仅正数生效，回合数累加；易伤期间受到的伤害增加 50%，每经过自己回合结束递减 1。
    public void AddVulnerable(int turns) {
        if (turns > 0) { this.vulnerable = this.vulnerable + turns; }
    }

    // 本方回合开始：格挡清零（格挡不跨回合保留）。
    public void StartTurn() { this.block = 0; }

    // 本方回合结束：易伤剩余回合数大于 0 时递减 1。
    public void EndTurn() {
        if (this.vulnerable > 0) {
            this.vulnerable = this.vulnerable - 1;
        }
    }

    // 唯一标识符（构造时传入，不变）。
    public string Id() { return this.id; }
    // 当前生命值，范围 [0, maxHp]。
    public int Hp() { return this.hp; }
    // 最大生命值（构造后不变）。
    public int MaxHp() { return this.maxHp; }
    // 当前格挡值，回合开始时清零。
    public int Block() { return this.block; }
    // 当前力量值，可为负。
    public int Strength() { return this.strength; }
    // 易伤剩余回合数，0 表示无易伤。
    public int Vulnerable() { return this.vulnerable; }
    // 是否存活：当前生命值大于 0。
    public bool Alive() { return this.hp > 0; }
}
