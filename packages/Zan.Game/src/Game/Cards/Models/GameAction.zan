using System;

namespace Game.Cards;

// 单个待演播动作节拍。
class GameAction {
    ActionKind kind;
    int sourceId;
    int targetId;
    int value;
    double duration;

    GameAction(ActionKind kind, int src, int tgt, int val, double dur) {
        this.kind = kind;
        this.sourceId = src;
        this.targetId = tgt;
        this.value = val;
        this.duration = dur > 0.01 ? dur : 0.2;
    }

    static GameAction Create(ActionKind kind, int src, int tgt, int val, double dur) {
        return new GameAction(kind, src, tgt, val, dur);
    }

    ActionKind Kind { get { return kind; } }
    int SourceId { get { return sourceId; } }
    int TargetId { get { return targetId; } }
    int Value { get { return value; } }
    double Duration { get { return duration; } }
}
