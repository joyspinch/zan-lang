using System;

namespace Game.Cards;

// 单个待演播动作节拍。
public class GameAction {
    public ActionKind kind;
    public int sourceId;
    public int targetId;
    public int value;
    public double duration;

    public GameAction(ActionKind kind, int src, int tgt, int val, double dur) {
        this.kind = kind;
        this.sourceId = src;
        this.targetId = tgt;
        this.value = val;
        this.duration = dur > 0.01 ? dur : 0.2;
    }

    public static GameAction Create(ActionKind kind, int src, int tgt, int val, double dur) {
        return new GameAction(kind, src, tgt, val, dur);
    }

    public ActionKind Kind { get { return kind; } }
    public int SourceId { get { return sourceId; } }
    public int TargetId { get { return targetId; } }
    public int Value { get { return value; } }
    public double Duration { get { return duration; } }
}
