using System;

namespace Game.Cards;

// 卡牌与策略游戏动作演播序列队列。
// 将回合制逻辑演算与视觉动画解耦，确保法术连击、亡语触发、伤害扣血按节奏流畅展现。
public class ActionQueue {
    public GameAction[] queue;
    public int head;
    public int tail;
    public int count;
    public int capacity;

    public GameAction currentAction;
    public double currentTimer;
    public bool isPlaying;

    public ActionQueue(int cap) {
        this.capacity = cap > 0 ? cap : 256;
        this.queue = new GameAction[capacity];
        this.head = 0;
        this.tail = 0;
        this.count = 0;
        this.currentAction = null;
        this.currentTimer = 0.0;
        this.isPlaying = false;
    }

    public static ActionQueue Create(int cap) {
        return new ActionQueue(cap);
    }

    public bool IsPlaying { get { return isPlaying || count > 0; } }
    public int PendingCount { get { return count; } }

    // 向队列尾部推入一个动作。
    public bool Enqueue(ActionKind kind, int src, int tgt, int val, double duration) {
        if (count >= capacity) { return false; }
        queue[tail] = GameAction.Create(kind, src, tgt, val, duration);
        tail = (tail + 1) % capacity;
        count = count + 1;
        return true;
    }

    // 逐物理帧推进演播序列。
    // 触发 onActionStart 和 onActionFinish 委托。
    public void Update(double dt, System.Linq.Action<GameAction> onActionStart, System.Linq.Action<GameAction> onActionFinish) {
        if (!isPlaying) {
            if (count > 0) {
                // 启动下一个动作
                currentAction = queue[head];
                head = (head + 1) % capacity;
                count = count - 1;
                currentTimer = currentAction.Duration;
                isPlaying = true;
                if (onActionStart != null) {
                    onActionStart(currentAction);
                }
            }
            return;
        }

        // 当前动作进行中
        currentTimer = currentTimer - dt;
        if (currentTimer <= 0.0) {
            isPlaying = false;
            if (onActionFinish != null) {
                onActionFinish(currentAction);
            }
            currentAction = null;
        }
    }

    public void Clear() {
        head = 0;
        tail = 0;
        count = 0;
        isPlaying = false;
        currentAction = null;
        currentTimer = 0.0;
    }
}
