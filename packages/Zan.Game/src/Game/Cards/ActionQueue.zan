using System;

namespace Game.Cards;

/// <summary>
/// 演播动作类型。
/// </summary>
enum ActionKind {
    PlayCardAnim,  // 出牌打向战场
    DealDamage,  // 飞弹攻击或受击跳字
    MinionDeath,  // 随从碎裂消亡
    DrawCardAnim,  // 从牌库抽牌飞行进入手牌
    PauseWait  // 战术性短暂停顿
}

/// <summary>
/// 单个待演播动作节拍。
/// </summary>
class GameAction {
    ActionKind kind;
    int sourceId;
    int targetId;
    int value;
    double duration;

    GameAction(ActionKind kind, int src, int tgt, int val, double dur) {
        this.kind = kind;
        this.sourceId = src;
        this.targetId = tgt;
        this.value = val;
        this.duration = dur > 0.01 ? dur : 0.2;
    }

    static GameAction Create(ActionKind kind, int src, int tgt, int val, double dur) {
        return new GameAction(kind, src, tgt, val, dur);
    }

    ActionKind Kind { get { return kind; } }
    int SourceId { get { return sourceId; } }
    int TargetId { get { return targetId; } }
    int Value { get { return value; } }
    double Duration { get { return duration; } }
}

/// <summary>
/// 卡牌与策略游戏动作演播序列队列。
/// 将回合制逻辑演算与视觉动画解耦，确保法术连击、亡语触发、伤害扣血按节奏流畅展现。
/// </summary>
class ActionQueue {
    GameAction[] queue;
    int head;
    int tail;
    int count;
    int capacity;

    GameAction currentAction;
    double currentTimer;
    bool isPlaying;

    ActionQueue(int cap) {
        this.capacity = cap > 0 ? cap : 256;
        this.queue = new GameAction[capacity];
        this.head = 0;
        this.tail = 0;
        this.count = 0;
        this.currentAction = null;
        this.currentTimer = 0.0;
        this.isPlaying = false;
    }

    static ActionQueue Create(int cap) {
        return new ActionQueue(cap);
    }

    bool IsPlaying { get { return isPlaying || count > 0; } }
    int PendingCount { get { return count; } }

    /// <summary>向队列尾部推入一个动作。</summary>
    bool Enqueue(ActionKind kind, int src, int tgt, int val, double duration) {
        if (count >= capacity) { return false; }
        queue[tail] = GameAction.Create(kind, src, tgt, val, duration);
        tail = (tail + 1) % capacity;
        count = count + 1;
        return true;
    }

    /// <summary>
    /// 逐物理帧推进演播序列。
    /// 触发 onActionStart 和 onActionFinish 委托。
    /// </summary>
    void Update(double dt, System.Linq.Action<GameAction> onActionStart, System.Linq.Action<GameAction> onActionFinish) {
        if (!isPlaying) {
            if (count > 0) {
                // 启动下一个动作
                currentAction = queue[head];
                head = (head + 1) % capacity;
                count = count - 1;
                currentTimer = currentAction.Duration;
                isPlaying = true;
                if (onActionStart != null) {
                    onActionStart(currentAction);
                }
            }
            return;
        }

        // 当前动作进行中
        currentTimer = currentTimer - dt;
        if (currentTimer <= 0.0) {
            isPlaying = false;
            if (onActionFinish != null) {
                onActionFinish(currentAction);
            }
            currentAction = null;
        }
    }

    void Clear() {
        head = 0;
        tail = 0;
        count = 0;
        isPlaying = false;
        currentAction = null;
        currentTimer = 0.0;
    }
}
