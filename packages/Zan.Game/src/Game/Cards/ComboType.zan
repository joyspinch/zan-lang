using System;

namespace Game.Cards;

// 牌型标识：中式卡牌（斗地主系）里一手牌的形状。识别、比较、
// 候选枚举都以它为准；ComboRules 是唯一实现。
//
// 取值不能随意改：Combo.Compare / ComboRules.Beats 按类型大小关系
// 比较（王炸压一切、炸弹压普通牌型、同型比点数），新游戏若要换语义
// 只能新增类型并在比较规则里显式处理。
public class ComboType {
    // 无效牌型（空一手 / 不是合法牌型）。
    public static int None() { return 0; }
    // 单张。
    public static int Single() { return 1; }
    // 对子。
    public static int Pair() { return 2; }
    // 三张。
    public static int Triple() { return 3; }
    // 三带一。
    public static int TripleWithOne() { return 4; }
    // 三带二。
    public static int TripleWithPair() { return 5; }
    // 顺子（连续单牌，长度 ≥ 5）。
    public static int Straight() { return 6; }
    // 连对（连续对子，至少 3 连）。
    public static int PairStraight() { return 7; }
    // 炸弹（同点 4 张）。
    public static int Bomb() { return 8; }
    // 王炸（大小王各一）。
    public static int Rocket() { return 9; }

    // 牌型的可读名（UI 与日志用）。
    public static string Name(int type) {
        if (type == Single()) { return "单张"; }
        if (type == Pair()) { return "对子"; }
        if (type == Triple()) { return "三张"; }
        if (type == TripleWithOne()) { return "三带一"; }
        if (type == TripleWithPair()) { return "三带二"; }
        if (type == Straight()) { return "顺子"; }
        if (type == PairStraight()) { return "连对"; }
        if (type == Bomb()) { return "炸弹"; }
        if (type == Rocket()) { return "王炸"; }
        return "无";
    }
}
