using System;
using Game.Foundation;

namespace Game.Cards;

// 卡牌定义（模板）：不可变的基础属性 id/名称/费用/分类，
// 外加可链式追加的效果列表与可选美术资源。同一定义可实例化
// 出多张卡。
public class CardDefinition {
    public string id;
    public string name;
    public int cost;
    public string category;
    public string art;
    public List<CardEffect> effects;

    // 构造卡牌定义：id 为唯一标识，name 为显示名，cost 为打出费用（能量），category 为分类标签；效果列表初始为空，art 为空字符串。
    public CardDefinition(
        string id,
        string name,
        int cost,
        string category
    ) {
        this.id = id;
        this.name = name;
        this.cost = cost;
        this.category = category;
        this.art = "";
        this.effects = new List<CardEffect>();
    }

    // 追加一条效果并返回自身，支持链式调用；kind/target 取常量类值。
    public CardDefinition AddEffect(int kind, int amount, int target) {
        this.effects.Add(CardEffect.Of(kind, amount, target));
        return this;
    }

    // 设置美术资源标识并返回自身，支持链式调用；传空字符串表示无美术。
    public CardDefinition SetArt(string resource) {
        this.art = resource;
        return this;
    }

    // 唯一标识符（构造时传入，不变）。
    public string Id() { return this.id; }
    // 显示名称。
    public string Name() { return this.name; }
    // 打出费用（能量单位）。
    public int Cost() { return this.cost; }
    // 分类标签字符串。
    public string Category() { return this.category; }
    // 美术资源标识，未设置时为空字符串。
    public string Art() { return this.art; }
    // 效果条数。
    public int EffectCount() { return this.effects.Count; }
    // 取第 index 条效果；索引越界行为由 List 决定（调用方应保证 0 <= index < EffectCount）。
    public CardEffect EffectAt(int index) { return this.effects[index]; }
}
