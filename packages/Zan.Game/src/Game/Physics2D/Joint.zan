using System;

namespace Game.Physics2D;

// 关节基类：把两个刚体绑在一起。
//
// 生命周期（由 PhysicsWorld 驱动）：
//   1. ApplyForces(h)  —— 速度积分之前：软约束（弹簧）在这里给力
//   2. Prepare(h)      —— 窄相之后：算有效质量
//   3. SolveVelocity(h)—— 速度迭代：施加冲量
//   4. SolvePosition   —— 位置迭代：分离冲量修正约束误差
//
// 关节本身不做碰撞过滤：被约束的两个刚体之间仍会生成接触（除非把
// 它们的碰撞组设成互斥）——多数关节（铰链、距离）需要"扣在一起"，
// 让接触与约束并存反而更稳。
public abstract class Joint {
    public RigidBody bodyA;
    public RigidBody bodyB;
    // 是否参与求解。
    public bool enabled;

    public Joint(RigidBody bodyA, RigidBody bodyB) {
        this.bodyA = bodyA;
        this.bodyB = bodyB;
        this.enabled = true;
    }

    // 软约束力（默认无）。
    public virtual void ApplyForces(double h) {
    }

    // 预备求解量（有效质量、力臂等）。
    public abstract void Prepare(double h);

    // 速度迭代：施加冲量。
    public abstract void SolveVelocity(double h);

    // 位置迭代：用分离冲量修正约束误差。
    public abstract void SolvePosition(double h, double baumgarte);
}
