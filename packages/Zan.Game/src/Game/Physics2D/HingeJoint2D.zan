using System;

namespace Game.Physics2D;

// 2D 旋转铰链关节（HingeJoint2D / PinJoint）。
// 将物体 B 约束在物体 A 的指定世界或局部锚点上，允许自由围绕铰链旋转，
// 用于模拟门轴、钟摆、车轮轴承与 Ragdoll 布娃娃四肢关节。
public class HingeJoint2D {
    public Body2D bodyA;
    public Body2D bodyB;
    public double anchorX; // 铰链世界锚点坐标
    public double anchorY;
    public double maxError; // 允许的微小公差

    public HingeJoint2D(Body2D a, Body2D b, double ax, double ay) {
        this.bodyA = a;
        this.bodyB = b;
        this.anchorX = ax;
        this.anchorY = ay;
        this.maxError = 0.05;
    }

    public static HingeJoint2D Create(Body2D a, Body2D b, double ax, double ay) {
        return new HingeJoint2D(a, b, ax, ay);
    }

    // 约束求解：消除刚体 B 与锚点间的漂移
    public void SolvePositions() {
        if (bodyB == null) { return; }

        // 如果 bodyA 存在，以 bodyA 当前坐标作为动锚点；否则以静态 anchorX, anchorY 为锚点
        double targetX = bodyA != null ? bodyA.x : anchorX;
        double targetY = bodyA != null ? bodyA.y : anchorY;

        double dx = bodyB.x - targetX;
        double dy = bodyB.y - targetY;
        double err = Math.Sqrt(dx * dx + dy * dy);

        if (err > maxError) {
            // 直接将 bodyB 吸附回目标锚点
            if (!bodyB.isStatic) {
                bodyB.x = targetX;
                bodyB.y = targetY;
            }
        }
    }
}
