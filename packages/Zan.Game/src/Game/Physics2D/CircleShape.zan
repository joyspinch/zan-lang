using System;

namespace Game.Physics2D;

// 圆形：局部圆心在原点。
public class CircleShape : Shape {
    // 半径。
    public double radius;

    public CircleShape(double radius) {
        this.radius = radius;
        this.density = 1.0;
    }

    public override double Area() {
        return Math.PI * this.radius * this.radius;
    }

    public override Vec2 Centroid() {
        return new Vec2(0.0, 0.0);
    }

    public override double InertiaPerMass() {
        // 实心圆盘绕圆心：I = m·r²/2。
        return 0.5 * this.radius * this.radius;
    }

    public override Aabb ComputeAabb(Vec2 center, double angle) {
        return Aabb.FromCenter(center, this.radius);
    }

    public override Vec2 Support(Vec2 dir, Vec2 center, double angle) {
        return center + dir.Normalized() * this.radius;
    }
}
