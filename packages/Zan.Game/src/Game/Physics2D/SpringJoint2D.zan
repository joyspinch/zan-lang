using System;

namespace Game.Physics2D;

// 2D 弹簧阻尼关节（SpringJoint2D）。
// 模拟胡克定律弹簧弹性恢复力与粘滞阻尼，常用于悬挂系统、蹦床、弹性挂件。
public class SpringJoint2D {
    public Body2D bodyA;
    public Body2D bodyB;
    public double restLength; // 静止原长
    public double stiffness;  // 弹簧刚度系数 k
    public double damping;    // 阻尼系数 c

    public SpringJoint2D(Body2D a, Body2D b, double restLength, double k, double c) {
        this.bodyA = a;
        this.bodyB = b;
        this.restLength = restLength >= 0.0 ? restLength : 0.0;
        this.stiffness = k >= 0.0 ? k : 50.0;
        this.damping = c >= 0.0 ? c : 2.0;
    }

    public static SpringJoint2D Create(Body2D a, Body2D b, double restLength, double k, double c) {
        return new SpringJoint2D(a, b, restLength, k, c);
    }

    // 弹簧阻尼力学计算并在时间步步进中施加冲量
    public void ApplyForces(double dt) {
        if (bodyA == null || bodyB == null || dt <= 0.0) { return; }

        double dx = bodyB.x - bodyA.x;
        double dy = bodyB.y - bodyA.y;
        double dist = Math.Sqrt(dx * dx + dy * dy);
        if (dist < 0.0001) { return; }

        double nx = dx / dist;
        double ny = dy / dist;

        // 弹簧形变量
        double delta = dist - restLength;
        double springForce = stiffness * delta;

        // 沿法线的相对速度
        double relVx = bodyB.vx - bodyA.vx;
        double relVy = bodyB.vy - bodyA.vy;
        double relSpeed = relVx * nx + relVy * ny;
        double dampForce = damping * relSpeed;

        double totalForce = springForce + dampForce;
        double impulseX = totalForce * nx * dt;
        double impulseY = totalForce * ny * dt;

        bodyA.ApplyImpulse(impulseX, impulseY);
        bodyB.ApplyImpulse(-impulseX, -impulseY);
    }
}
