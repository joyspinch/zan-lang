using System;
using System.Collections.Generic;

namespace Game.Physics2D;

// 2D 关节物理世界（JointWorld2D）。
// 集中管理刚体集合与各种物理关节约束，采用多步迭代（Sub-stepping / PBD）
// 稳定求解距离连杆、绳索链条、弹簧阻尼与铰链旋转，杜绝穿透与形变漂移。
public class JointWorld2D {
    public List<Body2D> bodies;
    public List<DistanceJoint2D> distanceJoints;
    public List<SpringJoint2D> springJoints;
    public List<HingeJoint2D> hingeJoints;

    public double gravityY;
    public int iterations; // 约束迭代求解次数（越多越刚硬，通常 4~8 次即可满足要求）

    public JointWorld2D() {
        this.bodies = new List<Body2D>();
        this.distanceJoints = new List<DistanceJoint2D>();
        this.springJoints = new List<SpringJoint2D>();
        this.hingeJoints = new List<HingeJoint2D>();

        this.gravityY = 980.0; // 默认标准 2D 重力 (像素/秒^2)
        this.iterations = 6;
    }

    public static JointWorld2D Create() {
        return new JointWorld2D();
    }

    public void AddBody(Body2D b) {
        if (b != null) { bodies.Add(b); }
    }

    public void AddDistanceJoint(DistanceJoint2D j) {
        if (j != null) { distanceJoints.Add(j); }
    }

    public void AddSpringJoint(SpringJoint2D j) {
        if (j != null) { springJoints.Add(j); }
    }

    public void AddHingeJoint(HingeJoint2D j) {
        if (j != null) { hingeJoints.Add(j); }
    }

    // 单步时间推进
    public void Step(double dt) {
        if (dt <= 0.0) { return; }

        // 1. 求解弹簧与连续动力学外力
        for (int i = 0; i < springJoints.Count; i = i + 1) {
            springJoints[i].ApplyForces(dt);
        }

        // 2. 积分推进所有刚体
        for (int i = 0; i < bodies.Count; i = i + 1) {
            bodies[i].Integrate(dt, gravityY);
        }

        // 3. 迭代投影求解几何硬约束（消除伸长误差）
        for (int iter = 0; iter < iterations; iter = iter + 1) {
            // 距离约束
            for (int i = 0; i < distanceJoints.Count; i = i + 1) {
                distanceJoints[i].SolvePositions();
            }
            // 铰链约束
            for (int i = 0; i < hingeJoints.Count; i = i + 1) {
                hingeJoints[i].SolvePositions();
            }
        }
    }
}
