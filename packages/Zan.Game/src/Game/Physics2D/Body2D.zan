using System;

namespace Game.Physics2D;

// 2D 物理质点/刚体（Body2D）。
// 维护质点的位置、线速度、质量与受力，支持静态锚点与重力阻尼模拟。
public class Body2D {
    public int id;
    public double x;
    public double y;
    public double vx;
    public double vy;

    public double mass;
    public double invMass; // 0.0 表示无限大质量（静态固定点）
    public bool isStatic;

    public double linearDamping;
    public double gravityScale;

    public Body2D(int id, double x, double y, double mass) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.vx = 0.0;
        this.vy = 0.0;

        this.mass = mass > 0.0 ? mass : 1.0;
        this.invMass = 1.0 / this.mass;
        this.isStatic = false;

        this.linearDamping = 0.02; // 空气阻尼
        this.gravityScale = 1.0;
    }

    public static Body2D CreateDynamic(int id, double x, double y, double mass) {
        return new Body2D(id, x, y, mass);
    }

    public static Body2D CreateStatic(int id, double x, double y) {
        Body2D b = new Body2D(id, x, y, 1.0);
        b.isStatic = true;
        b.invMass = 0.0;
        b.mass = 0.0;
        return b;
    }

    // 施加冲量（速度突变）
    public void ApplyImpulse(double ix, double iy) {
        if (isStatic || invMass == 0.0) { return; }
        vx = vx + ix * invMass;
        vy = vy + iy * invMass;
    }

    // 显式积分步进
    public void Integrate(double dt, double gravityY) {
        if (isStatic || invMass == 0.0) {
            vx = 0.0;
            vy = 0.0;
            return;
        }

        // 施加重力
        vy = vy + gravityY * gravityScale * dt;

        // 空气阻尼衰减
        double damp = 1.0 - linearDamping * dt * 60.0;
        if (damp < 0.0) { damp = 0.0; }
        vx = vx * damp;
        vy = vy * damp;

        // 位置推进
        x = x + vx * dt;
        y = y + vy * dt;
    }
}
