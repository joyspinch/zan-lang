using System;

namespace Game.Physics2D;

// 形状基类：碰撞几何与质量属性的抽象。
//
// 形状是**局部坐标**的——刚体的 position / angle 决定它在世界里的位置与
// 朝向。圆心固定在局部原点；多边形在构造时把顶点平移到质心系（见
// PolygonShape），因此刚体的 position 永远指向形状质心。
//
// 抽象方法由编译器保证"必须实现"：漏实现的派生类在编译期就被拒。
public abstract class Shape {
    // 面密度（质量 = 密度 × 面积）。刚体的质量与转动惯量由此推出。
    public double density;

    public Shape() {
        this.density = 1.0;
    }

    // 面积。
    public abstract double Area();

    // 局部质心（相对局部原点）。
    public abstract Vec2 Centroid();

    // 绕质心的转动惯量（每单位质量，I/m）。
    public abstract double InertiaPerMass();

    // 世界坐标包围盒（center 是质心世界坐标，angle 是旋转角）。
    public abstract Aabb ComputeAabb(Vec2 center, double angle);

    // 沿世界方向 dir 的支撑点（SAT 用：多边形取沿该方向最远的顶点）。
    public abstract Vec2 Support(Vec2 dir, Vec2 center, double angle);
}
