using System;

namespace Game.Physics2D;

// 2D 距离约束关节（DistanceJoint2D）。
// 维持两物体之间的欧氏距离等于 targetDistance（刚性连杆），或在不超过最大长度时允许自由移动（绳索 Rope 模式）。
public class DistanceJoint2D {
    public Body2D bodyA;
    public Body2D bodyB;
    public double targetDistance;
    public double stiffness; // 刚度系数 (0.0 ~ 1.0)
    public bool isRope;      // 是否为绳索模式（若为 true，只有两点距离 > targetDistance 时才施加拉力收缩，靠近时不排斥）

    public DistanceJoint2D(Body2D a, Body2D b, double distance, double stiffness, bool isRope) {
        this.bodyA = a;
        this.bodyB = b;
        this.targetDistance = distance >= 0.0 ? distance : 0.0;
        this.stiffness = stiffness > 1.0 ? 1.0 : (stiffness < 0.0 ? 0.0 : stiffness);
        this.isRope = isRope;
    }

    public static DistanceJoint2D Create(Body2D a, Body2D b, double distance) {
        return new DistanceJoint2D(a, b, distance, 1.0, false);
    }

    public static DistanceJoint2D CreateRope(Body2D a, Body2D b, double maxDistance) {
        return new DistanceJoint2D(a, b, maxDistance, 1.0, true);
    }

    // 执行一次位置投影约束求解（PBD 算法）
    public void SolvePositions() {
        if (bodyA == null || bodyB == null) { return; }
        double w1 = bodyA.invMass;
        double w2 = bodyB.invMass;
        double wSum = w1 + w2;
        if (wSum == 0.0) { return; } // 两者皆为静态固定点

        double dx = bodyB.x - bodyA.x;
        double dy = bodyB.y - bodyA.y;
        double currentDist = Math.Sqrt(dx * dx + dy * dy);
        if (currentDist < 0.0001) { return; }

        // 绳索模式下未拉紧则不产生约束力
        if (isRope && currentDist <= targetDistance) {
            return;
        }

        // 计算形变量
        double delta = currentDist - targetDistance;
        double correction = (delta / currentDist) * stiffness;

        double corrX = dx * correction;
        double corrY = dy * correction;

        if (!bodyA.isStatic && w1 > 0.0) {
            bodyA.x = bodyA.x + corrX * (w1 / wSum);
            bodyA.y = bodyA.y + corrY * (w1 / wSum);
        }
        if (!bodyB.isStatic && w2 > 0.0) {
            bodyB.x = bodyB.x - corrX * (w2 / wSum);
            bodyB.y = bodyB.y - corrY * (w2 / wSum);
        }
    }
}
