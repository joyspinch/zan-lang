namespace Game.Profiler;

// 一个热点分段（"谁在吃帧时间"）。
//
// **热点按累计耗时排，不按单帧最慢排**：单帧最慢的那一次常常是一次异常
// （首次进场的资源加载、GC），它不告诉你"每帧都在花时间的是谁"。累计耗时
// 才是每帧都要付的税。`p95Ms` 与 `medianMs` 一起看：median 低而 p95 高 =
// 偶发尖刺；两者都高 = 稳定的开销。
public class Hotspot {
    // 分段名。
    public string name;
    // 出现过的帧数。
    public int framesPresent;
    // 被计到的总次数（同名分段在多帧里累计）。
    public int callsTotal;
    // 累计耗时（毫秒）。
    public double totalMs;
    // 单帧平均耗时（totalMs / framesPresent）。
    public double meanMs;
    // 单帧中位数与 p95。
    public double medianMs;
    public double p95Ms;
    // 单帧最慢的一次。
    public double maxMs;
    // 占全部帧总耗时的比例（0..1）。
    public double share;

    public Hotspot() {
        this.name = "";
        this.framesPresent = 0;
        this.callsTotal = 0;
        this.totalMs = 0.0;
        this.meanMs = 0.0;
        this.medianMs = 0.0;
        this.p95Ms = 0.0;
        this.maxMs = 0.0;
        this.share = 0.0;
    }
}
