namespace Game.Profiler;

// 一段**连续**超预算的帧（"卡顿连片"）。
//
// 单帧超预算是一回事，连着超是另一回事：连片意味着"这段时间整体跟不上"
//（资源加载、GC 连发、后台任务抢占），单帧尖刺更可能是偶发。报告里两者
// 分开看，才知道该查"稳定开销"还是"偶发事件"。
public class StutterRun {
    // 连片的起始帧号。
    public long startFrame;
    // 连片的结束帧号。
    public long endFrame;
    // 连片长度（帧数）。
    public int count;
    // 连片里最慢的一帧。
    public double worstMs;
    // 连片超出预算的总时长（各帧超出部分之和）。
    public double excessMs;

    public StutterRun() {
        this.startFrame = 0;
        this.endFrame = 0;
        this.count = 0;
        this.worstMs = 0.0;
        this.excessMs = 0.0;
    }
}
