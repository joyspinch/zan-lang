namespace Game.Profiler;

// 一批帧的统计结果。
//
// **分位数用「最近秩」（nearest rank）**：p = ceil(q × n) 的那个样本（1 基）。
// 不用插值——插值的 p95 在样本少时是个"不存在的帧"的虚构值，看报告的人会
// 去找一个不存在的帧。最近秩给的是**真实出现过的某一帧**的耗时。
public class FrameStats {
    // 参与统计的帧数。
    public int count;
    // 全部帧的耗时之和。
    public double totalMs;
    // 最小 / 最大 / 平均。
    public double minMs;
    public double maxMs;
    public double meanMs;
    // 中位数（p50）与高分位。
    public double medianMs;
    public double p90Ms;
    public double p95Ms;
    public double p99Ms;
    // 超预算的帧数。
    public int overBudgetCount;
    // 超预算帧占比（0..1）。
    public double overBudgetRatio;
    // 连续超预算的段数（"卡顿连片"）。
    public int stutterRunCount;
    // 最长的连续超预算段长度（帧数）。
    public int longestStutterRun;

    public FrameStats() {
        this.count = 0;
        this.totalMs = 0.0;
        this.minMs = 0.0;
        this.maxMs = 0.0;
        this.meanMs = 0.0;
        this.medianMs = 0.0;
        this.p90Ms = 0.0;
        this.p95Ms = 0.0;
        this.p99Ms = 0.0;
        this.overBudgetCount = 0;
        this.overBudgetRatio = 0.0;
        this.stutterRunCount = 0;
        this.longestStutterRun = 0;
    }
}
