using System;
using System.Collections.Generic;

namespace Game.Profiler;

// 排序助手。
//
// **为什么自己排**：`List<T>` 没有 `Sort`（见编译器内建成员表），而剖析报告
// 的核心就是"按耗时排序"。这里用**归并排序**：稳定、O(n log n)、不依赖
// 原地交换的下标赋值语义（读—改—写更安全）。
//
// 全部返回**新列表**，不改传入的列表——调用方的样本顺序是"帧的时间顺序"，
// 被排序函数改了就没法再按时间看了。
public class ProfSort {
    // 升序排 double（返回新列表）。
    public static List<double> SortDoubles(List<double> input) {
        int n = input.Count;
        if (n <= 1) {
            List<double> same = new List<double>();
            for (int i = 0; i < n; i = i + 1) { same.Add(input[i]); }
            return same;
        }
        List<double> left = new List<double>();
        List<double> right = new List<double>();
        int half = n / 2;
        for (int i = 0; i < n; i = i + 1) {
            if (i < half) { left.Add(input[i]); } else { right.Add(input[i]); }
        }
        List<double> l = SortDoubles(left);
        List<double> r = SortDoubles(right);
        List<double> merged = new List<double>();
        int i = 0;
        int j = 0;
        while (i < l.Count && j < r.Count) {
            if (l[i] <= r[j]) { merged.Add(l[i]); i = i + 1; }
            else { merged.Add(r[j]); j = j + 1; }
        }
        while (i < l.Count) { merged.Add(l[i]); i = i + 1; }
        while (j < r.Count) { merged.Add(r[j]); j = j + 1; }
        return merged;
    }

    // 升序排 long（返回新列表）。
    public static List<long> SortLongs(List<long> input) {
        int n = input.Count;
        if (n <= 1) {
            List<long> same = new List<long>();
            for (int i = 0; i < n; i = i + 1) { same.Add(input[i]); }
            return same;
        }
        List<long> left = new List<long>();
        List<long> right = new List<long>();
        int half = n / 2;
        for (int i = 0; i < n; i = i + 1) {
            if (i < half) { left.Add(input[i]); } else { right.Add(input[i]); }
        }
        List<long> l = SortLongs(left);
        List<long> r = SortLongs(right);
        List<long> merged = new List<long>();
        int i = 0;
        int j = 0;
        while (i < l.Count && j < r.Count) {
            if (l[i] <= r[j]) { merged.Add(l[i]); i = i + 1; }
            else { merged.Add(r[j]); j = j + 1; }
        }
        while (i < l.Count) { merged.Add(l[i]); i = i + 1; }
        while (j < r.Count) { merged.Add(r[j]); j = j + 1; }
        return merged;
    }
}
