namespace Game.Profiler;

// 帧预算：一帧最多允许花多少毫秒。
//
// **预算是"超"的判据**：不设预算就只能说"这帧 20ms"，有了预算才能说
// "这帧超了 3.4ms"。三档预设对应三档刷新率——同一个游戏在 60Hz 屏上超
// 预算、在 120Hz 屏上可能刚好，所以预算不是常量，是**跟着屏幕走**的。
public class FrameBudget {
    // 预算（毫秒/帧）。
    public double ms;

    public FrameBudget(double ms) {
        if (ms <= 0.0) {
            throw new ProfilerException(ProfError.InvalidBudget, "frame budget must be > 0 ms");
        }
        this.ms = ms;
    }

    // 60Hz（16.667ms）。
    public static FrameBudget Sixty() { return new FrameBudget(1000.0 / 60.0); }
    // 30Hz（33.333ms）。
    public static FrameBudget Thirty() { return new FrameBudget(1000.0 / 30.0); }
    // 120Hz（8.333ms）。
    public static FrameBudget HundredTwenty() { return new FrameBudget(1000.0 / 120.0); }

    // 预算对应的帧率（Hz）。
    public double FramesPerSecond() { return 1000.0 / this.ms; }
}
