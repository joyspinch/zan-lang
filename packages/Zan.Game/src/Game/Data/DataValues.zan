using System;

namespace Game.Data;

// 数值表取值的公共转换：严格整数解析。
//
// 为什么单独放一个类：数值表最常见的线上事故是"策划把 12 写成 12.5"或
// "把空格子当成 0"——宽松转换悄悄改数值，比崩掉更难查。严格解析把这类
// 问题在加载期就顶出来，错误信息带行列定位。
public class DataValues {
    // 严格整数解析：空串、非法字符、溢出都抛异常。
    // context 是错误前缀（"表路径: 第 3 行: hp"）。
    public static int ParseInt(string value, string context) {
        if (value == null || value.Length == 0) {
            throw new Exception(context + ": empty integer");
        }
        int start = value.Substring(0, 1) == "-" ? 1 : 0;
        if (start == value.Length) {
            throw new Exception(context + ": invalid integer");
        }
        long n = 0;
        for (int i = start; i < value.Length; i = i + 1) {
            int digit = value[i] & 255;
            if (digit < 48 || digit > 57) {
                throw new Exception(context + ": invalid integer " + value);
            }
            n = n * 10 + digit - 48;
            if (n > 2147483647) {
                throw new Exception(context + ": integer overflow");
            }
        }
        return start == 1 ? 0 - (int)n : (int)n;
    }

    // 严格浮点解析：空串、非法字符都抛异常。
    //
    // 为什么自己扫一遍字符而不直接 Convert.ToDouble：Convert 对非数字文本
    // 静默返回 0——数值表里"倍率写成 abc"会被当成倍率 0，比崩掉难查得多。
    public static double ParseDouble(string value, string context) {
        if (value == null || value.Length == 0) {
            throw new Exception(context + ": empty number");
        }
        int i = 0;
        if (value[i] == '-' || value[i] == '+') { i = i + 1; }
        int digits = 0;
        while (i < value.Length && value[i] >= '0' && value[i] <= '9') {
            i = i + 1;
            digits = digits + 1;
        }
        if (i < value.Length && value[i] == '.') {
            i = i + 1;
            while (i < value.Length && value[i] >= '0' && value[i] <= '9') {
                i = i + 1;
                digits = digits + 1;
            }
        }
        if (digits < 1) { throw new Exception(context + ": invalid number " + value); }
        if (i < value.Length && (value[i] == 'e' || value[i] == 'E')) {
            i = i + 1;
            if (i < value.Length && (value[i] == '-' || value[i] == '+')) { i = i + 1; }
            int expDigits = 0;
            while (i < value.Length && value[i] >= '0' && value[i] <= '9') {
                i = i + 1;
                expDigits = expDigits + 1;
            }
            if (expDigits < 1) { throw new Exception(context + ": invalid number " + value); }
        }
        if (i != value.Length) { throw new Exception(context + ": invalid number " + value); }
        return Convert.ToDouble(value);
    }
}
