using System;

namespace Game.Data;

// 数值表的一列规格（列名 + 类型 + 取值范围）。
//
// 单独成文件而不是塞进 TableSchema 里：Zan 不支持嵌套类，实体类型一律
// 一个文件一个类（与 Game.Kit.BlitSourceEntry 同一约定）。
public class TableColumn {
    // 列名（CSV 表头里的名字）。
    public string key = "";
    // 列类型：text / int / num。
    public string kind = "text";
    // 数值下界与上界（hasRange 为 false 时不检查）。
    public double min = 0;
    public double max = 0;
    public bool hasRange = false;

    public TableColumn() {}

    public TableColumn(string key, string kind) {
        this.key = key;
        this.kind = kind;
    }
}
