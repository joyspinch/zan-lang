using System;
using System.Collections.Generic;

namespace Game.Data;

// 数值表的一行：列名 → 原始文本。
//
// 表里的一切都是文本，取值靠 Text/Num/Int 显式转换——CSV 是策划能直接
// 改的格式，解析层不做隐式类型推断（"0" 是整数还是浮点，由表结构决定，
// 不由字符串长得像决定）。
public class DataRow {
    // 行 id（"id" 列）与行名（"name" 列）。
    string id = "";
    string name = "";
    // 列名 → 原始文本。
    Dictionary<string, string> fields = new Dictionary<string, string>();
    // 出错定位（"表路径: 第 N 行"）：异常信息靠它指到具体行。
    string location = "";

    public string Id { get { return id; } }
    public string Name { get { return name; } }
    public Dictionary<string, string> Fields { get { return fields; } }
    public string Location { get { return location; } }

    // 设置行 id（加载期由表构建器写入）。
    public void SetId(string value) { this.id = value; }
    // 设置行名（加载期由表构建器写入）。
    public void SetName(string value) { this.name = value; }
    // 设置出错定位。
    public void SetLocation(string value) { this.location = value; }

    // 写一列（加载期用）。
    public void Set(string key, string value) { this.fields[key] = value; }

    // 取列文本：缺列返回空串（宽松）。表结构校验保证该有的列都在，
    // 缺列按"没填"处理而不是炸掉整局游戏。
    public string Text(string key) {
        if (!this.fields.ContainsKey(key)) { return ""; }
        return this.fields[key];
    }

    // 取列文本：缺列抛异常（严格）。关键列（id、倍率、掉落权重）
    // 建议用这个——写错列名要立刻暴露，不能悄悄变成 0。
    public string RequireText(string key) {
        if (!this.fields.ContainsKey(key)) {
            throw new Exception(this.location + ": missing column " + key);
        }
        return this.fields[key];
    }

    // 是否有该列。
    public bool Has(string key) { return this.fields.ContainsKey(key); }

    // 取数值：空串当 0（策划表里空格 = 没填）；非数字文本由 Convert 抛异常。
    public double Num(string key) {
        string s = this.Text(key);
        if (s == "") { return 0; }
        return Convert.ToDouble(s);
    }

    // 取整数（截断小数部分）。
    public int Int(string key) { return (int)this.Num(key); }

    // 取长整数。
    public long Long(string key) { return (long)this.Num(key); }

    // 严格整数：空串、非法字符、溢出都抛异常（错误信息带行列定位）。
    public int RequireInt(string key) {
        return DataValues.ParseInt(this.RequireText(key), this.location + ": " + key);
    }
}
