using System;
using System.Collections.Generic;

namespace Game.Data;

// 数值表的列规格：用一行文本描述表结构。
//
// 规格串（逗号分隔）每项四种写法：
//   name             文本列，必须非空
//   hp:int           整数列，必须是合法整数
//   hp:int:1:999     整数列且落在 [1,999]
//   hp:1:999         整数列且落在 [1,999]（简写，最常见）
//   rate:num:0:1     数值列且落在 [0,1]
//
// 第一项必须是 id 列：行 id 是表的行键，固定在第一列才能让"行序 = id 序"
// 这件事在策划表与代码表之间保持一致（对拍、增量更新都靠它）。
public class TableSchema {
    List<TableColumn> columns = new List<TableColumn>();

    // 列数。
    public int Count() { return this.columns.Count; }
    // 第 index 列的列名。
    public string KeyAt(int index) { return this.columns[index].key; }
    // id 列是否带数值范围：带范围说明 id 是数字（"7"），
    // 不带说明 id 是文本键（"inner_tp_per_kill" 这类规则名）。
    // 两种表的 id 口径不同，调用方据此决定要不要校验 id 的写法。
    public bool IdHasRange() {
        if (this.columns.Count < 1) { return false; }
        return this.columns[0].hasRange;
    }

    // 解析规格串。格式不对直接抛异常——规格写错是代码错误，不是数据错误。
    public static TableSchema Parse(string spec) {
        if (spec == null || spec == "") { throw new Exception("Empty table schema"); }
        TableSchema schema = new TableSchema();
        List<string> parts = spec.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string entry = parts[i].Trim();
            if (entry == "") { throw new Exception("Empty column in schema: " + spec); }
            List<string> bits = entry.Split(":");
            TableColumn col = new TableColumn();
            col.key = bits[0].Trim();
            if (col.key == "") { throw new Exception("Empty column name in schema: " + spec); }
            if (bits.Count == 3) {
                // 简写 key:min:max —— 整数列带范围（最常见的写法）。
                col.kind = "int";
                col.min = DataValues.ParseDouble(bits[1].Trim(), spec + ": " + col.key);
                col.max = DataValues.ParseDouble(bits[2].Trim(), spec + ": " + col.key);
                col.hasRange = true;
            } else if (bits.Count == 4) {
                // 全写 key:type:min:max —— 类型显式，范围同时给出。
                string kind = bits[1].Trim();
                if (kind == "int") { col.kind = "int"; }
                else if (kind == "num") { col.kind = "num"; }
                else { throw new Exception("Unknown column type '" + kind + "' in schema: " + spec); }
                col.min = DataValues.ParseDouble(bits[2].Trim(), spec + ": " + col.key);
                col.max = DataValues.ParseDouble(bits[3].Trim(), spec + ": " + col.key);
                col.hasRange = true;
            } else if (bits.Count == 2) {
                // key:type —— 类型显式，不限范围。
                string kind = bits[1].Trim();
                if (kind == "int") { col.kind = "int"; }
                else if (kind == "num") { col.kind = "num"; }
                else { throw new Exception("Unknown column type '" + kind + "' in schema: " + spec); }
            } else if (bits.Count != 1) {
                throw new Exception("Bad column spec '" + entry + "' in schema: " + spec);
            }
            if (col.hasRange && col.min > col.max) {
                throw new Exception("Inverted range for column " + col.key + " in schema: " + spec);
            }
            schema.columns.Add(col);
        }
        if (schema.columns.Count < 1) { throw new Exception("Empty table schema: " + spec); }
        if (schema.columns[0].key != "id") {
            throw new Exception("First schema column must be id: " + spec);
        }
        return schema;
    }

    // 校验表头：列数一致、规格里的列都在表头里。
    public void ValidateHeader(List<string> header, string place) {
        if (header == null) { throw new Exception(place + ": empty header"); }
        if (header.Count != this.columns.Count) {
            throw new Exception(place + ": schema column count mismatch (expected "
                + Convert.ToString(this.columns.Count) + ", found "
                + Convert.ToString(header.Count) + ")");
        }
        for (int i = 0; i < this.columns.Count; i = i + 1) {
            string key = this.columns[i].key;
            bool found = false;
            for (int j = 0; j < header.Count; j = j + 1) {
                if (header[j] == key) { found = true; }
            }
            if (!found) { throw new Exception(place + ": missing column " + key); }
        }
    }

    // 校验一行：按每列的类型与范围查值。
    public void ValidateRow(DataRow row, string place) {
        for (int i = 0; i < this.columns.Count; i = i + 1) {
            TableColumn col = this.columns[i];
            string context = place + ": " + col.key;
            string value = row.RequireText(col.key);
            if (col.kind == "text") {
                if (value == "") { throw new Exception(context + ": empty value"); }
                continue;
            }
            if (col.kind == "int") {
                int n = DataValues.ParseInt(value, context);
                if (col.hasRange && (n < col.min || n > col.max)) {
                    throw new Exception(context + ": out of range " + Convert.ToString(n));
                }
                continue;
            }
            double d = DataValues.ParseDouble(value, context);
            if (col.hasRange && (d < col.min || d > col.max)) {
                throw new Exception(context + ": out of range " + Convert.ToString(d));
            }
        }
    }
}
