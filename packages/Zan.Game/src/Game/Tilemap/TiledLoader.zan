using System;
using System.Collections.Generic;

namespace Game.Tilemap;

// Tiled 工业标准地图加载与构建器（TiledLoader）。
// 对应 Tiled 关卡编辑器导出的 JSON 地图文件或纯数据流，
// 自动组装多层 TileLayer、实体对象层（Objects），提供统一的资产加载入口。
public class TiledLoader {

    // 从给定的瓦片数据直接组装单个 TileLayer
    public static TileLayer CreateLayerWithData(string name, int cols, int rows, int tileSize, int[] data) {
        TileLayer layer = new TileLayer(name, cols, rows, tileSize);
        if (data != null) {
            int len = data.Length < cols * rows ? data.Length : cols * rows;
            for (int i = 0; i < len; i = i + 1) {
                int c = i % cols;
                int r = i / cols;
                layer.SetTile(c, r, data[i]);
            }
        }
        return layer;
    }

    // 简单轻量 JSON 扫描器：从 Tiled 导出的 JSON 文本中提取整数属性
    public static int ExtractInt(string json, string key, int defaultVal) {
        if (json == null || key == null) { return defaultVal; }
        string pattern = "\"" + key + "\":";
        int idx = json.IndexOf(pattern);
        if (idx < 0) {
            pattern = "\"" + key + "\" :";
            idx = json.IndexOf(pattern);
        }
        if (idx < 0) { return defaultVal; }

        int start = idx + pattern.Length;
        while (start < json.Length && (json[start] == ' ' || json[start] == '\t' || json[start] == '\r' || json[start] == '\n')) {
            start = start + 1;
        }

        int end = start;
        while (end < json.Length && ((json[end] >= '0' && json[end] <= '9') || json[end] == '-')) {
            end = end + 1;
        }

        if (end > start) {
            string numStr = json.Substring(start, end - start);
            try {
                return Convert.ToInt32(numStr);
            } catch (Exception ex) {
                return defaultVal;
            }
        }
        return defaultVal;
    }

    // 从 JSON 数组文本中解析出整数序列（例如 "data": [1, 2, 0, 3]）
    public static List<int> ExtractIntArray(string json, string arrayKey) {
        List<int> list = new List<int>();
        if (json == null || arrayKey == null) { return list; }

        string pattern = "\"" + arrayKey + "\"";
        int idx = json.IndexOf(pattern);
        if (idx < 0) { return list; }

        int openBracket = json.IndexOf("[", idx);
        if (openBracket < 0) { return list; }
        int closeBracket = json.IndexOf("]", openBracket);
        if (closeBracket < 0) { return list; }

        string content = json.Substring(openBracket + 1, closeBracket - openBracket - 1);
        List<string> parts = content.Split(',');
        for (int i = 0; i < parts.Count; i = i + 1) {
            string token = parts[i].Trim();
            if (token.Length > 0) {
                try {
                    list.Add(Convert.ToInt32(token));
                } catch (Exception ex) {
                    // 忽略无效格式
                }
            }
        }
        return list;
    }

    // 解析标准 Tiled JSON 文本，产出完整 TiledMap
    public static TiledMap LoadJson(string json) {
        if (json == null || json.Length == 0) {
            return new TiledMap(1, 1, 32, 32);
        }

        int w = ExtractInt(json, "width", 10);
        int h = ExtractInt(json, "height", 10);
        int tw = ExtractInt(json, "tilewidth", 32);
        int th = ExtractInt(json, "tileheight", 32);

        TiledMap map = new TiledMap(w, h, tw, th);

        // 解析瓦片数据（尝试读取默认 data 数组）
        List<int> data = ExtractIntArray(json, "data");
        if (data.Count > 0) {
            TileLayer defaultLayer = new TileLayer("Ground", w, h, tw);
            for (int i = 0; i < data.Count && i < w * h; i = i + 1) {
                int c = i % w;
                int r = i / w;
                defaultLayer.SetTile(c, r, data[i]);
            }
            map.AddLayer(defaultLayer);
        }

        return map;
    }
}
