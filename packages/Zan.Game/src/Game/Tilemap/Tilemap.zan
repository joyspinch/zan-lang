using System;
using System.Collections.Generic;
using Game.Arcade2D;

namespace Game.Tilemap;

/// <summary>
/// 2D 瓦片图层数据结构。管理固定尺寸 (cols x rows) 的网格单元 ID。
/// </summary>
class TileLayer {
    string name;
    int cols;
    int rows;
    int tileSize;
    List<int> tiles;

    TileLayer(string name, int cols, int rows, int tileSize) {
        this.name = name;
        this.cols = cols;
        if (this.cols <= 0) { this.cols = 1; }
        this.rows = rows;
        if (this.rows <= 0) { this.rows = 1; }
        this.tileSize = tileSize;
        if (this.tileSize <= 0) { this.tileSize = 16; }

        int total = this.cols * this.rows;
        this.tiles = new List<int>();
        int i = 0;
        while (i < total) {
            this.tiles.Add(0);
            i = i + 1;
        }
    }

    string Name() { return this.name; }
    int Cols() { return this.cols; }
    int Rows() { return this.rows; }
    int TileSize() { return this.tileSize; }

    /// 获取整张地图的世界坐标总宽度
    double WorldWidth() { return (double)(this.cols * this.tileSize); }
    /// 获取整张地图的世界坐标总高度
    double WorldHeight() { return (double)(this.rows * this.tileSize); }

    /// 根据网格列与行获取瓦片 ID，超出边界返回 0
    int GetTile(int col, int row) {
        if (col < 0 || col >= this.cols || row < 0 || row >= this.rows) {
            return 0;
        }
        int index = row * this.cols + col;
        return this.tiles[index];
    }

    /// 设置网格指定列与行的瓦片 ID
    void SetTile(int col, int row, int tileId) {
        if (col < 0 || col >= this.cols || row < 0 || row >= this.rows) {
            return;
        }
        int index = row * this.cols + col;
        this.tiles[index] = tileId;
    }

    /// 世界坐标转网格列号
    int WorldToCol(double worldX) {
        if (worldX < 0.0) { return -1; }
        return (int)(worldX / (double)this.tileSize);
    }

    /// 世界坐标转网格行号
    int WorldToRow(double worldY) {
        if (worldY < 0.0) { return -1; }
        return (int)(worldY / (double)this.tileSize);
    }

    /// 网格列转换为世界坐标左侧边缘 X
    double ColToWorldX(int col) {
        return (double)(col * this.tileSize);
    }

    /// 网格行转换为世界坐标顶部边缘 Y
    double RowToWorldY(int row) {
        return (double)(row * this.tileSize);
    }

    /// <summary>
    /// 从实心碰撞瓦片自动提取并合并优化碰撞矩形。
    /// 采用水平行连续合并（Row Merging），将相邻连续的实心瓦片合并为一个长矩形，
    /// 大幅降低物理检测计算开销与内部卡缝问题。
    /// </summary>
    List<Rect2> ExtractColliders(int solidTileId) {
        List<Rect2> colliders = new List<Rect2>();

        int r = 0;
        while (r < this.rows) {
            int c = 0;
            while (c < this.cols) {
                if (this.GetTile(c, r) == solidTileId) {
                    int startCol = c;
                    while (c < this.cols && this.GetTile(c, r) == solidTileId) {
                        c = c + 1;
                    }
                    int spanCols = c - startCol;
                    double rx = (double)(startCol * this.tileSize);
                    double ry = (double)(r * this.tileSize);
                    double rw = (double)(spanCols * this.tileSize);
                    double rh = (double)this.tileSize;
                    colliders.Add(new Rect2(rx, ry, rw, rh));
                } else {
                    c = c + 1;
                }
            }
            r = r + 1;
        }

        return colliders;
    }

    /// <summary>
    /// 解析逗号或换行分隔的 CSV 格式地图数据填充当前图层。
    /// 格式兼容 Tiled CSV 导出与手写 ASCII 数值网格。
    /// </summary>
    void LoadCsv(string csv) {
        if (csv == null) { return; }
        int len = csv.Length;
        int col = 0;
        int row = 0;
        int num = 0;
        bool hasNum = false;
        int sign = 1;

        int i = 0;
        while (i < len && row < this.rows) {
            char ch = csv[i];
            if (ch == '-') {
                sign = -1;
                hasNum = true;
            } else if (ch >= '0' && ch <= '9') {
                num = num * 10 + (int)(ch - '0');
                hasNum = true;
            } else if (ch == ',' || ch == '\n' || ch == '\r') {
                if (hasNum) {
                    this.SetTile(col, row, num * sign);
                    num = 0;
                    hasNum = false;
                    sign = 1;
                    col = col + 1;
                    if (col >= this.cols || ch == '\n') {
                        col = 0;
                        row = row + 1;
                    }
                }
            }
            i = i + 1;
        }
        if (hasNum && row < this.rows && col < this.cols) {
            this.SetTile(col, row, num * sign);
        }
    }
}
