using System;
using System.Collections.Generic;
using Game.Arcade2D;

namespace Game.Tilemap;

// 2D 瓦片图层数据结构。管理固定尺寸 (cols x rows) 的网格单元 ID。
class TileLayer {
    string name;
    int cols;
    int rows;
    int tileSize;
    List<int> tiles;

    TileLayer(string name, int cols, int rows, int tileSize) {
        this.name = name;
        this.cols = cols;
        if (this.cols <= 0) { this.cols = 1; }
        this.rows = rows;
        if (this.rows <= 0) { this.rows = 1; }
        this.tileSize = tileSize;
        if (this.tileSize <= 0) { this.tileSize = 16; }

        int total = this.cols * this.rows;
        this.tiles = new List<int>();
        int i = 0;
        while (i < total) {
            this.tiles.Add(0);
            i = i + 1;
        }
    }

    string Name() { return this.name; }
    int Cols() { return this.cols; }
    int Rows() { return this.rows; }
    int TileSize() { return this.tileSize; }

    // 获取整张地图的世界坐标总宽度
    double WorldWidth() { return (double)(this.cols * this.tileSize); }
    // 获取整张地图的世界坐标总高度
    double WorldHeight() { return (double)(this.rows * this.tileSize); }

    // 根据网格列与行获取瓦片 ID，超出边界返回 0
    int GetTile(int col, int row) {
        if (col < 0 || col >= this.cols || row < 0 || row >= this.rows) {
            return 0;
        }
        int index = row * this.cols + col;
        return this.tiles[index];
    }

    // 设置网格指定列与行的瓦片 ID
    void SetTile(int col, int row, int tileId) {
        if (col < 0 || col >= this.cols || row < 0 || row >= this.rows) {
            return;
        }
        int index = row * this.cols + col;
        this.tiles[index] = tileId;
    }

    // 世界坐标转网格列号
    int WorldToCol(double worldX) {
        if (worldX < 0.0) { return -1; }
        return (int)(worldX / (double)this.tileSize);
    }

    // 世界坐标转网格行号
    int WorldToRow(double worldY) {
        if (worldY < 0.0) { return -1; }
        return (int)(worldY / (double)this.tileSize);
    }

    // 网格列转换为世界坐标左侧边缘 X
    double ColToWorldX(int col) {
        return (double)(col * this.tileSize);
    }

    // 网格行转换为世界坐标顶部边缘 Y
    double RowToWorldY(int row) {
        return (double)(row * this.tileSize);
    }

    // 从实心碰撞瓦片自动提取并合并优化碰撞矩形。
    // 采用水平行连续合并（Row Merging），将相邻连续的实心瓦片合并为一个长矩形，
    // 大幅降低物理检测计算开销与内部卡缝问题。
    List<Rect2> ExtractColliders(int solidTileId) {
        List<Rect2> colliders = new List<Rect2>();

        int r = 0;
        while (r < this.rows) {
            int c = 0;
            while (c < this.cols) {
                if (this.GetTile(c, r) == solidTileId) {
                    int startCol = c;
                    while (c < this.cols && this.GetTile(c, r) == solidTileId) {
                        c = c + 1;
                    }
                    int spanCols = c - startCol;
                    double rx = (double)(startCol * this.tileSize);
                    double ry = (double)(r * this.tileSize);
                    double rw = (double)(spanCols * this.tileSize);
                    double rh = (double)this.tileSize;
                    colliders.Add(new Rect2(rx, ry, rw, rh));
                } else {
                    c = c + 1;
                }
            }
            r = r + 1;
        }

        return colliders;
    }

    // 从给定的多个实心瓦片 ID 集合提取并合并碰撞矩形（水平行合并）。
    // 支持同时匹配多种实心障碍物瓦片（例如墙壁、石块、管道等）。
    List<Rect2> ExtractCollidersMatching(List<int> solidTileIds) {
        List<Rect2> colliders = new List<Rect2>();
        if (solidTileIds == null || solidTileIds.Count == 0) {
            return colliders;
        }

        int r = 0;
        while (r < this.rows) {
            int c = 0;
            while (c < this.cols) {
                int tid = this.GetTile(c, r);
                if (TileLayer.ContainsId(solidTileIds, tid)) {
                    int startCol = c;
                    while (c < this.cols && TileLayer.ContainsId(solidTileIds, this.GetTile(c, r))) {
                        c = c + 1;
                    }
                    int spanCols = c - startCol;
                    double rx = (double)(startCol * this.tileSize);
                    double ry = (double)(r * this.tileSize);
                    double rw = (double)(spanCols * this.tileSize);
                    double rh = (double)this.tileSize;
                    colliders.Add(new Rect2(rx, ry, rw, rh));
                } else {
                    c = c + 1;
                }
            }
            r = r + 1;
        }

        return colliders;
    }

    // 从瓦片 ID 区间 [minTileId, maxTileId] 提取并合并碰撞矩形（水平行合并）。
    // 适合图集中连续一片区域作为地形/建筑碰撞体的场景。
    List<Rect2> ExtractCollidersRange(int minTileId, int maxTileId) {
        List<Rect2> colliders = new List<Rect2>();
        if (minTileId > maxTileId) {
            return colliders;
        }

        int r = 0;
        while (r < this.rows) {
            int c = 0;
            while (c < this.cols) {
                int tid = this.GetTile(c, r);
                if (tid >= minTileId && tid <= maxTileId) {
                    int startCol = c;
                    while (c < this.cols) {
                        int cur = this.GetTile(c, r);
                        if (cur >= minTileId && cur <= maxTileId) {
                            c = c + 1;
                        } else {
                            break;
                        }
                    }
                    int spanCols = c - startCol;
                    double rx = (double)(startCol * this.tileSize);
                    double ry = (double)(r * this.tileSize);
                    double rw = (double)(spanCols * this.tileSize);
                    double rh = (double)this.tileSize;
                    colliders.Add(new Rect2(rx, ry, rw, rh));
                } else {
                    c = c + 1;
                }
            }
            r = r + 1;
        }

        return colliders;
    }

    // 二维贪心矩形合并碰撞提取（2D Greedy Box Merging）。
    // 先进行水平跨列合并，再将上下相邻且水平起始列和跨度完全一致的横条垂直向上/下合并为一个大矩形。
    // 能将大型平台、实心高墙或地面（如 20x10 网格）直接压缩为极少数整块 Rect2，彻底杜绝跳跃/冲刺时的缝隙穿透与卡顿。
    List<Rect2> ExtractCollidersOptimized2D(int solidTileId) {
        List<Rect2> rowBoxes = this.ExtractColliders(solidTileId);
        return TileLayer.MergeBoxesVertically(rowBoxes, this.tileSize);
    }

    // 多瓦片 ID 匹配的二维贪心矩形合并碰撞提取。
    List<Rect2> ExtractCollidersMatchingOptimized2D(List<int> solidTileIds) {
        List<Rect2> rowBoxes = this.ExtractCollidersMatching(solidTileIds);
        return TileLayer.MergeBoxesVertically(rowBoxes, this.tileSize);
    }

    // 区间匹配的二维贪心矩形合并碰撞提取。
    List<Rect2> ExtractCollidersRangeOptimized2D(int minTileId, int maxTileId) {
        List<Rect2> rowBoxes = this.ExtractCollidersRange(minTileId, maxTileId);
        return TileLayer.MergeBoxesVertically(rowBoxes, this.tileSize);
    }

    static bool ContainsId(List<int> list, int target) {
        int i = 0;
        int count = list.Count;
        while (i < count) {
            if (list[i] == target) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    static List<Rect2> MergeBoxesVertically(List<Rect2> boxes, int tileSize) {
        List<Rect2> result = new List<Rect2>();
        int count = boxes.Count;
        if (count == 0) {
            return result;
        }

        List<bool> merged = new List<bool>();
        int k = 0;
        while (k < count) {
            merged.Add(false);
            k = k + 1;
        }

        double ts = (double)tileSize;

        int i = 0;
        while (i < count) {
            if (merged[i]) {
                i = i + 1;
                continue;
            }

            Rect2 baseBox = boxes[i];
            double bx = baseBox.X();
            double by = baseBox.Y();
            double bw = baseBox.Width();
            double bh = baseBox.Height();

            // 向后探测在后续行中是否有 x 和 width 完全相等且紧挨着底部的矩形 (y == by + bh)
            int j = i + 1;
            while (j < count) {
                if (!merged[j]) {
                    Rect2 candidate = boxes[j];
                    if (candidate.X() == bx && candidate.Width() == bw && candidate.Y() == (by + bh)) {
                        bh = bh + candidate.Height();
                        merged[j] = true;
                    }
                }
                j = j + 1;
            }

            merged[i] = true;
            result.Add(new Rect2(bx, by, bw, bh));
            i = i + 1;
        }

        return result;
    }

    // 解析逗号或换行分隔的 CSV 格式地图数据填充当前图层。
    // 格式兼容 Tiled CSV 导出与手写 ASCII 数值网格。
    void LoadCsv(string csv) {
        if (csv == null) { return; }
        int len = csv.Length;
        int col = 0;
        int row = 0;
        int num = 0;
        bool hasNum = false;
        int sign = 1;

        int i = 0;
        while (i < len && row < this.rows) {
            char ch = csv[i];
            if (ch == '-') {
                sign = -1;
                hasNum = true;
            } else if (ch >= '0' && ch <= '9') {
                num = num * 10 + (int)(ch - '0');
                hasNum = true;
            } else if (ch == ',' || ch == '\n' || ch == '\r') {
                if (hasNum) {
                    this.SetTile(col, row, num * sign);
                    num = 0;
                    hasNum = false;
                    sign = 1;
                    col = col + 1;
                    if (col >= this.cols || ch == '\n') {
                        col = 0;
                        row = row + 1;
                    }
                }
            }
            i = i + 1;
        }
        if (hasNum && row < this.rows && col < this.cols) {
            this.SetTile(col, row, num * sign);
        }
    }
}
