using System;
using System.Collections.Generic;
using Game.Arcade2D;

namespace Game.Tilemap;

// Tiled 行业标准地图数据模型（TiledMap）。
// 包含多层瓦片图层（TileLayer）与对象层物件（TiledObject，如玩家出生点、怪物巡逻点、静态碰撞体）。
public class TiledMap {
    public class TiledObject {
        public string name;
        public string type;
        public double x;
        public double y;
        public double width;
        public double height;

        public TiledObject(string name, string type, double x, double y, double w, double h) {
            this.name = name != null ? name : "";
            this.type = type != null ? type : "";
            this.x = x;
            this.y = y;
            this.width = w > 0.0 ? w : 1.0;
            this.height = h > 0.0 ? h : 1.0;
        }

        public Rect2 ToRect2() {
            return new Rect2(x, y, width, height);
        }
    }

    public int cols;
    public int rows;
    public int tileWidth;
    public int tileHeight;

    public List<TileLayer> tileLayers;
    public List<TiledObject> objects;

    public TiledMap(int cols, int rows, int tileW, int tileH) {
        this.cols = cols > 0 ? cols : 1;
        this.rows = rows > 0 ? rows : 1;
        this.tileWidth = tileW > 0 ? tileW : 32;
        this.tileHeight = tileH > 0 ? tileH : 32;
        this.tileLayers = new List<TileLayer>();
        this.objects = new List<TiledObject>();
    }

    public static TiledMap Create(int cols, int rows, int tileW, int tileH) {
        return new TiledMap(cols, rows, tileW, tileH);
    }

    public int Cols { get { return cols; } }
    public int Rows { get { return rows; } }
    public int TileWidth { get { return tileWidth; } }
    public int TileHeight { get { return tileHeight; } }
    public double WorldWidth { get { return (double)(cols * tileWidth); } }
    public double WorldHeight { get { return (double)(rows * tileHeight); } }

    public void AddLayer(TileLayer layer) {
        if (layer != null) {
            tileLayers.Add(layer);
        }
    }

    public void AddObject(TiledObject obj) {
        if (obj != null) {
            objects.Add(obj);
        }
    }

    // 根据名称获取瓦片图层
    public TileLayer GetLayer(string name) {
        for (int i = 0; i < tileLayers.Count; i = i + 1) {
            if (tileLayers[i] != null && tileLayers[i].Name() == name) {
                return tileLayers[i];
            }
        }
        return null;
    }

    // 根据名称查找单个关卡对象
    public TiledObject GetObject(string name) {
        for (int i = 0; i < objects.Count; i = i + 1) {
            if (objects[i] != null && objects[i].name == name) {
                return objects[i];
            }
        }
        return null;
    }

    // 根据类型查找全部匹配的对象（例如 type="EnemySpawn"）
    public List<TiledObject> GetObjectsByType(string type) {
        List<TiledObject> list = new List<TiledObject>();
        for (int i = 0; i < objects.Count; i = i + 1) {
            if (objects[i] != null && objects[i].type == type) {
                list.Add(objects[i]);
            }
        }
        return list;
    }

    // 一键提取指定图层的合并碰撞盒（利用 TileLayer 贪心矩形合并算法）
    public List<Rect2> GenerateLayerColliders(string layerName, int solidTileId) {
        TileLayer layer = GetLayer(layerName);
        if (layer == null) {
            return new List<Rect2>();
        }
        return layer.ExtractCollidersOptimized2D(solidTileId);
    }
}
