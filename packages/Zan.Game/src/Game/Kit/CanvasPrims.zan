// Game.Kit 的画布直绘层：Sprite/Draw/Text/KitUi 在 stdlib/Gui Canvas 上的
// 等价实现，供 GuiHost（Game.Foundation.Gui）主循环的游戏模板使用——
// SDL 版烘焙纹理（SdlTexture.CreateTarget）的地方改成立即模式直绘，
// 窗口/事件/呈现由 Gui 原生外壳承担，不依赖 SDL。
using System;
using System.IO;
using Gui;

namespace Game.Kit;

// 光晕与实心圆盘：SDL 版 Sprite 把圆盘/径向衰减烘焙成纹理再一个四边形
// 贴出；画布版 FillRadial 原生就是"中心 innerAlpha 平滑衰减到半径处 0"。
class CSprite {
    // 柔和光环（边缘 alpha 衰减到 0）。
    static void Glow(Canvas c, int cx, int cy, int rad,
                     int cr, int cg, int cb, int ca) {
        if (rad <= 0) { return; }
        c.FillRadial(CDraw.MapX(cx + CDraw.originX),
                     CDraw.MapY(cy + CDraw.originY), CDraw.MapW(rad),
                     CDraw.Argb(255, cr, cg, cb), ca);
    }

    // 实心带透明度的圆盘。
    static void Ball(Canvas c, int cx, int cy, int rad,
                     int cr, int cg, int cb, int ca) {
        if (rad <= 0) { return; }
        c.FillCircle(CDraw.MapX(cx + CDraw.originX),
                     CDraw.MapY(cy + CDraw.originY), CDraw.MapW(rad),
                     CDraw.Argb(ca, cr, cg, cb));
    }
}

// 画布上的整数几何原语（SDL 版 Draw 的等价子集）。
// 所有 C* 绘制都叠加模块级原点（Origin）：GuiHost 的窗口带标准
// 标题栏，模板按 0 基舞台坐标绘制，帧首 Origin(0, host.ContentTop())
// 即可整体落到标题栏之下；全屏（ContentTop()==0）自然退化。
class CDraw {
    static int originX;
    static int originY;

    /// 设置本帧舞台绘制的画布原点；模板 Render 开头调用一次。
    static void Origin(int x, int y) {
        CDraw.originX = x;
        CDraw.originY = y;
    }

    // 桌面窗口跟随视口（StageViewport）：逻辑坐标 → 设备画布的等比
    // 映射，单轴延伸——短轴贴设计尺寸、长轴按窗口比例延展逻辑空间
    // （宽窗多看宽度、窄窗多看高度），任何窗口都满铺：零黑边、零变
    // 形。vpS 是 16.16 缩放（65536 = 1:1），vpX/vpY 是逻辑 (0,0) 的设
    // 备位置；stageW/stageH 是延展后的逻辑舞台尺寸（模板取它当绘制
    // 范围）。未启用时恒 1:1、零偏移——映射退化为 x+origin，与历史
    // 行为逐像素一致。
    static int vpS = 65536;
    static int vpX;
    static int vpY;
    static int stageW;
    static int stageH;

    // 逻辑 → 设备。坐标带偏移，尺寸至少 1px。
    static int MapX(int v) { return CDraw.vpX + ((v * CDraw.vpS) >> 16); }
    static int MapY(int v) { return CDraw.vpY + ((v * CDraw.vpS) >> 16); }
    static int MapW(int v) {
        int r = (v * CDraw.vpS) >> 16;
        return r < 1 ? 1 : r;
    }

    // 设备 → 逻辑（指针坐标回舞台空间；GuiHost.MouseX/Y 用）。
    static int UnmapX(int v) { return ((v - CDraw.vpX) << 16) / CDraw.vpS; }
    static int UnmapY(int v) { return ((v - CDraw.vpY) << 16) / CDraw.vpS; }

    /// 桌面窗口跟随：内容区 [contentTopPx, 画布底) 等比铺满逻辑
    /// designW×designH——缩放取短轴，长轴延展成更大的逻辑空间（不
    /// 缩放不裁剪），故无黑边。帧首整块铺 marginColor 打底（延展边、
    /// 换面首帧不至于露垃圾），模板随后按 stageW/stageH 满画。指针
    /// 坐标用 UnmapX/UnmapY 换回。GuiHost 每帧调用。
    static void StageViewport(Canvas c, int contentTopPx, int designW,
                              int designH, int marginColor) {
        if (designW < 1) { designW = 1; }
        if (designH < 1) { designH = 1; }
        int cw = c.Width();
        int chh = c.Height() - contentTopPx;
        if (cw < 1 || chh < 1) {
            CDraw.vpS = 65536;
            CDraw.vpX = 0;
            CDraw.vpY = contentTopPx;
            CDraw.stageW = cw > 0 ? cw : designW;
            CDraw.stageH = chh > 0 ? chh : designH;
            return;
        }
        int sH = chh * 65536 / designH;   // 拟高：更矮（宽窗）时选它
        int sW = cw * 65536 / designW;    // 拟宽：更窄（竖窗）时选它
        int s = sH < sW ? sH : sW;
        CDraw.vpS = s;
        CDraw.vpX = 0;
        CDraw.vpY = contentTopPx;
        CDraw.stageW = cw * 65536 / s;
        CDraw.stageH = chh * 65536 / s;
        c.FillRect(0, contentTopPx, cw, chh, marginColor);
    }

    // 画布颜色是 0xAARRGGBB。
    static int Argb(int a, int r, int g, int b) {
        return a * 16777216 + r * 65536 + g * 256 + b;
    }

    static void FillRect(Canvas c, int x, int y, int w, int h, int color) {
        c.FillRect(MapX(x + originX), MapY(y + originY), MapW(w), MapW(h),
                   color);
    }

    static void FillVGrad(Canvas c, int x, int y, int w, int h,
                          int colorTop, int colorBottom) {
        c.FillVGrad(MapX(x + originX), MapY(y + originY), MapW(w), MapW(h),
                    colorTop, colorBottom);
    }

    // 清舞台矩形（清屏色只铺内容区，标题栏由 chrome 自绘）。
    static void Clear(Canvas c, int w, int h, int color) {
        c.FillRect(MapX(originX), MapY(originY), MapW(w), MapW(h), color);
    }

    // 贴图源统一走内存键：File.ReadAllBytes 盘优先、内嵌兜底（Android
    // 等无盘环境里发布镜像的贴图只存在于内嵌表，运行时按路径的解码
    // 缓存读不到文件），ImageLoadMem 注册成 mem: 键再贴——桌面与手机
    // 同一条代码路径。同路径的注册结果缓存，帧内重复贴不重读。
    static List<string> blitSrcPaths;
    static List<string> blitSrcKeys;

    static string BlitSource(Canvas c, string path) {
        if (path == null) { return null; }
        if (CDraw.blitSrcPaths == null) {
            CDraw.blitSrcPaths = new List<string>();
            CDraw.blitSrcKeys = new List<string>();
        }
        for (int i = 0; i < CDraw.blitSrcPaths.Count; i = i + 1) {
            if (CDraw.blitSrcPaths[i] == path) { return CDraw.blitSrcKeys[i]; }
        }
        byte[] b = File.ReadAllBytes(path);
        string key = "mem:" + path;
        Canvas.ImageLoadMem(key, b, b.Length);
        CDraw.blitSrcPaths.Add(path);
        CDraw.blitSrcKeys.Add(key);
        return key;
    }

    // 按路径缩放绘制整幅图片（解码缓存由画布持有）。
    static void BlitImage(Canvas c, string path, int dx, int dy, int dw, int dh) {
        string src = CDraw.BlitSource(c, path);
        if (src == null) { return; }
        c.BlitImage(src, MapX(dx + originX), MapY(dy + originY),
                    MapW(dw), MapW(dh), 0, 0, 0, 0);
    }

    static void RoundRectFill(Canvas c, int x, int y, int w, int h, int rad,
                              int cr, int cg, int cb, int ca) {
        if (w <= 0 || h <= 0) { return; }
        if (rad * 2 > w) { rad = w / 2; }
        if (rad * 2 > h) { rad = h / 2; }
        c.FillRoundRect(MapX(x + originX), MapY(y + originY), MapW(w), MapW(h),
                        MapW(rad), Argb(ca, cr, cg, cb));
    }

    // 矩形描边环（厚度 t，画在矩形内侧）。
    static void RingRect(Canvas c, int x, int y, int w, int h, int t,
                         int cr, int cg, int cb, int ca) {
        if (w <= 0 || h <= 0 || t <= 0) { return; }
        int col = Argb(ca, cr, cg, cb);
        int dx = MapX(x + originX);
        int dy = MapY(y + originY);
        int dw = MapW(w);
        int dh = MapW(h);
        int dt = MapW(t);
        c.FillRect(dx, dy, dw, dt, col);
        c.FillRect(dx, dy + dh - dt, dw, dt, col);
        c.FillRect(dx, dy, dt, dh, col);
        c.FillRect(dx + dw - dt, dy, dt, dh, col);
    }

    static void FillCircle(Canvas c, int cx, int cy, int rad,
                           int cr, int cg, int cb, int ca) {
        if (rad <= 0) { return; }
        c.FillCircle(MapX(cx + originX), MapY(cy + originY), MapW(rad),
                     Argb(ca, cr, cg, cb));
    }

    // 直线段（抗锯齿、厚度 t，圆头）：绳线/描迹用。
    static void Line(Canvas c, int x0, int y0, int x1, int y1, int t,
                     int cr, int cg, int cb, int ca) {
        if (t <= 0) { return; }
        c.DrawLine(MapX(x0 + originX), MapY(y0 + originY),
                   MapX(x1 + originX), MapY(y1 + originY),
                   Argb(ca, cr, cg, cb), MapW(t));
    }

    // 圆环描边（厚度 t 画在半径上）：QTE 圈/瞄准环用。
    static void CircleStroke(Canvas c, int cx, int cy, int rad, int t,
                             int cr, int cg, int cb, int ca) {
        if (rad <= 0 || t <= 0) { return; }
        c.DrawCircle(MapX(cx + originX), MapY(cy + originY), MapW(rad),
                     Argb(ca, cr, cg, cb), MapW(t));
    }

    static bool PointIn(int px, int py, int x, int y, int w, int h) {
        return px >= x && px < x + w && py >= y && py < y + h;
    }
}

// 系统字体文字（SDL 版 Text 走 SysFont；画布版 DrawText 本就是系统
// 字体，scale 沿用 Kit 的"字号档"语义：PxOf = scale*9 像素）。
class CText {
    // Kit scale 档 → 画布字号（对齐 SysFont.PxOf，HUD 版式不用重调）。
    // FontPx 保持逻辑单位（排版用它）；落笔时经视口缩放成设备字号，
    // 系统字体按设备字号渲染——窗口放大字不失真。
    static int FontPx(int scale) {
        if (scale < 1) { scale = 1; }
        return scale * 9;
    }
    static int LineHeight(int scale) { return CText.FontPx(scale); }
    static int DevPx(int scale) { return CDraw.MapW(CText.FontPx(scale)); }

    // 量宽（右对齐/居中排版用；与 Draw 同一字号档，返回逻辑宽度）。
    static int Width(string text, int scale) {
        if (text == null || text.Length == 0) { return 0; }
        int dev = Canvas.MeasureText(text, CText.DevPx(scale));
        return dev * 65536 / CDraw.vpS;
    }

    // 左上角锚定（y 是行盒顶，不是基线）——与 Text.Draw 契约一致。
    // 其余 CText 入口（居中/阴影）全部经此落笔，原点只加这一处。
    static void Draw(Canvas c, string text, int x, int y, int scale,
                     int cr, int cg, int cb, int ca) {
        if (text == null || text.Length == 0) { return; }
        c.DrawText(CDraw.MapX(x + CDraw.originX), CDraw.MapY(y + CDraw.originY),
                   text, CDraw.Argb(ca, cr, cg, cb), CText.DevPx(scale));
    }

    static void DrawCentered(Canvas c, string text, int centerX, int y,
                             int scale, int cr, int cg, int cb, int ca) {
        if (text == null || text.Length == 0) { return; }
        int w = CText.Width(text, scale);
        CText.Draw(c, text, centerX - w / 2, y, scale, cr, cg, cb, ca);
    }

    // 软阴影：偏移随字号取小值，主文字透明度单独给（同 Text.DrawShadow）。
    static void DrawShadow(Canvas c, string text, int x, int y, int scale,
                           int cr, int cg, int cb, int ca) {
        if (text == null || text.Length == 0) { return; }
        int so = 1 + scale;
        CText.Draw(c, text, x + so, y + so, scale, 0, 0, 0, 150);
        CText.Draw(c, text, x, y, scale, cr, cg, cb, ca);
    }

    static void DrawCenteredShadow(Canvas c, string text, int centerX, int y,
                                   int scale, int cr, int cg, int cb, int ca) {
        if (text == null || text.Length == 0) { return; }
        int w = CText.Width(text, scale);
        CText.DrawShadow(c, text, centerX - w / 2, y, scale, cr, cg, cb, ca);
    }
}

// 共享 UI 套件（SDL 版 KitUi 的画布等价）：整幅铺底图 + 压暗纱，
// 三态圆角按钮。颜色/层次与 KitUi 逐项对齐，游戏菜单观感不变。
class CKitUi {
    // 背景图铺满画布（路径为空退化为竖向渐变），再叠可读性压暗纱。
    static void Backdrop(Canvas c, string bgPath, int w, int h) {
        if (bgPath != null && bgPath.Length > 0) {
            CDraw.BlitImage(c, bgPath, 0, 0, w, h);
        } else {
            CDraw.FillVGrad(c, 0, 0, w, h, CDraw.Argb(255, 18, 22, 32),
                            CDraw.Argb(255, 8, 10, 16));
        }
        CDraw.FillVGrad(c, 0, 0, w, h, CDraw.Argb(70, 6, 8, 14),
                        CDraw.Argb(70, 6, 8, 14));
        CDraw.FillVGrad(c, 0, h * 3 / 5, w, h * 2 / 5, CDraw.Argb(150, 6, 8, 14),
                        CDraw.Argb(150, 8, 10, 16));
    }

    // 三态扁平圆角按钮（kind: 0 普通、1 强调、2 选中），悬停返回 true。
    // 配色与 KitUi.Button 逐项一致。
    static bool Button(Canvas c, int mx, int my, int x, int y, int w, int h,
                       string label, int scale, int kind) {
        bool hov = CDraw.PointIn(mx, my, x, y, w, h);
        int mr = 47; int mg = 54; int mb = 72;
        int tc = 238;
        if (kind == 1) {
            mr = 44; mg = 128; mb = 88;
        } else if (kind == 2) {
            mr = 226; mg = 178; mb = 64; tc = 36;
        }
        if (hov) {
            if (kind == 1) { mr = 56; mg = 152; mb = 104; }
            else if (kind == 2) { mr = 244; mg = 196; mb = 78; }
            else { mr = 62; mg = 71; mb = 96; }
        }
        if (hov) {
            int gr = 130; int gg = 190; int gb = 245;
            if (kind == 1) { gr = 120; gg = 230; gb = 170; }
            if (kind == 2) { gr = 250; gg = 210; gb = 110; }
            CDraw.RoundRectFill(c, x - 5, y - 5, w + 10, h + 10, 17, gr, gg, gb, 50);
        }
        // 深色外圈 + 平色主体 + 一道极细内亮边（无中线分缝）。
        CDraw.RoundRectFill(c, x - 2, y - 2, w + 4, h + 4, 14, 10, 12, 20, 240);
        CDraw.RoundRectFill(c, x, y, w, h, 12, mr, mg, mb, 255);
        c.DrawRoundRect(CDraw.MapX(x + 1 + CDraw.originX),
                        CDraw.MapY(y + 1 + CDraw.originY),
                        CDraw.MapW(w - 2), CDraw.MapW(h - 2), CDraw.MapW(11),
                        CDraw.Argb(28, 255, 255, 255), CDraw.MapW(1));
        CText.DrawCenteredShadow(c, label, x + w / 2, y + (h - CText.LineHeight(scale)) / 2,
                                 scale, tc, tc, tc, 255);
        return hov;
    }
}

// 美术化支持层（CFx）：真实美术资产（背景/棋盘/棋子/面板贴图）之外的
// 画布效果——投影、渐变面板、描金、暗角、鎏金按钮。定位是支持层：
// 大面积表面优先贴资产，CFx 负责资产落位后的压影/提亮/描金，以及
// 无资产时的同观感直绘回退。所有几何都经 CDraw 映射（视口缩放 +
// 模块原点），命中区语义与 CKitUi 完全一致。
class CFx {
    // 柔和投影（SDF smoothstep，几何连续、不随层叠变黑）。
    static void ShadowRect(Canvas c, int x, int y, int w, int h, int rad,
                           int blur, int cr, int cg, int cb, int ca) {
        if (blur <= 0 || ca <= 0) { return; }
        c.ShadowRoundRect(CDraw.MapX(x + CDraw.originX),
                          CDraw.MapY(y + CDraw.originY), CDraw.MapW(w),
                          CDraw.MapW(h), CDraw.MapW(rad), CDraw.MapW(blur),
                          CDraw.Argb(ca, cr, cg, cb));
    }

    // 圆角渐变面（dir: 0 上→下 1 左→右 2 右下对角 3 左下对角；
    // c0/cv/c1 是 0xAARRGGBB，cv=0 表示无中间停靠点，端点可带 alpha）。
    static void GradRect(Canvas c, int x, int y, int w, int h, int rad,
                         int dir, int c0, int cv, int c1) {
        c.FillGradMask(CDraw.MapX(x + CDraw.originX),
                       CDraw.MapY(y + CDraw.originY), CDraw.MapW(w),
                       CDraw.MapW(h), CDraw.MapW(rad), 15, dir, c0, cv, c1);
    }

    // 圆角描边环（厚度 t 画在轮廓上；ca<=0 跳过）。
    static void Ring(Canvas c, int x, int y, int w, int h, int rad, int t,
                     int cr, int cg, int cb, int ca) {
        if (ca <= 0 || t <= 0 || w <= 0 || h <= 0) { return; }
        c.DrawRoundRect(CDraw.MapX(x + CDraw.originX),
                        CDraw.MapY(y + CDraw.originY), CDraw.MapW(w),
                        CDraw.MapW(h), CDraw.MapW(rad),
                        CDraw.Argb(ca, cr, cg, cb), CDraw.MapW(t));
    }

    static void RingCircle(Canvas c, int cx, int cy, int rad, int t,
                           int cr, int cg, int cb, int ca) {
        if (ca <= 0 || t <= 0 || rad <= 0) { return; }
        c.DrawCircle(CDraw.MapX(cx + CDraw.originX),
                     CDraw.MapY(cy + CDraw.originY), CDraw.MapW(rad),
                     CDraw.Argb(ca, cr, cg, cb), CDraw.MapW(t));
    }

    // 提亮卡：投影 + 竖向渐变面 + 描边 + 顶部一道内亮线。
    static void Card(Canvas c, int x, int y, int w, int h, int rad,
                     int fr, int fg, int fb, int f2r, int f2g, int f2b,
                     int tr, int tg, int tb, int ta, int t, int dir) {
        CFx.ShadowRect(c, x, y + 4, w, h, rad, 16, 0, 0, 0, 110);
        CFx.GradRect(c, x, y, w, h, rad, dir,
                     CDraw.Argb(255, fr, fg, fb), 0,
                     CDraw.Argb(255, f2r, f2g, f2b));
        CFx.Ring(c, x, y, w, h, rad, t, tr, tg, tb, ta);
        if (h > 2 * rad + 4) {
            CDraw.FillRect(c, x + rad / 2, y + 1, w - rad, 1,
                           CDraw.Argb(56, 255, 244, 220));
        }
    }

    // 胶囊条（rad = h/2）：投影 + 渐变 + 细描边，做徽标/分段条。
    static void Pill(Canvas c, int x, int y, int w, int h, int dir,
                     int fr, int fg, int fb, int f2r, int f2g, int f2b,
                     int tr, int tg, int tb, int ta) {
        int rad = h / 2;
        if (rad < 4) { rad = 4; }
        CFx.ShadowRect(c, x, y + 2, w, h, rad, 8, 0, 0, 0, 90);
        CFx.GradRect(c, x, y, w, h, rad, dir,
                     CDraw.Argb(255, fr, fg, fb), 0,
                     CDraw.Argb(255, f2r, f2g, f2b));
        CFx.Ring(c, x, y, w, h, rad, 1, tr, tg, tb, ta);
    }

    // 鎏金/漆木按钮（kind: 0 漆木 1 鎏金 2 暗金）。命中区与
    // CKitUi.Button 完全一致（同一矩形，悬停光晕外扩不算命中），
    // 两者混用不产生命中漂移。
    static bool GoldButton(Canvas c, int mx, int my, int x, int y, int w,
                           int h, string label, int scale, int kind) {
        bool hov = CDraw.PointIn(mx, my, x, y, w, h);
        int rad = h / 3;
        if (rad > 12) { rad = 12; }
        int fr = 66; int fg = 42; int fb = 26;
        int f2r = 38; int f2g = 24; int f2b = 14;
        int tcR = 244; int tcG = 232; int tcB = 208;
        bool shadowText = true;
        if (kind == 1) {
            fr = 250; fg = 214; fb = 132;
            f2r = 196; f2g = 138; f2b = 54;
            tcR = 62; tcG = 38; tcB = 10;
            shadowText = false;
        } else if (kind == 2) {
            fr = 236; fg = 196; fb = 110;
            f2r = 186; f2g = 132; f2b = 44;
            tcR = 56; tcG = 34; tcB = 10;
            shadowText = false;
        }
        if (hov) {
            int gr = 240; int gg = 210; int gb = 160;
            if (kind != 0) { gr = 255; gg = 220; gb = 140; }
            CDraw.RoundRectFill(c, x - 6, y - 6, w + 12, h + 12, rad + 6,
                                gr, gg, gb, 46);
            fr = fr + 16; fg = fg + 14; fb = fb + 10;
            f2r = f2r + 14; f2g = f2g + 12; f2b = f2b + 8;
        }
        CFx.ShadowRect(c, x, y + 3, w, h, rad, 10, 0, 0, 0, 120);
        CFx.GradRect(c, x, y, w, h, rad, 0,
                     CDraw.Argb(255, fr, fg, fb), 0,
                     CDraw.Argb(255, f2r, f2g, f2b));
        if (kind == 0) {
            CFx.Ring(c, x, y, w, h, rad, 1, 226, 186, 128, 90);
        } else {
            CFx.Ring(c, x, y, w, h, rad, 1, 96, 58, 20, 200);
        }
        // 顶部一道弧面高光（裁剪在按钮上沿内），给鎏金面一点釉光。
        int gh = h * 2 / 5;
        if (gh > 0) {
            c.PushClip(CDraw.MapX(x + CDraw.originX),
                       CDraw.MapY(y + CDraw.originY), CDraw.MapW(w),
                       CDraw.MapW(gh));
            CFx.GradRect(c, x, y, w, gh, rad, 0,
                         CDraw.Argb(85, 255, 250, 235), 0,
                         CDraw.Argb(0, 255, 250, 235));
            c.PopClip();
        }
        int ty = y + (h - CText.LineHeight(scale)) / 2;
        if (shadowText) {
            CText.DrawCenteredShadow(c, label, x + w / 2, ty, scale,
                                     tcR, tcG, tcB, 255);
        } else {
            CText.DrawCentered(c, label, x + w / 2, ty, scale,
                               tcR, tcG, tcB, 255);
        }
        return hov;
    }

    // 四边暗角：向内渐隐的暗纱（不做模糊，不遮交互），a 是外沿 alpha。
    static void Vignette(Canvas c, int w, int h, int a) {
        if (a <= 0 || w < 16 || h < 16) { return; }
        int e = 72;
        if (e > h / 4) { e = h / 4; }
        if (e > w / 4) { e = w / 4; }
        if (e < 2) { return; }
        int dark = CDraw.Argb(a, 8, 5, 2);
        int clear = CDraw.Argb(0, 8, 5, 2);
        CFx.GradRect(c, 0, 0, w, e, 0, 0, dark, 0, clear);
        CFx.GradRect(c, 0, h - e, w, e, 0, 0, clear, 0, dark);
        CFx.GradRect(c, 0, 0, e, h, 0, 1, dark, 0, clear);
        CFx.GradRect(c, w - e, 0, e, h, 0, 1, clear, 0, dark);
    }

    // 描金分隔线：中央小结 + 两侧向外渐隐的金线与点饰（标题下饰线、
    // 楚河汉界水面线共用）。
    static void Rule(Canvas c, int cx, int cy, int halfW,
                     int cr, int cg, int cb, int ca) {
        if (halfW < 24 || ca <= 0) { return; }
        int lw = halfW - 14;
        CFx.GradRect(c, cx - halfW, cy - 1, lw, 2, 0, 1,
                     CDraw.Argb(0, cr, cg, cb), 0,
                     CDraw.Argb(ca, cr, cg, cb));
        CFx.GradRect(c, cx + 14, cy - 1, lw, 2, 0, 1,
                     CDraw.Argb(ca, cr, cg, cb), 0,
                     CDraw.Argb(0, cr, cg, cb));
        CDraw.FillCircle(c, cx, cy, 3, cr, cg, cb, ca);
        CDraw.FillCircle(c, cx - 9, cy, 2, cr, cg, cb, ca / 2);
        CDraw.FillCircle(c, cx + 9, cy, 2, cr, cg, cb, ca / 2);
    }
}
