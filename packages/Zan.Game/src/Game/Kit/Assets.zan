// Game.Kit 资源定位（原 GameKit.Assets，2026-09 下沉）。
// 以"运行中可执行文件"为锚解析仓库相对资源路径（IDE Run/快捷方式/
// 其他目录启动的 shell 会任意选工作目录——锚错就一张纹理都加载不到，
// 窗口全黑）。exe 目录向上最多走 4 级，兼容 build/game.exe 与打包后的
// dist/game.exe 两种布局；最后回退工作目录及各级父目录（zanc run 的
// exe 在临时目录）。
using System;
using System.Diagnostics;
using System.IO;

namespace Game.Kit;

class Assets {
    static string exeDir;
    static bool exeDirReady;

    public static string ExeDir() {
        if (Assets.exeDirReady) { return Assets.exeDir; }
        Assets.exeDirReady = true;
        Assets.exeDir = Assets.Parent(ProcessHost.SelfExe());
        return Assets.exeDir;
    }

    // Directory part of a path, "" when it has none.
    static string Parent(string path) {
        int cut = -1;
        for (int i = 0; i < path.Length; i = i + 1) {
            string c = path.Substring(i, 1);
            if (c == "/" || c == "\\") { cut = i; }
        }
        if (cut <= 0) { return ""; }
        return path.Substring(0, cut);
    }

    static string Find(string rel) {
        string dir = Assets.ExeDir();
        for (int up = 0; dir != "" && up < 4; up = up + 1) {
            string p = dir + "/" + rel;
            if (File.Exists(p)) { return p; }
            dir = Assets.Parent(dir);
        }
        // Fallback: the working directory and its parents (the IDE starts a
        // program in its project root, a shell run may sit a level or two in).
        string cwdRel = rel;
        for (int outward = 0; outward < 4; outward = outward + 1) {
            if (File.Exists(cwdRel)) { return cwdRel; }
            cwdRel = "../" + cwdRel;
        }
        return rel;
    }

    // 公共字体图集兼容两种布局：exe 同级 assets/common（发布布局）或
    // stdlib/Game/Kit/assets（仓库源码布局）。优先发布布局。
    public static string FindCommon(string name) {
        string p = Assets.Find("assets/common/" + name);
        if (File.Exists(p)) { return p; }
        p = Assets.Find("stdlib/Game/Kit/assets/" + name);
        if (File.Exists(p)) { return p; }
        return "assets/common/" + name;
    }
}

// Embedded 8x8 ASCII glyph atlas (codepoints 32..126), hex-encoded, 8 row-bytes
// per glyph; bit 7 is the leftmost column. Decoded once on first use.
