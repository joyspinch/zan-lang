using System;
using System.IO;
using Gui;

namespace Game.Kit;

// 贴图源内存映射条目实体（消除 blitSrcPaths 与 blitSrcKeys 平行列表反模式）。
public class BlitSourceEntry {
    public string path;
    public string key;

    public BlitSourceEntry(string path, string key) {
        this.path = path;
        this.key = key;
    }
}
