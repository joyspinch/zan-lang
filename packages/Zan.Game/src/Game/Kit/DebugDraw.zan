using System;
using Gui;

namespace Game.Kit;

// 游戏运行时即时调试绘制器（DebugDraw）。
// 解决 2D/2.5D 研发期无法直观观测碰撞盒、射线检测、索敌视野与路径点的最大痛点。
// 全局支持开关；发布版本置 Enabled = false 即可零开销短路，无性能损耗。
public class DebugDraw {
    public static bool Enabled = true;

    // 绘制空心调试矩形（例如 AABB 碰撞盒）。
    public static void Rect(Canvas c, int x, int y, int w, int h, int color) {
        if (!Enabled || c == null || w <= 0 || h <= 0) { return; }
        c.DrawRect(x, y, w, h, color, 1);
    }

    // 绘制调试线段（例如速度向量、连线）。
    public static void Line(Canvas c, int x1, int y1, int x2, int y2, int color) {
        if (!Enabled || c == null) { return; }
        c.DrawLine(x1, y1, x2, y2, color, 1);
    }

    // 绘制空心调试圆（例如索敌范围、圆形碰撞体、爆炸半径）。
    public static void Circle(Canvas c, int cx, int cy, int radius, int color) {
        if (!Enabled || c == null || radius <= 0) { return; }
        c.DrawCircle(cx, cy, radius, color, 1);
    }

    // 绘制射线（例如视线遮挡、枪口弹道前瞻检测）。
    public static void Ray(Canvas c, int startX, int startY, double dirX, double dirY, double length, int color) {
        if (!Enabled || c == null || length <= 0.0) { return; }
        double lenSq = dirX * dirX + dirY * dirY;
        if (lenSq < 0.0001) { return; }
        double invLen = 1.0 / Math.Sqrt(lenSq);
        int endX = startX + (int)(dirX * invLen * length);
        int endY = startY + (int)(dirY * invLen * length);
        Line(c, startX, startY, endX, endY, color);
    }

    // 绘制定位十字准星（例如命中点、锚点、巡逻路标）。
    public static void Cross(Canvas c, int cx, int cy, int size, int color) {
        if (!Enabled || c == null || size <= 0) { return; }
        Line(c, cx - size, cy, cx + size, cy, color);
        Line(c, cx, cy - size, cx, cy + size, color);
    }
}
