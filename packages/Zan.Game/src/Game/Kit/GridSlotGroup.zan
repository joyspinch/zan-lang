using System;
using Gui;

namespace Game.Kit;

// 游戏网格式槽位组布局与交互控制器（GridSlotGroup）。
// 对应设计器中的“格子族/网格组”，将设计器理念沉淀为纯代码层的极简运行时 API。
// 用于极速实现背包栏、装备槽、战术胸挂、技能快捷栏及仓库，
// 内置行列几何解算、鼠标命中检测（HitTest）与自动绘制。
public class GridSlotGroup {
    public int startX;
    public int startY;
    public int cols;
    public int rows;
    public int slotW;
    public int slotH;
    public int gapX;
    public int gapY;

    public GridSlotGroup(int startX, int startY, int cols, int rows, int slotW, int slotH, int gapX, int gapY) {
        this.startX = startX;
        this.startY = startY;
        this.cols = cols > 0 ? cols : 1;
        this.rows = rows > 0 ? rows : 1;
        this.slotW = slotW > 0 ? slotW : 32;
        this.slotH = slotH > 0 ? slotH : 32;
        this.gapX = gapX >= 0 ? gapX : 0;
        this.gapY = gapY >= 0 ? gapY : 0;
    }

    public static GridSlotGroup Create(int startX, int startY, int cols, int rows, int slotW, int slotH, int gapX, int gapY) {
        return new GridSlotGroup(startX, startY, cols, rows, slotW, slotH, gapX, gapY);
    }

    public int Cols { get { return cols; } }
    public int Rows { get { return rows; } }
    public int TotalSlots { get { return cols * rows; } }
    public int TotalWidth { get { return cols * slotW + (cols - 1) * gapX; } }
    public int TotalHeight { get { return rows * slotH + (rows - 1) * gapY; } }

    // 获取指定行列的格子屏幕像素矩形 [x, y, w, h]。
    public bool GetSlotRect(int col, int row, out int x, out int y, out int w, out int h) {
        if (col < 0 || col >= cols || row < 0 || row >= rows) {
            x = 0; y = 0; w = 0; h = 0;
            return false;
        }
        x = startX + col * (slotW + gapX);
        y = startY + row * (slotH + gapY);
        w = slotW;
        h = slotH;
        return true;
    }

    // 根据一维平坦索引获取格子矩形 (index = row * cols + col)。
    public bool GetSlotRectByIndex(int index, out int x, out int y, out int w, out int h) {
        if (index < 0 || index >= TotalSlots) {
            x = 0; y = 0; w = 0; h = 0;
            return false;
        }
        int r = index / cols;
        int c = index % cols;
        return GetSlotRect(c, r, out x, out y, out w, out h);
    }

    // 鼠标点击或指针悬停命中检测（HitTest）。
    // 返回命中是否落在有效格子上；命中时输出对应的 col, row 与平坦 index。
    public bool HitTest(int mouseX, int mouseY, out int outCol, out int outRow, out int outIndex) {
        outCol = -1;
        outRow = -1;
        outIndex = -1;

        if (mouseX < startX || mouseY < startY) { return false; }

        int relX = mouseX - startX;
        int relY = mouseY - startY;

        int stepX = slotW + gapX;
        int stepY = slotH + gapY;

        int c = relX / stepX;
        int r = relY / stepY;

        if (c < 0 || c >= cols || r < 0 || r >= rows) { return false; }

        // 检查是否落入两格之间的 gap 间隙空隙
        int inSlotX = relX - c * stepX;
        int inSlotY = relY - r * stepY;
        if (inSlotX >= slotW || inSlotY >= slotH) {
            return false;
        }

        outCol = c;
        outRow = r;
        outIndex = r * cols + c;
        return true;
    }

    // 在画布上快速绘制网格槽位线框与底色（支持高亮指定选性格子）。
    public void Draw(Canvas c, int borderColor, int fillColor, int highlightIndex, int highlightColor) {
        if (c == null) { return; }

        int total = TotalSlots;
        for (int i = 0; i < total; i = i + 1) {
            int sx, sy, sw, sh;
            GetSlotRectByIndex(i, out sx, out sy, out sw, out sh);

            int curFill = (i == highlightIndex && highlightColor != 0) ? highlightColor : fillColor;
            if (curFill != 0) {
                c.FillRect(sx, sy, sw, sh, curFill);
            }
            if (borderColor != 0) {
                c.DrawRect(sx, sy, sw, sh, borderColor, 1);
            }
        }
    }
}
