using System;

namespace Game.Kit;

class Rng {
    long state;

    static Rng Seed(long s) {
        Rng g = new Rng();
        if (s == 0) { s = 88172645463325252; }
        g.state = s;
        return g;
    }

    long NextLong() {
        long x = this.state;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        this.state = x;
        return x;
    }

    int Next() {
        long v = this.NextLong();
        if (v < 0) { v = -v; }
        return (int)(v & 2147483647);
    }

    int Range(int lo, int hi) {
        if (hi <= lo) { return lo; }
        return lo + this.Next() % (hi - lo);
    }

    double NextDouble01() {
        return (this.Next() & 16777215) / 16777216.0;
    }
}
