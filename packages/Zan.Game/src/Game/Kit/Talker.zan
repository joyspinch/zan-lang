using System;

namespace Game.Kit;

public class Talker {
    public List<string> praise;
    public List<string> taunt;
    public List<string> neutral;
    public List<string> hype;
    public string current;
    public int kind;
    public long until;
    public Rng rng;

    public static Talker Create(Rng rng) {
        Talker t = new Talker();
        t.praise = new List<string>();
        t.taunt = new List<string>();
        t.neutral = new List<string>();
        t.hype = new List<string>();
        t.current = "";
        t.kind = 2;
        t.until = 0;
        t.rng = rng;
        return t;
    }

    public void Add(int bank, string line) {
        if (bank == 0) { this.praise.Add(line); }
        else if (bank == 1) { this.taunt.Add(line); }
        else if (bank == 3) { this.hype.Add(line); }
        else { this.neutral.Add(line); }
    }

    public List<string> Bank(int bank) {
        if (bank == 0) { return this.praise; }
        if (bank == 1) { return this.taunt; }
        if (bank == 3) { return this.hype; }
        return this.neutral;
    }

    public void Say(int bank, int nowMs, int holdMs) {
        List<string> b = this.Bank(bank);
        if (b.Count == 0) { return; }
        this.current = b[this.rng.Range(0, b.Count)];
        this.kind = bank;
        this.until = (long)nowMs + (long)holdMs;
    }

    public void SayExact(int bank, string line, int nowMs, int holdMs) {
        this.current = line;
        this.kind = bank;
        this.until = (long)nowMs + (long)holdMs;
    }

    public string Current(int nowMs) {
        if ((long)nowMs > this.until) { return ""; }
        return this.current;
    }

    public int Kind() { return this.kind; }
}
