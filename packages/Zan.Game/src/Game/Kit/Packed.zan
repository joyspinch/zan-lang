// Game.Kit 加密资源包消费端（原 GameKit.PackedAssets/KeyShares，2026-09 下沉）。
// 游戏资产打成单个 AES-256-GCM 加密、RSA 签名的 .zrp 随 exe 分发，
// 条目按工程相对名（"assets/ui/panel.png"）寻址；打包工具见
// 核心契约与语义定义。
using System;
using System.IO;
using System.Resources;
using System.Security;
using System.Security.Cryptography;

namespace Game.Kit;

// 接口数据协议与执行契约。
// 核心契约与语义定义。
// 接口数据协议与执行契约。
// 核心契约与执行状态转移规范。
// 接口数据协议与执行契约。
class PackedAssets {
    ResourcePack pack;

    PackedAssets() {
        this.pack = null;
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    // 接口数据协议与执行契约。
    public static PackedAssets Open(string packPath, string shareAHex, string shareBHex) {
        byte[] shareA = Hex.Decode(shareAHex);
        byte[] shareB = Hex.Decode(shareBHex);
        byte[] master = ResourcePack.MixKey(shareA, shareB, 32);
        // Open/Write 的 masterKey 形参是 string（字节缓冲）。ToStr 是
        // 内建转换，把 byte[] 内容拷成独立的 string 缓冲（mini2.zan
        // 路径对比：ToStr 与 Hex.Decode(keyHex) 同字节同结果，
        // count=2/err=0 完全一致；Runtime/irgen_expr.c:232）。
        return PackedAssets.OpenKeyed(packPath, master.ToStr(0, 32));
    }

    // 接口数据协议与执行契约。
    public static PackedAssets OpenKeyed(string packPath, string masterKey) {
        PackedAssets pa = new PackedAssets();
        List<int> err = new List<int>();
        err.Add(0);
        ResourcePack p = ResourcePack.Open(packPath, masterKey, null, null, err);
        if (p == null) {
            if (err[0] == 2) { throw new IOException("pack: auth (wrong master key?)"); }
            if (err[0] == 3) { throw new IOException("pack: signature"); }
            throw new IOException("pack: io/magic (" + packPath + ")");
        }
        pa.pack = p;
        return pa;
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    // 接口数据协议与执行契约。
    public static PackedAssets OpenVerified(string packPath, string shareAHex,
        string shareBHex, string nHex, string eHex) {
        byte[] shareA = Hex.Decode(shareAHex);
        byte[] shareB = Hex.Decode(shareBHex);
        byte[] master = ResourcePack.MixKey(shareA, shareB, 32);
        // ToStr 拷出 masterKey（byte[]→string 隐式传参只在调用实参位置安全）。
        return PackedAssets.OpenKeyedVerified(packPath, master.ToStr(0, 32), nHex, eHex);
    }

    // 接口数据协议与执行契约。
    public static PackedAssets OpenKeyedVerified(string packPath, string masterKey,
        string nHex, string eHex) {
        PackedAssets pa = new PackedAssets();
        List<int> err = new List<int>();
        err.Add(0);
        ResourcePack p = ResourcePack.Open(packPath, masterKey, nHex, eHex, err);
        if (p == null) {
            if (err[0] == 2) { throw new IOException("pack: auth (wrong master key?)"); }
            if (err[0] == 3) { throw new IOException("pack: signature"); }
            throw new IOException("pack: io/magic (" + packPath + ")");
        }
        pa.pack = p;
        return pa;
    }

    // 接口数据协议与执行契约。
    public byte[] Read(string name) {
        List<int> len = new List<int>();
        len.Add(0);
        byte[] data = this.pack.Read(name, len);
        if (data == null) { throw new IOException("pack: missing/tampered " + name); }
        return data;
    }

    // 接口数据协议与执行契约。
    public AudioClip LoadWav(string name) {
        byte[] data = this.Read(name);
        // ToStr 拷出为调用实参（PCM 在调用内被拷出，见 Audio.zan 契约）。
        return AudioClip.LoadWavFromMem(data.ToStr(0, data.Length), data.Length);
    }

    // 核心契约与语义定义。
    public bool Contains(string name) { return this.pack.Contains(name); }

    // 核心契约与语义定义。
    public int Count() { return this.pack.Count(); }

    // 接口数据协议与执行契约。
    public int SizeOf(string name) { return this.pack.SizeOf(name); }
}

// 接口数据协议与执行契约。
class KeyShares {
    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    public static string File(string path) {
        byte[] raw = System.IO.File.ReadAllBytes(path);
        string s = raw.ToStr(0, raw.Length);
        // 接口数据协议与执行契约。
        int start = 0;
        int end = s.Length;
        while (start < end && KeyShares.SpaceAt(s, start)) { start = start + 1; }
        while (end > start && KeyShares.SpaceAt(s, end - 1)) { end = end - 1; }
        return s.Substring(start, end - start);
    }

    static bool SpaceAt(string s, int i) {
        int c = s[i] & 255;
        return c == 32 || c == 9 || c == 10 || c == 13;
    }
}
