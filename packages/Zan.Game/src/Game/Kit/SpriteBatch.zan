using System;
using Gui;

namespace Game.Kit;

/// <summary>
/// 2D 游戏批量图元与精灵渲染上下文。
/// 封装批量绘制指令流、全局颜色/Alpha 混合与视口映射，提供绘图统计以指导性能调优。
/// </summary>
class SpriteBatch {
    Canvas canvas;
    bool inBatch;
    int drawCalls;
    int itemCount;
    int globalAlpha; // 0..255

    SpriteBatch() {
        this.globalAlpha = 255;
        this.inBatch = false;
        this.drawCalls = 0;
        this.itemCount = 0;
    }

    /// <summary>当前已提交的批次绘制调用数（DrawCalls）。</summary>
    int DrawCalls() { return this.drawCalls; }

    /// <summary>本帧批量绘制的项目（图元/精灵）总数。</summary>
    int ItemCount() { return this.itemCount; }

    /// <summary>设置全局 Alpha 透明度乘数（0~255）。</summary>
    void SetGlobalAlpha(int alpha) {
        if (alpha < 0) { alpha = 0; }
        if (alpha > 255) { alpha = 255; }
        this.globalAlpha = alpha;
    }

    /// <summary>开始一个精灵批处理阶段。</summary>
    void Begin(Canvas c) {
        this.canvas = c;
        this.inBatch = true;
        this.drawCalls = 0;
        this.itemCount = 0;
    }

    /// <summary>结束批处理阶段。</summary>
    void End() {
        this.inBatch = false;
        this.canvas = null;
    }

    /// <summary>批量绘制实心矩形。</summary>
    void DrawRect(int x, int y, int w, int h, int color) {
        if (!this.inBatch || this.canvas == null) { return; }
        if (this.globalAlpha < 255) {
            int a = ((color >> 24) & 255) * this.globalAlpha / 255;
            color = (a << 24) | (color & 16777215);
        }
        CDraw.FillRect(this.canvas, x, y, w, h, color);
        this.itemCount = this.itemCount + 1;
        this.drawCalls = this.drawCalls + 1;
    }

    /// <summary>批量绘制实心圆盘。</summary>
    void DrawBall(int cx, int cy, int rad, int r, int g, int b, int a) {
        if (!this.inBatch || this.canvas == null) { return; }
        if (this.globalAlpha < 255) {
            a = a * this.globalAlpha / 255;
        }
        CSprite.Ball(this.canvas, cx, cy, rad, r, g, b, a);
        this.itemCount = this.itemCount + 1;
        this.drawCalls = this.drawCalls + 1;
    }

    /// <summary>批量绘制柔和径向光晕。</summary>
    void DrawGlow(int cx, int cy, int rad, int r, int g, int b, int a) {
        if (!this.inBatch || this.canvas == null) { return; }
        if (this.globalAlpha < 255) {
            a = a * this.globalAlpha / 255;
        }
        CSprite.Glow(this.canvas, cx, cy, rad, r, g, b, a);
        this.itemCount = this.itemCount + 1;
        this.drawCalls = this.drawCalls + 1;
    }
}
