using System;
using System.Collections.Generic;

namespace Game.Net;

// 单帧录像数据（帧序号 + 该帧全部玩家指令）。
public class ReplayFrameRecord {
    public int frameIndex;
    public List<PlayerCommand> commands;

    public ReplayFrameRecord(int frameIdx) {
        this.frameIndex = frameIdx;
        this.commands = new List<PlayerCommand>();
    }

    public static ReplayFrameRecord Create(int frameIdx) {
        return new ReplayFrameRecord(frameIdx);
    }

    public int FrameIndex { get { return frameIndex; } }
    public List<PlayerCommand> Commands { get { return commands; } }

    public void AddCommand(PlayerCommand cmd) {
        if (cmd != null) {
            commands.Add(cmd);
        }
    }
}
