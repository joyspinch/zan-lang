using System;

namespace Game.Net;

// 单个逻辑帧命令桶（包含该帧所有玩家的操作指令合集）。
public class FrameBucket {
    public int frameIndex;
    public PlayerCommand[] commands;
    public int commandCount;

    public FrameBucket(int frameIndex, int maxCommands) {
        this.frameIndex = frameIndex;
        int cap = maxCommands > 0 ? maxCommands : 32;
        this.commands = new PlayerCommand[cap];
        this.commandCount = 0;
    }

    public static FrameBucket Create(int frameIndex, int maxCommands) {
        return new FrameBucket(frameIndex, maxCommands);
    }

    public int FrameIndex { get { return frameIndex; } }
    public int CommandCount { get { return commandCount; } }

    public void AddCommand(PlayerCommand cmd) {
        if (cmd == null) { return; }
        if (commandCount < commands.Length) {
            commands[commandCount] = cmd;
            commandCount = commandCount + 1;
        }
    }

    public PlayerCommand GetCommand(int index) {
        if (index >= 0 && index < commandCount) {
            return commands[index];
        }
        return null;
    }
}
