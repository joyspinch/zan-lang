using System;

namespace Game.Net;

// 单个逻辑帧命令桶（包含该帧所有玩家的操作指令合集）。
class FrameBucket {
    int frameIndex;
    PlayerCommand[] commands;
    int commandCount;

    FrameBucket(int frameIndex, int maxCommands) {
        this.frameIndex = frameIndex;
        int cap = maxCommands > 0 ? maxCommands : 32;
        this.commands = new PlayerCommand[cap];
        this.commandCount = 0;
    }

    static FrameBucket Create(int frameIndex, int maxCommands) {
        return new FrameBucket(frameIndex, maxCommands);
    }

    int FrameIndex { get { return frameIndex; } }
    int CommandCount { get { return commandCount; } }

    void AddCommand(PlayerCommand cmd) {
        if (cmd == null) { return; }
        if (commandCount < commands.Length) {
            commands[commandCount] = cmd;
            commandCount = commandCount + 1;
        }
    }

    PlayerCommand GetCommand(int index) {
        if (index >= 0 && index < commandCount) {
            return commands[index];
        }
        return null;
    }
}
