using System;
using System.Collections.Generic;

namespace Game.Net;

// 录像元数据头信息。
public class ReplayHeader {
    public int magic;  // 0x5A524550 ("ZREP")
    public int version;  // 协议版本号
    public long randomSeed;  // 初始随机种子
    public int playerCount;  // 玩家总数
    public string mapName;  // 对战地图
    public int totalFrames;  // 总逻辑帧数

    public ReplayHeader(long seed, int players, string map) {
        this.magic = 0x5A524550;
        this.version = 1;
        this.randomSeed = seed;
        this.playerCount = players > 0 ? players : 1;
        this.mapName = map != null ? map : "default";
        this.totalFrames = 0;
    }

    public static ReplayHeader Create(long seed, int players, string map) {
        return new ReplayHeader(seed, players, map);
    }

    public long RandomSeed { get { return randomSeed; } }
    public int PlayerCount { get { return playerCount; } }
    public string MapName { get { return mapName; } }
    public int TotalFrames { get { return totalFrames; } set { totalFrames = value; } }
}
