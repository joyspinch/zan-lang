using System;

namespace Game.Net;

// 单个玩家在特定逻辑帧输入的指令。
class PlayerCommand {
    int playerId;
    int cmdType;  // 1:移动, 2:攻击, 3:技能, 4:停止
    double targetX;
    double targetY;
    int targetId;
    int extraParam;

    PlayerCommand(int pid, int type, double tx, double ty, int tid, int extra) {
        this.playerId = pid;
        this.cmdType = type;
        this.targetX = tx;
        this.targetY = ty;
        this.targetId = tid;
        this.extraParam = extra;
    }

    static PlayerCommand Create(int pid, int type, double tx, double ty, int tid, int extra) {
        return new PlayerCommand(pid, type, tx, ty, tid, extra);
    }

    int PlayerId { get { return playerId; } }
    int CmdType { get { return cmdType; } }
    double TargetX { get { return targetX; } }
    double TargetY { get { return targetY; } }
    int TargetId { get { return targetId; } }
    int ExtraParam { get { return extraParam; } }
}
