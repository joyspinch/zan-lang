using System;

namespace Game.Net;

// 单个玩家在特定逻辑帧输入的指令。
public class PlayerCommand {
    public int playerId;
    public int cmdType;  // 1:移动, 2:攻击, 3:技能, 4:停止
    public double targetX;
    public double targetY;
    public int targetId;
    public int extraParam;

    public PlayerCommand(int pid, int type, double tx, double ty, int tid, int extra) {
        this.playerId = pid;
        this.cmdType = type;
        this.targetX = tx;
        this.targetY = ty;
        this.targetId = tid;
        this.extraParam = extra;
    }

    public static PlayerCommand Create(int pid, int type, double tx, double ty, int tid, int extra) {
        return new PlayerCommand(pid, type, tx, ty, tid, extra);
    }

    public int PlayerId { get { return playerId; } }
    public int CmdType { get { return cmdType; } }
    public double TargetX { get { return targetX; } }
    public double TargetY { get { return targetY; } }
    public int TargetId { get { return targetId; } }
    public int ExtraParam { get { return extraParam; } }
}
