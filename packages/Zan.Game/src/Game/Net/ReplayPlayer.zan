using System;
using System.Collections.Generic;

namespace Game.Net;

// 录像帧回放执行委托：帧序号与该帧指令集合。
public delegate void ReplayFrameFn(int frameIndex, List<PlayerCommand> commands);

// 录像回放播放器（ReplayPlayer）：
// 支持暂停、恢复、快进倍速播放（1x, 2x, 4x, 8x）与步进帧同步。
public class ReplayPlayer {
    public ReplayHeader header;
    public List<ReplayFrameRecord> frames;
    public int currentPlayIndex;
    public bool isPlaying;
    public bool isPaused;
    public double speedMultiplier;  // 1.0, 2.0, 4.0, 8.0
    public double accumulator;
    public double frameIntervalSec;

    public ReplayPlayer(ReplayHeader header, List<ReplayFrameRecord> frames, double tickRateHz) {
        this.header = header;
        this.frames = frames != null ? frames : new List<ReplayFrameRecord>();
        this.currentPlayIndex = 0;
        this.isPlaying = false;
        this.isPaused = false;
        this.speedMultiplier = 1.0;
        this.accumulator = 0.0;
        double rate = tickRateHz > 1.0 ? tickRateHz : 20.0;
        this.frameIntervalSec = 1.0 / rate;
    }

    public static ReplayPlayer Create(ReplayHeader header, List<ReplayFrameRecord> frames, double tickRateHz) {
        return new ReplayPlayer(header, frames, tickRateHz);
    }

    public bool IsPlaying { get { return isPlaying; } }
    public bool IsPaused { get { return isPaused; } }
    public bool IsFinished { get { return currentPlayIndex >= frames.Count; } }
    public double SpeedMultiplier { get { return speedMultiplier; } set { speedMultiplier = value > 0.1 ? value : 1.0; } }
    public int CurrentFrameIndex {
        get {
            if (currentPlayIndex < frames.Count) {
                return frames[currentPlayIndex].FrameIndex;
            }
            return header != null ? header.TotalFrames : 0;
        }
    }
    public int TotalFrames { get { return header != null ? header.TotalFrames : frames.Count; } }

    public void Play() {
        this.isPlaying = true;
        this.isPaused = false;
    }

    public void Pause() {
        this.isPaused = true;
    }

    public void Resume() {
        this.isPaused = false;
    }

    // 推进回放时间轴，按倍速逐帧触发执行回调。
    public int Update(double dt, ReplayFrameFn onExecuteFrame) {
        if (!isPlaying || isPaused || IsFinished) { return 0; }

        accumulator = accumulator + dt * speedMultiplier;
        int executedFrames = 0;

        while (accumulator >= frameIntervalSec && currentPlayIndex < frames.Count) {
            accumulator = accumulator - frameIntervalSec;
            ReplayFrameRecord rec = frames[currentPlayIndex];
            currentPlayIndex = currentPlayIndex + 1;

            if (onExecuteFrame != null && rec != null) {
                onExecuteFrame(rec.FrameIndex, rec.Commands);
            }
            executedFrames = executedFrames + 1;
        }

        if (currentPlayIndex >= frames.Count) {
            isPlaying = false;
        }
        return executedFrames;
    }
}
