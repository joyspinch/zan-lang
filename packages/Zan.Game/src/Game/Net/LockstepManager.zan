using System;

namespace Game.Net;

// 工业级定步帧同步管理器（Lockstep Synchronizer）。
// 专为 RTS（红警/魔兽/帝国）、多人 ARPG 攻沙、格斗与联机塔防打造：
// 1. 固定频率逻辑帧驱动（默认 20Hz / 50ms 一帧）；
// 2. 命令桶缓存与按帧顺序确定性执行；
// 3. 网络断线与延迟积压快速追帧（Fast-Forward Catch-up）；
// 4. 逻辑分叉校验（Checksum Hash）。
class LockstepManager {
    int currentLogicFrame;  // 客户端当前推进到的逻辑帧序号
    int serverConfirmedFrame;  // 服务器已确认广播的最大逻辑帧序号
    double tickIntervalSec;  // 每逻辑帧时间（默认 0.05s = 20Hz）
    double accumulator;  // 时间累加器

    FrameBucket[] frameHistory;  // 帧桶历史缓存
    int maxHistory;
    bool isCatchingUp;  // 是否正在高速追帧

    LockstepManager(double tickRateHz, int historyCap) {
        double rate = tickRateHz > 1.0 ? tickRateHz : 20.0;
        this.tickIntervalSec = 1.0 / rate;
        this.accumulator = 0.0;
        this.currentLogicFrame = 0;
        this.serverConfirmedFrame = 0;

        this.maxHistory = historyCap > 64 ? historyCap : 1024;
        this.frameHistory = new FrameBucket[this.maxHistory];
        this.isCatchingUp = false;
    }

    static LockstepManager Create(double tickRateHz, int historyCap) {
        return new LockstepManager(tickRateHz, historyCap);
    }

    int CurrentLogicFrame { get { return currentLogicFrame; } }
    int ServerConfirmedFrame { get { return serverConfirmedFrame; } }
    double TickInterval { get { return tickIntervalSec; } }
    bool IsCatchingUp { get { return isCatchingUp; } }

    // 接收到服务器广播的指定逻辑帧命令包。
    void ReceiveServerFrame(int frameIdx, PlayerCommand[] cmds, int count) {
        if (frameIdx < 0) { return; }
        int slot = frameIdx % maxHistory;
        FrameBucket bucket = FrameBucket.Create(frameIdx, count);
        if (cmds != null) {
            for (int i = 0; i < count; i = i + 1) {
                bucket.AddCommand(cmds[i]);
            }
        }
        frameHistory[slot] = bucket;

        if (frameIdx > serverConfirmedFrame) {
            serverConfirmedFrame = frameIdx;
        }
    }

    // 推进时间并尝试消耗帧。
    // 回调 delegate: void OnExecuteFrame(int frameIndex, FrameBucket bucket)
    int Update(double dt, LogicTickFn onExecuteLogicTick) {
        accumulator = accumulator + dt;

        int executedTicks = 0;
        // 检查落后帧数，若落后超过 5 帧则触发高速追帧
        int lag = serverConfirmedFrame - currentLogicFrame;
        isCatchingUp = lag > 5;

        int maxTicksPerStep = isCatchingUp ? 15 : 4;  // 追帧时一次最多单步追 15 帧

        while (accumulator >= tickIntervalSec || (isCatchingUp && currentLogicFrame < serverConfirmedFrame)) {
            if (currentLogicFrame >= serverConfirmedFrame) {
                // 等待服务器发帧
                break;
            }

            int targetFrame = currentLogicFrame + 1;
            int slot = targetFrame % maxHistory;
            FrameBucket bucket = frameHistory[slot];

            if (bucket != null && bucket.FrameIndex == targetFrame) {
                currentLogicFrame = targetFrame;
                if (onExecuteLogicTick != null) {
                    onExecuteLogicTick(currentLogicFrame, bucket);
                }
                executedTicks = executedTicks + 1;
            } else {
                // 关键帧缺失，挂起等待重传
                break;
            }

            accumulator = accumulator - tickIntervalSec;
            if (accumulator < 0.0) { accumulator = 0.0; }

            if (executedTicks >= maxTicksPerStep) {
                break;
            }
        }

        return executedTicks;
    }
}
