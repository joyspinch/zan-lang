using System;
using System.Collections.Generic;

namespace Game.Lighting2D;

// 2D 动态光照与阴影管线系统（Lighting2D）。
// 统筹环境光、多动态点光源与阻光阴影投射器，
// 提供目标实体的最终照度判定、阴影隐蔽判定与地牢迷雾光照查询。
public class Lighting2D {
    public int ambientColor; // 环境光基准底色 (如暗夜为深黑蓝 0xFF050510)
    public List<PointLight2D> lights;
    public List<ShadowCaster2D> casters;

    public Lighting2D() {
        this.ambientColor = unchecked((int)0xFF0A0A14);
        this.lights = new List<PointLight2D>();
        this.casters = new List<ShadowCaster2D>();
    }

    public static Lighting2D Create() {
        return new Lighting2D();
    }

    public void AddLight(PointLight2D light) {
        if (light != null) { lights.Add(light); }
    }

    public void AddCaster(ShadowCaster2D caster) {
        if (caster != null) { casters.Add(caster); }
    }

    // 查询世界坐标 (px, py) 处受所有光源照射的综合光照强度（0.0 表示完全处于黑暗阴影中，>= 1.0 表示处于高亮明亮区域）
    public double SampleIntensity(double px, double py) {
        double total = 0.0;

        for (int i = 0; i < lights.Count; i = i + 1) {
            PointLight2D lt = lights[i];
            double rawIntensity = lt.EvaluateIntensityAt(px, py);
            if (rawIntensity <= 0.001) { continue; }

            // 阴影遮挡检测：如果被任意一个阻光体遮挡，则无该光源的直射贡献
            bool occluded = false;
            for (int j = 0; j < casters.Count; j = j + 1) {
                if (casters[j].IsOccluded(lt.x, lt.y, px, py)) {
                    occluded = true;
                    break;
                }
            }

            if (!occluded) {
                total = total + rawIntensity;
            }
        }

        if (total > 1.0) { total = 1.0; }
        return total;
    }

    // 判断某目标位置是否隐匿在完全阴影中（潜行游戏常用判定，光强 < 阈值即为潜行成功）
    public bool IsInShadow(double px, double py, double shadowThreshold) {
        double intensity = SampleIntensity(px, py);
        return intensity < shadowThreshold;
    }
}
