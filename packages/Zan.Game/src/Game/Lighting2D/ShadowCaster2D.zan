using System;
using System.Collections.Generic;

namespace Game.Lighting2D;

// 2D 阻光边缘线段
public class ShadowSegment2D {
    public double x1;
    public double y1;
    public double x2;
    public double y2;

    public ShadowSegment2D(double x1, double y1, double x2, double y2) {
        this.x1 = x1;
        this.y1 = y1;
        this.x2 = x2;
        this.y2 = y2;
    }
}

// 2D 阴影投射器（ShadowCaster2D）。
// 挂接在墙体、立柱、障碍物等不透光物体上，
// 接受点光源照射时，向光源背面拉伸投射出阴影体积（Shadow Volume），
// 并提供点在阴影盲区内的快速射线交叉遮蔽判定。
public class ShadowCaster2D {
    public List<ShadowSegment2D> segments;

    public ShadowCaster2D() {
        this.segments = new List<ShadowSegment2D>();
    }

    public static ShadowCaster2D Create() {
        return new ShadowCaster2D();
    }

    // 从轴对齐矩形快速添加 4 条阻光边界（如墙体碰撞块）
    public static ShadowCaster2D CreateFromRect(double rx, double ry, double rw, double rh) {
        ShadowCaster2D sc = new ShadowCaster2D();
        sc.AddSegment(rx, ry, rx + rw, ry);              // 上边
        sc.AddSegment(rx + rw, ry, rx + rw, ry + rh);     // 右边
        sc.AddSegment(rx + rw, ry + rh, rx, ry + rh);     // 下边
        sc.AddSegment(rx, ry + rh, rx, ry);              // 左边
        return sc;
    }

    public void AddSegment(double x1, double y1, double x2, double y2) {
        segments.Add(new ShadowSegment2D(x1, y1, x2, y2));
    }

    // 检测点 (px, py) 是否被任意一条阻光线段挡住，无法直接看到光源 (lx, ly)
    public bool IsOccluded(double lx, double ly, double px, double py) {
        for (int i = 0; i < segments.Count; i = i + 1) {
            ShadowSegment2D seg = segments[i];
            if (SegmentsIntersect(lx, ly, px, py, seg.x1, seg.y1, seg.x2, seg.y2)) {
                return true;
            }
        }
        return false;
    }

    // 两线段相交检测算法
    public static bool SegmentsIntersect(double p0x, double p0y, double p1x, double p1y,
                                         double p2x, double p2y, double p3x, double p3y) {
        double s10x = p1x - p0x;
        double s10y = p1y - p0y;
        double s32x = p3x - p2x;
        double s32y = p3y - p2y;

        double denom = s10x * s32y - s32x * s10y;
        if (Math.Abs(denom) < 0.000001) {
            return false; // 共线或平行
        }

        bool denomPositive = denom > 0.0;

        double s02x = p0x - p2x;
        double s02y = p0y - p2y;

        double sNumer = s10x * s02y - s10y * s02x;
        if ((sNumer < 0.0) == denomPositive) { return false; }

        double tNumer = s32x * s02y - s32y * s02x;
        if ((tNumer < 0.0) == denomPositive) { return false; }

        if (((sNumer > denom) == denomPositive) || ((tNumer > denom) == denomPositive)) {
            return false;
        }

        return true;
    }
}
