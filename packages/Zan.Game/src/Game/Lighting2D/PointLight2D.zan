using System;

namespace Game.Lighting2D;

// 2D 动态点光源（PointLight2D）。
// 模拟火把、灯笼、法术发光弹与爆炸火光，支持半径、颜色、强度与平滑距离衰减。
public class PointLight2D {
    public double x;
    public double y;
    public double radius;      // 光照有效辐射半径 (像素)
    public int color;          // 光源颜色 (AARRGGBB)
    public double intensity;   // 光照强度倍率 (0.0 ~ 2.0，默认 1.0)

    public PointLight2D(double x, double y, double radius, int color, double intensity) {
        this.x = x;
        this.y = y;
        this.radius = radius > 1.0 ? radius : 10.0;
        this.color = color;
        this.intensity = intensity >= 0.0 ? intensity : 1.0;
    }

    public static PointLight2D Create(double x, double y, double radius, int color) {
        return new PointLight2D(x, y, radius, color, 1.0);
    }

    // 计算某个世界坐标点受此光源照射的光照强度系数 (0.0 ~ 1.0)
    public double EvaluateIntensityAt(double px, double py) {
        double dx = px - this.x;
        double dy = py - this.y;
        double dist = Math.Sqrt(dx * dx + dy * dy);

        if (dist >= this.radius) {
            return 0.0;
        }

        // 平滑非线性衰减 (1.0 -> 0.0)
        double norm = dist / this.radius;
        double factor = 1.0 - norm * norm;
        return factor * intensity;
    }

    // 判断某个目标圆形或矩形是否落在光源辐射范围内
    public bool IntersectsCircle(double cx, double cy, double cr) {
        double dx = cx - this.x;
        double dy = cy - this.y;
        double maxD = this.radius + cr;
        return (dx * dx + dy * dy) <= (maxD * maxD);
    }
}
