using System;

namespace Game.Extraction;

// 穿甲弹道与防弹护甲解算器（BallisticSolver）。
// 对应搜打撤游戏的核心攻防对抗逻辑：
// 弹药穿透力（Penetration） vs 护甲等级（Armor Class）与耐久度衰减计算，
// 输出击穿判定、实际肉体伤害、钝伤（Blunt Damage）与护甲损耗。
public class BallisticSolver {
    public class BallisticResult {
        public bool isPenetrated;           // 是否击穿护甲
        public double healthDamage;        // 最终穿透或传递到肉体上的伤害
        public double armorDurabilityLoss; // 护甲耐久扣减值
        public double bleedChance;         // 附加的重度流血几率

        public BallisticResult(bool pen, double hpDmg, double armDmg, double bleed) {
            this.isPenetrated = pen;
            this.healthDamage = hpDmg;
            this.armorDurabilityLoss = armDmg;
            this.bleedChance = bleed;
        }
    }

    // 核心物理结算算法
    // penPower: 弹药穿甲值 (如 1 级弹: 15, 3 级弹: 32, 5 级弹: 55)
    // rawDamage: 弹药基础肉体伤害
    // armorClass: 护甲等级 (0 表示无甲, 1~6 级甲)
    // curDurability: 护甲当前耐久
    // maxDurability: 护甲满耐久
    public static BallisticResult Calculate(double penPower, double rawDamage, int armorClass, double curDurability, double maxDurability) {
        if (armorClass <= 0 || curDurability <= 0.0 || maxDurability <= 0.0) {
            // 无甲或护甲已被打烂归零：100% 全额真伤穿透！
            return new BallisticResult(true, rawDamage, 0.0, 0.6);
        }

        // 护甲耐久百分比 [0.0, 1.0]
        double durPercent = curDurability / maxDurability;
        // 等效防弹阈值 = 护甲等级 * 10 * 耐久系数
        double armorThreshold = (double)armorClass * 10.0 * (0.4 + 0.6 * durPercent);

        // 穿透裕度 (Margin)
        double margin = penPower - armorThreshold;

        if (margin >= 0.0) {
            // 穿甲成功击穿！
            // 穿甲裕度越大，阻尼越小，进入身体的伤害比例越高 (85% ~ 100%)
            double passRatio = 0.85 + (margin / 40.0) * 0.15;
            if (passRatio > 1.0) { passRatio = 1.0; }

            double hpDamage = rawDamage * passRatio;
            // 击穿也会消耗护甲耐久
            double armDmg = 5.0 + penPower * 0.2;

            return new BallisticResult(true, hpDamage, armDmg, 0.8);
        } else {
            // 防弹衣成功挡住子弹（未击穿）！
            // 承受防弹衣传导的轻微钝伤（Blunt Damage，基础伤害的 8% ~ 22%）
            double bluntRatio = 0.08 + (durPercent < 0.5 ? 0.14 : 0.04);
            double bluntDamage = rawDamage * bluntRatio;

            // 挡住子弹大幅消耗护甲耐久！
            double armDmg = 12.0 + (armorThreshold - penPower) * 0.5;

            return new BallisticResult(false, bluntDamage, armDmg, 0.05);
        }
    }
}
