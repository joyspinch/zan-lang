using System;

namespace Game.Extraction;

// 搜打撤条件撤离点状态机（ExtractZone）。
// 对应搜打撤游戏的核心博弈环节：
// 撤离区域范围检测、读秒倒计时、受击被打断、需钥匙/丢包条件判定与撤离成功清算。
public class ExtractZone {
    public string name;
    public double centerX;
    public double centerY;
    public double radius;               // 圆形撤离检测半径

    public double requiredCountdown;    // 撤离所需持续停留时间 (秒，通常 6.0 ~ 10.0s)
    public double currentTimer;         // 当前已读秒时间
    public bool isPlayerInside;         // 玩家当前是否在圈内
    public bool isExtracting;           // 正在撤离读秒
    public bool isSuccess;              // 撤离成功完成！

    public bool requiresNoBackpack;     // 特殊条件：无背包撤离（如下水道点）
    public string requiredKeyId;        // 特殊条件：需特定钥匙卡激活
    public bool isZoneActive;           // 撤离点全局开关（例如战局倒计时最后10分钟才开启）

    public ExtractZone(string name, double cx, double cy, double radius, double countdown) {
        this.name = name != null ? name : "ExtractPoint";
        this.centerX = cx;
        this.centerY = cy;
        this.radius = radius > 0.0 ? radius : 80.0;
        this.requiredCountdown = countdown > 0.0 ? countdown : 7.0;
        this.currentTimer = 0.0;
        this.isPlayerInside = false;
        this.isExtracting = false;
        this.isSuccess = false;
        this.requiresNoBackpack = false;
        this.requiredKeyId = "";
        this.isZoneActive = true;
    }

    public static ExtractZone Create(string name, double cx, double cy, double radius, double countdown) {
        return new ExtractZone(name, cx, cy, radius, countdown);
    }

    public bool IsSuccess { get { return isSuccess; } }
    public double Progress { get { return requiredCountdown > 0.0 ? currentTimer / requiredCountdown : 0.0; } }
    public double RemainingTime { get { return requiredCountdown - currentTimer > 0.0 ? requiredCountdown - currentTimer : 0.0; } }

    // 每帧物理与条件轮询
    // playerX, playerY: 玩家坐标
    // hasBackpack: 玩家身上是否背着战术背包
    // hasKey: 玩家背包里是否持有该撤离点的钥匙卡
    // isTakingDamage: 玩家当前帧是否遭到任何形式的伤害
    public void Update(double dt, double playerX, double playerY, bool hasBackpack, bool hasKey, bool isTakingDamage) {
        if (isSuccess || !isZoneActive) { return; }

        // 1. 距离检测
        double dx = playerX - centerX;
        double dy = playerY - centerY;
        bool inRange = (dx * dx + dy * dy) <= (radius * radius);
        isPlayerInside = inRange;

        // 2. 检查硬性条件
        bool conditionMet = true;
        if (requiresNoBackpack && hasBackpack) {
            conditionMet = false;
        }
        if (requiredKeyId.Length > 0 && !hasKey) {
            conditionMet = false;
        }

        // 3. 读秒与打断逻辑
        if (inRange && conditionMet) {
            if (isTakingDamage) {
                // 受击立刻打断倒计时并清零！
                currentTimer = 0.0;
                isExtracting = false;
                return;
            }

            isExtracting = true;
            currentTimer = currentTimer + dt;
            if (currentTimer >= requiredCountdown) {
                currentTimer = requiredCountdown;
                isSuccess = true; // 撤离成功！
                isExtracting = false;
            }
        } else {
            // 走出撤离区：倒计时重置归零
            currentTimer = 0.0;
            isExtracting = false;
        }
    }

    // 重置撤离点状态
    public void Reset() {
        this.currentTimer = 0.0;
        this.isPlayerInside = false;
        this.isExtracting = false;
        this.isSuccess = false;
    }
}
