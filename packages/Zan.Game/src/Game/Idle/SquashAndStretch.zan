using System;

namespace Game.Idle;

// 游戏爽快感打击动效（Juice Effects）：
// 包含点击果冻缩放（Squash & Stretch）弹簧阻尼振荡器。
class SquashAndStretch {
    double scaleX;
    double scaleY;
    double velocityX;
    double velocityY;
    double stiffness;  // 弹性系数 (如 180.0)
    double damping;  // 阻尼系数 (如 14.0)

    SquashAndStretch() {
        this.scaleX = 1.0;
        this.scaleY = 1.0;
        this.velocityX = 0.0;
        this.velocityY = 0.0;
        this.stiffness = 180.0;
        this.damping = 14.0;
    }

    static SquashAndStretch Create() {
        return new SquashAndStretch();
    }

    double ScaleX { get { return scaleX; } }
    double ScaleY { get { return scaleY; } }

    // 触发一次挤压打击或点击（例如 X 变宽 1.25，Y 被压扁 0.75）。
    void Trigger(double amount) {
        double amt = amount > 0.05 ? amount : 0.25;
        this.scaleX = 1.0 + amt;
        this.scaleY = 1.0 - amt;
    }

    // 弹簧阻尼物理步进更新（内部自动子步切分保证数值稳定性）。
    void Update(double dt) {
        if (dt <= 0.0) { return; }
        double remaining = dt > 0.2 ? 0.2 : dt;
        double subStep = 0.016;  // 60Hz 稳定子步

        while (remaining > 0.0) {
            double step = remaining < subStep ? remaining : subStep;
            remaining = remaining - step;

            // 目标基准比例为 1.0
            double forceX = -stiffness * (scaleX - 1.0) - damping * velocityX;
            velocityX = velocityX + forceX * step;
            scaleX = scaleX + velocityX * step;

            double forceY = -stiffness * (scaleY - 1.0) - damping * velocityY;
            velocityY = velocityY + forceY * step;
            scaleY = scaleY + velocityY * step;

            // 静止收敛门限
            if (Math.Abs(scaleX - 1.0) < 0.002 && Math.Abs(velocityX) < 0.002) {
                scaleX = 1.0;
                velocityX = 0.0;
            }
            if (Math.Abs(scaleY - 1.0) < 0.002 && Math.Abs(velocityY) < 0.002) {
                scaleY = 1.0;
                velocityY = 0.0;
            }
        }
    }
}
