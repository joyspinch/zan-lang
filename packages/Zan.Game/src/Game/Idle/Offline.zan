using System;

namespace Game.Idle;

/// <summary>离线收益结算：放置类"回来时有事发生"的标准算法。
/// 输入上次存档时间戳与每秒产出速率，按封顶时长折算收益；同时
/// 给出"应展示"的判定（离线久才弹结算面板，1 分钟内不烦人）。
/// 时间源由调用方注入（客户端用本地时钟，服务端权威用
/// WebApp.NowSeconds），本库不做 IO。legend/wuwei 模板各有一份
/// 手写等价物（24h 封顶、逐秒步进），这里是抽干后的公共形状。</summary>
class Offline {
    /// 缺省封顶：24 小时（秒）。长线放置可放宽到 7 天，但必须有——
    /// 无封顶的离线收益会让"回来"变成"爆炸"。
    static int CapDefault() { return 86400; }

    /// 最短弹窗时长（秒）：低于它静默入账。
    static int ReportThreshold() { return 60; }

    /// 结算结果：实际入账秒数（封顶后）与原始离线秒数。
    /// earnings 由调用方按 RateAt 自乘——本库只管时间账。
    class OfflineResult {
        public int seconds;      // 实际计费秒数（≤cap）
        public int awaySeconds;  // 原始离线秒数
        public bool reportable;  // 是否值得弹结算面板
    }

    /// 折算离线时长。`savedAt`/`nowAt` 同一时区/纪元的秒；时钟被
    /// 拨回（now < savedAt）视为 0 而不是负数——防"倒计时送钱"。
    static OfflineResult Settle(int savedAt, int nowAt, int capSeconds) {
        OfflineResult r = new OfflineResult();
        if (nowAt <= savedAt) { return r; }
        int away = nowAt - savedAt;
        r.awaySeconds = away;
        int cap = capSeconds;
        if (cap <= 0) { cap = CapDefault(); }
        if (away > cap) { away = cap; }
        r.seconds = away;
        r.reportable = away >= ReportThreshold();
        return r;
    }

    /// 便捷重载：用缺省 24h 封顶。
    static OfflineResult Settle(int savedAt, int nowAt) {
        return Settle(savedAt, nowAt, CapDefault());
    }

    /// 逐秒步进还是闭式一次入账：离线 ≤ threshold 秒走逐秒（与
    /// 在线手感一致，冷却/任务计时同步走），更长走闭式（性能）。
    /// 返回 true 时调用方应循环 Step()，false 直接乘。
    static bool PreferStepping(int awaySeconds) {
        return awaySeconds <= ReportThreshold();
    }
}
