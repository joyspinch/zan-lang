using System;

namespace Game.Idle;

// 放置类大数：以 long 原始值（通常"放大 1000 倍"的定点
// 或单纯金币计数）驱动，显示层换算成 1.2K / 3.4M / 5.6B / 7.8T /
// 9.0Qa 的科学后缀——长线放置超过 int 上限是必然事件，legend 模板
// `Rules.Bounded(1e9)` 那种钳制只是权宜。数值本体保持 long（约
// ±9.2e18，够绝大多数单机放置跑到 prestige 之后），格式化在这里
// 集中，模板与 UI 控件统一取文本。
public class BigNum {
    public static string[] s_suffixes = new string[12] {
        "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"
    };

    // 后缀阶梯：千进制，K M B T Qa Qi Sx Sp Oc No Dc。
    public static string Suffix(int tier) {
        if (tier < 1 || tier >= 12) { return ""; }
        return s_suffixes[tier];
    }

    // 值 → 展示文本（千进制后缀，1 位小数，整数段 1..3 位）。
    // 负数带符号；|v| < 1000 原样整数。ex: 999 -> "999"，
    // 1234 -> "1.2K"，5678000000 -> "5.7B"。
    public static string Short(long v) {
        string sign = "";
        if (v < 0) { sign = "-"; v = 0 - v; }
        if (v < 1000) { return sign + Convert.ToString((int)v); }
        int tier = 0;
        long scaled = v;
        /* 分档快速跳跃，避免多重 64 位长除法循环 */
        if (scaled >= 1000000000000000000L) {
            scaled = scaled / 1000000000000000L;
            tier = 5;
        } else if (scaled >= 1000000000000000L) {
            scaled = scaled / 1000000000000L;
            tier = 4;
        } else if (scaled >= 1000000000000L) {
            scaled = scaled / 1000000000L;
            tier = 3;
        } else if (scaled >= 1000000000L) {
            scaled = scaled / 1000000L;
            tier = 2;
        } else if (scaled >= 1000000L) {
            scaled = scaled / 1000L;
            tier = 1;
        }
        /* 兜底边界归约到 [1000, 999999] */
        while (scaled >= 1000000 && tier < 10) {
            scaled = scaled / 1000;
            tier = tier + 1;
        }
        /* scaled ∈ [1000, 999999]：整段 = scaled/1000，
         * 小数一位 = (scaled/100)%10；tier+1 给出实际档位
         * （归约停在下一档边界内）。5678000000 归约 5.678e9 →
         * /1000³=5.678 → tier=3 后再进一档得 B。 */
        long whole = scaled / 1000;
        long frac = (scaled / 100) % 10;
        string body = Convert.ToString((int)whole) + "."
            + Convert.ToString((int)frac);
        return sign + body + Suffix(tier + 1);
    }

    // 值 → 带千分位分组的完整文本（短数值、结算面板/审计日志用）。
    // 1234567 -> "1,234,567"。
    public static string Grouped(long v) {
        string sign = "";
        if (v < 0) { sign = "-"; v = 0 - v; }
        string s = Convert.ToString((int)0);
        if (v > 2147483647) {
            /* int 通道装不下时分两段拼（高位段+低 9 位），ARC 字符串
             * 拼接是拷贝，无别名坑。 */
            long hi = v / 1000000000;
            long lo = v % 1000000000;
            string los = Convert.ToString((int)lo);
            int pad = 9 - los.Length;
            if (pad > 0) {
                byte[] pbuf = new byte[9];
                for (int pi = 0; pi < pad; pi = pi + 1) { pbuf[pi] = (byte)48; }
                for (int pj = 0; pj < los.Length; pj = pj + 1) { pbuf[pad + pj] = (byte)(los[pj] & 255); }
                los = pbuf.ToStr(0, 9);
            }
            s = GroupDigits(Convert.ToString((int)hi) + los);
        } else {
            s = GroupDigits(Convert.ToString((int)v));
        }
        return sign + s;
    }

    // 纯数字串按 3 位分组（无符号，单次字节缓冲区构造消除反复字符串拼接）。
    public static string GroupDigits(string digits) {
        int len = digits.Length;
        if (len <= 3) { return digits; }
        int commas = (len - 1) / 3;
        int newLen = len + commas;
        byte[] buf = new byte[newLen];
        int src = len - 1;
        int dst = newLen - 1;
        int grp = 0;
        while (src >= 0) {
            if (grp == 3) {
                buf[dst] = (byte)44;
                dst = dst - 1;
                grp = 0;
            }
            buf[dst] = (byte)(digits[src] & 255);
            dst = dst - 1;
            src = src - 1;
            grp = grp + 1;
        }
        return buf.ToStr(0, newLen);
    }

    // 当前值换算成 double（用于与公式库互操作；>2^53 精度自然损失，
    // 显示层容忍）。
    public static double ToDouble(long v) { return (double)v; }
}
