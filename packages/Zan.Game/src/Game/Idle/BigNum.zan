using System;

namespace Game.Idle;

/// <summary>放置类大数：以 long 原始值（通常"放大 1000 倍"的定点
/// 或单纯金币计数）驱动，显示层换算成 1.2K / 3.4M / 5.6B / 7.8T /
/// 9.0Qa 的科学后缀——长线放置超过 int 上限是必然事件，legend 模板
/// `Rules.Bounded(1e9)` 那种钳制只是权宜。数值本体保持 long（约
/// ±9.2e18，够绝大多数单机放置跑到 prestige 之后），格式化在这里
/// 集中，模板与 UI 控件统一取文本。</summary>
class BigNum {
    /// 后缀阶梯：千进制，K M B T Qa Qi Sx Sp Oc No Dc。
    static string Suffix(int tier) {
        string names = "|K|M|B|T|Qa|Qi|Sx|Sp|Oc|No|Dc";
        List<string> parts = names.Split("|");
        if (tier < 1 || tier >= parts.Count) { return ""; }
        return parts[tier];
    }

    /// 值 → 展示文本（千进制后缀，1 位小数，整数段 1..3 位）。
    /// 负数带符号；|v| < 1000 原样整数。ex: 999 -> "999"，
    /// 1234 -> "1.2K"，5678000000 -> "5.7B"。
    static string Short(long v) {
        string sign = "";
        if (v < 0) { sign = "-"; v = 0 - v; }
        if (v < 1000) { return sign + Convert.ToString((int)v); }
        int tier = 0;
        long scaled = v;
        /* 归约到 [1000, 999999]：每除一次进一个千进制档。 */
        while (scaled >= 1000000 && tier < 10) {
            scaled = scaled / 1000;
            tier = tier + 1;
        }
        /* scaled ∈ [1000, 999999]：整段 = scaled/1000，
         * 小数一位 = (scaled/100)%10；tier+1 给出实际档位
         * （归约停在下一档边界内）。5678000000 归约 5.678e9 →
         * /1000³=5.678 → tier=3 后再进一档得 B。 */
        long whole = scaled / 1000;
        long frac = (scaled / 100) % 10;
        string body = Convert.ToString((int)whole) + "."
            + Convert.ToString((int)frac);
        return sign + body + Suffix(tier + 1);
    }

    /// 值 → 带千分位分组的完整文本（短数值、结算面板/审计日志用）。
    /// 1234567 -> "1,234,567"。
    static string Grouped(long v) {
        string sign = "";
        if (v < 0) { sign = "-"; v = 0 - v; }
        string s = Convert.ToString((int)0);
        if (v > 2147483647) {
            /* int 通道装不下时分两段拼（高位段+低 9 位），ARC 字符串
             * 拼接是拷贝，无别名坑。 */
            long hi = v / 1000000000;
            long lo = v % 1000000000;
            string los = Convert.ToString((int)lo);
            while (los.Length < 9) { los = "0" + los; }
            s = GroupDigits(Convert.ToString((int)hi) + los);
        } else {
            s = GroupDigits(Convert.ToString((int)v));
        }
        return sign + s;
    }

    /// 纯数字串按 3 位分组（无符号，调用方已保证形状）。
    static string GroupDigits(string digits) {
        if (digits.Length <= 3) { return digits; }
        string head = digits.Substring(0, digits.Length % 3);
        if (head == "") { head = digits.Substring(0, 3); }
        string tail = digits.Substring(head.Length);
        string outp = head;
        int i = 0;
        while (i + 3 <= tail.Length) {
            outp = outp + "," + tail.Substring(i, 3);
            i = i + 3;
        }
        return outp;
    }

    /// 当前值换算成 double（用于与公式库互操作；>2^53 精度自然损失，
    /// 显示层容忍）。
    static double ToDouble(long v) { return (double)v; }
}
