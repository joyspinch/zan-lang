using System;

namespace Game.Idle;

/// <summary>
/// 放置游戏离线挂机收益计算与结算驱动器。
/// </summary>
class OfflineRewardCalculator {
    double maxOfflineHours; // 最大收益累积上限（如 8 小时）
    double goldPerSecond;   // 基础产出速率

    OfflineRewardCalculator(double maxHours, double ratePerSec) {
        this.maxOfflineHours = maxHours > 0.1 ? maxHours : 8.0;
        this.goldPerSecond = ratePerSec >= 0.0 ? ratePerSec : 0.0;
    }

    static OfflineRewardCalculator Create(double maxHours, double ratePerSec) {
        return new OfflineRewardCalculator(maxHours, ratePerSec);
    }

    double MaxOfflineHours { get { return maxOfflineHours; } set { maxOfflineHours = value; } }
    double GoldPerSecond { get { return goldPerSecond; } set { goldPerSecond = value; } }

    /// <summary>
    /// 计算离线时间与金币收益结算结果。
    /// </summary>
    void CalculateReward(long lastLogoutUnixSec, long nowUnixSec, out long outElapsedSec, out long outCappedSec, out double outTotalGold) {
        long elapsed = nowUnixSec - lastLogoutUnixSec;
        if (elapsed < 0) { elapsed = 0; }

        long maxSec = (long)(maxOfflineHours * 3600.0);
        long capped = elapsed > maxSec ? maxSec : elapsed;

        outElapsedSec = elapsed;
        outCappedSec = capped;
        outTotalGold = (double)capped * goldPerSecond;
    }

    /// <summary>
    /// 将秒数格式化为人类可读的挂机时长文本（例如 "05时24分"）。
    /// </summary>
    static string FormatDuration(long totalSeconds) {
        long h = totalSeconds / 3600;
        long m = (totalSeconds % 3600) / 60;
        long s = totalSeconds % 60;

        string sh = h < 10 ? "0" + h.ToString() : h.ToString();
        string sm = m < 10 ? "0" + m.ToString() : m.ToString();
        string ss = s < 10 ? "0" + s.ToString() : s.ToString();

        if (h > 0) {
            return sh + "小时" + sm + "分";
        }
        return sm + "分" + ss + "秒";
    }
}
