using System;
using Gui;
using Game.Core;

namespace Game.Idle;

// 放置游戏/ARPG 高性能飘字管理器（零 GC 对象池）。
// 支持伤害跳字、暴击金黄放大、金币产出喷涌与经验获取飘字。
class FloatingTextManager {
    FloatingTextItem[] pool;
    int maxCount;
    int[] freeStack;
    int freeTop;
    int[] activeList;
    int activeCount;

    FloatingTextManager(int capacity) {
        this.maxCount = capacity > 16 ? capacity : 128;
        this.pool = new FloatingTextItem[this.maxCount];
        this.freeStack = new int[this.maxCount];
        this.activeList = new int[this.maxCount];
        for (int i = 0; i < this.maxCount; i = i + 1) {
            this.pool[i] = FloatingTextItem.Create();
            this.freeStack[i] = this.maxCount - 1 - i;
        }
        this.freeTop = this.maxCount;
        this.activeCount = 0;
    }

    static FloatingTextManager Create(int capacity) {
        return new FloatingTextManager(capacity);
    }

    int ActiveCount {
        get {
            return activeCount;
        }
    }

    static string[] s_intStrs;
    static string GetIntString(long amount) {
        if (amount >= 0 && amount < 1024) {
            int idx = (int)amount;
            if (s_intStrs == null) {
                s_intStrs = new string[1024];
            }
            string cached = s_intStrs[idx];
            if (cached == null) {
                cached = amount.ToString();
                s_intStrs[idx] = cached;
            }
            return cached;
        }
        return amount.ToString();
    }

    // 产生伤害飘字。
    void SpawnDamage(double x, double y, long amount, bool isCrit) {
        string txt = GetIntString(amount);
        int color = isCrit ? 0xFFD700 : 0xFF4444;  // 暴击金黄，普通鲜红
        double scale = isCrit ? 1.5 : 1.0;
        Spawn(x, y, txt, color, scale, isCrit, isCrit ? 1.0 : 0.7);
    }

    // 产生金币产出飘字。
    void SpawnGold(double x, double y, string formattedAmount) {
        string txt = "+" + formattedAmount;
        Spawn(x, y, txt, 0xFFE066, 1.1, false, 0.8);
    }

    // 底层生成跳字（O(1) 槽位分配与活跃表维护）。
    void Spawn(double x, double y, string text, int color, double scale, bool isCrit, double duration) {
        int slot = -1;
        if (freeTop > 0) {
            freeTop = freeTop - 1;
            slot = freeStack[freeTop];
            activeList[activeCount] = slot;
            activeCount = activeCount + 1;
        } else if (activeCount > 0) {
            // 若满，覆盖最旧项 (activeList[0])
            slot = activeList[0];
            for (int i = 0; i < activeCount - 1; i = i + 1) {
                activeList[i] = activeList[i + 1];
            }
            activeList[activeCount - 1] = slot;
        }
        if (slot >= 0 && slot < maxCount && pool[slot] != null) {
            pool[slot].Spawn(x, y, text, color, scale, isCrit, duration);
        }
    }

    // 时钟推进：仅遍历活跃跳字，过期项 O(1) 移出归还空闲栈。
    void Update(double dt) {
        int i = 0;
        while (i < activeCount) {
            int slot = activeList[i];
            FloatingTextItem item = pool[slot];
            if (item != null && item.Active) {
                item.Update(dt);
                if (!item.Active) {
                    freeStack[freeTop] = slot;
                    freeTop = freeTop + 1;
                    activeCount = activeCount - 1;
                    activeList[i] = activeList[activeCount];
                } else {
                    i = i + 1;
                }
            } else {
                freeStack[freeTop] = slot;
                freeTop = freeTop + 1;
                activeCount = activeCount - 1;
                activeList[i] = activeList[activeCount];
            }
        }
    }

    // 极速渲染所有活跃跳字（仅扫描 activeList，无空转开销）。
    void Render(Canvas c, Camera2D cam) {
        if (c == null) { return; }
        for (int i = 0; i < activeCount; i = i + 1) {
            int slot = activeList[i];
            FloatingTextItem item = pool[slot];
            if (item != null && item.Active) {
                int alpha = (int)(item.Alpha * 255.0);
                if (alpha <= 0) { continue; }
                if (alpha > 255) { alpha = 255; }

                double sx = item.X;
                double sy = item.Y;
                if (cam != null) {
                    if (!cam.IsVisible(item.X - 50.0, item.Y - 20.0, 100.0, 40.0)) {
                        continue;
                    }
                    cam.WorldToScreen(item.X, item.Y, out sx, out sy);
                }

                int renderColor = (alpha << 24) | (item.Color & 0xFFFFFF);
                int fontSize = item.Scale > 1.2 ? 18 : 14;

                // 绘制文本（带阴影描边提升视觉质感）
                c.DrawText((int)sx + 1, (int)sy + 1, item.Text, (alpha << 24) | 0x000000, fontSize);
                c.DrawText((int)sx, (int)sy, item.Text, renderColor, fontSize);
            }
        }
    }
}
