using System;
using System.Collections.Generic;

namespace Game.Idle;

// 放置挂机的世界状态：金币、累计收益、点击数与建筑列表。
//
// 与界面无关——界面只读这里的数、调用这里的动作。
// 存档、离线收益结算、成就判定都可以在这一层之上叠。
public class IdleState {
    public double gold;
    public double totalEarned;
    public long clicks;
    public List<IdleBuilding> buildings;

    // catalog 是这座游戏的建筑内容表（名字/价格/产出），机制不关心内容。
    public IdleState(List<IdleBuilding> catalog) {
        this.gold = 0.0;
        this.totalEarned = 0.0;
        this.clicks = 0;
        this.buildings = new List<IdleBuilding>();
        if (catalog != null) {
            for (int i = 0; i < catalog.Count; i = i + 1) {
                this.buildings.Add(catalog[i]);
            }
        }
    }

    public double Gold { get { return this.gold; } }
    public double TotalEarned { get { return this.totalEarned; } }
    public long Clicks { get { return this.clicks; } }
    public List<IdleBuilding> Buildings { get { return this.buildings; } }

    // 单次点击产出：基础 1 + 每级建筑额外加成（每级 +2）。
    public long ClickPower {
        get {
            long p = 1;
            for (int i = 0; i < this.buildings.Count; i = i + 1) {
                p = p + (long)(this.buildings[i].level * 2);
            }
            return p;
        }
    }

    // 每秒产出：各建筑产出之和。
    public double TotalDps {
        get {
            double sum = 0.0;
            for (int i = 0; i < this.buildings.Count; i = i + 1) {
                sum = sum + (double)this.buildings[i].Dps;
            }
            return sum;
        }
    }

    // 手动开采一次，返回本次收益。
    public long Mine() {
        this.clicks = this.clicks + 1;
        long gain = this.ClickPower;
        this.gold = this.gold + (double)gain;
        this.totalEarned = this.totalEarned + (double)gain;
        return gain;
    }

    // 外部收益入账（离线结算、任务奖励等）：只记正数。
    public void AddGold(double amount) {
        if (amount > 0.0) {
            this.gold = this.gold + amount;
            this.totalEarned = this.totalEarned + amount;
        }
    }

    public bool CanAfford(IdleBuilding b) {
        if (b == null) { return false; }
        return this.gold >= (double)b.Cost;
    }

    // 升级第 index 座建筑：钱够才扣钱升级，返回是否成功。
    public bool UpgradeBuilding(int index) {
        if (index < 0 || index >= this.buildings.Count) { return false; }
        IdleBuilding b = this.buildings[index];
        long cost = b.Cost;
        if (this.gold >= (double)cost) {
            this.gold = this.gold - (double)cost;
            b.Upgrade();
            return true;
        }
        return false;
    }

    // 定步推进：按每秒产出结算（dt 单位为秒）。
    public void Tick(double dt) {
        double dps = this.TotalDps;
        if (dps > 0.0 && dt > 0.0) {
            double gain = dps * dt;
            this.gold = this.gold + gain;
            this.totalEarned = this.totalEarned + gain;
        }
    }
}
