using System;
using Gui;

namespace Game.Idle;

/// <summary>多资源容器：放置类"金币/宝石/素材…"的通用账本。
/// 每种资源一个槽（名字→余额+上限），Add/TrySpend 原子增减，
/// 变更走事件（UI 进度条/按钮可用性订阅）。余额 long，钳在
/// [0, cap]——放置数值只涨不缩，溢出停在 cap（与 Curves.ClampLong
/// 同一策略：卡住而不是回绕出负余额）。名字区分大小写，槽序即
/// 插入序（UI 按创建顺序画进度条）。</summary>
class Wallet {
    List<string> keys;
    List<long> amounts;
    List<long> caps;

    /// 变更快照：最近一次变动的键与新余额（UI 每帧轮询对账，
    /// 放置结算一秒可触发几百次，内联事件反而烧帧——宿主自己
    /// 节流）。changedKey 为空串表示本帧无变更。
    string changedKey;
    long changedValue;

    Wallet() {
        keys = new List<string>();
        amounts = new List<long>();
        caps = new List<long>();
        changedKey = "";
        changedValue = 0;
    }

    /// 注册一个资源槽（重复注册返回 false 不覆盖）。
    bool Define(string key, long cap) {
        if (this.IndexOf(key) >= 0) { return false; }
        keys.Add(key);
        amounts.Add(0);
        caps.Add(cap);
        return true;
    }

    /// 槽下标；未注册返回 -1。
    int IndexOf(string key) {
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (keys[i] == key) { return i; }
        }
        return 0 - 1;
    }

    long Amount(string key) {
        int i = this.IndexOf(key);
        if (i < 0) { return 0; }
        return amounts[i];
    }

    long Cap(string key) {
        int i = this.IndexOf(key);
        if (i < 0) { return 0; }
        return caps[i];
    }

    /// 入账 `v`（可为负），返回实际入账量（被 cap 吃掉的部分不计）。
    /// 未注册的键拒收。v<0 时余额不会穿过 0。
    long Add(string key, long v) {
        int i = this.IndexOf(key);
        if (i < 0 || v == 0) { return 0; }
        long now = amounts[i];
        long want = now + v;
        if (want < 0) { want = 0; }
        if (want > caps[i]) { want = caps[i]; }
        long real = want - now;
        if (real == 0) { return 0; }
        amounts[i] = want;
        this.Fire(key, want);
        return real;
    }

    /// 消费：余额足够才扣（放置购买的经典形状——不透支），
    /// 成功返回 true。
    bool TrySpend(string key, long v) {
        if (v <= 0) { return false; }
        int i = this.IndexOf(key);
        if (i < 0) { return false; }
        if (amounts[i] < v) { return false; }
        amounts[i] = amounts[i] - v;
        this.Fire(key, amounts[i]);
        return true;
    }

    /// `costs` 全部可负担时一次扣清（多资源打包购买）；任一不足
    /// 则整体不动。costs 是 key→数量成对的奇偶序列。
    bool TrySpendAll(List<string> keysReq, List<long> costs) {
        if (keysReq == null || costs == null) { return false; }
        if (keysReq.Count != costs.Count) { return false; }
        for (int i = 0; i < keysReq.Count; i = i + 1) {
            if (this.Amount(keysReq[i]) < costs[i]) { return false; }
        }
        for (int i = 0; i < keysReq.Count; i = i + 1) {
            this.TrySpend(keysReq[i], costs[i]);
        }
        return true;
    }

    void Fire(string key, long now) {
        changedKey = key;
        changedValue = now;
    }

    /// 最近一次变更（轮询后用 TakeChange 取走并清零）。
    string ChangeKey() { return changedKey; }
    long ChangeValue() { return changedValue; }
    void ClearChange() { changedKey = ""; }

    /// 序列化：两行 JSON 兼容的 key|amount|cap 文本（存档用，
    /// 与引擎无关——放置存档里只需要余额，cap 由代码重定义）。
    string ToSaveText() {
        string s = "";
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (i > 0) { s = s + ";"; }
            s = s + keys[i] + "|" + Convert.ToString(amounts[i]);
        }
        return s;
    }

    /// 从 ToSaveText 恢复余额；cap 沿用当前 Define 的值（版本迁移
    /// 点：上调 cap 不需要动存档）。未知键忽略（老存档的废弃资源
    /// 自然蒸发），缺失键保持 0。
    void LoadSaveText(string s) {
        if (s == null || s == "") { return; }
        List<string> slots = s.Split(";");
        for (int i = 0; i < slots.Count; i = i + 1) {
            int bar = slots[i].IndexOf("|");
            if (bar <= 0) { continue; }
            string k = slots[i].Substring(0, bar);
            int j = this.IndexOf(k);
            if (j < 0) { continue; }
            long v = 0;
            string numText = slots[i].Substring(bar + 1);
            bool ok = true;
            for (int c = 0; c < numText.Length && ok; c = c + 1) {
                string ch = numText.Substring(c, 1);
                if (ch == "-") { continue; }
                if (ch.Length != 1 || ch.CompareTo("0") < 0 || ch.CompareTo("9") > 0) {
                    ok = false;
                }
            }
            if (ok && numText.Length > 0 && numText.Length <= 18) {
                v = Convert.ToInt64(numText);
            }
            if (v < 0) { v = 0; }
            if (v > caps[j]) { v = caps[j]; }
            amounts[j] = v;
        }
    }
}
