using System;
using Gui;

namespace Game.Idle;

class WalletSlot {
    public string key;
    public long amount;
    public long cap;

    public WalletSlot(string key, long amount, long cap) {
        this.key = key;
        this.amount = amount;
        this.cap = cap;
    }
}

/// <summary>强类型多资源支付项：键与消费数量捆绑，消除平行列表反模式。</summary>
class WalletCostItem {
    public string key;
    public long cost;

    public WalletCostItem(string key, long cost) {
        this.key = key != null ? key : "";
        this.cost = cost;
    }

    public static WalletCostItem Of(string key, long cost) {
        return new WalletCostItem(key, cost);
    }
}

/// <summary>多资源容器：放置类"金币/宝石/素材…"的通用账本。
/// 每种资源一个槽（名字→余额+上限），Add/TrySpend 原子增减，
/// 变更走事件（UI 进度条/按钮可用性订阅）。余额 long，钳在
/// [0, cap]——放置数值只涨不缩，溢出停在 cap（与 Curves.ClampLong
/// 同一策略：卡住而不是回绕出负余额）。名字区分大小写，槽序即
/// 插入序（UI 按创建顺序画进度条）。</summary>
class Wallet {
    List<WalletSlot> slots;

    /// 变更快照：最近一次变动的键与新余额（UI 每帧轮询对账，
    /// 放置结算一秒可触发几百次，内联事件反而烧帧——宿主自己
    /// 节流）。changedKey 为空串表示本帧无变更。
    string changedKey;
    long changedValue;

    Wallet() {
        slots = new List<WalletSlot>();
        changedKey = "";
        changedValue = 0;
    }

    /// 注册一个资源槽（重复注册返回 false 不覆盖）。
    bool Define(string key, long cap) {
        if (this.IndexOf(key) >= 0) { return false; }
        slots.Add(new WalletSlot(key, 0, cap));
        return true;
    }

    /// 槽下标；未注册返回 -1。
    int IndexOf(string key) {
        for (int i = 0; i < slots.Count; i = i + 1) {
            if (slots[i].key == key) { return i; }
        }
        return 0 - 1;
    }

    long Amount(string key) {
        int i = this.IndexOf(key);
        if (i < 0) { return 0; }
        return slots[i].amount;
    }

    long Cap(string key) {
        int i = this.IndexOf(key);
        if (i < 0) { return 0; }
        return slots[i].cap;
    }

    /// 入账 `v`（可为负），返回实际入账量（被 cap 吃掉的部分不计）。
    /// 未注册的键拒收。v<0 时余额不会穿过 0。
    long Add(string key, long v) {
        int i = this.IndexOf(key);
        if (i < 0 || v == 0) { return 0; }
        WalletSlot slot = slots[i];
        long now = slot.amount;
        long want = now + v;
        if (want < 0) { want = 0; }
        if (want > slot.cap) { want = slot.cap; }
        long real = want - now;
        if (real == 0) { return 0; }
        slot.amount = want;
        this.Fire(key, want);
        return real;
    }

    /// 消费：余额足够才扣（放置购买的经典形状——不透支），
    /// 成功返回 true。
    bool TrySpend(string key, long v) {
        if (v <= 0) { return false; }
        int i = this.IndexOf(key);
        if (i < 0) { return false; }
        WalletSlot slot = slots[i];
        if (slot.amount < v) { return false; }
        slot.amount = slot.amount - v;
        this.Fire(key, slot.amount);
        return true;
    }

    /// 强类型实体主方法：全部需求项均可负担时一次扣清，任一不足则整体不动。
    bool TrySpendItems(List<WalletCostItem> items) {
        if (items == null) { return false; }
        for (int i = 0; i < items.Count; i = i + 1) {
            WalletCostItem it = items[i];
            if (it == null || this.Amount(it.key) < it.cost) { return false; }
        }
        for (int i = 0; i < items.Count; i = i + 1) {
            WalletCostItem it = items[i];
            this.TrySpend(it.key, it.cost);
        }
        return true;
    }

    /// 兼容入口：`costs` 与 `keysReq` 组合为强类型实体后扣减。
    bool TrySpendAll(List<string> keysReq, List<long> costs) {
        if (keysReq == null || costs == null) { return false; }
        if (keysReq.Count != costs.Count) { return false; }
        List<WalletCostItem> items = new List<WalletCostItem>();
        for (int i = 0; i < keysReq.Count; i = i + 1) {
            items.Add(new WalletCostItem(keysReq[i], costs[i]));
        }
        return this.TrySpendItems(items);
    }

    void Fire(string key, long now) {
        changedKey = key;
        changedValue = now;
    }

    /// 最近一次变更（轮询后用 TakeChange 取走并清零）。
    string ChangeKey() { return changedKey; }
    long ChangeValue() { return changedValue; }
    void ClearChange() { changedKey = ""; }

    /// 序列化：两行 JSON 兼容的 key|amount|cap 文本（存档用，
    /// 与引擎无关——放置存档里只需要余额，cap 由代码重定义）。
    string ToSaveText() {
        string s = "";
        for (int i = 0; i < slots.Count; i = i + 1) {
            if (i > 0) { s = s + ";"; }
            s = s + slots[i].key + "|" + Convert.ToString(slots[i].amount);
        }
        return s;
    }

    /// 从 ToSaveText 恢复余额；cap 沿用当前 Define 的值（版本迁移
    /// 点：上调 cap 不需要动存档）。未知键忽略（老存档的废弃资源
    /// 自然蒸发），缺失键保持 0。
    void LoadSaveText(string s) {
        if (s == null || s == "") { return; }
        List<string> rawSlots = s.Split(";");
        for (int i = 0; i < rawSlots.Count; i = i + 1) {
            int bar = rawSlots[i].IndexOf("|");
            if (bar <= 0) { continue; }
            string k = rawSlots[i].Substring(0, bar);
            int j = this.IndexOf(k);
            if (j < 0) { continue; }
            long v = 0;
            string numText = rawSlots[i].Substring(bar + 1);
            bool ok = true;
            for (int c = 0; c < numText.Length && ok; c = c + 1) {
                string ch = numText.Substring(c, 1);
                if (ch == "-") { continue; }
                if (ch.Length != 1 || ch.CompareTo("0") < 0 || ch.CompareTo("9") > 0) {
                    ok = false;
                }
            }
            if (ok && numText.Length > 0 && numText.Length <= 18) {
                v = Convert.ToInt64(numText);
            }
            if (v < 0) { v = 0; }
            if (v > slots[j].cap) { v = slots[j].cap; }
            slots[j].amount = v;
        }
    }
}
