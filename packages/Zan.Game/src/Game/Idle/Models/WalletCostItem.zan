using System;
using Gui;

namespace Game.Idle;

// 强类型多资源支付项：键与消费数量捆绑，消除平行列表反模式。
class WalletCostItem {
    public string key;
    public long cost;

    public WalletCostItem(string key, long cost) {
        this.key = key != null ? key : "";
        this.cost = cost;
    }

    public static WalletCostItem Of(string key, long cost) {
        return new WalletCostItem(key, cost);
    }
}
