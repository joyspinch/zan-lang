using System;
using System.IO;
using System.Json;

namespace Game.Core;

// 播放 AnimClip：按流逝毫秒推进，可随时切换
// 朝向（帧位置保持不变，与经典 Mir 渲染器一致），
// 并读回帧表中要绘制的绝对帧。
// 循环模式：once（停在最后一帧，Done() 变为 true）、loop（回到
// 0）、section（先播放 0..loopStart-1 的前奏一次，再循环
// loopStart..末尾——例如施法前摇后接持续施法）。
class AnimPlayer {
    AnimClip clip;
    int dir;  // 当前朝向（0..dirs-1）
    int frame;  // 当前方向内的帧（0..framesPerDir-1）
    int accMs;  // 累计到下一帧步进的时间
    bool done;  // once 片段已到达并停在最后一帧

    AnimPlayer() {
        this.clip = null;
        this.dir = 0;
        this.frame = 0;
        this.accMs = 0;
        this.done = false;
    }

    // 从第 0 帧开始（或重新开始）播放片段，保持当前朝向。
    void Play(AnimClip c) {
        this.clip = c;
        this.frame = 0;
        this.accMs = 0;
        this.done = false;
    }

    // 切换朝向；片段内帧位置保持不变，
    // 转身的角色不会重新开始步伐。
    void SetDir(int d) {
        if (this.clip == null) { this.dir = d; return; }
        int n = this.clip.Dirs();
        int v = d % n;
        if (v < 0) { v = v + n; }
        this.dir = v;
    }

    // 当前朝向（0..dirs-1，SetDir 已归一化）。
    int Dir() { return this.dir; }
    // once 模式片段是否已停在最后一帧；循环片段恒为 false。
    bool Done() { return this.done; }
    // 当前方向内的帧索引（0..framesPerDir-1）。
    int Frame() { return this.frame; }

    // 按流逝毫秒推进。
    void Update(int dtMs) {
        if (this.clip == null || this.done) { return; }
        if (dtMs < 0) { return; }
        this.accMs = this.accMs + dtMs;
        int stepMs = 1000 / this.clip.Fps();
        if (stepMs < 1) { stepMs = 1; }
        while (this.accMs >= stepMs) {
            this.accMs = this.accMs - stepMs;
            this.frame = this.frame + 1;
            if (this.frame >= this.clip.FramesPerDir()) {
                int lm = this.clip.LoopMode();
                if (lm == 0) {
                    this.frame = this.clip.FramesPerDir() - 1;
                    this.done = true;
                    return;
                }
                if (lm == 2) { this.frame = this.clip.LoopStart(); }
                else { this.frame = 0; }
            }
        }
    }

    // 当前朝向与位置在帧表中的绝对帧索引
    int SheetFrame() {
        if (this.clip == null) { return 0; }
        return this.clip.Base() + this.dir * this.clip.FramesPerDir() + this.frame;
    }
}
