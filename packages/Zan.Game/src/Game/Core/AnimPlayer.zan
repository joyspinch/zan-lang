using System;
using System.IO;
using System.Json;

namespace Game.Core;

// 播放 AnimClip：按流逝毫秒推进，可随时切换
// 朝向（帧位置保持不变，与经典 Mir 渲染器一致），
// 并读回帧表中要绘制的绝对帧。
// 循环模式：once（停在最后一帧，Done() 变为 true）、loop（回到
// 0）、section（先播放 0..loopStart-1 的前奏一次，再循环
// loopStart..末尾——例如施法前摇后接持续施法）。
public class AnimPlayer {
    public AnimClip clip;
    public int dir;  // 当前朝向（0..dirs-1）
    public int frame;  // 当前方向内的帧（0..framesPerDir-1）
    public int accMs;  // 累计到下一帧步进的时间
    public bool done;  // once 片段已到达并停在最后一帧

    // 缓存字段（避免在每帧高频 Update / SheetFrame 中重复方法调用与求余除法）
    public int stepMs;
    public int framesPerDir;
    public int loopMode;
    public int loopStart;
    public int dirs;
    public int baseFrame;

    public AnimPlayer() {
        this.clip = null;
        this.dir = 0;
        this.frame = 0;
        this.accMs = 0;
        this.done = false;
        this.stepMs = 100;
        this.framesPerDir = 1;
        this.loopMode = 1;
        this.loopStart = 0;
        this.dirs = 1;
        this.baseFrame = 0;
    }

    // 从第 0 帧开始（或重新开始）播放片段，保持当前朝向。
    public void Play(AnimClip c) {
        this.clip = c;
        this.frame = 0;
        this.accMs = 0;
        this.done = false;
        if (c != null) {
            int fps = c.Fps();
            this.stepMs = fps > 0 ? (1000 / fps) : 100;
            if (this.stepMs < 1) { this.stepMs = 1; }
            this.framesPerDir = c.FramesPerDir();
            this.loopMode = c.LoopMode();
            this.loopStart = c.LoopStart();
            this.dirs = c.Dirs();
            this.baseFrame = c.Base();
        } else {
            this.stepMs = 100;
            this.framesPerDir = 1;
            this.loopMode = 1;
            this.loopStart = 0;
            this.dirs = 1;
            this.baseFrame = 0;
        }
    }

    // 切换朝向；片段内帧位置保持不变，
    // 转身的角色不会重新开始步伐。
    public void SetDir(int d) {
        if (this.clip == null) { this.dir = d; return; }
        int n = this.dirs;
        int v = d % n;
        if (v < 0) { v = v + n; }
        this.dir = v;
    }

    // 当前朝向（0..dirs-1，SetDir 已归一化）。
    public int Dir() { return this.dir; }
    // once 模式片段是否已停在最后一帧；循环片段恒为 false。
    public bool Done() { return this.done; }
    // 当前方向内的帧索引（0..framesPerDir-1）。
    public int Frame() { return this.frame; }

    // 按流逝毫秒推进（O(1) 步进与多步算术跳跃，彻底规避大 dt 时的逐步循环空转）。
    public void Update(int dtMs) {
        if (this.clip == null || this.done || dtMs <= 0) { return; }
        this.accMs = this.accMs + dtMs;
        if (this.accMs < this.stepMs) { return; }

        int steps = this.accMs / this.stepMs;
        this.accMs = this.accMs % this.stepMs;
        if (steps == 1) {
            this.frame = this.frame + 1;
            if (this.frame >= this.framesPerDir) {
                if (this.loopMode == 0) {
                    this.frame = this.framesPerDir - 1;
                    this.done = true;
                    return;
                }
                if (this.loopMode == 2) { this.frame = this.loopStart; }
                else { this.frame = 0; }
            }
        } else {
            if (this.loopMode == 0) {
                int target = this.frame + steps;
                if (target >= this.framesPerDir) {
                    this.frame = this.framesPerDir - 1;
                    this.done = true;
                } else {
                    this.frame = target;
                }
            } else if (this.loopMode == 2) {
                int cycleLen = this.framesPerDir - this.loopStart;
                if (cycleLen > 0) {
                    int cur = this.frame + steps;
                    if (cur >= this.framesPerDir) {
                        int rem = cur - this.framesPerDir;
                        this.frame = this.loopStart + (rem % cycleLen);
                    } else {
                        this.frame = cur;
                    }
                } else {
                    this.frame = this.loopStart;
                }
            } else {
                this.frame = (this.frame + steps) % this.framesPerDir;
            }
        }
    }

    // 当前朝向与位置在帧表中的绝对帧索引
    public int SheetFrame() {
        if (this.clip == null) { return 0; }
        return this.baseFrame + this.dir * this.framesPerDir + this.frame;
    }
}
