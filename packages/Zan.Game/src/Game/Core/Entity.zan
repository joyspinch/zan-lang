using System;
using Gui;

namespace Game.Core;

// 游戏轻量实体基类。
// 内置位置历史（用于亚帧平滑插值渲染）、包围盒及生命周期钩子。
public class Entity {
    public int id;
    public string tag;
    public bool isAlive;
    public bool isActive;

    public double x;
    public double y;
    public double prevX;
    public double prevY;
    public double width;
    public double height;
    public double radius;
    public double footOffsetY;  // 脚底 Y 偏移量（用于 YSort 遮挡排序）
    public int sortLayer;

    public Entity(int id, string tag) {
        this.id = id;
        this.tag = tag != null ? tag : "entity";
        this.isAlive = true;
        this.isActive = true;
        this.x = 0.0;
        this.y = 0.0;
        this.prevX = 0.0;
        this.prevY = 0.0;
        this.width = 32.0;
        this.height = 32.0;
        this.radius = 16.0;
        this.footOffsetY = 16.0;
        this.sortLayer = 0;
    }

    public int Id { get { return id; } }
    public string Tag { get { return tag; } set { tag = value; } }
    public bool IsAlive { get { return isAlive; } }
    public bool IsActive { get { return isActive; } set { isActive = value; } }

    public double X { get { return x; } set { x = value; } }
    public double Y { get { return y; } set { y = value; } }
    public double PrevX { get { return prevX; } }
    public double PrevY { get { return prevY; } }
    public double Width { get { return width; } set { width = value; } }
    public double Height { get { return height; } set { height = value; } }
    public double Radius { get { return radius; } set { radius = value; } }
    public double FootOffsetY { get { return footOffsetY; } set { footOffsetY = value; } }
    public double FootY { get { return y + footOffsetY; } }
    public int SortLayer { get { return sortLayer; } set { sortLayer = value; } }

    // 标记并销毁该实体，下一帧从场景中移除。
    public void Destroy() {
        this.isAlive = false;
    }

    // 记录当前帧历史坐标，准备开始物理步进计算。
    public void SnapshotHistory() {
        this.prevX = this.x;
        this.prevY = this.y;
    }

    // 实体被加入场景时触发。
    public virtual void OnAwake(Scene scene) {}

    // 固定时间步长逻辑更新（碰撞、寻路、AI）。
    public virtual void OnFixedUpdate(Scene scene, double dt) {}

    // 亚帧平滑插值渲染钩子。
    // interpX/interpY 已经过 (prev * (1 - alpha) + cur * alpha) 滤波平滑，完全消除帧率抖动。
    public virtual void OnRender(Scene scene, Canvas c, double interpX, double interpY) {}

    // 实体彻底销毁移除时触发。
    public virtual void OnDestroy(Scene scene) {}
}
