using System;
using Gui;

namespace Game.Core;

/// <summary>
/// 游戏轻量实体基类。
/// 内置位置历史（用于亚帧平滑插值渲染）、包围盒及生命周期钩子。
/// </summary>
class Entity {
    int id;
    string tag;
    bool isAlive;
    bool isActive;

    double x;
    double y;
    double prevX;
    double prevY;
    double width;
    double height;
    double radius;
    double footOffsetY; // 脚底 Y 偏移量（用于 YSort 遮挡排序）
    int sortLayer;

    Entity(int id, string tag) {
        this.id = id;
        this.tag = tag != null ? tag : "entity";
        this.isAlive = true;
        this.isActive = true;
        this.x = 0.0;
        this.y = 0.0;
        this.prevX = 0.0;
        this.prevY = 0.0;
        this.width = 32.0;
        this.height = 32.0;
        this.radius = 16.0;
        this.footOffsetY = 16.0;
        this.sortLayer = 0;
    }

    int Id { get { return id; } }
    string Tag { get { return tag; } set { tag = value; } }
    bool IsAlive { get { return isAlive; } }
    bool IsActive { get { return isActive; } set { isActive = value; } }

    double X { get { return x; } set { x = value; } }
    double Y { get { return y; } set { y = value; } }
    double PrevX { get { return prevX; } }
    double PrevY { get { return prevY; } }
    double Width { get { return width; } set { width = value; } }
    double Height { get { return height; } set { height = value; } }
    double Radius { get { return radius; } set { radius = value; } }
    double FootOffsetY { get { return footOffsetY; } set { footOffsetY = value; } }
    double FootY { get { return y + footOffsetY; } }
    int SortLayer { get { return sortLayer; } set { sortLayer = value; } }

    /// <summary>标记并销毁该实体，下一帧从场景中移除。</summary>
    void Destroy() {
        this.isAlive = false;
    }

    /// <summary>记录当前帧历史坐标，准备开始物理步进计算。</summary>
    void SnapshotHistory() {
        this.prevX = this.x;
        this.prevY = this.y;
    }

    /// <summary>实体被加入场景时触发。</summary>
    virtual void OnAwake(Scene scene) {}

    /// <summary>固定时间步长逻辑更新（碰撞、寻路、AI）。</summary>
    virtual void OnFixedUpdate(Scene scene, double dt) {}

    /// <summary>
    /// 亚帧平滑插值渲染钩子。
    /// interpX/interpY 已经过 (prev * (1 - alpha) + cur * alpha) 滤波平滑，完全消除帧率抖动。
    /// </summary>
    virtual void OnRender(Scene scene, Canvas c, double interpX, double interpY) {}

    /// <summary>实体彻底销毁移除时触发。</summary>
    virtual void OnDestroy(Scene scene) {}
}
