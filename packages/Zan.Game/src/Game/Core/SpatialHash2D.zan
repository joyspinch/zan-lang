using System;

namespace Game.Core;

/// <summary>
/// 高性能二维紧凑空间哈希网格（Spatial Hash Grid）。
/// 专为塔防怪群、ARPG 怪物碰撞、RTS 寻敌等海量实体设计。
/// 内部基于紧凑静态扁平链表实现，查询与插入完全零 GC 分配，O(1) 检索周围邻域。
/// </summary>
class SpatialHash2D {
    int cellSize;
    int tableSize;      // 哈希桶总数（质数或 2 的幂）
    int maxEntities;    // 支持的最大实体容量
    int count;

    // 扁平链表池
    int[] bucketHead;   // [tableSize]
    int[] nextEntry;    // [maxEntities]
    int[] entityIds;    // [maxEntities]
    double[] posX;      // [maxEntities]
    double[] posY;      // [maxEntities]
    double[] radius;    // [maxEntities]

    // 本帧发生过"空→非空"跃迁的桶下标；Clear 只重置这些桶，
    // 稀疏场景（百级实体占几十个桶）省掉绝大部分 tableSize 次写
    int[] usedBuckets;  // [maxEntities]（跃迁数 ≤ 插入数 ≤ maxEntities）
    int usedCount;
    // 本帧插入的最大实体半径。质心只落自己所在格，而距离判定含
    // 实体半径（qRadius + r）：质心格可能落在 qRadius 扫描框外一格，
    // 查询按本值外扩扫描范围后不再漏检
    double maxInsertRadius;

    SpatialHash2D(int cellSize, int maxEntities) {
        if (cellSize <= 8) { cellSize = 64; }
        if (maxEntities < 100) { maxEntities = 2048; }

        this.cellSize = cellSize;
        this.maxEntities = maxEntities;
        this.tableSize = 4099; // 优质哈希素数桶
        this.count = 0;

        this.bucketHead = new int[tableSize];
        this.nextEntry = new int[maxEntities];
        this.entityIds = new int[maxEntities];
        this.posX = new double[maxEntities];
        this.posY = new double[maxEntities];
        this.radius = new double[maxEntities];
        this.usedBuckets = new int[maxEntities];
        this.usedCount = 0;
        this.maxInsertRadius = 0.0;

        // new int[] 全 0 而空桶哨兵是 -1：Clear 只重置 usedBuckets 里
        // 记录过的桶，构造期一条都没记录，必须在此全量初始化一次
        //（稳态下 Clear 的脏桶清扫不受影响）
        for (int i = 0; i < tableSize; i = i + 1) {
            this.bucketHead[i] = -1;
        }
        Clear();
    }

    static SpatialHash2D Create(int cellSize, int maxCapacity) {
        return new SpatialHash2D(cellSize, maxCapacity);
    }

    /// <summary>
    /// 清空整张网格，准备下一帧重新插入。
    /// 只重置本帧实际写过的桶（usedBuckets）；maxInsertRadius 同步
    /// 归零、由本帧 Insert 重新抬高——任意时刻查询的扫描余量都
    /// 覆盖已插入的全部实体。
    /// </summary>
    void Clear() {
        for (int i = 0; i < usedCount; i = i + 1) {
            bucketHead[usedBuckets[i]] = -1;
        }
        usedCount = 0;
        maxInsertRadius = 0.0;
        count = 0;
    }

    int HashCoords(int cellX, int cellY) {
        // 优质大质数混淆哈希，防止聚簇
        long h = ((long)cellX * 73856093L) ^ ((long)cellY * 19349663L);
        int idx = (int)(h % (long)tableSize);
        if (idx < 0) { idx = idx + tableSize; }
        return idx;
    }

    /// <summary>
    /// 插入一个实体到哈希网格中。
    /// </summary>
    bool Insert(int id, double x, double y, double r) {
        if (count >= maxEntities) {
            return false;
        }

        int entryIdx = count;
        count = count + 1;

        entityIds[entryIdx] = id;
        posX[entryIdx] = x;
        posY[entryIdx] = y;
        radius[entryIdx] = r;

        int cx = (int)Math.Floor(x / (double)cellSize);
        int cy = (int)Math.Floor(y / (double)cellSize);
        int bIdx = HashCoords(cx, cy);

        // 桶从空变非空时登记下标，供 Clear 只清扫写过的桶
        if (bucketHead[bIdx] == -1) {
            usedBuckets[usedCount] = bIdx;
            usedCount = usedCount + 1;
        }
        if (r > maxInsertRadius) { maxInsertRadius = r; }

        // 头插法接入链表
        nextEntry[entryIdx] = bucketHead[bIdx];
        bucketHead[bIdx] = entryIdx;
        return true;
    }

    /// <summary>
    /// 查询指定圆心 (cx, cy) 范围内 radius 半径内的所有实体。
    /// 结果输出到传入的 outIds 数组中，返回命中实体数量。零堆分配。
    /// </summary>
    int QueryRange(double qx, double qy, double qRadius, int[] outIds, int maxOut) {
        if (maxOut <= 0 || outIds == null) { return 0; }

        // 扫描范围按本帧最大插入半径外扩（见 maxInsertRadius 注释）
        double effR = qRadius + maxInsertRadius;
        int minCx = (int)Math.Floor((qx - effR) / (double)cellSize);
        int maxCx = (int)Math.Floor((qx + effR) / (double)cellSize);
        int minCy = (int)Math.Floor((qy - effR) / (double)cellSize);
        int maxCy = (int)Math.Floor((qy + effR) / (double)cellSize);

        int hitCount = 0;

        for (int cx = minCx; cx <= maxCx; cx = cx + 1) {
            for (int cy = minCy; cy <= maxCy; cy = cy + 1) {
                int bIdx = HashCoords(cx, cy);
                int curr = bucketHead[bIdx];

                while (curr != -1) {
                    double dx = posX[curr] - qx;
                    double dy = posY[curr] - qy;
                    double totalR = qRadius + radius[curr];

                    if (dx * dx + dy * dy <= totalR * totalR) {
                        outIds[hitCount] = entityIds[curr];
                        hitCount = hitCount + 1;
                        if (hitCount >= maxOut) {
                            return hitCount;
                        }
                    }
                    curr = nextEntry[curr];
                }
            }
        }

        return hitCount;
    }

    /// <summary>
    /// 寻找离指定点 (qx, qy) 在 maxRange 范围内最近的实体 ID，未找到返回 -1。
    /// 塔防防御塔攻击索敌、自动施法的关键核心算子。
    /// </summary>
    int FindNearest(double qx, double qy, double maxRange) {
        // 扫描范围按本帧最大插入半径外扩（见 maxInsertRadius 注释）
        double effR = maxRange + maxInsertRadius;
        int minCx = (int)Math.Floor((qx - effR) / (double)cellSize);
        int maxCx = (int)Math.Floor((qx + effR) / (double)cellSize);
        int minCy = (int)Math.Floor((qy - effR) / (double)cellSize);
        int maxCy = (int)Math.Floor((qy + effR) / (double)cellSize);

        double bestDist2 = maxRange * maxRange;
        int bestId = -1;

        for (int cx = minCx; cx <= maxCx; cx = cx + 1) {
            for (int cy = minCy; cy <= maxCy; cy = cy + 1) {
                int bIdx = HashCoords(cx, cy);
                int curr = bucketHead[bIdx];

                while (curr != -1) {
                    double dx = posX[curr] - qx;
                    double dy = posY[curr] - qy;
                    double d2 = dx * dx + dy * dy;

                    if (d2 <= bestDist2) {
                        bestDist2 = d2;
                        bestId = entityIds[curr];
                    }
                    curr = nextEntry[curr];
                }
            }
        }

        return bestId;
    }
}
