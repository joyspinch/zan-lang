using System;

namespace Game.Core;

// 确定性高频固定步长游戏时钟（Fixed Time-Step Loop）。
// 将不稳定的可变渲染帧间隔转化为恒定物理步长（如 50Hz/60Hz），
// 杜绝物理穿模、积分漂移与逻辑因掉帧而脱节。
public class GameClock {
    public double fixedDeltaTime;  // 固定单步逻辑步长（秒，默认 1/60 = 0.016666s）
    public double accumulator;  // 未消耗时间累加器
    public double maxAccumulator;  // 最大防螺旋死亡保护阈值（默认 0.25s）
    public long lastTickUs;  // 上一次 Tick 的单调微秒
    public double timeScale;  // 时间膨胀因子（1.0 正常，0 暂停，0.5 慢动作）
    public long tickCount;  // 已经执行的固定步总次数

    public GameClock(double fixedDt) {
        if (fixedDt <= 0.001) {
            string envDt = ProcessHost.Env("ZAN_FIXED_DT");
            if (envDt != "") {
                double parsed = Convert.ToDouble(envDt);
                if (parsed > 0.0001 && parsed < 1.0) { fixedDt = parsed; }
            }
            if (fixedDt <= 0.001) {
                string envFps = ProcessHost.Env("ZAN_GAME_FPS");
                if (envFps != "") {
                    double fps = Convert.ToDouble(envFps);
                    if (fps >= 10.0 && fps <= 1000.0) { fixedDt = 1.0 / fps; }
                }
            }
            if (fixedDt <= 0.001) { fixedDt = 0.01666666667; }
        }
        this.fixedDeltaTime = fixedDt;
        this.accumulator = 0.0;
        this.maxAccumulator = 0.25;
        this.lastTickUs = Stopwatch.GetMicroseconds();
        this.timeScale = 1.0;
        this.tickCount = 0;
    }

    public static GameClock Create60Hz() {
        return new GameClock(1.0 / 60.0);
    }

    public static GameClock Create50Hz() {
        return new GameClock(1.0 / 50.0);
    }

    public double FixedDeltaTime { get { return fixedDeltaTime; } }
    public double TimeScale { get { return timeScale; } set { timeScale = value >= 0.0 ? value : 0.0; } }
    public long TickCount { get { return tickCount; } }

    // 重置计时基准（通常在场景加载或窗口从最小化恢复时调用，避免产生巨大 dt）。
    public void Reset() {
        accumulator = 0.0;
        lastTickUs = Stopwatch.GetMicroseconds();
    }

    // 推进时钟，返回本渲染帧需要执行的固定逻辑步长次数（通常为 0, 1 或 2）。
    // 宿主只需按照该步数循环调用 FixedUpdate(fixedDeltaTime) 即可。
    public int Advance() {
        long now = Stopwatch.GetMicroseconds();
        double dt = (double)(now - lastTickUs) / 1000000.0;
        lastTickUs = now;

        if (dt < 0.0) { dt = 0.0; }
        if (dt > maxAccumulator) { dt = maxAccumulator; }  // 螺旋死亡保护

        accumulator = accumulator + dt * timeScale;
        int steps = 0;
        while (accumulator >= fixedDeltaTime) {
            accumulator = accumulator - fixedDeltaTime;
            steps = steps + 1;
            tickCount = tickCount + 1;
            if (steps >= 10) {
                // 单帧硬上限，防止低配机器死循环
                accumulator = 0.0;
                break;
            }
        }
        return steps;
    }

    // 获取当前剩余时间在固定步长内的插值比例（0.0 ~ 1.0）。
    // 用于渲染层在两帧固定物理状态之间做平滑位置插值（Pos = PrevPos * (1-alpha) + CurrPos * alpha）。
    public double InterpolationAlpha() {
        if (fixedDeltaTime <= 0.0) { return 1.0; }
        double a = accumulator / fixedDeltaTime;
        if (a < 0.0) { return 0.0; }
        if (a > 1.0) { return 1.0; }
        return a;
    }
}
