using System;

namespace Game.Core;

/// <summary>
/// 确定性高频固定步长游戏时钟（Fixed Time-Step Loop）。
/// 将不稳定的可变渲染帧间隔转化为恒定物理步长（如 50Hz/60Hz），
/// 杜绝物理穿模、积分漂移与逻辑因掉帧而脱节。
/// </summary>
class GameClock {
    double fixedDeltaTime;   // 固定单步逻辑步长（秒，默认 1/60 = 0.016666s）
    double accumulator;      // 未消耗时间累加器
    double maxAccumulator;   // 最大防螺旋死亡保护阈值（默认 0.25s）
    long lastTickMs;         // 上一次 Tick 的单调毫秒
    double timeScale;        // 时间膨胀因子（1.0 正常，0 暂停，0.5 慢动作）
    long tickCount;          // 已经执行的固定步总次数

    GameClock(double fixedDt) {
        if (fixedDt <= 0.001) { fixedDt = 0.01666666667; }
        this.fixedDeltaTime = fixedDt;
        this.accumulator = 0.0;
        this.maxAccumulator = 0.25;
        this.lastTickMs = Stopwatch.GetMilliseconds();
        this.timeScale = 1.0;
        this.tickCount = 0;
    }

    static GameClock Create60Hz() {
        return new GameClock(1.0 / 60.0);
    }

    static GameClock Create50Hz() {
        return new GameClock(1.0 / 50.0);
    }

    double FixedDeltaTime { get { return fixedDeltaTime; } }
    double TimeScale { get { return timeScale; } set { timeScale = value >= 0.0 ? value : 0.0; } }
    long TickCount { get { return tickCount; } }

    /// <summary>
    /// 重置计时基准（通常在场景加载或窗口从最小化恢复时调用，避免产生巨大 dt）。
    /// </summary>
    void Reset() {
        accumulator = 0.0;
        lastTickMs = Stopwatch.GetMilliseconds();
    }

    /// <summary>
    /// 推进时钟，返回本渲染帧需要执行的固定逻辑步长次数（通常为 0, 1 或 2）。
    /// 宿主只需按照该步数循环调用 FixedUpdate(fixedDeltaTime) 即可。
    /// </summary>
    int Advance() {
        long now = Stopwatch.GetMilliseconds();
        double dt = (double)(now - lastTickMs) / 1000.0;
        lastTickMs = now;

        if (dt < 0.0) { dt = 0.0; }
        if (dt > maxAccumulator) { dt = maxAccumulator; } // 螺旋死亡保护

        accumulator = accumulator + dt * timeScale;
        int steps = 0;
        while (accumulator >= fixedDeltaTime) {
            accumulator = accumulator - fixedDeltaTime;
            steps = steps + 1;
            tickCount = tickCount + 1;
            if (steps >= 10) {
                // 单帧硬上限，防止低配机器死循环
                accumulator = 0.0;
                break;
            }
        }
        return steps;
    }

    /// <summary>
    /// 获取当前剩余时间在固定步长内的插值比例（0.0 ~ 1.0）。
    /// 用于渲染层在两帧固定物理状态之间做平滑位置插值（Pos = PrevPos * (1-alpha) + CurrPos * alpha）。
    /// </summary>
    double InterpolationAlpha() {
        if (fixedDeltaTime <= 0.0) { return 1.0; }
        double a = accumulator / fixedDeltaTime;
        if (a < 0.0) { return 0.0; }
        if (a > 1.0) { return 1.0; }
        return a;
    }
}
