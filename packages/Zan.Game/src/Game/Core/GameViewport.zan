using System;
using Gui;
using Game.Input;

namespace Game.Core;

/// HUD 叠层渲染回调：画布、视口宽、视口高（设备像素）。
/// 仓里没有多元 Action 泛型（System.Linq 只有 Action<T> 一元，
/// Gui.Action 是零元），多参回调一律声明具名委托。
delegate void HudRenderFn(Canvas canvas, int width, int height);

/// <summary>
/// 官方游戏世界视口集成控件（GameViewport）。
/// 继承自 Gui.Control，无缝缝合底层 GPU Canvas 渲染与上层高频游戏世界逻辑。
/// 自动同步视口边界、推进固定时钟步进并映射鼠标世界空间拾取。
/// </summary>
class GameViewport : Control {
    Scene activeScene;
    InputMapper input;
    HudRenderFn onRenderHudCallback;
    bool autoDriveClock;
    // 经 GuiHost.AttachViewport 挂载后为 true：逻辑由宿主帧循环的
    // 固定步长阶段统一推进，OnPaint 不再 Tick/FlushFrameEvents——
    // 部分重绘导致一帧多次 OnPaint 时，逻辑与输入边沿不会被重复推进/
    // 提前清掉，逻辑帧率也不被渲染帧率门死
    bool hostDriven;
    // 离屏位图：世界渲染进这块持久表面，OnPaint 只做贴图
    // 合成（BlitSurface 遵守宿主当前裁剪条带，局部帧下贴图被裁成
    // 条带）。世界代数没变且尺寸没变时整块复用上帧离屏像素——静态
    // 场景（菜单/暂停）的 GUI 帧零世界渲染开销；动态世界每个逻辑
    // 帧照常重渲染，插值平滑不受影响。表面与宿主画布同为 32bpp。
    Canvas off;
    int offWorldGen;
    bool offValid;

    GameViewport(Scene scene, int dockMode) {
        this.InitControl("game_viewport", dockMode > 0 ? dockMode : 5);  // 默认 dock=5 铺满剩余空间
        this.activeScene = scene;
        this.input = InputMapper.Create();
        this.onRenderHudCallback = null;
        // 渲染与逻辑严格解耦架构：
        // 默认 autoDriveClock 为 false，渲染帧仅负责提交世界与 HUD 画面；
        // 物理逻辑、网络与异步任务由独立的固定步长时钟 (StepLogic / FixedStepClock) 或后台调度器驱动。
        this.autoDriveClock = false;
        this.hostDriven = false;
        this.off = null;
        this.offWorldGen = 0;
        this.offValid = false;
    }

    static GameViewport Create(Scene scene) {
        return new GameViewport(scene, 5);
    }

    Scene CurrentScene { get { return activeScene; } set { activeScene = value; } }
    InputMapper Input { get { return input; } }
    bool AutoDriveClock { get { return autoDriveClock; } set { autoDriveClock = value; } }

    /// <summary>由 GuiHost.AttachViewport 调用：声明逻辑由宿主帧循环驱动。</summary>
    void MarkHostDriven() {
        this.hostDriven = true;
    }

    /// <summary>注册顶层 HUD / UI 绘制回调（在场景世界渲染完成后叠加）。</summary>
    void SetHudRenderer(HudRenderFn hudCallback) {
        this.onRenderHudCallback = hudCallback;
    }

    /// <summary>
    /// 推进一次游戏世界物理与逻辑步进（由宿主帧循环的固定步长阶段、
    /// 后台定时器或独立循环驱动，确保物理与异步逻辑完全不依赖界面
    /// 渲染帧率）。经 GuiHost.AttachViewport 挂载的视口由宿主自动调用。
    /// </summary>
    void StepLogic() {
        if (activeScene != null) {
            activeScene.Tick();
        }
        if (input != null) {
            input.FlushFrameEvents();
        }
    }

    override void OnMeasure(App app) {
        base.OnMeasure(app);
        // 允许自由拉伸自适应容器大小
        this.grow = true;
    }

    override void OnPaint(App app) {
        base.OnPaint(app);
        if (activeScene == null) { return; }

        Canvas c = app.canvas;
        if (c == null) { return; }

        // 1. 同步视口物理像素尺寸至摄像机
        if (this.bw > 0 && this.bh > 0) {
            activeScene.Camera.Resize(this.bw, this.bh);
        }

        // 2. 推进游戏时钟步进与实体物理（兼容单管线简易模式；
        // 挂宿主或外部定时驱动则走 StepLogic，渲染帧不推进逻辑）
        if (autoDriveClock && !hostDriven) {
            activeScene.Tick();
        }

        // 3. 世界渲染进持久离屏表面，再整块贴到宿主画布。
        // 世界代数变了（或表面刚重建）才重渲染：先清成不透明黑
        // （场景背景契约——想要背景色的场景画一块满屏背景实体），
        // 再走正常的视锥剔除 + 插值 + YSort 渲染。
        if (this.bw > 0 && this.bh > 0) {
            if (this.off == null || this.off.Width() != this.bw
                || this.off.Height() != this.bh) {
                this.RecreateOff(this.bw, this.bh);
            }
            if (!this.offValid || activeScene.WorldGen() != this.offWorldGen) {
                this.off.Clear(-16777216);
                activeScene.Render(this.off);
                this.offWorldGen = activeScene.WorldGen();
                this.offValid = true;
            }
            c.BlitSurface(this.off, this.bx, this.by, 0, 0, this.bw, this.bh);
        }

        // 4. 顶层游戏 HUD 叠加绘制（小地图、状态槽、技能快捷栏）——
        // HUD 直接画宿主画布：它跟 GUI 状态走，不进离屏。
        if (onRenderHudCallback != null) {
            onRenderHudCallback(c, this.bw, this.bh);
        }

        // 5. 刷新单帧输入击发事件（单管线简易模式；挂宿主后由 StepLogic 刷新，
        // 避免一帧多次 OnPaint 把还没读到的输入边沿提前清掉）
        if (autoDriveClock && !hostDriven) {
            input.FlushFrameEvents();
        }
    }

    /// 重建离屏表面（首帧或视口尺寸变化）。先建新再销旧，
    /// 防表面 id 被立刻复用读到旧内容；重建后强制重渲染。
    void RecreateOff(int w, int h) {
        Canvas old = this.off;
        this.off = new Canvas(w, h);
        if (old != null) { old.Destroy(); }
        this.offValid = false;
    }
}
