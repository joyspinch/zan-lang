using System;

namespace Game.Core;

// 2D 游戏正交相机与视口管理。
// 支持平滑插值跟随、视口内外剔除判定、地图边界钳制与阻尼屏幕震动。
public class Camera2D {
    public double x;  // 相机中心的世界坐标 X
    public double y;  // 相机中心的世界坐标 Y
    public int viewWidth;  // 视口屏幕宽度（像素）
    public int viewHeight;  // 视口屏幕高度（像素）
    public double zoom;  // 缩放系数（默认 1.0）
    public double invZoom;
    public double halfViewW;
    public double halfViewH;
    public double halfW;
    public double halfH;

    // 边界限制
    public bool hasBounds;
    public double minX;
    public double minY;
    public double maxX;
    public double maxY;

    // 震屏效果
    public double shakeIntensity;
    public double shakeTimer;
    public double shakeOffsetX;
    public double shakeOffsetY;
    public Random rnd;

    // 缓存可视视锥世界包围盒（避免每帧对海量图元重复计算除法与偏移）
    public double curCamX;
    public double curCamY;
    public double visLeft;
    public double visRight;
    public double visTop;
    public double visBottom;

    public Camera2D(int viewW, int viewH) {
        this.x = 0.0;
        this.y = 0.0;
        this.curCamX = 0.0;
        this.curCamY = 0.0;
        this.viewWidth = viewW > 0 ? viewW : 1280;
        this.viewHeight = viewH > 0 ? viewH : 720;
        this.halfViewW = (double)this.viewWidth * 0.5;
        this.halfViewH = (double)this.viewHeight * 0.5;
        this.zoom = 1.0;
        this.invZoom = 1.0;
        this.hasBounds = false;
        this.shakeIntensity = 0.0;
        this.shakeTimer = 0.0;
        this.shakeOffsetX = 0.0;
        this.shakeOffsetY = 0.0;
        this.rnd = new Random();
        UpdateVisibleBounds();
    }

    public static Camera2D Create(int viewW, int viewH) {
        return new Camera2D(viewW, viewH);
    }

    public double X { get { return curCamX; } set { x = value; ClampToBounds(); } }
    public double Y { get { return curCamY; } set { y = value; ClampToBounds(); } }
    public double Zoom { get { return zoom; } set { zoom = value > 0.1 ? value : 0.1; invZoom = 1.0 / zoom; UpdateVisibleBounds(); } }
    public int ViewWidth { get { return viewWidth; } }
    public int ViewHeight { get { return viewHeight; } }

    public double VisibleLeft { get { return visLeft; } }
    public double VisibleRight { get { return visRight; } }
    public double VisibleTop { get { return visTop; } }
    public double VisibleBottom { get { return visBottom; } }

    public void GetVisibleBounds(out double left, out double top, out double right, out double bottom) {
        left = visLeft;
        top = visTop;
        right = visRight;
        bottom = visBottom;
    }

    public void UpdateVisibleBounds() {
        curCamX = x + shakeOffsetX;
        curCamY = y + shakeOffsetY;
        halfW = halfViewW * invZoom;
        halfH = halfViewH * invZoom;
        visLeft = curCamX - halfW;
        visRight = curCamX + halfW;
        visTop = curCamY - halfH;
        visBottom = curCamY + halfH;
    }

    public void Resize(int w, int h) {
        if (w > 0) {
            viewWidth = w;
            halfViewW = (double)viewWidth * 0.5;
        }
        if (h > 0) {
            viewHeight = h;
            halfViewH = (double)viewHeight * 0.5;
        }
        ClampToBounds();
    }

    public void SetBounds(double minX, double minY, double maxX, double maxY) {
        this.hasBounds = true;
        this.minX = minX;
        this.minY = minY;
        this.maxX = maxX;
        this.maxY = maxY;
        ClampToBounds();
    }

    public void ClearBounds() {
        this.hasBounds = false;
        UpdateVisibleBounds();
    }

    // 触发屏幕震动（例如暴击、爆炸、地震）。
    public void Shake(double intensity, double durationSec) {
        this.shakeIntensity = intensity;
        this.shakeTimer = durationSec;
    }

    // 逐帧更新相机插值运动与震屏衰减。
    public void Update(double dt) {
        if (shakeTimer > 0.0) {
            shakeTimer = shakeTimer - dt;
            if (shakeTimer <= 0.0) {
                shakeTimer = 0.0;
                shakeOffsetX = 0.0;
                shakeOffsetY = 0.0;
            } else {
                double rad = (double)rnd.NextBelow(360) * 0.017453292519943295;
                shakeOffsetX = Math.Cos(rad) * shakeIntensity;
                shakeOffsetY = Math.Sin(rad) * shakeIntensity;
                shakeIntensity = shakeIntensity * Math.Max(0.0, 1.0 - dt * 5.0);  // 指数衰减
            }
            UpdateVisibleBounds();
        }
    }

    // 平滑跟随目标世界坐标（Lerp 缓动）。
    public void Follow(double targetX, double targetY, double smoothSpeed, double dt) {
        if (smoothSpeed <= 0.0 || dt <= 0.0) {
            x = targetX;
            y = targetY;
            ClampToBounds();
            return;
        }
        double dx = targetX - x;
        double dy = targetY - y;
        double absDx = dx < 0.0 ? -dx : dx;
        double absDy = dy < 0.0 ? -dy : dy;
        if (absDx < 0.001 && absDy < 0.001) {
            if (x != targetX || y != targetY) {
                x = targetX;
                y = targetY;
                ClampToBounds();
            }
            return;
        }
        double factor = 1.0 - Math.Exp(-smoothSpeed * dt);
        x = x + dx * factor;
        y = y + dy * factor;
        ClampToBounds();
    }

    public void ClampToBounds() {
        if (hasBounds) {
            if (maxX - minX <= halfW * 2.0) {
                x = (minX + maxX) * 0.5;
            } else {
                if (x - halfW < minX) { x = minX + halfW; }
                if (x + halfW > maxX) { x = maxX - halfW; }
            }

            if (maxY - minY <= halfH * 2.0) {
                y = (minY + maxY) * 0.5;
            } else {
                if (y - halfH < minY) { y = minY + halfH; }
                if (y + halfH > maxY) { y = maxY - halfH; }
            }
        }
        UpdateVisibleBounds();
    }

    // 世界坐标转换为屏幕像素坐标。
    public void WorldToScreen(double wx, double wy, out double sx, out double sy) {
        sx = (wx - curCamX) * zoom + halfViewW;
        sy = (wy - curCamY) * zoom + halfViewH;
    }

    // 屏幕像素坐标转换为世界坐标（例如鼠标点击位置拾取）。
    public void ScreenToWorld(double sx, double sy, out double wx, out double wy) {
        wx = (sx - halfViewW) * invZoom + curCamX;
        wy = (sy - halfViewH) * invZoom + curCamY;
    }

    // 视锥范围裁剪判定：判断一个世界矩形是否在屏幕可见范围内。
    public bool IsVisible(double wx, double wy, double w, double h) {
        return (wx + w >= visLeft && wx <= visRight && wy + h >= visTop && wy <= visBottom);
    }
}
