using System;
using System.IO;
using System.Json;

namespace Game.Core;

// 基于方向优先帧表的单个动画片段（
// Mir 式布局：先是方向 0 的全部帧，再是方向 1，……）。
// 由 IDE 资源管理器写入的 `.anim` 旁置 JSON 加载。
public class AnimClip {
    public string image;  // 帧表图片条目/路径
    public int frameW;  // 帧单元尺寸（0 = 未知，从帧表推导）
    public int frameH;
    public int baseFrame;  // 多动作帧表中该动作的首帧
    public int dirs;  // 方向数量（经典 Mir 移动为 8）
    public int framesPerDir;  // 每个方向所属的帧数
    public int fps;
    public int loopMode;  // 0 播放一次，1 循环，2 循环片段
    public int loopStart;  // 循环片段（模式 2）的首帧

    public AnimClip(int dirs, int framesPerDir, int fps, int loopMode, int loopStart) {
        this.image = "";
        this.frameW = 0;
        this.frameH = 0;
        this.baseFrame = 0;
        this.dirs = dirs;
        this.framesPerDir = framesPerDir;
        this.fps = fps;
        this.loopMode = loopMode;
        this.loopStart = loopStart;
        if (this.dirs < 1) { this.dirs = 1; }
        if (this.framesPerDir < 1) { this.framesPerDir = 1; }
        if (this.fps < 1) { this.fps = 1; }
        if (this.loopStart < 0) { this.loopStart = 0; }
        if (this.loopStart >= this.framesPerDir) { this.loopStart = this.framesPerDir - 1; }
    }

    // 解析 `.anim` JSON 文档；不是该格式则返回 null。
    public static AnimClip ParseJson(string json) {
        JsonValue v = JsonValue.ParseLenient(json);
        if (v == null || !v.IsObject()) { return null; }
        int lm = 1;
        string loop = v.Str("loop", "loop");
        if (loop == "once") { lm = 0; }
        if (loop == "section") { lm = 2; }
        AnimClip c = new AnimClip(
            v.Int("dirs", 8), v.Int("framesPerDir", 1),
            v.Int("fps", 12), lm, v.Int("loopStart", 0));
        c.image = v.Str("image", "");
        c.frameW = v.Int("frameW", 0);
        c.frameH = v.Int("frameH", 0);
        c.baseFrame = v.Int("base", 0);
        return c;
    }

    // 从磁盘上的 `.anim` 文件加载片段（失败返回 null）。
    public static AnimClip Load(string path) {
        if (!File.Exists(path)) { return null; }
        return AnimClip.ParseJson(File.ReadAllText(path));
    }

    // 帧表图片条目/路径（`.anim` 的 image 字段，默认空串）。
    public string Image() { return this.image; }
    // 多动作帧表中该动作的首帧（`.anim` 的 base 字段）。
    public int Base() { return this.baseFrame; }
    // 帧单元宽（0 = 未知，从帧表推导）。
    public int FrameW() { return this.frameW; }
    // 帧单元高（0 = 未知，从帧表推导）。
    public int FrameH() { return this.frameH; }
    // 方向数量（构造时小于 1 钳制为 1；经典 Mir 移动为 8）。
    public int Dirs() { return this.dirs; }
    // 每个方向的帧数（构造时小于 1 钳制为 1）。
    public int FramesPerDir() { return this.framesPerDir; }
    // 播放帧率（FPS，构造时小于 1 钳制为 1）。
    public int Fps() { return this.fps; }
    // 循环模式：0 播放一次，1 循环，2 循环片段。
    public int LoopMode() { return this.loopMode; }
    // 循环片段（模式 2）的首帧（钳制在 [0, framesPerDir-1]）。
    public int LoopStart() { return this.loopStart; }
}
