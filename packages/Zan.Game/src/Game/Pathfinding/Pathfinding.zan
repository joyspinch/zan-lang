using System;
using System.Collections.Generic;

namespace Game.Pathfinding;

// 寻路门面：把 A* / JPS / 平滑 / 导航网格串成常用调用。
//
// 选哪条路：
//   - 地图不大、路径要逐格（单位按格子走）：FindPath / FindPathJps
//   - 单位要连续移动、走廊复杂：FindNavPath（导航网格 + 漏斗）
public class Pathfinding {
    // A* + 视线拉直（默认入口）。
    public static CellPath FindPath(GridMap map, GridPoint start, GridPoint goal) {
        return Pathfinding.FindPath(map, start, goal, new AStarOptions());
    }

    public static CellPath FindPath(GridMap map, GridPoint start, GridPoint goal,
                                    AStarOptions options) {
        CellPath raw = AStar.Find(map, start, goal, options);
        if (raw.IsEmpty()) { return raw; }
        return PathSmoother.Smooth(map, raw);
    }

    // JPS + 视线拉直。空网格上比 A* 快得多；非均匀代价地图上自动退回 A*。
    public static CellPath FindPathJps(GridMap map, GridPoint start, GridPoint goal) {
        CellPath raw = Jps.Find(map, start, goal);
        if (raw.IsEmpty()) { return raw; }
        return PathSmoother.Smooth(map, raw);
    }

    // 导航网格路径（世界坐标折线）。
    public static List<Point2> FindNavPath(NavMesh mesh, Point2 start, Point2 goal) {
        if (mesh == null) { return new List<Point2>(); }
        return mesh.FindPath(start, goal);
    }
}
