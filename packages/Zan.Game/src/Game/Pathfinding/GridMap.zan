using System;
using System.Collections.Generic;

namespace Game.Pathfinding;

// 网格坐标（整型）。
public struct GridPoint {
    public int x;
    public int y;

    public GridPoint(int x, int y) {
        this.x = x;
        this.y = y;
    }

    public static bool operator ==(GridPoint a, GridPoint b) {
        return a.x == b.x && a.y == b.y;
    }
    public static bool operator !=(GridPoint a, GridPoint b) {
        return !(a.x == b.x && a.y == b.y);
    }

    public override string ToString() {
        return "(" + this.x.ToString() + ", " + this.y.ToString() + ")";
    }
}

// 通行网格：寻路的底座。
//
// 代价模型：**进入一格**的代价（默认 1.0）。负数表示障碍（不可通行）。
// A* 走"欧氏代价"（对角一步算 √2 倍）；JPS 只在**均匀代价**网格上成立
// （见 Jps.zan）。
public class GridMap {
    public int width;
    public int height;
    private double[] costs;

    public GridMap(int width, int height) {
        this.width = width;
        this.height = height;
        this.costs = new double[width * height];
        for (int i = 0; i < this.costs.Length; i = i + 1) {
            this.costs[i] = 1.0;
        }
    }

    // 行优先下标：y * width + x。
    public int Index(int x, int y) {
        return y * this.width + x;
    }

    public bool IsInside(int x, int y) {
        return x >= 0 && x < this.width && y >= 0 && y < this.height;
    }

    public bool IsWalkable(int x, int y) {
        if (!this.IsInside(x, y)) { return false; }
        return this.costs[this.Index(x, y)] >= 0.0;
    }

    // 进入 (x, y) 的代价；不可通行时返回 -1。
    public double Cost(int x, int y) {
        if (!this.IsInside(x, y)) { return -1.0; }
        return this.costs[this.Index(x, y)];
    }

    public void SetCost(int x, int y, double cost) {
        if (this.IsInside(x, y)) {
            this.costs[this.Index(x, y)] = cost;
        }
    }

    // 网格里最小的通行代价（启发式缩放用；全障碍时返回 1.0）。
    public double MinCost() {
        double min = -1.0;
        for (int i = 0; i < this.costs.Length; i = i + 1) {
            double c = this.costs[i];
            if (c < 0.0) { continue; }
            if (min < 0.0 || c < min) { min = c; }
        }
        if (min < 0.0) { return 1.0; }
        return min;
    }

    // 是否是**均匀代价**网格（所有可通行格的代价相同）。
    // JPS（跳跃点搜索）只在均匀代价网格上成立，非均匀时 Find 会退回 A*。
    public bool IsUniformCost() {
        double first = -1.0;
        for (int i = 0; i < this.costs.Length; i = i + 1) {
            double c = this.costs[i];
            if (c < 0.0) { continue; }
            if (first < 0.0) {
                first = c;
                continue;
            }
            if (c != first) { return false; }
        }
        return true;
    }

    // 格子中心的世界坐标（格 (x, y) 的中心是 (x + 0.5, y + 0.5)）。
    public Point2 CellCenter(int x, int y) {
        return new Point2(x + 0.5, y + 0.5);
    }

    // 世界坐标 → 格子（取包含该点的格子）。
    public GridPoint WorldToCell(Point2 p) {
        int cx = (int)Math.Floor(p.x);
        int cy = (int)Math.Floor(p.y);
        return new GridPoint(cx, cy);
    }

    // 由"格子值数组"构造：值等于 blockedValue 的格子是障碍，其余代价 1.0。
    public static GridMap FromBlocked(int[] cells, int width, int height, int blockedValue) {
        GridMap map = new GridMap(width, height);
        for (int i = 0; i < map.costs.Length && i < cells.Length; i = i + 1) {
            if (cells[i] == blockedValue) {
                map.costs[i] = -1.0;
            } else {
                map.costs[i] = 1.0;
            }
        }
        return map;
    }

    // 由"通行标记"构造：true 可通行（代价 1.0），false 障碍。
    public static GridMap FromWalkable(bool[] walkable, int width, int height) {
        GridMap map = new GridMap(width, height);
        for (int i = 0; i < map.costs.Length && i < walkable.Length; i = i + 1) {
            if (walkable[i]) {
                map.costs[i] = 1.0;
            } else {
                map.costs[i] = -1.0;
            }
        }
        return map;
    }

    // 由"代价数组"构造：负数为障碍，其余为进入该格的代价。
    public static GridMap FromCosts(double[] costs, int width, int height) {
        GridMap map = new GridMap(width, height);
        for (int i = 0; i < map.costs.Length && i < costs.Length; i = i + 1) {
            map.costs[i] = costs[i];
        }
        return map;
    }
}
