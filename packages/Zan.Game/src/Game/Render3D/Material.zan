namespace Game.Render3D;

// 材质参数：一次光照计算所需的全部输入。
//
// 颜色分量都是线性 0..1（不是 sRGB 字节值）——光照在线性空间做，
// 打包成 ARGB 整数是最后一步（见 Lighting.PackArgb）。
//
// **透明与否由节点决定**（SceneNode.Layer），材质只管 Alpha 数值，
// 避免"两层都说了算谁的"这种双份真相。
public class Material {
    // 反照率（漫反射基色）。
    public float Red;
    public float Green;
    public float Blue;
    // 不透明度（0..1），写进 tint 的 alpha 通道。
    public float Alpha;
    // 金属度（0..1）：越高漫反射越少、高光越强。
    public float Metallic;
    // 粗糙度（0..1）：越高高光越散。
    public float Roughness;
    // 自发光（线性 0..1），不参与光照计算，直接叠加。
    public float EmissiveRed;
    public float EmissiveGreen;
    public float EmissiveBlue;
    // 纹理键（图像路径或 "mem:" key）；空串表示无纹理。
    public string TextureKey;

    public Material() {
        this.Red = 0.8f;
        this.Green = 0.8f;
        this.Blue = 0.8f;
        this.Alpha = 1.0f;
        this.Metallic = 0.0f;
        this.Roughness = 0.8f;
        this.EmissiveRed = 0.0f;
        this.EmissiveGreen = 0.0f;
        this.EmissiveBlue = 0.0f;
        this.TextureKey = "";
    }

    // 纯色漫反射材质。
    public static Material Solid(float red, float green, float blue) {
        Material m = new Material();
        m.Red = red;
        m.Green = green;
        m.Blue = blue;
        return m;
    }

    // 自发光材质（不受光照影响）。
    public static Material Emissive(float red, float green, float blue) {
        Material m = Material.Solid(red, green, blue);
        m.EmissiveRed = red;
        m.EmissiveGreen = green;
        m.EmissiveBlue = blue;
        return m;
    }
}
