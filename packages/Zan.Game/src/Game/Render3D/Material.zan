namespace Game.Render3D;

// 材质参数：一次光照计算所需的全部输入。
//
// 颜色分量都是线性 0..1（不是 sRGB 字节值）——光照在线性空间做，
// 打包成 ARGB 整数是最后一步（见 Lighting.PackArgb）。
//
// **透明与否由节点决定**（SceneNode.Layer），材质只管 Alpha 数值，
// 避免"两层都说了算谁的"这种双份真相。
public class Material {
    // 反照率（漫反射基色）。
    public float Red;
    public float Green;
    public float Blue;
    // 不透明度（0..1），写进 tint 的 alpha 通道。
    public float Alpha;
    // 金属度（0..1）：越高漫反射越少、高光越强。
    public float Metallic;
    // 粗糙度（0..1）：越高高光越散。
    public float Roughness;
    // 自发光（线性 0..1），不参与光照计算，直接叠加。
    public float EmissiveRed;
    public float EmissiveGreen;
    public float EmissiveBlue;
    // 纹理键（图像路径或 "mem:" key）；空串表示无纹理。
    public string TextureKey;
    // 切线空间法线贴图键（图像路径或 "mem:" key）；空串表示关闭法线扰动。
    public string NormalMapKey;
    // 法线贴图凹凸强度（默认 1.0）。
    public float NormalScale;
    // glTF 2.0 ORM 复合贴图键（R=AO, G=Roughness, B=Metallic）；空串表示纯标量 PBR。
    public string OrmMapKey;
    // AO 环境光遮蔽强度（0..1，默认 1.0）。
    public float AoStrength;
    // Alpha Cutout 裁切阈值（>0 启用 MASK discard，0 关闭）。
    public float AlphaCutoff;
    // 硬件面剔除模式：0 = 双面（关闭剔除），1 = 剔除背面（Back），2 = 剔除正面（Front）。
    public int CullMode;
    // 加法辉光混合开关（配合透明层 Layer=1 使用，实现火焰/剑光/能量罩线性叠加）。
    public bool AdditiveBlend;
    // glTF 2.0 自发光贴图键（纹理单元 4，与 EmissiveRed/Green/Blue 相乘）；空串表示纯标量自发光。
    public string EmissiveMapKey;
    // GPU UV 平铺与滚动变换（v_uv = a_uv * (UvScaleU, UvScaleV) + (UvOffsetU, UvOffsetV)）。
    public float UvScaleU;
    public float UvScaleV;
    public float UvOffsetU;
    public float UvOffsetV;
    // GPU 菲涅尔轮廓边缘光（Rim Light，RGB 全 0 关闭，RimPower 推荐 2.0..5.0）。
    public float RimRed;
    public float RimGreen;
    public float RimBlue;
    public float RimPower;

    public Material() {
        this.Red = 0.8f;
        this.Green = 0.8f;
        this.Blue = 0.8f;
        this.Alpha = 1.0f;
        this.Metallic = 0.0f;
        this.Roughness = 0.8f;
        this.EmissiveRed = 0.0f;
        this.EmissiveGreen = 0.0f;
        this.EmissiveBlue = 0.0f;
        this.TextureKey = "";
        this.NormalMapKey = "";
        this.NormalScale = 1.0f;
        this.OrmMapKey = "";
        this.AoStrength = 1.0f;
        this.AlphaCutoff = 0.0f;
        this.CullMode = 0;
        this.AdditiveBlend = false;
        this.EmissiveMapKey = "";
        this.UvScaleU = 1.0f;
        this.UvScaleV = 1.0f;
        this.UvOffsetU = 0.0f;
        this.UvOffsetV = 0.0f;
        this.RimRed = 0.0f;
        this.RimGreen = 0.0f;
        this.RimBlue = 0.0f;
        this.RimPower = 3.0f;
    }

    // 纯色漫反射材质。
    public static Material Solid(float red, float green, float blue) {
        Material m = new Material();
        m.Red = red;
        m.Green = green;
        m.Blue = blue;
        return m;
    }

    // 自发光材质（不受光照影响）。
    public static Material Emissive(float red, float green, float blue) {
        Material m = Material.Solid(red, green, blue);
        m.EmissiveRed = red;
        m.EmissiveGreen = green;
        m.EmissiveBlue = blue;
        return m;
    }
}
