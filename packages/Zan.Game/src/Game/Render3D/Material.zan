namespace Game.Render3D;

// 材质参数：一次光照计算所需的全部输入。
//
// 颜色分量都是线性 0..1（不是 sRGB 字节值）——光照在线性空间做，
// 打包成 ARGB 整数是最后一步（见 Lighting.PackArgb）。
//
// **透明与否由节点决定**（SceneNode.Layer），材质只管 Alpha 数值，
// 避免"两层都说了算谁的"这种双份真相。
public class Material {
    // 反照率（漫反射基色）。
    public float Red;
    public float Green;
    public float Blue;
    // 不透明度（0..1），写进 tint 的 alpha 通道。
    public float Alpha;
    // 金属度（0..1）：越高漫反射越少、高光越强。
    public float Metallic;
    // 粗糙度（0..1）：越高高光越散。
    public float Roughness;
    // 自发光（线性 0..1），不参与光照计算，直接叠加。
    public float EmissiveRed;
    public float EmissiveGreen;
    public float EmissiveBlue;
    // 纹理键（图像路径或 "mem:" key）；空串表示无纹理。
    public string TextureKey;
    // 切线空间法线贴图键（图像路径或 "mem:" key）；空串表示关闭法线扰动。
    public string NormalMapKey;
    // 法线贴图凹凸强度（默认 1.0）。
    public float NormalScale;
    // glTF 2.0 ORM 复合贴图键（R=AO, G=Roughness, B=Metallic）；空串表示纯标量 PBR。
    public string OrmMapKey;
    // AO 环境光遮蔽强度（0..1，默认 1.0）。
    public float AoStrength;
    // Alpha Cutout 裁切阈值（>0 启用 MASK discard，0 关闭）。
    public float AlphaCutoff;
    // 硬件面剔除模式：0 = 双面（关闭剔除），1 = 剔除背面（Back），2 = 剔除正面（Front）。
    public int CullMode;
    // 加法辉光混合开关（配合透明层 Layer=1 使用，实现火焰/剑光/能量罩线性叠加）。
    public bool AdditiveBlend;
    // glTF 2.0 自发光贴图键（纹理单元 4，与 EmissiveRed/Green/Blue 相乘）；空串表示纯标量自发光。
    public string EmissiveMapKey;
    // GPU UV 平铺与滚动变换（v_uv = a_uv * (UvScaleU, UvScaleV) + (UvOffsetU, UvOffsetV)）。
    public float UvScaleU;
    public float UvScaleV;
    public float UvOffsetU;
    public float UvOffsetV;
    // GPU 菲涅尔轮廓边缘光（Rim Light，RGB 全 0 关闭，RimPower 推荐 2.0..5.0）。
    public float RimRed;
    public float RimGreen;
    public float RimBlue;
    public float RimPower;
    // GPU 风格化卡通色阶（>= 2.0 开启二次元/赛璐璐量化着色，0 关闭还原连续 PBR）。
    public float ToonBands;
    public float ToonSpecularStep;
    // GPU 程序化噪声消融（DissolveThreshold <= 0 关闭；>= 1.05 完全消融；Edge* 控制燃烧亮边）。
    public float DissolveThreshold;
    public float DissolveEdgeWidth;
    public float DissolveEdgeRed;
    public float DissolveEdgeGreen;
    public float DissolveEdgeBlue;
    // GPU 世界空间三平面纹理投影（TriplanarEnabled=true 时忽略顶点 UV 拉伸，按世界坐标三轴无缝平铺）。
    public bool TriplanarEnabled;
    public float TriplanarScale;
    public float TriplanarSharpness;
    // GPU 受击闪白与异常状态覆色（HitFlashAmount 0..1 控制混入强度，0 关闭）。
    public float HitFlashRed;
    public float HitFlashGreen;
    public float HitFlashBlue;
    public float HitFlashAmount;
    // GPU 全息扫描线与能量护盾菲涅尔覆层（HoloScanEnabled=true 时沿世界 Y 轴叠加发光带）。
    public bool HoloScanEnabled;
    public float HoloScanFrequency;
    public float HoloScanPhase;
    public float HoloScanStrength;
    public float HoloScanRed;
    public float HoloScanGreen;
    public float HoloScanBlue;
    // GPU 世界法线朝上积雪/青苔/落灰材质覆层（TopCoverEnabled=true 时在朝上表面混入覆色）。
    public bool TopCoverEnabled;
    public float TopCoverThreshold;
    public float TopCoverSharpness;
    public float TopCoverAmount;
    public float TopCoverRed;
    public float TopCoverGreen;
    public float TopCoverBlue;
    // GPU 顶点微风摇曳动画（WindSwayEnabled=true 且 Amplitude > 0 时按局部高度摆动植被/旗帜）。
    public bool WindSwayEnabled;
    public float WindSwayAmplitude;
    public float WindSwayFrequency;
    public float WindSwayPhase;
    public float WindSwayHeightScale;
    // GPU 屏幕空间 Bayer 4x4 抖动距离淡出（DistanceFadeEnabled=true 时按相机距离有序抖动透明）。
    public bool DistanceFadeEnabled;
    public float DistanceFadeStart;
    public float DistanceFadeEnd;
    // GPU 世界空间抗锯齿程序化网格（WorldGridEnabled=true 时在 XZ 平面叠加战术/建造网格）。
    public bool WorldGridEnabled;
    public float WorldGridCellSize;
    public float WorldGridLineWidth;
    public float WorldGridStrength;
    public float WorldGridRed;
    public float WorldGridGreen;
    public float WorldGridBlue;
    // GPU 世界空间程序化水底焦散光斑（WaterCausticsEnabled=true 时在朝上表面叠加干涉光网）。
    public bool WaterCausticsEnabled;
    public float WaterCausticsScale;
    public float WaterCausticsPhase;
    public float WaterCausticsStrength;
    public float WaterCausticsRed;
    public float WaterCausticsGreen;
    public float WaterCausticsBlue;
    // GPU 世界空间冰霜晶面闪烁与菲涅尔冰膜覆层（IceFrostEnabled=true 时叠加冰冻/结晶闪烁）。
    public bool IceFrostEnabled;
    public float IceFrostScale;
    public float IceFrostGlintStrength;
    public float IceFrostFresnelPower;
    public float IceFrostRed;
    public float IceFrostGreen;
    public float IceFrostBlue;
    // GPU 世界空间岩浆裂纹发光覆层（LavaCrustEnabled=true 时沿世界空间裂纹透出熔岩自发光）。
    public bool LavaCrustEnabled;
    public float LavaCrustScale;
    public float LavaCrustPhase;
    public float LavaCrustCrackWidth;
    public float LavaCrustStrength;
    public float LavaCrustRed;
    public float LavaCrustGreen;
    public float LavaCrustBlue;
    // GPU 薄膜干涉虹彩珠光涂层（IridescenceEnabled=true 时按视角产生薄膜彩虹干涉色）。
    public bool IridescenceEnabled;
    public float IridescenceFilmThickness;
    public float IridescencePhaseShift;
    public float IridescenceStrength;
    // GPU 3D 世界空间球面战术声呐脉冲波前（SonarPulseEnabled=true 时渲染高能扫描环与尾迹）。
    public bool SonarPulseEnabled;
    public float SonarOriginX;
    public float SonarOriginY;
    public float SonarOriginZ;
    public float SonarRadius;
    public float SonarRingWidth;
    public float SonarStrength;
    public float SonarRed;
    public float SonarGreen;
    public float SonarBlue;
    // GPU 3D 世界空间科幻六边形能量护盾网格（ForceFieldEnabled=true 时渲染六边形边界发光）。
    public bool ForceFieldEnabled;
    public float ForceFieldScale;
    public float ForceFieldPhase;
    public float ForceFieldEdgeWidth;
    public float ForceFieldStrength;
    public float ForceFieldRed;
    public float ForceFieldGreen;
    public float ForceFieldBlue;
    // GPU 3D 世界空间雨滴水洼同心涟漪（RainRipplesEnabled=true 时在朝上表面生成动态雨滴涟漪）。
    public bool RainRipplesEnabled;
    public float RainRipplesScale;
    public float RainRipplesPhase;
    public float RainRipplesStrength;
    public float RainRipplesRed;
    public float RainRipplesGreen;
    public float RainRipplesBlue;

    public Material() {
        this.Red = 0.8f;
        this.Green = 0.8f;
        this.Blue = 0.8f;
        this.Alpha = 1.0f;
        this.Metallic = 0.0f;
        this.Roughness = 0.8f;
        this.EmissiveRed = 0.0f;
        this.EmissiveGreen = 0.0f;
        this.EmissiveBlue = 0.0f;
        this.TextureKey = "";
        this.NormalMapKey = "";
        this.NormalScale = 1.0f;
        this.OrmMapKey = "";
        this.AoStrength = 1.0f;
        this.AlphaCutoff = 0.0f;
        this.CullMode = 0;
        this.AdditiveBlend = false;
        this.EmissiveMapKey = "";
        this.UvScaleU = 1.0f;
        this.UvScaleV = 1.0f;
        this.UvOffsetU = 0.0f;
        this.UvOffsetV = 0.0f;
        this.RimRed = 0.0f;
        this.RimGreen = 0.0f;
        this.RimBlue = 0.0f;
        this.RimPower = 3.0f;
        this.ToonBands = 0.0f;
        this.ToonSpecularStep = 0.35f;
        this.DissolveThreshold = 0.0f;
        this.DissolveEdgeWidth = 0.08f;
        this.DissolveEdgeRed = 1.0f;
        this.DissolveEdgeGreen = 0.4f;
        this.DissolveEdgeBlue = 0.05f;
        this.TriplanarEnabled = false;
        this.TriplanarScale = 1.0f;
        this.TriplanarSharpness = 4.0f;
        this.HitFlashRed = 1.0f;
        this.HitFlashGreen = 1.0f;
        this.HitFlashBlue = 1.0f;
        this.HitFlashAmount = 0.0f;
        this.HoloScanEnabled = false;
        this.HoloScanFrequency = 12.0f;
        this.HoloScanPhase = 0.0f;
        this.HoloScanStrength = 0.0f;
        this.HoloScanRed = 0.0f;
        this.HoloScanGreen = 0.9f;
        this.HoloScanBlue = 1.0f;
        this.TopCoverEnabled = false;
        this.TopCoverThreshold = 0.5f;
        this.TopCoverSharpness = 0.25f;
        this.TopCoverAmount = 0.0f;
        this.TopCoverRed = 0.95f;
        this.TopCoverGreen = 0.97f;
        this.TopCoverBlue = 1.0f;
        this.WindSwayEnabled = false;
        this.WindSwayAmplitude = 0.0f;
        this.WindSwayFrequency = 1.5f;
        this.WindSwayPhase = 0.0f;
        this.WindSwayHeightScale = 1.0f;
        this.DistanceFadeEnabled = false;
        this.DistanceFadeStart = 0.5f;
        this.DistanceFadeEnd = 2.0f;
        this.WorldGridEnabled = false;
        this.WorldGridCellSize = 1.0f;
        this.WorldGridLineWidth = 0.05f;
        this.WorldGridStrength = 0.0f;
        this.WorldGridRed = 0.0f;
        this.WorldGridGreen = 0.9f;
        this.WorldGridBlue = 1.0f;
        this.WaterCausticsEnabled = false;
        this.WaterCausticsScale = 1.0f;
        this.WaterCausticsPhase = 0.0f;
        this.WaterCausticsStrength = 0.0f;
        this.WaterCausticsRed = 0.4f;
        this.WaterCausticsGreen = 0.9f;
        this.WaterCausticsBlue = 1.0f;
        this.IceFrostEnabled = false;
        this.IceFrostScale = 2.0f;
        this.IceFrostGlintStrength = 0.0f;
        this.IceFrostFresnelPower = 2.5f;
        this.IceFrostRed = 0.65f;
        this.IceFrostGreen = 0.92f;
        this.IceFrostBlue = 1.0f;
        this.LavaCrustEnabled = false;
        this.LavaCrustScale = 1.5f;
        this.LavaCrustPhase = 0.0f;
        this.LavaCrustCrackWidth = 0.18f;
        this.LavaCrustStrength = 0.0f;
        this.LavaCrustRed = 1.0f;
        this.LavaCrustGreen = 0.35f;
        this.LavaCrustBlue = 0.04f;
        this.IridescenceEnabled = false;
        this.IridescenceFilmThickness = 2.0f;
        this.IridescencePhaseShift = 0.0f;
        this.IridescenceStrength = 0.0f;
        this.SonarPulseEnabled = false;
        this.SonarOriginX = 0.0f;
        this.SonarOriginY = 0.0f;
        this.SonarOriginZ = 0.0f;
        this.SonarRadius = 1.0f;
        this.SonarRingWidth = 0.6f;
        this.SonarStrength = 0.0f;
        this.SonarRed = 0.1f;
        this.SonarGreen = 0.9f;
        this.SonarBlue = 1.0f;
        this.ForceFieldEnabled = false;
        this.ForceFieldScale = 2.0f;
        this.ForceFieldPhase = 0.0f;
        this.ForceFieldEdgeWidth = 0.10f;
        this.ForceFieldStrength = 0.0f;
        this.ForceFieldRed = 0.1f;
        this.ForceFieldGreen = 0.75f;
        this.ForceFieldBlue = 1.0f;
        this.RainRipplesEnabled = false;
        this.RainRipplesScale = 2.0f;
        this.RainRipplesPhase = 0.0f;
        this.RainRipplesStrength = 0.0f;
        this.RainRipplesRed = 0.75f;
        this.RainRipplesGreen = 0.88f;
        this.RainRipplesBlue = 1.0f;
    }

    // 纯色漫反射材质。
    public static Material Solid(float red, float green, float blue) {
        Material m = new Material();
        m.Red = red;
        m.Green = green;
        m.Blue = blue;
        return m;
    }

    // 自发光材质（不受光照影响）。
    public static Material Emissive(float red, float green, float blue) {
        Material m = Material.Solid(red, green, blue);
        m.EmissiveRed = red;
        m.EmissiveGreen = green;
        m.EmissiveBlue = blue;
        return m;
    }
}
