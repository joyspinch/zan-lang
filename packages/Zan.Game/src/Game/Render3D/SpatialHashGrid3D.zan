using System;
using System.Collections.Generic;

namespace Game.Render3D;

// 空间哈希网格中的 3D 动态实体记录。
public class SpatialEntry3D {
    public int EntityId;
    public float X;
    public float Y;
    public float Z;
    public int CellX;
    public int CellY;
    public int CellZ;

    public SpatialEntry3D(int entityId, float x, float y, float z, int cx, int cy, int cz) {
        this.EntityId = entityId;
        this.X = x;
        this.Y = y;
        this.Z = z;
        this.CellX = cx;
        this.CellY = cy;
        this.CellZ = cz;
    }
}

// 商业 3D 均匀空间哈希网格：支持海量动态移动实体的快速位置更新、移除与球形邻域检索。
public class SpatialHashGrid3D {
    private List<SpatialEntry3D> entries;
    public float CellSize;

    public SpatialHashGrid3D(float cellSize) {
        this.entries = new List<SpatialEntry3D>();
        this.CellSize = cellSize > 0.1f ? cellSize : 4.0f;
    }

    private int CellCoord(float v) {
        return (int)Math.Floor((double)(v / this.CellSize));
    }

    public int Count() { return this.entries.Count; }

    public void Upsert(int entityId, float x, float y, float z) {
        int cx = this.CellCoord(x);
        int cy = this.CellCoord(y);
        int cz = this.CellCoord(z);
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            SpatialEntry3D e = this.entries[i];
            if (e.EntityId == entityId) {
                e.X = x; e.Y = y; e.Z = z;
                e.CellX = cx; e.CellY = cy; e.CellZ = cz;
                return;
            }
        }
        this.entries.Add(new SpatialEntry3D(entityId, x, y, z, cx, cy, cz));
    }

    public bool Remove(int entityId) {
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            if (this.entries[i].EntityId == entityId) {
                this.entries.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    // 球形半径邻域检索：先按整数栅格包围盒粗剔，再做精确欧氏距离平方判定。
    public List<int> QuerySphere(float cxPos, float cyPos, float czPos, float radius) {
        List<int> hits = new List<int>();
        if (radius < 0.0f) { return hits; }
        int minX = this.CellCoord(cxPos - radius);
        int maxX = this.CellCoord(cxPos + radius);
        int minY = this.CellCoord(cyPos - radius);
        int maxY = this.CellCoord(cyPos + radius);
        int minZ = this.CellCoord(czPos - radius);
        int maxZ = this.CellCoord(czPos + radius);
        float r2 = radius * radius;
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            SpatialEntry3D e = this.entries[i];
            if (e.CellX < minX || e.CellX > maxX) { continue; }
            if (e.CellY < minY || e.CellY > maxY) { continue; }
            if (e.CellZ < minZ || e.CellZ > maxZ) { continue; }
            float dx = e.X - cxPos;
            float dy = e.Y - cyPos;
            float dz = e.Z - czPos;
            if ((dx * dx + dy * dy + dz * dz) <= r2) {
                hits.Add(e.EntityId);
            }
        }
        return hits;
    }
}
