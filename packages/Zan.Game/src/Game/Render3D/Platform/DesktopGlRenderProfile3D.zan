using System;

namespace Game.Render3D;

// 桌面 OpenGL 3.3 Core（Windows / macOS / Linux）渲染后端档案实现。
public class DesktopGlRenderProfile3D : IRenderBackendProfile3D {
    public string BackendName() { return "DesktopOpenGL33"; }
    public string GlslHeader() { return "#version 330 core"; }
    public int RecommendedShadowSize() { return 2048; }
    public int MaxSkinBones() { return 128; }
    public int MaxDynamicLights() { return 8; }
    public float DefaultRenderScale() { return 1.0f; }
    public bool SupportsMsaa() { return true; }
}
