using System;

namespace Game.Render3D;

// OpenHarmony OpenGL ES 3.0（OHOS 手机/平板/PC 统一）渲染后端档案实现。
public class HarmonyGlesRenderProfile3D : IRenderBackendProfile3D {
    public string BackendName() { return "HarmonyOpenGLES30"; }
    public string GlslHeader() { return "#version 300 es"; }
    public int RecommendedShadowSize() { return 1024; }
    public int MaxSkinBones() { return 64; }
    public int MaxDynamicLights() { return 4; }
    public float DefaultRenderScale() { return 0.80f; }
    public bool SupportsMsaa() { return false; }
}
