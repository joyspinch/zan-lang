using System;

namespace Game.Render3D;

// 跨平台 3D 渲染后端档案统一接口（各平台独立文件实现，业务层零 if 分支）。
public interface IRenderBackendProfile3D {
    string BackendName();
    string GlslHeader();
    int RecommendedShadowSize();
    int MaxSkinBones();
    int MaxDynamicLights();
    float DefaultRenderScale();
    bool SupportsMsaa();
}
