using System;

namespace Game.Render3D;

// 跨平台 3D 渲染后端档案单点装配工厂（全模块唯一一处按 OperatingSystem 分发）。
public static class RenderBackendProfileFactory3D {
    public static IRenderBackendProfile3D CreateForHost() {
        if (OperatingSystem.IsOhos()) { return new HarmonyGlesRenderProfile3D(); }
        if (OperatingSystem.IsAndroid() || OperatingSystem.IsIos()) { return new MobileGlesRenderProfile3D(); }
        return new DesktopGlRenderProfile3D();
    }
}
