using System.Numerics;

namespace Game.Render3D;

// 程序化 GPU 大气天空盒配置：天顶色 / 地平线色 / 地面反射色 + 太阳方向光晕。
// 所有颜色分量为线性 0..1。
public class Skybox3D {
    public float TopRed;
    public float TopGreen;
    public float TopBlue;

    public float HorizonRed;
    public float HorizonGreen;
    public float HorizonBlue;

    public float GroundRed;
    public float GroundGreen;
    public float GroundBlue;

    // 指向太阳的世界方向向量（着色器内归一化）。
    public Vector3 SunDirection;

    public Skybox3D() {
        this.TopRed = 0.14f;
        this.TopGreen = 0.36f;
        this.TopBlue = 0.78f;
        this.HorizonRed = 0.68f;
        this.HorizonGreen = 0.80f;
        this.HorizonBlue = 0.94f;
        this.GroundRed = 0.24f;
        this.GroundGreen = 0.22f;
        this.GroundBlue = 0.20f;
        this.SunDirection = new Vector3(0.4f, 0.7f, 0.5f);
    }

    public static Skybox3D Daylight() {
        return new Skybox3D();
    }

    public static Skybox3D Sunset() {
        Skybox3D s = new Skybox3D();
        s.TopRed = 0.16f; s.TopGreen = 0.18f; s.TopBlue = 0.42f;
        s.HorizonRed = 0.96f; s.HorizonGreen = 0.48f; s.HorizonBlue = 0.24f;
        s.GroundRed = 0.16f; s.GroundGreen = 0.12f; s.GroundBlue = 0.14f;
        s.SunDirection = new Vector3(0.0f, 0.15f, -1.0f);
        return s;
    }

    public static Skybox3D Night() {
        Skybox3D s = new Skybox3D();
        s.TopRed = 0.02f; s.TopGreen = 0.04f; s.TopBlue = 0.12f;
        s.HorizonRed = 0.08f; s.HorizonGreen = 0.12f; s.HorizonBlue = 0.24f;
        s.GroundRed = 0.03f; s.GroundGreen = 0.03f; s.GroundBlue = 0.05f;
        s.SunDirection = new Vector3(-0.3f, 0.6f, -0.7f);
        return s;
    }
}
