using Gui;
using Game.Animation;

namespace Game.Render3D;

// 一个绘制项：渲染计划算好的一条"把这个网格这样画"指令。
//
// 纯数据，没有行为——绘制层只读这些字段，不反过来改。
public class RenderItem {
    // 网格句柄。
    public int MeshKey;
    // 纹理键（图像路径或 "mem:" key）；空串表示无纹理。
    public string TextureKey;
    // 纹理分组号：同一 (网格, 纹理) 的项分组号相同——排序后同组相邻，
    // 批次提交时才能连成一段（同网格多实例 = 一次实例化绘制）。
    public int TexGroup;
    // 模型矩阵（世界变换）。
    public Mat4 Model;
    // 着色后的 tint（0xAARRGGBB）；-1 = 不染色（白）。
    public int Tint;
    // 反照率（albedo）tint（0xAARRGGBB，纯材质反照率色与不透明度）；供 GPU 着色使用。
    public int Albedo;
    // 渲染层：0 = 不透明，1 = 透明。
    public int Layer;
    // 沿视线的深度（相机背后为负），用于透明排序与雾。
    public float Depth;
    // 来源节点名（调试用）。
    public string NodeName;
    // 阴影与蒙皮元数据（来自 SceneNode）。
    public bool CastShadow;
    public bool ReceiveShadow;
    public bool IsSkinned;
    public Skeleton Skeleton;
    // GPU 材质参数（金属度/粗糙度/自发光/法线贴图，来自 Material）。
    public float Metallic;
    public float Roughness;
    public float EmissiveRed;
    public float EmissiveGreen;
    public float EmissiveBlue;
    public string NormalMapKey;
    public float NormalScale;
    public string OrmMapKey;
    public float AoStrength;
    public float AlphaCutoff;
    public int CullMode;
    public bool AdditiveBlend;
    public string EmissiveMapKey;
    public float UvScaleU;
    public float UvScaleV;
    public float UvOffsetU;
    public float UvOffsetV;
    public float RimRed;
    public float RimGreen;
    public float RimBlue;
    public float RimPower;
    public float ToonBands;
    public float ToonSpecularStep;
    public float DissolveThreshold;
    public float DissolveEdgeWidth;
    public float DissolveEdgeRed;
    public float DissolveEdgeGreen;
    public float DissolveEdgeBlue;
    public bool TriplanarEnabled;
    public float TriplanarScale;
    public float TriplanarSharpness;
    public float HitFlashRed;
    public float HitFlashGreen;
    public float HitFlashBlue;
    public float HitFlashAmount;
    public bool HoloScanEnabled;
    public float HoloScanFrequency;
    public float HoloScanPhase;
    public float HoloScanStrength;
    public float HoloScanRed;
    public float HoloScanGreen;
    public float HoloScanBlue;
    public bool TopCoverEnabled;
    public float TopCoverThreshold;
    public float TopCoverSharpness;
    public float TopCoverAmount;
    public float TopCoverRed;
    public float TopCoverGreen;
    public float TopCoverBlue;
    public bool WindSwayEnabled;
    public float WindSwayAmplitude;
    public float WindSwayFrequency;
    public float WindSwayPhase;
    public float WindSwayHeightScale;

    public RenderItem() {
        this.MeshKey = 0;
        this.TextureKey = "";
        this.TexGroup = 0;
        this.Model = Mat4.Identity();
        this.Tint = -1;
        this.Albedo = -1;
        this.Layer = 0;
        this.Depth = 0.0f;
        this.NodeName = "";
        this.CastShadow = true;
        this.ReceiveShadow = true;
        this.IsSkinned = false;
        this.Skeleton = null;
        this.Metallic = 0.0f;
        this.Roughness = 1.0f;
        this.EmissiveRed = 0.0f;
        this.EmissiveGreen = 0.0f;
        this.EmissiveBlue = 0.0f;
        this.NormalMapKey = "";
        this.NormalScale = 1.0f;
        this.OrmMapKey = "";
        this.AoStrength = 1.0f;
        this.AlphaCutoff = 0.0f;
        this.CullMode = 0;
        this.AdditiveBlend = false;
        this.EmissiveMapKey = "";
        this.UvScaleU = 1.0f;
        this.UvScaleV = 1.0f;
        this.UvOffsetU = 0.0f;
        this.UvOffsetV = 0.0f;
        this.RimRed = 0.0f;
        this.RimGreen = 0.0f;
        this.RimBlue = 0.0f;
        this.RimPower = 3.0f;
        this.ToonBands = 0.0f;
        this.ToonSpecularStep = 0.35f;
        this.DissolveThreshold = 0.0f;
        this.DissolveEdgeWidth = 0.08f;
        this.DissolveEdgeRed = 1.0f;
        this.DissolveEdgeGreen = 0.4f;
        this.DissolveEdgeBlue = 0.05f;
        this.TriplanarEnabled = false;
        this.TriplanarScale = 1.0f;
        this.TriplanarSharpness = 4.0f;
        this.HitFlashRed = 1.0f;
        this.HitFlashGreen = 1.0f;
        this.HitFlashBlue = 1.0f;
        this.HitFlashAmount = 0.0f;
        this.HoloScanEnabled = false;
        this.HoloScanFrequency = 12.0f;
        this.HoloScanPhase = 0.0f;
        this.HoloScanStrength = 0.0f;
        this.HoloScanRed = 0.0f;
        this.HoloScanGreen = 0.9f;
        this.HoloScanBlue = 1.0f;
        this.TopCoverEnabled = false;
        this.TopCoverThreshold = 0.5f;
        this.TopCoverSharpness = 0.25f;
        this.TopCoverAmount = 0.0f;
        this.TopCoverRed = 0.95f;
        this.TopCoverGreen = 0.97f;
        this.TopCoverBlue = 1.0f;
        this.WindSwayEnabled = false;
        this.WindSwayAmplitude = 0.0f;
        this.WindSwayFrequency = 1.5f;
        this.WindSwayPhase = 0.0f;
        this.WindSwayHeightScale = 1.0f;
    }
}
