using System;
using System.Collections.Generic;
using System.Numerics;

namespace Game.Render3D;

// 商业 3D 广告牌粒子发射器参数配置（零 GC 池化粒子系统）：
// - 确定性伪随机锥形散射、重力加速度与线性空气阻尼
// - 生命周期尺寸插值（StartSize -> EndSize）与淡出 Alpha 曲线
public class ParticleEmitterConfig3D {
    public int MaxParticles;
    public float EmitRatePerSec;
    public float LifetimeSec;
    public float InitialSpeed;
    public float SpreadRadius;
    public float GravityY;
    public float Drag;
    public float StartSize;
    public float EndSize;

    public ParticleEmitterConfig3D() {
        this.MaxParticles = 64;
        this.EmitRatePerSec = 20.0f;
        this.LifetimeSec = 1.0f;
        this.InitialSpeed = 4.0f;
        this.SpreadRadius = 0.5f;
        this.GravityY = -9.8f;
        this.Drag = 0.5f;
        this.StartSize = 0.4f;
        this.EndSize = 0.1f;
    }
}

// 池化单颗 3D 广告牌粒子状态。
public class BillboardParticle3D {
    public bool Alive;
    public Vector3 Position;
    public Vector3 Velocity;
    public float Age;
    public float Lifetime;
    public float Size;
    public float Alpha;

    public BillboardParticle3D() {
        this.Alive = false;
        this.Position = new Vector3(0.0f, 0.0f, 0.0f);
        this.Velocity = new Vector3(0.0f, 0.0f, 0.0f);
        this.Age = 0.0f;
        this.Lifetime = 1.0f;
        this.Size = 0.25f;
        this.Alpha = 0.0f;
    }
}

// 3D 广告牌粒子系统：固定容量对象池复用、确定性 LCG 散射、步进模拟与面向相机的广告牌网格构建。
public class ParticleSystem3D {
    public ParticleEmitterConfig3D Config;
    public Vector3 Origin;
    private List<BillboardParticle3D> pool;
    private float emitAccumulator;
    private int rngState;

    public ParticleSystem3D(ParticleEmitterConfig3D config, int seed) {
        this.Config = config != null ? config : new ParticleEmitterConfig3D();
        this.Origin = new Vector3(0.0f, 0.0f, 0.0f);
        this.emitAccumulator = 0.0f;
        this.rngState = seed != 0 ? seed : 1337;
        this.pool = new List<BillboardParticle3D>();
        int cap = this.Config.MaxParticles > 0 ? this.Config.MaxParticles : 32;
        for (int i = 0; i < cap; i = i + 1) {
            this.pool.Add(new BillboardParticle3D());
        }
    }

    public int PoolCapacity() {
        return this.pool.Count;
    }

    public int ActiveCount() {
        int c = 0;
        for (int i = 0; i < this.pool.Count; i = i + 1) {
            if (this.pool[i].Alive) { c = c + 1; }
        }
        return c;
    }

    private float NextSignedUnit() {
        // 确定性 LCG（避免 int 溢出依赖，映射到 [-1, 1]）
        this.rngState = (this.rngState * 1103515245 + 12345) & 2147483647;
        float u = (float)(this.rngState % 10000) / 5000.0f;
        return u - 1.0f;
    }

    public bool EmitOne() {
        for (int i = 0; i < this.pool.Count; i = i + 1) {
            BillboardParticle3D p = this.pool[i];
            if (!p.Alive) {
                float sx = this.NextSignedUnit() * this.Config.SpreadRadius;
                float sz = this.NextSignedUnit() * this.Config.SpreadRadius;
                p.Alive = true;
                p.Position = this.Origin;
                p.Velocity = new Vector3(sx * this.Config.InitialSpeed, this.Config.InitialSpeed, sz * this.Config.InitialSpeed);
                p.Age = 0.0f;
                p.Lifetime = this.Config.LifetimeSec > 0.01f ? this.Config.LifetimeSec : 0.5f;
                p.Size = this.Config.StartSize;
                p.Alpha = 1.0f;
                return true;
            }
        }
        return false;
    }

    public int Burst(int count) {
        int emitted = 0;
        for (int i = 0; i < count; i = i + 1) {
            if (this.EmitOne()) { emitted = emitted + 1; }
        }
        return emitted;
    }

    public void Update(float dt, bool emitting) {
        if (dt <= 0.0f) { return; }
        if (emitting && this.Config.EmitRatePerSec > 0.0f) {
            this.emitAccumulator = this.emitAccumulator + dt * this.Config.EmitRatePerSec;
            while (this.emitAccumulator >= 1.0f) {
                this.emitAccumulator = this.emitAccumulator - 1.0f;
                if (!this.EmitOne()) { break; }
            }
        }
        float damp = 1.0f - this.Config.Drag * dt;
        if (damp < 0.0f) { damp = 0.0f; }

        for (int i = 0; i < this.pool.Count; i = i + 1) {
            BillboardParticle3D p = this.pool[i];
            if (!p.Alive) { continue; }
            p.Age = p.Age + dt;
            if (p.Age >= p.Lifetime) {
                p.Alive = false;
                p.Alpha = 0.0f;
                continue;
            }
            float vx = p.Velocity.X * damp;
            float vy = (p.Velocity.Y + this.Config.GravityY * dt) * damp;
            float vz = p.Velocity.Z * damp;
            p.Velocity = new Vector3(vx, vy, vz);
            p.Position = new Vector3(
                p.Position.X + vx * dt,
                p.Position.Y + vy * dt,
                p.Position.Z + vz * dt);
            float t = p.Age / p.Lifetime;
            p.Size = this.Config.StartSize + (this.Config.EndSize - this.Config.StartSize) * t;
            p.Alpha = 1.0f - t;
        }
    }

    // 面向相机基向量构建所有存活粒子的广告牌动态 Mesh3D（每粒子 4 顶点 2 三角形）。
    public Mesh3D BuildBillboardMesh(Vector3 camRight, Vector3 camUp, Vector3 camForward) {
        Mesh3D mesh = new Mesh3D();
        float nx = -camForward.X;
        float ny = -camForward.Y;
        float nz = -camForward.Z;
        int baseIdx = 0;
        for (int i = 0; i < this.pool.Count; i = i + 1) {
            BillboardParticle3D p = this.pool[i];
            if (!p.Alive) { continue; }
            float half = p.Size * 0.5f;
            float rx = camRight.X * half;
            float ry = camRight.Y * half;
            float rz = camRight.Z * half;
            float ux = camUp.X * half;
            float uy = camUp.Y * half;
            float uz = camUp.Z * half;
            Vector3 c = p.Position;
            mesh.Vertex(c.X - rx - ux, c.Y - ry - uy, c.Z - rz - uz, nx, ny, nz, 0.0f, 1.0f);
            mesh.Vertex(c.X + rx - ux, c.Y + ry - uy, c.Z + rz - uz, nx, ny, nz, 1.0f, 1.0f);
            mesh.Vertex(c.X + rx + ux, c.Y + ry + uy, c.Z + rz + uz, nx, ny, nz, 1.0f, 0.0f);
            mesh.Vertex(c.X - rx + ux, c.Y - ry + uy, c.Z - rz + uz, nx, ny, nz, 0.0f, 0.0f);
            mesh.Triangle(baseIdx + 0, baseIdx + 1, baseIdx + 2);
            mesh.Triangle(baseIdx + 0, baseIdx + 2, baseIdx + 3);
            baseIdx = baseIdx + 4;
        }
        return mesh;
    }
}
