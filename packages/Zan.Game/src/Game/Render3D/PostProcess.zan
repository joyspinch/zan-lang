using System;
using System.Numerics;

namespace Game.Render3D;

// 后处理参数（同时支持 CPU 计划层逐物计算与 Renderer3D GPU 全屏后处理 Pass）：
// 涵盖曝光（Exposure）、Reinhard/ACES Filmic 色调映射、线性雾、径向暗角（Vignette）与亮部高光泛光（Bloom）。
public class PostProcess {
    // 曝光（乘在颜色上，1 = 不变）。
    public float Exposure;
    // 色调映射方式。
    public TonemapKind Tonemap;
    // 雾色（线性 0..1）。
    public float FogRed;
    public float FogGreen;
    public float FogBlue;
    // 雾密度（按视深指数衰减，0 = 无雾）。
    public float FogDensity;
    // 暗角强度（屏幕空间，当前不参与计算）。
    public float VignetteStrength;
    // 泛光阈值（屏幕空间，当前不参与计算）。
    public float BloomThreshold;
    // 泛光强度（屏幕空间）。
    public float BloomIntensity;
    // GPU 调色：饱和度（0=黑白, 1=原色, >1 增艳）、对比度（1=原对比度）、色偏滤镜 RGB。
    public float Saturation;
    public float Contrast;
    public float TintRed;
    public float TintGreen;
    public float TintBlue;
    // GPU FXAA 抗锯齿强度（0..1）与径向色差镜头强度（0..0.1，用于受击/冲刺/低血反馈）。
    public float FxaaStrength;
    public float ChromaticAberration;
    // GPU 后处理边缘锐化（0..2）与胶片颗粒（0..0.5，含逐帧随机种子 FilmGrainSeed）。
    public float SharpenStrength;
    public float FilmGrainStrength;
    public float FilmGrainSeed;
    // GPU 电影宽银幕黑边（LetterboxRatio 0..0.45）与水下/热浪屏幕波纹畸变（WaveDistortAmplitude 0..0.08）。
    public float LetterboxRatio;
    public float WaveDistortAmplitude;
    public float WaveDistortFrequency;
    public float WaveDistortPhase;
    // GPU 径向冲刺/受击缩放模糊（RadialBlurStrength 0..0.15，聚焦中心 UV 0..1）。
    public float RadialBlurStrength;
    public float RadialBlurCenterX;
    public float RadialBlurCenterY;
    // GPU 复古像素化马赛克尺寸（>= 1.5 开启，单位像素）与色阶量化级数（>= 2 开启，0 关闭）。
    public float PixelateSize;
    public float PosterizeLevels;
    // GPU 双色调渐变映射（夜视仪/热成像/棕褐复古，DuotoneStrength 0..1 控制混合强度）。
    public float DuotoneStrength;
    public float DuotoneDarkRed;
    public float DuotoneDarkGreen;
    public float DuotoneDarkBlue;
    public float DuotoneLightRed;
    public float DuotoneLightGreen;
    public float DuotoneLightBlue;
    // GPU 复古 CRT 扫描线与曲面桶形畸变（CrtScanlineIntensity 0..0.95, CrtCurvature 0..0.5）。
    public float CrtScanlineIntensity;
    public float CrtScanlineCount;
    public float CrtCurvature;
    public float CrtGlowBoost;
    // GPU 屏幕空间 Sobel 边缘描边（OutlineStrength 0..1, OutlineThreshold 0.02..1）。
    public float OutlineStrength;
    public float OutlineThreshold;
    public float OutlineRed;
    public float OutlineGreen;
    public float OutlineBlue;
    // GPU 红外热成像伪彩视图（ThermalStrength 0..1, ThermalSensitivity 0.1..5, ThermalColdShift -0.5..0.5）。
    public float ThermalStrength;
    public float ThermalSensitivity;
    public float ThermalColdShift;
    // GPU 屏幕边缘受击红晕与全屏闪光弹致盲叠加（ScreenEdgeTintStrength / ScreenFlashStrength 0..1）。
    public float ScreenEdgeTintStrength;
    public float ScreenFlashStrength;
    public float ScreenFlashRed;
    public float ScreenFlashGreen;
    public float ScreenFlashBlue;
    // GPU 战术夜视仪（NVG P43 绿磷增益 + 圆形目镜遮罩 + 闪烁噪点）。
    public float NightVisionStrength;
    public float NightVisionGain;
    public float NightVisionNoise;
    public float NightVisionSeed;
    // GPU 后处理 45° 半色调漫画网点滤镜（HalftoneStrength 0..1）。
    public float HalftoneStrength;
    public float HalftoneDotScale;
    public float HalftoneContrast;
    // GPU 后处理赛博故障水平撕裂与 RGB 通道分离（GlitchIntensity 0..1）。
    public float GlitchIntensity;
    public float GlitchSliceCount;
    public float GlitchSeed;
    // GPU 后处理微缩移轴景深模糊（TiltShiftStrength 0..1）。
    public float TiltShiftStrength;
    public float TiltShiftFocusY;
    public float TiltShiftFocusBand;
    // GPU 后处理屏幕边缘冰晶霜冻（FrostIntensity 0..1）。
    public float FrostIntensity;
    public float FrostRadius;
    public float FrostRed;
    public float FrostGreen;
    public float FrostBlue;
    // GPU 后处理复古怀旧棕褐色调与胶片划痕（SepiaStrength 0..1）。
    public float SepiaStrength;
    public float SepiaScratchAmount;
    public float SepiaSeed;
    // GPU 后处理变形宽银幕水平镜头炫光条纹（SunStreakStrength 0..3）。
    public float SunStreakStrength;
    public float SunStreakThreshold;
    public float SunStreakRed;
    public float SunStreakGreen;
    public float SunStreakBlue;
    // GPU 后处理电影级阴影/高光分离色调（SplitToneStrength 0..1，SplitToneBalance -1..1）。
    public float SplitToneStrength;
    public float SplitToneBalance;
    public float SplitShadowRed;
    public float SplitShadowGreen;
    public float SplitShadowBlue;
    public float SplitHighRed;
    public float SplitHighGreen;
    public float SplitHighBlue;

    public PostProcess() {
        this.Exposure = 1.0f;
        this.Tonemap = TonemapKind.None;
        this.FogRed = 0.0f;
        this.FogGreen = 0.0f;
        this.FogBlue = 0.0f;
        this.FogDensity = 0.0f;
        this.VignetteStrength = 0.0f;
        this.BloomThreshold = 1.0f;
        this.BloomIntensity = 0.0f;
        this.Saturation = 1.0f;
        this.Contrast = 1.0f;
        this.TintRed = 1.0f;
        this.TintGreen = 1.0f;
        this.TintBlue = 1.0f;
        this.FxaaStrength = 0.0f;
        this.ChromaticAberration = 0.0f;
        this.SharpenStrength = 0.0f;
        this.FilmGrainStrength = 0.0f;
        this.FilmGrainSeed = 0.0f;
        this.LetterboxRatio = 0.0f;
        this.WaveDistortAmplitude = 0.0f;
        this.WaveDistortFrequency = 16.0f;
        this.WaveDistortPhase = 0.0f;
        this.RadialBlurStrength = 0.0f;
        this.RadialBlurCenterX = 0.5f;
        this.RadialBlurCenterY = 0.5f;
        this.PixelateSize = 0.0f;
        this.PosterizeLevels = 0.0f;
        this.DuotoneStrength = 0.0f;
        this.DuotoneDarkRed = 0.0f;
        this.DuotoneDarkGreen = 0.05f;
        this.DuotoneDarkBlue = 0.0f;
        this.DuotoneLightRed = 0.2f;
        this.DuotoneLightGreen = 1.0f;
        this.DuotoneLightBlue = 0.35f;
        this.CrtScanlineIntensity = 0.0f;
        this.CrtScanlineCount = 64.0f;
        this.CrtCurvature = 0.0f;
        this.CrtGlowBoost = 1.0f;
        this.OutlineStrength = 0.0f;
        this.OutlineThreshold = 0.2f;
        this.OutlineRed = 0.0f;
        this.OutlineGreen = 0.0f;
        this.OutlineBlue = 0.0f;
        this.ThermalStrength = 0.0f;
        this.ThermalSensitivity = 1.0f;
        this.ThermalColdShift = 0.0f;
        this.ScreenEdgeTintStrength = 0.0f;
        this.ScreenFlashStrength = 0.0f;
        this.ScreenFlashRed = 1.0f;
        this.ScreenFlashGreen = 0.05f;
        this.ScreenFlashBlue = 0.05f;
        this.NightVisionStrength = 0.0f;
        this.NightVisionGain = 3.0f;
        this.NightVisionNoise = 0.06f;
        this.NightVisionSeed = 0.0f;
        this.HalftoneStrength = 0.0f;
        this.HalftoneDotScale = 6.0f;
        this.HalftoneContrast = 1.0f;
        this.GlitchIntensity = 0.0f;
        this.GlitchSliceCount = 24.0f;
        this.GlitchSeed = 0.0f;
        this.TiltShiftStrength = 0.0f;
        this.TiltShiftFocusY = 0.5f;
        this.TiltShiftFocusBand = 0.15f;
        this.FrostIntensity = 0.0f;
        this.FrostRadius = 0.45f;
        this.FrostRed = 0.55f;
        this.FrostGreen = 0.88f;
        this.FrostBlue = 1.0f;
        this.SepiaStrength = 0.0f;
        this.SepiaScratchAmount = 0.0f;
        this.SepiaSeed = 0.0f;
        this.SunStreakStrength = 0.0f;
        this.SunStreakThreshold = 0.75f;
        this.SunStreakRed = 0.25f;
        this.SunStreakGreen = 0.78f;
        this.SunStreakBlue = 1.0f;
        this.SplitToneStrength = 0.0f;
        this.SplitToneBalance = 0.0f;
        this.SplitShadowRed = 0.05f;
        this.SplitShadowGreen = 0.35f;
        this.SplitShadowBlue = 0.95f;
        this.SplitHighRed = 1.0f;
        this.SplitHighGreen = 0.58f;
        this.SplitHighBlue = 0.15f;
    }

    // 应用后处理：曝光 → 雾（线性空间按视深混合）→ 色调映射 → 钳位。
    // depth 是沿视线方向的正距离（相机背后的物体为负，按 0 处理）。
    public void Apply(float red, float green, float blue, float depth,
                      out float outRed, out float outGreen, out float outBlue) {
        float r = red * this.Exposure;
        float g = green * this.Exposure;
        float b = blue * this.Exposure;

        if (this.FogDensity > 0.0f) {
            float d = depth > 0.0f ? depth : 0.0f;
            float f = 1.0f - (float)MathUtil.Exp(
                                -(double)(this.FogDensity * d));
            if (f < 0.0f) { f = 0.0f; }
            if (f > 1.0f) { f = 1.0f; }
            r = r + (this.FogRed - r) * f;
            g = g + (this.FogGreen - g) * f;
            b = b + (this.FogBlue - b) * f;
        }

        if (this.Tonemap == TonemapKind.Reinhard) {
            r = r / (1.0f + r);
            g = g / (1.0f + g);
            b = b / (1.0f + b);
        } else if (this.Tonemap == TonemapKind.Aces) {
            r = AcesCurve(r);
            g = AcesCurve(g);
            b = AcesCurve(b);
        }

        outRed = Clamp01(r);
        outGreen = Clamp01(g);
        outBlue = Clamp01(b);
    }

    private static float AcesCurve(float x) {
        if (x < 0.0f) { x = 0.0f; }
        return (x * (2.51f * x + 0.03f)) / (x * (2.43f * x + 0.59f) + 0.14f);
    }

    // 是否有需要触发 GPU 全屏后处理 Pass 的有效配置。
    public bool HasGpuPassEffect() {
        float dExp = this.Exposure - 1.0f;
        if (dExp < 0.0f) { dExp = 0.0f - dExp; }
        float dSat = this.Saturation - 1.0f;
        if (dSat < 0.0f) { dSat = 0.0f - dSat; }
        float dCon = this.Contrast - 1.0f;
        if (dCon < 0.0f) { dCon = 0.0f - dCon; }
        float dTr = this.TintRed - 1.0f;
        if (dTr < 0.0f) { dTr = 0.0f - dTr; }
        float dTg = this.TintGreen - 1.0f;
        if (dTg < 0.0f) { dTg = 0.0f - dTg; }
        float dTb = this.TintBlue - 1.0f;
        if (dTb < 0.0f) { dTb = 0.0f - dTb; }
        return dExp > 0.001f
            || dSat > 0.001f
            || dCon > 0.001f
            || dTr > 0.001f || dTg > 0.001f || dTb > 0.001f
            || this.Tonemap == TonemapKind.Reinhard
            || this.Tonemap == TonemapKind.Aces
            || this.VignetteStrength > 0.001f
            || this.BloomIntensity > 0.001f
            || this.FxaaStrength > 0.001f
            || this.ChromaticAberration > 0.0002f
            || this.SharpenStrength > 0.001f
            || this.FilmGrainStrength > 0.0005f
            || this.LetterboxRatio > 0.0005f
            || this.WaveDistortAmplitude > 0.0001f
            || this.RadialBlurStrength > 0.0005f
            || this.PixelateSize >= 1.5f
            || this.PosterizeLevels >= 2.0f
            || this.DuotoneStrength > 0.0005f
            || this.CrtScanlineIntensity > 0.0005f
            || this.CrtCurvature > 0.0005f
            || this.OutlineStrength > 0.0005f
            || this.ThermalStrength > 0.0005f
            || this.ScreenEdgeTintStrength > 0.0005f
            || this.ScreenFlashStrength > 0.0005f
            || this.NightVisionStrength > 0.0005f
            || this.HalftoneStrength > 0.0005f
            || this.GlitchIntensity > 0.0005f
            || this.TiltShiftStrength > 0.0005f
            || this.FrostIntensity > 0.0005f
            || this.SepiaStrength > 0.0005f
            || this.SunStreakStrength > 0.0005f
            || this.SplitToneStrength > 0.0005f;
    }

    private static float Clamp01(float value) {
        if (value < 0.0f) { return 0.0f; }
        if (value > 1.0f) { return 1.0f; }
        return value;
    }
}
