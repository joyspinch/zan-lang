using System;

namespace Game.Arpg;

// 类型化运行时发出的游戏玩法事件（物品增减/使用、技能结算、
// buff 变化、伤害与死亡、切图）。同样单播，框架在世界更新时
// 自动触发；经 Engine.GameplayEvents() 获取。
public class ArpgGameplayEvents {
    public ArpgItemChanged itemChanged;
    public ArpgItemUsed itemUsed;
    public ArpgSkillResolved skillResolved;
    public ArpgBuffChanged buffChanged;
    public ArpgActorDamaged actorDamaged;
    public ArpgActorDied actorDied;
    public ArpgMapChanged mapChanged;


    // 注册物品增减回调（quantity 为该物品当前持有总量）。
    public void OnItemChanged(ArpgItemChanged handler) {
        this.itemChanged = handler;
    }
    // 注册物品使用回调。
    public void OnItemUsed(ArpgItemUsed handler) { this.itemUsed = handler; }
    // 注册技能结算完成回调。
    public void OnSkillResolved(ArpgSkillResolved handler) {
        this.skillResolved = handler;
    }
    // 注册增益增删回调（added=true 添加）。
    public void OnBuffChanged(ArpgBuffChanged handler) {
        this.buffChanged = handler;
    }
    // 注册角色受伤回调（amount 为实际生效伤害）。
    public void OnActorDamaged(ArpgActorDamaged handler) {
        this.actorDamaged = handler;
    }
    // 注册角色死亡回调（killer 可为 null）。
    public void OnActorDied(ArpgActorDied handler) { this.actorDied = handler; }
    // 注册切图完成回调（首次进图 previousMapId 为空串）。
    public void OnMapChanged(ArpgMapChanged handler) { this.mapChanged = handler; }

    // 触发物品增减回调（未注册为空操作）。
    public void RaiseItemChanged(
        ArpgActor actor,
        ArpgItemDefinition item,
        int quantity
    ) {
        ArpgItemChanged handler = this.itemChanged;
        if (handler != null) {
            handler(actor, item, quantity);
        }
    }

    // 触发物品使用回调（未注册为空操作）。
    public void RaiseItemUsed(ArpgActor actor, ArpgItemDefinition item) {
        ArpgItemUsed handler = this.itemUsed;
        if (handler != null) { handler(actor, item); }
    }

    // 触发技能结算回调（未注册为空操作）。
    public void RaiseSkillResolved(ArpgSkillCastResult result) {
        ArpgSkillResolved handler = this.skillResolved;
        if (handler != null) { handler(result); }
    }

    // 触发增益增删回调（未注册为空操作）。
    public void RaiseBuffChanged(
        ArpgActor actor,
        ArpgBuffInstance buff,
        bool added
    ) {
        ArpgBuffChanged handler = this.buffChanged;
        if (handler != null) {
            handler(actor, buff, added);
        }
    }

    // 触发角色受伤回调（未注册为空操作）。
    public void RaiseActorDamaged(
        ArpgActor source,
        ArpgActor target,
        double amount,
        bool critical
    ) {
        ArpgActorDamaged handler = this.actorDamaged;
        if (handler != null) {
            handler(source, target, amount, critical);
        }
    }

    // 触发角色死亡回调（未注册为空操作）。
    public void RaiseActorDied(ArpgActor actor, ArpgActor killer) {
        ArpgActorDied handler = this.actorDied;
        if (handler != null) { handler(actor, killer); }
    }

    // 触发切图完成回调（未注册为空操作）。
    public void RaiseMapChanged(
        string previousMapId,
        string currentMapId,
        int portalId
    ) {
        ArpgMapChanged handler = this.mapChanged;
        if (handler != null) {
            handler(previousMapId, currentMapId, portalId);
        }
    }
}
