using System;

namespace Game.Arpg;

// UI 节点运行时实例：由 ArpgNodeDefinition 构造，包装定义并提供
// 求值后的内容/富文本文档、动画播放状态与指针命中测试。大部分
// 属性读取透传定义；Content() 返回模板求值后的文本，Resource()
// 在动画节点上返回当前帧资源。构造时即触发 Created 事件。
public class ArpgNode {
    public ArpgNodeDefinition definition;
    public ArpgDataSource dataSource;
    public string evaluatedContent;
    public ArpgRichTextDocument document;
    public bool focused;
    public bool inheritedDataSource;
    public bool playing;
    public int frameIndex;
    public int frameElapsed;

    // 构造节点实例；defaultSource 为定义未绑定数据源时的继承来源，构造即触发 Created 事件。
    public ArpgNode(
        ArpgNodeDefinition definition,
        ArpgDataSource defaultSource
    ) {
        this.definition = definition;
        this.dataSource = definition.DataSource();
        this.inheritedDataSource = this.dataSource == null;
        if (this.inheritedDataSource) { this.dataSource = defaultSource; }
        this.evaluatedContent = "";
        this.document = new ArpgRichTextDocument("");
        this.focused = false;
        this.playing = definition.AutoPlay();
        this.frameIndex = 0;
        this.frameElapsed = 0;
        this.Evaluate();
        definition.Events().RaiseCreated(this.Id());
    }

    // 返回节点唯一 Id（同定义 Id）。
    public string Id() { return this.definition.Id(); }
    // 返回节点类型字符串。
    public string Kind() { return this.definition.Kind(); }
    // 返回节点 X 坐标（像素，相对控件原点）。
    public int X() { return this.definition.X(); }
    // 返回节点 Y 坐标（像素，相对控件原点）。
    public int Y() { return this.definition.Y(); }
    // 返回节点宽度（像素）。
    public int Width() { return this.definition.Width(); }
    // 返回节点高度（像素）。
    public int Height() { return this.definition.Height(); }
    // 返回绘制顺序；数值大者在上层。
    public int Order() { return this.definition.Order(); }
    // 返回节点是否可见。
    public bool Visible() { return this.definition.Visible(); }
    // 返回节点是否接收鼠标事件。
    public bool MouseEvents() { return this.definition.MouseEvents(); }
    // 返回水平锚点（0=左缘，1=右缘）。
    public double AnchorX() { return this.definition.AnchorX(); }
    // 返回垂直锚点（0=上缘，1=下缘）。
    public double AnchorY() { return this.definition.AnchorY(); }
    // 返回水平缩放系数。
    public double ScaleX() { return this.definition.ScaleX(); }
    // 返回垂直缩放系数。
    public double ScaleY() { return this.definition.ScaleY(); }
    // 返回旋转角度（度，顺时针）。
    public int Angle() { return this.definition.Angle(); }
    // 返回不透明度（0.0~1.0）。
    public double Opacity() { return this.definition.Opacity(); }
    // 返回是否把内容裁剪到节点边界内。
    public bool Clip() { return this.definition.Clip(); }
    // 返回模板求值后的文本内容（含 AppendContent 追加部分在控件层才生效，节点层仅定义内容求值）。
    public string Content() { return this.evaluatedContent; }
    // 返回当前生效的资源 Id：动画节点返回当前帧资源，其他节点返回定义资源。
    public string Resource() {
        if (this.definition.AnimationFrameCount() > 0) {
            return this.definition.AnimationFrameAt(this.frameIndex);
        }
        return this.definition.Resource();
    }
    // 返回前景/文字颜色。
    public ArpgColor Color() { return this.definition.Color(); }
    // 返回背景色。
    public ArpgColor BackgroundColor() {
        return this.definition.BackgroundColor();
    }
    // 返回边框颜色。
    public ArpgColor BorderColor() { return this.definition.BorderColor(); }
    // 返回描边颜色（仅 ArtText 使用）。
    public ArpgColor OutlineColor() { return this.definition.OutlineColor(); }
    // 返回边框宽度（像素）。
    public int BorderWidth() { return this.definition.BorderWidth(); }
    // 返回圆角半径（像素）。
    public int Radius() { return this.definition.Radius(); }
    // 返回字体大小（像素）。
    public int FontSize() { return this.definition.FontSize(); }
    // 返回水平对齐（ArpgTextAlign 常量）。
    public int HorizontalAlign() { return this.definition.HorizontalAlign(); }
    // 返回垂直对齐（ArpgTextAlign 常量）。
    public int VerticalAlign() { return this.definition.VerticalAlign(); }
    // 返回文本是否自动换行。
    public bool Wrap() { return this.definition.Wrap(); }
    // 返回行间距（像素）。
    public int LineSpacing() { return this.definition.LineSpacing(); }
    // 返回九宫格描述；未设置时为 null。
    public ArpgNineSlice NineSlice() { return this.definition.NineSlice(); }
    // 返回动画是否正在播放。
    public bool Playing() { return this.playing; }
    // 返回当前动画帧索引（从 0 开始）。
    public int FrameIndex() { return this.frameIndex; }
    // 返回求值后的富文本文档（非富文本节点为单 run 文档）。
    public ArpgRichTextDocument Document() { return this.document; }
    // 返回节点事件槽位集合（单播）。
    public ArpgNodeEventHandlers Events() { return this.definition.Events(); }
    // 返回节点当前生效的数据源（私有的或继承的）。
    public ArpgDataSource DataSource() { return this.dataSource; }
    // 返回节点是否正在使用继承来的数据源（定义未绑定私有数据源时为 true）。
    public bool UsesInheritedDataSource() { return this.inheritedDataSource; }

    // 设置节点私有数据源并立即重新求值内容；之后不再继承。
    public void SetDataSource(ArpgDataSource newValue) {
        this.dataSource = newValue;
        this.inheritedDataSource = false;
        this.Evaluate();
    }

    // 设置继承数据源并立即重新求值内容（继承标记保持为 true）。
    public void SetInheritedDataSource(ArpgDataSource newValue) {
        this.dataSource = newValue;
        this.inheritedDataSource = true;
        this.Evaluate();
    }

    // 重新求值内容：模板占位符按当前数据源替换，富文本节点重新解析文档；框架每帧调用，业务一般无需手动调用。
    public void Evaluate() {
        this.evaluatedContent = ArpgTemplate.Evaluate(
            this.definition.Content(), this.dataSource);
        if (this.definition.RichText()) {
            this.document = ArpgRichText.Parse(
                this.definition.Content(), this.dataSource);
        } else {
            this.document = new ArpgRichTextDocument(
                this.evaluatedContent);
            if (this.evaluatedContent != "") {
                ArpgRichTextRun run =
                    ArpgRichTextRun.CreateText(this.evaluatedContent);
                this.document.Add(run);
            }
        }
    }

    // 每帧推进：重新求值内容，并按帧率推进动画帧（到末尾时按 LoopAnimation 循环或停在最后一帧）；随后触发 Updated 事件。
    public void Update(int deltaMilliseconds) {
        this.Evaluate();
        if (this.Kind() == ArpgNodeKind.Animation()
            && this.playing
            && this.definition.AnimationFrameCount() > 1) {
            this.frameElapsed = this.frameElapsed + deltaMilliseconds;
            int frameTime = 1000 / this.definition.FrameRate();
            while (this.frameElapsed >= frameTime) {
                this.frameElapsed = this.frameElapsed - frameTime;
                this.frameIndex = this.frameIndex + 1;
                if (this.frameIndex >= this.definition.AnimationFrameCount()) {
                    if (this.definition.LoopAnimation()) {
                        this.frameIndex = 0;
                    } else {
                        this.frameIndex =
                            this.definition.AnimationFrameCount() - 1;
                        this.playing = false;
                    }
                }
            }
        }
        this.definition.Events().RaiseUpdated(this.Id(), deltaMilliseconds);
    }

    // 恢复动画播放。
    public void Play() { this.playing = true; }
    // 暂停动画（停在当前帧）。
    public void Pause() { this.playing = false; }
    // 把动画重置回第 0 帧（不改变播放状态）。
    public void ResetAnimation() {
        this.frameIndex = 0;
        this.frameElapsed = 0;
    }

    // 命中测试：localX/localY 为节点局部坐标（相对节点原点），可见节点按缩放与锚点计算的实际矩形判断，命中返回 true。
    public bool HitTest(double localX, double localY) {
        double width = (double)this.Width() * this.ScaleX();
        double height = (double)this.Height() * this.ScaleY();
        double x = (double)this.X() - width * this.AnchorX();
        double y = (double)this.Y() - height * this.AnchorY();
        return this.Visible()
            && localX >= x
            && localY >= y
            && localX < x + width
            && localY < y + height;
    }

    // 设置焦点状态；变化时触发 FocusChanged 事件，不变时为空操作。
    public void SetFocused(bool newValue) {
        if (this.focused == newValue) { return; }
        this.focused = newValue;
        this.definition.Events().RaiseFocusChanged(this.Id(), newValue);
    }

    // 触发节点自定义事件（payload 原样透传给 OnCustomEvent 注册的 handler）。
    public void FireCustom(string name, string payload) {
        this.definition.Events().RaiseCustom(this.Id(), name, payload);
    }
}
