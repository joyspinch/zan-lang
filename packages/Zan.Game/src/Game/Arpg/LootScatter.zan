using System;

namespace Game.Arpg;

// 经典 ARPG 爆装与金币四散飞出弹跳物理系统（“怪物大爆”）。
// 模拟物品从怪物体内向四周抛射、在重力作用下抛物线运动并在地面多次弹性跳跃落地的全套真实物理轨迹。
class LootScatter {
    int capacity;
    int activeCount;

    bool[] active;
    int[] itemIds;
    int[] itemTypes;  // 0:金币, 1:药水, 2:普通装备, 3:极品神装
    double[] posX;  // 世界地表 X
    double[] posY;  // 世界地表 Y
    double[] posZ;  // 距离地面的浮空高度 Z (像素)
    double[] velX;  // 水平速度 X
    double[] velY;  // 水平速度 Y
    double[] velZ;  // 垂直向上的弹跳速度 Z
    int[] bounceCount;  // 剩余弹跳次数
    bool[] isSettled;  // 是否已平稳落地可拾取
    Random rnd;

    // 空闲槽位栈与运动项紧凑表：Burst O(1) 取槽、Update O(movingCount) 仅迭代空中弹跳物品
    int[] freeStack;
    int freeTop;
    int[] movingList;
    int[] movingPos;
    int movingCount;

    LootScatter(int cap) {
        this.capacity = cap > 0 ? cap : 512;
        this.activeCount = 0;
        this.rnd = new Random();

        this.active = new bool[capacity];
        this.itemIds = new int[capacity];
        this.itemTypes = new int[capacity];
        this.posX = new double[capacity];
        this.posY = new double[capacity];
        this.posZ = new double[capacity];
        this.velX = new double[capacity];
        this.velY = new double[capacity];
        this.velZ = new double[capacity];
        this.bounceCount = new int[capacity];
        this.isSettled = new bool[capacity];

        this.freeStack = new int[capacity];
        this.movingList = new int[capacity];
        this.movingPos = new int[capacity];
        for (int i = 0; i < capacity; i = i + 1) {
            this.freeStack[i] = capacity - 1 - i;
            this.movingPos[i] = -1;
        }
        this.freeTop = capacity;
        this.movingCount = 0;
    }

    static LootScatter Create(int cap) {
        return new LootScatter(cap);
    }

    int ActiveCount { get { return activeCount; } }
    bool IsActive(int idx) { return active[idx]; }
    bool IsSettled(int idx) { return isSettled[idx]; }
    double GetX(int idx) { return posX[idx]; }
    double GetY(int idx) { return posY[idx] - posZ[idx]; }  // 屏幕渲染坐标加上高度 Z 偏移
    double GetGroundY(int idx) { return posY[idx]; }
    int GetType(int idx) { return itemTypes[idx]; }
    int GetItemId(int idx) { return itemIds[idx]; }

    // 在 (originX, originY) 处引爆多件战利品向四周喷射。
    void Burst(double originX, double originY, int count, int startItemId) {
        for (int i = 0; i < count; i = i + 1) {
            if (freeTop <= 0) { break; }
            freeTop = freeTop - 1;
            int slot = freeStack[freeTop];

            active[slot] = true;
            itemIds[slot] = startItemId + i;
            itemTypes[slot] = (i == 0) ? 3 : (i % 3);  // 第一件为极品神装
            posX[slot] = originX;
            posY[slot] = originY;
            posZ[slot] = 10.0;

            // 随机 360 度向外喷射
            double angle = (double)rnd.NextBelow(360) * 0.017453292519943295;
            double hSpeed = 80.0 + (double)rnd.NextBelow(160);  // 水平抛射速度
            velX[slot] = Math.Cos(angle) * hSpeed;
            velY[slot] = Math.Sin(angle) * hSpeed * 0.5;  // 椭圆等轴比例
            velZ[slot] = 180.0 + (double)rnd.NextBelow(120);  // 向上初速度
            bounceCount[slot] = 3;
            isSettled[slot] = false;

            movingPos[slot] = movingCount;
            movingList[movingCount] = slot;
            movingCount = movingCount + 1;

            activeCount = activeCount + 1;
        }
    }

    // 逐物理步长更新弹跳重力模拟。
    // 仅迭代处于空中弹跳状态的项（movingList），物品落地静止后 O(1) 移出。
    void Update(double dt) {
        double gravDt = 600.0 * dt;  // 重力步进加速度 (px/s^2 * dt)
        double damp = Math.Max(0.0, 1.0 - dt * 2.0);  // 水平滑行衰减系数

        int m = 0;
        while (m < movingCount) {
            int i = movingList[m];
            if (!active[i] || isSettled[i]) {
                int last = movingCount - 1;
                int moving = movingList[last];
                movingList[m] = moving;
                movingPos[moving] = m;
                movingPos[i] = -1;
                movingCount = last;
                continue;
            }

            // 水平滑行衰减
            posX[i] = posX[i] + velX[i] * dt;
            posY[i] = posY[i] + velY[i] * dt;
            velX[i] = velX[i] * damp;
            velY[i] = velY[i] * damp;

            // 垂直跳跃
            posZ[i] = posZ[i] + velZ[i] * dt;
            velZ[i] = velZ[i] - gravDt;

            // 触地检测
            if (posZ[i] <= 0.0) {
                posZ[i] = 0.0;
                if (bounceCount[i] > 0) {
                    bounceCount[i] = bounceCount[i] - 1;
                    velZ[i] = -velZ[i] * 0.45;  // 45% 弹性恢复系数
                    velX[i] = velX[i] * 0.6;
                    velY[i] = velY[i] * 0.6;
                    m = m + 1;
                } else {
                    // 彻底落地静止
                    velX[i] = 0.0;
                    velY[i] = 0.0;
                    velZ[i] = 0.0;
                    isSettled[i] = true;
                    // O(1) 移出 movingList
                    int last = movingCount - 1;
                    int moving = movingList[last];
                    movingList[m] = moving;
                    movingPos[moving] = m;
                    movingPos[i] = -1;
                    movingCount = last;
                }
            } else {
                m = m + 1;
            }
        }
    }

    // 拾取战利品。
    bool Collect(int slot) {
        if (slot >= 0 && slot < capacity && active[slot] && isSettled[slot]) {
            active[slot] = false;
            activeCount = activeCount - 1;
            freeStack[freeTop] = slot;
            freeTop = freeTop + 1;
            return true;
        }
        return false;
    }
}
