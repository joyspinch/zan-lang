using System;

namespace Game.Arpg;

// 文本对齐常量：Start=起始对齐（水平=左/垂直=顶），Center=居中，
// End=末尾对齐（水平=右/垂直=底）。用于 HorizontalAlign/
// VerticalAlign 风格属性与富文本排版。
class ArpgTextAlign {
    // 起始对齐（水平=左，垂直=顶）。
    static int Start() { return 0; }
    // 居中对齐。
    static int Center() { return 1; }
    // 末尾对齐（水平=右，垂直=底）。
    static int End() { return 2; }
}
