using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using Game.Arpg;

namespace Game.Arpg.Data;

[Table(Name = "zgm_save_slot")]
class ArpgSaveSlotEntity {
    [Id]
    [Column(Name = "slot")]
    public string slot;
    [Column(Name = "map_name")]
    public string map_name;
    [Column(Name = "hero_x")]
    public int hero_x;
    [Column(Name = "hero_y")]
    public int hero_y;
    [Column(Name = "hero_direction")]
    public int hero_direction;
    [Column(Name = "hero_level")]
    public int hero_level;
    [Column(Name = "hero_hp")]
    public int hero_hp;
    [Column(Name = "hero_mp")]
    public int hero_mp;
    [Column(Name = "hero_experience")]
    public int hero_experience;
    [Column(Name = "hero_rage")]
    public int hero_rage;
}

[Table(Name = "zgm_save_item")]
class ArpgSaveItemEntity {
    [Column(Name = "slot")]
    public string slot;
    [Column(Name = "item_name")]
    public string item_name;
    [Column(Name = "quantity")]
    public int quantity;
}

[Table(Name = "zgm_save_equipment")]
class ArpgSaveEquipmentEntity {
    [Column(Name = "slot")]
    public string slot;
    [Column(Name = "equip_slot")]
    public string equip_slot;
    [Column(Name = "item_name")]
    public string item_name;
}

[Table(Name = "zgm_save_skill")]
class ArpgSaveSkillEntity {
    [Column(Name = "slot")]
    public string slot;
    [Column(Name = "skill_name")]
    public string skill_name;
}

[Table(Name = "zgm_save_buff")]
class ArpgSaveBuffEntity {
    [Column(Name = "slot")]
    public string slot;
    [Column(Name = "buff_name")]
    public string buff_name;
    [Column(Name = "remaining")]
    public int remaining;
}

// 基于通用 SQLite 连接的 ZGM 原生存档仓库。
// 其结构由标准库 ORM 实体（ArpgSaveSlotEntity 等）与强类型表达式查询驱动，
// 涵盖主槽位及规范化的子表（背包、装备、已学技能与生效增益）。
// 完全杜绝手拼 SQL 字符串与裸 SQL 注入风险。
class ArpgSaveRepository {
    ArpgDatabase database;
    bool ready;

    // 在已打开的数据库上打开存档仓库：database 为 null 或未打开时
    // 返回 null，否则同步实体结构建表并返回仓库；IsReady() 反映就绪状态，
    // 未就绪时所有读写操作均失败。
    static ArpgSaveRepository Open(ArpgDatabase database) {
        if (database == null || !database.IsOpen()) { return null; }
        ArpgSaveRepository repository = new ArpgSaveRepository();
        repository.database = database;
        repository.ready = repository.Initialize();
        return repository;
    }

    // 便捷入口：从项目解析名为 componentName 的 Sqlite 组件并在其
    // 数据库文件 path 上打开存档仓库（组件缺失时返回 null）。
    static ArpgSaveRepository OpenProject(
        ArpgProject project,
        string componentName,
        string path
    ) {
        ArpgDatabase database = ArpgDatabase.OpenProject(
            project, componentName, path);
        return ArpgSaveRepository.Open(database);
    }

    // 建表与实体同步是否成功；为 false 时 Save/Load 等操作一律拒绝。
    bool IsReady() { return this.ready; }
    // 底层数据库连接。
    ArpgDatabase Database() { return this.database; }

    // 表 table 是否已存在列 column。
    bool HasColumn(string table, string column) {
        DbResult columns = this.database.Query(
            "PRAGMA table_info(" + table + ")");
        for (int i = 0; i < columns.RowCount(); i = i + 1) {
            if (columns.GetString(i, 1) == column) { return true; }
        }
        return false;
    }

    // 基于 ORM CodeFirst 自动同步并迁移全部存档表结构（含主槽表与四张子表），
    // 自动补齐缺失列，任一步失败返回 false。
    bool Initialize() {
        if (this.database == null || this.database.Conn() == null) { return false; }
        SqliteConnection db = this.database.Conn();
        db.SyncStructure<ArpgSaveSlotEntity>();
        db.SyncStructure<ArpgSaveItemEntity>();
        db.SyncStructure<ArpgSaveEquipmentEntity>();
        db.SyncStructure<ArpgSaveSkillEntity>();
        db.SyncStructure<ArpgSaveBuffEntity>();
        return true;
    }

    // 将 state 覆写保存到槽位 slot：主行与四张子表在事务内先删后插，
    // 全部采用 ORM 强类型表达式与实体写入。未就绪、slot 为空串或 state 为 null 时
    // 直接返回 false。
    bool Save(string slot, ArpgSaveState state) {
        if (!this.ready || slot == "" || state == null) { return false; }
        SqliteConnection db = this.database.Conn();
        this.database.Begin();

        db.Delete<ArpgSaveSlotEntity>().Where(a => a.slot == slot).ExecuteAffrows();
        ArpgSaveSlotEntity slotEntity = new ArpgSaveSlotEntity();
        slotEntity.slot = slot;
        slotEntity.map_name = state.MapName();
        slotEntity.hero_x = state.HeroX();
        slotEntity.hero_y = state.HeroY();
        slotEntity.hero_direction = state.HeroDirection();
        slotEntity.hero_level = state.HeroLevel();
        slotEntity.hero_hp = state.HeroHp();
        slotEntity.hero_mp = state.HeroMp();
        slotEntity.hero_experience = state.HeroExperience();
        slotEntity.hero_rage = state.HeroRage();
        db.Insert<ArpgSaveSlotEntity>(slotEntity).ExecuteAffrows();

        db.Delete<ArpgSaveItemEntity>().Where(a => a.slot == slot).ExecuteAffrows();
        db.Delete<ArpgSaveEquipmentEntity>().Where(a => a.slot == slot).ExecuteAffrows();
        db.Delete<ArpgSaveSkillEntity>().Where(a => a.slot == slot).ExecuteAffrows();
        db.Delete<ArpgSaveBuffEntity>().Where(a => a.slot == slot).ExecuteAffrows();

        for (int i = 0; i < state.ItemCount(); i = i + 1) {
            ArpgSaveItem item = state.ItemAt(i);
            ArpgSaveItemEntity entity = new ArpgSaveItemEntity();
            entity.slot = slot;
            entity.item_name = item.Name();
            entity.quantity = item.Quantity();
            db.Insert<ArpgSaveItemEntity>(entity).ExecuteAffrows();
        }

        for (int i = 0; i < state.EquipmentCount(); i = i + 1) {
            ArpgSaveEquipment equip = state.EquipmentAt(i);
            ArpgSaveEquipmentEntity entity = new ArpgSaveEquipmentEntity();
            entity.slot = slot;
            entity.equip_slot = equip.Slot();
            entity.item_name = equip.ItemName();
            db.Insert<ArpgSaveEquipmentEntity>(entity).ExecuteAffrows();
        }

        for (int i = 0; i < state.SkillCount(); i = i + 1) {
            ArpgSaveSkill skill = state.SkillAt(i);
            ArpgSaveSkillEntity entity = new ArpgSaveSkillEntity();
            entity.slot = slot;
            entity.skill_name = skill.Name();
            db.Insert<ArpgSaveSkillEntity>(entity).ExecuteAffrows();
        }

        for (int i = 0; i < state.BuffCount(); i = i + 1) {
            ArpgSaveBuff buff = state.BuffAt(i);
            ArpgSaveBuffEntity entity = new ArpgSaveBuffEntity();
            entity.slot = slot;
            entity.buff_name = buff.Name();
            entity.remaining = buff.Remaining();
            db.Insert<ArpgSaveBuffEntity>(entity).ExecuteAffrows();
        }

        this.database.Commit();
        return true;
    }

    // 读取槽位 slot 为 ArpgSaveState：使用 ORM 强类型表达式查询。
    // 主行不存在、未就绪或 slot 为空串时返回 null。
    // 物品/装备/技能/增益子行分别按实体表达式排序读回。
    ArpgSaveState Load(string slot) {
        if (!this.ready || slot == "") { return null; }
        SqliteConnection db = this.database.Conn();
        ArpgSaveSlotEntity row = db.Select<ArpgSaveSlotEntity>()
            .Where(a => a.slot == slot)
            .First();
        if (row == null) { return null; }

        ArpgSaveState state = new ArpgSaveState(
            row.map_name,
            row.hero_x,
            row.hero_y,
            row.hero_direction,
            row.hero_level,
            row.hero_hp,
            row.hero_mp)
            .SetProgress(
                row.hero_experience,
                row.hero_rage);

        List<ArpgSaveItemEntity> items = db.Select<ArpgSaveItemEntity>()
            .Where(a => a.slot == slot)
            .OrderBy(a => a.item_name)
            .ToList();
        for (int i = 0; i < items.Count; i = i + 1) {
            state.AddItem(items[i].item_name, items[i].quantity);
        }

        List<ArpgSaveEquipmentEntity> equipment = db.Select<ArpgSaveEquipmentEntity>()
            .Where(a => a.slot == slot)
            .OrderBy(a => a.equip_slot)
            .ToList();
        for (int i = 0; i < equipment.Count; i = i + 1) {
            state.AddEquipment(equipment[i].equip_slot, equipment[i].item_name);
        }

        List<ArpgSaveSkillEntity> skills = db.Select<ArpgSaveSkillEntity>()
            .Where(a => a.slot == slot)
            .OrderBy(a => a.skill_name)
            .ToList();
        for (int i = 0; i < skills.Count; i = i + 1) {
            state.AddSkill(skills[i].skill_name);
        }

        List<ArpgSaveBuffEntity> buffs = db.Select<ArpgSaveBuffEntity>()
            .Where(a => a.slot == slot)
            .OrderBy(a => a.buff_name)
            .ToList();
        for (int i = 0; i < buffs.Count; i = i + 1) {
            state.AddBuff(buffs[i].buff_name, buffs[i].remaining);
        }

        return state;
    }

    // 槽位 slot 是否已有存档；未就绪或 slot 为空串时返回 false。
    bool Exists(string slot) {
        if (!this.ready || slot == "") { return false; }
        SqliteConnection db = this.database.Conn();
        return db.Select<ArpgSaveSlotEntity>().Where(a => a.slot == slot).Count() > 0;
    }

    // 删除槽位 slot：在一个事务内通过 ORM 表达式删除主行与全部子行。
    // 返回 true 表示槽位确实存在且已删除，槽位本不存在返回 false。
    bool Delete(string slot) {
        if (!this.ready || slot == "") { return false; }
        SqliteConnection db = this.database.Conn();
        this.database.Begin();
        db.Delete<ArpgSaveItemEntity>().Where(a => a.slot == slot).ExecuteAffrows();
        db.Delete<ArpgSaveEquipmentEntity>().Where(a => a.slot == slot).ExecuteAffrows();
        db.Delete<ArpgSaveSkillEntity>().Where(a => a.slot == slot).ExecuteAffrows();
        db.Delete<ArpgSaveBuffEntity>().Where(a => a.slot == slot).ExecuteAffrows();
        int saveResult = db.Delete<ArpgSaveSlotEntity>().Where(a => a.slot == slot).ExecuteAffrows();
        this.database.Commit();
        return saveResult > 0;
    }

    // 存档槽位总数；未就绪时返回 0。
    int SlotCount() {
        if (!this.ready) { return 0; }
        SqliteConnection db = this.database.Conn();
        return (int)db.Select<ArpgSaveSlotEntity>().Count();
    }

    // 按槽位名排序后的第 index 个槽位名；未就绪、index 为负或越界时返回空串。
    string SlotAt(int index) {
        if (!this.ready || index < 0) { return ""; }
        SqliteConnection db = this.database.Conn();
        List<ArpgSaveSlotEntity> slots = db.Select<ArpgSaveSlotEntity>()
            .OrderBy(a => a.slot)
            .ToList();
        if (index >= slots.Count) { return ""; }
        return slots[index].slot;
    }

    // 关闭底层数据库并将仓库置为未就绪；之后所有操作均失败。
    void Close() {
        if (this.database != null) {
            this.database.Close();
        }
        this.ready = false;
    }
}
