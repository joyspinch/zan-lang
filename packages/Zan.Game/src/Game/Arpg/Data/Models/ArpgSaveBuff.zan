using System;

namespace Game.Arpg.Data;

// 存档中的一个生效中增益：名称与剩余毫秒数。
public class ArpgSaveBuff {
    public string name;
    public int remaining;

    public ArpgSaveBuff(string name, int remaining) {
        this.name = name;
        this.remaining = remaining;
    }
    // 增益名。
    public string Name() { return this.name; }
    // 剩余时长（毫秒）。
    public int Remaining() { return this.remaining; }
}
