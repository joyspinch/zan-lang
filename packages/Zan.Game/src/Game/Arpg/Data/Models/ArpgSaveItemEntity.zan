using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using Game.Arpg;

namespace Game.Arpg.Data;

public class ArpgSaveItemEntity {
    [Column(Name = "slot")]
    public string slot;
    [Column(Name = "item_name")]
    public string item_name;
    [Column(Name = "quantity")]
    public int quantity;
}
