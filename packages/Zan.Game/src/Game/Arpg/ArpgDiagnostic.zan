using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 单条诊断信息：级别、错误码、出错路径与英文说明。
class ArpgDiagnostic {
    int severity;
    string code;
    string path;
    string message;

    // 构造一条诊断。
    ArpgDiagnostic(
        int severity,
        string code,
        string path,
        string message
    ) {
        this.severity = severity;
        this.code = code;
        this.path = path;
        this.message = message;
    }

    // 级别（ArpgDiagnosticSeverity 常量之一）。
    int Severity() { return this.severity; }
    // 机器可读错误码（如 "L2PRJ001"）。
    string Code() { return this.code; }
    // 出错位置（点分路径，如 "actors.player.skills"）。
    string Path() { return this.path; }
    // 英文说明文本。
    string Message() { return this.message; }
}
