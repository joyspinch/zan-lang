using System;

namespace Game.Arpg;

// 增益（Buff）定义：持续时长 -1 表示永久；触发间隔决定周期效果
// （如每秒掉血）的频率；移除条件与限制效果由布尔开关组合配置。
public class ArpgBuffDefinition {
    public string id;
    public string displayName;
    public string iconResource;
    public string title;
    public string tooltip;
    public int durationMilliseconds;
    public int triggerIntervalMilliseconds;
    public bool removeOnDeath;
    public bool removeOnMove;
    public bool removeOnAttack;
    public bool removeOnDamage;
    public bool movementDisabled;
    public bool attackDisabled;
    public bool blinded;
    public bool runningAllowed;
    public ArpgAttributes attributes;

    public ArpgBuffDefinition(string id, string displayName) {
        this.id = id;
        this.displayName = displayName;
        this.iconResource = "";
        this.title = "";
        this.tooltip = "";
        this.durationMilliseconds = -1;
        this.triggerIntervalMilliseconds = 0;
        this.removeOnDeath = true;
        this.removeOnMove = false;
        this.removeOnAttack = false;
        this.removeOnDamage = false;
        this.movementDisabled = false;
        this.attackDisabled = false;
        this.blinded = false;
        this.runningAllowed = true;
        this.attributes = new ArpgAttributes();
    }

    // 增益唯一 Id（配置键，创建后不变）。
    public string Id() { return this.id; }
    // 显示名（必填）。
    public string DisplayName() { return this.displayName; }
    // 图标资源路径，默认空串。
    public string IconResource() { return this.iconResource; }
    // UI 标题文本，默认空串。
    public string Title() { return this.title; }
    // 悬浮提示文本，默认空串。
    public string Tooltip() { return this.tooltip; }
    // 持续时长（毫秒），默认 -1 表示永久。
    public int DurationMilliseconds() { return this.durationMilliseconds; }
    // 周期触发间隔（毫秒），默认 0 表示不周期触发（Tick 返回 0）。
    public int TriggerIntervalMilliseconds() { return this.triggerIntervalMilliseconds; }
    // 携带者死亡时是否移除（默认 true）。
    public bool RemoveOnDeath() { return this.removeOnDeath; }
    // 移动时是否移除（默认 false）。
    public bool RemoveOnMove() { return this.removeOnMove; }
    // 攻击时是否移除（默认 false）。
    public bool RemoveOnAttack() { return this.removeOnAttack; }
    // 受伤时是否移除（默认 false）。
    public bool RemoveOnDamage() { return this.removeOnDamage; }
    // true 时禁止移动（定身类）。
    public bool MovementDisabled() { return this.movementDisabled; }
    // true 时禁止攻击（缴械类）。
    public bool AttackDisabled() { return this.attackDisabled; }
    // true 时致盲（视野受限）。
    public bool Blinded() { return this.blinded; }
    // true 时允许奔跑（如减速/冰冻增益需置 false）。
    public bool RunningAllowed() { return this.runningAllowed; }
    // 增益附带的属性加成集合（只读视图，配置期通过其 Set* 修改）。
    public ArpgAttributes Attributes() { return this.attributes; }

    // 设置图标资源路径。
    public void SetIconResource(string newValue) { this.iconResource = newValue; }
    // 设置 UI 标题文本。
    public void SetTitle(string newValue) { this.title = newValue; }
    // 设置悬浮提示文本。
    public void SetTooltip(string newValue) { this.tooltip = newValue; }
    // 设置持续时长（毫秒）；-1 表示永久。
    public void SetDurationMilliseconds(int newValue) { this.durationMilliseconds = newValue; }
    // 设置周期触发间隔（毫秒）；0 表示不周期触发。
    public void SetTriggerIntervalMilliseconds(int newValue) {
        this.triggerIntervalMilliseconds = newValue;
    }
    // 一次性设置四个移除条件：死亡/移动/攻击/受伤。
    public void SetRemoveConditions(
        bool death,
        bool move,
        bool attack,
        bool damage
    ) {
        this.removeOnDeath = death;
        this.removeOnMove = move;
        this.removeOnAttack = attack;
        this.removeOnDamage = damage;
    }
    // 一次性设置四个限制效果：禁移动/禁攻击/致盲/允许奔跑。
    public void SetRestrictions(
        bool movementDisabled,
        bool attackDisabled,
        bool blinded,
        bool runningAllowed
    ) {
        this.movementDisabled = movementDisabled;
        this.attackDisabled = attackDisabled;
        this.blinded = blinded;
        this.runningAllowed = runningAllowed;
    }

    // 校验增益配置合法性，问题以错误码 L2BUF001~L2BUF004 写入
    // diagnostics（必填缺失、时长小于 -1、触发间隔为负）。应在
    // 配置加载完成后调用一次。
    public void Validate(ArpgDiagnostics diagnostics) {
        string path = "buffs." + this.id;
        ArpgValidation.Required(diagnostics, this.id, "buffs", "L2BUF001");
        ArpgValidation.Required(
            diagnostics, this.displayName, path + ".displayName", "L2BUF002");
        if (this.durationMilliseconds < -1) {
            diagnostics.AddError(
                "L2BUF003",
                path + ".durationMilliseconds",
                "Duration must be -1 or a non-negative value.");
        }
        if (this.triggerIntervalMilliseconds < 0) {
            diagnostics.AddError(
                "L2BUF004",
                path + ".triggerIntervalMilliseconds",
                "Trigger interval cannot be negative.");
        }
    }
}
