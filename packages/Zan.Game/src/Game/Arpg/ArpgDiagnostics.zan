using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 收集校验错误，而不是在首个问题处抛异常。
public class ArpgDiagnostics {
    public List<ArpgDiagnostic> items;
    public int errorCount;
    public int warningCount;

    // 构造空诊断集合。
    public ArpgDiagnostics() {
        this.items = new List<ArpgDiagnostic>();
        this.errorCount = 0;
        this.warningCount = 0;
    }

    // 追加一条错误诊断并使 ErrorCount() 自增。
    public void AddError(string code, string path, string message) {
        this.items.Add(new ArpgDiagnostic(
            ArpgDiagnosticSeverity.Error(), code, path, message));
        this.errorCount = this.errorCount + 1;
    }

    // 追加一条警告诊断并使 WarningCount() 自增。
    public void AddWarning(string code, string path, string message) {
        this.items.Add(new ArpgDiagnostic(
            ArpgDiagnosticSeverity.Warning(), code, path, message));
        this.warningCount = this.warningCount + 1;
    }

    // 是否存在任何错误（ErrorCount() > 0）。
    public bool HasErrors() { return this.errorCount > 0; }
    // 错误条数。
    public int ErrorCount() { return this.errorCount; }
    // 警告条数。
    public int WarningCount() { return this.warningCount; }
    // 诊断总数（错误+警告+信息）。
    public int Count() { return this.items.Count; }
    // 第 index 条诊断（不查越界）。
    public ArpgDiagnostic At(int index) { return this.items[index]; }

    // 把 other 的全部条目并入自身并累计各级计数。
    public void Append(ArpgDiagnostics other) {
        for (int i = 0; i < other.Count(); i = i + 1) {
            ArpgDiagnostic diagnostic = other.At(i);
            this.items.Add(diagnostic);
            if (diagnostic.Severity() == ArpgDiagnosticSeverity.Error()) {
                this.errorCount = this.errorCount + 1;
            } else if (diagnostic.Severity() == ArpgDiagnosticSeverity.Warning()) {
                this.warningCount = this.warningCount + 1;
            }
        }
    }
}
