using System;
using System.Text;
using Gui;

namespace Game.Arpg;

// 富文本解析静态入口：先用数据源对 content 做模板求值（展开
// &amp;path&amp; 与 {if} 分支），再按默认样式解析为 run 文档。
// content 为空时返回空文档。
public class ArpgRichText {
    // 模板求值 + 富文本解析；source 可为 null（占位符解析为空）。
    public static ArpgRichTextDocument Parse(
        string content,
        ArpgDataSource source
    ) {
        string evaluated = ArpgTemplate.Evaluate(content, source);
        ArpgRichTextParser parser = new ArpgRichTextParser(
            evaluated, ArpgRichTextStyle.Default(), null);
        return parser.Parse();
    }

    // ArpgColor → Gui 打包色（0xAARRGGBB）。
    public static int PackColor(ArpgColor color) {
        return (color.Alpha() << 24) | (color.Red() << 16)
            | (color.Green() << 8) | color.Blue();
    }

    // Gui 打包色（0xAARRGGBB）→ ArpgColor。
    public static ArpgColor UnpackColor(int packed) {
        return new ArpgColor(
            (packed >> 16) & 255,
            (packed >> 8) & 255,
            packed & 255,
            (packed >> 24) & 255);
    }
}
