using System;

namespace Game.Arpg;

// 菜单运行时只分派有效、可见且启用的项。渲染
// 适配器可消费同一菜单状态并订阅 ArpgEvents。
// 菜单运行时：管理命名菜单集合并分派激活。只分派可见且启用
// 的项，激活成功经 ArpgEvents.RaiseMenuChanged 上抛（菜单名/
// 项名/载荷）。渲染适配器可消费同一菜单状态并订阅 ArpgEvents。
public class ArpgMenuRuntime : IDisposable {
    public List<ArpgMenu> menus;
    public ArpgEvents events;

    // 构造运行时；events 可为 null（激活时不上抛事件）。
    public ArpgMenuRuntime(ArpgEvents events) {
        this.menus = new List<ArpgMenu>();
        this.events = events;
    }

    // 按菜单名查找索引；未找到返回 -1。
    public int IndexOf(string name) {
        for (int i = 0; i < this.menus.Count; i = i + 1) {
            if (this.menus[i].Name() == name) { return i; }
        }
        return -1;
    }
    // 追加或按名称覆盖菜单（menu 为 null 忽略），返回 this。
    public ArpgMenuRuntime AddMenu(ArpgMenu menu) {
        if (menu == null) { return this; }
        int index = this.IndexOf(menu.Name());
        if (index < 0) { this.menus.Add(menu); }
        else { this.menus[index] = menu; }
        return this;
    }
    // 按菜单名查找菜单；未找到返回 null。
    public ArpgMenu FindMenu(string name) {
        int index = this.IndexOf(name);
        if (index < 0) { return null; }
        return this.menus[index];
    }
    // 菜单数量。
    public int MenuCount() { return this.menus.Count; }
    // 第 index 个菜单（不查越界）。
    public ArpgMenu MenuAt(int index) { return this.menus[index]; }

    // 激活指定菜单的指定项：菜单或项不存在、项不可见或禁用时
    // 返回 false（不上抛事件）；成功时经 RaiseMenuChanged 上抛
    // （菜单名/项名/载荷）并返回 true。
    public bool Activate(string menuName, string itemName) {
        ArpgMenu menu = this.FindMenu(menuName);
        if (menu == null) { return false; }
        ArpgMenuItem item = menu.FindItem(itemName);
        if (item == null || !item.Visible() || !item.Enabled()) {
            return false;
        }
        if (this.events != null) {
            this.events.RaiseMenuChanged(
                menuName, itemName, item.Payload());
        }
        return true;
    }

    // 释放全部菜单并断开事件引用（之后不应再使用本运行时）。
    public void Dispose() {
        for (int i = 0; i < this.menus.Count; i = i + 1) {
            this.menus[i].Dispose();
        }
        this.menus.Clear();
        this.menus = null;
        this.events = null;
    }
}
