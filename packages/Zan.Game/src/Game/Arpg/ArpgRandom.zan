namespace Game.Arpg;

// 适合回放与测试的小型确定性随机数生成器。
class ArpgRandom {
    int state;

    // 构造生成器；种子与 0x7FFFFFFF 按位与，0 时强制为 1。
    ArpgRandom(int seed) {
        this.state = seed & 2147483647;
        if (this.state == 0) { this.state = 1; }
    }

    // 返回 [0, 2147483647] 内的下一个伪随机整数（LCG）。
    int Next() {
        this.state = (this.state * 1103515245 + 12345) & 2147483647;
        return this.state;
    }

    // 返回 [1, 100] 内的百分比掷点（命中/暴击判定用）。
    int NextPercent() { return this.Next() % 100 + 1; }
}
