using System;
using System.Collections.Generic;

namespace Game.Arpg;

/// <summary>
/// 单个类型化全局变量：名称、字符串编码的值与类型标签
/// （0 = string，1 = int，2 = bool）。用单个实体代替平行列表。
/// </summary>
class GlobalEntry {
    string key;
    string val;
    int kind;

    GlobalEntry(string key, string val, int kind) {
        this.key = key;
        this.val = val;
        this.kind = kind;
    }
}

/// <summary>
/// 玩法、UI 与适配器共享的类型化进程/游戏状态。值
/// 特意可枚举，便于应用在外部序列化。
/// </summary>
class ArpgGlobals {
    List<GlobalEntry> entries;

    ArpgGlobals() {
        this.entries = new List<GlobalEntry>();
    }

    /// 返回 key 的存储下标；不存在时返回 -1（区分大小写精确匹配）。
    int IndexOf(string key) {
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            if (this.entries[i].key == key) { return i; }
        }
        return -1;
    }

    /// 插入或更新条目：已存在同名 key 时覆盖值与类型标签，否则
    /// 追加到末尾。返回 this 便于链式调用。
    ArpgGlobals Put(string key, string content, int kind) {
        int index = this.IndexOf(key);
        if (index < 0) {
            this.entries.Add(new GlobalEntry(key, content, kind));
        } else {
            this.entries[index].val = content;
            this.entries[index].kind = kind;
        }
        return this;
    }

    /// 写入字符串全局变量（类型标签 0），返回 this。
    ArpgGlobals Set(string key, string content) {
        return this.Put(key, content, 0);
    }
    /// 写入整数全局变量（以十进制字符串存储，类型标签 1），返回 this。
    ArpgGlobals SetInt(string key, int amount) {
        return this.Put(key, Convert.ToString(amount), 1);
    }
    /// 写入布尔全局变量（"1"/"0" 存储，类型标签 2），返回 this。
    ArpgGlobals SetBool(string key, bool enabled) {
        string text = "0";
        if (enabled) { text = "1"; }
        return this.Put(key, text, 2);
    }

    /// 是否存在指定 key 的条目。
    bool Contains(string key) { return this.IndexOf(key) >= 0; }
    /// 条目总数。
    int Count() { return this.entries.Count; }
    /// 第 index 个条目的名称；越界行为由底层 List 决定（抛错）。
    string KeyAt(int index) { return this.entries[index].key; }
    /// 第 index 个条目的字符串编码值。
    string ValueAt(int index) { return this.entries[index].val; }
    /// 第 index 个条目的类型标签（0 = string，1 = int，2 = bool）。
    int KindAt(int index) { return this.entries[index].kind; }

    /// 读取字符串全局变量；不存在时返回 fallback。
    string Get(string key, string fallback) {
        int index = this.IndexOf(key);
        if (index < 0) { return fallback; }
        return this.entries[index].val;
    }
    /// 读取整数全局变量；不存在或类型标签不是 1 时返回 fallback（不做转换）。
    int GetInt(string key, int fallback) {
        int index = this.IndexOf(key);
        if (index < 0 || this.entries[index].kind != 1) { return fallback; }
        return Convert.ToInt32(this.entries[index].val);
    }
    /// 读取布尔全局变量；不存在或类型标签不是 2 时返回 fallback，
    /// 否则值为 "1" 即 true。
    bool GetBool(string key, bool fallback) {
        int index = this.IndexOf(key);
        if (index < 0 || this.entries[index].kind != 2) { return fallback; }
        return this.entries[index].val == "1";
    }

    /// 移除指定 key 的条目并返回 true；不存在时不做修改返回 false。
    bool Remove(string key) {
        int index = this.IndexOf(key);
        if (index < 0) { return false; }
        this.entries.RemoveAt(index);
        return true;
    }
    /// 清空全部条目。
    void Clear() {
        this.entries.Clear();
    }
}
