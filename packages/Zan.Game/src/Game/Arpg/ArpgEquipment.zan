using System;

namespace Game.Arpg;

// 角色的装备栏：槽位名到物品的映射。Equip 会先从背包扣件、
// 换装时旧件退回背包（退不下则整体失败）；Attributes 汇总
// 全部已装备物品的属性修正。
class ArpgEquipment {
    List<ArpgEquipSlot> slots;

    // 构造空装备栏。
    ArpgEquipment() {
        this.slots = new List<ArpgEquipSlot>();
    }

    // 槽位名对应下标；不存在返回 -1。
    int IndexOf(string slot) {
        for (int i = 0; i < this.slots.Count; i = i + 1) {
            if (this.slots[i].slot == slot) { return i; }
        }
        return -1;
    }

    // 返回槽位上当前装备的物品；未装备返回 null。
    ArpgItemDefinition Get(string slot) {
        int index = this.IndexOf(slot);
        if (index < 0) { return null; }
        return this.slots[index].item;
    }

    // 装备一件物品：要求槽位名非空、物品为 Equipment 类别、背包
    // 能扣出 1 件。替换时旧件退回背包，退不下则整体回滚返回
    // false。成功返回 true。
    bool Equip(
        string slot,
        ArpgItemDefinition definition,
        ArpgInventory inventory
    ) {
        if (slot == null || slot == "" || definition == null || inventory == null) {
            return false;
        }
        if (definition.Category() != ArpgItemCategory.Equipment()) {
            return false;
        }
        if (!inventory.Remove(definition.Id(), 1)) { return false; }

        int index = this.IndexOf(slot);
        if (index >= 0) {
            ArpgItemDefinition old = this.slots[index].item;
            int restored = inventory.Add(old, 1);
            if (restored != 1) {
                inventory.Add(definition, 1);
                return false;
            }
            this.slots[index].item = definition;
        } else {
            this.slots.Add(new ArpgEquipSlot(slot, definition));
        }
        return true;
    }

    // 卸下槽位装备退回背包（放不下返回 false）。槽位为空或
    // inventory 为 null 返回 false。
    bool Unequip(string slot, ArpgInventory inventory) {
        int index = this.IndexOf(slot);
        if (index < 0 || inventory == null) { return false; }
        ArpgItemDefinition old = this.slots[index].item;
        if (inventory.Add(old, 1) != 1) { return false; }
        this.slots.RemoveAt(index);
        return true;
    }

    // 已装备的槽位数。
    int Count() { return this.slots.Count; }
    // 第 index 个槽位的名称（不查越界）。
    string SlotNameAt(int index) { return this.slots[index].slot; }
    // 第 index 个槽位的物品（不查越界）。
    ArpgItemDefinition ItemAt(int index) { return this.slots[index].item; }

    // 汇总全部已装备物品的属性修正（无装备时为零值属性）。
    ArpgAttributes Attributes() {
        ArpgAttributes attributes = new ArpgAttributes();
        for (int i = 0; i < this.slots.Count; i = i + 1) {
            attributes.AddModifiersFrom(this.slots[i].item.Attributes());
        }
        return attributes;
    }
}
