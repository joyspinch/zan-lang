using System;

namespace Game.Arpg;

// 角色与背包控件使用的可堆叠格子背包。
public class ArpgInventory {
    public int capacity;
    public List<ArpgItemInstance> slots;

    // 构造背包；容量钳制到 ≥1。
    public ArpgInventory(int capacity) {
        this.capacity = ArpgMath.Max(1, capacity);
        this.slots = new List<ArpgItemInstance>();
    }

    // 总格数上限（≥1）。
    public int Capacity() { return this.capacity; }
    // 当前已用格数（未堆满的同 id 物品共享一格）。
    public int SlotCount() { return this.slots.Count; }
    // 第 index 个格子实例（不查越界）。
    public ArpgItemInstance SlotAt(int index) { return this.slots[index]; }
    // 已用格数是否达到容量上限。
    public bool IsFull() { return this.slots.Count >= this.capacity; }

    // 指定物品 id 的总数量（跨全部格子求和）。
    public int QuantityOf(string itemId) {
        int total = 0;
        for (int i = 0; i < this.slots.Count; i = i + 1) {
            if (this.slots[i].Definition().Id() == itemId) {
                total = total + this.slots[i].Quantity();
            }
        }
        return total;
    }

    // 返回第一个包含指定物品的格子；没有返回 null。
    public ArpgItemInstance Find(string itemId) {
        for (int i = 0; i < this.slots.Count; i = i + 1) {
            if (this.slots[i].Definition().Id() == itemId) {
                return this.slots[i];
            }
        }
        return null;
    }

    // 加入物品：先填已有同 id 堆（至 MaxStack），再开新格。
    // 返回实际加入数；容量/堆叠不足时可少于 count
    // （definition 为 null 或 count ≤ 0 返回 0）。
    public int Add(ArpgItemDefinition definition, int count) {
        if (definition == null || count <= 0) { return 0; }
        int remaining = count;
        for (int i = 0; i < this.slots.Count && remaining > 0; i = i + 1) {
            ArpgItemInstance item = this.slots[i];
            if (item.Definition().Id() == definition.Id()) {
                remaining = remaining - item.Add(remaining);
            }
        }
        while (remaining > 0 && this.slots.Count < this.capacity) {
            int stack = remaining;
            if (stack > definition.MaxStack()) { stack = definition.MaxStack(); }
            this.slots.Add(new ArpgItemInstance(definition, stack));
            remaining = remaining - stack;
        }
        return count - remaining;
    }

    // 移除指定数量的物品（库存不足时整体失败返回 false，
    // 不做部分移除）。空格子自动回收。count ≤ 0 返回 false。
    public bool Remove(string itemId, int count) {
        if (count <= 0 || this.QuantityOf(itemId) < count) { return false; }
        int remaining = count;
        int i = this.slots.Count - 1;
        while (i >= 0 && remaining > 0) {
            ArpgItemInstance item = this.slots[i];
            if (item.Definition().Id() == itemId) {
                remaining = remaining - item.Remove(remaining);
                if (item.IsEmpty()) { this.slots.RemoveAt(i); }
            }
            i = i - 1;
        }
        return true;
    }
}
