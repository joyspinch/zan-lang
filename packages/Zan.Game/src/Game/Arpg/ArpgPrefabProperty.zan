using System;
using System.Collections.Generic;

namespace Game.Arpg;

// Prefab 可配置属性声明：属性名与其默认值（均为字符串）。控件
// 引用 Prefab 时可按名覆盖属性值；Validate 要求属性名非空且唯一。
public class ArpgPrefabProperty {
    public string name;
    public string defaultValue;

    public ArpgPrefabProperty(string name, string defaultValue) {
        this.name = name;
        this.defaultValue = defaultValue;
    }

    // 返回属性名（Prefab 内唯一）。
    public string Name() { return this.name; }
    // 返回属性默认值（未被覆盖时使用）。
    public string DefaultValue() { return this.defaultValue; }
}
