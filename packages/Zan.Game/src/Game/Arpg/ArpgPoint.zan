using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 逻辑坐标下的二维点。
class ArpgPoint {
    double x;
    double y;

    // 构造点。
    ArpgPoint(double x, double y) {
        this.x = x;
        this.y = y;
    }

    // X 坐标。
    double X() { return this.x; }
    // Y 坐标。
    double Y() { return this.y; }
    // 同时重设两个坐标。
    void Set(double x, double y) {
        this.x = x;
        this.y = y;
    }
}
