using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 逻辑坐标下的二维点。
public class ArpgPoint {
    public double x;
    public double y;

    // 构造点。
    public ArpgPoint(double x, double y) {
        this.x = x;
        this.y = y;
    }

    // X 坐标。
    public double X() { return this.x; }
    // Y 坐标。
    public double Y() { return this.y; }
    // 同时重设两个坐标。
    public void Set(double x, double y) {
        this.x = x;
        this.y = y;
    }
}
