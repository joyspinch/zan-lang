using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.WebSocket;

namespace Game.Arpg;

// WebSocketClient 组件的实时 WebSocket 客户端运行时。解析
// WebSocketClient 组件的实时 WebSocket 客户端运行时：解析配置
// 地址为 WsUrl，把 RFC 6455 握手与帧处理委托给
// System.Net.WebSocket.WebSocketClient。收发均为 async。
public class ArpgWebSocketRuntime : IDisposable {
    public WebSocketClientConfig config;
    public WsUrl url;
    public WebSocketClient ws;
    public bool connected;

    // 由组件配置构造运行时并立即解析地址（未连接）。
    public static ArpgWebSocketRuntime FromConfig(WebSocketClientConfig config) {
        ArpgWebSocketRuntime r = new ArpgWebSocketRuntime();
        r.config = config;
        r.url = WsUrl.Parse(config.Url());
        r.connected = false;
        return r;
    }

    // 解析出的目标地址。
    public WsUrl Url() { return this.url; }
    // 是否已连接。
    public bool IsConnected() { return this.connected; }

    // 异步执行握手连接；完成后用 IsConnected 判断结果。
    public async void ConnectAsync() {
        this.ws = await WebSocketClient.ConnectAsync(this.url.Host(), this.url.Port(), this.url.Path());
        this.connected = this.ws.IsConnected();
    }

    // 异步发送一条文本帧。
    public async void SendText(string text) {
        await this.ws.SendText(text);
    }

    // 异步接收一条文本帧；连接关闭时返回 null。
    public async string RecvText() {
        return await this.ws.RecvText();
    }

    // 异步关闭连接（未连接时安全调用）。
    public async void Close() {
        if (this.connected) {
            await this.ws.Close();
            this.connected = false;
        }
    }

    public void Dispose() {
        if (this.connected && this.ws != null) {
            this.ws.Dispose();
            this.connected = false;
        }
    }
}
