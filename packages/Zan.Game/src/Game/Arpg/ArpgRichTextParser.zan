using System;
using System.Text;
using Gui;

namespace Game.Arpg;

// 富文本解析器：把标签化文本切分为类型化 run 流。支持颜色
// 快捷标记（#W #R #Y #B #G #H #L）、#c()/#bg()/#f() 样式标签、
// #p()/#a()/#z()/#item() 资源标签、#br(宽度)/#md/#rt/#lf 排版标签
// 与 #@标记@内容@ 超链接。无法识别的 # 按普通文本保留，
// ## 转义为字面 '#'。
// 薄适配：解析完全委托 Gui.RichTextParser。
public class ArpgRichTextParser {
    Gui.RichTextParser inner;

    public ArpgRichTextParser(
        string input,
        ArpgRichTextStyle style,
        ArpgRichTextLink link
    ) {
        Gui.RichTextLink innerLink = null;
        if (link != null) { innerLink = link.Inner(); }
        this.inner = new Gui.RichTextParser(
            input, style.Inner(), innerLink);
    }

    // 在 text 中从 start 起查找 token 首次出现的位置；未找到返回 -1。
    public static int FindIn(string text, string token, int start) {
        return Gui.RichTextParser.FindIn(text, token, start);
    }

    // 按逗号分隔的参数个数（空串为 0，"a,,b" 计 3）。
    public static int ArgCount(string text) {
        return Gui.RichTextParser.ArgCount(text);
    }

    // 第 index 个逗号分隔参数（两侧去空白）；越界返回空串。
    public static string ArgAt(string text, int index) {
        return Gui.RichTextParser.ArgAt(text, index);
    }

    // 单个十六进制字符的数值（0-9/a-f/A-F）；其他字符返回 0。
    public static int HexDigit(string digit) {
        return Gui.RichTextParser.HexDigit(digit);
    }

    // 解析整数：支持十进制与 0x 前缀十六进制（可带负号），
    // 两侧去空白；无有效数字时返回 0（不置错）。
    public static int ParseInt(string text) {
        return Gui.RichTextParser.ParseInt(text);
    }

    // 解析 0xRRGGBBAA 颜色；空串、"0" 或格式不符返回全透明。
    public static ArpgColor ParseColor(string text) {
        return ArpgRichText.UnpackColor(
            Gui.RichTextParser.ParseColor(text));
    }

    // 解析颜色参数串：1 个参数按 0xRRGGBBAA，4 个参数按
    // r,g,b,a 十进制；其他情况返回全透明。
    public static ArpgColor ParseColorArgs(string args) {
        return ArpgRichText.UnpackColor(
            Gui.RichTextParser.ParseColorArgs(args));
    }

    // 解析全部输入并返回文档：\n 产生 LineBreak，'#' 触发标签
    // 解析（未识别时按普通文本保留），其余字符累积为文本 run。
    public ArpgRichTextDocument Parse() {
        return new ArpgRichTextDocument(this.inner.Parse());
    }
}
