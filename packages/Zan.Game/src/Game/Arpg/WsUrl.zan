using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.WebSocket;

namespace Game.Arpg;

// 解析后的 WebSocket 客户端地址（ws:// 或 wss://）。拆分为 scheme、host、
// port / path；省略时端口默认为 80（ws）或 443（wss）。
// 解析后的 WebSocket 客户端地址（ws:// 或 wss://）：scheme、
// host、port、path 与 secure 标志。端口省略时默认 80（ws）
// 或 443（wss）；path 省略时默认 "/"。
class WsUrl {
    // 协议名："ws" 或 "wss"。
    string scheme;
    // 主机名或 IP（authority 中端口前的部分）。
    string host;
    // 端口号；未显式给出时为 80（ws）或 443（wss）。
    int port;
    // 路径，以 "/" 开头；省略时为 "/"。
    string path;
    // 是否为加密连接（wss）。
    bool secure;

    // 把 s 的 [start, end) 区间数字字符转为 int，遇非数字即停
    // 并返回已累计值；非数字开头返回 0。
    static int DigitsToInt(string s, int start, int end) {
        int v = 0;
        int i = start;
        while (i < end) {
            int c = s[i] & 0xFF;
            if (c < 48 || c > 57) { return v; }
            v = v * 10 + (c - 48);
            i = i + 1;
        }
        return v;
    }

    // 解析 ws:// 或 wss:// 地址。无法识别前缀时按 host 为空、
    // ws 默认端口处理；不抛异常。
    static WsUrl Parse(string url) {
        WsUrl u = new WsUrl();
        u.scheme = "ws";
        u.secure = false;
        u.port = 80;
        u.path = "/";
        u.host = "";

        int len = url.Length;
        int idx = 0;
        // scheme: "wss://" = w s s : / /  ;  "ws://" = w s : / /
        if (len >= 6 && (url[0] & 0xFF) == 119 && (url[1] & 0xFF) == 115 &&
            (url[2] & 0xFF) == 115 && (url[3] & 0xFF) == 58 &&
            (url[4] & 0xFF) == 47 && (url[5] & 0xFF) == 47) {
            u.scheme = "wss";
            u.secure = true;
            u.port = 443;
            idx = 6;
        } else if (len >= 5 && (url[0] & 0xFF) == 119 && (url[1] & 0xFF) == 115 &&
                   (url[2] & 0xFF) == 58 && (url[3] & 0xFF) == 47 && (url[4] & 0xFF) == 47) {
            idx = 5;
        }

        // authority 一直延伸到第一个 '/'（或结尾）
        int slash = idx;
        while (slash < len && (url[slash] & 0xFF) != 47) { slash = slash + 1; }

        // 将 authority 拆分为 host[:port]
        int colon = idx;
        bool hasColon = false;
        int j = idx;
        while (j < slash) {
            if ((url[j] & 0xFF) == 58) { colon = j; hasColon = true; break; }
            j = j + 1;
        }
        if (hasColon) {
            u.host = url.Substring(idx, colon - idx);
            u.port = WsUrl.DigitsToInt(url, colon + 1, slash);
        } else {
            u.host = url.Substring(idx, slash - idx);
        }

        if (slash < len) {
            u.path = url.Substring(slash, len - slash);
        }
        return u;
    }

    // 协议名（"ws"/"wss"）。
    string Scheme() { return this.scheme; }
    // 主机名或 IP。
    string Host() { return this.host; }
    // 端口（默认 80/443）。
    int Port() { return this.port; }
    // 请求路径（以 "/" 开头）。
    string Path() { return this.path; }
    // 是否 wss（加密）。
    bool Secure() { return this.secure; }
}
