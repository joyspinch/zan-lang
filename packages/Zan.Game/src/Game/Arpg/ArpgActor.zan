using System;

namespace Game.Arpg;

// 运行期角色实例：直接构造或经 FromDefinition 从定义生成，
// 持有基础属性、背包（默认 40 格）、装备、冷却与在身增益；
// 坐标与朝向用地图格坐标系。治疗/消耗/伤害结算直接在实例上
// 进行，实时有效属性经 EffectiveAttributes 叠加装备与增益修饰。
class ArpgActor {
    string id;
    string displayName;
    string definitionId;
    string faction;
    int level;
    int gridX;
    int gridY;
    int direction;
    bool alive;
    ArpgAttributes attributes;
    List<string> skills;
    ArpgInventory inventory;
    ArpgEquipment equipment;
    ArpgCooldowns cooldowns;
    List<ArpgBuffInstance> activeBuffs;

    ArpgActor(string id, string displayName) {
        this.id = id;
        this.displayName = displayName;
        this.definitionId = "";
        this.faction = ArpgFaction.Neutral();
        this.level = 1;
        this.gridX = 0;
        this.gridY = 0;
        this.direction = 0;
        this.alive = true;
        this.attributes = new ArpgAttributes();
        this.skills = new List<string>();
        this.inventory = new ArpgInventory(40);
        this.equipment = new ArpgEquipment();
        this.cooldowns = new ArpgCooldowns();
        this.activeBuffs = new List<ArpgBuffInstance>();
    }

    // 以 instanceId 创建角色实例并从 definition 灌入显示名、阵营、
    // 等级、朝向与基础属性（AddFrom，含全部自定义属性）；初始技能
    // 取自定义。初始增益不在此处施加（由 Project.ApplyStartingBuffs
    // 负责），背包/装备为空。
    static ArpgActor FromDefinition(string instanceId, ArpgActorDefinition definition) {
        ArpgActor actor = new ArpgActor(instanceId, definition.DisplayName());
        actor.definitionId = definition.Id();
        actor.faction = definition.Faction();
        actor.level = definition.Level();
        actor.direction = definition.Direction();
        actor.attributes.AddFrom(definition.Attributes());
        for (int i = 0; i < definition.SkillCount(); i = i + 1) {
            actor.skills.Add(definition.SkillAt(i));
        }
        return actor;
    }

    // 角色 Id（实例标识，创建后不变）。
    string Id() { return this.id; }
    // 显示名（来自定义或构造参数）。
    string DisplayName() { return this.displayName; }
    // 来源定义 Id（FromDefinition 时才有值，否则为空串）。
    string DefinitionId() { return this.definitionId; }
    // 阵营（ArpgFaction 常量，默认 Neutral）。
    string Faction() { return this.faction; }
    // 等级。
    int Level() { return this.level; }
    // 当前所在格 X（地图格坐标）。
    int GridX() { return this.gridX; }
    // 当前所在格 Y（地图格坐标）。
    int GridY() { return this.gridY; }
    // 朝向（-1 或 0~7，-1 表示未定向）。
    int Direction() { return this.direction; }
    // 是否存活（HP 归 0 由 TakeDamage/ClampVitals 置 false）。
    bool IsAlive() { return this.alive; }
    // 基础属性（不含装备/增益，实时有效值用 EffectiveAttributes）。
    ArpgAttributes Attributes() { return this.attributes; }
    // 背包（默认 40 格）。
    ArpgInventory Inventory() { return this.inventory; }
    // 装备槽集合。
    ArpgEquipment Equipment() { return this.equipment; }
    // 技能/物品冷却表。
    ArpgCooldowns Cooldowns() { return this.cooldowns; }

    // 实时有效属性：基础属性克隆后叠加装备与全部在身增益的修饰。
    // 每次调用都重新计算并返回新对象，帧内反复调用有开销，宜缓存。
    ArpgAttributes EffectiveAttributes() {
        ArpgAttributes effective = this.attributes.Clone();
        effective.AddModifiersFrom(this.equipment.Attributes());
        for (int i = 0; i < this.activeBuffs.Count; i = i + 1) {
            effective.AddModifiersFrom(
                this.activeBuffs[i].Definition().Attributes());
        }
        return effective;
    }

    // 设置等级。
    void SetLevel(int newLevel) { this.level = newLevel; }
    // 设置阵营（ArpgFaction 常量）。
    void SetFaction(string newValue) { this.faction = newValue; }
    // 设置所在格坐标（地图格坐标系）。
    void SetGridPosition(int x, int y) {
        this.gridX = x;
        this.gridY = y;
    }
    // 设置朝向（-1 或 0~7）。
    void SetDirection(int newValue) { this.direction = newValue; }
    // 直接设置存活标记（复活/测试用；常规伤害走 TakeDamage）。
    void SetAlive(bool newValue) { this.alive = newValue; }

    // 添加技能 Id；已拥有时静默忽略（幂等）。
    void AddSkill(string skillId) {
        if (!this.HasSkill(skillId)) { this.skills.Add(skillId); }
    }

    // 移除指定技能；找到并移除返回 true，未拥有返回 false。
    bool RemoveSkill(string skillId) {
        int i = this.skills.Count - 1;
        while (i >= 0) {
            if (this.skills[i] == skillId) {
                this.skills.RemoveAt(i);
                return true;
            }
            i = i - 1;
        }
        return false;
    }

    // 是否已拥有指定技能。
    bool HasSkill(string skillId) {
        for (int i = 0; i < this.skills.Count; i = i + 1) {
            if (this.skills[i] == skillId) { return true; }
        }
        return false;
    }

    // 施加增益并返回实例；definition 为 null 返回 null。unique 为
    // true 且同 Id 增益已在身时返回 null 不重复施加，false 时允许
    // 同名增益叠加多份。
    ArpgBuffInstance ApplyBuff(
        ArpgBuffDefinition definition,
        ArpgActor source,
        bool unique
    ) {
        if (definition == null) { return null; }
        if (unique && this.HasBuff(definition.Id())) { return null; }
        ArpgBuffInstance instance =
            ArpgBuffInstance.CreateFrom(definition, source);
        this.activeBuffs.Add(instance);
        return instance;
    }

    // 移除全部同 Id 增益（含叠加的多份）。
    void RemoveBuff(string buffId) {
        int i = this.activeBuffs.Count - 1;
        while (i >= 0) {
            if (this.activeBuffs[i].Definition().Id() == buffId) {
                this.activeBuffs.RemoveAt(i);
            }
            i = i - 1;
        }
    }

    // 清空全部在身增益。
    void RemoveAllBuffs() {
        this.activeBuffs = new List<ArpgBuffInstance>();
    }

    // 是否身负指定 Id 的增益。
    bool HasBuff(string buffId) {
        for (int i = 0; i < this.activeBuffs.Count; i = i + 1) {
            if (this.activeBuffs[i].Definition().Id() == buffId) { return true; }
        }
        return false;
    }

    // 恢复 HP/MP，上界为有效 MaxHp/MaxMp、下界 0（负值即扣血）。
    // 返回 HP 的实际变化量（目标值 − 恢复前值）；已死亡时返回 0.0
    // 且无副作用。
    double Heal(double hp, double mp) {
        if (!this.alive) { return 0.0; }
        ArpgAttributes effective = this.EffectiveAttributes();
        double oldHp = this.attributes.Hp();
        double newHp = oldHp + hp;
        if (newHp > effective.MaxHp()) { newHp = effective.MaxHp(); }
        if (newHp < 0.0) { newHp = 0.0; }
        this.attributes.SetHp(newHp);

        double newMp = this.attributes.Mp() + mp;
        if (newMp > effective.MaxMp()) { newMp = effective.MaxMp(); }
        if (newMp < 0.0) { newMp = 0.0; }
        this.attributes.SetMp(newMp);
        return newHp - oldHp;
    }

    // 扣除 HP/MP 消耗（如技能施放）。余额不足返回 false 不扣除；
    // 注意 HP 判定要求剩余值必须大于 hp 消耗（不能扣到 0），
    // MP 判定为不小于。成功扣除返回 true。
    bool Spend(double hp, double mp) {
        if (!this.alive) { return false; }
        if (this.attributes.Hp() <= hp || this.attributes.Mp() < mp) {
            return false;
        }
        this.attributes.SetHp(this.attributes.Hp() - hp);
        this.attributes.SetMp(this.attributes.Mp() - mp);
        return true;
    }

    // 承受伤害：返回实际生效的伤害量（HP 被钳到 0 时小于 amount）。
    // HP 归 0 时自动置为死亡；已死亡或 amount ≤ 0 时返回 0.0 且
    // 无副作用。
    double TakeDamage(double amount) {
        if (!this.alive || amount <= 0.0) { return 0.0; }
        double oldHp = this.attributes.Hp();
        double newHp = oldHp - amount;
        if (newHp <= 0.0) {
            newHp = 0.0;
            this.alive = false;
        }
        this.attributes.SetHp(newHp);
        return oldHp - newHp;
    }

    // 将当前 HP/MP 钳制到 [0, 有效 Max] 区间；HP 钳后 ≤ 0 时置
    // 为死亡。适合在装备/增益变化后调用。
    void ClampVitals() {
        ArpgAttributes effective = this.EffectiveAttributes();
        double hp = this.attributes.Hp();
        double mp = this.attributes.Mp();
        if (hp > effective.MaxHp()) { hp = effective.MaxHp(); }
        if (mp > effective.MaxMp()) { mp = effective.MaxMp(); }
        if (hp < 0.0) { hp = 0.0; }
        if (mp < 0.0) { mp = 0.0; }
        this.attributes.SetHp(hp);
        this.attributes.SetMp(mp);
        if (hp <= 0.0) { this.alive = false; }
    }

    // 复活并恢复有效 MaxHp × hpPercent% 的生命（至少 1 点），
    // 同时置为存活；不影响 MP。
    void Revive(double hpPercent) {
        ArpgAttributes effective = this.EffectiveAttributes();
        double amount = effective.MaxHp() * hpPercent / 100.0;
        if (amount < 1.0) { amount = 1.0; }
        this.attributes.SetHp(amount);
        this.alive = true;
    }

    // 已学技能数量。
    int SkillCount() { return this.skills.Count; }
    // 按下标读取技能 Id；应配合 SkillCount 使用。
    string SkillAt(int index) { return this.skills[index]; }
    // 在身增益数量。
    int BuffCount() { return this.activeBuffs.Count; }
    // 按下标读取增益定义 Id；应配合 BuffCount 使用。
    string BuffAt(int index) {
        return this.activeBuffs[index].Definition().Id();
    }
    // 按下标读取增益实例（含剩余时长等运行时状态）。
    ArpgBuffInstance BuffInstanceAt(int index) {
        return this.activeBuffs[index];
    }
    // 按下标移除增益；index 越界行为未定义，应配合 BuffCount 使用。
    void RemoveBuffAt(int index) { this.activeBuffs.RemoveAt(index); }
}
