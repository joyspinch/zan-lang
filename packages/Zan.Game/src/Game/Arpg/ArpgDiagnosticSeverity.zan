using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 诊断级别：0=信息 1=警告 2=错误。
public class ArpgDiagnosticSeverity {
    // 信息级（0）。
    public static int Info() { return 0; }
    // 警告级（1）。
    public static int Warning() { return 1; }
    // 错误级（2），存在时 Validate 判定为不通过。
    public static int Error() { return 2; }
}
