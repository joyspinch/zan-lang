using System;
using System.Text;
using Gui;

namespace Game.Arpg;

// 富文本解析结果：原始输入与按序排列的 run 列表。绘制/布局层
// 遍历 runs 并按各 run 的 Kind 分派处理。
// 薄适配：包住 Gui.RichTextDocument；RunAt 的 Arpg 包装按需建
// 一次并缓存（文档随后 Add 时缓存惰性续建）。
public class ArpgRichTextDocument {
    Gui.RichTextDocument inner;
    public List<ArpgRichTextRun> cache;

    public ArpgRichTextDocument(string sourceText) {
        this.inner = new Gui.RichTextDocument(sourceText);
        this.cache = null;
    }

    public ArpgRichTextDocument(Gui.RichTextDocument inner) {
        this.inner = inner;
        this.cache = null;
    }

    // 把包装缓存补到与内部 run 数一致。
    public void SyncCache() {
        int count = this.inner.RunCount();
        if (this.cache == null) { this.cache = new List<ArpgRichTextRun>(); }
        while (this.cache.Count < count) {
            this.cache.Add(new ArpgRichTextRun(
                this.inner.RunAt(this.cache.Count)));
        }
    }

    // 解析前的原始输入。
    public string SourceText() { return this.inner.SourceText(); }
    // run 总数。
    public int RunCount() { return this.inner.RunCount(); }
    // 第 index 个 run（不查越界）。
    public ArpgRichTextRun RunAt(int index) {
        this.SyncCache();
        return this.cache[index];
    }
    // 追加一个 run 到末尾。
    public void Add(ArpgRichTextRun run) { this.inner.Add(run.Inner()); }
}
