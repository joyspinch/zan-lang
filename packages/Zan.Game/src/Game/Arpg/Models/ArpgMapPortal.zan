namespace Game.Arpg;

// 传送门定义：踩到 (gridX, gridY) 时切到 targetMapId 的
// (targetGridX, targetGridY)。id 由 SetId 指定后可用于事件定位。
class ArpgMapPortal {
    int gridX;
    int gridY;
    string targetMapId;
    int targetGridX;
    int targetGridY;
    int targetDirection;
    bool clearTargetMap;
    int id;

    ArpgMapPortal(
        int gridX,
        int gridY,
        string targetMapId,
        int targetGridX,
        int targetGridY
    ) {
        this.gridX = gridX;
        this.gridY = gridY;
        this.targetMapId = targetMapId;
        this.targetGridX = targetGridX;
        this.targetGridY = targetGridY;
        this.targetDirection = 0;
        this.clearTargetMap = false;
        this.id = 0;
    }

    // 传送门所在格 X。
    int GridX() { return this.gridX; }
    // 传送门所在格 Y。
    int GridY() { return this.gridY; }
    // 目标地图 Id（切图后 ArpgMapChanged 回调的 currentMapId）。
    string TargetMapId() { return this.targetMapId; }
    // 落点格 X。
    int TargetGridX() { return this.targetGridX; }
    // 落点格 Y。
    int TargetGridY() { return this.targetGridY; }
    // 落点朝向（0~7），默认 0。
    int TargetDirection() { return this.targetDirection; }
    // true 时到达后清空目标地图数据（一次性传送，防回传死循环）。
    bool ClearTargetMap() { return this.clearTargetMap; }
    // 传送门 Id（默认 0，事件回调中非传送门切图为 -1）。
    int Id() { return this.id; }
    // 设置落点朝向（0~7）。
    void SetTargetDirection(int newValue) { this.targetDirection = newValue; }
    // 设置是否清空目标地图数据（一次性传送）。
    void SetClearTargetMap(bool newValue) { this.clearTargetMap = newValue; }
    // 设置传送门 Id。
    void SetId(int newValue) { this.id = newValue; }
}
