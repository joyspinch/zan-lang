using System;

namespace Game.Arpg;

// 具名自定义属性条目：name 匹配键，amount 为该属性的数值贡献。
// 由 ArpgAttributes 的 Set/Get 按名字管理，一般不直接构造。
public class ArpgCustomAttribute {
    public string name;
    public double amount;

    public ArpgCustomAttribute(string name, double amount) {
        this.name = name;
        this.amount = amount;
    }

    // 自定义属性名（区分大小写，作为唯一匹配键）。
    public string Name() { return this.name; }
    // 该属性的数值贡献。
    public double Amount() { return this.amount; }
    // 修改该属性的数值贡献。
    public void SetAmount(double amount) { this.amount = amount; }
}
