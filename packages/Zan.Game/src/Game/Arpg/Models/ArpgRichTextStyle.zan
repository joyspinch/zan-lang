using System;
using System.Text;
using Gui;

namespace Game.Arpg;

// 富文本样式快照：前景/背景色、字体名与水平对齐。
// 解析过程中随 #c/#bg/#f/#md/#rt 等标签变化，并拷贝进
// 后续创建的 run。对齐取值：0=左，1=中（#md），2=右（#rt）。
// 薄适配：存取委托 Gui.RichTextStyle，颜色在边界换算。
class ArpgRichTextStyle {
    Gui.RichTextStyle inner;

    ArpgRichTextStyle(
        ArpgColor color,
        ArpgColor background,
        string font,
        int alignment
    ) {
        this.inner = new Gui.RichTextStyle(
            ArpgRichText.PackColor(color),
            ArpgRichText.PackColor(background),
            font,
            alignment);
    }

    ArpgRichTextStyle(Gui.RichTextStyle inner) {
        this.inner = inner;
    }

    // 内部 Gui 样式对象（适配层内部用）。
    Gui.RichTextStyle Inner() { return this.inner; }

    // 默认样式：白字、透明背景、空字体名、左对齐。
    static ArpgRichTextStyle Default() {
        return new ArpgRichTextStyle(Gui.RichTextStyle.Default());
    }

    // 返回独立副本（修改副本不影响原样式）。
    ArpgRichTextStyle Clone() {
        return new ArpgRichTextStyle(this.inner.Clone());
    }

    // 当前前景色。
    ArpgColor Color() { return ArpgRichText.UnpackColor(this.inner.Color()); }
    // 当前背景色。
    ArpgColor Background() {
        return ArpgRichText.UnpackColor(this.inner.Background());
    }
    // 当前字体名（空串表示默认字体）。
    string Font() { return this.inner.Font(); }
    // 当前水平对齐：0=左，1=中（#md），2=右（#rt）。
    int Alignment() { return this.inner.Alignment(); }
    // 设置前景色（影响后续创建的 run）。
    void SetColor(ArpgColor newValue) {
        this.inner.SetColor(ArpgRichText.PackColor(newValue));
    }
    // 设置背景色。
    void SetBackground(ArpgColor newValue) {
        this.inner.SetBackground(ArpgRichText.PackColor(newValue));
    }
    // 设置字体名。
    void SetFont(string newValue) { this.inner.SetFont(newValue); }
    // 设置水平对齐（0=左 1=中 2=右）。
    void SetAlignment(int newValue) { this.inner.SetAlignment(newValue); }
}
