namespace Game.Arpg;

// WebSocketClient 组件配置：{ 类型, 名称, 地址 }，连接到
// ws:// 或 wss:// 地址。
public class WebSocketClientConfig {
    public string kind;  // 类型: fixed "WebSocketClient"
    public string name;  // 名称: globally unique id
    // 服务器地址（ws:// 或 wss:// URL）。
    public string url;  // 地址: server url (ws:// or wss://)

    public WebSocketClientConfig(string name) {
        this.kind = "WebSocketClient";
        this.name = name;
        this.url = "";
    }
    // 设置服务器地址（ws:// 或 wss:// URL）；返回 this。
    public WebSocketClientConfig SetUrl(string url) { this.url = url; return this; }
    // 组件类型标识，固定为 "WebSocketClient"。
    public string Kind() { return this.kind; }
    // 组件全局唯一名称。
    public string Name() { return this.name; }
    // 服务器地址（ws:// 或 wss:// URL，默认空串）。
    public string Url() { return this.url; }
}
