using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 单个动画属性目标：属性名 + 终值/增量。to 步骤中 amount 为
// 绝对终值，by 步骤中为相对增量。
class TweenTarget {
    string prop;  // property name, e.g. "x" / "y" / "透明度"
    double amount;  // 目标值

    // 构造属性目标。
    static TweenTarget Of(string prop, double amount) {
        TweenTarget t = new TweenTarget();
        t.prop = prop;
        t.amount = amount;
        return t;
    }
    // 属性名（如 "x" / "y" / "透明度"）。
    string Prop() { return this.prop; }
    // 目标值（to 为绝对值，by 为增量）。
    double Amount() { return this.amount; }
}
