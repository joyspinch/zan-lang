using System;
using System.Text;
using Gui;

namespace Game.Arpg;

// 富文本解析产物的单个片段（run）：一段文本、一张图片、一个
// 动画、一个占位或一次换行。携带创建时刻的样式快照与所在链接
// （非链接 run 的 Link 为 null），布局/绘制层按 Kind 分派处理。
// 薄适配：包住 Gui.RichTextRun，样式/链接包装按需建一次。
class ArpgRichTextRun {
    Gui.RichTextRun inner;
    ArpgRichTextStyle styleWrap;
    ArpgRichTextLink linkWrap;

    ArpgRichTextRun(
        int kind,
        ArpgRichTextStyle style,
        ArpgRichTextLink link
    ) {
        Gui.RichTextLink innerLink = null;
        if (link != null) { innerLink = link.Inner(); }
        this.inner = new Gui.RichTextRun(
            kind, style.Inner(), innerLink);
        this.styleWrap = null;
        this.linkWrap = null;
    }

    ArpgRichTextRun(Gui.RichTextRun inner) {
        this.inner = inner;
        this.styleWrap = null;
        this.linkWrap = null;
    }

    // 内部 Gui run 对象（适配层内部用）。
    Gui.RichTextRun Inner() { return this.inner; }

    // 创建一个默认样式、无链接的纯文本 run。
    static ArpgRichTextRun CreateText(string text) {
        return new ArpgRichTextRun(Gui.RichTextRun.CreateText(text));
    }

    // run 类型（ArpgRichTextRunKind 常量）。
    int Kind() { return this.inner.Kind(); }
    // 文本内容（仅 Text run 有意义，其他为空串）。
    string Text() { return this.inner.Text(); }
    // 资源 Id（Image/Animation/Item run）。
    string Resource() { return this.inner.Resource(); }
    // 动画动作名（仅 Animation run 有意义）。
    string Action() { return this.inner.Action(); }
    // 物品数量（仅 Item run 有意义）。
    int Quantity() { return this.inner.Quantity(); }
    // 相对排版位置的 X 偏移（像素）。
    int OffsetX() { return this.inner.OffsetX(); }
    // 相对排版位置的 Y 偏移（像素）。
    int OffsetY() { return this.inner.OffsetY(); }
    // 宽度（像素；图片/动画未指定时布局按字号兜底）。
    int Width() { return this.inner.Width(); }
    // 高度（像素；未指定时布局按字号兜底）。
    int Height() { return this.inner.Height(); }
    // 动画缩放（默认 1.0）。
    double Scale() { return this.inner.Scale(); }
    // 创建时刻的样式快照（独立副本，修改不影响其他 run）。
    ArpgRichTextStyle Style() {
        if (this.styleWrap == null) {
            this.styleWrap = new ArpgRichTextStyle(this.inner.Style());
        }
        return this.styleWrap;
    }
    // 所在链接；非链接 run 返回 null。
    ArpgRichTextLink Link() {
        Gui.RichTextLink innerLink = this.inner.Link();
        if (innerLink == null) { return null; }
        if (this.linkWrap == null) {
            this.linkWrap = new ArpgRichTextLink(innerLink);
        }
        return this.linkWrap;
    }
    // 该 run 是否位于超链接内。
    bool IsLink() { return this.inner.IsLink(); }

    // 设置文本内容。
    void SetText(string newValue) { this.inner.SetText(newValue); }
    // 设置资源 Id。
    void SetResource(string newValue) { this.inner.SetResource(newValue); }
    // 设置动画动作名。
    void SetAction(string newValue) { this.inner.SetAction(newValue); }
    // 设置物品数量。
    void SetQuantity(int newValue) { this.inner.SetQuantity(newValue); }
    // 同时设置 X/Y 偏移（像素）。
    void SetOffset(int x, int y) { this.inner.SetOffset(x, y); }
    // 同时设置宽高（像素）。
    void SetSize(int width, int height) {
        this.inner.SetSize(width, height);
    }
    // 设置动画缩放。
    void SetScale(double newValue) { this.inner.SetScale(newValue); }
}
