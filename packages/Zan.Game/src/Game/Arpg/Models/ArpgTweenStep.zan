using System;
using System.Collections.Generic;

namespace Game.Arpg;

// to   —— 将目标对象的属性动画到绝对值
// by   —— 按相对增量进行动画
// wait —— 延时
// call —— 调用具名回调
// 缓动时间线中的单步：to（把目标对象属性动画到绝对值）、
// by（按相对增量动画）、wait（延时）、call（调用具名回调）。
// 经 To/By/Wait/Call 工厂创建，Set 链式追加属性目标。
public class ArpgTweenStep : IDisposable {
    public string op;  // "to" / "by" / "wait" / "call"
    public string target;  // 目标对象标识符（to/by）
    public List<TweenTarget> props;  // 属性目标（to/by）
    public int duration;  // 时长（毫秒，to/by/wait）
    public ArpgEasing easing;  // 缓动类型 (to/by)
    public string callback;  // 回调 id（call）

    // 创建 to 步骤：duration 为毫秒，easing 为缓动曲线。
    public static ArpgTweenStep To(string target, int duration, ArpgEasing easing) {
        ArpgTweenStep s = new ArpgTweenStep();
        s.op = "to";
        s.target = target;
        s.props = new List<TweenTarget>();
        s.duration = duration;
        s.easing = easing;
        s.callback = "";
        return s;
    }
    // 创建 by 步骤（属性按相对增量动画）。
    public static ArpgTweenStep By(string target, int duration, ArpgEasing easing) {
        ArpgTweenStep s = ArpgTweenStep.To(target, duration, easing);
        s.op = "by";
        return s;
    }
    // 创建 wait 步骤：duration 为毫秒延时。
    public static ArpgTweenStep Wait(int duration) {
        ArpgTweenStep s = new ArpgTweenStep();
        s.op = "wait";
        s.target = "";
        s.props = new List<TweenTarget>();
        s.duration = duration;
        s.easing = ArpgEasing.Linear;
        s.callback = "";
        return s;
    }
    // 创建 call 步骤：callback 为注册的回调标识，不占用时长。
    public static ArpgTweenStep Call(string callback) {
        ArpgTweenStep s = new ArpgTweenStep();
        s.op = "call";
        s.target = "";
        s.props = new List<TweenTarget>();
        s.duration = 0;
        s.easing = ArpgEasing.Linear;
        s.callback = callback;
        return s;
    }

    // 追加一个属性目标并返回 this（链式）。
    public ArpgTweenStep Set(string prop, double amount) {
        this.props.Add(TweenTarget.Of(prop, amount));
        return this;
    }
    // 步骤类型（"to"/"by"/"wait"/"call"）。
    public string Op() { return this.op; }
    // 目标对象标识符（wait/call 为空串）。
    public string Target() { return this.target; }
    // 时长（毫秒；call 为 0）。
    public int Duration() { return this.duration; }
    // 缓动曲线。
    public ArpgEasing Curve() { return this.easing; }
    // 回调标识（仅 call 有意义）。
    public string Callback() { return this.callback; }
    // 属性目标个数。
    public int PropCount() { return this.props.Count; }
    // 第 index 个属性目标（不查越界）。
    public TweenTarget PropAt(int index) { return this.props[index]; }

    // 释放属性目标集合（之后不应再使用本步骤）。
    public void Dispose() {
        this.props.Clear();
        this.props = null;
        this.op = null;
        this.target = null;
        this.callback = null;
    }
}
