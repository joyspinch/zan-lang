namespace Game.Arpg;

// 地图格子：位置 + 类型（1 普通、2 半透明障碍、3 阻挡）。阻挡
// 类型为 1 或 3，遮挡视野类型为 2 或 3。由 AddCell 挂到地图。
class ArpgMapCell {
    int x;
    int y;
    int cellType;

    ArpgMapCell(int x, int y, int cellType) {
        this.x = x;
        this.y = y;
        this.cellType = cellType;
    }

    // 格子 X 坐标（格）。
    int X() { return this.x; }
    // 格子 Y 坐标（格）。
    int Y() { return this.y; }
    // 格子类型（1 普通、2 半透明障碍、3 阻挡）。
    int CellType() { return this.cellType; }
    // 是否阻挡移动（类型 1 或 3）。
    bool IsBlocked() { return this.cellType == 1 || this.cellType == 3; }
    // 是否遮挡视野（类型 2 或 3）。
    bool IsTransparent() { return this.cellType == 2 || this.cellType == 3; }
}
