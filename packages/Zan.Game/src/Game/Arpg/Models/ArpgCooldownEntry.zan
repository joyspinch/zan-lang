namespace Game.Arpg;

// 单个生效中的冷却：名称、剩余毫秒与总时长毫秒。
class ArpgCooldownEntry {
    // 冷却名（如 "skill:fire"）。
    public string name;
    // 剩余毫秒。
    public int remaining;
    // 启动时的总时长毫秒（供进度计算）。
    public int duration;

    // 构造一条冷却记录。
    ArpgCooldownEntry(string name, int remaining, int duration) {
        this.name = name;
        this.remaining = remaining;
        this.duration = duration;
    }
}
