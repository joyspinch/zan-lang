using System;

namespace Game.Arpg;

// 无字体依赖的文本度量启发式：按 UTF-8 序列长度区分单字节与
// 多字节字符并估算宽度。仅供无真实字体度量时的回退排版。
public class ArpgTextMetrics {
    // 返回 text 中 index 处 UTF-8 字符的字节长度（1~4）；
    // 首字节非法时按前缀区间就近取值，不校验越界。
    public static int NextUtf8(string text, int index) {
        int first = text[index] & 255;
        if (first < 128) { return index + 1; }
        if (first < 224) { return index + 2; }
        if (first < 240) { return index + 3; }
        return index + 4;
    }

    // 单个字形的估算宽度（像素）：纯字节判断，彻底消除 Substring 与字符串比较。
    public static int GlyphWidthByte(int firstByte, int fontSize) {
        if (firstByte < 128) {
            if (firstByte == 32 || firstByte == 9) {
                return ArpgMath.Max(1, fontSize / 3);
            }
            return ArpgMath.Max(1, fontSize * 3 / 5);
        }
        return fontSize;
    }

    // 单个字形的估算宽度（像素）：兼容字符串重载。
    public static int GlyphWidth(string glyph, int fontSize) {
        if (glyph == null || glyph.Length == 0) { return 0; }
        return GlyphWidthByte(glyph[0] & 255, fontSize);
    }

    // 整段文本的估算宽度（像素）：单趟直接字节扫描，彻底消除逐字符 Substring 堆分配。
    public static int Measure(string text, int fontSize) {
        if (text == null) { return 0; }
        int width = 0;
        int index = 0;
        int len = text.Length;
        int spaceW = ArpgMath.Max(1, fontSize / 3);
        int asciiW = ArpgMath.Max(1, fontSize * 3 / 5);
        while (index < len) {
            int b = text[index] & 255;
            if (b < 128) {
                if (b == 32 || b == 9) {
                    width = width + spaceW;
                } else {
                    width = width + asciiW;
                }
                index = index + 1;
            } else {
                width = width + fontSize;
                if (b < 224) { index = index + 2; }
                else if (b < 240) { index = index + 3; }
                else { index = index + 4; }
            }
        }
        return width;
    }
}
