using System;

namespace Game.Arpg;

// 角色、物品、技能与增益共用的基础数值属性。
// 自定义数值属性，与 DM3 的扩展属性模型一致。
public class ArpgAttributes {
    public double hp;
    public double mp;
    public double maxHp;
    public double maxMp;
    public double accuracy;
    public double evasion;
    public double criticalChance;
    public double criticalDamage;
    public double moveSpeedPercent;
    public double attackSpeedPercent;
    public List<ArpgCustomAttribute> custom;

    public ArpgAttributes() {
        this.criticalDamage = 150.0;
        this.custom = new List<ArpgCustomAttribute>();
    }

    // 当前 HP（会随 Heal/TakeDamage/Spend 变化，受有效 MaxHp 钳制）。
    public double Hp() { return this.hp; }
    // 当前 MP（会随 Heal/Spend 变化，受有效 MaxMp 钳制）。
    public double Mp() { return this.mp; }
    // 基础最大 HP（不含装备/增益修饰，修饰看 EffectiveAttributes）。
    public double MaxHp() { return this.maxHp; }
    // 基础最大 MP（不含装备/增益修饰）。
    public double MaxMp() { return this.maxMp; }
    // 命中率基准值。
    public double Accuracy() { return this.accuracy; }
    // 闪避率基准值。
    public double Evasion() { return this.evasion; }
    // 暴击概率（百分比数值，由结算方解释）。
    public double CriticalChance() { return this.criticalChance; }
    // 暴击伤害倍率（百分比，默认 150.0 即 1.5 倍）。
    public double CriticalDamage() { return this.criticalDamage; }
    // 移动速度加成（百分比，0 为不加成）。
    public double MoveSpeedPercent() { return this.moveSpeedPercent; }
    // 攻击速度加成（百分比，0 为不加成）。
    public double AttackSpeedPercent() { return this.attackSpeedPercent; }

    // 设置当前 HP（不做钳制，越界后应调用 ClampVitals）。
    public void SetHp(double amount) { this.hp = amount; }
    // 设置当前 MP（不做钳制）。
    public void SetMp(double amount) { this.mp = amount; }
    // 设置基础最大 HP。
    public void SetMaxHp(double amount) { this.maxHp = amount; }
    // 设置基础最大 MP。
    public void SetMaxMp(double amount) { this.maxMp = amount; }
    // 设置命中率基准值。
    public void SetAccuracy(double amount) { this.accuracy = amount; }
    // 设置闪避率基准值。
    public void SetEvasion(double amount) { this.evasion = amount; }
    // 设置暴击概率。
    public void SetCriticalChance(double amount) { this.criticalChance = amount; }
    // 设置暴击伤害倍率（百分比）。
    public void SetCriticalDamage(double amount) { this.criticalDamage = amount; }
    // 设置移动速度加成（百分比）。
    public void SetMoveSpeedPercent(double amount) { this.moveSpeedPercent = amount; }
    // 设置攻击速度加成（百分比）。
    public void SetAttackSpeedPercent(double amount) { this.attackSpeedPercent = amount; }

    // 设置或累加自定义属性：同名条目已存在则覆盖其数值，否则追加
    // 新条目。名字区分大小写。
    public void SetCustom(string name, double amount) {
        for (int i = 0; i < this.custom.Count; i = i + 1) {
            ArpgCustomAttribute attribute = this.custom[i];
            if (attribute.Name() == name) {
                attribute.SetAmount(amount);
                return;
            }
        }
        this.custom.Add(new ArpgCustomAttribute(name, amount));
    }

    // 读取自定义属性数值；不存在同名条目时返回 0.0。
    public double GetCustom(string name) {
        for (int i = 0; i < this.custom.Count; i = i + 1) {
            ArpgCustomAttribute attribute = this.custom[i];
            if (attribute.Name() == name) {
                return attribute.Amount();
            }
        }
        return 0.0;
    }

    // 获取自定义属性数值（GetCustom 的简写别名）。
    public double Get(string name) { return this.GetCustom(name); }

    // 累加另一组属性的全部数值（含当前 HP/MP 与自定义属性）。
    // criticalDamage 按增量累加（对方超出 150 的部分）。用于把
    // 定义的基础属性灌入实例。
    public void AddFrom(ArpgAttributes other) {
        this.hp = this.hp + other.Hp();
        this.mp = this.mp + other.Mp();
        this.maxHp = this.maxHp + other.MaxHp();
        this.maxMp = this.maxMp + other.MaxMp();
        this.accuracy = this.accuracy + other.Accuracy();
        this.evasion = this.evasion + other.Evasion();
        this.criticalChance = this.criticalChance + other.CriticalChance();
        this.criticalDamage = this.criticalDamage + other.CriticalDamage() - 150.0;
        this.moveSpeedPercent = this.moveSpeedPercent + other.MoveSpeedPercent();
        this.attackSpeedPercent = this.attackSpeedPercent + other.AttackSpeedPercent();
        for (int i = 0; i < other.CustomCount(); i = i + 1) {
            ArpgCustomAttribute attribute = other.CustomAt(i);
            this.SetCustom(
                attribute.Name(),
                this.GetCustom(attribute.Name()) + attribute.Amount());
        }
    }

    // 仅累加修饰性数值（maxHp/maxMp/命中/闪避/暴击/速度与自定义
    // 属性），不动当前 HP/MP。装备与增益加成走此入口，避免直接
    // 回血回蓝。criticalDamage 按增量累加。
    public void AddModifiersFrom(ArpgAttributes other) {
        this.maxHp = this.maxHp + other.MaxHp();
        this.maxMp = this.maxMp + other.MaxMp();
        this.accuracy = this.accuracy + other.Accuracy();
        this.evasion = this.evasion + other.Evasion();
        this.criticalChance = this.criticalChance + other.CriticalChance();
        this.criticalDamage = this.criticalDamage + other.CriticalDamage() - 150.0;
        this.moveSpeedPercent = this.moveSpeedPercent + other.MoveSpeedPercent();
        this.attackSpeedPercent = this.attackSpeedPercent + other.AttackSpeedPercent();
        for (int i = 0; i < other.CustomCount(); i = i + 1) {
            ArpgCustomAttribute attribute = other.CustomAt(i);
            this.SetCustom(
                attribute.Name(),
                this.GetCustom(attribute.Name()) + attribute.Amount());
        }
    }

    // 深拷贝全部数值与自定义属性（自定义条目也逐个复制）。
    public ArpgAttributes Clone() {
        ArpgAttributes copy = new ArpgAttributes();
        copy.SetHp(this.hp);
        copy.SetMp(this.mp);
        copy.SetMaxHp(this.maxHp);
        copy.SetMaxMp(this.maxMp);
        copy.SetAccuracy(this.accuracy);
        copy.SetEvasion(this.evasion);
        copy.SetCriticalChance(this.criticalChance);
        copy.SetCriticalDamage(this.criticalDamage);
        copy.SetMoveSpeedPercent(this.moveSpeedPercent);
        copy.SetAttackSpeedPercent(this.attackSpeedPercent);
        for (int i = 0; i < this.custom.Count; i = i + 1) {
            copy.SetCustom(this.custom[i].Name(), this.custom[i].Amount());
        }
        return copy;
    }

    // 自定义属性条目数。
    public int CustomCount() { return this.custom.Count; }
    // 按下标读取自定义属性条目；应配合 CustomCount 使用。
    public ArpgCustomAttribute CustomAt(int index) { return this.custom[index]; }
}
