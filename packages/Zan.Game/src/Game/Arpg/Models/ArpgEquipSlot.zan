namespace Game.Arpg;

// 一件装备与其槽位名的绑定。
public class ArpgEquipSlot {
    // 槽位名（如 "weapon"、"armor"）。
    public string slot;
    // 该槽位当前装备的物品定义。
    public ArpgItemDefinition item;

    // 构造一个槽位绑定。
    public ArpgEquipSlot(string slot, ArpgItemDefinition item) {
        this.slot = slot;
        this.item = item;
    }
}
