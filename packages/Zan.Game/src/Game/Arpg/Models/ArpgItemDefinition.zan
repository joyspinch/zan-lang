using System;

namespace Game.Arpg;

// 物品定义：Id 与 DisplayName 必填，其余字段有默认值，通过 Set*
// 逐项配置。冷却按 CooldownGroup 共享（毫秒）；消耗品用 SetRestore
// 配置恢复量；Validate 在配置加载后校验合法性。
public class ArpgItemDefinition {
    public string id;
    public string displayName;
    public string iconResource;
    public string tooltip;
    public string category;
    public string subcategory;
    public string detailCategory;
    public string cooldownGroup;
    public int cooldownMilliseconds;
    public int maxStack;
    public bool discardDisabled;
    public int disappearMilliseconds;
    public int requiredLevel;
    public int restoreHp;
    public int restoreMp;
    public double restoreHpPercent;
    public double restoreMpPercent;
    public ArpgAttributes attributes;

    public ArpgItemDefinition(string id, string displayName) {
        this.id = id;
        this.displayName = displayName;
        this.iconResource = "";
        this.tooltip = "";
        this.category = ArpgItemCategory.Item();
        this.subcategory = "";
        this.detailCategory = "";
        this.cooldownGroup = "";
        this.cooldownMilliseconds = 0;
        this.maxStack = 1;
        this.discardDisabled = false;
        this.disappearMilliseconds = 40000;
        this.requiredLevel = 1;
        this.restoreHp = 0;
        this.restoreMp = 0;
        this.restoreHpPercent = 0.0;
        this.restoreMpPercent = 0.0;
        this.attributes = new ArpgAttributes();
    }

    // 物品唯一 Id（配置键，创建后不变）。
    public string Id() { return this.id; }
    // 显示名（必填，用于 UI 展示）。
    public string DisplayName() { return this.displayName; }
    // 图标资源路径，默认空串。
    public string IconResource() { return this.iconResource; }
    // 悬浮提示文本，默认空串。
    public string Tooltip() { return this.tooltip; }
    // 物品分类（ArpgItemCategory 常量之一，默认 "item"）。
    public string Category() { return this.category; }
    // 子分类自由文本，默认空串。
    public string Subcategory() { return this.subcategory; }
    // 细分类自由文本，默认空串。
    public string DetailCategory() { return this.detailCategory; }
    // 冷却组名；同组物品共享冷却，空串表示不参与组冷却。
    public string CooldownGroup() { return this.cooldownGroup; }
    // 冷却时长（毫秒），默认 0 表示无冷却。
    public int CooldownMilliseconds() { return this.cooldownMilliseconds; }
    // 单格最大堆叠数，默认 1（不可堆叠）。
    public int MaxStack() { return this.maxStack; }
    // true 时禁止丢弃（只能使用或卖出等业务途径移除）。
    public bool DiscardDisabled() { return this.discardDisabled; }
    // 掉落物消失时间（毫秒），默认 40000；-1 表示永不消失。
    public int DisappearMilliseconds() { return this.disappearMilliseconds; }
    // 使用所需最低角色等级，默认 1。
    public int RequiredLevel() { return this.requiredLevel; }
    // 使用时固定恢复的 HP 点数，默认 0。
    public int RestoreHp() { return this.restoreHp; }
    // 使用时固定恢复的 MP 点数，默认 0。
    public int RestoreMp() { return this.restoreMp; }
    // 使用时按最大值百分比恢复的 HP（0.0~1.0 小数），默认 0.0。
    public double RestoreHpPercent() { return this.restoreHpPercent; }
    // 使用时按最大值百分比恢复的 MP（0.0~1.0 小数），默认 0.0。
    public double RestoreMpPercent() { return this.restoreMpPercent; }
    // 装备/使用附带的属性加成集合（只读视图，配置期通过其 Set* 修改）。
    public ArpgAttributes Attributes() { return this.attributes; }

    // 设置图标资源路径。
    public void SetIconResource(string newValue) { this.iconResource = newValue; }
    // 设置悬浮提示文本。
    public void SetTooltip(string newValue) { this.tooltip = newValue; }
    // 设置物品分类，取值应为 ArpgItemCategory 的常量。
    public void SetCategory(string newValue) { this.category = newValue; }
    // 设置子分类文本。
    public void SetSubcategory(string newValue) { this.subcategory = newValue; }
    // 设置细分类文本。
    public void SetDetailCategory(string newValue) { this.detailCategory = newValue; }
    // 设置冷却组与冷却时长（毫秒）；同组物品共享冷却。
    public void SetCooldown(string group, int milliseconds) {
        this.cooldownGroup = group;
        this.cooldownMilliseconds = milliseconds;
    }
    // 设置单格最大堆叠数。
    public void SetMaxStack(int newValue) { this.maxStack = newValue; }
    // 设置是否禁止丢弃。
    public void SetDiscardDisabled(bool newValue) { this.discardDisabled = newValue; }
    // 设置掉落物消失时间（毫秒）；-1 表示永不消失。
    public void SetDisappearMilliseconds(int newValue) { this.disappearMilliseconds = newValue; }
    // 设置使用所需最低等级。
    public void SetRequiredLevel(int newValue) { this.requiredLevel = newValue; }
    // 一次性设置恢复量：固定点数与最大值百分比可同时生效。
    public void SetRestore(int hp, int mp, double hpPercent, double mpPercent) {
        this.restoreHp = hp;
        this.restoreMp = mp;
        this.restoreHpPercent = hpPercent;
        this.restoreMpPercent = mpPercent;
    }

    // 校验物品配置合法性，问题以错误码 L2ITM001~L2ITM006 写入
    // diagnostics（必填字段缺失、maxStack/requiredLevel 非正、
    // 冷却为负、消失时间小于 -1）。应在配置加载完成后调用一次。
    public void Validate(ArpgDiagnostics diagnostics) {
        string path = "items." + this.id;
        ArpgValidation.Required(diagnostics, this.id, "items", "L2ITM001");
        ArpgValidation.Required(
            diagnostics, this.displayName, path + ".displayName", "L2ITM002");
        ArpgValidation.Positive(
            diagnostics, this.maxStack, path + ".maxStack", "L2ITM003");
        ArpgValidation.Positive(
            diagnostics, this.requiredLevel, path + ".requiredLevel", "L2ITM004");
        if (this.cooldownMilliseconds < 0) {
            diagnostics.AddError(
                "L2ITM005", path + ".cooldown", "Cooldown cannot be negative.");
        }
        if (this.disappearMilliseconds < -1) {
            diagnostics.AddError(
                "L2ITM006",
                path + ".disappearMilliseconds",
                "Disappear time must be -1 or a non-negative value.");
        }
    }
}
