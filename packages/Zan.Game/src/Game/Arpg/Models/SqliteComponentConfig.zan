namespace Game.Arpg;

// SqliteDB 组件配置: { 类型="Sqlite", 名称=... }。扩展组件中引用的
// Sqlite 数据库组件；运行期方法（打开/执行）作用于实时对象。
public class SqliteComponentConfig {
    public string kind;  // 类型: fixed "Sqlite"
    public string name;  // 名称: globally unique id

    public SqliteComponentConfig(string name) {
        this.kind = "Sqlite";
        this.name = name;
    }
    // 组件类型标识，固定为 "Sqlite"。
    public string Kind() { return this.kind; }
    // 组件全局唯一名称。
    public string Name() { return this.name; }
}
