using System;

namespace Game.Arpg;

// 资源注册条目：id 为引用键，file 为文件路径。
public class ArpgResource {
    public string id;
    public string file;

    public ArpgResource(string id, string file) {
        this.id = id;
        this.file = file;
    }

    // 兼容只读访问接口
    public string Id() { return this.id; }
    public string File() { return this.file; }
}
