using System;

namespace Game.Arpg;

// 按名称管理的冷却集合。同名 Start 覆盖重置；Tick 递减剩余
// 时间，到 0 的条目自动移除。冷却时间单位均为毫秒。
public class ArpgCooldowns {
    public List<ArpgCooldownEntry> entries;

    // 构造空冷却集合。
    public ArpgCooldowns() {
        this.entries = new List<ArpgCooldownEntry>();
    }

    // 冷却名对应下标；不存在返回 -1。
    public int IndexOf(string name) {
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            if (this.entries[i].name == name) { return i; }
        }
        return -1;
    }

    // 启动/重置指定冷却。name 为 null/空或 milliseconds ≤ 0 时
    // 忽略；同名冷却被覆盖。
    public void Start(string name, int milliseconds) {
        if (name == null || name == "" || milliseconds <= 0) { return; }
        int index = this.IndexOf(name);
        if (index < 0) {
            this.entries.Add(new ArpgCooldownEntry(name, milliseconds, milliseconds));
        } else {
            this.entries[index].remaining = milliseconds;
            this.entries[index].duration = milliseconds;
        }
    }

    // 冷却是否就绪（未启动或剩余 ≤0 均视为就绪）。
    public bool IsReady(string name) {
        int index = this.IndexOf(name);
        return index < 0 || this.entries[index].remaining <= 0;
    }

    // 剩余毫秒；未启动该冷却返回 0。
    public int Remaining(string name) {
        int index = this.IndexOf(name);
        if (index < 0) { return 0; }
        return this.entries[index].remaining;
    }

    // 冷却进度百分比 0–100（已就绪/未启动为 100）。
    public int Progress(string name) {
        int index = this.IndexOf(name);
        if (index < 0 || this.entries[index].remaining <= 0) { return 100; }
        int duration = this.entries[index].duration;
        if (duration <= 0) { return 100; }
        return (duration - this.entries[index].remaining) * 100 / duration;
    }

    // 推进全部冷却并移除到期的条目；deltaMilliseconds ≤ 0 无效。
    public void Tick(int deltaMilliseconds) {
        if (deltaMilliseconds <= 0) { return; }
        int i = this.entries.Count - 1;
        while (i >= 0) {
            this.entries[i].remaining = this.entries[i].remaining - deltaMilliseconds;
            if (this.entries[i].remaining <= 0) {
                this.entries.RemoveAt(i);
            }
            i = i - 1;
        }
    }
}
