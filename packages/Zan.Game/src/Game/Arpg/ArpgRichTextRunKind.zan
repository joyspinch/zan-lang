using System;
using System.Text;
using Gui;

namespace Game.Arpg;

// 富文本 run 类型常量：Text=0 纯文本、Image=1 图片（#p）、
// Animation=2 动画（#a）、Spacer=3 空白占位（#z）、
// Item=4 物品片段（#item）、LineBreak=5 换行（源文本 \n）、
// WrapWidth=6 换行宽度段（#br(宽度) 或 #md/#rt 携带宽度时）。
// 实现在 Gui.RichTextRunKind——富文本的解析与数据模型已经
// 统一收敛到 stdlib/Gui（组件都到 Gui 下），本命名空间只保留
// Arpg 时代的类型名作薄适配，外部工程无需迁移。
public class ArpgRichTextRunKind {
    // 纯文本 run 类型常量（0）。
    public static int Text() { return Gui.RichTextRunKind.Text(); }
    // 图片 run 类型常量（1），由 #p(资源,x,y,宽,高) 产生。
    public static int Image() { return Gui.RichTextRunKind.Image(); }
    // 动画 run 类型常量（2），由 #a(资源,动作,缩放,宽,高,x,y) 产生。
    public static int Animation() { return Gui.RichTextRunKind.Animation(); }
    // 空白占位 run 类型常量（3），由 #z(宽,高) 产生。
    public static int Spacer() { return Gui.RichTextRunKind.Spacer(); }
    // 物品片段 run 类型常量（4），由 #item(资源,数量) 产生。
    public static int Item() { return Gui.RichTextRunKind.Item(); }
    // 换行 run 类型常量（5），源文本中的每个 \n 产生一个。
    public static int LineBreak() { return Gui.RichTextRunKind.LineBreak(); }
    // 换行宽度 run 类型常量（6）；携带宽度时改变后续换行宽度，宽度 0 仅切换对齐。
    public static int WrapWidth() { return Gui.RichTextRunKind.WrapWidth(); }
}
