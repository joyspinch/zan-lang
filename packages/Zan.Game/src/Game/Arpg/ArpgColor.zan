using System;
using System.Collections.Generic;

namespace Game.Arpg;

// Arpg 定义使用的 RGBA 颜色。构造时各通道钳制到 0–255。
public class ArpgColor {
    public int red;
    public int green;
    public int blue;
    public int alpha;

    // 构造颜色；各分量在构造时钳制到 [0,255]。
    public ArpgColor(int red, int green, int blue, int alpha) {
        this.red = ArpgMath.Clamp(red, 0, 255);
        this.green = ArpgMath.Clamp(green, 0, 255);
        this.blue = ArpgMath.Clamp(blue, 0, 255);
        this.alpha = ArpgMath.Clamp(alpha, 0, 255);
    }

    // 完全透明（0,0,0,0）。
    public static ArpgColor Transparent() { return new ArpgColor(0, 0, 0, 0); }
    // 不透明黑。
    public static ArpgColor Black() { return new ArpgColor(0, 0, 0, 255); }
    // 不透明白。
    public static ArpgColor White() { return new ArpgColor(255, 255, 255, 255); }

    // 红色分量（0–255）。
    public int Red() { return this.red; }
    // 绿色分量（0–255）。
    public int Green() { return this.green; }
    // 蓝色分量（0–255）。
    public int Blue() { return this.blue; }
    // alpha 分量：0 全透明，255 不透明。
    public int Alpha() { return this.alpha; }
}
