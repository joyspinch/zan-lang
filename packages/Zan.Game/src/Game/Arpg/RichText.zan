using System;
using System.Text;
using Gui;

namespace Game.Arpg;

/// <summary>
/// 富文本 run 类型常量：Text=0 纯文本、Image=1 图片（#p）、
/// Animation=2 动画（#a）、Spacer=3 空白占位（#z）、
/// Item=4 物品片段（#item）、LineBreak=5 换行（源文本 \n）、
/// WrapWidth=6 换行宽度段（#br(宽度) 或 #md/#rt 携带宽度时）。
///
/// 实现在 Gui.RichTextRunKind——富文本的解析与数据模型已经
/// 统一收敛到 stdlib/Gui（组件都到 Gui 下），本命名空间只保留
/// Arpg 时代的类型名作薄适配，外部工程无需迁移。
/// </summary>
class ArpgRichTextRunKind {
    /// 纯文本 run 类型常量（0）。
    static int Text() { return Gui.RichTextRunKind.Text(); }
    /// 图片 run 类型常量（1），由 #p(资源,x,y,宽,高) 产生。
    static int Image() { return Gui.RichTextRunKind.Image(); }
    /// 动画 run 类型常量（2），由 #a(资源,动作,缩放,宽,高,x,y) 产生。
    static int Animation() { return Gui.RichTextRunKind.Animation(); }
    /// 空白占位 run 类型常量（3），由 #z(宽,高) 产生。
    static int Spacer() { return Gui.RichTextRunKind.Spacer(); }
    /// 物品片段 run 类型常量（4），由 #item(资源,数量) 产生。
    static int Item() { return Gui.RichTextRunKind.Item(); }
    /// 换行 run 类型常量（5），源文本中的每个 \n 产生一个。
    static int LineBreak() { return Gui.RichTextRunKind.LineBreak(); }
    /// 换行宽度 run 类型常量（6）；携带宽度时改变后续换行宽度，宽度 0 仅切换对齐。
    static int WrapWidth() { return Gui.RichTextRunKind.WrapWidth(); }
}

/// <summary>
/// 富文本链接（#@标记@内容@ 语法中标记部分的类型化表示）。
/// 标记格式为 "action|参数列表"：竖线前是链接动作文本，竖线后
/// 可带逗号分隔的 1~4 个参数：样式编号、常态色、悬停色、按下色。
/// 颜色参数支持 0xRRGGBBAA；未提供的颜色为全透明。
/// 薄适配：解析与存取都委托 Gui.RichTextLink，颜色在边界换算成
/// ArpgColor。
/// </summary>
class ArpgRichTextLink {
    Gui.RichTextLink inner;

    ArpgRichTextLink(string marker) {
        this.inner = new Gui.RichTextLink(marker);
    }

    ArpgRichTextLink(Gui.RichTextLink inner) {
        this.inner = inner;
    }

    /// 内部 Gui 链接对象（适配层内部用）。
    Gui.RichTextLink Inner() { return this.inner; }

    /// 链接动作原文（标记中竖线前的部分）。
    string Raw() { return this.inner.Raw(); }
    /// 动作参数个数（按逗号分隔；无参数为 0）。
    int Count() { return this.inner.Count(); }
    /// 第 index 个动作参数（两侧去空白）；越界返回空串。
    string At(int index) { return this.inner.At(index); }
    /// 样式编号（标记第 1 个参数，未提供为 0）。
    int Style() { return this.inner.Style(); }
    /// 常态颜色（未提供时为全透明）。
    ArpgColor NormalColor() {
        return ArpgRichText.UnpackColor(this.inner.NormalColor());
    }
    /// 悬停颜色（未提供时为全透明）。
    ArpgColor HoverColor() {
        return ArpgRichText.UnpackColor(this.inner.HoverColor());
    }
    /// 按下颜色（未提供时为全透明）。
    ArpgColor PressedColor() {
        return ArpgRichText.UnpackColor(this.inner.PressedColor());
    }
}

/// <summary>
/// 富文本样式快照：前景/背景色、字体名与水平对齐。
/// 解析过程中随 #c/#bg/#f/#md/#rt 等标签变化，并拷贝进
/// 后续创建的 run。对齐取值：0=左，1=中（#md），2=右（#rt）。
/// 薄适配：存取委托 Gui.RichTextStyle，颜色在边界换算。
/// </summary>
class ArpgRichTextStyle {
    Gui.RichTextStyle inner;

    ArpgRichTextStyle(
        ArpgColor color,
        ArpgColor background,
        string font,
        int alignment
    ) {
        this.inner = new Gui.RichTextStyle(
            ArpgRichText.PackColor(color),
            ArpgRichText.PackColor(background),
            font,
            alignment);
    }

    ArpgRichTextStyle(Gui.RichTextStyle inner) {
        this.inner = inner;
    }

    /// 内部 Gui 样式对象（适配层内部用）。
    Gui.RichTextStyle Inner() { return this.inner; }

    /// 默认样式：白字、透明背景、空字体名、左对齐。
    static ArpgRichTextStyle Default() {
        return new ArpgRichTextStyle(Gui.RichTextStyle.Default());
    }

    /// 返回独立副本（修改副本不影响原样式）。
    ArpgRichTextStyle Clone() {
        return new ArpgRichTextStyle(this.inner.Clone());
    }

    /// 当前前景色。
    ArpgColor Color() { return ArpgRichText.UnpackColor(this.inner.Color()); }
    /// 当前背景色。
    ArpgColor Background() {
        return ArpgRichText.UnpackColor(this.inner.Background());
    }
    /// 当前字体名（空串表示默认字体）。
    string Font() { return this.inner.Font(); }
    /// 当前水平对齐：0=左，1=中（#md），2=右（#rt）。
    int Alignment() { return this.inner.Alignment(); }
    /// 设置前景色（影响后续创建的 run）。
    void SetColor(ArpgColor newValue) {
        this.inner.SetColor(ArpgRichText.PackColor(newValue));
    }
    /// 设置背景色。
    void SetBackground(ArpgColor newValue) {
        this.inner.SetBackground(ArpgRichText.PackColor(newValue));
    }
    /// 设置字体名。
    void SetFont(string newValue) { this.inner.SetFont(newValue); }
    /// 设置水平对齐（0=左 1=中 2=右）。
    void SetAlignment(int newValue) { this.inner.SetAlignment(newValue); }
}

/// <summary>
/// 富文本解析产物的单个片段（run）：一段文本、一张图片、一个
/// 动画、一个占位或一次换行。携带创建时刻的样式快照与所在链接
/// （非链接 run 的 Link 为 null），布局/绘制层按 Kind 分派处理。
/// 薄适配：包住 Gui.RichTextRun，样式/链接包装按需建一次。
/// </summary>
class ArpgRichTextRun {
    Gui.RichTextRun inner;
    ArpgRichTextStyle styleWrap;
    ArpgRichTextLink linkWrap;

    ArpgRichTextRun(
        int kind,
        ArpgRichTextStyle style,
        ArpgRichTextLink link
    ) {
        Gui.RichTextLink innerLink = null;
        if (link != null) { innerLink = link.Inner(); }
        this.inner = new Gui.RichTextRun(
            kind, style.Inner(), innerLink);
        this.styleWrap = null;
        this.linkWrap = null;
    }

    ArpgRichTextRun(Gui.RichTextRun inner) {
        this.inner = inner;
        this.styleWrap = null;
        this.linkWrap = null;
    }

    /// 内部 Gui run 对象（适配层内部用）。
    Gui.RichTextRun Inner() { return this.inner; }

    /// 创建一个默认样式、无链接的纯文本 run。
    static ArpgRichTextRun CreateText(string text) {
        return new ArpgRichTextRun(Gui.RichTextRun.CreateText(text));
    }

    /// run 类型（ArpgRichTextRunKind 常量）。
    int Kind() { return this.inner.Kind(); }
    /// 文本内容（仅 Text run 有意义，其他为空串）。
    string Text() { return this.inner.Text(); }
    /// 资源 Id（Image/Animation/Item run）。
    string Resource() { return this.inner.Resource(); }
    /// 动画动作名（仅 Animation run 有意义）。
    string Action() { return this.inner.Action(); }
    /// 物品数量（仅 Item run 有意义）。
    int Quantity() { return this.inner.Quantity(); }
    /// 相对排版位置的 X 偏移（像素）。
    int OffsetX() { return this.inner.OffsetX(); }
    /// 相对排版位置的 Y 偏移（像素）。
    int OffsetY() { return this.inner.OffsetY(); }
    /// 宽度（像素；图片/动画未指定时布局按字号兜底）。
    int Width() { return this.inner.Width(); }
    /// 高度（像素；未指定时布局按字号兜底）。
    int Height() { return this.inner.Height(); }
    /// 动画缩放（默认 1.0）。
    double Scale() { return this.inner.Scale(); }
    /// 创建时刻的样式快照（独立副本，修改不影响其他 run）。
    ArpgRichTextStyle Style() {
        if (this.styleWrap == null) {
            this.styleWrap = new ArpgRichTextStyle(this.inner.Style());
        }
        return this.styleWrap;
    }
    /// 所在链接；非链接 run 返回 null。
    ArpgRichTextLink Link() {
        Gui.RichTextLink innerLink = this.inner.Link();
        if (innerLink == null) { return null; }
        if (this.linkWrap == null) {
            this.linkWrap = new ArpgRichTextLink(innerLink);
        }
        return this.linkWrap;
    }
    /// 该 run 是否位于超链接内。
    bool IsLink() { return this.inner.IsLink(); }

    /// 设置文本内容。
    void SetText(string newValue) { this.inner.SetText(newValue); }
    /// 设置资源 Id。
    void SetResource(string newValue) { this.inner.SetResource(newValue); }
    /// 设置动画动作名。
    void SetAction(string newValue) { this.inner.SetAction(newValue); }
    /// 设置物品数量。
    void SetQuantity(int newValue) { this.inner.SetQuantity(newValue); }
    /// 同时设置 X/Y 偏移（像素）。
    void SetOffset(int x, int y) { this.inner.SetOffset(x, y); }
    /// 同时设置宽高（像素）。
    void SetSize(int width, int height) {
        this.inner.SetSize(width, height);
    }
    /// 设置动画缩放。
    void SetScale(double newValue) { this.inner.SetScale(newValue); }
}

/// <summary>
/// 富文本解析结果：原始输入与按序排列的 run 列表。绘制/布局层
/// 遍历 runs 并按各 run 的 Kind 分派处理。
/// 薄适配：包住 Gui.RichTextDocument；RunAt 的 Arpg 包装按需建
/// 一次并缓存（文档随后 Add 时缓存惰性续建）。
/// </summary>
class ArpgRichTextDocument {
    Gui.RichTextDocument inner;
    List<ArpgRichTextRun> cache;

    ArpgRichTextDocument(string sourceText) {
        this.inner = new Gui.RichTextDocument(sourceText);
        this.cache = null;
    }

    ArpgRichTextDocument(Gui.RichTextDocument inner) {
        this.inner = inner;
        this.cache = null;
    }

    /// 把包装缓存补到与内部 run 数一致。
    void SyncCache() {
        int count = this.inner.RunCount();
        if (this.cache == null) { this.cache = new List<ArpgRichTextRun>(); }
        while (this.cache.Count < count) {
            this.cache.Add(new ArpgRichTextRun(
                this.inner.RunAt(this.cache.Count)));
        }
    }

    /// 解析前的原始输入。
    string SourceText() { return this.inner.SourceText(); }
    /// run 总数。
    int RunCount() { return this.inner.RunCount(); }
    /// 第 index 个 run（不查越界）。
    ArpgRichTextRun RunAt(int index) {
        this.SyncCache();
        return this.cache[index];
    }
    /// 追加一个 run 到末尾。
    void Add(ArpgRichTextRun run) { this.inner.Add(run.Inner()); }
}

/// <summary>
/// 富文本解析器：把标签化文本切分为类型化 run 流。支持颜色
/// 快捷标记（#W #R #Y #B #G #H #L）、#c()/#bg()/#f() 样式标签、
/// #p()/#a()/#z()/#item() 资源标签、#br(宽度)/#md/#rt/#lf 排版标签
/// 与 #@标记@内容@ 超链接。无法识别的 # 按普通文本保留，
/// ## 转义为字面 '#'。
/// 薄适配：解析完全委托 Gui.RichTextParser。
/// </summary>
class ArpgRichTextParser {
    Gui.RichTextParser inner;

    ArpgRichTextParser(
        string input,
        ArpgRichTextStyle style,
        ArpgRichTextLink link
    ) {
        Gui.RichTextLink innerLink = null;
        if (link != null) { innerLink = link.Inner(); }
        this.inner = new Gui.RichTextParser(
            input, style.Inner(), innerLink);
    }

    /// 在 text 中从 start 起查找 token 首次出现的位置；未找到返回 -1。
    static int FindIn(string text, string token, int start) {
        return Gui.RichTextParser.FindIn(text, token, start);
    }

    /// 按逗号分隔的参数个数（空串为 0，"a,,b" 计 3）。
    static int ArgCount(string text) {
        return Gui.RichTextParser.ArgCount(text);
    }

    /// 第 index 个逗号分隔参数（两侧去空白）；越界返回空串。
    static string ArgAt(string text, int index) {
        return Gui.RichTextParser.ArgAt(text, index);
    }

    /// 单个十六进制字符的数值（0-9/a-f/A-F）；其他字符返回 0。
    static int HexDigit(string digit) {
        return Gui.RichTextParser.HexDigit(digit);
    }

    /// 解析整数：支持十进制与 0x 前缀十六进制（可带负号），
    /// 两侧去空白；无有效数字时返回 0（不置错）。
    static int ParseInt(string text) {
        return Gui.RichTextParser.ParseInt(text);
    }

    /// 解析 0xRRGGBBAA 颜色；空串、"0" 或格式不符返回全透明。
    static ArpgColor ParseColor(string text) {
        return ArpgRichText.UnpackColor(
            Gui.RichTextParser.ParseColor(text));
    }

    /// 解析颜色参数串：1 个参数按 0xRRGGBBAA，4 个参数按
    /// r,g,b,a 十进制；其他情况返回全透明。
    static ArpgColor ParseColorArgs(string args) {
        return ArpgRichText.UnpackColor(
            Gui.RichTextParser.ParseColorArgs(args));
    }

    /// 解析全部输入并返回文档：\n 产生 LineBreak，'#' 触发标签
    /// 解析（未识别时按普通文本保留），其余字符累积为文本 run。
    ArpgRichTextDocument Parse() {
        return new ArpgRichTextDocument(this.inner.Parse());
    }
}

/// <summary>
/// 富文本解析静态入口：先用数据源对 content 做模板求值（展开
/// &amp;path&amp; 与 {if} 分支），再按默认样式解析为 run 文档。
/// content 为空时返回空文档。
/// </summary>
class ArpgRichText {
    /// 模板求值 + 富文本解析；source 可为 null（占位符解析为空）。
    static ArpgRichTextDocument Parse(
        string content,
        ArpgDataSource source
    ) {
        string evaluated = ArpgTemplate.Evaluate(content, source);
        ArpgRichTextParser parser = new ArpgRichTextParser(
            evaluated, ArpgRichTextStyle.Default(), null);
        return parser.Parse();
    }

    /// ArpgColor → Gui 打包色（0xAARRGGBB）。
    static int PackColor(ArpgColor color) {
        return (color.Alpha() << 24) | (color.Red() << 16)
            | (color.Green() << 8) | color.Blue();
    }

    /// Gui 打包色（0xAARRGGBB）→ ArpgColor。
    static ArpgColor UnpackColor(int packed) {
        return new ArpgColor(
            (packed >> 16) & 255,
            (packed >> 8) & 255,
            packed & 255,
            (packed >> 24) & 255);
    }
}
