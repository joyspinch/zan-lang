using System;
using System.Collections.Generic;

namespace Game.Arpg;

/// <summary>
/// 缓动曲线枚举：每个族都有 _in / _out / _inOut 变体（由引擎
/// 创建缓动时按时间进度映射属性值）。线性族 Linear 无变体。
/// </summary>
enum ArpgEasing {
    Linear,
    QuadIn, QuadOut, QuadInOut,           // 二次方
    CubicIn, CubicOut, CubicInOut,        // 三次方
    QuartIn, QuartOut, QuartInOut,        // 四次方
    QuintIn, QuintOut, QuintInOut,        // 五次方
    SineIn, SineOut, SineInOut,           // 正弦曲线
    ExpoIn, ExpoOut, ExpoInOut,           // 指数曲线
    CircIn, CircOut, CircInOut,           // 圆形曲线
    ElasticIn, ElasticOut, ElasticInOut,  // 曲线衰减
    BackIn, BackOut, BackInOut,           // 后移衰减
    BounceIn, BounceOut, BounceInOut      // 反弹衰减
}

/// <summary>
/// 单个动画属性目标：属性名 + 终值/增量。to 步骤中 amount 为
/// 绝对终值，by 步骤中为相对增量。
/// </summary>
class TweenTarget {
    string prop;   // property name, e.g. "x" / "y" / "透明度"
    double amount; // 目标值

    /// 构造属性目标。
    static TweenTarget Of(string prop, double amount) {
        TweenTarget t = new TweenTarget();
        t.prop = prop;
        t.amount = amount;
        return t;
    }
    /// 属性名（如 "x" / "y" / "透明度"）。
    string Prop() { return this.prop; }
    /// 目标值（to 为绝对值，by 为增量）。
    double Amount() { return this.amount; }
}

// One step in a 缓动 timeline. Kinds mirror the tween methods:
//   to   —— 将目标对象的属性动画到绝对值
//   by   —— 按相对增量进行动画
//   wait —— 延时
//   call —— 调用具名回调
/// <summary>
/// 缓动时间线中的单步：to（把目标对象属性动画到绝对值）、
/// by（按相对增量动画）、wait（延时）、call（调用具名回调）。
/// 经 To/By/Wait/Call 工厂创建，Set 链式追加属性目标。
/// </summary>
class ArpgTweenStep {
    string op;               // "to" / "by" / "wait" / "call"
    string target;           // 目标对象标识符（to/by）
    List<TweenTarget> props; // 属性目标（to/by）
    int duration;            // 时长（毫秒，to/by/wait）
    ArpgEasing easing;           // 缓动类型 (to/by)
    string callback;         // 回调 id（call）

    /// 创建 to 步骤：duration 为毫秒，easing 为缓动曲线。
    static ArpgTweenStep To(string target, int duration, ArpgEasing easing) {
        ArpgTweenStep s = new ArpgTweenStep();
        s.op = "to";
        s.target = target;
        s.props = new List<TweenTarget>();
        s.duration = duration;
        s.easing = easing;
        s.callback = "";
        return s;
    }
    /// 创建 by 步骤（属性按相对增量动画）。
    static ArpgTweenStep By(string target, int duration, ArpgEasing easing) {
        ArpgTweenStep s = ArpgTweenStep.To(target, duration, easing);
        s.op = "by";
        return s;
    }
    /// 创建 wait 步骤：duration 为毫秒延时。
    static ArpgTweenStep Wait(int duration) {
        ArpgTweenStep s = new ArpgTweenStep();
        s.op = "wait";
        s.target = "";
        s.props = new List<TweenTarget>();
        s.duration = duration;
        s.easing = ArpgEasing.Linear;
        s.callback = "";
        return s;
    }
    /// 创建 call 步骤：callback 为注册的回调标识，不占用时长。
    static ArpgTweenStep Call(string callback) {
        ArpgTweenStep s = new ArpgTweenStep();
        s.op = "call";
        s.target = "";
        s.props = new List<TweenTarget>();
        s.duration = 0;
        s.easing = ArpgEasing.Linear;
        s.callback = callback;
        return s;
    }

    /// 追加一个属性目标并返回 this（链式）。
    ArpgTweenStep Set(string prop, double amount) {
        this.props.Add(TweenTarget.Of(prop, amount));
        return this;
    }
    /// 步骤类型（"to"/"by"/"wait"/"call"）。
    string Op() { return this.op; }
    /// 目标对象标识符（wait/call 为空串）。
    string Target() { return this.target; }
    /// 时长（毫秒；call 为 0）。
    int Duration() { return this.duration; }
    /// 缓动曲线。
    ArpgEasing Curve() { return this.easing; }
    /// 回调标识（仅 call 有意义）。
    string Callback() { return this.callback; }
    /// 属性目标个数。
    int PropCount() { return this.props.Count; }
    /// 第 index 个属性目标（不查越界）。
    TweenTarget PropAt(int index) { return this.props[index]; }

    /// 释放属性目标集合（之后不应再使用本步骤）。
    void Dispose() {
        this.props.Clear();
        this.props = null;
        this.op = null;
        this.target = null;
        this.callback = null;
    }
}

/// <summary>
/// 缓动时间线：按序执行的步骤链（引擎.创建缓动 产生，Add 链式
/// 追加步骤）。运行时由引擎驱动各步骤，call 步骤按回调 id 触发
/// 注册的回调。
/// </summary>
class ArpgTween {
    List<ArpgTweenStep> steps;

    /// 构造空时间线（一般经引擎工厂创建）。
    ArpgTween() {
        this.steps = new List<ArpgTweenStep>();
    }

    /// 追加一个步骤并返回 this（链式）。
    ArpgTween Add(ArpgTweenStep step) { this.steps.Add(step); return this; }
    /// 步骤总数。
    int StepCount() { return this.steps.Count; }
    /// 第 index 个步骤；越界返回 null。
    ArpgTweenStep StepAt(int index) {
        if (index < 0 || index >= this.steps.Count) { return null; }
        return this.steps[index];
    }

    /// 所有步骤的调度总时长（毫秒）。
    int TotalDuration() {
        int total = 0;
        for (int i = 0; i < this.steps.Count; i = i + 1) {
            ArpgTweenStep s = this.steps[i];
            total = total + s.Duration();
        }
        return total;
    }

    /// 释放全部步骤（之后不应再使用本时间线）。
    void Dispose() {
        for (int i = 0; i < this.steps.Count; i = i + 1) {
            this.steps[i].Dispose();
        }
        this.steps.Clear();
        this.steps = null;
    }
}
