using System;

namespace Game.Arpg;

// 2.5D 等轴测（Isometric）斜 45 度菱形地图映射引擎。
// 专为传奇类、暗黑类、经典模拟经营游戏设计。
// 采用工业界标准的 2:1 等轴测投影变换（例如 64x32 菱形地砖）。
class IsoTileMap {
    int mapWidth;  // 地图瓦片横向格数
    int mapHeight;  // 地图瓦片纵向格数
    int tileWidth;  // 瓦片菱形外接矩形宽（例如 64）
    int tileHeight;  // 瓦片菱形外接矩形高（例如 32，刚好为 2:1）
    int halfTileW;
    int halfTileH;

    int[] groundTiles;  // 地表地砖类型 ID
    byte[] collision;  // 阻挡图层：0 为可行走，1 为实体墙壁/悬崖障碍

    IsoTileMap(int mapW, int mapH, int tileW, int tileH) {
        this.mapWidth = mapW > 0 ? mapW : 128;
        this.mapHeight = mapH > 0 ? mapH : 128;
        this.tileWidth = tileW > 0 ? tileW : 64;
        this.tileHeight = tileH > 0 ? tileH : 32;
        this.halfTileW = this.tileWidth / 2;
        this.halfTileH = this.tileHeight / 2;

        int total = this.mapWidth * this.mapHeight;
        this.groundTiles = new int[total];
        this.collision = new byte[total];
    }

    static IsoTileMap Create(int mapW, int mapH, int tileW, int tileH) {
        return new IsoTileMap(mapW, mapH, tileW, tileH);
    }

    int MapWidth { get { return mapWidth; } }
    int MapHeight { get { return mapHeight; } }
    int TileWidth { get { return tileWidth; } }
    int TileHeight { get { return tileHeight; } }

    int Index(int gx, int gy) {
        return gy * mapWidth + gx;
    }

    void SetTile(int gx, int gy, int tileId, bool blocked) {
        if (gx < 0 || gx >= mapWidth || gy < 0 || gy >= mapHeight) { return; }
        int idx = Index(gx, gy);
        groundTiles[idx] = tileId;
        collision[idx] = blocked ? (byte)1 : (byte)0;
    }

    int GetTile(int gx, int gy) {
        if (gx < 0 || gx >= mapWidth || gy < 0 || gy >= mapHeight) { return -1; }
        return groundTiles[Index(gx, gy)];
    }

    bool IsBlocked(int gx, int gy) {
        if (gx < 0 || gx >= mapWidth || gy < 0 || gy >= mapHeight) { return true; }
        return collision[Index(gx, gy)] != (byte)0;
    }

    // 网格坐标 (gx, gy) 转换为屏幕空间坐标 (sx, sy)。
    // 菱形地表中心点。
    void GridToWorld(int gx, int gy, out double sx, out double sy) {
        sx = (double)(gx - gy) * (double)halfTileW;
        sy = (double)(gx + gy) * (double)halfTileH;
    }

    // 世界/屏幕拾取坐标 (sx, sy) 逆转换为网格坐标 (gx, gy)。
    // 鼠标点击寻路、移动落点的核心算子。
    void WorldToGrid(double sx, double sy, out int gx, out int gy) {
        double divX = sx / (double)halfTileW;
        double divY = sy / (double)halfTileH;
        gx = (int)Math.Floor((divY + divX) * 0.5);
        gy = (int)Math.Floor((divY - divX) * 0.5);
    }

    // 计算 8 方向朝向索引（0: 上, 1: 右上, 2: 右, 3: 右下, 4: 下, 5: 左下, 6: 左, 7: 左上）。
    // ARPG 角色移动、砍怪朝向判定的标准算法。
    static int GetDirection8(double fromX, double fromY, double toX, double toY) {
        double dx = toX - fromX;
        double dy = toY - fromY;
        if (Math.Abs(dx) < 0.001 && Math.Abs(dy) < 0.001) {
            return 4;  // 默认朝南
        }
        // Atan2 输出角度 [-PI .. PI]
        double angleDeg = Math.Atan2(dy, dx) * (180.0 / 3.14159265);
        if (angleDeg < 0.0) { angleDeg = angleDeg + 360.0; }

        // 将 360 度分为 8 个 45 度扇区
        int sector = (int)Math.Floor((angleDeg + 22.5) / 45.0) % 8;
        // sector: 0:东(右), 1:东南(右下), 2:南(下), 3:西南(左下), 4:西(左), 5:西北(左上), 6:北(上), 7:东北(右上)
        return sector;
    }
}
