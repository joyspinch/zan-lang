using System;
using System.Collections.Generic;

namespace Game.Arpg;

// Server.lua 配置：服务端入口（通过 `-s` 启动）、ArpgTcpServer
// （配对客户端组件为 ArpgTcpClient）。服务器与客户端交换
// table-format messages keyed by a unique 通信标识 cid。Available server-side
// components: Sqlite, 地图, 角色。
// Config: { 名称, 端口, 消息长度, 扩展组件, 扩展脚本, 系统事件 }。
public class ServerConfig {
    public string name;  // 名称: console title
    public int port;  // 端口: listen port
    public int messageLength;  // 消息长度, default 2*1024*1024
    public List<string> extComponents;  // 扩展组件
    public List<string> extScripts;  // 扩展脚本

    public ServerConfig(string name, int port) {
        this.name = name;
        this.port = port;
        this.messageLength = ArpgNetDefaults.MaxMessageLength();
        this.extComponents = new List<string>();
        this.extScripts = new List<string>();
    }

    // 设置单条消息包上限（字节，默认 2 MiB）；返回 this。
    public ServerConfig SetMessageLength(int amount) { this.messageLength = amount; return this; }
    // 追加一个扩展组件名（按登记顺序）；返回 this。
    public ServerConfig AddComponent(string script) { this.extComponents.Add(script); return this; }
    // 追加一个扩展脚本（按登记顺序）；返回 this。
    public ServerConfig AddScript(string script) { this.extScripts.Add(script); return this; }

    // 服务器名（同时用作控制台标题）。
    public string Name() { return this.name; }
    // 监听端口。
    public int Port() { return this.port; }
    // 单条消息包上限（字节，默认 2 MiB）。
    public int MessageLength() { return this.messageLength; }
    // 扩展组件数量。
    public int ComponentCount() { return this.extComponents.Count; }
    // 扩展脚本数量。
    public int ScriptCount() { return this.extScripts.Count; }
    // 按下标读取扩展组件名；应配合 ComponentCount 使用。
    public string ComponentAt(int index) { return this.extComponents[index]; }
    // 按下标读取扩展脚本；应配合 ScriptCount 使用。
    public string ScriptAt(int index) { return this.extScripts[index]; }
}
