using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 逻辑坐标下的轴对齐矩形（x,y 为左上角）。
class ArpgRect {
    double x;
    double y;
    double width;
    double height;

    // 构造矩形。
    ArpgRect(double x, double y, double width, double height) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
    }

    // 左上角 X。
    double X() { return this.x; }
    // 左上角 Y。
    double Y() { return this.y; }
    // 宽度。
    double Width() { return this.width; }
    // 高度。
    double Height() { return this.height; }
}
