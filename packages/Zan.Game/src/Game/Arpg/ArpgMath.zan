using System;
using System.Collections.Generic;

namespace Game.Arpg;

// Arpg 校验/构造时使用的整型与浮点小工具。
public class ArpgMath {
    // 返回 newValue 钳制到 [minimum, maximum] 后的结果。
    public static int Clamp(int newValue, int minimum, int maximum) {
        if (newValue < minimum) { return minimum; }
        if (newValue > maximum) { return maximum; }
        return newValue;
    }

    // 返回 newValue 钳制到 [minimum, maximum] 后的结果（浮点版）。
    public static double ClampDouble(double newValue, double minimum, double maximum) {
        if (newValue < minimum) { return minimum; }
        if (newValue > maximum) { return maximum; }
        return newValue;
    }

    // 返回两者中较大的整数；相等时返回 right。
    public static int Max(int left, int right) {
        if (left > right) { return left; }
        return right;
    }
}
