namespace Game.Debug;

// 实体检查器的一行：一个实体的快照。
//
// 检查器**不反射**——Zan 没有反射，字段拿不到，所以实体快照由调用方
// （游戏代码）显式填好后交给检查器。检查器负责的是"组织、过滤、搜索、
// 排序、呈现"，不是"知道引擎里有什么"。
public class DebugEntityRow {
    // 实体 id。
    public int id;
    // 实体标签（"player" / "enemy-3" …）。
    public string tag;
    // 世界坐标与尺寸。
    public double x;
    public double y;
    public double width;
    public double height;
    // 生命周期状态。
    public bool alive;
    public bool active;
    // 该实体挂着的组件数（只做计数，不展开）。
    public int componentCount;

    public DebugEntityRow() {
        this.id = 0;
        this.tag = "";
        this.x = 0.0;
        this.y = 0.0;
        this.width = 0.0;
        this.height = 0.0;
        this.alive = true;
        this.active = true;
        this.componentCount = 0;
    }

    // 命中过滤串：id 前缀 / 标签子串（大小写不敏感）。
    //
    // id 用**前缀**匹配而不是子串——"1" 不该命中 "21"，子串匹配会让
    // 实体一多就满屏都是"看起来相关"的行。
    private static bool ContainsAsciiIgnoreCase(string hay, string needle) {
        if (hay == null || needle == null) { return false; }
        int hLen = hay.Length;
        int nLen = needle.Length;
        if (nLen == 0) { return true; }
        if (hLen < nLen) { return false; }
        int limit = hLen - nLen;
        for (int i = 0; i <= limit; i = i + 1) {
            bool ok = true;
            for (int j = 0; j < nLen; j = j + 1) {
                int a = hay[i + j] & 255;
                int b = needle[j] & 255;
                if (a >= 65 && a <= 90) { a = a + 32; }
                if (b >= 65 && b <= 90) { b = b + 32; }
                if (a != b) { ok = false; break; }
            }
            if (ok) { return true; }
        }
        return false;
    }

    public bool Matches(string query) {
        if (query == null || query.Length == 0) { return true; }
        int q0 = query[0] & 255;
        if (q0 >= 48 && q0 <= 57) {
            if (Convert.ToString(this.id).StartsWith(query)) { return true; }
        }
        return DebugEntityRow.ContainsAsciiIgnoreCase(this.tag, query);
    }

    // 一行摘要：id + 标签 + 位置 + 尺寸 + 组件数。
    //
    // 位置与尺寸用**定点一位小数**——调试面板是给人扫的，整数看不出
    // 差 0.5 像素的抖动，全精度又太长。
    public string Summary() {
        string state = this.alive ? (this.active ? "alive" : "inactive") : "dead";
        return "#" + this.id.ToString() + " " + (this.tag == null ? "" : this.tag)
            + " @(" + DebugEntityRow.Fixed(this.x) + "," + DebugEntityRow.Fixed(this.y) + ")"
            + " " + DebugEntityRow.Fixed(this.width) + "x" + DebugEntityRow.Fixed(this.height)
            + " c=" + this.componentCount.ToString()
            + " " + state;
    }

    // 定点一位小数（自己写，不依赖全局格式化设置）。
    public static string Fixed(double v) {
        bool neg = v < 0.0;
        double a = neg ? -v : v;
        long scaled = (long)(a * 10.0 + 0.5);
        long whole = scaled / 10;
        long frac = scaled % 10;
        string s = whole.ToString() + "." + frac.ToString();
        return neg ? "-" + s : s;
    }
}
