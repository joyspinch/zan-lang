namespace Game.Debug;

// 帧剖析覆盖层里的一行。
//
// 覆盖层是"看得见的账单"：把 Profiler 的报告与热点算成一行行能画的东西
// （标题 / 文本 / 带占比条的文本）。占比条用 0..1 的比例表示，由绘制层
// 换算成像素——**布局归数据层管**，绘制层只管画。
public class DebugOverlayRow {
    // 行种类。
    public DebugOverlayKind kind;
    // 左侧标签。
    public string label;
    // 右侧数值文本（没有就空串）。
    public string value;
    // 占比（0..1）。-1 表示这一行不画条。
    public double share;
    // 是否超预算（画成告警色）。
    public bool overBudget;

    public DebugOverlayRow() {
        this.kind = DebugOverlayKind.Text;
        this.label = "";
        this.value = "";
        this.share = -1.0;
        this.overBudget = false;
    }

    public DebugOverlayRow(DebugOverlayKind kind, string label, string value) {
        this.kind = kind;
        this.label = label == null ? "" : label;
        this.value = value == null ? "" : value;
        this.share = -1.0;
        this.overBudget = false;
    }

    // 一行文本："标签 值"（值非空时用空格隔开）。
    public string Summary() {
        if (this.value == "") { return this.label; }
        return this.label + " " + this.value;
    }

    // 带条的一行：条用 '#' 画，长度按占比取 0..20 格。
    //
    // 用字符画而不是数字百分比，是为了让"文本呈现"（无 GUI 环境、stdout、
    // 日志）与"图形呈现"看到同一份结构——比例信息在两种呈现里都保住了。
    public string SummaryWithBar() {
        if (this.share < 0.0) { return this.Summary(); }
        double s = this.share;
        if (s > 1.0) { s = 1.0; }
        int cells = (int)(s * 20.0 + 0.5);
        string bar = "";
        for (int i = 0; i < cells; i = i + 1) { bar = bar + "#"; }
        string mark = this.overBudget ? "!" : " ";
        return this.Summary() + " " + mark + "[" + bar + "]";
    }
}
