using System.Collections.Generic;

namespace Game.Debug;

// 实体检查器里的一个组件行：组件名 + 它的一组字段。
public class DebugComponentRow {
    // 组件名（"Transform" / "Health" / "Sprite" …）。
    public string name;
    // 该组件的字段行。
    public List<DebugFieldRow> fields;
    // 是否展开（收起时只显示组件名，展开显示字段）。
    public bool expanded;

    public DebugComponentRow() {
        this.name = "";
        this.fields = new List<DebugFieldRow>();
        this.expanded = true;
    }

    public DebugComponentRow(string name) {
        this.name = name == null ? "" : name;
        this.fields = new List<DebugFieldRow>();
        this.expanded = true;
    }

    // 加一个字段行。
    public DebugComponentRow Add(string fieldName, string value) {
        this.fields.Add(new DebugFieldRow(fieldName, value));
        return this;
    }

    // 组件名命中过滤串，或**任一字段**命中（字段名或值）。
    //
    // 字段命中也算，是"按数值找实体"的唯一办法——组件名是写死的，
    // 值才是变化的（血量 30 的那个）。
    public bool Matches(string query) {
        if (query == null || query == "") { return true; }
        string q = query.ToLower();
        if (this.name.ToLower().Contains(q)) { return true; }
        for (int i = 0; i < this.fields.Count; i = i + 1) {
            if (this.fields[i].Matches(query)) { return true; }
        }
        return false;
    }

    // 展开时的文本块：组件名 + 每行一个字段。
    public string Summary() {
        string s = this.name;
        if (!this.expanded) { return s; }
        for (int i = 0; i < this.fields.Count; i = i + 1) {
            s = s + "\n  " + this.fields[i].Summary();
        }
        return s;
    }
}
