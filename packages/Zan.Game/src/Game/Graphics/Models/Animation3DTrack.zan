using System;

namespace Game.Graphics;

// 3D 骨骼动作切片与权重（用于动作平滑混合 Cross-Fade）。
public class Animation3DTrack {
    public string clipName;
    public double time;
    public double duration;
    public double speed;
    public double weight;
    public bool loop;

    public Animation3DTrack() {
        this.clipName = "";
        this.time = 0.0;
        this.duration = 1.0;
        this.speed = 1.0;
        this.weight = 1.0;
        this.loop = true;
    }

    public static Animation3DTrack Create(string clipName, double duration, double speed, bool loop) {
        Animation3DTrack t = new Animation3DTrack();
        t.clipName = clipName != null ? clipName : "";
        t.duration = duration > 0.01 ? duration : 1.0;
        t.speed = speed > 0.0 ? speed : 1.0;
        t.loop = loop;
        t.weight = 1.0;
        t.time = 0.0;
        return t;
    }

    public string ClipName { get { return clipName; } }
    public double Time { get { return time; } set { time = value; } }
    public double Duration { get { return duration; } }
    public double Weight { get { return weight; } set { weight = (value < 0.0) ? 0.0 : (value > 1.0 ? 1.0 : value); } }
    public bool Loop { get { return loop; } }

    public void Advance(double dt) {
        time = time + dt * speed;
        if (time >= duration) {
            if (loop) {
                time = time - duration;
                if (time >= duration) {
                    while (time >= duration) {
                        time = time - duration;
                    }
                }
            } else {
                time = duration;
            }
        }
    }
}
