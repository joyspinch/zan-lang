using System;

namespace Game.Graphics;

// 纸娃娃独立挂件层（如：身体、服饰、武器、翅膀、头饰）。
public class PaperdollLayer {
    public string name;
    public SpriteSheet sheet;
    public bool is5DirMode;
    public bool visible;
    public double offsetX;
    public double offsetY;
    public int baseOrder;
    public int[] orderPerDir;  // 8 个朝向下的微调层深（解决正面武器在前、背面武器在后的遮挡穿模问题）

    public PaperdollLayer(string name, SpriteSheet sheet, int baseOrder, int[] orderPerDir, bool is5DirMode) {
        this.name = name != null ? name : "";
        this.sheet = sheet;
        this.baseOrder = baseOrder;
        this.is5DirMode = is5DirMode;
        this.visible = true;
        this.offsetX = 0.0;
        this.offsetY = 0.0;

        this.orderPerDir = new int[8];
        if (orderPerDir != null) {
            int n = orderPerDir.Length < 8 ? orderPerDir.Length : 8;
            for (int i = 0; i < n; i = i + 1) {
                this.orderPerDir[i] = orderPerDir[i];
            }
        }
    }

    public static PaperdollLayer Create(string name, SpriteSheet sheet, int baseOrder, int[] orderPerDir, bool is5DirMode) {
        return new PaperdollLayer(name, sheet, baseOrder, orderPerDir, is5DirMode);
    }

    public string Name { get { return name; } }
    public SpriteSheet Sheet { get { return sheet; } set { sheet = value; } }
    public bool Visible { get { return visible; } set { visible = value; } }
    public bool Is5DirMode { get { return is5DirMode; } set { is5DirMode = value; } }
    public double OffsetX { get { return offsetX; } set { offsetX = value; } }
    public double OffsetY { get { return offsetY; } set { offsetY = value; } }
    public int BaseOrder { get { return baseOrder; } set { baseOrder = value; } }

    public int GetOrder(int dir8) {
        int d = (dir8 >= 0 && dir8 < 8) ? dir8 : 2;
        return baseOrder + orderPerDir[d];
    }
}
