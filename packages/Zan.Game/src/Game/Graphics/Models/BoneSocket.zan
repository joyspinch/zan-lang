using System;

namespace Game.Graphics;

// 3D 骨骼挂点（Bone Socket），用于在角色手部挂载武器、背部挂载翅膀或头顶定位血条。
public class BoneSocket {
    public string name;
    public double localX;
    public double localY;
    public double localZ;

    public BoneSocket(string name, double lx, double ly, double lz) {
        this.name = name != null ? name : "";
        this.localX = lx;
        this.localY = ly;
        this.localZ = lz;
    }

    public static BoneSocket Create(string name, double lx, double ly, double lz) {
        return new BoneSocket(name, lx, ly, lz);
    }

    public string Name { get { return name; } }
    public double LocalX { get { return localX; } }
    public double LocalY { get { return localY; } }
    public double LocalZ { get { return localZ; } }

    // 根据角色当前的 Y 轴旋转偏角（弧度），将局部偏置旋转换算为世界 3D 偏移。
    public void ResolveWorldOffset(double rotYRad, out double outX, out double outY, out double outZ) {
        double cosA = Math.Cos(rotYRad);
        double sinA = Math.Sin(rotYRad);
        ResolveWorldOffsetCached(cosA, sinA, out outX, out outY, out outZ);
    }

    // 接收预计算的 cos/sin（避免挂点遍历重复三角函数计算）。
    public void ResolveWorldOffsetCached(double cosA, double sinA, out double outX, out double outY, out double outZ) {
        // 绕 Y 轴旋转：X' = X * cos + Z * sin, Z' = -X * sin + Z * cos
        outX = localX * cosA + localZ * sinA;
        outY = localY;
        outZ = -localX * sinA + localZ * cosA;
    }
}
