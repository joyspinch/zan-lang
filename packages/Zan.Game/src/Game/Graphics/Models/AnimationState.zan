using System;

namespace Game.Graphics;

// 单个动作片段元数据（例如 "walk"、"attack"）。
class AnimationState {
    string name;
    int startRow;  // 在图集中的起始行号（通常 8 方向各占一行）
    int framesPerDir;  // 每个方向包含的连续动作帧数
    double fps;  // 播放帧率（帧/秒）
    bool loop;  // 是否循环

    AnimationState(string name, int startRow, int framesPerDir, double fps, bool loop) {
        this.name = name != null ? name : "";
        this.startRow = startRow;
        this.framesPerDir = framesPerDir > 0 ? framesPerDir : 1;
        this.fps = fps > 0.1 ? fps : 10.0;
        this.loop = loop;
    }

    static AnimationState Create(string name, int startRow, int framesPerDir, double fps, bool loop) {
        return new AnimationState(name, startRow, framesPerDir, fps, loop);
    }

    string Name { get { return name; } }
    int StartRow { get { return startRow; } }
    int FramesPerDir { get { return framesPerDir; } }
    double Fps { get { return fps; } }
    bool Loop { get { return loop; } }
}
