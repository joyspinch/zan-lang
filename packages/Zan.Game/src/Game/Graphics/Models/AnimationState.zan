using System;

namespace Game.Graphics;

// 单个动作片段元数据（例如 "walk"、"attack"）。
public class AnimationState {
    public string name;
    public int startRow;  // 在图集中的起始行号（通常 8 方向各占一行）
    public int framesPerDir;  // 每个方向包含的连续动作帧数
    public double fps;  // 播放帧率（帧/秒）
    public double frameDuration;  // 1.0 / fps 快速帧步长
    public bool loop;  // 是否循环

    public AnimationState(string name, int startRow, int framesPerDir, double fps, bool loop) {
        this.name = name != null ? name : "";
        this.startRow = startRow;
        this.framesPerDir = framesPerDir > 0 ? framesPerDir : 1;
        this.fps = fps > 0.1 ? fps : 10.0;
        this.frameDuration = 1.0 / this.fps;
        this.loop = loop;
    }

    public static AnimationState Create(string name, int startRow, int framesPerDir, double fps, bool loop) {
        return new AnimationState(name, startRow, framesPerDir, fps, loop);
    }

    public string Name { get { return name; } }
    public int StartRow { get { return startRow; } }
    public int FramesPerDir { get { return framesPerDir; } }
    public double Fps { get { return fps; } }
    public double FrameDuration { get { return frameDuration; } }
    public bool Loop { get { return loop; } }
}
