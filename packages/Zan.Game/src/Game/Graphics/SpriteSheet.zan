using System;

namespace Game.Graphics;

// 纹理图集切片网格（SpriteSheet）。
// 将单张大贴图按照固定列数、行数划分为帧图元，提供高频 UV 映射。
class SpriteSheet {
    string textureKey;
    int texWidth;
    int texHeight;
    int frameWidth;
    int frameHeight;
    int cols;
    int rows;
    int totalFrames;
    float invTexWidth;
    float invTexHeight;
    float uWidth;
    float vHeight;
    bool isPowerOfTwo;
    int colShift;
    int colMask;

    SpriteSheet(string key, int texW, int texH, int frameW, int frameH) {
        this.textureKey = key != null ? key : "";
        this.texWidth = texW > 0 ? texW : 256;
        this.texHeight = texH > 0 ? texH : 256;
        this.frameWidth = frameW > 0 ? frameW : 32;
        this.frameHeight = frameH > 0 ? frameH : 32;

        this.cols = this.texWidth / this.frameWidth;
        this.rows = this.texHeight / this.frameHeight;
        if (this.cols <= 0) { this.cols = 1; }
        if (this.rows <= 0) { this.rows = 1; }
        this.totalFrames = this.cols * this.rows;

        this.invTexWidth = 1.0f / (float)this.texWidth;
        this.invTexHeight = 1.0f / (float)this.texHeight;
        this.uWidth = (float)this.frameWidth * this.invTexWidth;
        this.vHeight = (float)this.frameHeight * this.invTexHeight;

        if ((this.cols & (this.cols - 1)) == 0) {
            this.colMask = this.cols - 1;
            int shift = 0;
            int temp = this.cols;
            while (temp > 1) {
                shift = shift + 1;
                temp = temp >> 1;
            }
            this.colShift = shift;
            this.isPowerOfTwo = true;
        } else {
            this.colMask = 0;
            this.colShift = 0;
            this.isPowerOfTwo = false;
        }
    }

    static SpriteSheet Create(string key, int texW, int texH, int frameW, int frameH) {
        return new SpriteSheet(key, texW, texH, frameW, frameH);
    }

    string TextureKey { get { return textureKey; } }
    int FrameWidth { get { return frameWidth; } }
    int FrameHeight { get { return frameHeight; } }
    int TotalFrames { get { return totalFrames; } }
    int Cols { get { return cols; } }
    int Rows { get { return rows; } }

    // 获取指定帧在图集上的归一化纹理坐标 UV 矩形 [u0, v0, u1, v1]。
    void GetFrameUV(int frameIndex, out float u0, out float v0, out float u1, out float v1) {
        if (frameIndex < 0) { frameIndex = 0; }
        if (frameIndex >= totalFrames) { frameIndex = totalFrames - 1; }

        int r, c;
        if (isPowerOfTwo) {
            r = frameIndex >> colShift;
            c = frameIndex & colMask;
        } else {
            r = frameIndex / cols;
            c = frameIndex - r * cols;
        }

        u0 = (float)c * uWidth;
        v0 = (float)r * vHeight;
        u1 = u0 + uWidth;
        v1 = v0 + vHeight;
    }

    // 获取指定帧在图集上的像素裁剪矩形 [srcX, srcY, srcW, srcH]。
    void GetFrameRect(int frameIndex, out int srcX, out int srcY, out int srcW, out int srcH) {
        if (frameIndex < 0) { frameIndex = 0; }
        if (frameIndex >= totalFrames) { frameIndex = totalFrames - 1; }

        int r, c;
        if (isPowerOfTwo) {
            r = frameIndex >> colShift;
            c = frameIndex & colMask;
        } else {
            r = frameIndex / cols;
            c = frameIndex - r * cols;
        }

        srcX = c * frameWidth;
        srcY = r * frameHeight;
        srcW = frameWidth;
        srcH = frameHeight;
    }
}
