internal sealed class GpuMesh {
    public int Id;
    public ulong Epoch;
    public uint Vao;
    public uint Vbo;
    public uint Ebo;
    public int IndexCount;
    public bool Colored;
    public bool Skinned;
    public bool InstReady;
}

internal sealed class GpuDepth {
    public uint Renderbuffer;
    public int Width;
    public int Height;
    public uint AttachedFbo;
}

// GPU 资源生命周期、着色器缓存、Mesh VAO/VBO/EBO、深度 RBO、阴影与后处理 FBO 管理。
internal static class GameGpuResources {
    public const int LocPos = 0;
    public const int LocNormal = 1;
    public const int LocUv = 2;
    public const int LocColor = 3;
    public const int LocIMvp = 4;
    public const int LocITint = 8;
    public const int LocJoints = 9;
    public const int LocWeights = 10;
    public const int VertexCap = 65536;
    public const int MeshMaxCap = 16384;
    public const int GlErrorLimit = 32;

    private static GpuProgram[] progs; // 2 * 3: idx = colored * 3 + mode
    private static GpuProgram skinProg;
    private static GpuShadowProgram shadowProg;
    private static GpuShadowProgram shadowInstProg;
    private static GpuShadowProgram shadowSkinProg;
    private static GpuPostProgram postProg;
    private static GpuSkyboxProgram skyboxProg;

    public static uint PostFbo;
    public static uint PostTex;
    public static uint PostVao;
    public static int PostW;
    public static int PostH;
    public static uint InstanceVbo;

    private static List<GpuMesh> meshes;
    private static Dictionary<int, GpuMesh> meshMap;
    private static int nextMeshId = 1;
    private static GpuDepth[] depths;
    private static bool cleanupRegistered;
    private static bool resInitialized;

    private static void EnsureResInit() {
        GameGpuState.EnsureInit();
        if (resInitialized) { return; }
        resInitialized = true;
        progs = new GpuProgram[6];
        meshes = new List<GpuMesh>();
        meshMap = new Dictionary<int, GpuMesh>();
        depths = new GpuDepth[GameGpuState.SurfaceCap];
        for (int i = 0; i < GameGpuState.SurfaceCap; i = i + 1) {
            depths[i] = new GpuDepth();
        }
    }

    public static void DropMesh(GpuMesh m) {
        if (m == null) { return; }
        GlApi gl = GameGpuState.Gl;
        if (gl != null) {
            if (m.Vao != 0u) { GlBridge.DeleteOne(gl.DeleteVertexArrays, m.Vao); }
            if (m.Vbo != 0u) { GlBridge.DeleteOne(gl.DeleteBuffers, m.Vbo); }
            if (m.Ebo != 0u) { GlBridge.DeleteOne(gl.DeleteBuffers, m.Ebo); }
        }
        m.Vao = 0u; m.Vbo = 0u; m.Ebo = 0u;
        m.Id = 0; m.Epoch = 0UL; m.IndexCount = 0;
        m.Colored = false; m.Skinned = false; m.InstReady = false;
    }

    public static void DropDepth(GpuDepth d) {
        if (d == null) { return; }
        GlApi gl = GameGpuState.Gl;
        if (gl != null && d.Renderbuffer != 0u) {
            GlBridge.DeleteOne(gl.DeleteRenderbuffers, d.Renderbuffer);
        }
        d.Renderbuffer = 0u; d.Width = 0; d.Height = 0; d.AttachedFbo = 0u;
    }

    public static void DropShadow() {
        GlApi gl = GameGpuState.Gl;
        if (gl != null) {
            if (GameGpuState.ShadowFbo != 0u) { GlBridge.DeleteOne(gl.DeleteFramebuffers, GameGpuState.ShadowFbo); }
            if (GameGpuState.ShadowTex != 0u) { GlBridge.DeleteOne(gl.DeleteTextures, GameGpuState.ShadowTex); }
        }
        GameGpuState.ShadowFbo = 0u;
        GameGpuState.ShadowTex = 0u;
        GameGpuState.ShadowSize = 0;
        GameGpuState.ShadowReady = false;
        GameGpuState.ShadowSurface = -1;
    }

    public static void DropPost() {
        GlApi gl = GameGpuState.Gl;
        if (gl != null) {
            if (postProg != null && postProg.Program != 0u) { gl.DeleteProgram(postProg.Program); }
            if (skyboxProg != null && skyboxProg.Program != 0u) { gl.DeleteProgram(skyboxProg.Program); }
            if (PostFbo != 0u) { GlBridge.DeleteOne(gl.DeleteFramebuffers, PostFbo); }
            if (PostTex != 0u) { GlBridge.DeleteOne(gl.DeleteTextures, PostTex); }
            if (PostVao != 0u) { GlBridge.DeleteOne(gl.DeleteVertexArrays, PostVao); }
        }
        postProg = null;
        skyboxProg = null;
        PostFbo = 0u; PostTex = 0u; PostVao = 0u;
        PostW = 0; PostH = 0;
    }

    public static void ForgetGpu() {
        EnsureResInit();
        GlApi gl = GameGpuState.Gl;
        if (gl != null) {
            for (int i = 0; i < 6; i = i + 1) {
                if (progs[i] != null && progs[i].Program != 0u) {
                    gl.DeleteProgram(progs[i].Program);
                }
            }
            if (skinProg != null && skinProg.Program != 0u) { gl.DeleteProgram(skinProg.Program); }
            if (shadowProg != null && shadowProg.Program != 0u) { gl.DeleteProgram(shadowProg.Program); }
            if (shadowInstProg != null && shadowInstProg.Program != 0u) { gl.DeleteProgram(shadowInstProg.Program); }
            if (shadowSkinProg != null && shadowSkinProg.Program != 0u) { gl.DeleteProgram(shadowSkinProg.Program); }
            if (InstanceVbo != 0u) { GlBridge.DeleteOne(gl.DeleteBuffers, InstanceVbo); }
            DropShadow();
            DropPost();
        }
        for (int i = 0; i < 6; i = i + 1) { progs[i] = null; }
        skinProg = null;
        shadowProg = null;
        shadowInstProg = null;
        shadowSkinProg = null;
        meshes.Clear();
        meshMap.Clear();
        for (int i = 0; i < GameGpuState.SurfaceCap; i = i + 1) {
            depths[i].Renderbuffer = 0u;
            depths[i].Width = 0;
            depths[i].Height = 0;
            depths[i].AttachedFbo = 0u;
        }
        GameGpuState.TexCacheGen = GameGpuState.TexCacheGen + 1u;
        GameGpuState.TexCacheNext = 0;
        GameGpuState.WhiteTex = 0u;
        InstanceVbo = 0u;
        GameGpuState.BatchSurface = -1;
        GameGpuState.BatchOwnsGpu = false;
        GameGpuState.FrameSurface = -1;
        GameGpuState.FrameClipEmpty = false;
        GameGpuState.ShadowSurface = -1;
        GameGpuState.ShadowReady = false;
        GameGpuState.PreserveDepth = 0;
        GameGpuState.Epoch = 0UL;
        GameGpuState.Gl = null;
        GameGpuState.InvalidateGlCache();
    }

    // 注册给 zan_gui_gpu_register_cleanup 的原生回调：surfaceId>=0 释单画布深度，-1 释全局上下文。
    public static void OnGpuCleanup(int surfaceId) {
        EnsureResInit();
        if (surfaceId >= 0) {
            if (surfaceId < GameGpuState.SurfaceCap && GameGpuState.Gl != null) {
                DropDepth(depths[surfaceId]);
            }
            return;
        }
        if (surfaceId != -1) { return; }
        if (GameGpuState.Gl != null) {
            for (int i = 0; i < meshes.Count; i = i + 1) {
                DropMesh(meshes[i]);
            }
            for (int i = 0; i < GameGpuState.SurfaceCap; i = i + 1) {
                DropDepth(depths[i]);
            }
        }
        ForgetGpu();
    }

    public static bool PrepareFast(GpuFrameInfo frame) {
        EnsureResInit();
        if (frame.ApiPtr == 0 || frame.Framebuffer == 0u || frame.Width <= 0 || frame.Height <= 0) {
            return false;
        }
        if (GameGpuState.Gl != null && GameGpuState.Epoch != frame.Epoch) {
            ForgetGpu();
        }
        if (GameGpuState.Gl == null || GameGpuState.Gl.RawPtr != frame.ApiPtr) {
            GameGpuState.Gl = GlApi.Bind(frame.ApiPtr);
        }
        GameGpuState.Epoch = frame.Epoch;
        if (!cleanupRegistered) {
            if (GlBridge.RegisterCleanup((nint)GameGpuResources.OnGpuCleanup) == 0) {
                return false;
            }
            cleanupRegistered = true;
        }
        return true;
    }

    public static bool Prepare(GpuFrameInfo frame) {
        if (!PrepareFast(frame)) { return false; }
        GlApi gl = GameGpuState.Gl;
        for (int i = 0; i < GlErrorLimit; i = i + 1) {
            if (gl.GetError() == 0u) { return true; }
        }
        return false;
    }

    private static void QueryFullLitUniforms(GlApi gl, GpuProgram p, uint prog) {
        p.ULightVp = GlBridge.UniformLoc(gl, prog, "uLightVP");
        p.UShadowMap = GlBridge.UniformLoc(gl, prog, "uShadowMap");
        p.UShadowOn = GlBridge.UniformLoc(gl, prog, "uShadowOn");
        p.UNormalMap = GlBridge.UniformLoc(gl, prog, "uNormalMap");
        p.UNormalOn = GlBridge.UniformLoc(gl, prog, "uNormalOn");
        p.UNormalScale = GlBridge.UniformLoc(gl, prog, "uNormalScale");
        p.UOrmMap = GlBridge.UniformLoc(gl, prog, "uOrmMap");
        p.UOrmOn = GlBridge.UniformLoc(gl, prog, "uOrmOn");
        p.UAoStrength = GlBridge.UniformLoc(gl, prog, "uAoStrength");
        p.UAlphaCutoff = GlBridge.UniformLoc(gl, prog, "uAlphaCutoff");
        p.UEmissiveMap = GlBridge.UniformLoc(gl, prog, "uEmissiveMap");
        p.UEmissiveOn = GlBridge.UniformLoc(gl, prog, "uEmissiveOn");
        p.UUvTransform = GlBridge.UniformLoc(gl, prog, "uUvTransform");
        p.URimLight = GlBridge.UniformLoc(gl, prog, "uRimLight");
        p.UToon = GlBridge.UniformLoc(gl, prog, "uToon");
        p.UDissolve = GlBridge.UniformLoc(gl, prog, "uDissolve");
        p.UDissolveEdge = GlBridge.UniformLoc(gl, prog, "uDissolveEdge");
        p.UClipPlane = GlBridge.UniformLoc(gl, prog, "uClipPlane");
        p.UClipOn = GlBridge.UniformLoc(gl, prog, "uClipOn");
        p.UTriplanar = GlBridge.UniformLoc(gl, prog, "uTriplanar");
        p.UHeightFogParams = GlBridge.UniformLoc(gl, prog, "uHeightFogParams");
        p.UHeightFogColor = GlBridge.UniformLoc(gl, prog, "uHeightFogColor");
        p.UHitFlash = GlBridge.UniformLoc(gl, prog, "uHitFlash");
        p.UHoloScanParams = GlBridge.UniformLoc(gl, prog, "uHoloScanParams");
        p.UHoloScanColor = GlBridge.UniformLoc(gl, prog, "uHoloScanColor");
        p.UTopCoverParams = GlBridge.UniformLoc(gl, prog, "uTopCoverParams");
        p.UTopCoverColor = GlBridge.UniformLoc(gl, prog, "uTopCoverColor");
        p.UWindParams = GlBridge.UniformLoc(gl, prog, "uWindParams");
        p.UDistFade = GlBridge.UniformLoc(gl, prog, "uDistFade");
        p.UWorldGridParams = GlBridge.UniformLoc(gl, prog, "uWorldGridParams");
        p.UWorldGridColor = GlBridge.UniformLoc(gl, prog, "uWorldGridColor");
        p.UCausticsParams = GlBridge.UniformLoc(gl, prog, "uCausticsParams");
        p.UCausticsColor = GlBridge.UniformLoc(gl, prog, "uCausticsColor");
        p.UIceFrostParams = GlBridge.UniformLoc(gl, prog, "uIceFrostParams");
        p.UIceFrostColor = GlBridge.UniformLoc(gl, prog, "uIceFrostColor");
        p.ULavaCrustParams = GlBridge.UniformLoc(gl, prog, "uLavaCrustParams");
        p.ULavaCrustColor = GlBridge.UniformLoc(gl, prog, "uLavaCrustColor");
        p.UIridescenceParams = GlBridge.UniformLoc(gl, prog, "uIridescenceParams");
        p.USonarOriginRadius = GlBridge.UniformLoc(gl, prog, "uSonarOriginRadius");
        p.USonarStyle = GlBridge.UniformLoc(gl, prog, "uSonarStyle");
        p.USonarColor = GlBridge.UniformLoc(gl, prog, "uSonarColor");
        p.UForceFieldParams = GlBridge.UniformLoc(gl, prog, "uForceFieldParams");
        p.UForceFieldColor = GlBridge.UniformLoc(gl, prog, "uForceFieldColor");
        p.URainRipplesParams = GlBridge.UniformLoc(gl, prog, "uRainRipplesParams");
        p.URainRipplesColor = GlBridge.UniformLoc(gl, prog, "uRainRipplesColor");
        p.UXrayParams = GlBridge.UniformLoc(gl, prog, "uXrayParams");
        p.UXrayColor = GlBridge.UniformLoc(gl, prog, "uXrayColor");
        p.UPortalVortexParams = GlBridge.UniformLoc(gl, prog, "uPortalVortexParams");
        p.UPortalVortexColor = GlBridge.UniformLoc(gl, prog, "uPortalVortexColor");
        p.UBlueprintWireParams = GlBridge.UniformLoc(gl, prog, "uBlueprintWireParams");
        p.UBlueprintWireColor = GlBridge.UniformLoc(gl, prog, "uBlueprintWireColor");
        p.UHeatHazeParams = GlBridge.UniformLoc(gl, prog, "uHeatHazeParams");
        p.UHeatHazeColor = GlBridge.UniformLoc(gl, prog, "uHeatHazeColor");
        p.UPixelDitherParams = GlBridge.UniformLoc(gl, prog, "uPixelDitherParams");
        p.UCrosshatchParams = GlBridge.UniformLoc(gl, prog, "uCrosshatchParams");
        p.UCrosshatchColor = GlBridge.UniformLoc(gl, prog, "uCrosshatchColor");
        p.UAnisoBrushedParams = GlBridge.UniformLoc(gl, prog, "uAnisoBrushedParams");
        p.UAnisoBrushedColor = GlBridge.UniformLoc(gl, prog, "uAnisoBrushedColor");
        p.UVelvetSheenParams = GlBridge.UniformLoc(gl, prog, "uVelvetSheenParams");
        p.UVelvetSheenColor = GlBridge.UniformLoc(gl, prog, "uVelvetSheenColor");
        p.USubsurfaceParams = GlBridge.UniformLoc(gl, prog, "uSubsurfaceParams");
        p.USubsurfaceColor = GlBridge.UniformLoc(gl, prog, "uSubsurfaceColor");
        p.UCamPos = GlBridge.UniformLoc(gl, prog, "uCamPos");
        p.UCamValid = GlBridge.UniformLoc(gl, prog, "uCamValid");
        p.UMaterial = GlBridge.UniformLoc(gl, prog, "uMaterial");
        p.UEmissive = GlBridge.UniformLoc(gl, prog, "uEmissive");
        p.UPointPos = GlBridge.UniformLoc(gl, prog, "uPointPos[0]");
        p.UPointColor = GlBridge.UniformLoc(gl, prog, "uPointColor[0]");
        p.UPointCount = GlBridge.UniformLoc(gl, prog, "uPointCount");
        p.USpotPos = GlBridge.UniformLoc(gl, prog, "uSpotPos[0]");
        p.USpotDir = GlBridge.UniformLoc(gl, prog, "uSpotDir[0]");
        p.USpotColor = GlBridge.UniformLoc(gl, prog, "uSpotColor[0]");
        p.USpotCount = GlBridge.UniformLoc(gl, prog, "uSpotCount");
        p.UHemiSky = GlBridge.UniformLoc(gl, prog, "uHemiSky");
        p.UHemiGround = GlBridge.UniformLoc(gl, prog, "uHemiGround");
        p.UHemiOn = GlBridge.UniformLoc(gl, prog, "uHemiOn");
        p.UPbrParams = GlBridge.UniformLoc(gl, prog, "uPbrParams");
        p.USkyHorizonCol = GlBridge.UniformLoc(gl, prog, "uSkyHorizonCol");
        p.UShadowTexel = GlBridge.UniformLoc(gl, prog, "uShadowTexel");
        p.UFogColor = GlBridge.UniformLoc(gl, prog, "uFogColor");
        p.UFogParams = GlBridge.UniformLoc(gl, prog, "uFogParams");
    }

    public static GpuProgram GetProgram(bool colored, int mode) {
        EnsureResInit();
        if (mode < 0 || mode > 2) { return null; }
        int slot = (colored ? 3 : 0) + mode;
        if (progs[slot] != null && progs[slot].Program != 0u) { return progs[slot]; }
        GlApi gl = GameGpuState.Gl;
        string head = GameGpuShaders.GlslHeader(gl);
        string vs = "";
        string fs = "";
        if (mode == 2) {
            vs = colored ? GameGpuShaders.VsInstLitColor() : GameGpuShaders.VsInstLit();
            fs = colored ? GameGpuShaders.FsInstLitColor() : GameGpuShaders.FsInstLit();
        } else if (mode == 1) {
            vs = colored ? GameGpuShaders.VsInstColor() : GameGpuShaders.VsInst();
            fs = colored ? GameGpuShaders.FsInstColor() : GameGpuShaders.FsInst();
        } else {
            vs = colored ? GameGpuShaders.VsColor() : GameGpuShaders.VsPlain();
            fs = colored ? GameGpuShaders.FsColor() : GameGpuShaders.FsPlain();
        }
        uint program = GlBridge.GpuProgram(head + vs, head + fs);
        if (program == 0u) { return null; }
        GpuProgram p = new GpuProgram();
        p.Program = program;
        p.UTex = GlBridge.UniformLoc(gl, program, "uTex");
        int pos = GlBridge.AttribLoc(gl, program, "a_pos");
        int normal = GlBridge.AttribLoc(gl, program, "a_normal");
        int uv = GlBridge.AttribLoc(gl, program, "a_uv");
        if (mode == 0) {
            p.UMvp = GlBridge.UniformLoc(gl, program, "uMVP");
            p.UModel = GlBridge.UniformLoc(gl, program, "uModel");
            p.UColor = GlBridge.UniformLoc(gl, program, "uColor");
        } else if (mode == 2) {
            p.UVp = GlBridge.UniformLoc(gl, program, "uVP");
        }
        p.ULightDir = GlBridge.UniformLoc(gl, program, "uLightDir[0]");
        p.ULightColor = GlBridge.UniformLoc(gl, program, "uLightColor[0]");
        p.ULightCount = GlBridge.UniformLoc(gl, program, "uLightCount");
        p.UAmbient = GlBridge.UniformLoc(gl, program, "uAmbient");
        if (mode != 1) {
            QueryFullLitUniforms(gl, p, program);
        }
        bool ok = p.UTex >= 0 && pos == LocPos && normal == LocNormal && uv == LocUv
            && (mode != 0 || (p.UMvp >= 0 && p.UColor >= 0))
            && (mode != 2 || p.UVp >= 0)
            && p.ULightDir >= 0 && p.ULightColor >= 0 && p.ULightCount >= 0 && p.UAmbient >= 0
            && gl.GetError() == 0u;
        if (ok && colored) {
            ok = GlBridge.AttribLoc(gl, program, "a_color") == LocColor;
        }
        if (ok && mode == 1) {
            ok = GlBridge.AttribLoc(gl, program, "i_mvp") == LocIMvp
                && GlBridge.AttribLoc(gl, program, "i_tint") == LocITint;
        }
        if (ok && mode == 2) {
            ok = GlBridge.AttribLoc(gl, program, "i_model") == LocIMvp
                && GlBridge.AttribLoc(gl, program, "i_tint") == LocITint;
        }
        if (!ok) {
            gl.DeleteProgram(program);
            return null;
        }
        progs[slot] = p;
        return p;
    }

    public static GpuProgram GetSkinProgram() {
        EnsureResInit();
        if (skinProg != null && skinProg.Program != 0u) { return skinProg; }
        GlApi gl = GameGpuState.Gl;
        string head = GameGpuShaders.GlslHeader(gl);
        uint program = GlBridge.GpuProgram(head + GameGpuShaders.VsSkinned(), head + GameGpuShaders.FsPlain());
        if (program == 0u) { return null; }
        GpuProgram p = new GpuProgram();
        p.Program = program;
        int pos = GlBridge.AttribLoc(gl, program, "a_pos");
        int normal = GlBridge.AttribLoc(gl, program, "a_normal");
        int uv = GlBridge.AttribLoc(gl, program, "a_uv");
        int joints = GlBridge.AttribLoc(gl, program, "a_joints");
        int weights = GlBridge.AttribLoc(gl, program, "a_weights");
        p.UMvp = GlBridge.UniformLoc(gl, program, "uMVP");
        p.UModel = GlBridge.UniformLoc(gl, program, "uModel");
        p.UBones = GlBridge.UniformLoc(gl, program, "uBones[0]");
        if (p.UBones < 0) { p.UBones = GlBridge.UniformLoc(gl, program, "uBones"); }
        p.UTex = GlBridge.UniformLoc(gl, program, "uTex");
        p.UColor = GlBridge.UniformLoc(gl, program, "uColor");
        p.ULightDir = GlBridge.UniformLoc(gl, program, "uLightDir[0]");
        p.ULightColor = GlBridge.UniformLoc(gl, program, "uLightColor[0]");
        p.ULightCount = GlBridge.UniformLoc(gl, program, "uLightCount");
        p.UAmbient = GlBridge.UniformLoc(gl, program, "uAmbient");
        QueryFullLitUniforms(gl, p, program);
        bool ok = pos == LocPos && normal == LocNormal && uv == LocUv
            && joints == LocJoints && weights == LocWeights
            && p.UMvp >= 0 && p.UBones >= 0 && p.UTex >= 0 && p.UColor >= 0
            && p.ULightDir >= 0 && p.ULightColor >= 0 && p.ULightCount >= 0 && p.UAmbient >= 0
            && gl.GetError() == 0u;
        if (!ok) {
            gl.DeleteProgram(program);
            return null;
        }
        skinProg = p;
        return p;
    }

