    public static uint ResolveTex(string texture, bool fallbackWhite) {
        EnsureResInit();
        if (texture == null || texture.Length == 0) {
            if (!fallbackWhite) { return 0u; }
            if (GameGpuState.WhiteTex == 0u) {
                GameGpuState.WhiteTex = GlBridge.GpuTexture(GlBridge.WhiteBitmapPtr());
            }
            return GameGpuState.WhiteTex;
        }
        for (int i = 0; i < GameGpuState.TexCacheCap; i = i + 1) {
            TexCacheEntry e = GameGpuState.TexCache[i];
            if (e.Gen == GameGpuState.TexCacheGen && e.Tex != 0u && e.Key == texture && e.BitmapPtr != 0) {
                BitmapView bv;
                if (GlBridge.ReadBitmap(e.BitmapPtr, out bv) && bv.Serial == e.Serial) {
                    return e.Tex;
                }
            }
        }
        nint bmpPtr = GlBridge.ImageGet(texture);
        BitmapView view;
        if (!GlBridge.ReadBitmap(bmpPtr, out view)) {
            if (!fallbackWhite) { return 0u; }
            if (GameGpuState.WhiteTex == 0u) {
                GameGpuState.WhiteTex = GlBridge.GpuTexture(GlBridge.WhiteBitmapPtr());
            }
            return GameGpuState.WhiteTex;
        }
        uint tex = GlBridge.GpuTexture(bmpPtr);
        if (tex != 0u) { Prepare3DTexture(tex, view); }
        if (tex == 0u && fallbackWhite) {
            if (GameGpuState.WhiteTex == 0u) {
                GameGpuState.WhiteTex = GlBridge.GpuTexture(GlBridge.WhiteBitmapPtr());
            }
            return GameGpuState.WhiteTex;
        }
        if (tex != 0u && texture.Length < 256) {
            TexCacheEntry dst = GameGpuState.TexCache[GameGpuState.TexCacheNext];
            GameGpuState.TexCacheNext = (GameGpuState.TexCacheNext + 1) % GameGpuState.TexCacheCap;
            dst.Key = texture;
            dst.BitmapPtr = bmpPtr;
            dst.Serial = view.Serial;
            dst.Tex = tex;
            dst.Gen = GameGpuState.TexCacheGen;
        }
        return tex;
    }

    // ---- 3D 材质纹理：REPEAT 平铺 + CPU 生成 mip 链 + 三线性 + 各向异性 ----
    // GUI 驱动按 2D 贴图规则建纹理（CLAMP、无 mip）。3D 世界材质需要平铺与远处不闪烁：
    // GL 函数表没有 glGenerateMipmap，这里在 CPU 上逐级 2×2 平均后用 TexImage2D 上传各级。
    // 每个 (纹理, 位图序号) 只处理一次；关闭：Texture3DQuality = 0。
    public static int Texture3DQuality = 2;     // 0 不处理 1 仅 REPEAT 2 REPEAT + mip + 各向异性
    public static int MaxAnisotropy = 8;
    private static Dictionary<uint, ulong> prepared3D;

    public static void Prepare3DTexture(uint tex, BitmapView view) {
        if (Texture3DQuality <= 0 || view.Pixels == 0 || view.Width <= 0 || view.Height <= 0) { return; }
        if (prepared3D == null) { prepared3D = new Dictionary<uint, ulong>(); }
        if (prepared3D.ContainsKey(tex) && prepared3D[tex] == view.Serial) { return; }
        prepared3D[tex] = view.Serial;
        GlApi gl = GameGpuState.Gl;
        if (gl == null) { return; }
        gl.ActiveTexture(GlBridge.TEXTURE0);
        gl.BindTexture(GlBridge.TEXTURE_2D, tex);
        GameGpuState.CurTex[0] = tex;
        gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_WRAP_S, (int)REPEAT);
        gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_WRAP_T, (int)REPEAT);
        if (Texture3DQuality < 2 || view.Width < 4 || view.Height < 4) { return; }
        bool gles = GlBridge.IsGlesVersion(gl);
        uint fmt = gles ? GlBridge.RGBA : BGRA;
        int w = view.Width; int h = view.Height;
        // 第 0 级拷成紧密排列，便于逐级缩小
        nint src = NativeMemory.Alloc(w * h * 4);
        Span<uint> s0 = new Span<uint>(src, w * h);
        Span<uint> vp = new Span<uint>(view.Pixels, view.Stride * h);
        for (int y = 0; y < h; y = y + 1) {
            int ro = y * view.Stride;
            int wo = y * w;
            for (int x = 0; x < w; x = x + 1) { s0[wo + x] = vp[ro + x]; }
        }
        int level = 0;
        while (w > 1 || h > 1) {
            int nw = w > 1 ? w / 2 : 1; int nh = h > 1 ? h / 2 : 1;
            nint dst = NativeMemory.Alloc(nw * nh * 4);
            Span<uint> a = new Span<uint>(src, w * h);
            Span<uint> b = new Span<uint>(dst, nw * nh);
            for (int y = 0; y < nh; y = y + 1) {
                int y0 = y * 2; int y1 = y0 + 1 < h ? y0 + 1 : y0;
                for (int x = 0; x < nw; x = x + 1) {
                    int x0 = x * 2; int x1 = x0 + 1 < w ? x0 + 1 : x0;
                    uint p0 = a[y0 * w + x0]; uint p1 = a[y0 * w + x1]; uint p2 = a[y1 * w + x0]; uint p3 = a[y1 * w + x1];
                    uint c0 = (((p0 & 0xFFu) + (p1 & 0xFFu) + (p2 & 0xFFu) + (p3 & 0xFFu) + 2u) >> 2);
                    uint c1 = ((((p0 >> 8) & 0xFFu) + ((p1 >> 8) & 0xFFu) + ((p2 >> 8) & 0xFFu) + ((p3 >> 8) & 0xFFu) + 2u) >> 2);
                    uint c2 = ((((p0 >> 16) & 0xFFu) + ((p1 >> 16) & 0xFFu) + ((p2 >> 16) & 0xFFu) + ((p3 >> 16) & 0xFFu) + 2u) >> 2);
                    uint c3 = ((((p0 >> 24) & 0xFFu) + ((p1 >> 24) & 0xFFu) + ((p2 >> 24) & 0xFFu) + ((p3 >> 24) & 0xFFu) + 2u) >> 2);
                    b[y * nw + x] = c0 | (c1 << 8) | (c2 << 16) | (c3 << 24);
                }
            }
            level = level + 1;
            gl.TexImage2D(GlBridge.TEXTURE_2D, level, (int)GlBridge.RGBA8, nw, nh, 0, fmt, GlBridge.UNSIGNED_BYTE, dst);
            NativeMemory.Free(src);
            src = dst; w = nw; h = nh;
        }
        NativeMemory.Free(src);
        gl.TexParameteri(GlBridge.TEXTURE_2D, TEXTURE_MAX_LEVEL, level);
        gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_MIN_FILTER, (int)LINEAR_MIPMAP_LINEAR);
        gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_MAG_FILTER, (int)GlBridge.LINEAR);
        if (MaxAnisotropy > 1) { gl.TexParameteri(GlBridge.TEXTURE_2D, TEXTURE_MAX_ANISOTROPY, MaxAnisotropy); }
    }
    private const uint REPEAT = 0x2901u;
    private const uint BGRA = 0x80E1u;
    private const uint LINEAR_MIPMAP_LINEAR = 0x2703u;
    private const uint TEXTURE_MAX_LEVEL = 0x813Du;
    private const uint TEXTURE_MAX_ANISOTROPY = 0x84FEu;

    public static void BindTexUnit(GlApi gl, int unit, uint tex) {
        if (GameGpuState.CurTex[unit] == tex) { return; }
        gl.ActiveTexture(GlBridge.TEXTURE0 + (uint)unit);
        gl.BindTexture(GlBridge.TEXTURE_2D, tex);
        GameGpuState.CurTex[unit] = tex;
    }

    public static void UseProgram(GlApi gl, GpuProgram prog) {
        if (GameGpuState.CurProg != prog.Program) {
            gl.UseProgram(prog.Program);
            GameGpuState.CurProg = prog.Program;
        }
        if (!prog.TexUnitsBound) {
            if (prog.UTex >= 0) { gl.Uniform1i(prog.UTex, 0); }
            if (prog.UShadowMap >= 0) { gl.Uniform1i(prog.UShadowMap, 1); }
            if (prog.UNormalMap >= 0) { gl.Uniform1i(prog.UNormalMap, 2); }
            if (prog.UOrmMap >= 0) { gl.Uniform1i(prog.UOrmMap, 3); }
            if (prog.UEmissiveMap >= 0) { gl.Uniform1i(prog.UEmissiveMap, 4); }
            prog.TexUnitsBound = true;
        }
    }

    public static GpuMesh FindMesh(int id, ulong epoch) {
        EnsureResInit();
        if (id <= 0) { return null; }
        GpuMesh m = null;
        if (meshMap.TryGetValue(id, out m) && m != null && m.Epoch == epoch) {
            return m;
        }
        return null;
    }

    public static int CreateMeshEx(int surfaceId, nint verts, int count, nint indices, int indexCount, int flags) {
        EnsureResInit();
        bool skinned = (flags & 2) != 0;
        bool colored = !skinned && (flags & 1) != 0;
        int vertexFloats = skinned ? 16 : (colored ? 12 : 8);
        if (verts == 0 || indices == 0 || count <= 0 || count > VertexCap || indexCount <= 0) {
            return 0;
        }
        if (meshes.Count >= MeshMaxCap) { return 0; }
        Span<ushort> idxSpan = new Span<ushort>(indices, indexCount);
        for (int i = 0; i < indexCount; i = i + 1) {
            if ((int)idxSpan[i] >= count) { return 0; }
        }

        GpuFrameInfo frame;
        bool ownsGpu = false;
        if (GameGpuState.FrameSurface == surfaceId) {
            frame = GameGpuState.FrameGpu;
        } else {
            if (!GlBridge.GpuBegin(surfaceId, out frame)) { return 0; }
            ownsGpu = true;
        }
        int result = 0;
        if (Prepare(frame)) {
            bool progOk = skinned ? (GetSkinProgram() != null) : (GetProgram(colored, 0) != null);
            if (progOk) {
                GlApi gl = GameGpuState.Gl;
                GpuMesh m = new GpuMesh();
                m.Vao = GlBridge.GenOne(gl.GenVertexArrays);
                if (m.Vao != 0u) {
                    gl.BindVertexArray(m.Vao);
                    m.Vbo = GlBridge.GenOne(gl.GenBuffers);
                    m.Ebo = GlBridge.GenOne(gl.GenBuffers);
                    if (m.Vbo != 0u && m.Ebo != 0u) {
                        gl.BindBuffer(GlBridge.ARRAY_BUFFER, m.Vbo);
                        gl.BufferData(GlBridge.ARRAY_BUFFER, (nint)(count * vertexFloats * 4), verts, GlBridge.STATIC_DRAW);
                        gl.BindBuffer(GlBridge.ELEMENT_ARRAY_BUFFER, m.Ebo);
                        gl.BufferData(GlBridge.ELEMENT_ARRAY_BUFFER, (nint)(indexCount * 2), indices, GlBridge.STATIC_DRAW);
                        int stride = vertexFloats * 4;
                        gl.EnableVertexAttribArray((uint)LocPos);
                        gl.VertexAttribPointer((uint)LocPos, 3, GlBridge.FLOAT, 0, stride, 0);
                        gl.EnableVertexAttribArray((uint)LocNormal);
                        gl.VertexAttribPointer((uint)LocNormal, 3, GlBridge.FLOAT, 0, stride, 12);
                        gl.EnableVertexAttribArray((uint)LocUv);
                        gl.VertexAttribPointer((uint)LocUv, 2, GlBridge.FLOAT, 0, stride, 24);
                        if (colored) {
                            gl.EnableVertexAttribArray((uint)LocColor);
                            gl.VertexAttribPointer((uint)LocColor, 4, GlBridge.FLOAT, 0, stride, 32);
                        } else if (skinned) {
                            gl.EnableVertexAttribArray((uint)LocJoints);
                            gl.VertexAttribPointer((uint)LocJoints, 4, GlBridge.FLOAT, 0, stride, 32);
                            gl.EnableVertexAttribArray((uint)LocWeights);
                            gl.VertexAttribPointer((uint)LocWeights, 4, GlBridge.FLOAT, 0, stride, 48);
                        }
                        if (gl.GetError() == 0u) {
                            m.IndexCount = indexCount;
                            m.Colored = colored;
                            m.Skinned = skinned;
                            m.Epoch = frame.Epoch;
                            m.Id = nextMeshId;
                            nextMeshId = nextMeshId + 1;
                            meshes.Add(m);
                            meshMap[m.Id] = m;
                            result = m.Id;
                        } else {
                            DropMesh(m);
                        }
                    } else {
                        DropMesh(m);
                    }
                    gl.BindVertexArray(0u);
                }
            }
        }
        if (ownsGpu) {
            GlBridge.GpuEnd(surfaceId);
            GameGpuState.InvalidateGlCache();
        }
        return result;
    }

    public static bool EnsureInstanceVbo(GlApi gl) {
        if (InstanceVbo != 0u) { return true; }
        InstanceVbo = GlBridge.GenOne(gl.GenBuffers);
        if (InstanceVbo == 0u) { return false; }
        gl.BindBuffer(GlBridge.ARRAY_BUFFER, InstanceVbo);
        gl.BufferData(GlBridge.ARRAY_BUFFER, (nint)(GameGpuState.InstanceCap * GameGpuState.InstanceFloats * 4), 0, GlBridge.STREAM_DRAW);
        gl.BindBuffer(GlBridge.ARRAY_BUFFER, 0u);
        return true;
    }

    public static void UploadInstances(GlApi gl, nint instances, int count) {
        nint capBytes = (nint)(GameGpuState.InstanceCap * GameGpuState.InstanceFloats * 4);
        nint uploadBytes = (nint)(count * GameGpuState.InstanceFloats * 4);
        gl.BindBuffer(GlBridge.ARRAY_BUFFER, InstanceVbo);
        gl.BufferData(GlBridge.ARRAY_BUFFER, capBytes, 0, GlBridge.STREAM_DRAW);
        gl.BufferSubData(GlBridge.ARRAY_BUFFER, 0, uploadBytes, instances);
        gl.BindBuffer(GlBridge.ARRAY_BUFFER, 0u);
    }

    public static bool MeshInstReady(GpuMesh mesh, GlApi gl) {
        if (mesh.InstReady) { return true; }
        if (!EnsureInstanceVbo(gl)) { return false; }
        gl.BindVertexArray(mesh.Vao);
        gl.BindBuffer(GlBridge.ARRAY_BUFFER, InstanceVbo);
        int stride = GameGpuState.InstanceFloats * 4;
        for (int i = 0; i < 4; i = i + 1) {
            uint loc = (uint)(LocIMvp + i);
            gl.EnableVertexAttribArray(loc);
            gl.VertexAttribPointer(loc, 4, GlBridge.FLOAT, 0, stride, (nint)(i * 16));
            gl.VertexAttribDivisor(loc, 1u);
        }
        gl.EnableVertexAttribArray((uint)LocITint);
        gl.VertexAttribPointer((uint)LocITint, 4, GlBridge.FLOAT, 0, stride, 64);
        gl.VertexAttribDivisor((uint)LocITint, 1u);
        gl.BindBuffer(GlBridge.ARRAY_BUFFER, 0u);
        gl.BindVertexArray(0u);
        mesh.InstReady = true;
        return true;
    }

    public static bool DepthReady(int surfaceId, GpuFrameInfo frame) {
        EnsureResInit();
        GpuDepth depth = depths[surfaceId];
        GlApi gl = GameGpuState.Gl;
        if (depth.Renderbuffer != 0u && (depth.Width != frame.Width || depth.Height != frame.Height)) {
            DropDepth(depth);
        }
        if (depth.Renderbuffer == 0u) {
            depth.Renderbuffer = GlBridge.GenOne(gl.GenRenderbuffers);
            if (depth.Renderbuffer == 0u) { return false; }
            gl.BindRenderbuffer(GlBridge.RENDERBUFFER, depth.Renderbuffer);
            gl.RenderbufferStorage(GlBridge.RENDERBUFFER, GlBridge.DEPTH_COMPONENT24, frame.Width, frame.Height);
            if (gl.GetError() != 0u) {
                gl.RenderbufferStorage(GlBridge.RENDERBUFFER, GlBridge.DEPTH_COMPONENT16, frame.Width, frame.Height);
            }
            depth.Width = frame.Width;
            depth.Height = frame.Height;
            depth.AttachedFbo = 0u;
        }
        if (depth.AttachedFbo != frame.Framebuffer) {
            gl.FramebufferRenderbuffer(GlBridge.FRAMEBUFFER, GlBridge.DEPTH_ATTACHMENT, GlBridge.RENDERBUFFER, depth.Renderbuffer);
            if (gl.CheckFramebufferStatus(GlBridge.FRAMEBUFFER) != GlBridge.FRAMEBUFFER_COMPLETE || gl.GetError() != 0u) {
                DropDepth(depth);
                return false;
            }
            depth.AttachedFbo = frame.Framebuffer;
        }
        return true;
    }

    public static bool ShadowFboReady(GlApi gl, int mapSize) {
        if (GameGpuState.ShadowFbo != 0u && GameGpuState.ShadowSize == mapSize) { return true; }
        DropShadow();
        GameGpuState.ShadowTex = GlBridge.GenOne(gl.GenTextures);
        if (GameGpuState.ShadowTex == 0u) { return false; }
        gl.BindTexture(GlBridge.TEXTURE_2D, GameGpuState.ShadowTex);
        gl.TexImage2D(GlBridge.TEXTURE_2D, 0, (int)GlBridge.DEPTH_COMPONENT24, mapSize, mapSize, 0, GlBridge.DEPTH_COMPONENT, GlBridge.UNSIGNED_INT, 0);
        if (gl.GetError() != 0u) {
            gl.TexImage2D(GlBridge.TEXTURE_2D, 0, (int)GlBridge.DEPTH_COMPONENT16, mapSize, mapSize, 0, GlBridge.DEPTH_COMPONENT, GlBridge.UNSIGNED_SHORT, 0);
        }
        gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_MIN_FILTER, (int)GlBridge.NEAREST);
        gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_MAG_FILTER, (int)GlBridge.NEAREST);
        gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_WRAP_S, (int)GlBridge.CLAMP_TO_EDGE);
        gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_WRAP_T, (int)GlBridge.CLAMP_TO_EDGE);
        GameGpuState.ShadowFbo = GlBridge.GenOne(gl.GenFramebuffers);
        if (GameGpuState.ShadowFbo == 0u) { DropShadow(); return false; }
        gl.BindFramebuffer(GlBridge.FRAMEBUFFER, GameGpuState.ShadowFbo);
        gl.FramebufferTexture2D(GlBridge.FRAMEBUFFER, GlBridge.DEPTH_ATTACHMENT, GlBridge.TEXTURE_2D, GameGpuState.ShadowTex, 0);
        if (gl.CheckFramebufferStatus(GlBridge.FRAMEBUFFER) != GlBridge.FRAMEBUFFER_COMPLETE || gl.GetError() != 0u) {
            DropShadow();
            return false;
        }
        GameGpuState.ShadowSize = mapSize;
        return true;
    }

    public static bool PostTargetReady(GpuFrameInfo frame) {
        GlApi gl = GameGpuState.Gl;
        if (!gl.HasBlitFramebuffer) { return false; }
        if (PostFbo != 0u && (PostW != frame.Width || PostH != frame.Height)) {
            GlBridge.DeleteOne(gl.DeleteFramebuffers, PostFbo);
            GlBridge.DeleteOne(gl.DeleteTextures, PostTex);
            PostFbo = 0u; PostTex = 0u; PostW = 0; PostH = 0;
        }
        if (PostFbo == 0u) {
            PostTex = GlBridge.GenOne(gl.GenTextures);
            if (PostTex == 0u) { return false; }
            gl.BindTexture(GlBridge.TEXTURE_2D, PostTex);
            gl.TexImage2D(GlBridge.TEXTURE_2D, 0, (int)GlBridge.RGBA8, frame.Width, frame.Height, 0, GlBridge.RGBA, GlBridge.UNSIGNED_BYTE, 0);
            gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_MIN_FILTER, (int)GlBridge.LINEAR);
            gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_MAG_FILTER, (int)GlBridge.LINEAR);
            gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_WRAP_S, (int)GlBridge.CLAMP_TO_EDGE);
            gl.TexParameteri(GlBridge.TEXTURE_2D, GlBridge.TEXTURE_WRAP_T, (int)GlBridge.CLAMP_TO_EDGE);
            PostFbo = GlBridge.GenOne(gl.GenFramebuffers);
            if (PostFbo == 0u) { GlBridge.DeleteOne(gl.DeleteTextures, PostTex); PostTex = 0u; return false; }
            gl.BindFramebuffer(GlBridge.FRAMEBUFFER, PostFbo);
            gl.FramebufferTexture2D(GlBridge.FRAMEBUFFER, GlBridge.COLOR_ATTACHMENT0, GlBridge.TEXTURE_2D, PostTex, 0);
            if (gl.CheckFramebufferStatus(GlBridge.FRAMEBUFFER) != GlBridge.FRAMEBUFFER_COMPLETE || gl.GetError() != 0u) {
                GlBridge.DeleteOne(gl.DeleteFramebuffers, PostFbo);
                GlBridge.DeleteOne(gl.DeleteTextures, PostTex);
                PostFbo = 0u; PostTex = 0u;
                return false;
            }
            PostW = frame.Width;
            PostH = frame.Height;
        }
        if (PostVao == 0u) {
            PostVao = GlBridge.GenOne(gl.GenVertexArrays);
            if (PostVao == 0u) { return false; }
        }
        return true;
    }
}
