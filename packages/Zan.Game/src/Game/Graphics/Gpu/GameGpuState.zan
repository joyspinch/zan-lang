        float cr = r > 0.0f ? r : 0.0f; float cg = g > 0.0f ? g : 0.0f; float cb = b > 0.0f ? b : 0.0f;
        if (AnisoOn == p0 && AnisoFreq == p1 && AnisoVal == anisotropy && AnisoStr == strength
            && AnisoR == cr && AnisoG == cg && AnisoB == cb) { return; }
        AnisoOn = p0; AnisoFreq = p1; AnisoVal = anisotropy; AnisoStr = strength;
        AnisoR = cr; AnisoG = cg; AnisoB = cb;
        VfxVersion = VfxVersion + 1u;
    }

    public static void SetVelvetSheen3D(int enabled, float roughness, float weaveFreq, float strength, float r, float g, float b) {
        float p0 = enabled != 0 ? 1.0f : 0.0f;
        if (roughness < 0.12f) { roughness = 0.12f; }
        if (roughness > 1.0f) { roughness = 1.0f; }
        float p2 = weaveFreq > 2.0f ? weaveFreq : 16.0f;
        if (strength < 0.0f) { strength = 0.0f; }
        if (strength > 3.0f) { strength = 3.0f; }
        float cr = r > 0.0f ? r : 0.0f; float cg = g > 0.0f ? g : 0.0f; float cb = b > 0.0f ? b : 0.0f;
        if (VelvetOn == p0 && VelvetRough == roughness && VelvetWeave == p2 && VelvetStr == strength
            && VelvetR == cr && VelvetG == cg && VelvetB == cb) { return; }
        VelvetOn = p0; VelvetRough = roughness; VelvetWeave = p2; VelvetStr = strength;
        VelvetR = cr; VelvetG = cg; VelvetB = cb;
        VfxVersion = VfxVersion + 1u;
    }

    public static void SetSubsurfaceWrap3D(int enabled, float wrap, float translucency, float power, float r, float g, float b) {
        float p0 = enabled != 0 ? 1.0f : 0.0f;
        if (wrap < 0.0f) { wrap = 0.0f; }
        if (wrap > 1.0f) { wrap = 1.0f; }
        if (translucency < 0.0f) { translucency = 0.0f; }
        if (translucency > 2.0f) { translucency = 2.0f; }
        if (power < 1.0f) { power = 1.0f; }
        if (power > 8.0f) { power = 8.0f; }
        float cr = r > 0.0f ? r : 0.0f; float cg = g > 0.0f ? g : 0.0f; float cb = b > 0.0f ? b : 0.0f;
        if (SssOn == p0 && SssWrap == wrap && SssTrans == translucency && SssPow == power
            && SssR == cr && SssG == cg && SssB == cb) { return; }
        SssOn = p0; SssWrap = wrap; SssTrans = translucency; SssPow = power;
        SssR = cr; SssG = cg; SssB = cb;
        VfxVersion = VfxVersion + 1u;
    }

    // ---- PostProcess Setters ----

    public static void SetColorGrade3D(float sat, float con, float tr, float tg, float tb) {
        ColorSat = sat >= 0.0f ? sat : 0.0f;
        ColorCon = con >= 0.0f ? con : 0.0f;
        ColorTintR = tr >= 0.0f ? tr : 0.0f;
        ColorTintG = tg >= 0.0f ? tg : 0.0f;
        ColorTintB = tb >= 0.0f ? tb : 0.0f;
    }

    public static void SetPostLens3D(float fxaa, float chromatic) {
        if (fxaa < 0.0f) { fxaa = 0.0f; } if (fxaa > 1.0f) { fxaa = 1.0f; }
        if (chromatic < 0.0f) { chromatic = 0.0f; } if (chromatic > 0.1f) { chromatic = 0.1f; }
        PostFxaa = fxaa; PostChromatic = chromatic;
    }

    public static void SetPostFilm3D(float sharpen, float grain, float seed) {
        if (sharpen < 0.0f) { sharpen = 0.0f; } if (sharpen > 2.0f) { sharpen = 2.0f; }
        if (grain < 0.0f) { grain = 0.0f; } if (grain > 0.5f) { grain = 0.5f; }
        PostSharpen = sharpen; PostGrain = grain; PostGrainSeed = seed;
    }

    public static void SetPostCinema3D(float letterbox, float amp, float freq, float phase) {
        if (letterbox < 0.0f) { letterbox = 0.0f; } if (letterbox > 0.45f) { letterbox = 0.45f; }
        if (amp < 0.0f) { amp = 0.0f; } if (amp > 0.08f) { amp = 0.08f; }
        PostLetterbox = letterbox; PostDistortAmp = amp;
        PostDistortFreq = freq > 0.001f ? freq : 16.0f; PostDistortPhase = phase;
    }

    public static void SetPostRadialBlur3D(float str, float cx, float cy) {
        if (str < 0.0f) { str = 0.0f; } if (str > 0.15f) { str = 0.15f; }
        if (cx < 0.0f) { cx = 0.0f; } if (cx > 1.0f) { cx = 1.0f; }
        if (cy < 0.0f) { cy = 0.0f; } if (cy > 1.0f) { cy = 1.0f; }
        PostRadialStr = str; PostRadialCx = cx; PostRadialCy = cy;
    }

    public static void SetPostPixelate3D(float pxSize, float posterize) {
        if (pxSize < 0.0f) { pxSize = 0.0f; } if (pxSize > 64.0f) { pxSize = 64.0f; }
        if (posterize < 0.0f) { posterize = 0.0f; } if (posterize > 64.0f) { posterize = 64.0f; }
        PostPixelSize = pxSize; PostPosterize = posterize;
    }

    public static void SetPostDuotone3D(float str, float dr, float dg, float db, float lr, float lg, float lb) {
        if (str < 0.0f) { str = 0.0f; } if (str > 1.0f) { str = 1.0f; }
        PostDuoDarkR = dr > 0.0f ? dr : 0.0f; PostDuoDarkG = dg > 0.0f ? dg : 0.0f; PostDuoDarkB = db > 0.0f ? db : 0.0f;
        PostDuoStr = str;
        PostDuoLightR = lr > 0.0f ? lr : 0.0f; PostDuoLightG = lg > 0.0f ? lg : 0.0f; PostDuoLightB = lb > 0.0f ? lb : 0.0f;
    }

    public static void SetPostCrtScanline3D(float intensity, float count, float curvature, float glowBoost) {
        if (intensity < 0.0f) { intensity = 0.0f; } if (intensity > 0.95f) { intensity = 0.95f; }
        if (count < 2.0f) { count = 64.0f; }
        if (curvature < 0.0f) { curvature = 0.0f; } if (curvature > 0.5f) { curvature = 0.5f; }
        if (glowBoost < 0.1f) { glowBoost = 1.0f; }
        PostCrtInt = intensity; PostCrtCount = count; PostCrtCurve = curvature; PostCrtGlow = glowBoost;
    }

    public static void SetPostEdgeOutline3D(float str, float thresh, float r, float g, float b) {
        if (str < 0.0f) { str = 0.0f; } if (str > 1.0f) { str = 1.0f; }
        if (thresh < 0.02f) { thresh = 0.02f; } if (thresh > 1.0f) { thresh = 1.0f; }
        PostOutlineStr = str; PostOutlineThresh = thresh;
        PostOutlineR = r > 0.0f ? r : 0.0f; PostOutlineG = g > 0.0f ? g : 0.0f; PostOutlineB = b > 0.0f ? b : 0.0f;
    }

