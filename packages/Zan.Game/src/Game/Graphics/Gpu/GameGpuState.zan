    public static void SetPostGodRays3D(float str, float decay, float lx, float ly) {
        if (str < 0.0f) { str = 0.0f; } if (str > 2.0f) { str = 2.0f; }
        if (decay < 0.70f) { decay = 0.70f; } if (decay > 0.99f) { decay = 0.99f; }
        if (lx < 0.0f) { lx = 0.0f; } if (lx > 1.0f) { lx = 1.0f; }
        if (ly < 0.0f) { ly = 0.0f; } if (ly > 1.0f) { ly = 1.0f; }
