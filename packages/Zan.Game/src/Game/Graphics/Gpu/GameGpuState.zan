    // 2D 精灵注册表
    private static List<string> sprites;
    private static Dictionary<string, int> spriteMap;

    public static void EnsureInit() {
        if (initialized) { return; }
        initialized = true;
        FloatBuf = NativeMemory.Alloc(TotalFloatBufBytes);
        NativeMemory.Fill(FloatBuf, 0, TotalFloatBufBytes);
        Span<float> f = new Span<float>(FloatBuf, TotalFloatBufBytes / 4);
        // 缺省键光（与旧固定着色器逐位一致）
        f[OffLightDir / 4 + 0] = 0.4f;
        f[OffLightDir / 4 + 1] = 0.8f;
        f[OffLightDir / 4 + 2] = 0.6f;
        f[OffLightColor / 4 + 0] = 0.45f;
        f[OffLightColor / 4 + 1] = 0.45f;
        f[OffLightColor / 4 + 2] = 0.45f;
        f[OffAmbient / 4 + 0] = 0.55f;
        f[OffAmbient / 4 + 1] = 0.55f;
        f[OffAmbient / 4 + 2] = 0.55f;
        f[OffHemiSky / 4 + 0] = 0.35f;
        f[OffHemiSky / 4 + 1] = 0.50f;
        f[OffHemiSky / 4 + 2] = 0.72f;
        f[OffHemiGround / 4 + 0] = 0.16f;
        f[OffHemiGround / 4 + 1] = 0.14f;
        f[OffHemiGround / 4 + 2] = 0.12f;
        // 单位矩阵：ShadowLightVp、IdentityMat4 及全部 64 块骨骼
        WriteIdentity(f, OffShadowLightVp / 4);
        WriteIdentity(f, OffIdentityMat4 / 4);
        for (int i = 0; i < MaxBones; i = i + 1) {
            WriteIdentity(f, OffBones / 4 + i * 16);
        }
        CurTex = new uint[5];
        TexCache = new TexCacheEntry[TexCacheCap];
        for (int i = 0; i < TexCacheCap; i = i + 1) {
            TexCache[i] = new TexCacheEntry();
        }
        sprites = new List<string>();
        spriteMap = new Dictionary<string, int>();
    }

    private static void WriteIdentity(Span<float> f, int baseIdx) {
        for (int i = 0; i < 16; i = i + 1) { f[baseIdx + i] = 0.0f; }
        f[baseIdx + 0] = 1.0f;
        f[baseIdx + 5] = 1.0f;
        f[baseIdx + 10] = 1.0f;
        f[baseIdx + 15] = 1.0f;
    }

    public static void InvalidateGlCache() {
        CurProg = 0u;
        if (CurTex != null) {
            for (int i = 0; i < 5; i = i + 1) { CurTex[i] = 0u; }
        }
        CurBlend = -1;
        CurDepthWrite = -1;
        CurCull = -1;
        ShadowCurProg = 0u;
    }

    // ---- 2D 精灵烘焙与批量提交 ----

    public static int SpriteHandle(string key) {
        EnsureInit();
        if (key == null || key.Length == 0 || key.Length >= 512) { return 0; }
        int existing = 0;
        if (spriteMap.TryGetValue(key, out existing)) { return existing; }
        if (sprites.Count >= SpriteCap) { return 0; }
        BitmapView bv;
        if (!GlBridge.ReadBitmap(GlBridge.ImageGet(key), out bv)) { return 0; }
        sprites.Add(key);
        int h = sprites.Count;
        spriteMap[key] = h;
        return h;
    }

    public static int BakeSprite(string key, int surfaceId, int x, int y, int width, int height) {
        EnsureInit();
        if (key == null || key.Length == 0) { return 0; }
        string fullKey = key.StartsWith("mem:") ? key : ("mem:" + key);
        if (fullKey.Length >= 512) { return 0; }
        int existing = 0;
        bool hasExisting = spriteMap.TryGetValue(fullKey, out existing);
        if (!hasExisting && sprites.Count >= SpriteCap) { return 0; }
        BitmapView src;
        if (!GlBridge.ReadBitmap(GlBridge.SurfaceBitmap(surfaceId), out src)) { return 0; }
        long bx = x;
        long by = y;
        long bw = width > 0 ? width : src.Width;
        long bh = height > 0 ? height : src.Height;
        if (bx < 0) { bw = bw + bx; bx = 0; }
        if (by < 0) { bh = bh + by; by = 0; }
        if (bx >= src.Width || by >= src.Height) { return 0; }
        if (bw > src.Width - bx) { bw = src.Width - bx; }
        if (bh > src.Height - by) { bh = src.Height - by; }
        if (bw <= 0 || bh <= 0) { return 0; }
        nint slice = src.Pixels + (nint)((by * (long)src.Stride + bx) * 4L);
        if (GlBridge.ImageRegisterArgb(fullKey, slice, (int)bw, (int)bh, src.Stride) <= 0) {
            return 0;
        }
        if (hasExisting) { return existing; }
        sprites.Add(fullKey);
        int h = sprites.Count;
        spriteMap[fullKey] = h;
        return h;
    }

    public static void SpriteBatch(int surfaceId, int handle, nint quads, int count) {
        EnsureInit();
        if (quads == 0 || count <= 0 || handle <= 0 || handle > sprites.Count) { return; }
        nint bmpPtr = GlBridge.ImageGet(sprites[handle - 1]);
        BitmapView bv;
        if (!GlBridge.ReadBitmap(bmpPtr, out bv)) { return; }
        GlBridge.BlitPixelsBatch(surfaceId, bmpPtr, quads, count);
    }

    // ---- 核心 3D 状态 Setter（全量 compare-before-write 维护脏版本号）----

    public static int SetLights3D(int count, nint dirs, nint colors, nint ambient) {
        EnsureInit();
        if (count < 0 || count > MaxLights) { return 0; }
        if (count > 0 && (dirs == 0 || colors == 0)) { return 0; }
        if (count > 0) {
            NativeMemory.Copy(FloatBuf + OffLightDir, dirs, count * 12);
            NativeMemory.Copy(FloatBuf + OffLightColor, colors, count * 12);
        }
        LightCount = count;
        if (ambient != 0) {
            NativeMemory.Copy(FloatBuf + OffAmbient, ambient, 12);
        }
        LightVersion = LightVersion + 1u;
        return 1;
    }

    public static int SetBlend3D(int enabled, int depthWrite) {
        BlendEnabled = (enabled == 2) ? 2 : (enabled != 0 ? 1 : 0);
        DepthWrite = depthWrite != 0 ? 1 : 0;
        if (BatchSurface >= 0 && Gl != null) {
            GameGpuRenderer.ApplyBlendState(Gl);
        }
        return 1;
    }

    public static int SetCull3D(int mode) {
        if (mode < 0 || mode > 2) { return 0; }
        CullMode = mode;
        if (BatchSurface >= 0 && Gl != null) {
            GameGpuRenderer.ApplyBlendState(Gl);
        }
        return 1;
    }

    public static void SetCamera3D(float x, float y, float z) {
        EnsureInit();
        Span<float> cp = new Span<float>(FloatBuf + OffCamPos, 3);
        if (CamValid != 0 && cp[0] == x && cp[1] == y && cp[2] == z) { return; }
        cp[0] = x; cp[1] = y; cp[2] = z;
        CamValid = 1;
        LightVersion = LightVersion + 1u;
    }

    public static void SetMaterial3D(float metallic, float roughness, float emR, float emG, float emB) {
        EnsureInit();
        if (metallic < 0.0f) { metallic = 0.0f; }
        if (metallic > 1.0f) { metallic = 1.0f; }
        if (roughness < 0.05f) { roughness = 0.05f; }
        if (roughness > 1.0f) { roughness = 1.0f; }
        Span<float> em = new Span<float>(FloatBuf + OffEmissive, 3);
        if (MatMetallic == metallic && MatRoughness == roughness
            && em[0] == emR && em[1] == emG && em[2] == emB) { return; }
        MatMetallic = metallic;
        MatRoughness = roughness;
        em[0] = emR; em[1] = emG; em[2] = emB;
        MatVersion = MatVersion + 1u;
    }

    public static int SetPointLights3D(int count, nint posRange4, nint colors3) {
        EnsureInit();
        if (count < 0 || count > MaxLights) { return 0; }
        if (count > 0 && (posRange4 == 0 || colors3 == 0)) { return 0; }
        NativeMemory.Fill(FloatBuf + OffPointPos, 0, MaxLights * 16);
        NativeMemory.Fill(FloatBuf + OffPointColor, 0, MaxLights * 12);
        if (count > 0) {
            NativeMemory.Copy(FloatBuf + OffPointPos, posRange4, count * 16);
            NativeMemory.Copy(FloatBuf + OffPointColor, colors3, count * 12);
        }
        PointCount = count;
        LightVersion = LightVersion + 1u;
        return 1;
    }

    public static int SetSpotLights3D(int count, nint posRange4, nint dirInner4, nint colorOuter4) {
        EnsureInit();
        if (count < 0 || count > MaxLights) { return 0; }
        if (count > 0 && (posRange4 == 0 || dirInner4 == 0 || colorOuter4 == 0)) { return 0; }
        SpotCount = count;
        if (count > 0) {
            NativeMemory.Copy(FloatBuf + OffSpotPos, posRange4, count * 16);
            NativeMemory.Copy(FloatBuf + OffSpotDir, dirInner4, count * 16);
            NativeMemory.Copy(FloatBuf + OffSpotColor, colorOuter4, count * 16);
        }
        LightVersion = LightVersion + 1u;
        return 1;
    }

    public static void SetPbrShading3D(int enabled, float exposure, int tonemap, float envIntensity) {
        EnsureInit();
        PbrOn = enabled != 0 ? 1 : 0;
        PbrExposure = exposure > 0.0f ? exposure : 1.0f;
        PbrTonemap = tonemap != 0 ? 1.0f : 0.0f;
        PbrEnv = envIntensity >= 0.0f ? envIntensity : 1.0f;
        LightVersion = LightVersion + 1u;
    }

    // 物理着色的天空：顶色沿用半球环境光的天空色、地面色沿用地面反弹色，这里设地平线色。
    public static void SetSkyHorizon3D(float r, float g, float b) {
        EnsureInit();
        SkyHorR = r; SkyHorG = g; SkyHorB = b;
        LightVersion = LightVersion + 1u;
    }

    public static void SetHemiAmbient3D(int enabled, float sr, float sg, float sb, float gr, float gg, float gb) {
        EnsureInit();
        HemiOn = enabled != 0 ? 1 : 0;
        Span<float> hs = new Span<float>(FloatBuf + OffHemiSky, 3);
        Span<float> hg = new Span<float>(FloatBuf + OffHemiGround, 3);
        hs[0] = sr; hs[1] = sg; hs[2] = sb;
        hg[0] = gr; hg[1] = gg; hg[2] = gb;
        LightVersion = LightVersion + 1u;
    }

    public static void SetFog3D(int enabled, float r, float g, float b, float startDist, float endDist) {
        EnsureInit();
        float span = endDist - startDist;
        if (span < 0.0001f) { span = 0.0001f; }
        float on = enabled != 0 ? 1.0f : 0.0f;
        float invSpan = 1.0f / span;
        Span<float> fc = new Span<float>(FloatBuf + OffFogColor, 3);
        Span<float> fp = new Span<float>(FloatBuf + OffFogParams, 3);
        if (fp[0] == on && fp[1] == startDist && fp[2] == invSpan
            && fc[0] == r && fc[1] == g && fc[2] == b) { return; }
        fc[0] = r; fc[1] = g; fc[2] = b;
        fp[0] = on; fp[1] = startDist; fp[2] = invSpan;
        LightVersion = LightVersion + 1u;
    }

    public static int SetBones3D(int count, nint matrices16) {
        EnsureInit();
        if (count < 0 || count > MaxBones) { return 0; }
        if (count > 0 && matrices16 == 0) { return 0; }
        if (count > 0) {
            NativeMemory.Copy(FloatBuf + OffBones, matrices16, count * 64);
        }
        for (int i = count; i < MaxBones; i = i + 1) {
            NativeMemory.Copy(FloatBuf + OffBones + i * 64, FloatBuf + OffIdentityMat4, 64);
        }
        BoneCount = count;
        return 1;
    }

    public static void SetNormalMap3D(string texture, float scale) {
        if (texture == null || texture.Length == 0 || scale <= 0.0f) {
            if (NormalKey == "" && NormalScale == 0.0f) { return; }
            NormalKey = "";
            NormalScale = 0.0f;
            MatVersion = MatVersion + 1u;
            return;
        }
        if (NormalScale == scale && NormalKey == texture) { return; }
        NormalKey = texture;
        NormalScale = scale;
        MatVersion = MatVersion + 1u;
    }

