using System;
using System.Collections.Generic;
using Gui;

namespace Game.Graphics;

// 2D 骨架姿态容器（SkeletonPose）。
// 管理角色全身骨骼拓扑树，保证父子骨骼世界坐标变换的正确求值顺序，
// 并提供调试线框可视化与骨骼查找。
public class SkeletonPose {
    public List<Bone2D> bones;
    public double rootX;
    public double rootY;

    public SkeletonPose() {
        this.bones = new List<Bone2D>();
        this.rootX = 0.0;
        this.rootY = 0.0;
    }

    public static SkeletonPose Create() {
        return new SkeletonPose();
    }

    public int BoneCount {
        get { return bones.Count; }
    }

    // 添加骨骼。保证父骨骼必须在子骨骼之前添加，以满足拓扑更新序。
    public int AddBone(Bone2D bone) {
        if (bone == null) { return -1; }
        bones.Add(bone);
        return bones.Count - 1;
    }

    public Bone2D GetBone(int index) {
        if (index < 0 || index >= bones.Count) { return null; }
        return bones[index];
    }

    // 查找骨骼索引
    public int FindBoneIndex(string boneName) {
        if (boneName == null) { return -1; }
        for (int i = 0; i < bones.Count; i = i + 1) {
            if (bones[i].name == boneName) {
                return i;
            }
        }
        return -1;
    }

    // 设置根骨骼在世界空间的原点坐标
    public void SetRootPosition(double x, double y) {
        this.rootX = x;
        this.rootY = y;
    }

    // 全身世界变换拓扑更新
    public void UpdateWorldTransforms() {
        for (int i = 0; i < bones.Count; i = i + 1) {
            Bone2D bone = bones[i];
            Bone2D parent = null;
            if (bone.parentIndex >= 0 && bone.parentIndex < i) {
                parent = bones[bone.parentIndex];
            }

            bone.UpdateWorldTransform(parent);

            // 如果是根骨骼，偏移到角色的 rootX, rootY
            if (parent == null) {
                bone.worldX = bone.worldX + this.rootX;
                bone.worldY = bone.worldY + this.rootY;
            }
        }
    }

    // 调试绘制骨架：用细线连接关节至骨尖
    public void DebugDrawBones(Canvas c, int boneColor, int jointColor) {
        if (c == null) { return; }

        for (int i = 0; i < bones.Count; i = i + 1) {
            Bone2D b = bones[i];
            double tipX = 0.0;
            double tipY = 0.0;
            b.GetWorldTip(out tipX, out tipY);

            // 绘制骨骼主干线
            c.DrawLine((int)b.worldX, (int)b.worldY, (int)tipX, (int)tipY, boneColor, 1);

            // 绘制关节圆点
            c.DrawCircle((int)b.worldX, (int)b.worldY, 3, jointColor, 1);
        }
    }
}
