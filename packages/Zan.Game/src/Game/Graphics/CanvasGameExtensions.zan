    // 设置 GPU 后处理边缘锐化（0..2）与时间胶片颗粒（0..0.5）。
    public static void SetPostFilm3D(this Canvas c, float sharpenStrength,
    float grainStrength, float grainSeed) {
        if (c == null) { return; }
