    public static int SpriteHandle(this Canvas c, string key) {
        if (c == null) { return 0; }
        return zan_game_sprite_handle(key);
    }

    public static int BakeSprite(this Canvas c, string key, int x, int y, int w, int h) {
        if (c == null) { return 0; }
        return zan_game_bake_sprite(key, c.SurfaceId(), x, y, w, h);
    }

    public static int BakeSprite(this Canvas c, string key) {
        if (c == null) { return 0; }
        return zan_game_bake_sprite(key, c.SurfaceId(), 0, 0, c.Width(), c.Height());
    }

    public static void DrawSprites(this Canvas c, int handle, nint quads, int count) {
        if (c == null || handle <= 0 || count <= 0) { return; }
        PaintHash.Op(41, handle, count, 0, 0);
        zan_game_sprite_batch(c.SurfaceId(), handle, quads, count);
    }

    private static nint meshUploadVertBuf;
    private static int meshUploadVertCap;
    private static nint meshUploadIdxBuf;
    private static int meshUploadIdxCap;

    public static int MeshUpload(this Canvas c, Mesh3D mesh) {
        if (c == null || mesh == null) { return 0; }
        int nv = mesh.VertexCount();
        int ni = mesh.IndexCount();
        if (nv <= 0 || ni <= 0) { return 0; }
        int stride = mesh.StrideFloats();
        int totalFloats = nv * stride;
        int vertBytes = totalFloats * 4;
        if (vertBytes > meshUploadVertCap) {
            if (meshUploadVertBuf != 0) {
                NativeMemory.Free(meshUploadVertBuf);
            }
            int newCap = vertBytes < 65536 ? 65536 : vertBytes * 2;
            meshUploadVertBuf = NativeMemory.Alloc(newCap);
            meshUploadVertCap = newCap;
        }
        mesh.CopyVerticesTo(meshUploadVertBuf);

        int idxBytes = ni * 2;
        if (idxBytes > meshUploadIdxCap) {
            if (meshUploadIdxBuf != 0) {
                NativeMemory.Free(meshUploadIdxBuf);
            }
            int newCap = idxBytes < 32768 ? 32768 : idxBytes * 2;
            meshUploadIdxBuf = NativeMemory.Alloc(newCap);
            meshUploadIdxCap = newCap;
        }
        mesh.CopyIndicesTo(meshUploadIdxBuf);

        return zan_game_mesh_create_ex(c.SurfaceId(), meshUploadVertBuf, nv,
        meshUploadIdxBuf, ni, mesh.Colored() ? 1 : 0);
    }

    private static nint cachedMvpPtr;
    private static nint lightDirsBuf;
    private static int lightDirsCap;
    private static nint lightColorsBuf;
    private static int lightColorsCap;
    private static nint lightAmbientBuf;

    public static int DrawMesh3D(this Canvas c, int mesh, float[] mvpColumnMajor, int color,
    string texture) {
        if (c == null || mvpColumnMajor == null || mvpColumnMajor.Length < 16) { return 0; }
        if (cachedMvpPtr == 0) {
            cachedMvpPtr = NativeMemory.Alloc(64);
        }
        Span<float> ms = new Span<float>(cachedMvpPtr, 16);
        for (int i = 0; i < 16; i = i + 1) { ms[i] = mvpColumnMajor[i]; }
        string texKey = texture == null ? "" : texture;
        return zan_game_draw3d(c.SurfaceId(), mesh, cachedMvpPtr, color, texKey);
    }

    public static int DrawMesh3D(this Canvas c, int mesh, Mat4 mvp, int color, string texture) {
        if (c == null || mvp == null || mvp.m == null || mvp.m.Length < 16) { return 0; }
        if (cachedMvpPtr == 0) {
            cachedMvpPtr = NativeMemory.Alloc(64);
        }
        Span<float> ms = new Span<float>(cachedMvpPtr, 16);
        float[] m = mvp.m;
        ms[0] = m[0];  ms[1] = m[4];  ms[2] = m[8];   ms[3] = m[12];
        ms[4] = m[1];  ms[5] = m[5];  ms[6] = m[9];   ms[7] = m[13];
        ms[8] = m[2];  ms[9] = m[6];  ms[10] = m[10]; ms[11] = m[14];
        ms[12] = m[3]; ms[13] = m[7]; ms[14] = m[11]; ms[15] = m[15];
        string texKey = texture == null ? "" : texture;
        return zan_game_draw3d(c.SurfaceId(), mesh, cachedMvpPtr, color, texKey);
    }

    public static int SetLights3D(this Canvas c, float[] dirs, float[] colors, float[] ambient) {
        if (c == null) { return 0; }
        int count = dirs == null ? 0 : dirs.Length / 3;
        if (count > 4) { return 0; }
        if (count > 0 &&
        (colors == null || colors.Length < count * 3)) { return 0; }
        int dirBytes = count * 3 * 4;
        if (dirBytes > lightDirsCap) {
            if (lightDirsBuf != 0) {
                NativeMemory.Free(lightDirsBuf);
            }
            lightDirsBuf = NativeMemory.Alloc(dirBytes < 96 ? 96 : dirBytes * 2);
            lightDirsCap = dirBytes < 96 ? 96 : dirBytes * 2;
        }
        if (count > 0) {
            Span<float> ds = new Span<float>(lightDirsBuf, count * 3);
            for (int i = 0; i < count * 3; i = i + 1) { ds[i] = dirs[i]; }
            int colorBytes = colors.Length * 4;
            if (colorBytes > lightColorsCap) {
                if (lightColorsBuf != 0) {
                    NativeMemory.Free(lightColorsBuf);
                }
                lightColorsBuf = NativeMemory.Alloc(
                colorBytes < 96 ? 96 : colorBytes * 2);
                lightColorsCap = colorBytes < 96 ? 96 : colorBytes * 2;
            }
            Span<float> cs = new Span<float>(lightColorsBuf, colors.Length);
            for (int i = 0; i < colors.Length; i = i + 1) { cs[i] = colors[i]; }
        }
        if (lightAmbientBuf == 0) {
            lightAmbientBuf = NativeMemory.Alloc(12);
        }
        nint ambientPtr = 0;
        if (ambient != null && ambient.Length >= 3) {
            Span<float> ab = new Span<float>(lightAmbientBuf, 3);
            ab[0] = ambient[0];
            ab[1] = ambient[1];
            ab[2] = ambient[2];
            ambientPtr = lightAmbientBuf;
        }
        return zan_game_set_lights3d(count, lightDirsBuf, lightColorsBuf,
        ambientPtr);
    }

    public static int DrawMesh3DBatchBegin(this Canvas c) {
        if (c == null) { return 0; }
        return zan_game_draw3d_batch_begin(c.SurfaceId());
    }

    public static int DrawMesh3DBatch(this Canvas c, int mesh, string texture, nint instances,
    int count) {
        if (c == null || instances == 0 || count <= 0) { return 0; }
        PaintHash.Op(42, mesh, count, 0, 0);
        string texKey = texture == null ? "" : texture;
        return zan_game_draw3d_batch(c.SurfaceId(), mesh, texKey, instances,
        count);
    }

    public static int DrawMesh3DBatchEnd(this Canvas c) {
        if (c == null) { return 0; }
        return zan_game_draw3d_batch_end(c.SurfaceId());
    }

    private static nint cachedModelPtr;
    private static nint cachedBonesPtr;
    private static int cachedBonesCap;
    private static nint pointPosBuf;
    private static nint pointColBuf;

    // 设置 3D 世界空间相机坐标（驱动 GPU 高光视角向量与线性距离雾）。
    public static void SetCamera3D(this Canvas c, float x, float y, float z) {
        if (c == null) { return; }
        zan_game_set_camera3d(x, y, z);
    }

    // 设置 3D PBR 材质参数与自发光（metallic 0..1, roughness 0..1, emissive RGB）。
    public static void SetMaterial3D(this Canvas c, float metallic, float roughness,
    float emR, float emG, float emB) {
        if (c == null) { return; }
        zan_game_set_material3d(metallic, roughness, emR, emG, emB);
    }

    // 设置最多 4 盏动态点光源：posRange4 每盏 [x,y,z,radius]，colors3 每盏 [r,g,b]；传 null 清零。
    public static int SetPointLights3D(this Canvas c, float[] posRange4, float[] colors3) {
        if (c == null) { return 0; }
        if (posRange4 == null || colors3 == null || posRange4.Length < 4 || colors3.Length < 3) {
            return zan_game_set_point_lights3d(0, 0, 0);
        }
        int count = posRange4.Length / 4;
        int cCount = colors3.Length / 3;
        if (cCount < count) { count = cCount; }
        if (count > 4) { count = 4; }
        if (pointPosBuf == 0) { pointPosBuf = NativeMemory.Alloc(4 * 4 * 4); }
        if (pointColBuf == 0) { pointColBuf = NativeMemory.Alloc(4 * 3 * 4); }
        Span<float> ps = new Span<float>(pointPosBuf, count * 4);
        Span<float> cs = new Span<float>(pointColBuf, count * 3);
        for (int i = 0; i < count * 4; i = i + 1) { ps[i] = posRange4[i]; }
        for (int i = 0; i < count * 3; i = i + 1) { cs[i] = colors3[i]; }
        return zan_game_set_point_lights3d(count, pointPosBuf, pointColBuf);
    }

    // 设置 3D 线性大气距离雾（startDist 到 endDist 之间平滑混入雾色）。
    public static void SetFog3D(this Canvas c, bool enabled, float r, float g, float b,
    float startDist, float endDist) {
        if (c == null) { return; }
        zan_game_set_fog3d(enabled ? 1 : 0, r, g, b, startDist, endDist);
    }

    private static void WriteMat4ColumnMajor(nint dst, Mat4 mat) {
        Span<float> ms = new Span<float>(dst, 16);
        float[] m = mat.m;
        ms[0] = m[0];  ms[1] = m[4];  ms[2] = m[8];   ms[3] = m[12];
        ms[4] = m[1];  ms[5] = m[5];  ms[6] = m[9];   ms[7] = m[13];
        ms[8] = m[2];  ms[9] = m[6];  ms[10] = m[10]; ms[11] = m[14];
        ms[12] = m[3]; ms[13] = m[7]; ms[14] = m[11]; ms[15] = m[15];
    }

    private static void EnsureMatBuffers() {
        if (cachedMvpPtr == 0) { cachedMvpPtr = NativeMemory.Alloc(64); }
        if (cachedModelPtr == 0) { cachedModelPtr = NativeMemory.Alloc(64); }
    }

    // 上传 GPU 蒙皮网格（flags bit1 = 2，16 float/顶点）。
    public static int MeshUploadSkinned(this Canvas c, SkinnedMesh3D mesh) {
        if (c == null || mesh == null) { return 0; }
        int nv = mesh.VertexCount();
        int ni = mesh.IndexCount();
        if (nv <= 0 || ni <= 0) { return 0; }
        int vertBytes = nv * mesh.StrideFloats() * 4;
        if (vertBytes > meshUploadVertCap) {
            if (meshUploadVertBuf != 0) { NativeMemory.Free(meshUploadVertBuf); }
            int newCap = vertBytes < 65536 ? 65536 : vertBytes * 2;
            meshUploadVertBuf = NativeMemory.Alloc(newCap);
            meshUploadVertCap = newCap;
        }
        mesh.CopyVerticesTo(meshUploadVertBuf);

        int idxBytes = ni * 2;
        if (idxBytes > meshUploadIdxCap) {
            if (meshUploadIdxBuf != 0) { NativeMemory.Free(meshUploadIdxBuf); }
            int newCap = idxBytes < 32768 ? 32768 : idxBytes * 2;
            meshUploadIdxBuf = NativeMemory.Alloc(newCap);
            meshUploadIdxCap = newCap;
        }
        mesh.CopyIndicesTo(meshUploadIdxBuf);

        return zan_game_mesh_create_ex(c.SurfaceId(), meshUploadVertBuf, nv,
            meshUploadIdxBuf, ni, 2);
    }

    // 控制 3D Alpha 混合与深度写入（半透明物体设为 enabled=true, depthWrite=false，画完切回 false, true）。
    public static int SetBlend3D(this Canvas c, bool enabled, bool depthWrite) {
        if (c == null) { return 0; }
        return zan_game_set_blend3d(enabled ? 1 : 0, depthWrite ? 1 : 0);
    }

    // 控制 3D 混合模式（0=不透明, 1=标准 Alpha 混合, 2=加法辉光 Additive 混合）与深度写入。
    public static int SetBlendMode3D(this Canvas c, int blendMode, bool depthWrite) {
        if (c == null) { return 0; }
        return zan_game_set_blend3d(blendMode, depthWrite ? 1 : 0);
    }

    // 控制 3D 硬件面剔除（0=关闭/双面 DoubleSided, 1=剔除背面 Back, 2=剔除正面 Front）。
    public static int SetCull3D(this Canvas c, int cullMode) {
        if (c == null) { return 0; }
        return zan_game_set_cull3d(cullMode);
    }

    // 开启多 Pass 3D 帧：清一次 24-bit 深度缓冲并跨 DrawMesh3DEx / DrawMesh3DSkinned 共享深度。
    public static int BeginFrame3D(this Canvas c) {
        if (c == null) { return 0; }
        return zan_game_begin_frame3d(c.SurfaceId());
    }

    // 结束多 Pass 3D 帧，恢复单次 DrawMesh3D 自动清深度的默认行为。
    public static void EndFrame3D(this Canvas c) {
        if (c == null) { return; }
        zan_game_end_frame3d();
    }

    // 扩展 3D 绘制：显式传 model 矩阵以启用 ShadowMap 3x3 PCF 软阴影接收。
    public static int DrawMesh3DEx(this Canvas c, int mesh, Mat4 mvp, Mat4 model,
    int color, string texture) {
        if (c == null || mvp == null || mvp.m == null || mvp.m.Length < 16) { return 0; }
        EnsureMatBuffers();
        WriteMat4ColumnMajor(cachedMvpPtr, mvp);
        nint modelPtr = 0;
        if (model != null && model.m != null && model.m.Length >= 16) {
            WriteMat4ColumnMajor(cachedModelPtr, model);
            modelPtr = cachedModelPtr;
        }
        string texKey = texture == null ? "" : texture;
        return zan_game_draw3d_ex(c.SurfaceId(), mesh, cachedMvpPtr, modelPtr, color, texKey);
    }

    public static int DrawMesh3DEx(this Canvas c, int mesh, float[] mvpColumnMajor,
    float[] modelColumnMajor, int color, string texture) {
        if (c == null || mvpColumnMajor == null || mvpColumnMajor.Length < 16) { return 0; }
        EnsureMatBuffers();
        Span<float> ms = new Span<float>(cachedMvpPtr, 16);
        for (int i = 0; i < 16; i = i + 1) { ms[i] = mvpColumnMajor[i]; }
        nint modelPtr = 0;
        if (modelColumnMajor != null && modelColumnMajor.Length >= 16) {
            Span<float> md = new Span<float>(cachedModelPtr, 16);
            for (int i = 0; i < 16; i = i + 1) { md[i] = modelColumnMajor[i]; }
            modelPtr = cachedModelPtr;
        }
        string texKey = texture == null ? "" : texture;
        return zan_game_draw3d_ex(c.SurfaceId(), mesh, cachedMvpPtr, modelPtr, color, texKey);
    }

    // 开启单方向光 ShadowMap 深度渲染 Pass（mapSize 256..4096）。
    public static int ShadowBegin(this Canvas c, int mapSize, Mat4 lightVp) {
        if (c == null || lightVp == null || lightVp.m == null || lightVp.m.Length < 16) { return 0; }
        EnsureMatBuffers();
        WriteMat4ColumnMajor(cachedMvpPtr, lightVp);
        return zan_game_shadow_begin(c.SurfaceId(), mapSize, cachedMvpPtr);
    }

    public static int ShadowDraw(this Canvas c, int mesh, Mat4 model) {
        if (c == null || model == null || model.m == null || model.m.Length < 16) { return 0; }
        EnsureMatBuffers();
        WriteMat4ColumnMajor(cachedModelPtr, model);
        return zan_game_shadow_draw(c.SurfaceId(), mesh, cachedModelPtr);
    }

    // 蒙皮网格动态阴影投射：先调用 SetBones3D 上传本帧骨骼矩阵，再在 ShadowBegin..ShadowEnd 间调用。
    public static int ShadowDrawSkinned(this Canvas c, int mesh, Mat4 model) {
        if (c == null || model == null || model.m == null || model.m.Length < 16) { return 0; }
        EnsureMatBuffers();
        WriteMat4ColumnMajor(cachedModelPtr, model);
        return zan_game_shadow_draw_skinned(c.SurfaceId(), mesh, cachedModelPtr);
    }

    public static int ShadowEnd(this Canvas c) {
        if (c == null) { return 0; }
        return zan_game_shadow_end(c.SurfaceId());
    }

    public static void ShadowClear(this Canvas c) {
        if (c == null) { return; }
        zan_game_shadow_clear();
    }

    // 上传当前帧 GPU 骨骼蒙皮矩阵（列主序 float[boneCount * 16]，最多 64 根骨骼）。
    public static int SetBones3D(this Canvas c, float[] columnMajorMatrices16, int boneCount) {
        if (c == null || boneCount < 0 || boneCount > 64) { return 0; }
        if (boneCount == 0) { return zan_game_set_bones3d(0, 0); }
        if (columnMajorMatrices16 == null || columnMajorMatrices16.Length < boneCount * 16) {
            return 0;
        }
        int bytes = boneCount * 16 * 4;
        if (bytes > cachedBonesCap) {
            if (cachedBonesPtr != 0) { NativeMemory.Free(cachedBonesPtr); }
            int newCap = bytes < 4096 ? 4096 : bytes;
            cachedBonesPtr = NativeMemory.Alloc(newCap);
            cachedBonesCap = newCap;
        }
        Span<float> dst = new Span<float>(cachedBonesPtr, boneCount * 16);
        int n = boneCount * 16;
        for (int i = 0; i < n; i = i + 1) { dst[i] = columnMajorMatrices16[i]; }
        return zan_game_set_bones3d(boneCount, cachedBonesPtr);
    }

    // 直接从 Game.Animation.Skeleton 计算蒙皮矩阵并上传至 GPU。
    public static int SetBones3D(this Canvas c, Skeleton skeleton) {
        if (c == null || skeleton == null) { return 0; }
        int count = skeleton.Count();
        if (count > 64) { count = 64; }
        float[] mats = SkinnedMesh3D.BuildBoneMatrices(skeleton);
        return c.SetBones3D(mats, count);
    }

    // 绘制已上传的 GPU 蒙皮网格（MeshUploadSkinned 返回的句柄）。
    public static int DrawMesh3DSkinned(this Canvas c, int mesh, Mat4 mvp, Mat4 model,
    int color, string texture) {
        if (c == null || mvp == null || mvp.m == null || mvp.m.Length < 16) { return 0; }
        EnsureMatBuffers();
        WriteMat4ColumnMajor(cachedMvpPtr, mvp);
        nint modelPtr = 0;
        if (model != null && model.m != null && model.m.Length >= 16) {
            WriteMat4ColumnMajor(cachedModelPtr, model);
            modelPtr = cachedModelPtr;
        }
        string texKey = texture == null ? "" : texture;
        return zan_game_draw3d_skinned(c.SurfaceId(), mesh, cachedMvpPtr, modelPtr, color, texKey);
    }

    // 屏幕空间 GPU 后处理 Pass（Exposure + 13-tap 亮部 Bloom + Reinhard/ACES 色调映射 + Vignette 暗角）。
    // tonemapMode: 0 = None/Clamp, 1 = Reinhard, 2 = ACES Filmic。
    public static int PostProcess3D(this Canvas c, float exposure, int tonemapMode,
    float vignette, float bloomThreshold, float bloomIntensity) {
        if (c == null) { return 0; }
        return zan_game_postprocess3d(c.SurfaceId(), exposure, tonemapMode, vignette,
            bloomThreshold, bloomIntensity);
    }

    public static int PostProcess3D(this Canvas c, PostProcess post) {
        if (c == null || post == null) { return 0; }
        int mode = 0;
        if (post.Tonemap == TonemapKind.Reinhard) { mode = 1; }
        else if (post.Tonemap == TonemapKind.Aces) { mode = 2; }
        zan_game_set_color_grade3d(post.Saturation, post.Contrast,
            post.TintRed, post.TintGreen, post.TintBlue);
        zan_game_set_post_lens3d(post.FxaaStrength, post.ChromaticAberration);
        zan_game_set_post_film3d(post.SharpenStrength, post.FilmGrainStrength, post.FilmGrainSeed);
        zan_game_set_post_cinema3d(post.LetterboxRatio, post.WaveDistortAmplitude,
            post.WaveDistortFrequency, post.WaveDistortPhase);
        zan_game_set_post_radial_blur3d(post.RadialBlurStrength,
            post.RadialBlurCenterX, post.RadialBlurCenterY);
        zan_game_set_post_pixelate3d(post.PixelateSize, post.PosterizeLevels);
        zan_game_set_post_duotone3d(post.DuotoneStrength,
            post.DuotoneDarkRed, post.DuotoneDarkGreen, post.DuotoneDarkBlue,
            post.DuotoneLightRed, post.DuotoneLightGreen, post.DuotoneLightBlue);
        zan_game_set_post_crt_scanline3d(post.CrtScanlineIntensity,
            post.CrtScanlineCount, post.CrtCurvature, post.CrtGlowBoost);
        zan_game_set_post_edge_outline3d(post.OutlineStrength, post.OutlineThreshold,
            post.OutlineRed, post.OutlineGreen, post.OutlineBlue);
        zan_game_set_post_thermal_heat3d(post.ThermalStrength, post.ThermalSensitivity,
            post.ThermalColdShift);
        zan_game_set_post_screen_tint_flash3d(post.ScreenEdgeTintStrength, post.ScreenFlashStrength,
            post.ScreenFlashRed, post.ScreenFlashGreen, post.ScreenFlashBlue);
        zan_game_set_post_night_vision3d(post.NightVisionStrength, post.NightVisionGain,
            post.NightVisionNoise, post.NightVisionSeed);
        zan_game_set_post_halftone_comic3d(post.HalftoneStrength, post.HalftoneDotScale,
            post.HalftoneContrast);
        zan_game_set_post_glitch_rgb3d(post.GlitchIntensity, post.GlitchSliceCount,
            post.GlitchSeed);
        zan_game_set_post_tilt_shift3d(post.TiltShiftStrength, post.TiltShiftFocusY,
            post.TiltShiftFocusBand);
        zan_game_set_post_vignette_frost3d(post.FrostIntensity, post.FrostRadius,
            post.FrostRed, post.FrostGreen, post.FrostBlue);
        zan_game_set_post_sepia_vintage3d(post.SepiaStrength, post.SepiaScratchAmount,
            post.SepiaSeed);
        zan_game_set_post_sun_bloom_streak3d(post.SunStreakStrength, post.SunStreakThreshold,
            post.SunStreakRed, post.SunStreakGreen, post.SunStreakBlue);
        zan_game_set_post_split_tone3d(post.SplitToneStrength, post.SplitToneBalance,
            post.SplitShadowRed, post.SplitShadowGreen, post.SplitShadowBlue,
            post.SplitHighRed, post.SplitHighGreen, post.SplitHighBlue);
        zan_game_set_post_oil_paint3d(post.OilPaintStrength, post.OilPaintRadius);
        zan_game_set_post_scope_edge_blur3d(post.ScopeEdgeBlurStrength, post.ScopeEdgeClearRadius);
        zan_game_set_post_daltonize3d(post.DaltonizeMode, post.DaltonizeStrength);
        zan_game_set_post_lens_distort3d(post.LensDistortK1, post.LensDistortZoom);
        int ok = zan_game_postprocess3d(c.SurfaceId(), post.Exposure, mode,
            post.VignetteStrength, post.BloomThreshold, post.BloomIntensity);
        zan_game_set_color_grade3d(1.0f, 1.0f, 1.0f, 1.0f, 1.0f);
        zan_game_set_post_lens3d(0.0f, 0.0f);
        zan_game_set_post_film3d(0.0f, 0.0f, 0.0f);
        zan_game_set_post_cinema3d(0.0f, 0.0f, 16.0f, 0.0f);
        zan_game_set_post_radial_blur3d(0.0f, 0.5f, 0.5f);
        zan_game_set_post_pixelate3d(0.0f, 0.0f);
        zan_game_set_post_duotone3d(0.0f, 0.0f, 0.05f, 0.0f, 0.2f, 1.0f, 0.35f);
        zan_game_set_post_crt_scanline3d(0.0f, 64.0f, 0.0f, 1.0f);
        zan_game_set_post_edge_outline3d(0.0f, 0.2f, 0.0f, 0.0f, 0.0f);
        zan_game_set_post_thermal_heat3d(0.0f, 1.0f, 0.0f);
        zan_game_set_post_screen_tint_flash3d(0.0f, 0.0f, 1.0f, 0.05f, 0.05f);
        zan_game_set_post_night_vision3d(0.0f, 3.0f, 0.06f, 0.0f);
        zan_game_set_post_halftone_comic3d(0.0f, 6.0f, 1.0f);
        zan_game_set_post_glitch_rgb3d(0.0f, 24.0f, 0.0f);
        zan_game_set_post_tilt_shift3d(0.0f, 0.5f, 0.15f);
        zan_game_set_post_vignette_frost3d(0.0f, 0.45f, 0.55f, 0.88f, 1.0f);
        zan_game_set_post_sepia_vintage3d(0.0f, 0.0f, 0.0f);
        zan_game_set_post_sun_bloom_streak3d(0.0f, 0.75f, 0.25f, 0.78f, 1.0f);
        zan_game_set_post_split_tone3d(0.0f, 0.0f, 0.05f, 0.35f, 0.95f, 1.0f, 0.58f, 0.15f);
        zan_game_set_post_oil_paint3d(0.0f, 2.0f);
        zan_game_set_post_scope_edge_blur3d(0.0f, 0.45f);
        zan_game_set_post_daltonize3d(0.0f, 0.0f);
        zan_game_set_post_lens_distort3d(0.0f, 1.0f);
        return ok;
    }

    private static nint skyboxBuf;

    // 设置切线空间法线贴图（textureKey 为空或 scale <= 0 时关闭，零采样开销）。
    public static void SetNormalMap3D(this Canvas c, string textureKey, float scale) {
        if (c == null) { return; }
        string key = textureKey == null ? "" : textureKey;
        zan_game_set_normal_map3d(key, scale);
    }

    // 绘制 GPU 程序化大气天空盒（关闭深度写入，宜在 3D 场景几何体之前调用）。
    public static int DrawSkybox3D(this Canvas c, Camera3D camera, Skybox3D skybox) {
        if (c == null || camera == null || skybox == null) { return 0; }
        if (skyboxBuf == 0) { skyboxBuf = NativeMemory.Alloc(21 * 4); }
        Vector3 fwd = camera.Forward();
        Vector3 right = camera.Right();
        Vector3 camUp = Vector3.Normalize(Vector3.Cross(right, fwd));
        Span<float> b = new Span<float>(skyboxBuf, 21);
        // [0..8] = camBasis9 (right, up, forward)
        b[0] = right.X; b[1] = right.Y; b[2] = right.Z;
        b[3] = camUp.X; b[4] = camUp.Y; b[5] = camUp.Z;
        b[6] = fwd.X;   b[7] = fwd.Y;   b[8] = fwd.Z;
        // [9..11] = sunDir3
        b[9] = skybox.SunDirection.X; b[10] = skybox.SunDirection.Y; b[11] = skybox.SunDirection.Z;
        // [12..14] = topRgb3
        b[12] = skybox.TopRed; b[13] = skybox.TopGreen; b[14] = skybox.TopBlue;
        // [15..17] = horizonRgb3
        b[15] = skybox.HorizonRed; b[16] = skybox.HorizonGreen; b[17] = skybox.HorizonBlue;
        // [18..20] = groundRgb3
        b[18] = skybox.GroundRed; b[19] = skybox.GroundGreen; b[20] = skybox.GroundBlue;
        float tanHalf = (float)Math.Tan((double)(camera.FieldOfView * 0.5f));
        float asp = camera.AspectRatio > 0.001f ? camera.AspectRatio : 1.0f;
        return zan_game_skybox3d(c.SurfaceId(), skyboxBuf, tanHalf, asp,
            skyboxBuf + 36, skyboxBuf + 48, skyboxBuf + 60, skyboxBuf + 72);
    }

    private static nint spotPosBuf;
    private static nint spotDirBuf;
    private static nint spotColBuf;

    // 设置最多 4 盏 GPU 动态聚光灯：posRange4=[x,y,z,range], dirInner4=[dx,dy,dz,cosInner], colorOuter4=[r,g,b,cosOuter]。
    public static int SetSpotLights3D(this Canvas c, float[] posRange4, float[] dirInner4, float[] colorOuter4) {
        if (c == null) { return 0; }
        if (posRange4 == null || dirInner4 == null || colorOuter4 == null
            || posRange4.Length < 4 || dirInner4.Length < 4 || colorOuter4.Length < 4) {
            return zan_game_set_spot_lights3d(0, 0, 0, 0);
        }
        int count = posRange4.Length / 4;
        int dCount = dirInner4.Length / 4;
        int cCount = colorOuter4.Length / 4;
        if (dCount < count) { count = dCount; }
        if (cCount < count) { count = cCount; }
        if (count > 4) { count = 4; }
        if (spotPosBuf == 0) { spotPosBuf = NativeMemory.Alloc(4 * 4 * 4); }
        if (spotDirBuf == 0) { spotDirBuf = NativeMemory.Alloc(4 * 4 * 4); }
        if (spotColBuf == 0) { spotColBuf = NativeMemory.Alloc(4 * 4 * 4); }
        Span<float> ps = new Span<float>(spotPosBuf, count * 4);
        Span<float> ds = new Span<float>(spotDirBuf, count * 4);
        Span<float> cs = new Span<float>(spotColBuf, count * 4);
        int n = count * 4;
        for (int i = 0; i < n; i = i + 1) {
            ps[i] = posRange4[i];
            ds[i] = dirInner4[i];
            cs[i] = colorOuter4[i];
        }
        return zan_game_set_spot_lights3d(count, spotPosBuf, spotDirBuf, spotColBuf);
    }

    // 启用或关闭 GPU 半球天空/地面环境光 IBL（按世界法线 N.y 混合天空顶色与地面反弹色）。
    public static void SetHemisphereAmbient3D(this Canvas c, bool enabled,
    float skyR, float skyG, float skyB, float groundR, float groundG, float groundB) {
