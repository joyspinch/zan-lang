using System;

namespace Game.Graphics;

// 2.5D / ARPG / RTS 经典 8 方向多状态骨骼级帧动画机。
// 自动衔接待机、行军、挥刀攻击、施法及死亡动画，杜绝手写零碎帧数判定。
public class DirectionalAnimator {
    public SpriteSheet sheet;
    public AnimationState[] states;
    public int stateCount;

    public static int[] s_dir5Row = new int[8] { 2, 1, 0, 1, 2, 3, 4, 3 };
    public static bool[] s_dir5Flip = new bool[8] { false, false, false, true, true, true, false, false };

    public int currentStateIndex;
    public int currentDir8;  // 当前朝向 (0:东, 1:东南, 2:南, 3:西南, 4:西, 5:西北, 6:北, 7:东北)
    public bool is5DirMode;  // 是否启用工业级 5方向镜像模式（省37.5%图具体积与显存）
    public double frameTimer;
    public int currentFrameInDir;
    public bool isFinished;

    public DirectionalAnimator(SpriteSheet sheet, int maxStates) {
        this.sheet = sheet;
        this.states = new AnimationState[maxStates > 0 ? maxStates : 16];
        this.stateCount = 0;

        this.currentStateIndex = -1;
        this.currentDir8 = 2;  // 默认朝南
        this.is5DirMode = false;
        this.frameTimer = 0.0;
        this.currentFrameInDir = 0;
        this.isFinished = false;
    }

    public static DirectionalAnimator Create(SpriteSheet sheet, int maxStates) {
        return new DirectionalAnimator(sheet, maxStates);
    }

    public SpriteSheet Sheet { get { return sheet; } }
    public int Direction { get { return currentDir8; } set { currentDir8 = (value >= 0 && value < 8) ? value : 2; } }
    public bool Is5DirMode { get { return is5DirMode; } set { is5DirMode = value; } }
    public bool IsFinished { get { return isFinished; } }
    public int CurrentFrameInDir { get { return currentFrameInDir; } }
    public string CurrentStateName {
        get {
            if (currentStateIndex >= 0 && currentStateIndex < stateCount && states[currentStateIndex] != null) {
                return states[currentStateIndex].Name;
            }
            return "";
        }
    }

    // 注册一个动作状态配置。
    public void AddState(string name, int startRow, int framesPerDir, double fps, bool loop) {
        if (stateCount < states.Length) {
            states[stateCount] = AnimationState.Create(name, startRow, framesPerDir, fps, loop);
            if (currentStateIndex == -1) {
                currentStateIndex = stateCount;
            }
            stateCount = stateCount + 1;
        }
    }

    // 切换播放状态（例如从 "idle" 切到 "attack"）。
    public void Play(string stateName, int dir8, bool forceRestart) {
        this.currentDir8 = (dir8 >= 0 && dir8 < 8) ? dir8 : currentDir8;

        int foundIdx = -1;
        for (int i = 0; i < stateCount; i = i + 1) {
            if (states[i] != null && states[i].Name == stateName) {
                foundIdx = i;
                break;
            }
        }

        if (foundIdx >= 0) {
            if (foundIdx != currentStateIndex || forceRestart) {
                currentStateIndex = foundIdx;
                currentFrameInDir = 0;
                frameTimer = 0.0;
                isFinished = false;
            }
        }
    }

    // 逐帧推进动画定时器（O(1) 周期折算与未触发立即短路，消除大跨度时间累加循环与卡顿风暴）。
    public void Update(double dt) {
        if (currentStateIndex < 0 || isFinished || dt <= 0.0) { return; }
        AnimationState st = states[currentStateIndex];
        if (st == null) { return; }

        double frameDuration = st.FrameDuration;
        if (frameDuration <= 0.0) { return; }
        frameTimer = frameTimer + dt;
        if (frameTimer < frameDuration) { return; }

        int totalFrames = st.FramesPerDir;
        if (totalFrames <= 0) { return; }

        int framesToAdvance = (int)(frameTimer / frameDuration);
        frameTimer = frameTimer - (double)framesToAdvance * frameDuration;

        int nextFrame = currentFrameInDir + framesToAdvance;
        if (st.Loop) {
            currentFrameInDir = nextFrame % totalFrames;
        } else {
            if (nextFrame >= totalFrames) {
                currentFrameInDir = totalFrames - 1;
                isFinished = true;
                frameTimer = 0.0;
            } else {
                currentFrameInDir = nextFrame;
            }
        }
    }

    // 5 方向对称工业标准映射矩阵。
    // 将 8 方向逻辑朝向解算为 5 行贴图索引与水平翻转标志（FlipX）。
    public static void ResolveDir5(int dir8, out int outRowOffset, out bool outFlipX) {
        int d = (dir8 >= 0 && dir8 < 8) ? dir8 : 2;
        outRowOffset = s_dir5Row[d];
        outFlipX = s_dir5Flip[d];
    }

    // 获取当前帧在 SpriteSheet 中的全局绝对图元帧索引。
    // 8方向模式：(startRow + dir8) * cols + currentFrameInDir
    // 5方向模式：(startRow + dir5) * cols + currentFrameInDir
    public int GetCurrentGlobalFrame() {
        if (currentStateIndex < 0 || sheet == null) { return 0; }
        AnimationState st = states[currentStateIndex];
        if (st == null) { return 0; }

        int rowOffset = currentDir8;
        if (is5DirMode) {
            int d = (currentDir8 >= 0 && currentDir8 < 8) ? currentDir8 : 2;
            rowOffset = s_dir5Row[d];
        }

        int row = st.StartRow + rowOffset;
        return row * sheet.Cols + currentFrameInDir;
    }

    // 获取当前是否处于水平镜像翻转状态（仅在 5 方向模式下生效）。
    public bool IsCurrentFlipped() {
        if (!is5DirMode) { return false; }
        int d = (currentDir8 >= 0 && currentDir8 < 8) ? currentDir8 : 2;
        return s_dir5Flip[d];
    }

    // 直接获取当前帧对应的纹理 UV 矩形。
    // 若启用 5方向镜像模式且当前朝向处于西侧，自动交换 u0 与 u1 实现 GPU 零开销硬件镜像。
    public void GetCurrentUV(out float u0, out float v0, out float u1, out float v1) {
        int gFrame = 0;
        bool flip = false;
        if (currentStateIndex >= 0 && sheet != null) {
            AnimationState st = states[currentStateIndex];
            if (st != null) {
                int rowOffset = currentDir8;
                if (is5DirMode) {
                    int d = (currentDir8 >= 0 && currentDir8 < 8) ? currentDir8 : 2;
                    rowOffset = s_dir5Row[d];
                    flip = s_dir5Flip[d];
                }
                int row = st.StartRow + rowOffset;
                gFrame = row * sheet.Cols + currentFrameInDir;
            }
        }
        sheet.GetFrameUV(gFrame, out u0, out v0, out u1, out v1);
        if (flip) {
            float temp = u0;
            u0 = u1;
            u1 = temp;
        }
    }

    // 根据输入向量（例如摇杆或移动速度）自动解算并更新当前朝向。
    public void SetDirectionFromVector(double vx, double vy) {
        this.currentDir8 = DirectionMapper.FromVector8(vx, vy, this.currentDir8);
    }

    // 获取当前帧在贴图图集上的像素矩形与水平翻转标志。
    public void GetCurrentPixelRect(out int sx, out int sy, out int sw, out int sh, out bool flipX) {
        sx = 0; sy = 0; sw = 0; sh = 0; flipX = false;
        if (sheet == null) { return; }
        int gFrame = GetCurrentGlobalFrame();
        sheet.GetFrameRect(gFrame, out sx, out sy, out sw, out sh);
        flipX = IsCurrentFlipped();
    }
}
