using System;

namespace Game.Graphics;

// 2D 骨骼节点（Bone2D）。
// 维护 2D 骨架中单个骨骼的局部变换（位移、旋转、缩放）与父子层级关系，
// 并高效求解当前骨骼的世界矩阵与骨尖世界坐标。
public class Bone2D {
    public string name;
    public int parentIndex; // -1 表示无父骨骼（根骨骼）
    public double length;   // 骨骼长度（用于骨尖计算与调试绘制）

    // 局部变换
    public double localX;
    public double localY;
    public double localRotation; // 弧度制
    public double localScaleX;
    public double localScaleY;

    // 世界变换（计算求解得出）
    public double worldX;
    public double worldY;
    public double worldRotation;
    public double worldScaleX;
    public double worldScaleY;

    // 挂接部件或贴图标识
    public string attachment;

    public Bone2D(string name, int parentIndex, double length) {
        this.name = name != null ? name : "";
        this.parentIndex = parentIndex;
        this.length = length >= 0.0 ? length : 0.0;

        this.localX = 0.0;
        this.localY = 0.0;
        this.localRotation = 0.0;
        this.localScaleX = 1.0;
        this.localScaleY = 1.0;

        this.worldX = 0.0;
        this.worldY = 0.0;
        this.worldRotation = 0.0;
        this.worldScaleX = 1.0;
        this.worldScaleY = 1.0;
        this.attachment = "";
    }

    public static Bone2D Create(string name, int parentIndex, double length) {
        return new Bone2D(name, parentIndex, length);
    }

    // 设置局部变换
    public void SetLocal(double x, double y, double rotation, double scaleX, double scaleY) {
        this.localX = x;
        this.localY = y;
        this.localRotation = rotation;
        this.localScaleX = scaleX;
        this.localScaleY = scaleY;
    }

    // 依据父骨骼更新当前骨骼的世界变换矩阵
    public void UpdateWorldTransform(Bone2D parent) {
        if (parent == null) {
            // 根骨骼：局部变换即世界变换
            this.worldX = this.localX;
            this.worldY = this.localY;
            this.worldRotation = this.localRotation;
            this.worldScaleX = this.localScaleX;
            this.worldScaleY = this.localScaleY;
        } else {
            // 父子仿射变换复合：
            // 当前世界旋转 = 父世界旋转 + 局部旋转
            this.worldRotation = parent.worldRotation + this.localRotation;
            this.worldScaleX = parent.worldScaleX * this.localScaleX;
            this.worldScaleY = parent.worldScaleY * this.localScaleY;

            // 局部偏移经父旋转与缩放旋转后加到父世界坐标
            double cos = Math.Cos(parent.worldRotation);
            double sin = Math.Sin(parent.worldRotation);
            double scaledX = this.localX * parent.worldScaleX;
            double scaledY = this.localY * parent.worldScaleY;

            this.worldX = parent.worldX + (scaledX * cos - scaledY * sin);
            this.worldY = parent.worldY + (scaledX * sin + scaledY * cos);
        }
    }

    // 获取骨骼端点（骨尖）的世界坐标（沿当前骨骼旋转方向延伸 length 距离）
    public void GetWorldTip(out double tipX, out double tipY) {
        if (this.length <= 0.0) {
            tipX = this.worldX;
            tipY = this.worldY;
            return;
        }
        double cos = Math.Cos(this.worldRotation);
        double sin = Math.Sin(this.worldRotation);
        double effLen = this.length * this.worldScaleX;
        tipX = this.worldX + effLen * cos;
        tipY = this.worldY + effLen * sin;
    }
}
