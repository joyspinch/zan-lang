using System;

namespace Game.Graphics;

// 2D 角色骨骼/精灵挂接点（Socket2D）。
// 用于在角色的特定部位（如右手持枪点、左手持盾点、头顶血条、背部背包、脚底光环）挂接
// 独立单体贴图、粒子发射器或 UI 元素，支持 8 朝向下独立或对称偏移与前后层级（Z-Order）。
public class Socket2D {
    public string name;
    public int[] offsetX;       // 8 个朝向下的 X 偏移（相对于角色基准锚点，例如脚底中心）
    public int[] offsetY;       // 8 个朝向下的 Y 偏移
    public int[] zOrderOffset;  // 8 个朝向下的层深偏置（正数在人物身前，负数在人物背后）

    public Socket2D(string name) {
        this.name = name != null ? name : "";
        this.offsetX = new int[8];
        this.offsetY = new int[8];
        this.zOrderOffset = new int[8];
    }

    public static Socket2D Create(string name) {
        return new Socket2D(name);
    }

    public string Name { get { return name; } }

    // 为指定朝向设置挂点偏移与前后层级。
    public void SetOffset(int dir8, int x, int y, int zOrder) {
        if (dir8 >= 0 && dir8 < 8) {
            offsetX[dir8] = x;
            offsetY[dir8] = y;
            zOrderOffset[dir8] = zOrder;
        }
    }

    public void SetOffset(int dir8, int x, int y) {
        SetOffset(dir8, x, y, 0);
    }

    // 对称设置：基于 5 方向配置（南、东南、东、东北、北），自动镜像生成西侧方向的 X 轴偏移（X 变 -X）
    public void SetSymmetric5(int dir5, int x, int y, int zOrder) {
        // dir5 约定：
        // 0: 南 (South) -> dir8=2
        // 1: 东南 (SouthEast) -> dir8=1 与 dir8=3(西南, -x)
        // 2: 东 (East) -> dir8=0 与 dir8=4(西, -x)
        // 3: 东北 (NorthEast) -> dir8=7 与 dir8=5(西北, -x)
        // 4: 北 (North) -> dir8=6
        if (dir5 == 0) {
            SetOffset(2, x, y, zOrder);
        } else if (dir5 == 1) {
            SetOffset(1, x, y, zOrder);
            SetOffset(3, -x, y, zOrder);
        } else if (dir5 == 2) {
            SetOffset(0, x, y, zOrder);
            SetOffset(4, -x, y, zOrder);
        } else if (dir5 == 3) {
            SetOffset(7, x, y, zOrder);
            SetOffset(5, -x, y, zOrder);
        } else if (dir5 == 4) {
            SetOffset(6, x, y, zOrder);
        }
    }

    public void SetSymmetric5(int dir5, int x, int y) {
        SetSymmetric5(dir5, x, y, 0);
    }

    // 根据角色当前的朝向与世界/屏幕坐标基准点，解算出挂点最终的绝对坐标与层级偏置。
    public void ResolvePosition(int dir8, int rootX, int rootY, out int outX, out int outY, out int outZOrder) {
        int d = (dir8 >= 0 && dir8 < 8) ? dir8 : 2;
        outX = rootX + offsetX[d];
        outY = rootY + offsetY[d];
        outZOrder = zOrderOffset[d];
    }

    public void ResolvePosition(int dir8, int rootX, int rootY, out int outX, out int outY) {
        int unusedZ = 0;
        ResolvePosition(dir8, rootX, rootY, out outX, out outY, out unusedZ);
    }
}
