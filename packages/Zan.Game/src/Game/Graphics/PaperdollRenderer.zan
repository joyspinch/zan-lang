using System;

namespace Game.Graphics;

// 2.5D / ARPG 传奇与暗黑类纸娃娃换装与分层渲染系统。
// 主控单一时间轴，保证各挂件同帧严格对齐；
// 支持 5 方向自动镜像与 8 方向动态层深调序（彻底消除穿模）。
public class PaperdollRenderer {
    public PaperdollLayer[] layers;
    public int layerCount;
    public DirectionalAnimator masterAnimator;  // 主控动作与时间轴

    public int[] sortedLayerIndices;  // 预分配排序索引缓存（零 GC）
    public int[] sortKeys;

    public Socket2D[] sockets;         // 2D 骨骼/精灵挂接点集合
    public int socketCount;

    public PaperdollRenderer(SpriteSheet baseSheet, int maxLayers) {
        int cap = maxLayers > 0 ? maxLayers : 12;
        this.layers = new PaperdollLayer[cap];
        this.layerCount = 0;
        this.sortedLayerIndices = new int[cap];
        this.sortKeys = new int[cap];
        this.sockets = new Socket2D[16];
        this.socketCount = 0;

        // 默认主控动画机
        this.masterAnimator = DirectionalAnimator.Create(baseSheet, 16);
    }

    public static PaperdollRenderer Create(SpriteSheet baseSheet, int maxLayers) {
        return new PaperdollRenderer(baseSheet, maxLayers);
    }

    public DirectionalAnimator MasterAnimator { get { return masterAnimator; } }
    public int LayerCount { get { return layerCount; } }

    // 添加或挂载一个纸娃娃部件层。
    public void AddLayer(string name, SpriteSheet sheet, int baseOrder, int[] orderPerDir, bool is5DirMode) {
        if (layerCount < layers.Length) {
            layers[layerCount] = PaperdollLayer.Create(name, sheet, baseOrder, orderPerDir, is5DirMode);
            sortedLayerIndices[layerCount] = layerCount;
            layerCount = layerCount + 1;
        }
    }

    // 根据名字获取指定部件层。
    public PaperdollLayer GetLayer(string name) {
        for (int i = 0; i < layerCount; i = i + 1) {
            if (layers[i] != null && layers[i].Name == name) {
                return layers[i];
            }
        }
        return null;
    }

    // 设置部件层可见性（例如隐藏头盔或脱下翅膀）。
    public void SetLayerVisible(string name, bool visible) {
        PaperdollLayer l = GetLayer(name);
        if (l != null) {
            l.Visible = visible;
        }
    }

    // 替换指定部位的图集（实现即时换装换武器）。
    public void SwapLayerSheet(string name, SpriteSheet newSheet) {
        PaperdollLayer l = GetLayer(name);
        if (l != null) {
            l.Sheet = newSheet;
        }
    }

    // 播放动作，统一主控动画机。
    public void Play(string stateName, int dir8, bool forceRestart) {
        masterAnimator.Play(stateName, dir8, forceRestart);
    }

    // 时钟步进推进。
    public void Update(double dt) {
        masterAnimator.Update(dt);
    }

    // 根据当前朝向对所有激活的部件层进行 Z-Order 快速排序（升序）。
    // 返回有效部件层数量，排序结果保存在 sortedLayerIndices 中。
    public int SortLayersByDirection() {
        int dir = masterAnimator.Direction;
        int activeCount = 0;

        for (int i = 0; i < layerCount; i = i + 1) {
            PaperdollLayer l = layers[i];
            if (l != null && l.Visible && l.Sheet != null) {
                sortedLayerIndices[activeCount] = i;
                sortKeys[activeCount] = l.GetOrder(dir);
                activeCount = activeCount + 1;
            }
        }

        if (activeCount <= 1) {
            return activeCount;
        }

        // 原位插入排序（部件层数量极少通常在 3~10 之间，插入排序速度极快且零堆分配）
        for (int i = 1; i < activeCount; i = i + 1) {
            int curKey = sortKeys[i];
            int curIdx = sortedLayerIndices[i];
            int j = i - 1;
            while (j >= 0 && sortKeys[j] > curKey) {
                sortKeys[j + 1] = sortKeys[j];
                sortedLayerIndices[j + 1] = sortedLayerIndices[j];
                j = j - 1;
            }
            sortKeys[j + 1] = curKey;
            sortedLayerIndices[j + 1] = curIdx;
        }

        return activeCount;
    }

    // 获取排序后的第 i 个图层索引。
    public int GetSortedLayerIndex(int sortedRank) {
        if (sortedRank >= 0 && sortedRank < layerCount) {
            return sortedLayerIndices[sortedRank];
        }
        return -1;
    }

    // 获取指定部件层在当前主控动画帧下的 UV 矩形与翻转标志。
    public void GetLayerCurrentUV(int layerIndex, out float u0, out float v0, out float u1, out float v1, out bool flipped) {
        u0 = 0.0f; v0 = 0.0f; u1 = 1.0f; v1 = 1.0f;
        flipped = false;

        if (layerIndex < 0 || layerIndex >= layerCount) { return; }
        PaperdollLayer l = layers[layerIndex];
        if (l == null || l.Sheet == null) { return; }

        int dir8 = masterAnimator.Direction;
        int frameInDir = masterAnimator.CurrentFrameInDir;
        int rowOffset = dir8;

        if (l.Is5DirMode) {
            int r5 = 0;
            bool fx = false;
            DirectionalAnimator.ResolveDir5(dir8, out r5, out fx);
            rowOffset = r5;
            flipped = fx;
        }

        int globalFrame = rowOffset * l.Sheet.Cols + frameInDir;
        l.Sheet.GetFrameUV(globalFrame, out u0, out v0, out u1, out v1);

        if (flipped) {
            float temp = u0;
            u0 = u1;
            u1 = temp;
        }
    }

    // 获取指定部件层在当前主控动画帧下的像素矩形与水平翻转标志。
    public void GetLayerCurrentPixelRect(int layerIndex, out int sx, out int sy, out int sw, out int sh, out bool flipped) {
        sx = 0; sy = 0; sw = 0; sh = 0; flipped = false;
        if (layerIndex < 0 || layerIndex >= layerCount) { return; }
        PaperdollLayer l = layers[layerIndex];
        if (l == null || l.Sheet == null) { return; }

        int dir8 = masterAnimator.Direction;
        int frameInDir = masterAnimator.CurrentFrameInDir;
        int rowOffset = dir8;

        if (l.Is5DirMode) {
            int r5 = 0;
            bool fx = false;
            DirectionalAnimator.ResolveDir5(dir8, out r5, out fx);
            rowOffset = r5;
            flipped = fx;
        }

        int globalFrame = rowOffset * l.Sheet.Cols + frameInDir;
        l.Sheet.GetFrameRect(globalFrame, out sx, out sy, out sw, out sh);
    }

    // 注册一个 2D 骨骼挂接点（如手部持枪点、背部背包点、头顶血条）。
    public void AddSocket(Socket2D socket) {
        if (socket == null) { return; }
        if (socketCount < sockets.Length) {
            sockets[socketCount] = socket;
            socketCount = socketCount + 1;
        }
    }

    // 查找指定名称的 2D 挂接点。
    public Socket2D GetSocket(string name) {
        if (name == null) { return null; }
        for (int i = 0; i < socketCount; i = i + 1) {
            if (sockets[i] != null && sockets[i].Name == name) {
                return sockets[i];
            }
        }
        return null;
    }

    // 解算指定挂点在当前朝向下的世界/屏幕绝对位置与前后遮挡偏置。
    public bool ResolveSocket(string name, int rootX, int rootY, out int outX, out int outY, out int outZOrder) {
        outX = rootX;
        outY = rootY;
        outZOrder = 0;
        Socket2D s = GetSocket(name);
        if (s == null) { return false; }
        s.ResolvePosition(masterAnimator.Direction, rootX, rootY, out outX, out outY, out outZOrder);
        return true;
    }
}
