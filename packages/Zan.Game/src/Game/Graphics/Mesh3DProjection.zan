using System;

namespace Game.Graphics;

/// <summary>
/// 3D 骨骼动作切片与权重（用于动作平滑混合 Cross-Fade）。
/// </summary>
class Animation3DTrack {
    string clipName;
    double time;
    double duration;
    double speed;
    double weight;
    bool loop;

    Animation3DTrack() {
        this.clipName = "";
        this.time = 0.0;
        this.duration = 1.0;
        this.speed = 1.0;
        this.weight = 1.0;
        this.loop = true;
    }

    static Animation3DTrack Create(string clipName, double duration, double speed, bool loop) {
        Animation3DTrack t = new Animation3DTrack();
        t.clipName = clipName != null ? clipName : "";
        t.duration = duration > 0.01 ? duration : 1.0;
        t.speed = speed > 0.0 ? speed : 1.0;
        t.loop = loop;
        t.weight = 1.0;
        t.time = 0.0;
        return t;
    }

    string ClipName { get { return clipName; } }
    double Time { get { return time; } set { time = value; } }
    double Duration { get { return duration; } }
    double Weight { get { return weight; } set { weight = (value < 0.0) ? 0.0 : (value > 1.0 ? 1.0 : value); } }
    bool Loop { get { return loop; } }

    void Advance(double dt) {
        time = time + dt * speed;
        if (time >= duration) {
            if (loop) {
                while (time >= duration) {
                    time = time - duration;
                }
            } else {
                time = duration;
            }
        }
    }
}

/// <summary>
/// 3D 骨骼挂点（Bone Socket），用于在角色手部挂载武器、背部挂载翅膀或头顶定位血条。
/// </summary>
class BoneSocket {
    string name;
    double localX;
    double localY;
    double localZ;

    BoneSocket(string name, double lx, double ly, double lz) {
        this.name = name != null ? name : "";
        this.localX = lx;
        this.localY = ly;
        this.localZ = lz;
    }

    static BoneSocket Create(string name, double lx, double ly, double lz) {
        return new BoneSocket(name, lx, ly, lz);
    }

    string Name { get { return name; } }
    double LocalX { get { return localX; } }
    double LocalY { get { return localY; } }
    double LocalZ { get { return localZ; } }

    /// <summary>
    /// 根据角色当前的 Y 轴旋转偏角（弧度），将局部偏置旋转换算为世界 3D 偏移。
    /// </summary>
    void ResolveWorldOffset(double rotYRad, out double outX, out double outY, out double outZ) {
        double cosA = Math.Cos(rotYRad);
        double sinA = Math.Sin(rotYRad);
        // 绕 Y 轴旋转：X' = X * cos + Z * sin, Z' = -X * sin + Z * cos
        outX = localX * cosA + localZ * sinA;
        outY = localY;
        outZ = -localX * sinA + localZ * cosA;
    }
}

/// <summary>
/// 2.5D 瓦片世界与 3D 角色模型表现层的高性能桥接组件。
/// 核心功能：
/// 1. 像素单位与 3D 世界单位严密对齐（PPU 投影转换）；
/// 2. 360 度任意朝向无级丝滑平滑插值（克服传统 8 方向生硬跳跃）；
/// 3. 动作交叉平滑融合（Cross-Fade 避免动作切帧突兀）；
/// 4. 骨骼挂点挂载计算（武器、翅膀贴合跟随）。
/// </summary>
class Mesh3DProjection {
    double pixelsPerUnit;  // 像素转 3D 单位（默认 64.0，即 64 像素 = 1 米）

    // 旋转平滑参数（弧度制）
    double currentYaw;
    double targetYaw;
    double rotationSpeed;  // 角速度（弧度/秒，例如 12.0）

    // 动作交叉融合（CrossFade）
    Animation3DTrack currentTrack;
    Animation3DTrack fadeTrack;
    double crossFadeDuration;
    double crossFadeElapsed;
    bool isFading;

    // 骨骼挂点表
    BoneSocket[] sockets;
    int socketCount;

    Mesh3DProjection(double ppu, int maxSockets) {
        this.pixelsPerUnit = ppu > 1.0 ? ppu : 64.0;
        this.currentYaw = 0.0;
        this.targetYaw = 0.0;
        this.rotationSpeed = 12.5;  // 约每秒旋转 2 圈，手感极为顺滑

        this.currentTrack = null;
        this.fadeTrack = null;
        this.crossFadeDuration = 0.15;
        this.crossFadeElapsed = 0.0;
        this.isFading = false;

        int cap = maxSockets > 0 ? maxSockets : 8;
        this.sockets = new BoneSocket[cap];
        this.socketCount = 0;
    }

    static Mesh3DProjection Create(double ppu, int maxSockets) {
        return new Mesh3DProjection(ppu, maxSockets);
    }

    double PPU { get { return pixelsPerUnit; } }
    double CurrentYaw { get { return currentYaw; } set { currentYaw = value; } }
    double TargetYaw { get { return targetYaw; } set { targetYaw = value; } }
    double RotationSpeed { get { return rotationSpeed; } set { rotationSpeed = value; } }
    Animation3DTrack CurrentTrack { get { return currentTrack; } }
    Animation3DTrack FadeTrack { get { return fadeTrack; } }
    bool IsFading { get { return isFading; } }

    /// <summary>
    /// 将 2D 逻辑世界坐标 (x, y) 转换为 3D 场景坐标 (X3D, Y3D, Z3D)。
    /// </summary>
    void World2Dto3D(double x2d, double y2d, double height2d, out double x3d, out double y3d, out double z3d) {
        x3d = x2d / pixelsPerUnit;
        y3d = height2d / pixelsPerUnit;
        z3d = y2d / pixelsPerUnit;
    }

    /// <summary>
    /// 将 3D 场景坐标正交等轴测投影回屏幕像素相对坐标。
    /// 标准 2:1 菱形视角投影：
    /// screenX = (X - Z) * PPU * 0.5
    /// screenY = (X + Z) * PPU * 0.25 - Y * PPU
    /// </summary>
    void Project3DtoScreen(double x3d, double y3d, double z3d, out double screenX, out double screenY) {
        double px = x3d * pixelsPerUnit;
        double py = y3d * pixelsPerUnit;
        double pz = z3d * pixelsPerUnit;

        screenX = (px - pz) * 0.5;
        screenY = (px + pz) * 0.25 - py;
    }

    /// <summary>
    /// 设置目标朝向（360度任意角度，弧度制）。
    /// </summary>
    void SetLookDirection(double dx, double dy) {
        if (Math.Abs(dx) > 0.001 || Math.Abs(dy) > 0.001) {
            targetYaw = Math.Atan2(dy, dx);
        }
    }

    /// <summary>
    /// 注册骨骼挂点（例如 "hand_r", 0.5, 0.8, 0.2）。
    /// </summary>
    void RegisterSocket(string name, double lx, double ly, double lz) {
        if (socketCount < sockets.Length) {
            sockets[socketCount] = BoneSocket.Create(name, lx, ly, lz);
            socketCount = socketCount + 1;
        }
    }

    /// <summary>
    /// 获取挂点在世界 3D 空间中的坐标（叠加角色自身 3D 位置与当前朝向偏转）。
    /// </summary>
    bool GetSocketWorldPosition(string name, double charX3d, double charY3d, double charZ3d, out double outX, out double outY, out double outZ) {
        outX = charX3d; outY = charY3d; outZ = charZ3d;
        for (int i = 0; i < socketCount; i = i + 1) {
            BoneSocket s = sockets[i];
            if (s != null && s.Name == name) {
                double ox = 0.0; double oy = 0.0; double oz = 0.0;
                s.ResolveWorldOffset(currentYaw, out ox, out oy, out oz);
                outX = charX3d + ox;
                outY = charY3d + oy;
                outZ = charZ3d + oz;
                return true;
            }
        }
        return false;
    }

    /// <summary>
    /// 触发动作切换与平滑融合（Cross-Fade）。
    /// </summary>
    void CrossFade(string newClipName, double duration, double speed, bool loop, double fadeTime) {
        if (currentTrack != null && currentTrack.ClipName == newClipName) {
            return;  // 同一动作，无需打断融合
        }

        Animation3DTrack next = Animation3DTrack.Create(newClipName, duration, speed, loop);
        if (currentTrack == null || fadeTime <= 0.001) {
            currentTrack = next;
            currentTrack.Weight = 1.0;
            fadeTrack = null;
            isFading = false;
        } else {
            fadeTrack = currentTrack;
            currentTrack = next;
            currentTrack.Weight = 0.0;
            crossFadeDuration = fadeTime;
            crossFadeElapsed = 0.0;
            isFading = true;
        }
    }

    /// <summary>
    /// 逐帧推进旋转插值与动作混合时间。
    /// </summary>
    void Update(double dt) {
        // 1. 360 度角度最短路径平滑旋转
        double diff = targetYaw - currentYaw;
        // 归一化角差到 [-PI, PI]
        while (diff > 3.141592653589793) { diff = diff - 6.283185307179586; }
        while (diff < -3.141592653589793) { diff = diff + 6.283185307179586; }

        double maxStep = rotationSpeed * dt;
        if (Math.Abs(diff) <= maxStep) {
            currentYaw = targetYaw;
        } else {
            if (diff > 0.0) {
                currentYaw = currentYaw + maxStep;
            } else {
                currentYaw = currentYaw - maxStep;
            }
        }

        // 2. 推进动作与权重融合
        if (isFading && fadeTrack != null) {
            crossFadeElapsed = crossFadeElapsed + dt;
            double alpha = crossFadeElapsed / crossFadeDuration;
            if (alpha >= 1.0) {
                alpha = 1.0;
                isFading = false;
                fadeTrack = null;
            }
            currentTrack.Weight = alpha;
            if (fadeTrack != null) {
                fadeTrack.Weight = 1.0 - alpha;
                fadeTrack.Advance(dt);
            }
        } else {
            if (currentTrack != null) {
                currentTrack.Weight = 1.0;
            }
        }

        if (currentTrack != null) {
            currentTrack.Advance(dt);
        }
    }
}
