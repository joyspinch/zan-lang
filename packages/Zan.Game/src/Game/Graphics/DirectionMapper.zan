using System;

namespace Game.Graphics;

// 2D / 2.5D 方向解算与方位映射器。
// 提供摇杆输入向量、瞄准夹角与 4/8 方向逻辑索引的无分配相互转换。
//
// 8方向编号约定（与 DirectionalAnimator 完全一致）：
//   0: 东 (East / 右)
//   1: 东南 (SouthEast / 右下)
//   2: 南 (South / 下 / 正对屏幕)
//   3: 西南 (SouthWest / 左下)
//   4: 西 (West / 左)
//   5: 西北 (NorthWest / 左上)
//   6: 北 (North / 上 / 背对屏幕)
//   7: 东北 (NorthEast / 右上)
//
// 4方向编号约定：
//   0: 东 (East / 右)
//   1: 南 (South / 下)
//   2: 西 (West / 左)
//   3: 北 (North / 上)
public class DirectionMapper {
    public const double PI = 3.141592653589793;
    public const double TWO_PI = 6.283185307179586;
    public const double HALF_PI = 1.5707963267948966;
    public const double OCTANT = 0.39269908169872414; // PI / 8.0 (22.5度)

    // 将 2D 向量 (vx, vy) 映射为 8 朝向。若处于死区，保留 fallbackDir。
    public static int FromVector8(double vx, double vy, int fallbackDir) {
        if (vx * vx + vy * vy < 0.0001) {
            return (fallbackDir >= 0 && fallbackDir < 8) ? fallbackDir : 2;
        }
        double rad = Math.Atan2(vy, vx);
        return FromAngle8(rad);
    }

    public static int FromVector8(double vx, double vy) {
        return FromVector8(vx, vy, 2);
    }

    // 将弧度角 rad (-PI 到 PI 或任意范围) 映射到 8 朝向。
    // 0 弧度为正东，顺时针增长（屏幕坐标系：+X 向右, +Y 向下）。
    public static int FromAngle8(double rad) {
        double a = rad % TWO_PI;
        if (a < 0.0) { a = a + TWO_PI; }

        if (a < OCTANT || a >= TWO_PI - OCTANT) { return 0; } // 东
        if (a < 3.0 * OCTANT) { return 1; } // 东南
        if (a < 5.0 * OCTANT) { return 2; } // 南
        if (a < 7.0 * OCTANT) { return 3; } // 西南
        if (a < 9.0 * OCTANT) { return 4; } // 西
        if (a < 11.0 * OCTANT) { return 5; } // 西北
        if (a < 13.0 * OCTANT) { return 6; } // 北
        return 7; // 东北
    }

    // 将 2D 向量映射为 4 朝向。若处于死区，保留 fallbackDir。
    public static int FromVector4(double vx, double vy, int fallbackDir) {
        if (vx * vx + vy * vy < 0.0001) {
            return (fallbackDir >= 0 && fallbackDir < 4) ? fallbackDir : 1;
        }
        double rad = Math.Atan2(vy, vx);
        return FromAngle4(rad);
    }

    public static int FromVector4(double vx, double vy) {
        return FromVector4(vx, vy, 1);
    }

    // 将弧度角映射为 4 朝向 (0:东, 1:南, 2:西, 3:北)
    public static int FromAngle4(double rad) {
        double a = rad % TWO_PI;
        if (a < 0.0) { a = a + TWO_PI; }
        double q = PI / 4.0; // 45 度
        if (a < q || a >= TWO_PI - q) { return 0; } // 东
        if (a < 3.0 * q) { return 1; } // 南
        if (a < 5.0 * q) { return 2; } // 西
        return 3; // 北
    }

    // 获取 8 朝向中心对应的弧度角
    public static double ToAngle8(int dir8) {
        int d = (dir8 >= 0 && dir8 < 8) ? dir8 : 2;
        return (double)d * (PI / 4.0);
    }

    // 获取 4 朝向中心对应的弧度角
    public static double ToAngle4(int dir4) {
        int d = (dir4 >= 0 && dir4 < 4) ? dir4 : 1;
        return (double)d * HALF_PI;
    }

    // 4 朝向转 8 朝向
    public static int Dir4To8(int dir4) {
        if (dir4 == 0) { return 0; }
        if (dir4 == 1) { return 2; }
        if (dir4 == 2) { return 4; }
        if (dir4 == 3) { return 6; }
        return 2;
    }

    // 8 朝向转 4 朝向（就近就直原则）
    public static int Dir8To4(int dir8) {
        if (dir8 == 0 || dir8 == 7) { return 0; }
        if (dir8 == 1 || dir8 == 2) { return 1; }
        if (dir8 == 3 || dir8 == 4) { return 2; }
        return 3; // 5, 6
    }

    // 8 朝向简写名称
    public static string Name8(int dir8) {
        if (dir8 == 0) { return "E"; }
        if (dir8 == 1) { return "SE"; }
        if (dir8 == 2) { return "S"; }
        if (dir8 == 3) { return "SW"; }
        if (dir8 == 4) { return "W"; }
        if (dir8 == 5) { return "NW"; }
        if (dir8 == 6) { return "N"; }
        if (dir8 == 7) { return "NE"; }
        return "Unknown";
    }
}
