using System;

namespace Game.Graphics;

// 2.5D / ARPG / 搜打撤 / 战棋场景通用的 Y-Sort 深度排序缓冲队列。
// 基于零堆分配（Zero-GC）设计，在主循环中快速收集场景实体的渲染层级，
// 按照 (SortY 升序，Tag 偏置) 排序，保证自上而下、从远到近的正确遮挡渲染。
public class YSortQueue {
    public int capacity;
    public int count;

    public int[] entityIds;
    public double[] sortYs;
    public int[] tags;          // 自定义标签或额外 Z-Order 偏置

    // 复用归并排序辅助缓冲（大批量时惰性分配一次，稳态零 GC）
    private int[] scratchIds;
    private double[] scratchYs;
    private int[] scratchTags;

    public YSortQueue(int capacity) {
        int cap = capacity > 0 ? capacity : 256;
        this.capacity = cap;
        this.count = 0;
        this.entityIds = new int[cap];
        this.sortYs = new double[cap];
        this.tags = new int[cap];
        this.scratchIds = null;
        this.scratchYs = null;
        this.scratchTags = null;
    }

    public static YSortQueue Create(int capacity) {
        return new YSortQueue(capacity);
    }

    public int Count { get { return count; } }
    public int Capacity { get { return capacity; } }

    // 开始新一帧，重置计数（不重新分配内存）
    public void Clear() {
        this.count = 0;
    }

    // 压入一个实体进行深度排序
    public bool Push(int entityId, double sortY, int tag) {
        if (count >= capacity) {
            return false;
        }
        entityIds[count] = entityId;
        sortYs[count] = sortY;
        tags[count] = tag;
        count = count + 1;
        return true;
    }

    public bool Push(int entityId, double sortY) {
        return Push(entityId, sortY, 0);
    }

    // 原位稳定排序（升序：sortY 小的排在前面先绘制，底部的排在后面后绘制覆盖上方）。
    // 小段用插入排序，大队列采用自底向上稳定归并排序（最坏 O(N log N)，复用缓冲零稳态 GC）。
    public void Sort() {
        if (count <= 1) { return; }

        if (count <= 32) {
            this.InsertionSortRange(0, count);
            return;
        }

        if (this.scratchIds == null) {
            this.scratchIds = new int[this.capacity];
            this.scratchYs = new double[this.capacity];
            this.scratchTags = new int[this.capacity];
        }

        // 先对每个长度为 32 的段做插入排序
        int run = 32;
        for (int lo = 0; lo < count; lo = lo + run) {
            int hi = lo + run;
            if (hi > count) { hi = count; }
            this.InsertionSortRange(lo, hi);
        }

        // 自底向上稳定归并
        int[] srcIds = this.entityIds;
        double[] srcYs = this.sortYs;
        int[] srcTags = this.tags;
        int[] dstIds = this.scratchIds;
        double[] dstYs = this.scratchYs;
        int[] dstTags = this.scratchTags;

        int width = run;
        while (width < count) {
            for (int lo = 0; lo < count; lo = lo + width * 2) {
                int mid = lo + width;
                if (mid > count) { mid = count; }
                int hi = lo + width * 2;
                if (hi > count) { hi = count; }

                int i = lo;
                int j = mid;
                int k = lo;
                while (i < mid && j < hi) {
                    // 稳定比较：相等时取左段元素
                    if (srcYs[i] < srcYs[j] || (srcYs[i] == srcYs[j] && srcTags[i] <= srcTags[j])) {
                        dstYs[k] = srcYs[i];
                        dstIds[k] = srcIds[i];
                        dstTags[k] = srcTags[i];
                        i = i + 1;
                    } else {
                        dstYs[k] = srcYs[j];
                        dstIds[k] = srcIds[j];
                        dstTags[k] = srcTags[j];
                        j = j + 1;
                    }
                    k = k + 1;
                }
                while (i < mid) {
                    dstYs[k] = srcYs[i];
                    dstIds[k] = srcIds[i];
                    dstTags[k] = srcTags[i];
                    i = i + 1;
                    k = k + 1;
                }
                while (j < hi) {
                    dstYs[k] = srcYs[j];
                    dstIds[k] = srcIds[j];
                    dstTags[k] = srcTags[j];
                    j = j + 1;
                    k = k + 1;
                }
            }
            int[] tmpIds = srcIds; srcIds = dstIds; dstIds = tmpIds;
            double[] tmpYs = srcYs; srcYs = dstYs; dstYs = tmpYs;
            int[] tmpTags = srcTags; srcTags = dstTags; dstTags = tmpTags;
            width = width * 2;
        }

        if (srcIds != this.entityIds) {
            for (int i = 0; i < count; i = i + 1) {
                this.entityIds[i] = srcIds[i];
                this.sortYs[i] = srcYs[i];
                this.tags[i] = srcTags[i];
            }
        }
    }

    private void InsertionSortRange(int lo, int hi) {
        for (int i = lo + 1; i < hi; i = i + 1) {
            double curY = sortYs[i];
            int curId = entityIds[i];
            int curTag = tags[i];

            int j = i - 1;
            while (j >= lo && (sortYs[j] > curY || (sortYs[j] == curY && tags[j] > curTag))) {
                sortYs[j + 1] = sortYs[j];
                entityIds[j + 1] = entityIds[j];
                tags[j + 1] = tags[j];
                j = j - 1;
            }
            sortYs[j + 1] = curY;
            entityIds[j + 1] = curId;
            tags[j + 1] = curTag;
        }
    }

    // 获取排序后的条目
    public void Get(int rank, out int outEntityId, out double outSortY, out int outTag) {
        if (rank >= 0 && rank < count) {
            outEntityId = entityIds[rank];
            outSortY = sortYs[rank];
            outTag = tags[rank];
        } else {
            outEntityId = -1;
            outSortY = 0.0;
            outTag = 0;
        }
    }

    public int GetEntityId(int rank) {
        if (rank >= 0 && rank < count) {
            return entityIds[rank];
        }
        return -1;
    }

    public double GetSortY(int rank) {
        if (rank >= 0 && rank < count) {
            return sortYs[rank];
        }
        return 0.0;
    }
}
