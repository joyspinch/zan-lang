using System;

namespace Game.Graphics;

// 2.5D / ARPG / 搜打撤 / 战棋场景通用的 Y-Sort 深度排序缓冲队列。
// 基于零堆分配（Zero-GC）设计，在主循环中快速收集场景实体的渲染层级，
// 按照 (SortY 升序，Tag 偏置) 排序，保证自上而下、从远到近的正确遮挡渲染。
public class YSortQueue {
    public int capacity;
    public int count;

    public int[] entityIds;
    public double[] sortYs;
    public int[] tags;          // 自定义标签或额外 Z-Order 偏置

    public YSortQueue(int capacity) {
        int cap = capacity > 0 ? capacity : 256;
        this.capacity = cap;
        this.count = 0;
        this.entityIds = new int[cap];
        this.sortYs = new double[cap];
        this.tags = new int[cap];
    }

    public static YSortQueue Create(int capacity) {
        return new YSortQueue(capacity);
    }

    public int Count { get { return count; } }
    public int Capacity { get { return capacity; } }

    // 开始新一帧，重置计数（不重新分配内存）
    public void Clear() {
        this.count = 0;
    }

    // 压入一个实体进行深度排序
    public bool Push(int entityId, double sortY, int tag) {
        if (count >= capacity) {
            return false;
        }
        entityIds[count] = entityId;
        sortYs[count] = sortY;
        tags[count] = tag;
        count = count + 1;
        return true;
    }

    public bool Push(int entityId, double sortY) {
        return Push(entityId, sortY, 0);
    }

    // 原位排序（升序：sortY 小的排在前面先绘制，底部的排在后面后绘制覆盖上方）。
    // 采用针对逐帧高度局部有序队列优化的插入排序，热路径零 GC。
    public void Sort() {
        if (count <= 1) { return; }

        for (int i = 1; i < count; i = i + 1) {
            double curY = sortYs[i];
            int curId = entityIds[i];
            int curTag = tags[i];

            int j = i - 1;
            while (j >= 0 && (sortYs[j] > curY || (sortYs[j] == curY && tags[j] > curTag))) {
                sortYs[j + 1] = sortYs[j];
                entityIds[j + 1] = entityIds[j];
                tags[j + 1] = tags[j];
                j = j - 1;
            }
            sortYs[j + 1] = curY;
            entityIds[j + 1] = curId;
            tags[j + 1] = curTag;
        }
    }

    // 获取排序后的条目
    public void Get(int rank, out int outEntityId, out double outSortY, out int outTag) {
        if (rank >= 0 && rank < count) {
            outEntityId = entityIds[rank];
            outSortY = sortYs[rank];
            outTag = tags[rank];
        } else {
            outEntityId = -1;
            outSortY = 0.0;
            outTag = 0;
        }
    }

    public int GetEntityId(int rank) {
        if (rank >= 0 && rank < count) {
            return entityIds[rank];
        }
        return -1;
    }

    public double GetSortY(int rank) {
        if (rank >= 0 && rank < count) {
            return sortYs[rank];
        }
        return 0.0;
    }
}
