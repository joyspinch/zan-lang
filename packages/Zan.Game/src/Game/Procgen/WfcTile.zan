using System;
using System.Collections.Generic;

namespace Game.Procgen;

// 瓦片集：一组瓦片 + 它们之间的邻接规则。
//
// **规则是"有向"的**：A 的右边可以是 B，但 B 的右边不一定是 A
// （单向箭头、单向门）。所以每条规则写成 (from, to, dir)，
// 方向用 `WfcDir` 枚举表示。
//
// 瓦片本身用**整数**表示（不是字符串）：拼图瓦片集动辄几十上百个，
// 字符串比较在每次邻接检查里都要跑一遍，是纯浪费。名字另存一份
// 只给渲染层用。
public class WfcTile {
    // 瓦片 id（内部用整数）。
    public int id;
    // 瓦片名（渲染层用，可为空）。
    public string name;
    // 该瓦片在四个方向上"允许"与之相邻的瓦片 id 列表。
    // null 表示"不限制"（任何瓦片都能挨着）。
    //
    // **四个独立字段**而不是 `List<int>[]`——Zan 的泛型数组不能
    // 直接构造（`new List<int>[]` 不行），逐方向字段更直白也更快。
    public List<int> allowUp;
    public List<int> allowRight;
    public List<int> allowDown;
    public List<int> allowLeft;

    public WfcTile(int id, string name) {
        this.id = id;
        this.name = name != null ? name : "";
        this.allowUp = null;
        this.allowRight = null;
        this.allowDown = null;
        this.allowLeft = null;
    }

    // 取某方向的允许列表（null = 不限制）。
    public List<int> AllowAt(int dir) {
        if (dir == 0) { return this.allowUp; }
        if (dir == 1) { return this.allowRight; }
        if (dir == 2) { return this.allowDown; }
        return this.allowLeft;
    }

    // 设定某方向的允许列表（null = 不限制）。
    public void SetAllow(int dir, List<int> allow) {
        if (dir == 0) { this.allowUp = allow; }
        else if (dir == 1) { this.allowRight = allow; }
        else if (dir == 2) { this.allowDown = allow; }
        else { this.allowLeft = allow; }
    }

    // 该方向是否允许与 given 相邻。
    //
    // allow 为 null = 不限制；否则查表。
    public bool Allows(int dir, int given) {
        List<int> a = this.AllowAt(dir);
        if (a == null) { return true; }
        return a.Contains(given);
    }
}

// 方向。
public enum WfcDir {
    // 上（北）。
    Up = 0,
    // 右（东）。
    Right = 1,
    // 下（南）。
    Down = 2,
    // 左（西）。
    Left = 3,
}

// 方向工具：取反、偏移。
public class WfcDirs {
    // 相反方向。
    public static int Opposite(int dir) {
        if (dir == 0) { return 2; }
        if (dir == 1) { return 3; }
        if (dir == 2) { return 0; }
        return 1;
    }

    // 水平偏移（Right = +1，Left = -1）。
    public static int Dx(int dir) {
        if (dir == 1) { return 1; }
        if (dir == 3) { return -1; }
        return 0;
    }

    // 垂直偏移（Down = +1，Up = -1）。
    public static int Dy(int dir) {
        if (dir == 2) { return 1; }
        if (dir == 0) { return -1; }
        return 0;
    }
}
