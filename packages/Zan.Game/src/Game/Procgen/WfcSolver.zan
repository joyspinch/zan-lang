using System;
using System.Collections.Generic;
using System.Numerics;

namespace Game.Procgen;

// 波函数坍缩（WFC）求解器。
//
// **算法**：每个格子持有"还可能的瓦片集合"。反复做两件事：
//   1. **坍缩**：挑一个熵最低（候选最少）的格子，把它定死成一个瓦片；
//   2. **传播**：把定死的结果按邻接规则往四周扩散，缩小邻居的候选集。
// 候选集变空 = 矛盾（这个拼图规则无解）。
//
// **域的表示**：多字 64 位位图（`long[]`，每格 `wordCount = (tileCount + 63) / 64` 字），
// 支持任意数量瓦片（无 64 瓦片上限）。传播求交直接用按位 `&` / `|` 与硬件指令
// `BitOperations.PopCount` / `TrailingZeroCount`，热循环零堆分配。
//
// **确定性**：坍缩时用带种子的随机源选瓦片，同 seed + 同规则 → 同一张图
// （可回放）。传播顺序固定（按格子索引），不依赖哈希遍历顺序。
//
// **不变量**：任何时刻，若某格候选集为空，该格与邻居的规则已被违反；
// 求解器在**坍缩前**检查矛盾并返回失败，不产出半成品。
public class WfcSolver {
    // 瓦片集。
    private WfcTileSet tiles;
    // 宽。
    private int width;
    // 高。
    private int height;
    // 瓦片索引映射与预计算邻接位掩码（Solve 时构建）。
    private int tileCount;
    private int wordCount;
    private int[] tileIds;
    private int[] tileWeights;
    private long[] allowMasks;      // [tileIdx * 4 * wordCount + dir * wordCount + w]
    private long[] domainBits;      // [cell * wordCount + w]
    private int[] domainCounts;     // [cell]
    private long[] scratchAllowed;  // [wordCount]
    // 随机源。
    private Rng rng;
    // 已坍缩的格子数。
    private int collapsedCount;
    // 矛盾信息（失败时给出）。
    public string conflict;
    // 失败格子的索引（-1 = 无）。
    public int conflictCell;

    public WfcSolver(WfcTileSet tiles, int width, int height, long seed) {
        this.tiles = tiles;
        this.width = width > 0 ? width : 1;
        this.height = height > 0 ? height : 1;
        this.rng = new Rng(seed);
        this.tileCount = 0;
        this.wordCount = 0;
        this.tileIds = null;
        this.tileWeights = null;
        this.allowMasks = null;
        this.domainBits = null;
        this.domainCounts = null;
        this.scratchAllowed = null;
        this.collapsedCount = 0;
        this.conflict = "";
        this.conflictCell = -1;
    }

    // 宽。
    public int Width() { return this.width; }

    // 高。
    public int Height() { return this.height; }

    // 已坍缩的格子数。
    public int CollapsedCount() { return this.collapsedCount; }

    // 取单候选格子的唯一瓦片索引；非单候选返回 -1。
    private int SingleTileIdx(int cell) {
        if (this.domainCounts == null || this.domainCounts[cell] != 1) { return -1; }
        int baseOff = cell * this.wordCount;
        for (int wi = 0; wi < this.wordCount; wi = wi + 1) {
            long w = this.domainBits[baseOff + wi];
            if (w != 0L) {
                return (wi << 6) + BitOperations.TrailingZeroCount(w);
            }
        }
        return -1;
    }

    // 格子 (x, y) 的最终瓦片 id；未坍缩时返回 -1。
    public int TileAt(int x, int y) {
        if (x < 0 || y < 0 || x >= this.width || y >= this.height) { return -1; }
        int idx = this.SingleTileIdx(y * this.width + x);
        if (idx < 0 || idx >= this.tileCount) { return -1; }
        return this.tileIds[idx];
    }

    // 整张图的瓦片 id（行优先）；未坍缩的格子是 -1。
    public int[] Result() {
        int cellCount = this.width * this.height;
        int[] outArr = new int[cellCount];
        for (int i = 0; i < cellCount; i = i + 1) {
            int idx = this.SingleTileIdx(i);
            outArr[i] = (idx >= 0 && idx < this.tileCount) ? this.tileIds[idx] : -1;
        }
        return outArr;
    }

    // 某格的候选集。
    public List<int> DomainOf(int x, int y) {
        if (x < 0 || y < 0 || x >= this.width || y >= this.height) { return null; }
        if (this.domainBits == null) { return null; }
        int cell = y * this.width + x;
        List<int> list = new List<int>();
        int baseOff = cell * this.wordCount;
        for (int wi = 0; wi < this.wordCount; wi = wi + 1) {
            long w = this.domainBits[baseOff + wi];
            while (w != 0L) {
                int bit = BitOperations.TrailingZeroCount(w);
                list.Add(this.tileIds[(wi << 6) + bit]);
                w = w & (w - 1L);
            }
        }
        return list;
    }

    // 求解。成功返回 true；矛盾返回 false（看 conflict / conflictCell）。
    public bool Solve() {
        this.conflict = "";
        this.conflictCell = -1;
        this.collapsedCount = 0;
        this.InitDomains();

        if (this.tileCount == 0) {
            this.MarkConflict(0);
            return false;
        }

        while (true) {
            // 传播把矛盾带出来就先判失败。
            int cell = this.PickLowestEntropy();
            if (cell < 0) {
                // 没有可坍缩的格子了 = 全部坍缩 = 成功。
                return true;
            }
            int cnt = this.domainCounts[cell];
            // 候选为 0：矛盾。
            if (cnt == 0) {
                this.MarkConflict(cell);
                return false;
            }
            // 候选为 1：已经定死了（传播收缩的结果），不用再掷骰子。
            if (cnt > 1) {
                int chosenIdx = this.PickWeightedIdx(cell);
                int baseOff = cell * this.wordCount;
                for (int wi = 0; wi < this.wordCount; wi = wi + 1) {
                    this.domainBits[baseOff + wi] = 0L;
                }
                this.domainBits[baseOff + (chosenIdx >> 6)] = 1L << (chosenIdx & 63);
                this.domainCounts[cell] = 1;
                this.collapsedCount = this.collapsedCount + 1;
            }
            if (!this.Propagate(cell)) {
                return false;
            }
        }
    }

    // 初始化：构建瓦片索引表与邻接位掩码，每格候选 = 全部瓦片。
    private void InitDomains() {
        int rawCount = this.tiles.Count();
        List<WfcTile> validTiles = new List<WfcTile>();
        Dictionary<int, int> idToIdx = new Dictionary<int, int>();
        for (int t = 0; t < rawCount; t = t + 1) {
            WfcTile tile = this.tiles.Get(t);
            if (tile != null) {
                idToIdx[tile.id] = validTiles.Count;
                validTiles.Add(tile);
            }
        }
        this.tileCount = validTiles.Count;
        this.wordCount = this.tileCount > 0 ? ((this.tileCount + 63) / 64) : 1;
        this.tileIds = new int[this.tileCount];
        this.tileWeights = new int[this.tileCount];
        for (int i = 0; i < this.tileCount; i = i + 1) {
            int tid = validTiles[i].id;
            this.tileIds[i] = tid;
            this.tileWeights[i] = this.tiles.WeightOf(tid);
        }

        // 全集位掩码
        long[] allMask = new long[this.wordCount];
        for (int i = 0; i < this.tileCount; i = i + 1) {
            allMask[i >> 6] = allMask[i >> 6] | (1L << (i & 63));
        }

        // 预计算每个瓦片在 4 个方向上的允许位掩码
        int wc = this.wordCount;
        this.allowMasks = new long[(this.tileCount > 0 ? this.tileCount : 1) * 4 * wc];
        for (int i = 0; i < this.tileCount; i = i + 1) {
            WfcTile tile = validTiles[i];
            for (int dir = 0; dir < 4; dir = dir + 1) {
                int mbase = (i * 4 + dir) * wc;
                List<int> a = tile.AllowAt(dir);
                if (a == null) {
                    for (int k = 0; k < wc; k = k + 1) {
                        this.allowMasks[mbase + k] = allMask[k];
                    }
                } else {
                    for (int j = 0; j < a.Count; j = j + 1) {
                        int targetIdx;
                        if (idToIdx.TryGetValue(a[j], out targetIdx)) {
                            this.allowMasks[mbase + (targetIdx >> 6)] =
                                this.allowMasks[mbase + (targetIdx >> 6)] | (1L << (targetIdx & 63));
                        }
                    }
                }
            }
        }

        int cellCount = this.width * this.height;
        this.domainBits = new long[cellCount * wc];
        this.domainCounts = new int[cellCount];
        this.scratchAllowed = new long[wc];
        for (int c = 0; c < cellCount; c = c + 1) {
            int cbase = c * wc;
            for (int k = 0; k < wc; k = k + 1) {
                this.domainBits[cbase + k] = allMask[k];
            }
            this.domainCounts[c] = this.tileCount;
        }
    }

    // 挑熵最低的格子（候选数最少且 > 1）；没有则返回 -1。
    //
    // 平局时取**索引最小**的——保证确定性（不依赖遍历顺序的偶然性）。
    private int PickLowestEntropy() {
        int best = -1;
        int bestCount = 0;
        int cellCount = this.domainCounts.Length;
        for (int i = 0; i < cellCount; i = i + 1) {
            int c = this.domainCounts[i];
            if (c <= 1) { continue; }
            if (best < 0 || c < bestCount) {
                best = i;
                bestCount = c;
            }
        }
        return best;
    }

    // 按权重挑一个候选瓦片索引（与原候选列表按瓦片加入顺序一致，保证同 seed 完全确定性）。
    //
    // 权重取自瓦片集的权重表（WfcTileSet.WeightOf，默认 1）。全零权重时退化为均匀随机，
    // **不能**因为权重和为 0 而崩或死循环。
    private int PickWeightedIdx(int cell) {
        int wc = this.wordCount;
        int baseOff = cell * wc;
        int total = 0;
        int count = 0;
        int lastIdx = 0;
        for (int wi = 0; wi < wc; wi = wi + 1) {
            long w = this.domainBits[baseOff + wi];
            while (w != 0L) {
                int idx = (wi << 6) + BitOperations.TrailingZeroCount(w);
                total = total + this.tileWeights[idx];
                count = count + 1;
                lastIdx = idx;
                w = w & (w - 1L);
            }
        }
        if (total <= 0) {
            int targetOrd = this.rng.RangeInt(0, count - 1);
            int ord = 0;
            for (int wi = 0; wi < wc; wi = wi + 1) {
                long w = this.domainBits[baseOff + wi];
                while (w != 0L) {
                    int idx = (wi << 6) + BitOperations.TrailingZeroCount(w);
                    if (ord == targetOrd) { return idx; }
                    ord = ord + 1;
                    w = w & (w - 1L);
                }
            }
            return lastIdx;
        }
        int roll = this.rng.RangeInt(1, total);
        int acc = 0;
        for (int wi = 0; wi < wc; wi = wi + 1) {
            long w = this.domainBits[baseOff + wi];
            while (w != 0L) {
                int idx = (wi << 6) + BitOperations.TrailingZeroCount(w);
                acc = acc + this.tileWeights[idx];
                if (roll <= acc) { return idx; }
                w = w & (w - 1L);
            }
        }
        return lastIdx;
    }

    // 从一个已坍缩的格子出发做传播。
    //
    // 队列驱动的约束传播：每确定一格，就把它的四个邻居的候选集
    // 按"我这边的瓦片允许什么"收紧；邻居的候选变了，邻居就成了
    // 新的传播源。全程按位运算 + 硬件 PopCount，零堆分配。
    private bool Propagate(int startCell) {
        int cellCount = this.width * this.height;
        int wc = this.wordCount;
        Queue<int> queue = new Queue<int>();
        bool[] inQueue = new bool[cellCount];
        queue.Enqueue(startCell);
        inQueue[startCell] = true;

        while (queue.Count() > 0) {
            int cell = queue.Dequeue();
            inQueue[cell] = false;
            int cx = cell % this.width;
            int cy = cell / this.width;
            int cbase = cell * wc;

            for (int dir = 0; dir < 4; dir = dir + 1) {
                int nx = cx + WfcDirs.Dx(dir);
                int ny = cy + WfcDirs.Dy(dir);
                if (nx < 0 || ny < 0 || nx >= this.width || ny >= this.height) { continue; }
                int ncell = ny * this.width + nx;
                int nbase = ncell * wc;

                // 计算 cell 当前候选集在 dir 方向上允许的瓦片并集（写入 scratchAllowed）
                for (int k = 0; k < wc; k = k + 1) { this.scratchAllowed[k] = 0L; }
                for (int wi = 0; wi < wc; wi = wi + 1) {
                    long w = this.domainBits[cbase + wi];
                    while (w != 0L) {
                        int ti = (wi << 6) + BitOperations.TrailingZeroCount(w);
                        int mbase = (ti * 4 + dir) * wc;
                        for (int k = 0; k < wc; k = k + 1) {
                            this.scratchAllowed[k] = this.scratchAllowed[k] | this.allowMasks[mbase + k];
                        }
                        w = w & (w - 1L);
                    }
                }

                // 原地求交并统计新候选数（**判据是"交集比当前域小"**，防无限乒乓）
                int newCount = 0;
                for (int k = 0; k < wc; k = k + 1) {
                    long nv = this.domainBits[nbase + k] & this.scratchAllowed[k];
                    this.domainBits[nbase + k] = nv;
                    newCount = newCount + BitOperations.PopCount(nv);
                }
                if (newCount == this.domainCounts[ncell]) {
                    continue;
                }
                this.domainCounts[ncell] = newCount;
                if (newCount == 0) {
                    this.MarkConflict(ncell);
                    return false;
                }
                if (!inQueue[ncell]) {
                    queue.Enqueue(ncell);
                    inQueue[ncell] = true;
                }
            }
        }
        return true;
    }

    // 标记矛盾。
    private void MarkConflict(int cell) {
        this.conflictCell = cell;
        int cx = cell % this.width;
        int cy = cell / this.width;
        this.conflict = "wfc contradiction at (" + cx.ToString() + "," + cy.ToString() + ")";
    }
}
