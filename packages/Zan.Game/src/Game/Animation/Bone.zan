using System;
using System.Numerics;

namespace Game.Animation;

// 骨骼：一节骨骼的层级关系与三套姿势。
//
// **三套姿势各管一段**：
//   - 绑定姿势（BindPose）：模型出厂时的姿势，蒙皮矩阵就是拿它算的；
//   - 局部姿势（LocalPose）：相对父骨骼的位移/旋转/缩放，动作采样写这里；
//   - 世界姿势（WorldPose）：相对模型根的绝对变换，由层级递推得出。
//
// **轴向约定**：骨骼局部 **+Y** 指向骨骼末端（Unity 约定）。两骨 IK 与
// "骨骼长度"的换算都按这个约定走；用别的约定时请在导入模型时把骨骼旋转让
// 对齐，别在运行时改。
public class Bone {
    // 骨骼名（同一骨架内唯一）。
    public string Name;
    // 父骨骼下标（-1 = 根骨骼）。
    public int ParentIndex;
    // 绑定姿势（相对父骨骼）。
    public Transform3D BindPose;
    // 局部姿势（相对父骨骼；动作采样写这里）。
    public Transform3D LocalPose;
    // 世界姿势（相对骨架根；由 `Skeleton.ComputeWorldPoses` 递推）。
    public Transform3D WorldPose;

    public Bone(string name, int parentIndex) {
        this.Name = name != null ? name : "";
        this.ParentIndex = parentIndex;
        this.BindPose = Transform3D.Identity;
        this.LocalPose = Transform3D.Identity;
        this.WorldPose = Transform3D.Identity;
    }

    // 骨骼名。
    public string BoneName { get { return this.Name; } }
    // 父骨骼下标（-1 = 根骨骼）。
    public int Parent { get { return this.ParentIndex; } set { this.ParentIndex = value; } }

    // 设置绑定姿势（链式）。
    public Bone WithBindPose(Transform3D pose) {
        this.BindPose = pose;
        return this;
    }

    // 当前位置（世界姿势的平移分量）。
    public Vector3 Position() { return this.WorldPose.Position; }
}
