using System;
using System.Collections.Generic;
using System.Numerics;

namespace Game.Animation;

// 骨骼权重遮罩：按骨骼下标存放 [0..1] 混合权重，支持按骨骼子树一键设置上下半身分离遮罩。
public class BoneMask {
    private float[] weights;

    public BoneMask(int boneCount, float defaultWeight) {
        int n = boneCount > 0 ? boneCount : 0;
        this.weights = new float[n];
        float w = AnimMath.Clamp01(defaultWeight);
        for (int i = 0; i < n; i = i + 1) {
            this.weights[i] = w;
        }
    }

    public int Count() { return this.weights.Length; }

    public float WeightAt(int boneIndex) {
        if (boneIndex < 0 || boneIndex >= this.weights.Length) { return 0.0f; }
        return this.weights[boneIndex];
    }

    public void SetWeight(int boneIndex, float weight) {
        if (boneIndex < 0 || boneIndex >= this.weights.Length) { return; }
        this.weights[boneIndex] = AnimMath.Clamp01(weight);
    }

    // 递归将 rootBoneIndex 及其全部后代骨骼设置为指定权重（因 Skeleton 保证父在子前，单趟线性扫描即可完成）。
    public void SetSubtreeWeight(Skeleton skeleton, int rootBoneIndex, float weight) {
        if (skeleton == null || rootBoneIndex < 0 || rootBoneIndex >= skeleton.Count()) { return; }
        int count = skeleton.Count();
        if (this.weights.Length < count) {
            float[] grown = new float[count];
            for (int i = 0; i < this.weights.Length; i = i + 1) { grown[i] = this.weights[i]; }
            this.weights = grown;
        }
        bool[] inSubtree = new bool[count];
        inSubtree[rootBoneIndex] = true;
        float w = AnimMath.Clamp01(weight);
        this.weights[rootBoneIndex] = w;
        for (int i = rootBoneIndex + 1; i < count; i = i + 1) {
            Bone b = skeleton.At(i);
            if (b != null && b.ParentIndex >= 0 && inSubtree[b.ParentIndex]) {
                inSubtree[i] = true;
                this.weights[i] = w;
            }
        }
    }

    // 便捷：以某根骨骼名（例如 "spine_01"）为根生成子树遮罩，其余骨骼权重为 0。
    public static BoneMask FromSubtree(Skeleton skeleton, string rootBoneName, float subtreeWeight) {
        if (skeleton == null) { return new BoneMask(0, 0.0f); }
        BoneMask mask = new BoneMask(skeleton.Count(), 0.0f);
        int idx = skeleton.IndexOf(rootBoneName);
        if (idx >= 0) {
            mask.SetSubtreeWeight(skeleton, idx, subtreeWeight);
        }
        return mask;
    }
}

// 3D 枪战/动作角色分层骨骼动画混合器（零每帧堆分配）：
// - Base 层：全身基础运动（如八方向奔跑/蹲走 Pose）
// - Masked Override 层：按 BoneMask 局部覆盖（如上半身持枪瞄准、换弹、投掷手雷）
// - Additive 叠加层：相对于参考帧（Reference Pose）叠加局部增量（如开火后坐力震退、受击抖动、呼吸起伏）
// - Spine AimOffset：将角色瞄准俯仰角（Pitch）与偏航扭腰角（Yaw）按权重均摊到多节脊柱/颈部骨骼
public class LayeredAnimator3D {
    private Skeleton skeleton;
    private PoseBuffer finalPose;
    private PoseBuffer scratchPoseA;
    private PoseBuffer scratchPoseB;

    public LayeredAnimator3D(Skeleton skeleton) {
        if (skeleton == null) {
            throw new AnimationException("skeleton must not be null");
        }
        this.skeleton = skeleton;
        int n = skeleton.Count();
        this.finalPose = new PoseBuffer(n);
        this.scratchPoseA = new PoseBuffer(n);
        this.scratchPoseB = new PoseBuffer(n);
        this.ResetToBindPose();
    }

    public Skeleton TargetSkeleton() { return this.skeleton; }
    public PoseBuffer OutputPose() { return this.finalPose; }

    private void SyncCapacity() {
        int n = this.skeleton.Count();
        this.finalPose.EnsureSize(n);
        this.scratchPoseA.EnsureSize(n);
        this.scratchPoseB.EnsureSize(n);
    }

    // 用绑定姿势初始化当前合成缓冲。
    public void ResetToBindPose() {
        this.SyncCapacity();
        int n = this.skeleton.Count();
        for (int i = 0; i < n; i = i + 1) {
            this.finalPose.Set(i, this.skeleton.BindPose(i));
        }
    }

    // 采样基础全身片段作为底层姿势。
    public void SetBaseClip(AnimationClip clip, float time) {
        this.SyncCapacity();
        if (clip == null) {
            this.ResetToBindPose();
            return;
        }
        clip.SampleTo(this.skeleton, time, this.finalPose);
    }

    // 将双片段线性混合作为底层姿势（例如 Idle <-> Run 速度混合或前后左右移动过渡）。
    public void SetBaseBlend(AnimationClip clipA, float timeA, AnimationClip clipB, float timeB, float blendT) {
        this.SyncCapacity();
        if (clipA == null && clipB == null) {
            this.ResetToBindPose();
            return;
        }
        if (clipA == null) {
            clipB.SampleTo(this.skeleton, timeB, this.finalPose);
            return;
        }
        if (clipB == null) {
            clipA.SampleTo(this.skeleton, timeA, this.finalPose);
            return;
        }
        clipA.SampleTo(this.skeleton, timeA, this.scratchPoseA);
        clipB.SampleTo(this.skeleton, timeB, this.scratchPoseB);
        PoseBuffer.BlendInto(this.finalPose, this.scratchPoseA, this.scratchPoseB, blendT);
    }

    // 按骨骼遮罩叠加 Override 覆盖层（例如上半身换弹/持枪覆盖下半身跑步）：
    // 每根骨骼的实际覆盖比例 = layerWeight * mask.WeightAt(i)。
    public void ApplyOverrideLayer(AnimationClip overrideClip, float time, BoneMask mask, float layerWeight) {
        if (overrideClip == null || layerWeight <= 0.0001f) { return; }
        this.SyncCapacity();
        float globalW = AnimMath.Clamp01(layerWeight);
        overrideClip.SampleTo(this.skeleton, time, this.scratchPoseA);
        int n = this.skeleton.Count();
        for (int i = 0; i < n; i = i + 1) {
            float mw = mask != null ? mask.WeightAt(i) : 1.0f;
            float w = globalW * mw;
            if (w > 0.0001f) {
                Transform3D cur = this.finalPose.At(i);
                Transform3D ovr = this.scratchPoseA.At(i);
                this.finalPose.Set(i, PoseBuffer.Blend(cur, ovr, w));
            }
        }
    }

    // 叠加 Additive 增量动画层（用于枪械后坐力踢动、受击抖动、瞄准呼吸）：
    // 增量定义：deltaPos = add.Pos - ref.Pos，deltaRot = Inverse(ref.Rot) * add.Rot，deltaScale = add.Scale / ref.Scale。
    // refClip 为 null 时以各骨骼 BindPose 作为参考基准帧。
    public void ApplyAdditiveLayer(AnimationClip additiveClip, float time,
                                   AnimationClip refClip, float refTime,
                                   BoneMask mask, float layerWeight) {
        if (additiveClip == null || layerWeight <= 0.0001f) { return; }
        this.SyncCapacity();
        float globalW = AnimMath.Clamp01(layerWeight);
        additiveClip.SampleTo(this.skeleton, time, this.scratchPoseA);
        int n = this.skeleton.Count();
        if (refClip != null) {
            refClip.SampleTo(this.skeleton, refTime, this.scratchPoseB);
        } else {
            for (int i = 0; i < n; i = i + 1) {
                this.scratchPoseB.Set(i, this.skeleton.BindPose(i));
            }
        }

        for (int i = 0; i < n; i = i + 1) {
            float mw = mask != null ? mask.WeightAt(i) : 1.0f;
            float w = globalW * mw;
            if (w <= 0.0001f) { continue; }

            Transform3D basePose = this.finalPose.At(i);
            Transform3D addPose = this.scratchPoseA.At(i);
            Transform3D refPose = this.scratchPoseB.At(i);

            Vector3 dPos = Vector3.Subtract(addPose.Position, refPose.Position);
            Vector3 outPos = new Vector3(
                basePose.Position.X + dPos.X * w,
                basePose.Position.Y + dPos.Y * w,
                basePose.Position.Z + dPos.Z * w);

            Quaternion invRef = Quaternion.Inverse(refPose.Rotation);
            Quaternion deltaRot = Quaternion.Normalize(Quaternion.Multiply(invRef, addPose.Rotation));
            Quaternion weightedDelta = AnimMath.Slerp(Quaternion.Identity, deltaRot, w);
            Quaternion outRot = Quaternion.Normalize(Quaternion.Multiply(basePose.Rotation, weightedDelta));

            float rsx = AnimMath.Abs(refPose.Scale.X) > 0.0001f ? (addPose.Scale.X / refPose.Scale.X) : 1.0f;
            float rsy = AnimMath.Abs(refPose.Scale.Y) > 0.0001f ? (addPose.Scale.Y / refPose.Scale.Y) : 1.0f;
            float rsz = AnimMath.Abs(refPose.Scale.Z) > 0.0001f ? (addPose.Scale.Z / refPose.Scale.Z) : 1.0f;
            Vector3 outScale = new Vector3(
                basePose.Scale.X * (1.0f + (rsx - 1.0f) * w),
                basePose.Scale.Y * (1.0f + (rsy - 1.0f) * w),
                basePose.Scale.Z * (1.0f + (rsz - 1.0f) * w));

            this.finalPose.Set(i, new Transform3D(outPos, outRot, outScale));
        }
    }

    // 程序化脊柱瞄准偏移（Aim Offset）：将俯仰角（绕局部 X 轴）与扭腰偏航角（绕局部 Y 轴）均摊到一组脊柱骨骼上。
    public void ApplySpineAimOffset(int[] spineBoneIndices, float pitchRadians, float yawRadians, float weight) {
        if (spineBoneIndices == null || spineBoneIndices.Length == 0 || weight <= 0.0001f) { return; }
        this.SyncCapacity();
        float w = AnimMath.Clamp01(weight);
        float invCount = w / (float)spineBoneIndices.Length;
        float stepPitch = pitchRadians * invCount;
        float stepYaw = yawRadians * invCount;
        Quaternion qPitch = Quaternion.FromAxisAngle(new Vector3(1.0f, 0.0f, 0.0f), stepPitch);
        Quaternion qYaw = Quaternion.FromAxisAngle(new Vector3(0.0f, 1.0f, 0.0f), stepYaw);
        Quaternion aimStep = Quaternion.Normalize(Quaternion.Multiply(qYaw, qPitch));

        int total = this.skeleton.Count();
        for (int k = 0; k < spineBoneIndices.Length; k = k + 1) {
            int bi = spineBoneIndices[k];
            if (bi < 0 || bi >= total) { continue; }
            Transform3D cur = this.finalPose.At(bi);
            Quaternion nextRot = Quaternion.Normalize(Quaternion.Multiply(cur.Rotation, aimStep));
            this.finalPose.Set(bi, new Transform3D(cur.Position, nextRot, cur.Scale));
        }
    }

    // 将合成后的最终局部姿势一次性写回 Skeleton 并刷新世界姿势，供 IK 二次微调或 GPU 蒙皮矩阵提取。
    public void CommitToSkeleton() {
        int n = this.skeleton.Count();
        if (this.finalPose.Count() < n) { n = this.finalPose.Count(); }
        for (int i = 0; i < n; i = i + 1) {
            this.skeleton.SetLocalPose(i, this.finalPose.At(i));
        }
        this.skeleton.ComputeWorldPoses();
    }
}
