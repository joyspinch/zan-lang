using System;

namespace Game.Animation;

// 状态机的一条转移：从一个状态到另一个状态，带触发条件与淡化时长。
//
// **交叉淡化**：淡化时长 > 0 时，新旧两段动作会按权重混在一起过渡（见
// `AnimationStateMachine.Update`）；时长为 0 就是硬切。
//
// **触发器是一次性的**：`Trigger` 打进来的信号被消费掉就消失；浮点 /
// 布尔参数是持续量，条件一直成立就会一直触发（所以状态离开后要记得把参数
// 复位，否则回到原状态时立刻又转走）。
public class AnimationTransition {
    // 起始状态名。
    public string From;
    // 目标状态名。
    public string To;
    // 触发参数名。
    public string Parameter;
    // 触发方式。
    public AnimationTransitionKind Kind;
    // 浮点参数的触发阈值（`Kind == Float` 时有效）。
    public float Threshold;
    // 交叉淡化时长（秒）；0 表示硬切。
    public float Duration;

    public AnimationTransition(string from, string to, string parameter, AnimationTransitionKind kind) {
        this.From = from != null ? from : "";
        this.To = to != null ? to : "";
        this.Parameter = parameter != null ? parameter : "";
        this.Kind = kind;
        this.Threshold = 0.0f;
        this.Duration = 0.0f;
    }

    // 浮点参数转移（参数 >= 阈值触发）。
    public static AnimationTransition OnFloat(string from, string to, string parameter, float threshold, float duration) {
        AnimationTransition t = new AnimationTransition(from, to, parameter, AnimationTransitionKind.Float);
        t.Threshold = threshold;
        t.Duration = duration;
        return t;
    }

    // 布尔参数转移（参数为 true 触发）。
    public static AnimationTransition OnBool(string from, string to, string parameter, float duration) {
        AnimationTransition t = new AnimationTransition(from, to, parameter, AnimationTransitionKind.Bool);
        t.Duration = duration;
        return t;
    }

    // 触发器转移（一次性）。
    public static AnimationTransition OnTrigger(string from, string to, string parameter, float duration) {
        AnimationTransition t = new AnimationTransition(from, to, parameter, AnimationTransitionKind.Trigger);
        t.Duration = duration;
        return t;
    }
}
