using System;
using System.IO;

namespace Game.Tools;

// 图集切片矩形元数据。
public class FrameRect {
    public int id;
    public int x;
    public int y;
    public int width;
    public int height;
    public float u0;
    public float v0;
    public float u1;
    public float v1;

    public FrameRect(int id, int x, int y, int w, int h, float u0, float v0, float u1, float v1) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.u0 = u0;
        this.v0 = v0;
        this.u1 = u1;
        this.v1 = v1;
    }

    public static FrameRect Create(int id, int x, int y, int w, int h, float u0, float v0, float u1, float v1) {
        return new FrameRect(id, x, y, w, h, u0, v0, u1, v1);
    }

    public int Id { get { return id; } }
    public int X { get { return x; } }
    public int Y { get { return y; } }
    public int Width { get { return width; } }
    public int Height { get { return height; } }
    public float U0 { get { return u0; } }
    public float V0 { get { return v0; } }
    public float U1 { get { return u1; } }
    public float V1 { get { return v1; } }
}
