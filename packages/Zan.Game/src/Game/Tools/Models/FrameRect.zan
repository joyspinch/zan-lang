using System;
using System.IO;

namespace Game.Tools;

// 图集切片矩形元数据。
class FrameRect {
    int id;
    int x;
    int y;
    int width;
    int height;
    float u0;
    float v0;
    float u1;
    float v1;

    FrameRect(int id, int x, int y, int w, int h, float u0, float v0, float u1, float v1) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.u0 = u0;
        this.v0 = v0;
        this.u1 = u1;
        this.v1 = v1;
    }

    static FrameRect Create(int id, int x, int y, int w, int h, float u0, float v0, float u1, float v1) {
        return new FrameRect(id, x, y, w, h, u0, v0, u1, v1);
    }

    int Id { get { return id; } }
    int X { get { return x; } }
    int Y { get { return y; } }
    int Width { get { return width; } }
    int Height { get { return height; } }
    float U0 { get { return u0; } }
    float V0 { get { return v0; } }
    float U1 { get { return u1; } }
    float V1 { get { return v1; } }
}
