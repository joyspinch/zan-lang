using System;
using System.IO;
using System.Text;

namespace Game.Tools;

// 游戏素材自动化处理管线：
// 1. 图集栅格与紧凑布局烘焙计算（AtlasBaker）；
// 2. 5 方向切片映射为 8 方向元数据导出（FiveDirProcessor）；
// 3. 纸娃娃部位层深与挂点配置文件生成（PaperdollConfigGenerator）。
public class AssetPipeline {
    // 计算将 N 个等宽高帧紧凑打包进 Atlas 纹理的规格（自动选取最接近的 2 的幂次方尺寸，如 512, 1024, 2048）。
    public static void CalculateOptimalAtlasSize(int frameWidth, int frameHeight, int totalFrames, out int atlasWidth, out int atlasHeight, out int cols, out int rows) {
        int fw = frameWidth > 0 ? frameWidth : 64;
        int fh = frameHeight > 0 ? frameHeight : 64;
        int count = totalFrames > 0 ? totalFrames : 1;

        // 估算粗略面积
        int totalArea = fw * fh * count;
        int side = 256;
        while ((side * side) < totalArea && side < 4096) {
            side = side * 2;
        }

        cols = side / fw;
        if (cols < 1) { cols = 1; }
        rows = (count + cols - 1) / cols;

        int requiredH = rows * fh;
        int h = 256;
        while (h < requiredH && h < 4096) {
            h = h * 2;
        }

        atlasWidth = side;
        atlasHeight = h;
    }

    // 生成包含每个切片 UV 坐标的标准图集描述元数据 JSON 文本。
    public static string GenerateAtlasManifestJson(string atlasName, int atlasWidth, int atlasHeight, int frameWidth, int frameHeight, int cols, int rows, int totalFrames) {
        StringBuilder json = new StringBuilder();
        json.Append("{\n");
        json.Append("  \"name\": \""); json.Append(atlasName); json.Append("\",\n");
        json.Append("  \"atlasWidth\": "); json.Append(atlasWidth.ToString()); json.Append(",\n");
        json.Append("  \"atlasHeight\": "); json.Append(atlasHeight.ToString()); json.Append(",\n");
        json.Append("  \"frameWidth\": "); json.Append(frameWidth.ToString()); json.Append(",\n");
        json.Append("  \"frameHeight\": "); json.Append(frameHeight.ToString()); json.Append(",\n");
        json.Append("  \"cols\": "); json.Append(cols.ToString()); json.Append(",\n");
        json.Append("  \"rows\": "); json.Append(rows.ToString()); json.Append(",\n");
        json.Append("  \"totalFrames\": "); json.Append(totalFrames.ToString()); json.Append(",\n");
        json.Append("  \"frames\": [\n");

        for (int i = 0; i < totalFrames; i = i + 1) {
            int c = i % cols;
            int r = i / cols;
            int px = c * frameWidth;
            int py = r * frameHeight;
            double u0 = (double)px / (double)atlasWidth;
            double v0 = (double)py / (double)atlasHeight;
            double u1 = (double)(px + frameWidth) / (double)atlasWidth;
            double v1 = (double)(py + frameHeight) / (double)atlasHeight;

            json.Append("    { \"id\": "); json.Append(i.ToString());
            json.Append(", \"x\": "); json.Append(px.ToString());
            json.Append(", \"y\": "); json.Append(py.ToString());
            json.Append(", \"u0\": "); json.Append(u0.ToString());
            json.Append(", \"v0\": "); json.Append(v0.ToString());
            json.Append(", \"u1\": "); json.Append(u1.ToString());
            json.Append(", \"v1\": "); json.Append(v1.ToString());
            json.Append(" }");

            if (i < totalFrames - 1) {
                json.Append(",\n");
            } else {
                json.Append("\n");
            }
        }

        json.Append("  ]\n");
        json.Append("}\n");
        return json.ToString();
    }

    // 生成 5 方向转 8 方向的映射对照元数据 JSON 文本。
    public static string Generate5DirMappingJson(string characterModelName) {
        StringBuilder json = new StringBuilder();
        json.Append("{\n");
        json.Append("  \"model\": \""); json.Append(characterModelName); json.Append("\",\n");
        json.Append("  \"mode\": \"5DirSymmetricMirror\",\n");
        json.Append("  \"directions\": [\n");

        string[] dirNames = new string[8];
        dirNames[0] = "East";
        dirNames[1] = "SouthEast";
        dirNames[2] = "South";
        dirNames[3] = "SouthWest";
        dirNames[4] = "West";
        dirNames[5] = "NorthWest";
        dirNames[6] = "North";
        dirNames[7] = "NorthEast";

        int[] mappedSource = new int[8];
        mappedSource[0] = 2;  // East -> row 2
        mappedSource[1] = 1;  // SouthEast -> row 1
        mappedSource[2] = 0;  // South -> row 0
        mappedSource[3] = 1;  // SouthWest -> row 1 (Mirror)
        mappedSource[4] = 2;  // West -> row 2 (Mirror)
        mappedSource[5] = 3;  // NorthWest -> row 3 (Mirror)
        mappedSource[6] = 4;  // North -> row 4
        mappedSource[7] = 3;  // NorthEast -> row 3

        bool[] flipX = new bool[8];
        flipX[0] = false;
        flipX[1] = false;
        flipX[2] = false;
        flipX[3] = true;
        flipX[4] = true;
        flipX[5] = true;
        flipX[6] = false;
        flipX[7] = false;

        for (int i = 0; i < 8; i = i + 1) {
            json.Append("    { \"dir8\": "); json.Append(i.ToString());
            json.Append(", \"name\": \""); json.Append(dirNames[i]); json.Append("\"");
            json.Append(", \"sourceRow5\": "); json.Append(mappedSource[i].ToString());
            json.Append(", \"flipX\": "); json.Append(flipX[i] ? "true" : "false"); json.Append(" }");

            if (i < 7) {
                json.Append(",\n");
            } else {
                json.Append("\n");
            }
        }

        json.Append("  ]\n");
        json.Append("}\n");
        return json.ToString();
    }

    // 生成纸娃娃装备部件与层深遮挡矩阵配置 JSON 文本。
    public static string GeneratePaperdollManifestJson(string charClass) {
        StringBuilder json = new StringBuilder();
        json.Append("{\n");
        json.Append("  \"class\": \""); json.Append(charClass); json.Append("\",\n");
        json.Append("  \"layers\": [\n");

        // Wing 层
        json.Append("    {\n");
        json.Append("      \"name\": \"wing\",\n");
        json.Append("      \"baseOrder\": 0,\n");
        json.Append("      \"orderPerDir\": [-20, -20, -20, -20, -20, 30, 30, 30]\n");  // 朝北时翅膀遮挡身体正面
        json.Append("    },\n");

        // Body 身体裸模
        json.Append("    {\n");
        json.Append("      \"name\": \"body\",\n");
        json.Append("      \"baseOrder\": 10,\n");
        json.Append("      \"orderPerDir\": [0, 0, 0, 0, 0, 0, 0, 0]\n");
        json.Append("    },\n");

        // Cloth 衣服层
        json.Append("    {\n");
        json.Append("      \"name\": \"cloth\",\n");
        json.Append("      \"baseOrder\": 20,\n");
        json.Append("      \"orderPerDir\": [0, 0, 0, 0, 0, 0, 0, 0]\n");
        json.Append("    },\n");

        // Weapon 武器层
        json.Append("    {\n");
        json.Append("      \"name\": \"weapon\",\n");
        json.Append("      \"baseOrder\": 30,\n");
        json.Append("      \"orderPerDir\": [10, 10, 10, 10, 10, -30, -30, -30]\n");  // 朝北时右手武器收在身后
        json.Append("    }\n");

        json.Append("  ]\n");
        json.Append("}\n");
        return json.ToString();
    }
}
