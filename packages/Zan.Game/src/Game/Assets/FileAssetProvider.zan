using System;
using System.IO;

namespace Game.Assets;

// 文件系统资源来源：清单里的 path 相对 root 解析。
//
// 读失败（文件不存在、不是合法路径）一律返回 false 而不是抛异常：
// 上层要决定"缺资源"是致命错误还是降级，provider 只负责回答
// "能不能拿到字节"。
public class FileAssetProvider : IAssetProvider {
    // 根目录（清单 path 相对它解析）。
    private string root;

    public FileAssetProvider(string root) {
        this.root = root != null ? root : "";
    }

    // 根目录。
    public string Root() {
        return this.root;
    }

    // 拼出实际路径。
    public string Resolve(string path) {
        if (path == null || path == "") { return this.root; }
        if (this.root == "") { return path; }
        if (path.StartsWith("/") || path.StartsWith("\\")) { return path; }
        return this.root + "/" + path;
    }

    public bool Exists(string path) {
        if (path == null || path == "") { return false; }
        return File.Exists(this.Resolve(path));
    }

    public bool TryRead(string path, out byte[] data) {
        data = null;
        if (path == null || path == "") { return false; }
        string full = this.Resolve(path);
        try {
            data = File.ReadAllBytes(full);
            return true;
        } catch (FileNotFoundException) {
            // 缺文件（目录不存在也走这条：ReadAllBytes 统一抛它）。
            return false;
        } catch (IOException) {
            // 其它 IO 故障（占用、权限、坏路径）。
            return false;
        } catch (ArgumentException) {
            // 非法路径（空字节等）。
            return false;
        }
    }
}
