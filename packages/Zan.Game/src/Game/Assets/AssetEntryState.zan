using System;
using System.Collections.Generic;

namespace Game.Assets;

// 已加载资源的运行时条目。
//
// 三种"占用"分开记，缺一不可：
//   - **refCount**：外部持有的引用（每次 Acquire +1，每次 Release -1）。
//   - **depCount**：被几个**已加载**资源依赖着。这是图的属性：
//     依赖者一旦加载就 +1，被回收时 -1，与 acquire 次数无关。
//   - **pinned**：被显式钉住，永不淘汰（关卡常驻资源）。
//
// 合并成一个计数是不够的：依赖计数会随依赖者的加载/回收而回退，
// 外部引用不会。把两者混在一起，要么资源提前被回收
// （外部还在用），要么永远回收不掉（依赖已断但计数没降）。
public class AssetEntryState {
    // 资源 id。
    public string id;
    // 资源种类。
    public AssetKind kind;
    // 清单里的路径。
    public string path;
    // 内容。
    public byte[] data;
    // 字节数。
    public long size;
    // 外部引用计数。
    public int refCount;
    // 依赖计数（被多少个已加载资源依赖）。
    public int depCount;
    // 是否钉住。
    public bool pinned;
    // 最近一次使用的序号（LRU 淘汰用；单调递增，不用墙上时钟——
    // 同一串操作必须得到同一结果，回放 / 锁步需要这个）。
    public long lastUse;
    // 状态建立序号（同 lastUse 时的定序依据）。
    public long seq;
    // 是否已加载。
    public bool loaded;

    public AssetEntryState(string id, AssetKind kind, string path, long seq) {
        this.id = id != null ? id : "";
        this.kind = kind;
        this.path = path != null ? path : "";
        this.data = null;
        this.size = 0L;
        this.refCount = 0;
        this.depCount = 0;
        this.pinned = false;
        this.lastUse = 0L;
        this.seq = seq;
        this.loaded = false;
    }

    // 是否还有人在用（外部引用或被依赖）。
    public bool InUse() {
        return this.refCount > 0 || this.depCount > 0;
    }
}
