namespace Game.Assets;

// 资源种类。清单里用它给资源分类，决定加载后走哪条解码路径。
//
// 刻意用枚举而不是字符串标签：资源类型是编译期已知的有限集合，
// 字符串比较 + 字典查找会让"类型写错"变成运行期的静默错配
// （加载器找不到对应 handler，资源照样进缓存，只是用不对）。
public enum AssetKind {
    // 未分类。清单里没写 kind 时用它。
    Unknown = 0,
    // 纹理（PNG/JPEG/…，字节由解码器解释）。
    Texture = 1,
    // 音频（PCM/WAV/…）。
    Audio = 2,
    // 网格（顶点/索引数据）。
    Mesh = 3,
    // 着色器源码或已编译产物。
    Shader = 4,
    // 字体。
    Font = 5,
    // 纯文本。
    Text = 6,
    // 二进制数据（配置表、关卡数据等）。
    Data = 7,
    // 场景描述。
    Scene = 8,
}

// 种类 ↔ 名称的映射。清单用名称（人可读、可 diff），
// 内部转成枚举（比较快、不会写错）。
public class AssetKinds {
    // 种类 → 名称。
    public static string Name(AssetKind kind) {
        if (kind == AssetKind.Texture) { return "Texture"; }
        if (kind == AssetKind.Audio) { return "Audio"; }
        if (kind == AssetKind.Mesh) { return "Mesh"; }
        if (kind == AssetKind.Shader) { return "Shader"; }
        if (kind == AssetKind.Font) { return "Font"; }
        if (kind == AssetKind.Text) { return "Text"; }
        if (kind == AssetKind.Data) { return "Data"; }
        if (kind == AssetKind.Scene) { return "Scene"; }
        return "Unknown";
    }

    // 名称 → 种类；名字不认识时抛 ArgumentException
    // （清单里写错 kind 要当场失败，不能默默降级成 Unknown
    // ——那会让资源进了缓存却走错解码路径，问题会推迟到很远的地方才炸）。
    public static AssetKind Parse(string name) {
        if (name == null) { return AssetKind.Unknown; }
        if (name == "Texture") { return AssetKind.Texture; }
        if (name == "Audio") { return AssetKind.Audio; }
        if (name == "Mesh") { return AssetKind.Mesh; }
        if (name == "Shader") { return AssetKind.Shader; }
        if (name == "Font") { return AssetKind.Font; }
        if (name == "Text") { return AssetKind.Text; }
        if (name == "Data") { return AssetKind.Data; }
        if (name == "Scene") { return AssetKind.Scene; }
        if (name == "Unknown") { return AssetKind.Unknown; }
        throw new ArgumentException("unknown asset kind: " + name);
    }
}
