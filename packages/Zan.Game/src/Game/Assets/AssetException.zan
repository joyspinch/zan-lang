using System;
using System.Collections.Generic;

namespace Game.Assets;

// 资源读取失败的原因（可区分的错误码）。
public enum AssetError {
    // id 不在清单里。
    NotFound = 0,
    // 依赖的资源读不出来（依赖本身缺文件）。
    DependencyFailed = 1,
    // 资源在清单里，但来源读不出字节。
    ReadFailed = 2,
    // 释放次数多于获取次数。
    Underflow = 3,
}

// 资源错误。带上错误码与资源 id，调用点能区分对待
//（缺资源可以降级，读坏了必须炸）。
public class AssetException : Exception {
    // 错误码。
    public AssetError error;
    // 出问题的资源 id。
    public string assetId;

    public AssetException(AssetError error, string assetId, string message) : base(message) {
        this.error = error;
        this.assetId = assetId != null ? assetId : "";
    }
}
