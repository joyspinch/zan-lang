using System;
using System.Collections.Generic;
using System.Text;

namespace Game.Assets;

// 内存资源来源：内容由调用方注入。
//
// 三种用法：
//   - 测试：构造假内容，测加载/引用计数/淘汰，不碰磁盘；
//   - 内嵌资源：把编译期 --embed 出来的字节塞进来；
//   - 网络注入：远端下发的资源先落在内存里。
public class MemoryAssetProvider : IAssetProvider {
    private Dictionary<string, byte[]> store;

    public MemoryAssetProvider() {
        this.store = new Dictionary<string, byte[]>();
    }

    // 放入（或覆盖）一份内容。
    public MemoryAssetProvider Put(string path, byte[] data) {
        if (path == null || path == "") { return this; }
        this.store[path] = data != null ? data : new byte[0];
        return this;
    }

    // 放入一份字符串内容（UTF-8 字节）。
    public MemoryAssetProvider PutText(string path, string text) {
        if (path == null || path == "") { return this; }
        this.store[path] = Encoding.UTF8.GetBytes(text != null ? text : "");
        return this;
    }

    // 内容条数。
    public int Count() {
        return this.store.Count;
    }

    public bool Exists(string path) {
        return path != null && this.store.ContainsKey(path);
    }

    public bool TryRead(string path, out byte[] data) {
        data = null;
        if (path == null || !this.store.ContainsKey(path)) { return false; }
        data = this.store[path];
        return true;
    }
}
