using System;

namespace Game.Physics3D;

// 轴对齐包围盒（值语义）：宽相粗筛用的最小盒。
//
// 旋转体（盒）的 AABB 随姿态变化，每帧重算——粗筛只是过滤，真正的相交
// 判定由窄相（SAT）负责。
public struct Aabb {
    public double minX;
    public double minY;
    public double minZ;
    public double maxX;
    public double maxY;
    public double maxZ;

    public Aabb(double minX, double minY, double minZ,
                double maxX, double maxY, double maxZ) {
        this.minX = minX;
        this.minY = minY;
        this.minZ = minZ;
        this.maxX = maxX;
        this.maxY = maxY;
        this.maxZ = maxZ;
    }

    // 以 center 为心、radius 为半径的立方包围盒。
    public static Aabb FromCenter(Vec3 center, double radius) {
        return new Aabb(
            center.x - radius, center.y - radius, center.z - radius,
            center.x + radius, center.y + radius, center.z + radius
        );
    }

    // 是否与另一个盒子相交（含边界接触）。
    public bool Overlaps(Aabb other) {
        if (other.minX > this.maxX) { return false; }
        if (other.maxX < this.minX) { return false; }
        if (other.minY > this.maxY) { return false; }
        if (other.maxY < this.minY) { return false; }
        if (other.minZ > this.maxZ) { return false; }
        if (other.maxZ < this.minZ) { return false; }
        return true;
    }

    // 是否包含一点（含边界）。
    public bool Contains(Vec3 point) {
        return point.x >= this.minX && point.x <= this.maxX
            && point.y >= this.minY && point.y <= this.maxY
            && point.z >= this.minZ && point.z <= this.maxZ;
    }

    // 盒子中心。
    public Vec3 Center() {
        return new Vec3(
            (this.minX + this.maxX) * 0.5,
            (this.minY + this.maxY) * 0.5,
            (this.minZ + this.maxZ) * 0.5
        );
    }

    // 就地向外扩张 margin。
    public void Expand(double margin) {
        this.minX = this.minX - margin;
        this.minY = this.minY - margin;
        this.minZ = this.minZ - margin;
        this.maxX = this.maxX + margin;
        this.maxY = this.maxY + margin;
        this.maxZ = this.maxZ + margin;
    }
}
