using System;

namespace Game.Physics3D;

// 三维向量（double 分量，值语义）。
//
// **为什么用 double 而不是 stdlib 的 `System.Numerics.Vector3`**：那个是
// float（渲染用的精度），物理里累加惯量与冲量时 float 的舍入会让"能量守恒"
// 这类断言在边界上飘——同样的两次运行结果不同就谈不上确定性。物理用 double，
// 渲染时再转 float。
//
// 标量只能写在运算符右侧：`v * 2.0` 合法，`2.0 * v` 编译器不支持（标量在左
// 时编译器要反推操作数类型，当前不做这件事）。
public struct Vec3 {
    public double x;
    public double y;
    public double z;

    public Vec3(double x, double y, double z) {
        this.x = x;
        this.y = y;
        this.z = z;
    }

    public static Vec3 Zero { get { return new Vec3(0.0, 0.0, 0.0); } }
    public static Vec3 One { get { return new Vec3(1.0, 1.0, 1.0); } }
    public static Vec3 UnitX { get { return new Vec3(1.0, 0.0, 0.0); } }
    public static Vec3 UnitY { get { return new Vec3(0.0, 1.0, 0.0); } }
    public static Vec3 UnitZ { get { return new Vec3(0.0, 0.0, 1.0); } }

    public static Vec3 operator +(Vec3 a, Vec3 b) {
        return new Vec3(a.x + b.x, a.y + b.y, a.z + b.z);
    }
    public static Vec3 operator -(Vec3 a, Vec3 b) {
        return new Vec3(a.x - b.x, a.y - b.y, a.z - b.z);
    }
    public static Vec3 operator *(Vec3 a, double s) {
        return new Vec3(a.x * s, a.y * s, a.z * s);
    }
    public static Vec3 operator /(Vec3 a, double s) {
        return new Vec3(a.x / s, a.y / s, a.z / s);
    }
    public static bool operator ==(Vec3 a, Vec3 b) {
        return a.x == b.x && a.y == b.y && a.z == b.z;
    }
    public static bool operator !=(Vec3 a, Vec3 b) {
        return !(a.x == b.x && a.y == b.y && a.z == b.z);
    }

    // 向量长度。
    public double Length() {
        return Math.Sqrt(this.x * this.x + this.y * this.y + this.z * this.z);
    }

    // 长度平方（比较远近时免开方）。
    public double LengthSquared() {
        return this.x * this.x + this.y * this.y + this.z * this.z;
    }

    // 单位化；零向量返回零向量（不做除零）。
    public Vec3 Normalized() {
        double len = this.Length();
        if (len > 0.000000000001) {
            return new Vec3(this.x / len, this.y / len, this.z / len);
        }
        return new Vec3(0.0, 0.0, 0.0);
    }

    // 点积。
    public static double Dot(Vec3 a, Vec3 b) {
        return a.x * b.x + a.y * b.y + a.z * b.z;
    }

    // 叉积（右手系）。
    public static Vec3 Cross(Vec3 a, Vec3 b) {
        return new Vec3(
            a.y * b.z - a.z * b.y,
            a.z * b.x - a.x * b.z,
            a.x * b.y - a.y * b.x
        );
    }

    // 各分量取绝对值。
    public Vec3 Abs() {
        double ax = this.x < 0.0 ? -this.x : this.x;
        double ay = this.y < 0.0 ? -this.y : this.y;
        double az = this.z < 0.0 ? -this.z : this.z;
        return new Vec3(ax, ay, az);
    }

    // 点到线段的最近距离（球-盒窄相要用：球心到盒边的最近点）。
    public static double DistancePointSegment(Vec3 p, Vec3 a, Vec3 b) {
        Vec3 ab = b - a;
        double len2 = ab.LengthSquared();
        if (len2 <= 0.000000000001) { return (p - a).Length(); }
        double t = Vec3.Dot(p - a, ab) / len2;
        if (t < 0.0) { t = 0.0; }
        if (t > 1.0) { t = 1.0; }
        return (p - (a + ab * t)).Length();
    }

    // 归一化后的四舍五入友好打印（调试用）。
    public string ToString() {
        return "(" + this.x.ToString() + ", " + this.y.ToString() + ", " + this.z.ToString() + ")";
    }
}
