using System;

namespace Game.Physics3D;

// 球：局部球心在原点。
public class SphereShape : Shape {
    // 半径。
    public double radius;

    public SphereShape(double radius) {
        this.radius = radius;
        this.density = 1.0;
    }

    public override double Volume() {
        return 4.0 / 3.0 * Math.PI * this.radius * this.radius * this.radius;
    }

    public override Vec3 Centroid() {
        return new Vec3(0.0, 0.0, 0.0);
    }

    public override Vec3 InertiaPerMass() {
        // 实心球绕球心：I = 2/5·m·r²，各向同性。
        double v = 0.4 * this.radius * this.radius;
        return new Vec3(v, v, v);
    }

    public override Aabb ComputeAabb(Vec3 center, Quat rot) {
        return Aabb.FromCenter(center, this.radius);
    }

    public override Vec3 Support(Vec3 dir, Vec3 center, Quat rot) {
        return center + dir.Normalized() * this.radius;
    }
}
