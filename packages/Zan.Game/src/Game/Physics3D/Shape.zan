using System;

namespace Game.Physics3D;

// 形状基类：碰撞几何与质量属性的抽象。
//
// 形状是**局部坐标**的——刚体的 position / orientation 决定它在世界里的位置
// 与朝向。球心固定在局部原点；盒的中心也在局部原点，因此刚体的 position
// 永远指向形状质心。
//
// **转动惯量用对角张量表示**：均匀长方体与球的惯量张量在自身主轴系下是
// 对角的（球是各向同性），所以只存三个对角分量（局部系），世界系下按
// R·I·Rᵀ 变换（见 RigidBody.ApplyInvInertia）。
//
// 抽象方法由编译器保证"必须实现"：漏实现的派生类在编译期就被拒。
public abstract class Shape {
    // 体密度（质量 = 密度 × 体积）。刚体的质量与转动惯量由此推出。
    public double density;

    public Shape() {
        this.density = 1.0;
    }

    // 体积。
    public abstract double Volume();

    // 局部质心（相对局部原点）。
    public abstract Vec3 Centroid();

    // 绕质心的转动惯量张量（每单位质量，局部主轴系下的三个对角分量）。
    public abstract Vec3 InertiaPerMass();

    // 世界坐标包围盒（center 是质心世界坐标，rot 是姿态）。
    public abstract Aabb ComputeAabb(Vec3 center, Quat rot);

    // 沿世界方向 dir 的支撑点（SAT 用：取沿该方向最远的点）。
    public abstract Vec3 Support(Vec3 dir, Vec3 center, Quat rot);
}
