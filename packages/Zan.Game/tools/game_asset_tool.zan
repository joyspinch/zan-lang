using System;
using Game.Tools;

/// <summary>
/// 游戏素材与图集自动化 CLI 处理工具。
/// 用法：
/// game_asset_tool atlas <frameW> <frameH> <totalFrames>
/// game_asset_tool mirror5 <modelName>
/// game_asset_tool paperdoll <className>
/// </summary>
class GameAssetToolApp {
    static void Main(string[] args) {
        if (args == null || args.Length == 0) {
            Console.WriteLine("=====================================================");
            Console.WriteLine("  Zan Game Engine - 工业级素材与图集自动化处理工具  ");
            Console.WriteLine("=====================================================");
            Console.WriteLine("指令格式：");
            Console.WriteLine("  1. atlas <frameW> <frameH> <totalFrames>   - 计算并生成紧凑最优图集布局与 UV 坐标清单");
            Console.WriteLine("  2. mirror5 <modelName>                     - 导出 5方向镜像映射至 8方向的对照配置");
            Console.WriteLine("  3. paperdoll <className>                   - 导出纸娃娃身体/服饰/武器/翅膀层深遮挡矩阵配置");
            return;
        }

        string cmd = args[0];
        if (cmd == "atlas") {
            int fw = args.Length > 1 ? int.Parse(args[1]) : 64;
            int fh = args.Length > 2 ? int.Parse(args[2]) : 64;
            int count = args.Length > 3 ? int.Parse(args[3]) : 40;

            int atlasW = 0; int atlasH = 0; int cols = 0; int rows = 0;
            AssetPipeline.CalculateOptimalAtlasSize(fw, fh, count, out atlasW, out atlasH, out cols, out rows);
            Console.WriteLine("[AtlasBaker] 计算完成: Atlas 规格 = " + atlasW.ToString() + "x" + atlasH.ToString()
                + ", 网格 = " + cols.ToString() + "列 x " + rows.ToString() + "行, 总帧数 = " + count.ToString());

            string json = AssetPipeline.GenerateAtlasManifestJson("Atlas_Generated", atlasW, atlasH, fw, fh, cols, rows, count);
            Console.WriteLine(json);
        } else if (cmd == "mirror5") {
            string name = args.Length > 1 ? args[1] : "Warrior_Male";
            string json = AssetPipeline.Generate5DirMappingJson(name);
            Console.WriteLine(json);
        } else if (cmd == "paperdoll") {
            string name = args.Length > 1 ? args[1] : "Warrior";
            string json = AssetPipeline.GeneratePaperdollManifestJson(name);
            Console.WriteLine(json);
        } else {
            Console.WriteLine("未知指令: " + cmd);
        }
    }
}
