using System;

namespace System.Test.Fixtures;

// 假数据生成失败的原因（可区分的错误码）。
public enum FixtureError {
    // 取值时对应的键没有注册过。
    KeyNotRegistered = 0,
    // 生成器产出的值违反了约束（如唯一性重试超限）。
    ConstraintViolated = 1,
    // 参数非法（区间反了、长度为负等）。
    InvalidArgument = 2,
}

// 假数据生成器的错误。
//
// **为什么用异常**：假数据生成器的错误几乎都是**测试代码写错了**（键名打错、
// 区间反了）。当场炸掉并带上键名，比"返回一个看起来合法的假值"好得多——
// 后者会让测试以另一种方式失败，排查成本翻倍。
public class FixtureException : Exception {
    // 错误码。
    public FixtureError error;
    // 出问题的键名（没有则为空串）。
    public string key;

    public FixtureException(FixtureError error, string key, string message) : base(message) {
        this.error = error;
        this.key = key != null ? key : "";
    }
}
