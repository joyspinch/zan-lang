using System;
using System.Collections.Generic;
using System.Web;
using System.Json;
using Zan.Web.Core;
using Zan.Web.Protocol;
using Zan.Web.Modules.Dev;
using Zan.Web.Modules.Dev.Model;
using Zan.Web.Modules.Dev.Dao;

namespace Zan.Web.Modules.Dev.Controller;

/// 表设计器与代码生成控制器（对接 adminUI CurdForm.vue）
class CurdController : WebController {
    private SysCurdDao _curdDao = new SysCurdDao();

    /// GET /dev/curd/config - 获取表的生成配置与 TableConfig
    public async void Config() {
        string table = this.In("table");
        if (table == null || table.Length == 0) {
            this.FailJson(400, "参数 table 不能为空");
            return;
        }

        SysCurd curd = await _curdDao.ByTableName(table);
        if (curd == null) {
            TableConfig defaultConf = new TableConfig();
            TableColumn idCol = new TableColumn();
            idCol.field = "id";
            idCol.headerName = "ID";
            idCol.type = "int";
            defaultConf.columns.Add(idCol);

            this.OkJson(defaultConf.ToJson());
            return;
        }

        if (curd.fieldsJson != null && curd.fieldsJson.Length > 0) {
            this.OkJson(curd.fieldsJson);
        } else {
            this.OkJson("{}");
        }
    }

    /// POST /dev/curd/save - 保存设计器元数据配置
    public async void Save() {
        string table = this.In("table");
        if (table == null || table.Length == 0) {
            this.FailJson(400, "table 不能为空");
            return;
        }

        SysCurd exist = await _curdDao.ByTableName(table);
        bool isNew = exist == null;
        SysCurd c = isNew ? new SysCurd() : exist;

        c.tableName = table;
        c.className = this.In("className");
        c.title = this.In("title");
        c.moduleName = this.In("moduleName");
        c.fieldsJson = this.InRaw("fieldsJson");
        c.filtersJson = this.InRaw("filtersJson");
        c.buttonsJson = this.InRaw("buttonsJson");
        c.tabsJson = this.InRaw("tabsJson");

        if (isNew) {
            c.createdAt = DateTime.Now().ToUnixSeconds();
            c.updatedAt = c.createdAt;
            await _curdDao.Insert(c);
        } else {
            await _curdDao.Update(c);
        }

        this.OkJson("{}");
    }

    /// POST /dev/curd/generate - 执行 1:1:1 代码生成并写入指定目录
    public async void Generate() {
        string table = this.In("table");
        string targetDir = this.In("targetDir");
        if (table == null || table.Length == 0) {
            this.FailJson(400, "table 不能为空");
            return;
        }
        if (targetDir == null || targetDir.Length == 0) {
            targetDir = "src/App";
        }

        SysCurd curd = await _curdDao.ByTableName(table);
        if (curd == null) {
            this.FailJson(404, "表配置未找到");
            return;
        }

        TableConfig conf = new TableConfig();
        CodeGenerator.EmitFiles(targetDir, curd, conf);

        this.OkJson("{\"message\":\"代码已生成到 " + targetDir + "\"}");
    }
}
