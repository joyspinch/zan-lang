using System;
using System.Collections.Generic;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Modules.Dev.Model;

namespace Zan.Web.Modules.Dev.Dao;

/// sys_curd 生成器配置数据网关（全异步原生 ORM）
class SysCurdDao {
    public async SysCurd ByTableName(string tableName) {
        return await Db.Connection().Select<SysCurd>().Where(a => a.tableName == tableName).FirstAsync();
    }

    public async SysCurd ById(int id) {
        return await Db.Connection().Select<SysCurd>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysCurd> All() {
        return await Db.Connection().Select<SysCurd>().OrderByDescending(a => a.id).ToListAsync();
    }

    public async int Insert(SysCurd curd) {
        return await Db.Connection().Insert<SysCurd>(curd).ExecuteIdentityAsync();
    }

    public async int Update(SysCurd curd) {
        return await Db.Connection().Update<SysCurd>()
            .Set(a => a.tableName, curd.tableName)
            .Set(a => a.className, curd.className)
            .Set(a => a.title, curd.title)
            .Set(a => a.moduleName, curd.moduleName)
            .Set(a => a.fieldsJson, curd.fieldsJson)
            .Set(a => a.filtersJson, curd.filtersJson)
            .Set(a => a.buttonsJson, curd.buttonsJson)
            .Set(a => a.tabsJson, curd.tabsJson)
            .Set(a => a.updatedAt, DateTime.Now().ToUnixSeconds())
            .Where(a => a.id == curd.id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        return await Db.Connection().Delete<SysCurd>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
