using System;
using System.Collections.Generic;

namespace Zan.Web.Modules.Monitor;

/// 单条慢请求追踪记录
class SlowRequest {
    public string route = "";
    public string method = "";
    public int elapsedMs = 0;
    public int statusCode = 200;
    public string ip = "";
    public long timestamp = 0;

    public string ToJson() {
        return "{\"route\":\"" + (route != null ? route : "") + "\""
            + ",\"method\":\"" + (method != null ? method : "") + "\""
            + ",\"elapsedMs\":" + elapsedMs.ToString()
            + ",\"statusCode\":" + statusCode.ToString()
            + ",\"ip\":\"" + (ip != null ? ip : "") + "\""
            + ",\"timestamp\":" + timestamp.ToString() + "}";
    }
}

/// 路由级性能与调用量聚合统计项
class RouteStatItem {
    public string route = "";
    public int count = 0;
    public int successCount = 0;
    public int failureCount = 0;
    public long totalMs = 0;
    public int minMs = 0;
    public int maxMs = 0;
    public Dict<int, int> statusCodes = new Dict<int, int>();

    public void Update(int elapsedMs, int statusCode, bool isError) {
        count++;
        if (isError) {
            failureCount++;
        } else {
            successCount++;
        }
        totalMs += elapsedMs;
        if (minMs <= 0 || elapsedMs < minMs) {
            minMs = elapsedMs;
        }
        if (elapsedMs > maxMs) {
            maxMs = elapsedMs;
        }
        if (statusCodes.ContainsKey(statusCode)) {
            int current = statusCodes[statusCode];
            statusCodes[statusCode] = current + 1;
        } else {
            statusCodes[statusCode] = 1;
        }
    }

    public long AvgMs() {
        if (count <= 0) { return 0; }
        return totalMs / count;
    }

    public string ToJson() {
        return "{\"route\":\"" + (route != null ? route : "") + "\""
            + ",\"count\":" + count.ToString()
            + ",\"successCount\":" + successCount.ToString()
            + ",\"failureCount\":" + failureCount.ToString()
            + ",\"totalMs\":" + totalMs.ToString()
            + ",\"minMs\":" + minMs.ToString()
            + ",\"maxMs\":" + maxMs.ToString()
            + ",\"avgMs\":" + AvgMs().ToString() + "}";
    }
}

/// 服务端全局性能监控与实时统计引擎
class ServerStats {
    private static long _startTime = 0;
    private static int _totalRequests = 0;
    private static int _totalSuccess = 0;
    private static int _totalFailure = 0;
    private static long _totalElapsedMs = 0;
    private static Dict<string, RouteStatItem> _routes = new Dict<string, RouteStatItem>();
    private static List<SlowRequest> _slowRequests = new List<SlowRequest>();
    private static int _maxSlowQueue = 100;

    /// 引擎初始化（记录服务启动时间）
    public static void Init() {
        if (_startTime == 0) {
            _startTime = DateTime.Now().ToUnixSeconds();
        }
    }

    /// 记录单次 HTTP 请求执行指标
    public static void Record(string route, string method, int elapsedMs, int statusCode, string ip) {
        Init();
        if (route == null || route.Length == 0) {
            route = "/";
        }

        bool isError = statusCode >= 400;

        _totalRequests++;
        if (isError) {
            _totalFailure++;
        } else {
            _totalSuccess++;
        }
        _totalElapsedMs += elapsedMs;

        // 路由级聚合
        RouteStatItem item;
        if (_routes.ContainsKey(route)) {
            item = _routes[route];
        } else {
            item = new RouteStatItem();
            item.route = route;
            _routes[route] = item;
        }
        item.Update(elapsedMs, statusCode, isError);

        // 慢请求采样追踪（超过 300 毫秒自动采样进滚动队列）
        if (elapsedMs >= 300) {
            SlowRequest slow = new SlowRequest();
            slow.route = route;
            slow.method = method;
            slow.elapsedMs = elapsedMs;
            slow.statusCode = statusCode;
            slow.ip = ip;
            slow.timestamp = DateTime.Now().ToUnixSeconds();

            if (_slowRequests.Count >= _maxSlowQueue) {
                _slowRequests.RemoveAt(0);
            }
            _slowRequests.Add(slow);
        }
    }

    /// 获取服务端实时统计概要 JSON
    public static string GetSummaryJson() {
        Init();
        long now = DateTime.Now().ToUnixSeconds();
        long uptime = now - _startTime;
        if (uptime <= 0) { uptime = 1; }

        long avgMs = _totalRequests > 0 ? (_totalElapsedMs / _totalRequests) : 0;
        long qps = _totalRequests / uptime;

        return "{\"uptime\":" + uptime.ToString()
            + ",\"totalRequests\":" + _totalRequests.ToString()
            + ",\"totalSuccess\":" + _totalSuccess.ToString()
            + ",\"totalFailure\":" + _totalFailure.ToString()
            + ",\"avgMs\":" + avgMs.ToString()
            + ",\"qps\":" + qps.ToString()
            + ",\"routeCount\":" + _routes.Count.ToString()
            + ",\"slowCount\":" + _slowRequests.Count.ToString() + "}";
    }

    /// 获取全部路由的聚合监控 JSON 列表
    public static string GetApisJson() {
        Init();
        string json = "[";
        List<RouteStatItem> items = _routes.Values;
        if (items != null) {
            for (int i = 0; i < items.Count; i++) {
                if (i > 0) { json += ","; }
                json += items[i].ToJson();
            }
        }
        json += "]";
        return json;
    }

    /// 获取最近慢请求采样记录 JSON 列表
    public static string GetSlowRequestsJson() {
        Init();
        string json = "[";
        for (int i = 0; i < _slowRequests.Count; i++) {
            if (i > 0) { json += ","; }
            json += _slowRequests[i].ToJson();
        }
        json += "]";
        return json;
    }
}
