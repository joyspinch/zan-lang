using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Modules.Monitor.Model;

namespace Zan.Web.Modules.Monitor.Dao;

/// API 统计数据访问网关（全异步、强类型原生 ORM）
class SysApiStatDao {
    private IDbConnection _db;

    public SysApiStatDao(IDbConnection db) {
        _db = db;
    }

    public SysApiStatDao() {
        _db = Db.Connection();
    }

    private IDbConnection Conn() {
        return _db != null ? _db : Db.Connection();
    }

    /// 记录单次接口耗时统计（按 路由 + 日期 + 小时 聚合入库）
    public async void RecordStat(string route, int ymd, int hour, int elapsedMs, bool isError) {
        if (route == null || route.Length == 0) {
            return;
        }

        long now = DateTime.Now().ToUnixSeconds();

        // 查找当小时是否已有聚合行
        SysApiStat exist = await this.Conn().Select<SysApiStat>()
            .Where(a => a.route == route && a.ymd == ymd && a.hour == hour)
            .FirstAsync();

        if (exist == null) {
            SysApiStat item = new SysApiStat();
            item.route = route;
            item.ymd = ymd;
            item.hour = hour;
            item.count = 1;
            item.successCount = isError ? 0 : 1;
            item.failureCount = isError ? 1 : 0;
            item.totalMs = elapsedMs;
            item.minMs = elapsedMs;
            item.maxMs = elapsedMs;
            item.updatedAt = now;
            await this.Conn().Insert<SysApiStat>(item).ExecuteAffrowsAsync();
        } else {
            int newSuccess = exist.successCount + (isError ? 0 : 1);
            int newFailure = exist.failureCount + (isError ? 1 : 0);
            int newCount = exist.count + 1;
            long newTotalMs = exist.totalMs + elapsedMs;
            int newMinMs = (exist.minMs <= 0 || elapsedMs < exist.minMs) ? elapsedMs : exist.minMs;
            int newMaxMs = elapsedMs > exist.maxMs ? elapsedMs : exist.maxMs;

            await this.Conn().Update<SysApiStat>()
                .Set(a => a.count, newCount)
                .Set(a => a.successCount, newSuccess)
                .Set(a => a.failureCount, newFailure)
                .Set(a => a.totalMs, newTotalMs)
                .Set(a => a.minMs, newMinMs)
                .Set(a => a.maxMs, newMaxMs)
                .Set(a => a.updatedAt, now)
                .Where(a => a.id == exist.id)
                .ExecuteAffrowsAsync();
        }
    }

    /// 查询指定日期的全量接口统计列表
    public async List<SysApiStat> ByDate(int ymd) {
        return await this.Conn().Select<SysApiStat>()
            .Where(a => a.ymd == ymd)
            .OrderByDescending(a => a.count)
            .ToListAsync();
    }

    /// 查询指定日期的接口耗时 TOP 排行
    public async List<SysApiStat> TopSlowByDate(int ymd, int limit) {
        return await this.Conn().Select<SysApiStat>()
            .Where(a => a.ymd == ymd)
            .OrderByDescending(a => a.totalMs)
            .Take(limit)
            .ToListAsync();
    }
}
