using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Protocol;
using Zan.Web.Modules.Monitor;
using Zan.Web.Modules.Monitor.Dao;
using Zan.Web.Modules.Monitor.Model;

namespace Zan.Web.Modules.Monitor.Controller;

/// 服务端统计监控控制器
[Route("api/monitor/stat/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("服务端监控统计")]
class StatController : WebController {
    private SysApiStatDao ApiStatDao() { return new SysApiStatDao(this.__Conn()); }

    /// PUT or GET /api/monitor/stat/conf - 对接 adminUI ZanTable 表格元数据配置
    [HttpGet]
    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("监控表格配置")]
    public void Conf() {
        TableConfig tc = new TableConfig();
        tc.conf.title = "服务运行指标";
        tc.conf.pageSize = 20;

        tc.columns.Add(new TableColumn("route", "路由接口", 220));
        tc.columns.Add(new TableColumn("method", "方法", 80));
        tc.columns.Add(new TableColumn("calls", "累计调用量", 110));
        tc.columns.Add(new TableColumn("avgLatencyMs", "平均耗时(ms)", 120));
        tc.columns.Add(new TableColumn("maxLatencyMs", "峰值耗时(ms)", 120));
        tc.columns.Add(new TableColumn("errors", "错误次数", 90));

        this.OkJson(tc.ToJson());
    }

    /// POST /api/monitor/stat/list - 对接 adminUI getListAsync 列表查询
    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("列表查询")]
    public void List() {
        this.Apis();
    }

    /// GET /api/monitor/stat/summary - 服务端实时统计概要（运行时长、QPS、请求量、失败数、慢查询等）
    [HttpGet]
    [Custom(IsMenu = true, Perm = PermBit.View)]
    [Description("运行统计概要")]
    public void Summary() {
        this.OkJson(ServerStats.GetSummaryJson());
    }

    /// GET /api/monitor/stat/apis - 实时 API 路由监控与调用指标排行
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("API性能排行")]
    public void Apis() {
        this.OkJson(ServerStats.GetApisJson());
    }

    /// GET /api/monitor/stat/slow - 实时慢请求采样队列（>300ms 链路追踪）
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("慢请求分析")]
    public void Slow() {
        this.OkJson(ServerStats.GetSlowRequestsJson());
    }

    /// GET /api/monitor/stat/slowSql - 实时慢 SQL 采样队列（>200ms 数据库查询诊断）
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("慢SQL分析")]
    public void SlowSql() {
        this.OkJson(ServerStats.GetSlowQueriesJson());
    }

    /// GET /api/monitor/stat/series - 最近时序指标走势（分钟级 QPS 与耗时曲线）
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("时序指标走势")]
    public void Series() {
        this.OkJson(ServerStats.GetSeriesJson());
    }

    /// GET /api/monitor/stat/stream - 监控指标 Server-Sent Events (SSE) 实时推流（用于前端大屏无感实时刷新）
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("监控实时推流")]
    public async void Stream() {
        HttpContext ctx = this.Ctx();
        if (ctx == null) { return; }
        if (!await ctx.SseOpen()) { return; }

        // 推送首帧初始快照
        if (!await ctx.SseSend("metrics", ServerStats.GetSummaryJson())) { return; }

        // 持续推送心跳与指标数据（最长 30 分钟，客户端断开时自动退出）
        for (int i = 0; i < 900; i++) {
            await Task.Delay(2000);
            if (!await ctx.SseSend("metrics", ServerStats.GetSummaryJson())) {
                return;
            }
        }
    }

    /// GET /api/monitor/stat/daily - 查询指定日期的持久化历史统计
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("历史统计报表")]
    public async void Daily() {
        int ymd = this.InInt("date", 0);
        if (ymd <= 0) {
            DateTime now = DateTime.Now();
            ymd = now.Year() * 10000 + now.Month() * 100 + now.Day();
        }

        List<SysApiStat> list = await this.ApiStatDao().ByDate(ymd);
        JsonValue arr = JsonValue.NewArray();
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                SysApiStat item = list[i];
                JsonValue obj = JsonValue.NewObject();
                obj.PutInt("id", item.id);
                obj.PutStr("route", item.route);
                obj.PutInt("ymd", item.ymd);
                obj.PutInt("hour", item.hour);
                obj.PutInt("count", item.count);
                obj.PutInt("successCount", item.successCount);
                obj.PutInt("failureCount", item.failureCount);
                obj.PutInt("totalMs", item.totalMs);
                obj.PutInt("minMs", item.minMs);
                obj.PutInt("maxMs", item.maxMs);
                obj.PutInt("updatedAt", item.updatedAt);
                arr.Append(obj);
            }
        }
        this.OkJson(arr.ToJson());
    }
}
