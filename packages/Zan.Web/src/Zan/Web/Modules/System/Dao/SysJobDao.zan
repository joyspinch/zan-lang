using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Modules.System.Model;

namespace Zan.Web.Modules.System.Dao;

/// 定时任务数据访问层
class SysJobDao {
    private IDbConnection _db;

    public SysJobDao(IDbConnection db) {
        this._db = db;
    }

    public async List<SysJob> All() {
        if (_db == null) { return new List<SysJob>(); }
        return await _db.Select<SysJob>().OrderBy(j => j.id).ToListAsync();
    }

    public async SysJob FindById(int id) {
        if (_db == null) { return null; }
        return await _db.Select<SysJob>().Where(j => j.id == id).FirstAsync();
    }

    public async int Insert(SysJob job) {
        if (_db == null || job == null) { return 0; }
        return await _db.Insert<SysJob>(job).ExecuteIdentityAsync();
    }

    public async int Update(SysJob job) {
        if (_db == null || job == null) { return 0; }
        return await _db.Update<SysJob>()
            .Set(j => j.name, job.name)
            .Set(j => j.kind, job.kind)
            .Set(j => j.intervalSec, job.intervalSec)
            .Set(j => j.paramJson, job.paramJson)
            .Set(j => j.runCount, job.runCount)
            .Set(j => j.enabled, job.enabled)
            .Set(j => j.lastRunAt, job.lastRunAt)
            .Set(j => j.lastMs, job.lastMs)
            .Set(j => j.lastOk, job.lastOk)
            .Set(j => j.lastMessage, job.lastMessage)
            .Where(j => j.id == job.id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        if (_db == null) { return 0; }
        return await _db.Delete<SysJob>().Where(j => j.id == id).ExecuteAffrowsAsync();
    }
}
