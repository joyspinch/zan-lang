using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;

namespace Zan.Web.Modules.System.Dao;

/// 角色与菜单权限关联数据访问网关（全异步、强类型原生 ORM）
class SysRoleMenuDao {
    private IDbConnection _db;

    public SysRoleMenuDao(IDbConnection db) {
        _db = db;
    }

    public SysRoleMenuDao() {
        _db = Db.Connection();
    }

    private IDbConnection Conn() {
        return _db != null ? _db : Db.Connection();
    }

    public async List<int> GetMenuIdsByRoleId(int roleId) {
        List<SysRoleMenu> list = await this.Conn().Select<SysRoleMenu>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
        List<int> result = new List<int>();
        for (int i = 0; i < list.Count; i++) {
            result.Add(list[i].menuId);
        }
        return result;
    }

    public async int SetRoleMenus(int roleId, List<int> menuIds) {
        await this.Conn().Delete<SysRoleMenu>()
            .Where(a => a.roleId == roleId)
            .ExecuteAffrowsAsync();

        if (menuIds == null || menuIds.Count == 0) {
            return 0;
        }

        int count = 0;
        for (int i = 0; i < menuIds.Count; i++) {
            SysRoleMenu item = new SysRoleMenu();
            item.roleId = roleId;
            item.menuId = menuIds[i];
            await this.Conn().Insert<SysRoleMenu>(item).ExecuteAffrowsAsync();
            count++;
        }
        return count;
    }
}
