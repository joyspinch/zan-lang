using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;

namespace Zan.Web.Modules.System.Dao;

/// 系统部门组织架构数据访问对象
class SysDepartmentDao {
    private IDbConnection _db;

    public SysDepartmentDao(IDbConnection db) {
        _db = db;
    }

    public SysDepartmentDao() {
        _db = Db.Connection();
    }

    private IDbConnection Conn() {
        return _db != null ? _db : Db.Connection();
    }

    /// 查询全部部门列表（按排序权重升序排列）
    public async List<SysDepartment> All() {
        return await this.Conn().Select<SysDepartment>()
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    /// 根据部门 ID 查询
    public async SysDepartment ById(int id) {
        return await this.Conn().Select<SysDepartment>()
            .Where(a => a.id == id)
            .FirstAsync();
    }

    /// 根据上级部门 ID 查询直属子部门
    public async List<SysDepartment> ByParentId(int parentId) {
        return await this.Conn().Select<SysDepartment>()
            .Where(a => a.parentId == parentId)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    /// 新增部门
    public async int Insert(SysDepartment dept) {
        if (dept == null) { return 0; }
        long now = DateTime.Now().ToUnixSeconds();
        if (dept.createdAt == 0) { dept.createdAt = now; }
        dept.updatedAt = now;
        return await this.Conn().Insert<SysDepartment>(dept).ExecuteIdentityAsync();
    }

    /// 更新部门
    public async int Update(SysDepartment dept) {
        if (dept == null) { return 0; }
        return await this.Conn().Update<SysDepartment>()
            .Set(a => a.parentId, dept.parentId)
            .Set(a => a.name, dept.name)
            .Set(a => a.code, dept.code)
            .Set(a => a.leaderUserId, dept.leaderUserId)
            .Set(a => a.sortOrder, dept.sortOrder)
            .Set(a => a.status, dept.status)
            .Set(a => a.updatedAt, DateTime.Now().ToUnixSeconds())
            .Where(a => a.id == dept.id)
            .ExecuteAffrowsAsync();
    }

    /// 删除部门
    public async int Delete(int id) {
        return await this.Conn().Delete<SysDepartment>()
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /// 获取指定部门及其所有下级子孙部门的 ID 列表（供数据权限范围计算）
    public async List<int> GetSubDeptIds(int deptId) {
        List<int> result = new List<int>();
        result.Add(deptId);

        List<SysDepartment> all = await this.All();
        if (all == null || all.Count == 0) {
            return result;
        }

        // 广度遍历收集下级
        List<int> queue = new List<int>();
        queue.Add(deptId);
        int head = 0;
        while (head < queue.Count) {
            int currentParent = queue[head];
            head++;
            for (int i = 0; i < all.Count; i++) {
                SysDepartment d = all[i];
                if (d.parentId == currentParent && !result.Contains(d.id)) {
                    result.Add(d.id);
                    queue.Add(d.id);
                }
            }
        }
        return result;
    }
}
