using System;
using System.Collections.Generic;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;

namespace Zan.Web.Modules.System.Dao;

/// 数据字典类型数据访问对象
class SysDictTypeDao {
    public async List<SysDictType> All() {
        return await Db.Connection().Select<SysDictType>()
            .OrderBy(a => a.id)
            .ToListAsync();
    }

    public async SysDictType ById(int id) {
        return await Db.Connection().Select<SysDictType>()
            .Where(a => a.id == id)
            .FirstAsync();
    }

    public async SysDictType ByCode(string code) {
        return await Db.Connection().Select<SysDictType>()
            .Where(a => a.code == code)
            .FirstAsync();
    }

    public async int Insert(SysDictType entity) {
        if (entity == null) { return 0; }
        long now = DateTime.Now().ToUnixSeconds();
        if (entity.createdAt == 0) { entity.createdAt = now; }
        entity.updatedAt = now;
        return await Db.Connection().Insert<SysDictType>(entity).ExecuteIdentityAsync();
    }

    public async int Update(SysDictType entity) {
        if (entity == null) { return 0; }
        return await Db.Connection().Update<SysDictType>()
            .Set(a => a.code, entity.code)
            .Set(a => a.name, entity.name)
            .Set(a => a.description, entity.description)
            .Set(a => a.status, entity.status)
            .Set(a => a.updatedAt, DateTime.Now().ToUnixSeconds())
            .Where(a => a.id == entity.id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        return await Db.Connection().Delete<SysDictType>()
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }
}
