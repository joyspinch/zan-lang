using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Security.Cryptography;
using System.Text;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;

namespace Zan.Web.Modules.System.Dao;

/// 用户数据访问网关（全异步、强类型原生 ORM）
class SysUserDao {
    private IDbConnection _db;

    public SysUserDao(IDbConnection db) {
        _db = db;
    }

    public SysUserDao() {
        _db = Db.Connection();
    }

    private IDbConnection Conn() {
        return _db != null ? _db : Db.Connection();
    }

    /// 计算用户密码加盐哈希（MD5(password:salt)）
    public static string HashPassword(string password, string salt) {
        if (password == null) { password = ""; }
        if (salt == null) { salt = ""; }
        string raw = password + ":" + salt;
        byte[] hash = Md5.Hash(raw, raw.Length);
        return Hex.Encode(hash);
    }

    /// 校验输入密码与数据库哈希是否匹配
    public static bool VerifyPassword(string inputPwd, string salt, string expectedHash) {
        if (inputPwd == null || salt == null || expectedHash == null) {
            return false;
        }
        string computed = HashPassword(inputPwd, salt);
        return computed.ToLower() == expectedHash.ToLower();
    }

    /// 根据用户名精确查询单个用户
    public async SysUser ByUsername(string username) {
        if (username == null || username.Length == 0) {
            return null;
        }
        return await this.Conn().Select<SysUser>()
            .Where(a => a.username == username)
            .FirstAsync();
    }

    /// 根据用户 ID 查询单个用户
    public async SysUser ById(int id) {
        return await this.Conn().Select<SysUser>()
            .Where(a => a.id == id)
            .FirstAsync();
    }

    /// 分页查询用户列表
    public async List<SysUser> Page(int page, int pageSize) {
        if (page < 1) { page = 1; }
        if (pageSize < 1) { pageSize = 20; }
        int skip = (page - 1) * pageSize;
        return await this.Conn().Select<SysUser>()
            .OrderByDescending(a => a.id)
            .Skip(skip)
            .Take(pageSize)
            .ToListAsync();
    }

    /// 获取用户总数
    public async long TotalCount() {
        return await this.Conn().Select<SysUser>().CountAsync();
    }

    /// 新增用户并返回自增主键
    public async int Insert(SysUser user) {
        return await this.Conn().Insert<SysUser>(user).ExecuteIdentityAsync();
    }

    /// 更新用户基本信息
    public async int Update(SysUser user) {
        return await this.Conn().Update<SysUser>()
            .Set(a => a.nickname, user.nickname)
            .Set(a => a.email, user.email)
            .Set(a => a.mobile, user.mobile)
            .Set(a => a.avatar, user.avatar)
            .Set(a => a.status, user.status)
            .Set(a => a.updatedAt, DateTime.Now().ToUnixSeconds())
            .Where(a => a.id == user.id)
            .ExecuteAffrowsAsync();
    }

    /// 修改用户密码与盐
    public async int UpdatePassword(int id, string newPassword, string newSalt) {
        string hash = HashPassword(newPassword, newSalt);
        return await this.Conn().Update<SysUser>()
            .Set(a => a.password, hash)
            .Set(a => a.salt, newSalt)
            .Set(a => a.updatedAt, DateTime.Now().ToUnixSeconds())
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /// 更新用户启停状态
    public async int UpdateStatus(int id, int status) {
        return await this.Conn().Update<SysUser>()
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, DateTime.Now().ToUnixSeconds())
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /// 删除指定用户
    public async int Delete(int id) {
        return await this.Conn().Delete<SysUser>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
