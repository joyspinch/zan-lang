using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;

namespace Zan.Web.Modules.System.Dao;

/// 角色数据访问网关（全异步、强类型原生 ORM）
class SysRoleDao {
    private IDbConnection _db;

    public SysRoleDao(IDbConnection db) {
        _db = db;
    }

    public SysRoleDao() {
        _db = Db.Connection();
    }

    private IDbConnection Conn() {
        return _db != null ? _db : Db.Connection();
    }

    public async SysRole ById(int id) {
        return await this.Conn().Select<SysRole>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysRole> All() {
        return await this.Conn().Select<SysRole>().Where(a => a.status == 1).ToListAsync();
    }

    public async List<SysRole> Page(int page, int pageSize) {
        if (page < 1) { page = 1; }
        if (pageSize < 1) { pageSize = 20; }
        int skip = (page - 1) * pageSize;
        return await this.Conn().Select<SysRole>()
            .OrderByDescending(a => a.id)
            .Skip(skip)
            .Take(pageSize)
            .ToListAsync();
    }

    public async long TotalCount() {
        return await this.Conn().Select<SysRole>().CountAsync();
    }

    public async int Insert(SysRole role) {
        return await this.Conn().Insert<SysRole>(role).ExecuteIdentityAsync();
    }

    public async int Update(SysRole role) {
        return await this.Conn().Update<SysRole>()
            .Set(a => a.name, role.name)
            .Set(a => a.intro, role.intro)
            .Set(a => a.status, role.status)
            .Set(a => a.updatedAt, DateTime.Now().ToUnixSeconds())
            .Where(a => a.id == role.id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        return await this.Conn().Delete<SysRole>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
