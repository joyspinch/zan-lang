using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;

namespace Zan.Web.Modules.System.Dao;

/// 用户角色关联数据访问网关（全异步、强类型原生 ORM）
class SysUserRoleDao {
    private IDbConnection _db;

    public SysUserRoleDao(IDbConnection db) {
        _db = db;
    }

    public SysUserRoleDao() {
        _db = Db.Connection();
    }

    private IDbConnection Conn() {
        return _db != null ? _db : Db.Connection();
    }

    public async int GetRoleId(int userId) {
        SysUserRole record = await this.Conn().Select<SysUserRole>()
            .Where(a => a.userId == userId)
            .FirstAsync();
        if (record != null) {
            return record.roleId;
        }
        return 0;
    }

    public async int SetUserRole(int userId, int roleId) {
        await this.Conn().Delete<SysUserRole>()
            .Where(a => a.userId == userId)
            .ExecuteAffrowsAsync();

        if (roleId > 0) {
            SysUserRole item = new SysUserRole();
            item.userId = userId;
            item.roleId = roleId;
            return await this.Conn().Insert<SysUserRole>(item).ExecuteAffrowsAsync();
        }
        return 1;
    }
}
