using System;
using System.Collections.Generic;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;

namespace Zan.Web.Modules.System.Dao;

/// 系统配置数据访问对象
class SysConfigDao {
    public async List<SysConfig> All() {
        return await Db.Connection().Select<SysConfig>()
            .OrderBy(a => a.id)
            .ToListAsync();
    }

    public async SysConfig ByKey(string key) {
        return await Db.Connection().Select<SysConfig>()
            .Where(a => a.key == key)
            .FirstAsync();
    }

    public async string GetValue(string key, string defVal) {
        SysConfig cfg = await this.ByKey(key);
        if (cfg != null && cfg.value != null) {
            return cfg.value;
        }
        return defVal;
    }

    public async int SetValue(string key, string val, string description) {
        if (key == null || key.Length == 0) { return 0; }
        long now = DateTime.Now().ToUnixSeconds();
        SysConfig existing = await this.ByKey(key);
        if (existing != null) {
            return await Db.Connection().Update<SysConfig>()
                .Set(a => a.value, val)
                .Set(a => a.description, description != null ? description : existing.description)
                .Set(a => a.updatedAt, now)
                .Where(a => a.id == existing.id)
                .ExecuteAffrowsAsync();
        } else {
            SysConfig cfg = new SysConfig();
            cfg.key = key;
            cfg.value = val;
            cfg.description = description != null ? description : "";
            cfg.updatedAt = now;
            return await Db.Connection().Insert<SysConfig>(cfg).ExecuteIdentityAsync();
        }
    }

    public async int Delete(string key) {
        return await Db.Connection().Delete<SysConfig>()
            .Where(a => a.key == key)
            .ExecuteAffrowsAsync();
    }
}
