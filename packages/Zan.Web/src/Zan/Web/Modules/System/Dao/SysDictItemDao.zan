using System;
using System.Collections.Generic;
using System.Data;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;

namespace Zan.Web.Modules.System.Dao;

/// 数据字典项数据访问对象
class SysDictItemDao {
    private IDbConnection _db;

    public SysDictItemDao(IDbConnection db) {
        _db = db;
    }

    public SysDictItemDao() {
        _db = Db.Connection();
    }

    private IDbConnection Conn() {
        return _db != null ? _db : Db.Connection();
    }

    public async List<SysDictItem> ByTypeCode(string typeCode) {
        return await this.Conn().Select<SysDictItem>()
            .Where(a => a.typeCode == typeCode)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    public async SysDictItem ById(int id) {
        return await this.Conn().Select<SysDictItem>()
            .Where(a => a.id == id)
            .FirstAsync();
    }

    public async int Insert(SysDictItem entity) {
        if (entity == null) { return 0; }
        long now = DateTime.Now().ToUnixSeconds();
        if (entity.createdAt == 0) { entity.createdAt = now; }
        entity.updatedAt = now;
        return await this.Conn().Insert<SysDictItem>(entity).ExecuteIdentityAsync();
    }

    public async int Update(SysDictItem entity) {
        if (entity == null) { return 0; }
        return await this.Conn().Update<SysDictItem>()
            .Set(a => a.typeCode, entity.typeCode)
            .Set(a => a.label, entity.label)
            .Set(a => a.value, entity.value)
            .Set(a => a.sortOrder, entity.sortOrder)
            .Set(a => a.status, entity.status)
            .Set(a => a.updatedAt, DateTime.Now().ToUnixSeconds())
            .Where(a => a.id == entity.id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        return await this.Conn().Delete<SysDictItem>()
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    public async int DeleteByTypeCode(string typeCode) {
        return await this.Conn().Delete<SysDictItem>()
            .Where(a => a.typeCode == typeCode)
            .ExecuteAffrowsAsync();
    }
}
