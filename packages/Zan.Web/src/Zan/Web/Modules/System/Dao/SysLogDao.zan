using System;
using System.Collections.Generic;
using System.Data;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;

namespace Zan.Web.Modules.System.Dao;

/// 系统操作与审计日志数据访问对象
class SysLogDao {
    private IDbConnection _db;

    public SysLogDao(IDbConnection db) {
        _db = db;
    }

    public SysLogDao() {
        _db = Db.Connection();
    }

    private IDbConnection Conn() {
        return _db != null ? _db : Db.Connection();
    }

    public async int Insert(SysLog entity) {
        if (entity == null) { return 0; }
        if (entity.createdAt == 0) {
            entity.createdAt = DateTime.Now().ToUnixSeconds();
        }
        return await this.Conn().Insert<SysLog>(entity).ExecuteIdentityAsync();
    }

    public async int Record(int userId, string username, string action, string module, string ip, string ua, string detail, int status) {
        SysLog log = new SysLog();
        log.userId = userId;
        log.username = username != null ? username : "";
        log.action = action != null ? action : "";
        log.module = module != null ? module : "";
        log.ip = ip != null ? ip : "";
        log.userAgent = ua != null ? ua : "";
        log.detail = detail != null ? detail : "";
        log.status = status;
        log.createdAt = DateTime.Now().ToUnixSeconds();
        return await this.Insert(log);
    }

    public async List<SysLog> Page(int page, int pageSize) {
        if (page < 1) { page = 1; }
        if (pageSize < 1) { pageSize = 20; }
        return await this.Conn().Select<SysLog>()
            .OrderByDescending(a => a.id)
            .Page(page, pageSize)
            .ToListAsync();
    }

    public async long Count() {
        return await this.Conn().Select<SysLog>().CountAsync();
    }
}
