using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Modules.System.Model;

namespace Zan.Web.Modules.System.Dao;

/// 媒体与文件资产数据访问层
class SysMediaFileDao {
    private IDbConnection _db;

    public SysMediaFileDao(IDbConnection db) {
        this._db = db;
    }

    public async List<SysMediaFile> Page(int page, int pageSize) {
        if (_db == null) { return new List<SysMediaFile>(); }
        int p = page <= 0 ? 1 : page;
        int sz = pageSize <= 0 ? 20 : pageSize;
        int offset = (p - 1) * sz;
        return await _db.Select<SysMediaFile>()
            .OrderByDescending(m => m.id)
            .Skip(offset)
            .Take(sz)
            .ToListAsync();
    }

    public async long Count() {
        if (_db == null) { return 0; }
        return await _db.Select<SysMediaFile>().CountAsync();
    }

    public async int Insert(SysMediaFile file) {
        if (_db == null || file == null) { return 0; }
        return await _db.Insert<SysMediaFile>(file).ExecuteIdentityAsync();
    }

    public async int Delete(int id) {
        if (_db == null) { return 0; }
        return await _db.Delete<SysMediaFile>().Where(m => m.id == id).ExecuteAffrowsAsync();
    }
}
