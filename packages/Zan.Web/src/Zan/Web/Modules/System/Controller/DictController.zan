using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Protocol;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 数据字典管理控制器
[Route("api/system/dict/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("数据字典")]
class DictController : WebController {
    private SysDictTypeDao TypeDao() { return new SysDictTypeDao(this.__Conn()); }
    private SysDictItemDao ItemDao() { return new SysDictItemDao(this.__Conn()); }

    /// PUT or GET /api/system/dict/conf - 对接 adminUI ZanTable 表格元数据配置
    [HttpGet]
    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("字典表格配置")]
    public void Conf() {
        TableConfig tc = new TableConfig();
        tc.conf.title = "数据字典";
        tc.conf.pageSize = 20;

        tc.columns.Add(new TableColumn("id", "ID", 70));
        tc.columns.Add(new TableColumn("name", "字典名称", 150));
        tc.columns.Add(new TableColumn("code", "字典类型编码", 160));
        tc.columns.Add(new TableColumn("description", "说明", 200));
        tc.columns.Add(new TableColumn("status", "状态", 80));

        tc.filters.Add(new TableFilter("name", "字典名称", "text"));
        tc.filters.Add(new TableFilter("code", "编码", "text"));

        this.OkJson(tc.ToJson());
    }

    /// POST /api/system/dict/list - 对接 adminUI getListAsync 列表查询
    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("列表查询")]
    public async void List() {
        this.Types();
    }

    /// GET /api/system/dict/types - 获取所有字典类型列表
    [HttpGet]
    [Custom(IsMenu = true, Perm = PermBit.View)]
    [Description("字典类型列表")]
    public async void Types() {
        List<SysDictType> list = await this.TypeDao().All();
        JsonValue arr = JsonValue.NewArray();
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                SysDictType t = list[i];
                JsonValue item = JsonValue.NewObject();
                item.PutInt("id", t.id);
                item.PutStr("code", t.code);
                item.PutStr("name", t.name);
                item.PutStr("description", t.description);
                item.PutInt("status", t.status);
                arr.Append(item);
            }
        }
        this.OkJson(arr.ToJson());
    }

    /// POST /api/system/dict/saveType - 新增或修改字典类型
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存字典类型")]
    public async void SaveType() {
        int id = this.InInt("id", 0);
        string code = this.In("code");
        string name = this.In("name");
        string description = this.In("description");
        int status = this.InInt("status", 1);

        if (code == null || code.Length == 0) {
            this.FailJson(400, "类型标识不能为空");
            return;
        }
        if (name == null || name.Length == 0) {
            this.FailJson(400, "类型名称不能为空");
            return;
        }

        SysDictTypeDao typeDao = this.TypeDao();
        SysDictType clash = await typeDao.ByCode(code);
        if (clash != null && clash.id != id) {
            this.FailJson(400, "类型标识 " + code + " 已存在");
            return;
        }

        if (id > 0) {
            SysDictType t = await typeDao.ById(id);
            if (t == null) {
                this.FailJson(404, "字典类型不存在");
                return;
            }
            t.code = code;
            t.name = name;
            t.description = description;
            t.status = status;
            await typeDao.Update(t);
            this.OkJson("{\"id\":" + Convert.ToString(id) + "}");
        } else {
            SysDictType t = new SysDictType();
            t.code = code;
            t.name = name;
            t.description = description;
            t.status = status;
            int newId = await typeDao.Insert(t);
            this.OkJson("{\"id\":" + Convert.ToString(newId) + "}");
        }
    }

    /// POST /api/system/dict/deleteType - 删除字典类型及其所有条目
    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除字典类型")]
    public async void DeleteType() {
        int id = this.InInt("id", 0);
        SysDictTypeDao typeDao = this.TypeDao();
        SysDictType t = await typeDao.ById(id);
        if (t == null) {
            this.FailJson(404, "字典类型不存在");
            return;
        }
        await typeDao.Delete(id);
        if (t.code != null && t.code.Length > 0) {
            await this.ItemDao().DeleteByTypeCode(t.code);
        }
        this.OkJson("{\"success\":true}");
    }

    /// GET /api/system/dict/items - 获取指定类型的字典条目列表
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("字典项列表")]
    public async void Items() {
        string typeCode = this.In("typeCode");
        if (typeCode == null || typeCode.Length == 0) {
            typeCode = this.In("type");
        }
        if (typeCode == null || typeCode.Length == 0) {
            this.FailJson(400, "typeCode 不能为空");
            return;
        }

        List<SysDictItem> list = await this.ItemDao().ByTypeCode(typeCode);
        JsonValue arr = JsonValue.NewArray();
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                SysDictItem it = list[i];
                JsonValue item = JsonValue.NewObject();
                item.PutInt("id", it.id);
                item.PutStr("typeCode", it.typeCode);
                item.PutStr("label", it.label);
                item.PutStr("value", it.value);
                item.PutInt("sortOrder", it.sortOrder);
                item.PutInt("status", it.status);
                arr.Append(item);
            }
        }
        this.OkJson(arr.ToJson());
    }

    /// POST /api/system/dict/saveItem - 新增或修改字典条目
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存字典项")]
    public async void SaveItem() {
        int id = this.InInt("id", 0);
        string typeCode = this.In("typeCode");
        string label = this.In("label");
        string val = this.In("value");
        int sortOrder = this.InInt("sortOrder", 1);
        int status = this.InInt("status", 1);

        if (typeCode == null || typeCode.Length == 0) {
            this.FailJson(400, "所属类型标识不能为空");
            return;
        }
        if (label == null || label.Length == 0) {
            this.FailJson(400, "条目标签不能为空");
            return;
        }
        if (val == null || val.Length == 0) {
            this.FailJson(400, "条目值不能为空");
            return;
        }

        SysDictItemDao itemDao = this.ItemDao();
        if (id > 0) {
            SysDictItem it = await itemDao.ById(id);
            if (it == null) {
                this.FailJson(404, "字典条目不存在");
                return;
            }
            it.typeCode = typeCode;
            it.label = label;
            it.value = val;
            it.sortOrder = sortOrder;
            it.status = status;
            await itemDao.Update(it);
            this.OkJson("{\"id\":" + Convert.ToString(id) + "}");
        } else {
            SysDictItem it = new SysDictItem();
            it.typeCode = typeCode;
            it.label = label;
            it.value = val;
            it.sortOrder = sortOrder;
            it.status = status;
            int newId = await itemDao.Insert(it);
            this.OkJson("{\"id\":" + Convert.ToString(newId) + "}");
        }
    }

    /// POST /api/system/dict/deleteItem - 删除字典条目
    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除字典项")]
    public async void DeleteItem() {
        int id = this.InInt("id", 0);
        SysDictItemDao itemDao = this.ItemDao();
        SysDictItem it = await itemDao.ById(id);
        if (it == null) {
            this.FailJson(404, "字典条目不存在");
            return;
        }
        await itemDao.Delete(id);
        this.OkJson("{\"success\":true}");
    }
}
