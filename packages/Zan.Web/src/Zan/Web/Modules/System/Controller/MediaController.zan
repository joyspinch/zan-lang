using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Protocol;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 媒体与文件资产管理控制器
[Route("api/system/media/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("媒体库")]
class MediaController : WebController {
    private SysMediaFileDao MediaDao() { return new SysMediaFileDao(this.__Conn()); }

    /// PUT or GET /api/system/media/conf - 对接 adminUI ZanTable 表格元数据配置
    [HttpGet]
    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("媒体库表格配置")]
    public void Conf() {
        TableConfig tc = new TableConfig();
        tc.conf.title = "媒体库管理";
        tc.conf.pageSize = 20;

        tc.columns.Add(new TableColumn("id", "ID", 70));
        tc.columns.Add(new TableColumn("name", "文件名", 200));
        tc.columns.Add(new TableColumn("path", "文件路径", 240));
        tc.columns.Add(new TableColumn("ext", "类型", 90));
        tc.columns.Add(new TableColumn("size", "大小(Bytes)", 110));
        tc.columns.Add(new TableColumn("uploadedBy", "上传人", 120));
        tc.columns.Add(new TableColumn("createdAt", "上传时间", 160));

        tc.filters.Add(new TableFilter("name", "文件名", "text"));

        this.OkJson(tc.ToJson());
    }

    /// GET /api/system/media/page - 分页查询媒体文件
    [HttpGet]
    [Custom(IsMenu = true, Perm = PermBit.View)]
    [Description("媒体列表")]
    public async void Page() {
        int page = this.InInt("page", 1);
        int pageSize = this.InInt("pageSize", 20);
        if (pageSize <= 0) { pageSize = this.InInt("limit", 20); }

        SysMediaFileDao dao = this.MediaDao();
        List<SysMediaFile> list = await dao.Page(page, pageSize);
        long total = await dao.Count();

        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < list.Count; i++) {
            SysMediaFile m = list[i];
            JsonValue o = JsonValue.NewObject();
            o.PutInt("id", m.id);
            o.PutStr("name", m.name);
            o.PutStr("path", m.path);
            o.PutStr("ext", m.ext);
            o.PutInt("size", (int)m.size);
            o.PutStr("uploadedBy", m.uploadedBy);
            o.PutInt("createdAt", (int)m.createdAt);
            arr.Append(o);
        }

        JsonValue data = JsonValue.NewObject();
        data.PutInt("total", (int)total);
        data.Put("records", arr);
        this.OkJson(data.ToJson());
    }

    /// POST /api/system/media/delete - 删除媒体文件记录
    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除文件")]
    public async void Delete() {
        int id = this.InInt("id", 0);
        if (id <= 0) { this.FailJson(400, "参数 id 无效"); return; }
        bool ok = await this.MediaDao().Delete(id);
        if (ok) {
            this.OkJson("{\"status\":\"deleted\"}");
        } else {
            this.FailJson(500, "删除失败");
        }
    }
}
