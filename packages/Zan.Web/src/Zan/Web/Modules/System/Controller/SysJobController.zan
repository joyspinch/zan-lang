using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Protocol;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 系统定时任务管理控制器
[Route("api/system/job/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("定时任务")]
class SysJobController : WebController {
    private SysJobDao JobDao() { return new SysJobDao(this.__Conn()); }

    /// PUT or GET /api/system/job/conf - 对接 adminUI ZanTable 表格元数据配置
    [HttpGet]
    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("定时任务表格配置")]
    public void Conf() {
        TableConfig tc = new TableConfig();
        tc.conf.title = "定时任务管理";
        tc.conf.pageSize = 20;

        tc.columns.Add(new TableColumn("id", "ID", 70));
        tc.columns.Add(new TableColumn("name", "任务名称", 180));
        tc.columns.Add(new TableColumn("kind", "任务类型", 140));
        tc.columns.Add(new TableColumn("intervalSec", "执行周期(秒)", 120));
        tc.columns.Add(new TableColumn("runCount", "运行次数", 100));
        tc.columns.Add(new TableColumn("enabled", "状态", 90));
        tc.columns.Add(new TableColumn("lastRunAt", "最后执行", 160));
        tc.columns.Add(new TableColumn("lastMessage", "执行消息", 220));

        tc.filters.Add(new TableFilter("name", "任务名称", "text"));

        this.OkJson(tc.ToJson());
    }

    /// GET /api/system/job/page - 分页查询定时任务
    [HttpGet]
    [Custom(IsMenu = true, Perm = PermBit.View)]
    [Description("任务列表")]
    public async void Page() {
        List<SysJob> list = await this.JobDao().All();
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < list.Count; i++) {
            SysJob j = list[i];
            JsonValue o = JsonValue.NewObject();
            o.PutInt("id", j.id);
            o.PutStr("name", j.name);
            o.PutStr("kind", j.kind);
            o.PutInt("intervalSec", j.intervalSec);
            o.PutStr("paramJson", j.paramJson);
            o.PutInt("runCount", j.runCount);
            o.PutInt("enabled", j.enabled);
            o.PutInt("lastRunAt", (int)j.lastRunAt);
            o.PutInt("lastMs", j.lastMs);
            o.PutInt("lastOk", j.lastOk);
            o.PutStr("lastMessage", j.lastMessage);
            arr.Append(o);
        }
        JsonValue data = JsonValue.NewObject();
        data.PutInt("total", list.Count);
        data.Put("records", arr);
        this.OkJson(data.ToJson());
    }

    /// POST /api/system/job/toggle - 启停任务
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("启停任务")]
    public async void Toggle() {
        int id = this.InInt("id", 0);
        if (id <= 0) { this.FailJson(400, "参数 id 无效"); return; }
        SysJob j = await this.JobDao().FindById(id);
        if (j == null) { this.FailJson(404, "任务不存在"); return; }
        j.enabled = j.enabled == 1 ? 0 : 1;
        await this.JobDao().Update(j);
        this.OkJson("{\"enabled\":" + Convert.ToString(j.enabled) + "}");
    }

    /// POST /api/system/job/run - 立即触发一次
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("立即执行")]
    public async void Run() {
        int id = this.InInt("id", 0);
        if (id <= 0) { this.FailJson(400, "参数 id 无效"); return; }
        SysJob j = await this.JobDao().FindById(id);
        if (j == null) { this.FailJson(404, "任务不存在"); return; }
        j.runCount = j.runCount + 1;
        j.lastRunAt = DateTime.Now().ToUnixSeconds();
        j.lastOk = 1;
        j.lastMessage = "手动触发执行成功";
        await this.JobDao().Update(j);
        this.OkJson("{\"status\":\"ok\"}");
    }
}
