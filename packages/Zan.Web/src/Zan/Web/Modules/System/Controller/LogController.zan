using System;
using System.Collections.Generic;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 系统审计与操作日志控制器
class LogController : WebController {
    private SysLogDao _logDao = new SysLogDao();

    /// GET /api/log/page - 分页查询系统操作与审计日志
    public async void Page() {
        int page = this.InInt("page", 1);
        int pageSize = this.InInt("pageSize", 20);
        if (pageSize <= 0) { pageSize = this.InInt("limit", 20); }

        List<SysLog> list = await _logDao.Page(page, pageSize);
        long total = await _logDao.Count();

        string json = "{\"total\":" + Convert.ToString(total) + ",\"records\":[";
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                if (i > 0) { json += ","; }
                SysLog l = list[i];
                json += "{\"id\":" + Convert.ToString(l.id) +
                    ",\"userId\":" + Convert.ToString(l.userId) +
                    ",\"username\":\"" + (l.username != null ? l.username : "") + "\"" +
                    ",\"action\":\"" + (l.action != null ? l.action : "") + "\"" +
                    ",\"module\":\"" + (l.module != null ? l.module : "") + "\"" +
                    ",\"ip\":\"" + (l.ip != null ? l.ip : "") + "\"" +
                    ",\"status\":" + Convert.ToString(l.status) +
                    ",\"createdAt\":" + Convert.ToString(l.createdAt) + "}";
            }
        }
        json += "]}";
        this.OkJson(json);
    }
}
