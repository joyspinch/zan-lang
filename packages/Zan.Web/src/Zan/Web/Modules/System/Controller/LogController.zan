using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 系统审计与操作日志控制器
[Route("api/system/log/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("系统日志")]
class LogController : WebController {
    private SysLogDao LogDao() { return new SysLogDao(this.__Conn()); }

    /// GET /api/system/log/page - 分页查询系统操作与审计日志
    [HttpGet]
    [Custom(IsMenu = true, Perm = PermBit.View)]
    [Description("日志列表")]
    public async void Page() {
        int page = this.InInt("page", 1);
        int pageSize = this.InInt("pageSize", 20);
        if (pageSize <= 0) { pageSize = this.InInt("limit", 20); }

        SysLogDao dao = this.LogDao();
        List<SysLog> list = await dao.Page(page, pageSize);
        long total = await dao.Count();

        JsonValue root = JsonValue.NewObject();
        root.PutInt("total", total);
        JsonValue records = JsonValue.NewArray();
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                SysLog l = list[i];
                JsonValue row = JsonValue.NewObject();
                row.PutInt("id", l.id);
                row.PutInt("userId", l.userId);
                row.PutStr("username", l.username);
                row.PutStr("action", l.action);
                row.PutStr("module", l.module);
                row.PutStr("ip", l.ip);
                row.PutInt("status", l.status);
                row.PutInt("createdAt", l.createdAt);
                records.Append(row);
            }
        }
        root.Put("records", records);
        this.OkJson(root.ToJson());
    }
}
