using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Protocol;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 系统审计与操作日志控制器
[Route("api/system/log/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("系统日志")]
class LogController : WebController {
    private SysLogDao LogDao() { return new SysLogDao(this.__Conn()); }

    /// PUT or GET /api/system/log/conf - 对接 adminUI ZanTable 表格元数据配置
    [HttpGet]
    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("日志表格配置")]
    public void Conf() {
        TableConfig tc = new TableConfig();
        tc.conf.title = "系统日志";
        tc.conf.pageSize = 20;

        tc.columns.Add(new TableColumn("id", "ID", 70));
        tc.columns.Add(new TableColumn("username", "操作用户", 120));
        tc.columns.Add(new TableColumn("action", "操作动作", 140));
        tc.columns.Add(new TableColumn("module", "模块", 110));
        tc.columns.Add(new TableColumn("method", "HTTP方法", 90));
        tc.columns.Add(new TableColumn("url", "请求URL", 180));
        tc.columns.Add(new TableColumn("ip", "IP地址", 130));
        tc.columns.Add(new TableColumn("status", "状态码", 80));
        tc.columns.Add(new TableColumn("elapsedMs", "耗时(ms)", 90));
        tc.columns.Add(new TableColumn("createdAt", "请求时间", 160));

        tc.filters.Add(new TableFilter("username", "操作人", "text"));
        tc.filters.Add(new TableFilter("module", "业务模块", "text"));

        this.OkJson(tc.ToJson());
    }

    /// POST /api/system/log/list - 对接 adminUI getListAsync 列表查询
    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("列表查询")]
    public async void List() {
        this.Page();
    }

    /// GET /api/system/log/page - 分页查询系统操作与审计日志
    [HttpGet]
    [Custom(IsMenu = true, Perm = PermBit.View)]
    [Description("日志列表")]
    public async void Page() {
        int page = this.InInt("page", 1);
        int pageSize = this.InInt("pageSize", 20);
        if (pageSize <= 0) { pageSize = this.InInt("limit", 20); }

        SysLogDao dao = this.LogDao();
        List<SysLog> list = await dao.Page(page, pageSize);
        long total = await dao.Count();

        JsonValue root = JsonValue.NewObject();
        root.PutInt("total", total);
        JsonValue records = JsonValue.NewArray();
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                SysLog l = list[i];
                JsonValue row = JsonValue.NewObject();
                row.PutInt("id", l.id);
                row.PutInt("userId", l.userId);
                row.PutStr("username", l.username);
                row.PutStr("action", l.action);
                row.PutStr("module", l.module);
                row.PutStr("ip", l.ip);
                row.PutInt("status", l.status);
                row.PutInt("createdAt", l.createdAt);
                records.Append(row);
            }
        }
        root.Put("records", records);
        this.OkJson(root.ToJson());
    }
}
