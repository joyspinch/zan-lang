using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Protocol;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 系统菜单管理控制器
[Route("api/system/menu/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("菜单管理")]
class SysMenuController : WebController {
    private SysMenuDao MenuDao() { return new SysMenuDao(this.__Conn()); }

    /// PUT or GET /api/system/menu/conf - 对接 adminUI ZanTable 表格元数据配置
    [HttpGet]
    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("菜单表格配置")]
    public void Conf() {
        TableConfig tc = new TableConfig();
        tc.conf.title = "菜单管理";
        tc.conf.pageSize = 50;

        tc.columns.Add(new TableColumn("id", "ID", 70));
        tc.columns.Add(new TableColumn("title", "菜单标题", 160));
        tc.columns.Add(new TableColumn("node", "路由标识(node)", 140));
        tc.columns.Add(new TableColumn("parentNode", "父级标识", 120));
        tc.columns.Add(new TableColumn("path", "路由路径", 160));
        tc.columns.Add(new TableColumn("icon", "图标", 100));
        tc.columns.Add(new TableColumn("rank", "排序", 80));
        tc.columns.Add(new TableColumn("status", "状态", 80));

        tc.filters.Add(new TableFilter("title", "菜单标题", "text"));

        this.OkJson(tc.ToJson());
    }

    /// POST /api/system/menu/list - 对接 adminUI getListAsync 列表查询
    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("列表查询")]
    public async void List() {
        this.All();
    }

    /// GET /api/system/menu/all - 获取全部菜单节点
    [HttpGet]
    [Custom(IsMenu = true, Perm = PermBit.View)]
    [Description("全部菜单")]
    public async void All() {
        List<SysMenu> list = await this.MenuDao().All();
        JsonValue arr = JsonValue.NewArray();
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                SysMenu m = list[i];
                JsonValue item = JsonValue.NewObject();
                item.PutInt("id", m.id);
                item.PutStr("node", m.node);
                item.PutStr("parentNode", m.parentNode);
                item.PutStr("title", m.title);
                item.PutStr("component", m.component);
                item.PutStr("icon", m.icon);
                item.PutStr("path", m.path);
                item.PutInt("rank", m.rank);
                item.PutInt("hidden", m.hidden);
                item.PutInt("status", m.status);
                arr.Append(item);
            }
        }
        this.OkJson(arr.ToJson());
    }

    /// POST /api/system/menu/save - 保存或更新菜单
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存菜单")]
    public async void Save() {
        int id = this.InInt("id", 0);
        string node = this.In("node");
        string parentNode = this.In("parentNode");
        string title = this.In("title");
        string component = this.In("component");
        string icon = this.In("icon");
        string path = this.In("path");
        int rank = this.InInt("rank", 99);
        int hidden = this.InInt("hidden", 0);
        int status = this.InInt("status", 1);

        if (title == null || title.Length == 0) {
            this.FailJson(400, "菜单标题不能为空");
            return;
        }
        if (node == null || node.Length == 0) {
            this.FailJson(400, "路由标识(node)不能为空");
            return;
        }

        SysMenuDao menuDao = this.MenuDao();
        if (id > 0) {
            SysMenu m = await menuDao.ById(id);
            if (m == null) {
                this.FailJson(404, "菜单不存在");
                return;
            }
            m.node = node;
            m.parentNode = parentNode != null ? parentNode : "";
            m.title = title;
            m.component = component != null ? component : "";
            m.icon = icon != null ? icon : "";
            m.path = path != null ? path : "";
            m.rank = rank;
            m.hidden = hidden;
            m.status = status;
            await menuDao.Update(m);
            this.OkJson("{\"id\":" + Convert.ToString(id) + "}");
        } else {
            SysMenu m = new SysMenu();
            m.node = node;
            m.parentNode = parentNode != null ? parentNode : "";
            m.title = title;
            m.component = component != null ? component : "";
            m.icon = icon != null ? icon : "";
            m.path = path != null ? path : "";
            m.rank = rank;
            m.hidden = hidden;
            m.status = status;
            int newId = await menuDao.Insert(m);
            this.OkJson("{\"id\":" + Convert.ToString(newId) + "}");
        }
    }

    /// POST /api/system/menu/delete - 删除菜单
    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除菜单")]
    public async void Delete() {
        int id = this.InInt("id", 0);
        if (id <= 0) {
            this.FailJson(400, "参数错误");
            return;
        }
        await this.MenuDao().Delete(id);
        this.OkJson("{\"success\":true}");
    }
}
