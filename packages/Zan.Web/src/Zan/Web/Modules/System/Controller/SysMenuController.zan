using System;
using System.Collections.Generic;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 系统菜单管理控制器
class SysMenuController : WebController {
    private SysMenuDao _menuDao = new SysMenuDao();

    /// GET /api/system/menu/all - 获取全部菜单节点
    public async void All() {
        List<SysMenu> list = await _menuDao.All();
        string json = "[";
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                if (i > 0) { json += ","; }
                SysMenu m = list[i];
                json += "{\"id\":" + Convert.ToString(m.id) +
                    ",\"node\":\"" + (m.node != null ? m.node : "") + "\"" +
                    ",\"parentNode\":\"" + (m.parentNode != null ? m.parentNode : "") + "\"" +
                    ",\"title\":\"" + (m.title != null ? m.title : "") + "\"" +
                    ",\"component\":\"" + (m.component != null ? m.component : "") + "\"" +
                    ",\"icon\":\"" + (m.icon != null ? m.icon : "") + "\"" +
                    ",\"path\":\"" + (m.path != null ? m.path : "") + "\"" +
                    ",\"rank\":" + Convert.ToString(m.rank) +
                    ",\"hidden\":" + Convert.ToString(m.hidden) +
                    ",\"status\":" + Convert.ToString(m.status) + "}";
            }
        }
        json += "]";
        this.OkJson(json);
    }

    /// POST /api/system/menu/save - 保存或更新菜单
    public async void Save() {
        int id = this.InInt("id", 0);
        string node = this.In("node");
        string parentNode = this.In("parentNode");
        string title = this.In("title");
        string component = this.In("component");
        string icon = this.In("icon");
        string path = this.In("path");
        int rank = this.InInt("rank", 99);
        int hidden = this.InInt("hidden", 0);
        int status = this.InInt("status", 1);

        if (title == null || title.Length == 0) {
            this.FailJson(400, "菜单标题不能为空");
            return;
        }
        if (node == null || node.Length == 0) {
            this.FailJson(400, "路由标识(node)不能为空");
            return;
        }

        if (id > 0) {
            SysMenu m = await _menuDao.ById(id);
            if (m == null) {
                this.FailJson(404, "菜单不存在");
                return;
            }
            m.node = node;
            m.parentNode = parentNode != null ? parentNode : "";
            m.title = title;
            m.component = component != null ? component : "";
            m.icon = icon != null ? icon : "";
            m.path = path != null ? path : "";
            m.rank = rank;
            m.hidden = hidden;
            m.status = status;
            await _menuDao.Update(m);
            this.OkJson("{\"id\":" + Convert.ToString(id) + "}");
        } else {
            SysMenu m = new SysMenu();
            m.node = node;
            m.parentNode = parentNode != null ? parentNode : "";
            m.title = title;
            m.component = component != null ? component : "";
            m.icon = icon != null ? icon : "";
            m.path = path != null ? path : "";
            m.rank = rank;
            m.hidden = hidden;
            m.status = status;
            int newId = await _menuDao.Insert(m);
            this.OkJson("{\"id\":" + Convert.ToString(newId) + "}");
        }
    }

    /// POST /api/system/menu/delete - 删除菜单
    public async void Delete() {
        int id = this.InInt("id", 0);
        if (id <= 0) {
            this.FailJson(400, "参数错误");
            return;
        }
        await _menuDao.Delete(id);
        this.OkJson("{\"success\":true}");
    }
}
