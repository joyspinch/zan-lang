using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 系统部门组织架构管理控制器
[Route("api/system/dept/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("部门管理")]
class SysDeptController : WebController {
    private SysDepartmentDao DeptDao() { return new SysDepartmentDao(this.__Conn()); }

    /// GET /api/system/dept/tree - 获取部门列表/组织架构树
    [HttpGet]
    [Custom(IsMenu = true, Perm = PermBit.View)]
    [Description("部门架构树")]
    public async void Tree() {
        List<SysDepartment> list = await this.DeptDao().All();
        JsonValue arr = JsonValue.NewArray();
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                SysDepartment d = list[i];
                JsonValue obj = JsonValue.NewObject();
                obj.PutInt("id", d.id);
                obj.PutInt("parentId", d.parentId);
                obj.PutStr("name", d.name);
                obj.PutStr("code", d.code);
                obj.PutInt("leaderUserId", d.leaderUserId);
                obj.PutInt("sortOrder", d.sortOrder);
                obj.PutInt("status", d.status);
                obj.PutInt("createdAt", d.createdAt);
                obj.PutInt("updatedAt", d.updatedAt);
                arr.Append(obj);
            }
        }
        this.OkJson(arr.ToJson());
    }

    /// POST /api/system/dept/save - 新增或修改部门
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存部门")]
    public async void Save() {
        int id = this.InInt("id", 0);
        int parentId = this.InInt("parentId", 0);
        string name = this.In("name");
        string code = this.In("code");
        int leaderUserId = this.InInt("leaderUserId", 0);
        int sortOrder = this.InInt("sortOrder", 1);
        int status = this.InInt("status", 1);

        if (name == null || name.Length == 0) {
            this.FailJson(400, "部门名称不能为空");
            return;
        }

        SysDepartmentDao dao = this.DeptDao();
        if (id > 0) {
            SysDepartment d = await dao.ById(id);
            if (d == null) {
                this.FailJson(404, "部门不存在");
                return;
            }
            d.parentId = parentId;
            d.name = name;
            d.code = code != null ? code : "";
            d.leaderUserId = leaderUserId;
            d.sortOrder = sortOrder;
            d.status = status;
            await dao.Update(d);
            this.OkJson("{\"id\":" + Convert.ToString(id) + "}");
        } else {
            SysDepartment d = new SysDepartment();
            d.parentId = parentId;
            d.name = name;
            d.code = code != null ? code : "";
            d.leaderUserId = leaderUserId;
            d.sortOrder = sortOrder;
            d.status = status;
            int newId = await dao.Insert(d);
            this.OkJson("{\"id\":" + Convert.ToString(newId) + "}");
        }
    }

    /// POST /api/system/dept/delete - 删除部门
    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除部门")]
    public async void Delete() {
        int id = this.InInt("id", 0);
        if (id <= 0) {
            this.FailJson(400, "参数错误");
            return;
        }
        SysDepartmentDao dao = this.DeptDao();
        List<SysDepartment> subs = await dao.ByParentId(id);
        if (subs != null && subs.Count > 0) {
            this.FailJson(400, "该部门下存在子部门，禁止直接删除");
            return;
        }

        await dao.Delete(id);
        this.OkJson("{\"success\":true}");
    }
}
