using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;
using Zan.Web.Modules.System.Service;

namespace Zan.Web.Modules.System.Controller;

/// 系统身份认证与用户会话控制器
[Route("api/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("身份认证")]
class AuthController : WebController {
    private SysUserDao UserDao() { return new SysUserDao(this.__Conn()); }
    private SysUserRoleDao UserRoleDao() { return new SysUserRoleDao(this.__Conn()); }
    private SysRoleDao RoleDao() { return new SysRoleDao(this.__Conn()); }
    private AuthManager AuthMgr() { return new AuthManager(this.__Conn()); }

    /// POST /api/login - 用户登录，下发 AccessToken 与用户信息
    [HttpPost]
    [Custom(Authorization = CustomAuthorization.None)]
    [Description("用户登录")]
    public async void Login() {
        string userName = this.In("userName");
        if (userName == null || userName.Length == 0) {
            userName = this.In("username");
        }
        string password = this.In("password");

        if (userName == null || userName.Length == 0) {
            this.FailJson(400, "用户名不能为空");
            return;
        }
        if (password == null || password.Length == 0) {
            this.FailJson(400, "密码不能为空");
            return;
        }

        SysUserDao userDao = this.UserDao();
        SysUser user = await userDao.ByUsername(userName);
        if (user == null) {
            this.FailJson(400, "用户不存在或密码错误");
            return;
        }

        if (user.status != 1) {
            this.FailJson(403, "用户已被禁用，请联系管理员");
            return;
        }

        bool match = SysUserDao.VerifyPassword(password, user.salt, user.password);
        if (!match) {
            this.FailJson(400, "用户不存在或密码错误");
            return;
        }

        int roleId = await this.UserRoleDao().GetRoleId(user.id);
        string roleName = "普通用户";
        if (roleId > 0) {
            SysRole role = await this.RoleDao().ById(roleId);
            if (role != null && role.name != null && role.name.Length > 0) {
                roleName = role.name;
            }
        }

        LoginUser loginUser = await TokenService.CreateToken(user, roleId > 0 ? roleId : 1, roleName);
        this.Ctx().SetCookie("zsession", loginUser.AccessToken, 604800);
        this.Ctx().SetCookie("token", loginUser.AccessToken, 604800);
        this.OkJson(loginUser.ToJson());
    }

    /// GET /users/index/userinfo - 获取当前登录用户的个人资料
    [HttpGet]
    [Route("/users/index/userinfo")]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("当前用户信息")]
    public async void UserInfo() {
        string token = TokenService.ExtractToken(this);
        if (token == null || token.Length == 0) {
            this.FailJson(401, "未提供有效 Token");
            return;
        }

        LoginUser user = await TokenService.GetLoginUser(token);
        if (user == null) {
            this.FailJson(401, "登录已失效，请重新登录");
            return;
        }

        this.OkJson(user.ToJson());
    }

    /// POST /api/logout - 用户退出登录，注销 Token
    [HttpPost]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("退出登录")]
    public async void Logout() {
        string token = TokenService.ExtractToken(this);
        if (token != null && token.Length > 0) {
            await TokenService.RemoveToken(token);
        }
        this.Ctx().SetCookie("zsession", "", 0);
        this.Ctx().SetCookie("token", "", 0);
        this.OkJson("{}");
    }

    /// GET /api/conf/menu - 获取动态路由权限菜单树（对接 adminUI 动态路由加载）
    [HttpGet]
    [Route("/api/conf/menu")]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("动态路由菜单")]
    public async void Menu() {
        string token = TokenService.ExtractToken(this);
        int roleId = 1; // 默认超级管理员

        if (token != null && token.Length > 0) {
            LoginUser user = await TokenService.GetLoginUser(token);
            if (user != null && user.RoleID > 0) {
                roleId = user.RoleID;
            }
        }

        List<RouteNode> tree = await this.AuthMgr().GetMenuTree(roleId);
        if ((tree == null || tree.Count == 0) && WebBoot.App() != null) {
            tree = SysMenuSync.BuildFromRouter(WebBoot.App(), roleId);
        }
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < tree.Count; i++) {
            arr.Append(tree[i].ToJsonValue());
        }

        this.OkJson(arr.ToJson());
    }
}
