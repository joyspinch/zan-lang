using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Protocol;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 系统角色管理控制器
[Route("api/system/role/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("角色管理")]
class SysRoleController : WebController {
    private SysRoleDao RoleDao() { return new SysRoleDao(this.__Conn()); }
    private SysRoleMenuDao RoleMenuDao() { return new SysRoleMenuDao(this.__Conn()); }

    /// PUT or GET /api/system/role/conf - 对接 adminUI ZanTable 表格元数据配置
    [HttpGet]
    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("角色表格配置")]
    public void Conf() {
        TableConfig tc = new TableConfig();
        tc.conf.title = "角色管理";
        tc.conf.pageSize = 20;

        tc.columns.Add(new TableColumn("id", "ID", 70));
        tc.columns.Add(new TableColumn("name", "角色名称", 140));
        tc.columns.Add(new TableColumn("intro", "角色说明", 220));
        tc.columns.Add(new TableColumn("status", "状态", 80));
        tc.columns.Add(new TableColumn("createdAt", "创建时间", 160));

        tc.filters.Add(new TableFilter("name", "角色名称", "text"));

        this.OkJson(tc.ToJson());
    }

    /// POST /api/system/role/list - 对接 adminUI getListAsync 列表查询
    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("列表查询")]
    public async void List() {
        this.Page();
    }

    /// GET /api/system/role/all - 获取全部启用角色列表
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("全部角色")]
    public async void All() {
        List<SysRole> list = await this.RoleDao().All();
        JsonValue arr = JsonValue.NewArray();
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                SysRole r = list[i];
                JsonValue item = JsonValue.NewObject();
                item.PutInt("id", r.id);
                item.PutStr("name", r.name);
                item.PutStr("intro", r.intro);
                item.PutInt("status", r.status);
                arr.Append(item);
            }
        }
        this.OkJson(arr.ToJson());
    }

    /// GET /api/system/role/page - 分页获取角色列表
    [HttpGet]
    [Custom(IsMenu = true, Perm = PermBit.View)]
    [Description("分页查询")]
    public async void Page() {
        int page = this.InInt("page", 1);
        int pageSize = this.InInt("pageSize", 20);
        if (pageSize <= 0) { pageSize = this.InInt("limit", 20); }

        SysRoleDao roleDao = this.RoleDao();
        List<SysRole> list = await roleDao.Page(page, pageSize);
        long total = await roleDao.TotalCount();

        JsonValue root = JsonValue.NewObject();
        root.PutInt("total", total);
        JsonValue records = JsonValue.NewArray();
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                SysRole r = list[i];
                JsonValue item = JsonValue.NewObject();
                item.PutInt("id", r.id);
                item.PutStr("name", r.name);
                item.PutStr("intro", r.intro);
                item.PutInt("status", r.status);
                item.PutInt("createdAt", r.createdAt);
                item.PutInt("updatedAt", r.updatedAt);
                records.Append(item);
            }
        }
        root.Put("records", records);
        this.OkJson(root.ToJson());
    }

    /// POST /api/system/role/save - 保存或更新角色
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存角色")]
    public async void Save() {
        int id = this.InInt("id", 0);
        string name = this.In("name");
        string intro = this.In("intro");
        int status = this.InInt("status", 1);

        if (name == null || name.Length == 0) {
            this.FailJson(400, "角色名称不能为空");
            return;
        }

        SysRoleDao roleDao = this.RoleDao();
        if (id > 0) {
            SysRole r = await roleDao.ById(id);
            if (r == null) {
                this.FailJson(404, "角色不存在");
                return;
            }
            r.name = name;
            r.intro = intro != null ? intro : "";
            r.status = status;
            await roleDao.Update(r);
            this.OkJson("{\"id\":" + Convert.ToString(id) + "}");
        } else {
            SysRole r = new SysRole();
            r.name = name;
            r.intro = intro != null ? intro : "";
            r.status = status;
            long now = DateTime.Now().ToUnixSeconds();
            r.createdAt = now;
            r.updatedAt = now;
            int newId = await roleDao.Insert(r);
            this.OkJson("{\"id\":" + Convert.ToString(newId) + "}");
        }
    }

    /// POST /api/system/role/delete - 删除角色
    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除角色")]
    public async void Delete() {
        int id = this.InInt("id", 0);
        if (id <= 0) {
            this.FailJson(400, "参数错误");
            return;
        }
        await this.RoleDao().Delete(id);
        this.OkJson("{\"success\":true}");
    }

    /// GET /api/system/role/menus - 获取角色关联的菜单ID列表
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("角色菜单权限")]
    public async void Menus() {
        int roleId = this.InInt("roleId", 0);
        if (roleId <= 0) {
            this.FailJson(400, "角色ID不能为空");
            return;
        }
        List<int> menuIds = await this.RoleMenuDao().GetMenuIdsByRoleId(roleId);
        JsonValue arr = JsonValue.NewArray();
        if (menuIds != null) {
            for (int i = 0; i < menuIds.Count; i++) {
                arr.AppendInt(menuIds[i]);
            }
        }
        this.OkJson(arr.ToJson());
    }

    /// POST /api/system/role/set-menus - 设置角色菜单授权
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("配置菜单权限")]
    public async void SetMenus() {
        int roleId = this.InInt("roleId", 0);
        string menuIdsStr = this.In("menuIds");
        if (roleId <= 0) {
            this.FailJson(400, "角色ID不能为空");
            return;
        }

        List<int> menuIds = new List<int>();
        if (menuIdsStr != null && menuIdsStr.Length > 0) {
            List<string> parts = menuIdsStr.Split(",");
            for (int i = 0; i < parts.Count; i++) {
                string p = parts[i].Trim();
                if (p.Length > 0) {
                    menuIds.Add(Convert.ToInt32(p));
                }
            }
        }

        await this.RoleMenuDao().SetRoleMenus(roleId, menuIds);
        this.OkJson("{\"success\":true}");
    }
}
