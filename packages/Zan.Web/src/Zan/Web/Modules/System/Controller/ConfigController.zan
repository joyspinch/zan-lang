using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 系统配置管理控制器
class ConfigController : WebController {
    private SysConfigDao _configDao = new SysConfigDao();

    /// GET /api/config/all - 获取全部配置项
    public async void All() {
        List<SysConfig> list = await _configDao.All();
        JsonValue arr = JsonValue.NewArray();
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                SysConfig cfg = list[i];
                JsonValue item = JsonValue.NewObject();
                item.PutInt("id", cfg.id);
                item.PutStr("key", cfg.key);
                item.PutStr("value", cfg.value);
                item.PutStr("description", cfg.description);
                item.PutInt("updatedAt", cfg.updatedAt);
                arr.Append(item);
            }
        }
        this.OkJson(arr.ToJson());
    }

    /// GET /api/config/get - 获取单个配置项
    public async void Get() {
        string key = this.In("key");
        if (key == null || key.Length == 0) {
            this.FailJson(400, "配置键 key 不能为空");
            return;
        }
        SysConfig cfg = await _configDao.ByKey(key);
        if (cfg == null) {
            this.OkJson("null");
            return;
        }
        JsonValue item = JsonValue.NewObject();
        item.PutInt("id", cfg.id);
        item.PutStr("key", cfg.key);
        item.PutStr("value", cfg.value);
        item.PutStr("description", cfg.description);
        item.PutInt("updatedAt", cfg.updatedAt);
        this.OkJson(item.ToJson());
    }

    /// POST /api/config/set - 设置或更新配置项
    public async void Set() {
        string key = this.In("key");
        string val = this.In("value");
        string desc = this.In("description");
        if (key == null || key.Length == 0) {
            this.FailJson(400, "配置键 key 不能为空");
            return;
        }
        await _configDao.SetValue(key, val != null ? val : "", desc != null ? desc : "");
        this.OkJson("{\"success\":true}");
    }

    /// POST /api/config/delete - 删除配置项
    public async void Delete() {
        string key = this.In("key");
        if (key == null || key.Length == 0) {
            this.FailJson(400, "配置键 key 不能为空");
            return;
        }
        await _configDao.Delete(key);
        this.OkJson("{\"success\":true}");
    }
}
