using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Protocol;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Controller;

/// 系统配置管理控制器
[Route("api/system/config/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("系统配置")]
class ConfigController : WebController {
    private SysConfigDao ConfigDao() { return new SysConfigDao(this.__Conn()); }

    /// PUT or GET /api/system/config/conf - 对接 adminUI ZanTable 表格元数据配置
    [HttpGet]
    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("配置表格配置")]
    public void Conf() {
        TableConfig tc = new TableConfig();
        tc.conf.title = "系统配置";
        tc.conf.pageSize = 50;

        tc.columns.Add(new TableColumn("id", "ID", 70));
        tc.columns.Add(new TableColumn("key", "配置参数键名", 180));
        tc.columns.Add(new TableColumn("value", "配置值", 220));
        tc.columns.Add(new TableColumn("description", "参数描述", 240));
        tc.columns.Add(new TableColumn("updatedAt", "更新时间", 160));

        tc.filters.Add(new TableFilter("key", "键名", "text"));

        this.OkJson(tc.ToJson());
    }

    /// POST /api/system/config/list - 对接 adminUI getListAsync 列表查询
    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("列表查询")]
    public async void List() {
        this.All();
    }

    /// GET /api/system/config/all - 获取全部配置项
    [HttpGet]
    [Custom(IsMenu = true, Perm = PermBit.View)]
    [Description("全部配置")]
    public async void All() {
        List<SysConfig> list = await this.ConfigDao().All();
        JsonValue arr = JsonValue.NewArray();
        if (list != null) {
            for (int i = 0; i < list.Count; i++) {
                SysConfig cfg = list[i];
                JsonValue item = JsonValue.NewObject();
                item.PutInt("id", cfg.id);
                item.PutStr("key", cfg.key);
                item.PutStr("value", cfg.value);
                item.PutStr("description", cfg.description);
                item.PutInt("updatedAt", cfg.updatedAt);
                arr.Append(item);
            }
        }
        this.OkJson(arr.ToJson());
    }

    /// GET /api/system/config/get - 获取单个配置项
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("获取配置")]
    public async void Get() {
        string key = this.In("key");
        if (key == null || key.Length == 0) {
            this.FailJson(400, "配置键 key 不能为空");
            return;
        }
        SysConfig cfg = await this.ConfigDao().ByKey(key);
        if (cfg == null) {
            this.OkJson("null");
            return;
        }
        JsonValue item = JsonValue.NewObject();
        item.PutInt("id", cfg.id);
        item.PutStr("key", cfg.key);
        item.PutStr("value", cfg.value);
        item.PutStr("description", cfg.description);
        item.PutInt("updatedAt", cfg.updatedAt);
        this.OkJson(item.ToJson());
    }

    /// POST /api/system/config/set - 设置或更新配置项
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("设置配置")]
    public async void Set() {
        string key = this.In("key");
        string val = this.In("value");
        string desc = this.In("description");
        if (key == null || key.Length == 0) {
            this.FailJson(400, "配置键 key 不能为空");
            return;
        }
        await this.ConfigDao().SetValue(key, val != null ? val : "", desc != null ? desc : "");
        this.OkJson("{\"success\":true}");
    }

    /// POST /api/system/config/delete - 删除配置项
    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除配置")]
    public async void Delete() {
        string key = this.In("key");
        if (key == null || key.Length == 0) {
            this.FailJson(400, "配置键 key 不能为空");
            return;
        }
        await this.ConfigDao().Delete(key);
        this.OkJson("{\"success\":true}");
    }
}
