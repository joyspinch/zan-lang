using System;
using System.Data.Orm;

namespace Zan.Web.Modules.System.Model;

/// 系统菜单与权限节点实体（与 sys_menu 1:1:1 映射）
[Table(Name = "sys_menu")]
class SysMenu {
    [Column(IsIdentity = true)]
    public int id;

    /// 节点路径或路由（如 /system/users）
    [Column(StringLength = 128, IsNullable = false)]
    public string node;

    /// 父级节点路径
    [Column(StringLength = 128)]
    public string parentNode;

    /// 菜单标题
    [Column(StringLength = 64, IsNullable = false)]
    public string title;

    /// 前端组件路径（如 view/system/users/index.vue）
    [Column(StringLength = 128)]
    public string component;

    /// 图标标识
    [Column(StringLength = 64)]
    public string icon;

    /// 访问 URL
    [Column(StringLength = 128)]
    public string path;

    /// 排序权重（数字越小越靠前）
    public int rank;

    /// 是否在侧边栏隐藏（0: 显示, 1: 隐藏）
    public int hidden;

    /// 状态（1: 启用, 0: 禁用）
    public int status;
}
