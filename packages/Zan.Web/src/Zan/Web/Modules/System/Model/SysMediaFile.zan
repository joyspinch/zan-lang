using System;
using System.Data.Orm;

namespace Zan.Web.Modules.System.Model;

/// 媒体与文件资产实体
[Table(Name = "sys_media_file")]
class SysMediaFile {
    [Id(AutoIncrement = true)]
    public int id = 0;

    /// 原始文件名
    [Column(Name = "name", Length = 255)]
    public string name = "";

    /// 存储相对路径/URL
    [Column(Name = "path", Length = 512)]
    public string path = "";

    /// 文件扩展名 (无点小写，如 png, jpg, pdf)
    [Column(Name = "ext", Length = 32)]
    public string ext = "";

    /// 文件大小（字节）
    [Column(Name = "size")]
    public long size = 0;

    /// 上传者用户账号
    [Column(Name = "uploaded_by", Length = 64)]
    public string uploadedBy = "";

    /// 创建时间戳 (Unix 秒)
    [Column(Name = "created_at")]
    public long createdAt = 0;
}
