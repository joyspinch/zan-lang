using System;
using System.Data.Orm;

namespace Zan.Web.Modules.System.Model;

/// 定时任务实体
[Table(Name = "sys_job")]
class SysJob {
    [Id(AutoIncrement = true)]
    public int id = 0;

    /// 任务名称
    [Column(Name = "name", Length = 64)]
    public string name = "";

    /// 任务类型/执行标识
    [Column(Name = "kind", Length = 64)]
    public string kind = "";

    /// 执行间隔（秒）
    [Column(Name = "interval_sec")]
    public int intervalSec = 60;

    /// 任务执行参数 JSON
    [Column(Name = "param_json", Length = 512)]
    public string paramJson = "";

    /// 累计执行次数
    [Column(Name = "run_count")]
    public int runCount = 0;

    /// 启停状态（1 启用，0 停用）
    [Column(Name = "enabled")]
    public int enabled = 1;

    /// 最后一次运行时间戳 (Unix 秒)
    [Column(Name = "last_run_at")]
    public long lastRunAt = 0;

    /// 最后一次耗时 (毫秒)
    [Column(Name = "last_ms")]
    public int lastMs = 0;

    /// 最后一次是否成功（1 成功，0 失败）
    [Column(Name = "last_ok")]
    public int lastOk = 1;

    /// 最后一次执行消息
    [Column(Name = "last_message", Length = 255)]
    public string lastMessage = "";
}
