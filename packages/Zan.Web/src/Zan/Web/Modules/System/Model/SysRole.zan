using System;
using System.Data.Orm;

namespace Zan.Web.Modules.System.Model;

/// 系统角色实体（与 sys_role 表 1:1:1 强类型同构）
[Table(Name = "sys_role")]
class SysRole {
    [Column(IsIdentity = true)]
    public int id;

    [Column(StringLength = 64, IsNullable = false)]
    public string name;

    [Column(StringLength = 255)]
    public string intro;

    public int status;

    public long createdAt;

    public long updatedAt;
}
