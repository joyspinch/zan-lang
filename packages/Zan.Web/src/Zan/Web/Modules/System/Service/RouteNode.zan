using System;
using System.Collections.Generic;
using System.Json;

namespace Zan.Web.Modules.System.Service;

/// 菜单元信息（契合 adminUI 前端路由协议）
class RouteNodeMeta {
    public bool hidden = false;
    public bool keepAlive = true;
    public bool showLink = true;
    public int rank = 0;
    public string type = "";
    public string routeKey = "";
    public string title = "";
    public string icon = "";

    public JsonValue ToJsonValue() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutBool("hidden", hidden);
        obj.PutBool("keepAlive", keepAlive);
        obj.PutBool("showLink", showLink);
        obj.PutInt("rank", rank);
        obj.PutStr("type", type);
        obj.PutStr("routeKey", routeKey);
        obj.PutStr("title", title);
        obj.PutStr("icon", icon);
        return obj;
    }

    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}

/// 动态路由树节点（契合 adminUI 前端路由树结构）
class RouteNode {
    public string path = "";
    public string parentPath = "";
    public string name = "";
    public int rank = 99;
    public string component = "";
    public RouteNodeMeta meta = new RouteNodeMeta();
    public List<RouteNode> children = new List<RouteNode>();

    public JsonValue ToJsonValue() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutStr("path", path);
        obj.PutStr("parentPath", parentPath);
        obj.PutStr("name", name);
        obj.PutInt("rank", rank);
        obj.PutStr("component", component);
        obj.Put("meta", meta != null ? meta.ToJsonValue() : JsonValue.NewObject());
        JsonValue ch = JsonValue.NewArray();
        if (children != null) {
            for (int i = 0; i < children.Count; i++) {
                ch.Append(children[i].ToJsonValue());
            }
        }
        obj.Put("children", ch);
        return obj;
    }

    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}
