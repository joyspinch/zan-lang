using System;
using System.Collections.Generic;
using System.Data;
using System.Web;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;

namespace Zan.Web.Modules.System.Service;

/// 路由特性驱动的动态菜单同步器与构建器
/// 彻底解耦硬编码菜单：依据控制器的 [Route]、[Custom(IsMenu = true)]、[Description] 动态推导菜单层级与权限挂载
class SysMenuSync {

    /// 获取分组显示标签与图标
    public static string GroupTitle(string seg) {
        if (seg == "system") { return "系统管理"; }
        if (seg == "monitor") { return "运行监控"; }
        if (seg == "dev") { return "研发工具"; }
        if (seg == "content") { return "内容管理"; }
        if (seg == "finance") { return "财务管理"; }
        return MenuBuilder.Label(seg);
    }

    public static string GroupIcon(string seg) {
        if (seg == "system") { return "Setting"; }
        if (seg == "monitor") { return "Monitor"; }
        if (seg == "dev") { return "Cpu"; }
        return "Folder";
    }

    public static string DefaultIcon(string seg) {
        if (seg == "user") { return "User"; }
        if (seg == "role") { return "Lock"; }
        if (seg == "menu") { return "Menu"; }
        if (seg == "dept") { return "OfficeBuilding"; }
        if (seg == "dict") { return "Collection"; }
        if (seg == "config") { return "Tools"; }
        if (seg == "log") { return "Document"; }
        if (seg == "stat") { return "TrendCharts"; }
        if (seg == "dashboard") { return "PieChart"; }
        if (seg == "curd") { return "MagicStick"; }
        return "Document";
    }

    public static int GroupRank(string seg) {
        if (seg == "system") { return 1; }
        if (seg == "monitor") { return 2; }
        if (seg == "dev") { return 3; }
        return 10;
    }

    /// 从运行时路由表将声明的菜单节点动态同步入数据库 sys_menu 与 sys_role_menu
    public static async bool SyncFromRouter(IDbConnection db, WebApp app, int superRoleId) {
        if (db == null || app == null) {
            return false;
        }

        List<Route> routes = app.router.All();
        if (routes == null || routes.Count == 0) {
            return false;
        }

        SysMenuDao menuDao = new SysMenuDao(db);
        SysRoleMenuDao roleMenuDao = new SysRoleMenuDao(db);
        List<SysMenu> existing = await menuDao.All();
        Dict<string, SysMenu> existMap = new Dict<string, SysMenu>();
        if (existing != null) {
            for (int i = 0; i < existing.Count; i++) {
                existMap[existing[i].node] = existing[i];
            }
        }

        List<int> superRoleMenuIds = await roleMenuDao.GetMenuIdsByRoleId(superRoleId);
        Dict<int, bool> roleMenuMap = new Dict<int, bool>();
        if (superRoleMenuIds != null) {
            for (int i = 0; i < superRoleMenuIds.Count; i++) {
                roleMenuMap[superRoleMenuIds[i]] = true;
            }
        }

        for (int i = 0; i < routes.Count; i++) {
            Route r = routes[i];
            if (!r.inMenu) { continue; }
            if (r.method != "GET") { continue; }

            List<string> segs = MenuBuilder.Body(r.pattern);
            if (segs.Count < 2) { continue; }

            string gNode = segs[0];
            string cNode = segs[1];
            string cPath = "/" + gNode + "/" + cNode;

            // 1. 同步一级分组节点
            int gId = 0;
            if (existMap.ContainsKey(gNode)) {
                gId = existMap[gNode].id;
            } else {
                SysMenu gm = new SysMenu();
                gm.node = gNode;
                gm.parentNode = "";
                gm.title = GroupTitle(gNode);
                gm.component = "";
                gm.icon = GroupIcon(gNode);
                gm.path = "/" + gNode;
                gm.rank = GroupRank(gNode);
                gm.hidden = 0;
                gm.status = 1;
                gId = await menuDao.Insert(gm);
                gm.id = gId;
                existMap[gNode] = gm;
            }

            if (gId > 0 && superRoleId > 0 && !roleMenuMap.ContainsKey(gId)) {
                SysRoleMenu srm = new SysRoleMenu();
                srm.roleId = superRoleId;
                srm.menuId = gId;
                await db.Insert<SysRoleMenu>(srm).ExecuteAffrowsAsync();
                roleMenuMap[gId] = true;
            }

            // 2. 同步二级功能页面节点
            string title = r.title;
            if (title == null || title.Length == 0) {
                title = MenuBuilder.Label(cNode);
            }
            string icon = r.meta.Has("Icon") ? r.meta.Get("Icon") : DefaultIcon(cNode);
            string comp = r.meta.Has("Component") ? r.meta.Get("Component") : "view/vlist/index.vue";

            int cId = 0;
            if (existMap.ContainsKey(cNode)) {
                cId = existMap[cNode].id;
            } else {
                SysMenu cm = new SysMenu();
                cm.node = cNode;
                cm.parentNode = gNode;
                cm.title = title;
                cm.component = comp;
                cm.icon = icon;
                cm.path = cPath;
                cm.rank = i + 1;
                cm.hidden = 0;
                cm.status = 1;
                cId = await menuDao.Insert(cm);
                cm.id = cId;
                existMap[cNode] = cm;
            }

            if (cId > 0 && superRoleId > 0 && !roleMenuMap.ContainsKey(cId)) {
                SysRoleMenu srm = new SysRoleMenu();
                srm.roleId = superRoleId;
                srm.menuId = cId;
                await db.Insert<SysRoleMenu>(srm).ExecuteAffrowsAsync();
                roleMenuMap[cId] = true;
            }
        }

        return true;
    }

    /// 纯内存模式：直接从运行时路由反射构建 RouteNode 路由树（零 DB 依赖，配置驱动）
    public static List<RouteNode> BuildFromRouter(WebApp app, int roleId) {
        List<RouteNode> roots = new List<RouteNode>();
        if (app == null) { return roots; }

        List<Route> routes = app.router.All();
        if (routes == null || routes.Count == 0) { return roots; }

        Dict<string, RouteNode> groupMap = new Dict<string, RouteNode>();

        for (int i = 0; i < routes.Count; i++) {
            Route r = routes[i];
            if (!r.inMenu) { continue; }
            if (r.method != "GET") { continue; }

            List<string> segs = MenuBuilder.Body(r.pattern);
            if (segs.Count < 2) { continue; }

            string gNode = segs[0];
            string cNode = segs[1];

            RouteNode group;
            if (groupMap.ContainsKey(gNode)) {
                group = groupMap[gNode];
            } else {
                group = new RouteNode();
                group.path = gNode;
                group.parentPath = "";
                group.name = GroupTitle(gNode);
                group.rank = GroupRank(gNode);
                group.component = "";

                RouteNodeMeta gMeta = new RouteNodeMeta();
                gMeta.title = GroupTitle(gNode);
                gMeta.icon = GroupIcon(gNode);
                gMeta.rank = GroupRank(gNode);
                gMeta.routeKey = gNode;
                gMeta.showLink = true;
                group.meta = gMeta;

                groupMap[gNode] = group;
                roots.Add(group);
            }

            string title = r.title;
            if (title == null || title.Length == 0) {
                title = MenuBuilder.Label(cNode);
            }
            string icon = r.meta.Has("Icon") ? r.meta.Get("Icon") : DefaultIcon(cNode);
            string comp = r.meta.Has("Component") ? r.meta.Get("Component") : "view/vlist/index.vue";

            RouteNode child = new RouteNode();
            child.path = cNode;
            child.parentPath = gNode;
            child.name = title;
            child.rank = i + 1;
            child.component = comp;

            RouteNodeMeta cMeta = new RouteNodeMeta();
            cMeta.title = title;
            cMeta.icon = icon;
            cMeta.rank = i + 1;
            cMeta.routeKey = cNode;
            cMeta.showLink = true;
            child.meta = cMeta;

            group.children.Add(child);
        }

        return roots;
    }
}
