using System;
using System.Collections.Generic;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Generator.Model;
using Zan.Web.Generator.Dao;
using Zan.Web.Protocol;

namespace Zan.Web.Generator;

/// CURD 生成器控制器：对接 adminUI CurdForm.vue 及代码生成触发
[Route("SysAdmin/Make/[controller]/[action]")]
class CurdController : WebController {
    SysCurdDao dao = new SysCurdDao();

    /// 1. 列表配置：提供管理 sys_curd 本身所需的 ZanTable 配置
    [HttpPut]
    public void Conf() {
        TableConfig conf = new TableConfig();
        conf.conf.innerKey = "id";
        conf.conf.innerName = "title";

        conf.columns.Add(new TableColumn("id", "ID", 80));
        conf.columns.Add(new TableColumn("node", "节点", 200, TableColumnType.Input, true));
        conf.columns.Add(new TableColumn("title", "标题", 180, TableColumnType.Input, true));
        conf.columns.Add(new TableColumn("table1", "主表", 150, TableColumnType.Input, false));
        conf.columns.Add(new TableColumn("rank", "排序", 80, TableColumnType.Input, true));
        conf.columns.Add(new TableColumn("status", "状态", 90, TableColumnType.Switch, true));

        // 操作栏按钮
        TableColumnButton btnMake = new TableColumnButton("生成代码", "id", "make", "600px", "400px", "生成代码", TableButtonType.Primary, false);
        conf.tools.Add(btnMake);

        this.OkJson(conf.ToJson());
    }

    /// 2. 分页数据查询
    [HttpPost]
    public async void List() {
        PostData p = this.ReadPostData();
        int total = 0;
        List<SysCurd> rows = await this.dao.Page(p.page, p.pageSize, out total);
        this.OkJson("{\"total\":" + Convert.ToString(total) + "}");
    }

    /// 3. 新增保存
    [HttpPost]
    public async void AddSave() {
        SysCurd curd = new SysCurd();
        curd.node = this.In("node");
        curd.title = this.In("title");
        curd.table1 = this.In("table1");
        curd.table2 = this.In("table2");
        curd.table3 = this.In("table3");
        curd.table4 = this.In("table4");
        curd.table5 = this.In("table5");
        curd.rank = this.InInt("rank", 10);
        curd.status = 1;
        curd.createdAt = DateTime.Now().ToUnixSeconds();
        curd.updatedAt = curd.createdAt;

        int newId = await this.dao.Insert(curd);
        this.OkJson(Convert.ToString(newId));
    }

    /// 4. 编辑获取
    [HttpPost]
    public async void Edit() {
        int id = this.InInt("id", 0);
        SysCurd curd = await this.dao.ById(id);
        if (curd == null) {
            this.FailJson(404, "记录不存在");
            return;
        }
        this.OkJson("{\"id\":" + Convert.ToString(curd.id) + ",\"title\":\"" + curd.title + "\"}");
    }

    /// 5. 快速修改字段
    [HttpPost]
    public async void Field() {
        int id = this.InInt("id", 0);
        string field = this.In("field");
        string value = this.In("value");
        int rows = await this.dao.SetField(id, field, value);
        this.OkJson(Convert.ToString(rows));
    }

    /// 6. 删除
    [HttpPost]
    public async void Delete() {
        int id = this.InInt("id", 0);
        int rows = await this.dao.Delete(id);
        this.OkJson(Convert.ToString(rows));
    }

    /// 7. 触发生成代码
    [HttpPost]
    public async void Make() {
        int id = this.InInt("id", 0);
        SysCurd curd = await this.dao.ById(id);
        if (curd == null) {
            this.FailJson(404, "CURD 配置不存在");
            return;
        }

        string outputRoot = "src"; // 默认生成至项目源码目录
        bool ok = CodeGenerator.Generate(curd, outputRoot);
        if (ok) {
            this.OkJson("true");
        } else {
            this.FailJson(500, "代码生成失败");
        }
    }
}
