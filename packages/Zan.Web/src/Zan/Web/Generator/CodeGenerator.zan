using System;
using System.Collections.Generic;
using System.IO;
using System.Text;
using Zan.Web.Generator.Model;

namespace Zan.Web.Generator;

/// 代码生成引擎：根据 SysCurd 元数据生成 1:1:1 的原生 Zan 代码（Model/Dao/Controller）
class CodeGenerator {
    /// 一键生成 Model、Dao、Controller 三层同构代码
    public static bool Generate(SysCurd curd, string outputRoot) {
        if (curd == null || curd.node == null || curd.node.Length == 0) {
            return false;
        }

        string node = curd.node.Replace("/", "\\");
        List<string> parts = node.Split('\\');
        string entityName = parts[parts.Count - 1];
        
        string moduleNamespace = "App";
        if (parts.Count > 1) {
            StringBuilder sbNs = new StringBuilder();
            for (int i = 0; i < parts.Count - 1; i = i + 1) {
                if (i > 0) { sbNs.Append("."); }
                sbNs.Append(parts[i]);
            }
            moduleNamespace = sbNs.ToString();
        }

        string tableName = curd.table1;
        if (tableName == null || tableName.Length == 0) {
            tableName = entityName.ToLower();
        }

        // 1. 生成 Model
        string modelCode = GenerateModel(moduleNamespace, entityName, tableName, curd.title);
        string modelDir = Path.Combine(outputRoot, "Model");
        if (parts.Count > 1) {
            modelDir = Path.Combine(modelDir, parts[0]);
        }
        if (!Directory.Exists(modelDir)) {
            Directory.CreateDirectoryRecursive(modelDir);
        }
        File.WriteAllText(Path.Combine(modelDir, entityName + ".zan"), modelCode);

        // 2. 生成 Dao
        string daoCode = GenerateDao(moduleNamespace, entityName, tableName);
        string daoDir = Path.Combine(outputRoot, "Dao");
        if (parts.Count > 1) {
            daoDir = Path.Combine(daoDir, parts[0]);
        }
        if (!Directory.Exists(daoDir)) {
            Directory.CreateDirectoryRecursive(daoDir);
        }
        File.WriteAllText(Path.Combine(daoDir, entityName + "Dao.zan"), daoCode);

        // 3. 生成 Controller
        string controllerCode = GenerateController(moduleNamespace, entityName, tableName, curd);
        string controllerDir = Path.Combine(outputRoot, "Controller");
        if (parts.Count > 1) {
            controllerDir = Path.Combine(controllerDir, parts[0]);
        }
        if (!Directory.Exists(controllerDir)) {
            Directory.CreateDirectoryRecursive(controllerDir);
        }
        File.WriteAllText(Path.Combine(controllerDir, entityName + "Controller.zan"), controllerCode);

        return true;
    }

    /// 生成原生 Zan ORM 实体代码
    static string GenerateModel(string ns, string entityName, string tableName, string title) {
        StringBuilder sb = new StringBuilder();
        sb.Append("using System;\n");
        sb.Append("using System.Data.Orm;\n\n");
        sb.Append("namespace " + ns + ".Model;\n\n");
        sb.Append("/// " + title + " 实体模型（对应 " + tableName + " 表）\n");
        sb.Append("[Table(Name = \"" + tableName + "\")]\n");
        sb.Append("class " + entityName + " {\n");
        sb.Append("    [Column(IsIdentity = true)]\n");
        sb.Append("    public int id;\n\n");
        sb.Append("    [Column(StringLength = 128, IsNullable = false)]\n");
        sb.Append("    public string name;\n\n");
        sb.Append("    public int status;\n");
        sb.Append("    public long createdAt;\n");
        sb.Append("    public long updatedAt;\n");
        sb.Append("}\n");
        return sb.ToString();
    }

    /// 生成原生 Zan 数据网关 DAO 代码
    static string GenerateDao(string ns, string entityName, string tableName) {
        StringBuilder sb = new StringBuilder();
        sb.Append("using System;\n");
        sb.Append("using System.Collections.Generic;\n");
        sb.Append("using System.Data.Orm;\n");
        sb.Append("using Zan.Web.Core;\n");
        sb.Append("using " + ns + ".Model;\n\n");
        sb.Append("namespace " + ns + ".Dao;\n\n");
        sb.Append("/// " + entityName + " 领域数据访问网关（全异步、强类型 ORM）\n");
        sb.Append("class " + entityName + "Dao {\n");
        sb.Append("    public async " + entityName + " ById(int id) {\n");
        sb.Append("        return await Db.Connection().Select<" + entityName + ">().Where(a => a.id == id).FirstAsync();\n");
        sb.Append("    }\n\n");
        sb.Append("    public async List<" + entityName + "> Page(int page, int pageSize, out int total) {\n");
        sb.Append("        total = await Db.Connection().Select<" + entityName + ">().CountAsync();\n");
        sb.Append("        return await Db.Connection().Select<" + entityName + ">()\n");
        sb.Append("            .OrderByDescending(a => a.id)\n");
        sb.Append("            .Page(page, pageSize)\n");
        sb.Append("            .ToListAsync();\n");
        sb.Append("    }\n\n");
        sb.Append("    public async int Insert(" + entityName + " entity) {\n");
        sb.Append("        return await Db.Connection().Insert<" + entityName + ">(entity).ExecuteIdentityAsync();\n");
        sb.Append("    }\n\n");
        sb.Append("    public async int Update(" + entityName + " entity) {\n");
        sb.Append("        return await Db.Connection().Update<" + entityName + ">()\n");
        sb.Append("            .Set(a => a.name, entity.name)\n");
        sb.Append("            .Set(a => a.status, entity.status)\n");
        sb.Append("            .Set(a => a.updatedAt, entity.updatedAt)\n");
        sb.Append("            .Where(a => a.id == entity.id)\n");
        sb.Append("            .ExecuteAffrowsAsync();\n");
        sb.Append("    }\n\n");
        sb.Append("    public async int SetField(int id, string field, string value) {\n");
        sb.Append("        if (field == \"status\") {\n");
        sb.Append("            return await Db.Connection().Update<" + entityName + ">()\n");
        sb.Append("                .Set(a => a.status, Convert.ToInt(value))\n");
        sb.Append("                .Where(a => a.id == id)\n");
        sb.Append("                .ExecuteAffrowsAsync();\n");
        sb.Append("        }\n");
        sb.Append("        return 0;\n");
        sb.Append("    }\n\n");
        sb.Append("    public async int Delete(int id) {\n");
        sb.Append("        return await Db.Connection().Delete<" + entityName + ">().Where(a => a.id == id).ExecuteAffrowsAsync();\n");
        sb.Append("    }\n");
        sb.Append("}\n");
        return sb.ToString();
    }

    /// 生成原生 Zan 控制器代码（对齐 adminUI ZanTable 协议）
    static string GenerateController(string ns, string entityName, string tableName, SysCurd curd) {
        StringBuilder sb = new StringBuilder();
        sb.Append("using System;\n");
        sb.Append("using System.Collections.Generic;\n");
        sb.Append("using System.Web;\n");
        sb.Append("using Zan.Web.Core;\n");
        sb.Append("using Zan.Web.Protocol;\n");
        sb.Append("using " + ns + ".Model;\n");
        sb.Append("using " + ns + ".Dao;\n\n");
        sb.Append("namespace " + ns + ".Controller;\n\n");
        sb.Append("/// " + curd.title + " 控制器（对齐 adminUI ZanTable 10大标准端点）\n");
        sb.Append("class " + entityName + "Controller : WebController {\n");
        sb.Append("    " + entityName + "Dao dao = new " + entityName + "Dao();\n\n");

        // 1. Conf
        sb.Append("    [HttpPut]\n");
        sb.Append("    public void Conf() {\n");
        sb.Append("        TableConfig conf = new TableConfig();\n");
        sb.Append("        conf.conf.innerKey = \"id\";\n");
        sb.Append("        conf.conf.innerName = \"name\";\n");
        sb.Append("        conf.columns.Add(new TableColumn(\"id\", \"ID\", 80));\n");
        sb.Append("        conf.columns.Add(new TableColumn(\"name\", \"名称\", 150, TableColumnType.Input, true));\n");
        sb.Append("        conf.columns.Add(new TableColumn(\"status\", \"状态\", 100, TableColumnType.Switch, true));\n");
        sb.Append("        this.OkJson(conf.ToJson());\n");
        sb.Append("    }\n\n");

        // 2. List
        sb.Append("    [HttpPost]\n");
        sb.Append("    public async void List() {\n");
        sb.Append("        PostData p = this.ReadPostData();\n");
        sb.Append("        int total = 0;\n");
        sb.Append("        List<" + entityName + "> list = await this.dao.Page(p.page, p.pageSize, out total);\n");
        sb.Append("        this.OkJson(\"{\\\"rows\\\":[],\\\"total\\\":\" + Convert.ToString(total) + \"}\");\n");
        sb.Append("    }\n\n");

        // 3. Field
        sb.Append("    [HttpPost]\n");
        sb.Append("    public async void Field() {\n");
        sb.Append("        int id = this.InInt(\"id\", 0);\n");
        sb.Append("        string field = this.In(\"field\");\n");
        sb.Append("        string value = this.In(\"value\");\n");
        sb.Append("        int affrows = await this.dao.SetField(id, field, value);\n");
        sb.Append("        this.OkJson(Convert.ToString(affrows));\n");
        sb.Append("    }\n\n");

        // 4. Delete
        sb.Append("    [HttpPost]\n");
        sb.Append("    public async void Delete() {\n");
        sb.Append("        int id = this.InInt(\"id\", 0);\n");
        sb.Append("        int affrows = await this.dao.Delete(id);\n");
        sb.Append("        this.OkJson(Convert.ToString(affrows));\n");
        sb.Append("    }\n");

        sb.Append("}\n");
        return sb.ToString();
    }
}
