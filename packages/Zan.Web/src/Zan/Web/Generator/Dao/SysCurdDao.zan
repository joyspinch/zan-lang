using System;
using System.Collections.Generic;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Generator.Model;

namespace Zan.Web.Generator.Dao;

/// CURD 记录数据访问网关（全异步、强类型原生 ORM）
class SysCurdDao {
    public async SysCurd ById(int id) {
        return await Db.Connection().Select<SysCurd>().Where(a => a.id == id).FirstAsync();
    }

    public async SysCurd ByNode(string node) {
        return await Db.Connection().Select<SysCurd>().Where(a => a.node == node).FirstAsync();
    }

    public async List<SysCurd> Page(int page, int pageSize, out int total) {
        total = await Db.Connection().Select<SysCurd>().CountAsync();
        return await Db.Connection().Select<SysCurd>()
            .OrderByDescending(a => a.id)
            .Page(page, pageSize)
            .ToListAsync();
    }

    public async int Insert(SysCurd curd) {
        return await Db.Connection().Insert<SysCurd>(curd).ExecuteIdentityAsync();
    }

    public async int Update(SysCurd curd) {
        return await Db.Connection().Update<SysCurd>()
            .Set(a => a.node, curd.node)
            .Set(a => a.title, curd.title)
            .Set(a => a.table1, curd.table1)
            .Set(a => a.table2, curd.table2)
            .Set(a => a.table3, curd.table3)
            .Set(a => a.table4, curd.table4)
            .Set(a => a.table5, curd.table5)
            .Set(a => a.conf, curd.conf)
            .Set(a => a.columns, curd.columns)
            .Set(a => a.actionForms, curd.actionForms)
            .Set(a => a.filter, curd.filter)
            .Set(a => a.filterRight, curd.filterRight)
            .Set(a => a.tools, curd.tools)
            .Set(a => a.buttons, curd.buttons)
            .Set(a => a.rank, curd.rank)
            .Set(a => a.icon, curd.icon)
            .Set(a => a.status, curd.status)
            .Set(a => a.updatedAt, curd.updatedAt)
            .Where(a => a.id == curd.id)
            .ExecuteAffrowsAsync();
    }

    public async int SetField(int id, string field, string value) {
        if (field == "status") {
            return await Db.Connection().Update<SysCurd>()
                .Set(a => a.status, Convert.ToInt(value))
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
        }
        if (field == "rank") {
            return await Db.Connection().Update<SysCurd>()
                .Set(a => a.rank, Convert.ToInt(value))
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
        }
        return 0;
    }

    public async int Delete(int id) {
        return await Db.Connection().Delete<SysCurd>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
