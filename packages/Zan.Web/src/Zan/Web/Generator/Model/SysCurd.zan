using System.Data.Orm;

namespace Zan.Web.Generator.Model;

/// CURD 生成器元数据记录表模型（对应 sys_curd 表）
[Table(Name = "sys_curd")]
class SysCurd {
    [Column(IsIdentity = true)]
    public int id;

    /// 节点名称（如 SysAdmin\Users\User）
    [Column(StringLength = 128, IsNullable = false)]
    public string node;

    /// 功能标题（如 用户管理）
    [Column(StringLength = 128, IsNullable = false)]
    public string title;

    /// 主表名（如 sys_user）
    [Column(StringLength = 64, IsNullable = false)]
    public string table1;

    /// 关联表1
    [Column(StringLength = 64)]
    public string table2;

    /// 关联表2
    [Column(StringLength = 64)]
    public string table3;

    /// 关联表3
    [Column(StringLength = 64)]
    public string table4;

    /// 关联表4
    [Column(StringLength = 64)]
    public string table5;

    /// 表格全局配置 JSON
    public string conf;

    /// 列配置 JSON
    public string columns;

    /// 表单配置 JSON
    public string actionForms;

    /// 筛选条件配置 JSON
    public string filter;

    /// 右筛选配置 JSON
    public string filterRight;

    /// 工具栏按钮配置 JSON
    public string tools;

    /// 表头操作按钮配置 JSON
    public string buttons;

    /// 排序权重
    public int rank;

    /// 菜单图标
    [Column(StringLength = 64)]
    public string icon;

    /// 状态（1=启用，0=停用）
    public int status;

    public long createdAt;
    public long updatedAt;
}
