using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;
using Zan.Web.Modules.Dev.Model;
using Zan.Web.Modules.Monitor.Model;

namespace Zan.Web.Seed;

/// 系统基础数据与表结构初始化种子：开箱即用建表、超级管理员初始化、默认菜单与字典注入
class SysSeed {

    /// 自动创建核心系统表结构（基于 ORM CodeFirst，跨数据库方言自动同步并迁移结构）
    public static async bool InitTables(IDbConnection db) {
        if (db == null) { return false; }

        db.SyncStructure<SysUser>();
        db.SyncStructure<SysRole>();
        db.SyncStructure<SysUserRole>();
        db.SyncStructure<SysDepartment>();
        db.SyncStructure<SysMenu>();
        db.SyncStructure<SysRoleMenu>();
        db.SyncStructure<SysDictType>();
        db.SyncStructure<SysDictItem>();
        db.SyncStructure<SysConfig>();
        db.SyncStructure<SysLog>();
        db.SyncStructure<SysCurd>();
        db.SyncStructure<SysApiStat>();
        return true;
    }

    /// 执行全量数据播种（带防重保护：若 sys_user 已有记录则跳过播种）
    public static async bool SeedAll(IDbConnection db) {
        if (db == null) { return false; }
        await InitTables(db);

        long userCount = await db.Select<SysUser>().CountAsync();
        if (userCount > 0) {
            return true;
        }

        long now = DateTime.Now().ToUnixSeconds();

        // 1. 初始化根部门
        SysDepartment dept = new SysDepartment();
        dept.parentId = 0;
        dept.name = "总公司";
        dept.code = "HQ";
        dept.leaderUserId = 1;
        dept.sortOrder = 1;
        dept.status = 1;
        dept.createdAt = now;
        dept.updatedAt = now;
        int deptId = await db.Insert<SysDepartment>(dept).ExecuteIdentityAsync();
        if (deptId <= 0) { deptId = 1; }

        // 2. 初始化超管角色
        SysRole role = new SysRole();
        role.name = "超级管理员";
        role.intro = "系统内置最高权限角色，拥有全部功能与数据权限";
        role.status = 1;
        role.createdAt = now;
        role.updatedAt = now;
        int roleId = await db.Insert<SysRole>(role).ExecuteIdentityAsync();
        if (roleId <= 0) { roleId = 1; }

        // 3. 初始化默认管理员账号 (admin / 123456)
        SysUser admin = new SysUser();
        admin.username = "admin";
        admin.nickname = "超级管理员";
        admin.salt = "zan_salt_888";
        admin.password = SysUserDao.HashPassword("123456", admin.salt);
        admin.email = "admin@zan.org";
        admin.mobile = "18888888888";
        admin.avatar = "";
        admin.status = 1;
        admin.departmentId = deptId;
        admin.createdAt = now;
        admin.updatedAt = now;
        int userId = await db.Insert<SysUser>(admin).ExecuteIdentityAsync();
        if (userId <= 0) { userId = 1; }

        // 4. 绑定超管用户与角色
        SysUserRole ur = new SysUserRole();
        ur.userId = userId;
        ur.roleId = roleId;
        await db.Insert<SysUserRole>(ur).ExecuteIdentityAsync();

        // 5. 初始化菜单节点与权限
        await SeedMenus(db, roleId);

        // 6. 初始化核心字典
        await SeedDicts(db, now);

        // 7. 初始化系统核心配置
        await SeedConfigs(db, now);

        return true;
    }

    private static async void SeedMenus(IDbConnection db, int superRoleId) {
        // 系统管理根节点
        int mSystem = await AddMenu(db, superRoleId, "system", "", "系统管理", "", "Setting", "/system", 1);
        await AddMenu(db, superRoleId, "user", "system", "用户管理", "view/system/user/index.vue", "User", "/system/user", 1);
        await AddMenu(db, superRoleId, "role", "system", "角色管理", "view/system/role/index.vue", "Lock", "/system/role", 2);
        await AddMenu(db, superRoleId, "menu", "system", "菜单管理", "view/system/menu/index.vue", "Menu", "/system/menu", 3);
        await AddMenu(db, superRoleId, "dept", "system", "部门管理", "view/system/dept/index.vue", "OfficeBuilding", "/system/dept", 4);
        await AddMenu(db, superRoleId, "dict", "system", "数据字典", "view/system/dict/index.vue", "Collection", "/system/dict", 5);
        await AddMenu(db, superRoleId, "config", "system", "系统配置", "view/system/config/index.vue", "Tools", "/system/config", 6);
        await AddMenu(db, superRoleId, "log", "system", "操作日志", "view/system/log/index.vue", "Document", "/system/log", 7);

        // 运行监控根节点
        int mMonitor = await AddMenu(db, superRoleId, "monitor", "", "运行监控", "", "Monitor", "/monitor", 2);
        await AddMenu(db, superRoleId, "dashboard", "monitor", "系统概览", "view/monitor/dashboard/index.vue", "PieChart", "/monitor/dashboard", 1);
        await AddMenu(db, superRoleId, "stat", "monitor", "服务指标", "view/monitor/stat/index.vue", "TrendCharts", "/monitor/stat", 2);

        // 研发工具根节点
        int mDev = await AddMenu(db, superRoleId, "dev", "", "研发工具", "", "Cpu", "/dev", 3);
        await AddMenu(db, superRoleId, "curd", "dev", "代码生成", "view/dev/curd/index.vue", "MagicStick", "/dev/curd", 1);
    }

    private static async int AddMenu(IDbConnection db, int roleId, string node, string parentNode, string title, string comp, string icon, string path, int rank) {
        SysMenu m = new SysMenu();
        m.node = node;
        m.parentNode = parentNode;
        m.title = title;
        m.component = comp;
        m.icon = icon;
        m.path = path;
        m.rank = rank;
        m.hidden = 0;
        m.status = 1;
        int mId = await db.Insert<SysMenu>(m).ExecuteIdentityAsync();
        if (mId > 0 && roleId > 0) {
            SysRoleMenu rm = new SysRoleMenu();
            rm.roleId = roleId;
            rm.menuId = mId;
            await db.Insert<SysRoleMenu>(rm).ExecuteIdentityAsync();
        }
        return mId;
    }

    private static async void SeedDicts(IDbConnection db, long now) {
        // 用户性别字典
        SysDictType dtSex = new SysDictType();
        dtSex.code = "sys_user_sex";
        dtSex.name = "用户性别";
        dtSex.description = "用户性别标准枚举";
        dtSex.status = 1;
        dtSex.createdAt = now;
        dtSex.updatedAt = now;
        await db.Insert<SysDictType>(dtSex).ExecuteIdentityAsync();

        await AddDictItem(db, "sys_user_sex", "男", "1", 1, now);
        await AddDictItem(db, "sys_user_sex", "女", "2", 2, now);
        await AddDictItem(db, "sys_user_sex", "未知", "0", 3, now);

        // 启停状态字典
        SysDictType dtStatus = new SysDictType();
        dtStatus.code = "sys_status";
        dtStatus.name = "通用状态";
        dtStatus.description = "系统记录启用与禁用";
        dtStatus.status = 1;
        dtStatus.createdAt = now;
        dtStatus.updatedAt = now;
        await db.Insert<SysDictType>(dtStatus).ExecuteIdentityAsync();

        await AddDictItem(db, "sys_status", "正常", "1", 1, now);
        await AddDictItem(db, "sys_status", "禁用", "0", 2, now);
    }

    private static async void AddDictItem(IDbConnection db, string typeCode, string label, string val, int sort, long now) {
        SysDictItem item = new SysDictItem();
        item.typeCode = typeCode;
        item.label = label;
        item.value = val;
        item.sortOrder = sort;
        item.status = 1;
        item.createdAt = now;
        item.updatedAt = now;
        await db.Insert<SysDictItem>(item).ExecuteIdentityAsync();
    }

    private static async void SeedConfigs(IDbConnection db, long now) {
        await AddConfig(db, "site_name", "Zan.Web 开发框架", "系统站点全称", now);
        await AddConfig(db, "site_version", "1.0.0", "当前服务版本号", now);
        await AddConfig(db, "token_expire", "86400", "用户登录 Token 有效时长（秒）", now);
        await AddConfig(db, "cors_enabled", "true", "是否启用全局跨域支持", now);
    }

    private static async void AddConfig(IDbConnection db, string key, string val, string desc, long now) {
        SysConfig c = new SysConfig();
        c.key = key;
        c.value = val;
        c.description = desc;
        c.updatedAt = now;
        await db.Insert<SysConfig>(c).ExecuteIdentityAsync();
    }
}
