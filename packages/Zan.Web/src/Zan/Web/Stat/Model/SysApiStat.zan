using System;
using System.Data.Orm;

namespace Zan.Web.Stat.Model;

/// API 路由执行统计实体（与 sys_api_stat 表 1:1:1 强类型同构）
[Table(Name = "sys_api_stat")]
class SysApiStat {
    [Column(IsIdentity = true)]
    public int id;

    /// 请求路由/接口路径（如 /api/user/info）
    [Column(StringLength = 128, IsNullable = false)]
    public string route;

    /// 统计日期（格式 YYYYMMDD，如 20260925）
    public int ymd;

    /// 小时区间（0 - 23）
    public int hour;

    /// 请求调用总量
    public int count;

    /// 成功调用次数
    public int successCount;

    /// 失败/异常调用次数
    public int failureCount;

    /// 总耗时（毫秒）
    public long totalMs;

    /// 最小耗时（毫秒）
    public int minMs;

    /// 最大耗时（毫秒）
    public int maxMs;

    /// 记录更新时间戳（秒）
    public long updatedAt;
}
