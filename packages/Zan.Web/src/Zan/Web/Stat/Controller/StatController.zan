using System;
using System.Collections.Generic;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Stat;
using Zan.Web.Stat.Dao;
using Zan.Web.Stat.Model;

namespace Zan.Web.Stat.Controller;

/// 服务端统计监控控制器
class StatController : WebController {
    private SysApiStatDao _apiStatDao = new SysApiStatDao();

    /// GET /api/stat/summary - 服务端实时统计概要（运行时长、QPS、请求量、失败数、平均耗时）
    public void Summary() {
        this.OkJson(ServerStats.GetSummaryJson());
    }

    /// GET /api/stat/apis - 实时 API 路由监控与调用指标排行
    public void Apis() {
        this.OkJson(ServerStats.GetApisJson());
    }

    /// GET /api/stat/slow - 实时慢请求采样队列（>300ms 链路追踪）
    public void Slow() {
        this.OkJson(ServerStats.GetSlowRequestsJson());
    }

    /// GET /api/stat/daily - 查询指定日期的持久化接口统计
    public async void Daily() {
        int ymd = this.InInt("date", 0);
        if (ymd <= 0) {
            DateTime now = DateTime.Now();
            ymd = now.Year() * 10000 + now.Month() * 100 + now.Day();
        }

        List<SysApiStat> list = await _apiStatDao.ByDate(ymd);
        string json = "[";
        for (int i = 0; i < list.Count; i++) {
            if (i > 0) { json += ","; }
            SysApiStat item = list[i];
            json += "{\"id\":" + item.id.ToString()
                + ",\"route\":\"" + item.route + "\""
                + ",\"ymd\":" + item.ymd.ToString()
                + ",\"hour\":" + item.hour.ToString()
                + ",\"count\":" + item.count.ToString()
                + ",\"successCount\":" + item.successCount.ToString()
                + ",\"failureCount\":" + item.failureCount.ToString()
                + ",\"totalMs\":" + item.totalMs.ToString()
                + ",\"minMs\":" + item.minMs.ToString()
                + ",\"maxMs\":" + item.maxMs.ToString()
                + ",\"updatedAt\":" + item.updatedAt.ToString() + "}";
        }
        json += "]";
        this.OkJson(json);
    }
}
