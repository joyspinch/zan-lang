using System;
using System.Data;
using System.Diagnostics;
using System.IO;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Modules.Monitor;
using Zan.Web.Modules.Monitor.Controller;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;
using Zan.Web.Modules.System.Service;
using Zan.Web.Modules.System.Controller;
using Zan.Web.Modules.Dev.Controller;
using Zan.Web.Seed;

namespace Zan.Web.Core;

/// 路由注册委托：供应用层传入编译期生成的 __AttrRoutes.Register(app)
public delegate void WebRouteFn(WebApp app);

/// Zan.Web 统一引导与宿主启动器：开箱即用集成 CORS、全链路指标打点、RBAC 网关与系统数据播种
class WebBoot {
    private static WebRouteFn _routes;
    private static WebApp _app;
    private static IDbConnection _db;
    private static bool _corsEnabled = true;
    private static string _corsOrigin = "*";
    private static int _slowThresholdMs = 300;
    private static string _adminDir = "";
    private static bool _adminMounted = false;

    /// 注册外部业务/自动属性路由挂点
    public static void OnRoutes(WebRouteFn fn) {
        _routes = fn;
    }

    /// 获取运行中的 WebApp 实例
    public static WebApp App() {
        return _app;
    }

    /// 挂载管理端静态前端工程目录（如 adminUI 的 dist 目录）
    public static void MountAdmin(string dir) {
        _adminDir = dir;
        _adminMounted = true;
    }

    /// 设置 CORS 跨域配置
    public static void SetCors(bool enabled, string origin) {
        _corsEnabled = enabled;
        if (origin != null && origin.Length > 0) {
            _corsOrigin = origin;
        }
    }

    /// 设置慢请求告警阈值（毫秒）
    public static void SetSlowThreshold(int ms) {
        if (ms > 0) {
            _slowThresholdMs = ms;
        }
    }

    /// 统一装配并启动 Web 宿主服务
    public static async int Run(string host, int port, IDbConnection db) {
        _db = db;
        if (db != null) {
            Db.SetConnection(db);
            await SysSeed.SeedAll(db);
        }

        if (host == null || host.Length == 0) {
            host = "0.0.0.0";
        }
        if (port <= 0) {
            port = 8080;
        }

        WebApp app = new WebApp(host, port);
        _app = app;
        WebHost.Use(app);

        // 1. CORS 前置过滤器与 OPTIONS 预检请求短路
        app.Before(WebBoot.CorsFilter);

        // 2. 统计全链路耗时与指标
        app.After(WebBoot.MetricsFilter);

        // 3. 安装框架级身份认证解析器 (Token -> uid)
        app.AuthResolver(WebBoot.ResolveAuth);

        // 4. 安装框架级权限门禁解析器 (uid + action -> allow)
        app.PermissionResolver(WebBoot.ResolvePermission);

        // 5. 配置未登录拦截重定向路径
        app.LoginPath("/admin/login");

        // 6. 挂载路由：优先全自动装配编译器生成的属性路由 __AttrRoutes，再执行用户自定义注册
        __AttrRoutes.Register(app);
        if (_routes != null) {
            _routes(app);
        }

        // 7. 全自动挂载 OpenAPI 3.0 规范 (/api/docs.json) 与离线交互文档 UI (/api/docs)
        ApiDocs.Mount(app, "/api/docs");

        // 8. 从路由特性自动同步菜单与超管权限（配置驱动，无须代码硬编码）
        if (db != null) {
            await SysMenuSync.SyncFromRouter(db, app, 1);
        }

        // 9. 挂载管理端静态文件服务 (CSS / JS / Assets) 与页面路由
        app.Before(WebBoot.ServeAdminStatic);
        app.Get("/admin", WebBoot.ServeAdminHome);
        app.Get("/admin/", WebBoot.ServeAdminHome);
        app.Get("/admin/login", WebBoot.ServeAdminLogin);
        app.Post("/admin/login", WebBoot.HandleAdminLogin);
        app.Get("/admin/logout", WebBoot.HandleAdminLogout);
        app.Post("/admin/logout", WebBoot.HandleAdminLogout);
        app.Get("/", WebBoot.ServeRootHome);

        Console.WriteLine("[Zan.Web] Server booting at http://" + host + ":" + Convert.ToString(port));
        return await app.Start();
    }

    /// 便捷启动重载（默认端口 8080）
    public static async int Run(int port) {
        return await Run("0.0.0.0", port, Db.Connection());
    }

    /// 便捷启动重载（带路由表委托）
    public static async int Run(int port, WebRouteFn onRoutes) {
        OnRoutes(onRoutes);
        return await Run("0.0.0.0", port, Db.Connection());
    }

    /// 统一跨域过滤中间件
    private static bool CorsFilter(HttpContext ctx) {
        if (!_corsEnabled || ctx == null) {
            return true;
        }
        ctx.SetHeader("Access-Control-Allow-Origin", _corsOrigin);
        ctx.SetHeader("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS");
        ctx.SetHeader("Access-Control-Allow-Headers", "Authorization, Content-Type, Accept, X-Requested-With, Origin");
        ctx.SetHeader("Access-Control-Max-Age", "86400");

        if (ctx.method == "OPTIONS") {
            ctx.Status(204, "No Content");
            ctx.Text("");
            return false;
        }
        return true;
    }

    /// 统一指标收集后置钩子
    private static void MetricsFilter(HttpContext ctx, long elapsedUs) {
        if (ctx == null) { return; }
        int elapsedMs = (int)(elapsedUs / 1000);
        if (elapsedMs < 0) { elapsedMs = 0; }

        string path = ctx.path;
        string method = ctx.method;
        int status = ctx.status;
        string ip = ctx.RemoteIp();

        ServerStats.Record(path, method, elapsedMs, status, ip);

        if (elapsedMs >= _slowThresholdMs) {
            Console.WriteLine("[Zan.Web][SLOW] " + method + " " + path + " elapsed: " + Convert.ToString(elapsedMs) + "ms");
        }
    }

    /// 身份认证解析器：根据 Token 查询当前登录用户 ID
    private static async string ResolveAuth(string token) {
        if (token == null || token.Length == 0) {
            return "";
        }
        LoginUser u = await TokenService.GetLoginUser(token);
        if (u != null && u.UserID > 0) {
            return Convert.ToString(u.UserID);
        }
        return "";
    }

    /// 权限门禁解析器：判断当前用户是否有权访问 action
    private static async bool ResolvePermission(string uid, string action) {
        if (uid == null || uid.Length == 0) {
            return false;
        }
        // 超级管理员 (UserID == 1) 拥有全部操作权限
        if (uid == "1") {
            return true;
        }
        int userId = Convert.ToInt32(uid);
        if (userId <= 0) {
            return false;
        }

        IDbConnection db = _db != null ? _db : Db.Connection();
        if (db == null) {
            return false;
        }

        // 校验账号状态
        SysUserDao userDao = new SysUserDao(db);
        SysUser user = await userDao.ById(userId);
        if (user == null || user.status != 1) {
            return false;
        }

        // 查询角色并判断权限
        SysUserRoleDao urDao = new SysUserRoleDao(db);
        int roleId = await urDao.GetRoleId(userId);
        if (roleId <= 0) {
            return false;
        }
        if (roleId == 1) {
            return true;
        }

        AuthManager authMgr = new AuthManager(db);
        return await authMgr.CanAccess(roleId, action);
    }

    /// 判断当前 HttpContext 会话是否已完成身份认证
    public static async bool IsAuthenticated(HttpContext ctx) {
        if (ctx == null) { return false; }
        string token = TokenService.ExtractTokenFromContext(ctx);
        if (token == null || token.Length == 0) {
            return false;
        }
        LoginUser u = await TokenService.GetLoginUser(token);
        return u != null && u.UserID > 0;
    }

    /// 管理后台静态资源服务钩子 (/admin/css/*, /admin/js/* 等)
    private static bool ServeAdminStatic(HttpContext ctx) {
        if (ctx == null) { return true; }
        if (ctx.method != "GET" && ctx.method != "HEAD") { return true; }
        string p = ctx.path;
        if (p == null) { return true; }
        if (!p.StartsWith("/admin/css/") && !p.StartsWith("/admin/js/") && !p.StartsWith("/admin/assets/")) {
            return true;
        }
        string adminDir = ResolveAdminDir();
        string rel = p.Substring(7);
        string full = adminDir + "/" + rel;
        if (!File.Exists(full)) {
            return true;
        }
        int size = File.GetSize(full);
        if (size < 0) {
            return true;
        }
        string ext = "";
        int dot = full.LastIndexOf(".");
        if (dot >= 0) {
            ext = full.Substring(dot);
        }
        string ctype = "application/octet-stream";
        if (ext == ".css") { ctype = "text/css; charset=utf-8"; }
        else if (ext == ".js") { ctype = "application/javascript; charset=utf-8"; }
        else if (ext == ".png") { ctype = "image/png"; }
        else if (ext == ".jpg" || ext == ".jpeg") { ctype = "image/jpeg"; }
        else if (ext == ".svg") { ctype = "image/svg+xml"; }
        else if (ext == ".ico") { ctype = "image/x-icon"; }
        else if (ext == ".json") { ctype = "application/json; charset=utf-8"; }

        ctx.SetHeader("Cache-Control", "public, max-age=86400");
        byte[] bytes = File.ReadAllBytes(full);
        ctx.Binary(ctype, bytes, size);
        return false;
    }

    /// 解析管理后台静态资源物理目录
    public static string ResolveAdminDir() {
        if (_adminDir != null && _adminDir.Length > 0) {
            return _adminDir;
        }
        if (File.Exists("wwwroot/admin/index.html")) {
            return "wwwroot/admin";
        }
        if (File.Exists("packages/Zan.Web/wwwroot/admin/index.html")) {
            return "packages/Zan.Web/wwwroot/admin";
        }
        return "wwwroot/admin";
    }

    /// 内置 Admin 单页控制台入口：未登录强制 302 拦截重定向至 /admin/login
    private static async void ServeAdminHome(HttpContext ctx) {
        if (ctx == null) { return; }
        if (!await IsAuthenticated(ctx)) {
            ctx.Redirect("/admin/login");
            return;
        }
        string adminDir = ResolveAdminDir();
        string indexPath = adminDir + "/index.html";
        if (File.Exists(indexPath)) {
            ctx.Html(File.ReadAllText(indexPath));
            return;
        }
        ctx.Status(404, "Not Found").Text("Admin files not found at: " + indexPath);
    }

    /// 管理后台登录页：已登录自动进入控制台，未登录渲染登录界面
    private static async void ServeAdminLogin(HttpContext ctx) {
        if (ctx == null) { return; }
        if (await IsAuthenticated(ctx)) {
            ctx.Redirect("/admin");
            return;
        }
        string adminDir = ResolveAdminDir();
        string loginPath = adminDir + "/login.html";
        if (File.Exists(loginPath)) {
            ctx.Html(File.ReadAllText(loginPath));
            return;
        }
        ctx.Status(404, "Not Found").Text("Login page not found at: " + loginPath);
    }

    /// 管理后台表单/异步登录提交处理
    private static async void HandleAdminLogin(HttpContext ctx) {
        if (ctx == null) { return; }
        string userName = ctx.In("userName");
        if (userName == null || userName.Length == 0) {
            userName = ctx.In("username");
        }
        string password = ctx.In("password");
        if (userName == null || userName.Length == 0 || password == null || password.Length == 0) {
            ctx.Status(400, "Bad Request").Json("{\"code\":400,\"msg\":\"请输入账号和密码\"}");
            return;
        }

        IDbConnection db = _db != null ? _db : Db.Connection();
        if (db == null) {
            ctx.Status(500, "Internal Server Error").Json("{\"code\":500,\"msg\":\"数据库未连接\"}");
            return;
        }

        SysUserDao userDao = new SysUserDao(db);
        SysUser user = await userDao.ByUsername(userName);
        if (user == null) {
            ctx.Status(400, "Bad Request").Json("{\"code\":400,\"msg\":\"账号或密码错误\"}");
            return;
        }
        if (user.status != 1) {
            ctx.Status(403, "Forbidden").Json("{\"code\":403,\"msg\":\"该账号已被停用\"}");
            return;
        }

        bool match = SysUserDao.VerifyPassword(password, user.salt, user.password);
        if (!match) {
            ctx.Status(400, "Bad Request").Json("{\"code\":400,\"msg\":\"账号或密码错误\"}");
            return;
        }

        SysUserRoleDao urDao = new SysUserRoleDao(db);
        int roleId = await urDao.GetRoleId(user.id);
        string roleName = "普通用户";
        if (roleId > 0) {
            SysRoleDao roleDao = new SysRoleDao(db);
            SysRole r = await roleDao.ById(roleId);
            if (r != null && r.name != null && r.name.Length > 0) {
                roleName = r.name;
            }
        }

        LoginUser loginUser = await TokenService.CreateToken(user, roleId > 0 ? roleId : 1, roleName);
        ctx.SetCookie("zsession", loginUser.AccessToken, 604800);
        ctx.SetCookie("token", loginUser.AccessToken, 604800);

        string accept = ctx.Header("Accept");
        if (accept != null && accept.Contains("application/json")) {
            ctx.Json("{\"code\":0,\"msg\":\"success\",\"data\":" + loginUser.ToJson() + "}");
        } else {
            ctx.Redirect("/admin");
        }
    }

    /// 管理后台退出登录
    private static async void HandleAdminLogout(HttpContext ctx) {
        if (ctx == null) { return; }
        string token = TokenService.ExtractTokenFromContext(ctx);
        if (token != null && token.Length > 0) {
            await TokenService.RemoveToken(token);
        }
        ctx.SetCookie("zsession", "", 0);
        ctx.SetCookie("token", "", 0);
        ctx.Redirect("/admin/login");
    }

    /// 根路径重定向至管理后台
    private static async void ServeRootHome(HttpContext ctx) {
        if (ctx == null) { return; }
        ctx.Redirect("/admin");
    }

    /// 编译器按需拉取依赖锚点：确保系统内建控制器进入 AST 闭包并由 GenRoute 自动生成 __AttrRoutes
    private static void __TouchControllers() {
        new AuthController();
        new SysUserController();
        new SysDeptController();
        new SysRoleController();
        new SysMenuController();
        new DictController();
        new ConfigController();
        new LogController();
        new SysJobController();
        new MediaController();
        new SysDocsController();
        new StatController();
        new CurdController();
    }
}
