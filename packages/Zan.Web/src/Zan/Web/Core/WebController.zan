using System;
using System.Data;
using System.Diagnostics;
using System.Json;
using System.Web;
using Zan.Web.Protocol;
using Zan.Web.Modules.Monitor;

namespace Zan.Web.Core;

/// Web/API 控制器基类：提供请求作用域连接托管、标准协议响应、多语言、输入解析及全链路监控打点
class WebController : Controller {
    private long _reqStartMs = 0;
    protected IDbConnection _lease;
    protected bool _inTx = false;

    /// 获取本次请求的独占数据库连接（首次调用借出，同请求复用，退出时自动归还）
    public async IDbConnection Conn() {
        if (_lease != null) { return _lease; }
        _lease = Db.Connection();
        return _lease;
    }

    /// 编译器表访问器和内建绑定所识别的连接挂钩
    public IDbConnection __Conn() {
        if (_lease != null) { return _lease; }
        _lease = Db.Connection();
        return _lease;
    }

    /// 本次请求数据库连接是否就绪
    public bool DbReady() {
        return _lease != null || Db.Connection() != null;
    }

    /// 开启请求作用域事务
    public async bool Begin() {
        IDbConnection db = await this.Conn();
        if (db == null) { return false; }
        if (_inTx) { return true; }
        await db.BeginTransactionAsync();
        _inTx = true;
        return true;
    }

    /// 提交请求作用域事务
    public async void Commit() {
        if (!_inTx || _lease == null) { return; }
        _inTx = false;
        await _lease.CommitAsync();
    }

    /// 回滚请求作用域事务
    public async void Rollback() {
        if (!_inTx || _lease == null) { return; }
        _inTx = false;
        await _lease.RollbackAsync();
    }

    /// [Tx] 特性支持的生命周期蹦床
    override async bool __TxBegin() { return await this.Begin(); }
    override async void __TxCommit() { await this.Commit(); }
    override async void __TxRollback() { await this.Rollback(); }

    /// 请求执行前异步钩子：初始化计时与连接预热
    override async bool OnBeforeAsync() {
        _reqStartMs = Stopwatch.GetMilliseconds();
        return this.OnBefore();
    }

    /// 请求完成后异步钩子：事务安全回滚、监控打点、连接归还
    override async void OnAfterAsync() {
        if (_lease != null) {
            await this.Rollback();
            _lease = null;
        }
        this.OnAfter();
    }

    /// 请求执行前钩子：记录启动微秒级/毫秒级时间戳
    public override bool OnBefore() {
        if (_reqStartMs == 0) {
            _reqStartMs = Stopwatch.GetMilliseconds();
        }
        return true;
    }

    /// 请求执行后钩子：自动收集耗时指标并打点至 ServerStats
    public override void OnAfter() {
        if (_reqStartMs > 0 && this.Ctx() != null) {
            long endMs = Stopwatch.GetMilliseconds();
            int elapsed = (int)(endMs - _reqStartMs);
            if (elapsed < 0) { elapsed = 0; }

            string path = this.Ctx().path;
            string method = this.Ctx().method;
            int status = this.Ctx().status;
            string ip = this.Ctx().RemoteIp();

            ServerStats.Record(path, method, elapsed, status, ip);
        }
    }

    /// 解析当前请求语言
    public string Lang() {
        string qLang = this.In("lang");
        string cLang = this.Ctx().Cookie("lang");
        string hLang = this.Ctx().Header("Accept-Language");
        return I18n.ResolveLang(qLang, cLang, hLang);
    }

    /// 国际化翻译快捷方法
    public string T(string key, string defVal) {
        return I18n.T(this.Lang(), key, defVal);
    }

    /// 输出统一协议成功的 JSON 响应
    public void OkJson(string dataJson) {
        long nowSec = DateTime.Now().ToUnixSeconds();
        JsonValue root = JsonValue.NewObject();
        root.PutInt("code", 0);
        root.PutStr("msg", "success");
        root.PutInt("time", nowSec);
        if (dataJson == null || dataJson.Length == 0) {
            root.PutStr("data", "");
        } else {
            root.PutJson("data", dataJson);
        }
        this.Ctx().Json(root.ToJson());
    }

    /// 输出统一协议失败的 JSON 响应
    public void FailJson(int code, string msg) {
        long nowSec = DateTime.Now().ToUnixSeconds();
        JsonValue root = JsonValue.NewObject();
        root.PutInt("code", code);
        root.PutStr("msg", msg != null ? msg : "");
        root.PutInt("time", nowSec);
        root.PutNull("data");
        this.Ctx().Json(root.ToJson());
    }

    /// 从请求中提取并构建 PostData 列表查询载荷
    public PostData ReadPostData() {
        PostData p = new PostData();
        p.page = this.InInt("page", 1);
        p.pageSize = this.InInt("pageSize", 20);
        if (p.pageSize <= 0) { p.pageSize = this.InInt("limit", 20); }
        p.query = this.In("query");
        p.tab = this.In("tab");
        p.sort = this.In("sort");
        p.asc = this.InBool("asc", false);
        p.filterWhere = this.In("where");
        return p;
    }
}
