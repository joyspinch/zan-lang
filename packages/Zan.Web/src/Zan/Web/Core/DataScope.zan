using System;
using System.Collections.Generic;

namespace Zan.Web.Core;

/// 行级数据权限范围隔离（用于业务表中按 用户/部门 自动隔离数据）
class DataScope {
    public static int RoleAll = 1;      // 全部数据权限
    public static int RoleDept = 2;     // 本部门数据权限
    public static int RoleDeptTree = 3; // 本部门及下级部门数据权限
    public static int RoleSelf = 4;     // 仅本人数据权限
    public static int RoleCustom = 5;   // 自定义部门数据权限

    public static int All = 1;
    public static int ByDepts = 2;
    public static int Self = 4;

    public int mode;
    public int userId;
    public int deptId;
    public List<int> depts;

    public DataScope() {
        this.mode = DataScope.All;
        this.userId = 0;
        this.deptId = 0;
        this.depts = new List<int>();
    }

    /// 是否拥有全部数据访问权限
    public bool Any() { return this.mode == DataScope.All; }

    /// 是否仅按部门/子部门筛选数据
    public bool ByDept() { return this.mode == DataScope.ByDepts; }

    /// 是否仅能访问本人创建的数据
    public bool Mine() { return this.mode == DataScope.Self; }

    /// 授权的部门 ID 集合
    public List<int> Depts() { return this.depts; }

    /// 当前用户 ID
    public int UserId() { return this.userId; }

    /// 判断某条业务记录（其归属的用户ID与部门ID）是否在当前作用域内
    public bool Covers(int rowUserId, int rowDeptId) {
        if (this.Any()) { return true; }
        if (this.Mine()) { return rowUserId > 0 && rowUserId == this.userId; }
        if (this.depts != null && this.depts.Count > 0) {
            for (int i = 0; i < this.depts.Count; i++) {
                if (this.depts[i] == rowDeptId) { return true; }
            }
        }
        return false;
    }

    /// 构建无权限空作用域（用于未授权访问阻断）
    public static DataScope None() {
        DataScope sc = new DataScope();
        sc.mode = DataScope.ByDepts;
        sc.depts.Add(-1);
        return sc;
    }

    /// 构建全部数据权限作用域（如超级管理员）
    public static DataScope Everything(int userId) {
        DataScope sc = new DataScope();
        sc.mode = DataScope.All;
        sc.userId = userId;
        return sc;
    }
}
