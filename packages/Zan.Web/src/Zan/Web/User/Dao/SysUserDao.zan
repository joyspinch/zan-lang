using System;
using System.Collections.Generic;
using System.Data.Orm;
using System.Security.Cryptography;
using Zan.Web.Core;
using Zan.Web.User.Model;

namespace Zan.Web.User.Dao;

/// 系统用户数据访问网关（全异步、强类型原生 ORM）
class SysUserDao {
    /// 计算密码加盐哈希（MD5 32位十六进制散列）
    public static string HashPassword(string password, string salt) {
        string raw = password + ":" + salt;
        byte[] hash = Md5.Hash(raw, raw.Length);
        return Hex.Encode(hash);
    }

    /// 校验输入密码与数据库密码哈希是否匹配
    public static bool VerifyPassword(string inputPwd, string salt, string expectedHash) {
        if (inputPwd == null || salt == null || expectedHash == null) {
            return false;
        }
        string computed = HashPassword(inputPwd, salt);
        return computed.ToLower() == expectedHash.ToLower();
    }

    public async SysUser ById(int id) {
        return await Db.Connection().Select<SysUser>().Where(a => a.id == id).FirstAsync();
    }

    public async SysUser ByUsername(string username) {
        return await Db.Connection().Select<SysUser>().Where(a => a.username == username).FirstAsync();
    }

    public async List<SysUser> Page(int page, int pageSize, out int total) {
        total = await Db.Connection().Select<SysUser>().CountAsync();
        return await Db.Connection().Select<SysUser>()
            .OrderByDescending(a => a.id)
            .Page(page, pageSize)
            .ToListAsync();
    }

    public async int Insert(SysUser user) {
        return await Db.Connection().Insert<SysUser>(user).ExecuteIdentityAsync();
    }

    public async int Update(SysUser user) {
        return await Db.Connection().Update<SysUser>()
            .Set(a => a.nickname, user.nickname)
            .Set(a => a.email, user.email)
            .Set(a => a.mobile, user.mobile)
            .Set(a => a.avatar, user.avatar)
            .Set(a => a.status, user.status)
            .Set(a => a.updatedAt, user.updatedAt)
            .Where(a => a.id == user.id)
            .ExecuteAffrowsAsync();
    }

    public async int UpdatePassword(int id, string newPassword, string newSalt) {
        string hash = HashPassword(newPassword, newSalt);
        long now = DateTime.Now().ToUnixSeconds();
        return await Db.Connection().Update<SysUser>()
            .Set(a => a.password, hash)
            .Set(a => a.salt, newSalt)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    public async int SetStatus(int id, int status) {
        long now = DateTime.Now().ToUnixSeconds();
        return await Db.Connection().Update<SysUser>()
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        return await Db.Connection().Delete<SysUser>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
