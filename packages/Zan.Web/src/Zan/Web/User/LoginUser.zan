using System;

namespace Zan.Web.User;

/// 登录用户会话与凭证载荷（与 adminUI / OneAdmin 协议同构）
class LoginUser {
    public int UserID = 0;
    public int RoleID = 0;
    public string RoleName = "";
    public string UserName = "";
    public string NickName = "";
    public string Avatar = "";
    public string AccessToken = "";
    public long Expires = 0;

    public LoginUser() {}

    public string ToJson() {
        return "{\"UserID\":" + Convert.ToString(this.UserID)
            + ",\"RoleID\":" + Convert.ToString(this.RoleID)
            + ",\"RoleName\":\"" + this.RoleName + "\""
            + ",\"UserName\":\"" + this.UserName + "\""
            + ",\"NickName\":\"" + this.NickName + "\""
            + ",\"Avatar\":\"" + this.Avatar + "\""
            + ",\"AccessToken\":\"" + this.AccessToken + "\""
            + ",\"Expires\":" + Convert.ToString(this.Expires) + "}";
    }
}
