using System;
using System.Collections.Generic;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Auth.Model;

namespace Zan.Web.Auth.Dao;

/// 系统菜单与权限节点数据访问网关（全异步、强类型原生 ORM）
class SysMenuDao {
    public async List<SysMenu> All() {
        return await Db.Connection().Select<SysMenu>()
            .Where(a => a.status == 1)
            .OrderBy(a => a.rank)
            .ToListAsync();
    }

    public async SysMenu ById(int id) {
        return await Db.Connection().Select<SysMenu>().Where(a => a.id == id).FirstAsync();
    }

    public async SysMenu ByNode(string node) {
        return await Db.Connection().Select<SysMenu>().Where(a => a.node == node).FirstAsync();
    }

    public async List<SysMenu> ByIds(List<int> ids) {
        if (ids == null || ids.Count == 0) {
            return new List<SysMenu>();
        }
        return await Db.Connection().Select<SysMenu>()
            .Where(a => ids.Contains(a.id) && a.status == 1)
            .OrderBy(a => a.rank)
            .ToListAsync();
    }

    public async int Insert(SysMenu menu) {
        return await Db.Connection().Insert<SysMenu>(menu).ExecuteIdentityAsync();
    }

    public async int Update(SysMenu menu) {
        return await Db.Connection().Update<SysMenu>()
            .Set(a => a.node, menu.node)
            .Set(a => a.parentNode, menu.parentNode)
            .Set(a => a.title, menu.title)
            .Set(a => a.component, menu.component)
            .Set(a => a.icon, menu.icon)
            .Set(a => a.path, menu.path)
            .Set(a => a.rank, menu.rank)
            .Set(a => a.hidden, menu.hidden)
            .Set(a => a.status, menu.status)
            .Where(a => a.id == menu.id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        return await Db.Connection().Delete<SysMenu>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
