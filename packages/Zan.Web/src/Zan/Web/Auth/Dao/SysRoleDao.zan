using System;
using System.Collections.Generic;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Auth.Model;

namespace Zan.Web.Auth.Dao;

/// 角色数据访问网关（全异步、强类型原生 ORM）
class SysRoleDao {
    public async SysRole ById(int id) {
        return await Db.Connection().Select<SysRole>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysRole> All() {
        return await Db.Connection().Select<SysRole>()
            .Where(a => a.status == 1)
            .OrderBy(a => a.id)
            .ToListAsync();
    }

    public async List<SysRole> Page(int page, int pageSize, out int total) {
        total = await Db.Connection().Select<SysRole>().CountAsync();
        return await Db.Connection().Select<SysRole>()
            .OrderByDescending(a => a.id)
            .Page(page, pageSize)
            .ToListAsync();
    }

    public async int Insert(SysRole role) {
        return await Db.Connection().Insert<SysRole>(role).ExecuteIdentityAsync();
    }

    public async int Update(SysRole role) {
        return await Db.Connection().Update<SysRole>()
            .Set(a => a.name, role.name)
            .Set(a => a.intro, role.intro)
            .Set(a => a.status, role.status)
            .Set(a => a.updatedAt, role.updatedAt)
            .Where(a => a.id == role.id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        return await Db.Connection().Delete<SysRole>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
