using System;
using System.Collections.Generic;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Auth.Model;

namespace Zan.Web.Auth.Dao;

/// 角色与菜单权限关联数据访问网关（全异步、强类型原生 ORM）
class SysRoleMenuDao {
    public async List<int> GetMenuIdsByRoleId(int roleId) {
        List<SysRoleMenu> list = await Db.Connection().Select<SysRoleMenu>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
        List<int> result = new List<int>();
        for (int i = 0; i < list.Count; i++) {
            result.Add(list[i].menuId);
        }
        return result;
    }

    public async int SetRoleMenus(int roleId, List<int> menuIds) {
        // 先删除该角色旧绑定
        await Db.Connection().Delete<SysRoleMenu>()
            .Where(a => a.roleId == roleId)
            .ExecuteAffrowsAsync();

        if (menuIds == null || menuIds.Count == 0) {
            return 0;
        }

        int count = 0;
        for (int i = 0; i < menuIds.Count; i++) {
            SysRoleMenu item = new SysRoleMenu();
            item.roleId = roleId;
            item.menuId = menuIds[i];
            await Db.Connection().Insert<SysRoleMenu>(item).ExecuteAffrowsAsync();
            count++;
        }
        return count;
    }
}
