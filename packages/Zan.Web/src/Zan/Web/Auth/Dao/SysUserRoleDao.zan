using System;
using System.Collections.Generic;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Auth.Model;

namespace Zan.Web.Auth.Dao;

/// 用户角色关联数据访问网关（全异步、强类型原生 ORM）
class SysUserRoleDao {
    public async int GetRoleId(int userId) {
        SysUserRole ur = await Db.Connection().Select<SysUserRole>()
            .Where(a => a.userId == userId)
            .FirstAsync();
        return ur != null ? ur.roleId : 0;
    }

    public async List<int> GetRoleIds(int userId) {
        List<SysUserRole> list = await Db.Connection().Select<SysUserRole>()
            .Where(a => a.userId == userId)
            .ToListAsync();
        List<int> ids = new List<int>();
        for (int i = 0; i < list.Count; i = i + 1) {
            ids.Add(list[i].roleId);
        }
        return ids;
    }

    public async int SetUserRole(int userId, int roleId) {
        // 先清理旧关联
        await Db.Connection().Delete<SysUserRole>().Where(a => a.userId == userId).ExecuteAffrowsAsync();
        // 绑定新角色
        SysUserRole ur = new SysUserRole();
        ur.userId = userId;
        ur.roleId = roleId;
        return await Db.Connection().Insert<SysUserRole>(ur).ExecuteIdentityAsync();
    }
}
