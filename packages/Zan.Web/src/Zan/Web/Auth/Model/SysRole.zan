using System;
using System.Data.Orm;

namespace Zan.Web.Auth.Model;

/// 系统角色实体模型（对应 sys_role 表）
[Table(Name = "sys_role")]
class SysRole {
    [Column(IsIdentity = true)]
    public int id;

    /// 角色名称
    [Column(StringLength = 64, IsNullable = false)]
    public string name;

    /// 角色简介说明
    [Column(StringLength = 256)]
    public string intro;

    /// 状态（1=启用，0=禁用）
    public int status;

    public long createdAt;
    public long updatedAt;
}
