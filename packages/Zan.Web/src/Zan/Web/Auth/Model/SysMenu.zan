using System;
using System.Data.Orm;

namespace Zan.Web.Auth.Model;

/// 系统菜单与权限节点模型（对应 sys_menu 表，对齐 adminUI 菜单树协议）
[Table(Name = "sys_menu")]
class SysMenu {
    [Column(IsIdentity = true)]
    public int id;

    /// 唯一节点标识（如 sysadmin_user、sysadmin_role）
    [Column(StringLength = 64, IsNullable = false)]
    public string node;

    /// 上级节点标识（顶层为空字符串）
    [Column(StringLength = 64)]
    public string parentNode;

    /// 菜单标题显示名称
    [Column(StringLength = 64, IsNullable = false)]
    public string title;

    /// 前端组件映射标识（如 view.sysadmin_user）
    [Column(StringLength = 128)]
    public string component;

    /// 图标名称（如 mdi:account、carbon:settings）
    [Column(StringLength = 64)]
    public string icon;

    /// 路由路径（如 /sysadmin/users）
    [Column(StringLength = 128)]
    public string path;

    /// 排序权重（数值越小越靠前）
    public int rank;

    /// 是否在侧边栏隐藏（1=隐藏，0=显示）
    public int hidden;

    /// 状态（1=正常，0=停用）
    public int status;
}
