using System;
using System.Collections.Generic;

namespace Zan.Web.Auth;

/// 菜单元信息（契合 adminUI 前端路由协议）
class RouteNodeMeta {
    public bool hidden = false;
    public bool keepAlive = true;
    public bool showLink = true;
    public int rank = 0;
    public string type = "";
    public string routeKey = "";
    public string title = "";
    public string icon = "";

    public string ToJson() {
        return "{\"hidden\":" + (hidden ? "true" : "false")
            + ",\"keepAlive\":" + (keepAlive ? "true" : "false")
            + ",\"showLink\":" + (showLink ? "true" : "false")
            + ",\"rank\":" + rank.ToString()
            + ",\"type\":\"" + (type != null ? type : "") + "\""
            + ",\"routeKey\":\"" + (routeKey != null ? routeKey : "") + "\""
            + ",\"title\":\"" + (title != null ? title : "") + "\""
            + ",\"icon\":\"" + (icon != null ? icon : "") + "\"}";
    }
}

/// 动态路由树节点（契合 adminUI 前端路由树结构）
class RouteNode {
    public string path = "";
    public string parentPath = "";
    public string name = "";
    public int rank = 99;
    public string component = "";
    public RouteNodeMeta meta = new RouteNodeMeta();
    public List<RouteNode> children = new List<RouteNode>();

    public string ToJson() {
        string json = "{\"path\":\"" + (path != null ? path : "") + "\""
            + ",\"parentPath\":\"" + (parentPath != null ? parentPath : "") + "\""
            + ",\"name\":\"" + (name != null ? name : "") + "\""
            + ",\"rank\":" + rank.ToString()
            + ",\"component\":\"" + (component != null ? component : "") + "\""
            + ",\"meta\":" + (meta != null ? meta.ToJson() : "{}")
            + ",\"children\":[";

        if (children != null) {
            for (int i = 0; i < children.Count; i++) {
                if (i > 0) { json += ","; }
                json += children[i].ToJson();
            }
        }
        json += "]}";
        return json;
    }
}
