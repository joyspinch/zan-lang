using System;

namespace Zan.Web.Protocol;

/// 统一响应外壳（与 adminUI / OneAdmin Response<T> 协议同构）
class Response<T> {
    public int code = 0;
    public string msg = "success";
    public T data;
    public long time = 0;

    public Response() {}

    public Response(int code, string msg, T data) {
        this.code = code;
        this.msg = msg;
        this.data = data;
        this.time = DateTime.Now().ToUnixSeconds();
    }
}

/// 响应构造快捷工具
class ApiResponse {
    public static Response<T> Ok<T>(T data) {
        return new Response<T>(0, "success", data);
    }

    public static Response<T> Ok<T>(T data, string msg) {
        return new Response<T>(0, msg, data);
    }

    public static Response<T> Fail<T>(int code, string msg) {
        Response<T> r = new Response<T>();
        r.code = code;
        r.msg = msg;
        r.time = DateTime.Now().ToUnixSeconds();
        return r;
    }

    public static Response<string> OkEmpty() {
        return new Response<string>(0, "success", "");
    }

    public static Response<string> Error(int code, string msg) {
        return ApiResponse.Fail<string>(code, msg);
    }
}
