using System;
using System.Collections.Generic;

namespace Zan.Web.Protocol;

/// 列表查询请求载荷（POST {apiObj}/list）
class PostData {
    public int page = 1;
    public int pageSize = 20;
    public string query = "";
    public string tab = "";
    public string sort = "";
    public bool asc = false;
    public string filterWhere = "";

    public PostData() {}
}

/// 单字段/行更新请求载荷（POST {apiObj}/field, POST {apiObj}/editsave）
class FieldPostData<T> {
    public int id = 0;
    public string field = "";
    public string value = "";
    public T data;

    public FieldPostData() {}

    public FieldPostData(int id, string field, string value) {
        this.id = id;
        this.field = field;
        this.value = value;
    }
}

/// 批量字段修改请求载荷（POST {apiObj}/batchfield）
class BatchFieldPostData<T> {
    public List<int> ids = new List<int>();
    public string field = "";
    public string value = "";
    public List<T> data = new List<T>();

    public BatchFieldPostData() {}
}

/// 分页列表响应包装结构
class ResponseList<T> {
    public List<T> rows = new List<T>();
    public int total = 0;
    public int page = 1;
    public int pageSize = 20;

    public ResponseList() {}

    public ResponseList(List<T> rows, int total) {
        this.rows = rows;
        this.total = total;
    }

    public ResponseList(List<T> rows, int total, int page, int pageSize) {
        this.rows = rows;
        this.total = total;
        this.page = page;
        this.pageSize = pageSize;
    }
}
