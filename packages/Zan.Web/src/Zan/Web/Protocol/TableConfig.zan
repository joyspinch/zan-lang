using System;
using System.Collections.Generic;

namespace Zan.Web.Protocol;

/// 表格全局配置项（与 adminUI ZanTable <ZanTable> / OneAdmin TableConf 协议同构）
class TableConf {
    public bool showPages = true;
    public int pageSize = 20;
    public string pageSizes = "10,20,50,100";
    public bool treeData = false;
    public bool local = false;
    public bool allowImport = false;
    public bool allowExport = false;
    public bool allowChart = false;
    public string innerKey = "id";
    public string innerName = "name";

    public TableConf() {}

    public TableConf(string innerKey, string innerName) {
        this.innerKey = innerKey;
        this.innerName = innerName;
    }

    public string ToJson() {
        return "{\"showPages\":" + (this.showPages ? "true" : "false")
            + ",\"pageSize\":" + Convert.ToString(this.pageSize)
            + ",\"pageSizes\":\"" + this.pageSizes + "\""
            + ",\"TreeData\":" + (this.treeData ? "true" : "false")
            + ",\"Local\":" + (this.local ? "true" : "false")
            + ",\"import\":" + (this.allowImport ? "true" : "false")
            + ",\"export\":" + (this.allowExport ? "true" : "false")
            + ",\"chart\":" + (this.allowChart ? "true" : "false")
            + ",\"innerKey\":\"" + this.innerKey + "\""
            + ",\"innerName\":\"" + this.innerName + "\"}";
    }
}

/// 列类型常量
class TableColumnType {
    public static string Input = "input";
    public static string Select = "select";
    public static string Dict = "dict";
    public static string Switch = "switch";
    public static string Button = "button";
    public static string Icon = "icon";
    public static string Date = "date";
    public static string Textarea = "textarea";
    public static string Image = "image";
    public static string Link = "link";
}

/// 按钮类型常量
class TableButtonType {
    public static string Primary = "primary";
    public static string Success = "success";
    public static string Warning = "warning";
    public static string Error = "error";
    public static string Info = "info";
    public static string Default = "default";
}

/// 弹窗层配置
class LayerConfig {
    public string width = "800px";
    public string height = "600px";
    public string title = "";
    public bool maxmin = true;

    public LayerConfig() {}

    public LayerConfig(string width, string height, string title) {
        this.width = width;
        this.height = height;
        this.title = title;
    }
}

/// 列级或工具栏操作按钮
class TableColumnButton {
    public string name = "";
    public string key = "";
    public string action = "";
    public string width = "800px";
    public string height = "600px";
    public string title = "";
    public string btnType = "primary";
    public bool choose = false;
    public string showIndex = "";
    public string dict = "";

    public TableColumnButton() {}

    public TableColumnButton(string name, string key, string action, string width, string height) {
        this.name = name;
        this.key = key;
        this.action = action;
        this.width = width;
        this.height = height;
        this.title = name;
    }

    public TableColumnButton(string name, string key, string action, string width, string height, string title, string btnType, bool choose) {
        this.name = name;
        this.key = key;
        this.action = action;
        this.width = width;
        this.height = height;
        this.title = title;
        this.btnType = btnType;
        this.choose = choose;
    }

    public string ToJson() {
        return "{\"name\":\"" + this.name + "\""
            + ",\"key\":\"" + this.key + "\""
            + ",\"action\":\"" + this.action + "\""
            + ",\"width\":\"" + this.width + "\""
            + ",\"height\":\"" + this.height + "\""
            + ",\"title\":\"" + this.title + "\""
            + ",\"btnType\":\"" + this.btnType + "\""
            + ",\"choose\":" + (this.choose ? "true" : "false")
            + ",\"showIndex\":\"" + this.showIndex + "\""
            + ",\"dict\":\"" + this.dict + "\"}";
    }
}

/// 表格单列配置
class TableColumn {
    public string headerName = "";
    public string field = "";
    public int width = 120;
    public string type = "input";
    public bool editable = false;
    public int flex = 0;
    public string align = "left";
    public bool sortable = false;
    public string dict = "";

    public TableColumn() {}

    public TableColumn(string field, string headerName, int width) {
        this.field = field;
        this.headerName = headerName;
        this.width = width;
    }

    public TableColumn(string field, string headerName, int width, string type, bool editable) {
        this.field = field;
        this.headerName = headerName;
        this.width = width;
        this.type = type;
        this.editable = editable;
    }

    public string ToJson() {
        return "{\"field\":\"" + this.field + "\""
            + ",\"headerName\":\"" + this.headerName + "\""
            + ",\"width\":" + Convert.ToString(this.width)
            + ",\"type\":\"" + this.type + "\""
            + ",\"editable\":" + (this.editable ? "true" : "false")
            + ",\"flex\":" + Convert.ToString(this.flex)
            + ",\"align\":\"" + this.align + "\""
            + ",\"sortable\":" + (this.sortable ? "true" : "false")
            + ",\"dict\":\"" + this.dict + "\"}";
    }
}

/// 过滤器定义
class TableFilter {
    public string field = "";
    public string label = "";
    public string type = "input"; // input, select, date
    public string placeholder = "";
    public string dict = "";

    public TableFilter() {}

    public TableFilter(string field, string label, string type) {
        this.field = field;
        this.label = label;
        this.type = type;
    }

    public string ToJson() {
        return "{\"field\":\"" + this.field + "\""
            + ",\"label\":\"" + this.label + "\""
            + ",\"type\":\"" + this.type + "\""
            + ",\"placeholder\":\"" + this.placeholder + "\""
            + ",\"dict\":\"" + this.dict + "\"}";
    }
}

/// 选项卡定义
class TableTab {
    public string name = "";
    public string title = "";
    public int count = 0;

    public TableTab() {}

    public TableTab(string name, string title) {
        this.name = name;
        this.title = title;
    }

    public string ToJson() {
        return "{\"name\":\"" + this.name + "\""
            + ",\"title\":\"" + this.title + "\""
            + ",\"count\":" + Convert.ToString(this.count) + "}";
    }
}

/// 完整的表格配置对象（PUT {apiObj}/conf 的载荷）
class TableConfig {
    public TableConf conf = new TableConf();
    public List<TableColumn> columns = new List<TableColumn>();
    public List<TableColumnButton> tools = new List<TableColumnButton>();
    public List<TableFilter> filters = new List<TableFilter>();
    public List<TableFilter> filterRight = new List<TableFilter>();
    public List<TableTab> tabs = new List<TableTab>();
    public List<TableColumnButton> buttons = new List<TableColumnButton>();

    public TableConfig() {}

    public string ToJson() {
        string json = "{\"Conf\":" + this.conf.ToJson();
        json = json + ",\"Columns\":[";
        for (int i = 0; i < this.columns.Count; i = i + 1) {
            if (i > 0) { json = json + ","; }
            json = json + this.columns[i].ToJson();
        }
        json = json + "],\"Tools\":[";
        for (int i = 0; i < this.tools.Count; i = i + 1) {
            if (i > 0) { json = json + ","; }
            json = json + this.tools[i].ToJson();
        }
        json = json + "],\"Filters\":[";
        for (int i = 0; i < this.filters.Count; i = i + 1) {
            if (i > 0) { json = json + ","; }
            json = json + this.filters[i].ToJson();
        }
        json = json + "],\"FilterRight\":[";
        for (int i = 0; i < this.filterRight.Count; i = i + 1) {
            if (i > 0) { json = json + ","; }
            json = json + this.filterRight[i].ToJson();
        }
        json = json + "],\"Tabs\":[";
        for (int i = 0; i < this.tabs.Count; i = i + 1) {
            if (i > 0) { json = json + ","; }
            json = json + this.tabs[i].ToJson();
        }
        json = json + "],\"Buttons\":[";
        for (int i = 0; i < this.buttons.Count; i = i + 1) {
            if (i > 0) { json = json + ","; }
            json = json + this.buttons[i].ToJson();
        }
        json = json + "]}";
        return json;
    }
}
