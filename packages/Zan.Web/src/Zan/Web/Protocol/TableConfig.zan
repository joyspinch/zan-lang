using System;
using System.Collections.Generic;
using System.Json;

namespace Zan.Web.Protocol;

/// 表格全局配置项（与 adminUI ZanTable <ZanTable> / OneAdmin TableConf 协议同构）
class TableConf {
    public bool showPages = true;
    public int pageSize = 20;
    public string pageSizes = "10,20,50,100";
    public bool treeData = false;
    public bool local = false;
    public bool allowImport = false;
    public bool allowExport = false;
    public bool allowChart = false;
    public string innerKey = "id";
    public string innerName = "name";

    public TableConf() {}

    public TableConf(string innerKey, string innerName) {
        this.innerKey = innerKey;
        this.innerName = innerName;
    }

    public JsonValue ToJsonValue() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutBool("showPages", this.showPages);
        obj.PutInt("pageSize", this.pageSize);
        obj.PutStr("pageSizes", this.pageSizes);
        obj.PutBool("TreeData", this.treeData);
        obj.PutBool("Local", this.local);
        obj.PutBool("import", this.allowImport);
        obj.PutBool("export", this.allowExport);
        obj.PutBool("chart", this.allowChart);
        obj.PutStr("innerKey", this.innerKey);
        obj.PutStr("innerName", this.innerName);
        return obj;
    }

    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}

/// 列类型常量
class TableColumnType {
    public static string Input = "input";
    public static string Select = "select";
    public static string Dict = "dict";
    public static string Switch = "switch";
    public static string Button = "button";
    public static string Icon = "icon";
    public static string Date = "date";
    public static string Textarea = "textarea";
    public static string Image = "image";
    public static string Link = "link";
}

/// 按钮类型常量
class TableButtonType {
    public static string Primary = "primary";
    public static string Success = "success";
    public static string Warning = "warning";
    public static string Error = "error";
    public static string Info = "info";
    public static string Default = "default";
}

/// 弹窗层配置
class LayerConfig {
    public string width = "800px";
    public string height = "600px";
    public string title = "";
    public bool maxmin = true;

    public LayerConfig() {}

    public LayerConfig(string width, string height, string title) {
        this.width = width;
        this.height = height;
        this.title = title;
    }
}

/// 列级或工具栏操作按钮
class TableColumnButton {
    public string name = "";
    public string key = "";
    public string action = "";
    public string width = "800px";
    public string height = "600px";
    public string title = "";
    public string btnType = "primary";
    public bool choose = false;
    public string showIndex = "";
    public string dict = "";

    public TableColumnButton() {}

    public TableColumnButton(string name, string key, string action, string width, string height) {
        this.name = name;
        this.key = key;
        this.action = action;
        this.width = width;
        this.height = height;
        this.title = name;
    }

    public TableColumnButton(string name, string key, string action, string width, string height, string title, string btnType, bool choose) {
        this.name = name;
        this.key = key;
        this.action = action;
        this.width = width;
        this.height = height;
        this.title = title;
        this.btnType = btnType;
        this.choose = choose;
    }

    public JsonValue ToJsonValue() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutStr("name", this.name);
        obj.PutStr("key", this.key);
        obj.PutStr("action", this.action);
        obj.PutStr("width", this.width);
        obj.PutStr("height", this.height);
        obj.PutStr("title", this.title);
        obj.PutStr("btnType", this.btnType);
        obj.PutBool("choose", this.choose);
        obj.PutStr("showIndex", this.showIndex);
        obj.PutStr("dict", this.dict);
        return obj;
    }

    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}

/// 表格单列配置
class TableColumn {
    public string headerName = "";
    public string field = "";
    public int width = 120;
    public string type = "input";
    public bool editable = false;
    public int flex = 0;
    public string align = "left";
    public bool sortable = false;
    public string dict = "";

    public TableColumn() {}

    public TableColumn(string field, string headerName, int width) {
        this.field = field;
        this.headerName = headerName;
        this.width = width;
    }

    public TableColumn(string field, string headerName, int width, string type, bool editable) {
        this.field = field;
        this.headerName = headerName;
        this.width = width;
        this.type = type;
        this.editable = editable;
    }

    public JsonValue ToJsonValue() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutStr("field", this.field);
        obj.PutStr("headerName", this.headerName);
        obj.PutInt("width", this.width);
        obj.PutStr("type", this.type);
        obj.PutBool("editable", this.editable);
        obj.PutInt("flex", this.flex);
        obj.PutStr("align", this.align);
        obj.PutBool("sortable", this.sortable);
        obj.PutStr("dict", this.dict);
        return obj;
    }

    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}

/// 过滤器定义
class TableFilter {
    public string field = "";
    public string label = "";
    public string type = "input"; // input, select, date
    public string placeholder = "";
    public string dict = "";

    public TableFilter() {}

    public TableFilter(string field, string label, string type) {
        this.field = field;
        this.label = label;
        this.type = type;
    }

    public JsonValue ToJsonValue() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutStr("field", this.field);
        obj.PutStr("label", this.label);
        obj.PutStr("type", this.type);
        obj.PutStr("placeholder", this.placeholder);
        obj.PutStr("dict", this.dict);
        return obj;
    }

    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}

/// 选项卡定义
class TableTab {
    public string name = "";
    public string title = "";
    public int count = 0;

    public TableTab() {}

    public TableTab(string name, string title) {
        this.name = name;
        this.title = title;
    }

    public JsonValue ToJsonValue() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutStr("name", this.name);
        obj.PutStr("title", this.title);
        obj.PutInt("count", this.count);
        return obj;
    }

    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}

/// 完整的表格配置对象（PUT {apiObj}/conf 的载荷）
class TableConfig {
    public TableConf conf = new TableConf();
    public List<TableColumn> columns = new List<TableColumn>();
    public List<TableColumnButton> tools = new List<TableColumnButton>();
    public List<TableFilter> filters = new List<TableFilter>();
    public List<TableFilter> filterRight = new List<TableFilter>();
    public List<TableTab> tabs = new List<TableTab>();
    public List<TableColumnButton> buttons = new List<TableColumnButton>();

    public TableConfig() {}

    public JsonValue ToJsonValue() {
        JsonValue root = JsonValue.NewObject();
        root.Put("Conf", this.conf != null ? this.conf.ToJsonValue() : JsonValue.NewNull());

        JsonValue cols = JsonValue.NewArray();
        for (int i = 0; i < this.columns.Count; i = i + 1) {
            cols.Append(this.columns[i].ToJsonValue());
        }
        root.Put("Columns", cols);

        JsonValue tls = JsonValue.NewArray();
        for (int i = 0; i < this.tools.Count; i = i + 1) {
            tls.Append(this.tools[i].ToJsonValue());
        }
        root.Put("Tools", tls);

        JsonValue flts = JsonValue.NewArray();
        for (int i = 0; i < this.filters.Count; i = i + 1) {
            flts.Append(this.filters[i].ToJsonValue());
        }
        root.Put("Filters", flts);

        JsonValue fltR = JsonValue.NewArray();
        for (int i = 0; i < this.filterRight.Count; i = i + 1) {
            fltR.Append(this.filterRight[i].ToJsonValue());
        }
        root.Put("FilterRight", fltR);

        JsonValue tbs = JsonValue.NewArray();
        for (int i = 0; i < this.tabs.Count; i = i + 1) {
            tbs.Append(this.tabs[i].ToJsonValue());
        }
        root.Put("Tabs", tbs);

        JsonValue btns = JsonValue.NewArray();
        for (int i = 0; i < this.buttons.Count; i = i + 1) {
            btns.Append(this.buttons[i].ToJsonValue());
        }
        root.Put("Buttons", btns);

        return root;
    }

    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}
