using System;
using System.Collections.Generic;

namespace Zan.Web.Protocol;

/// 后台多语言管理与国际化本地化引擎
class I18n {
    static Dict<string, Dict<string, string>> catalogs = new Dict<string, Dict<string, string>>();
    static string defaultLang = "zh-CN";

    /// 注册语言字典
    public static void Register(string lang, string key, string value) {
        if (!catalogs.ContainsKey(lang)) {
            catalogs[lang] = new Dict<string, string>();
        }
        Dict<string, string> dict = catalogs[lang];
        dict[key] = value;
    }

    /// 批量注册某一语言的多条文案
    public static void RegisterBatch(string lang, Dict<string, string> items) {
        if (!catalogs.ContainsKey(lang)) {
            catalogs[lang] = new Dict<string, string>();
        }
        Dict<string, string> dict = catalogs[lang];
        foreach (string k in items.Keys) {
            dict[k] = items[k];
        }
    }

    /// 设置系统默认语言
    public static void SetDefaultLanguage(string lang) {
        if (lang != null && lang.Length > 0) {
            defaultLang = lang;
        }
    }

    /// 获取翻译文本；找不到时返回 defVal（若 defVal 为空则返回 key 自身）
    public static string T(string lang, string key, string defVal) {
        if (lang == null || lang.Length == 0) {
            lang = defaultLang;
        }
        if (catalogs.ContainsKey(lang)) {
            Dict<string, string> dict = catalogs[lang];
            if (dict.ContainsKey(key)) {
                return dict[key];
            }
        }
        // 回退默认语言
        if (lang != defaultLang && catalogs.ContainsKey(defaultLang)) {
            Dict<string, string> dict = catalogs[defaultLang];
            if (dict.ContainsKey(key)) {
                return dict[key];
            }
        }
        if (defVal != null && defVal.Length > 0) {
            return defVal;
        }
        return key;
    }

    /// 从请求头或参数中解析语言标识
    public static string ResolveLang(string queryLang, string cookieLang, string headerAcceptLang) {
        if (queryLang != null && queryLang.Length > 0) {
            return NormalizeLang(queryLang);
        }
        if (cookieLang != null && cookieLang.Length > 0) {
            return NormalizeLang(cookieLang);
        }
        if (headerAcceptLang != null && headerAcceptLang.Length > 0) {
            if (headerAcceptLang.StartsWith("en") || headerAcceptLang.Contains("en-US")) {
                return "en-US";
            }
            if (headerAcceptLang.StartsWith("zh") || headerAcceptLang.Contains("zh-CN")) {
                return "zh-CN";
            }
        }
        return defaultLang;
    }

    static string NormalizeLang(string input) {
        string lower = input.ToLower();
        if (lower.StartsWith("en")) {
            return "en-US";
        }
        if (lower.StartsWith("zh")) {
            return "zh-CN";
        }
        return input;
    }
}
