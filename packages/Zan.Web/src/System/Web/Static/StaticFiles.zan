using System;
using System.IO;

namespace System.Web;

// 静态资源文件服务中间件：提供 CSS/JS/字体/图片的高性能流式分发与缓存控制。
public class StaticFiles {
    private static string prefix = "";
    private static string root = "";
    private static int maxAge = HttpLimits.DefaultTtlSeconds;
    public static const int MaxFileBytes = HttpLimits.MaxStaticFileBytes;
    private static List<StaticMount> mounts = new List<StaticMount>();
    private static Dict<string, string> mimeTypes = null;

    private static Dict<string, string> EnsureMimes() {
        lock (StaticFiles.mounts) {
            if (StaticFiles.mimeTypes == null) {
                Dict<string, string> m = new Dict<string, string>();
                m.Add("css", "text/css; charset=utf-8");
                m.Add("js", "application/javascript; charset=utf-8");
                m.Add("mjs", "application/javascript; charset=utf-8");
                m.Add("json", "application/json; charset=utf-8");
                m.Add("map", "application/json; charset=utf-8");
                m.Add("html", "text/html; charset=utf-8");
                m.Add("txt", "text/plain; charset=utf-8");
                m.Add("svg", "image/svg+xml");
                m.Add("png", "image/png");
                m.Add("jpg", "image/jpeg");
                m.Add("jpeg", "image/jpeg");
                m.Add("gif", "image/gif");
                m.Add("webp", "image/webp");
                m.Add("ico", "image/x-icon");
                m.Add("woff", "font/woff");
                m.Add("woff2", "font/woff2");
                m.Add("ttf", "font/ttf");
                StaticFiles.mimeTypes = m;
            }
            return StaticFiles.mimeTypes;
        }
    }

    // 注册或覆盖扩展名对应的 Content-Type（ext 可带或不带前导点；拒绝含 CR/LF/控制字符的值防头注入）。
    public static void RegisterMime(string ext, string contentType) {
        if (ext == null || contentType == null) { return; }
        string key = ext.Trim().ToLower();
        if (key.StartsWith(".")) { key = key.Substring(1); }
        if (key.Length == 0 || contentType.Length == 0) { return; }
        for (int i = 0; i < contentType.Length; i = i + 1) {
            int c = contentType[i] & 255;
            if (c < 32 || c == 127) { return; }
        }
        lock (StaticFiles.mounts) {
            Dict<string, string> m = StaticFiles.EnsureMimes();
            if (m.ContainsKey(key)) {
                m[key] = contentType;
            } else {
                m.Add(key, contentType);
            }
        }
    }

    // 将本地目录挂载至指定 URL 前缀路由中间件。
    public static void Mount(WebApp app, string urlPrefix, string dir) {
        StaticFiles.prefix = urlPrefix;
        StaticFiles.root = dir;
        StaticMount m = new StaticMount(urlPrefix, dir, StaticFiles.maxAge);
        StaticFiles.mounts.Add(m);
        if (app != null) {
            app.Mount(urlPrefix, dir, StaticFiles.maxAge);
        }
    }

    // 浏览器客户端资源缓存时长（秒，开发环境可配置为 0）。
    public static void MaxAge(int seconds) {
        StaticFiles.maxAge = seconds;
        for (int i = 0; i < StaticFiles.mounts.Count; i = i + 1) {
            StaticMount m = StaticFiles.mounts[i];
            m.SetMaxAge(seconds);
        }
    }

    // 请求前置中间件：匹配静态资源直接响应，未匹配放行后续路由。
    public static bool Serve(HttpContext ctx) {
        if (ctx.Method() != "GET" && ctx.Method() != "HEAD") { return true; }
        WebApp app = ctx != null ? ctx.App() : null;
        if (app != null && app.StaticMounts().Count > 0) {
            bool handled = !app.ServeStatic(ctx);
            if (handled) { return false; }
        }
        if (StaticFiles.mounts.Count > 0) {
            for (int i = 0; i < StaticFiles.mounts.Count; i = i + 1) {
                StaticMount m = StaticFiles.mounts[i];
                string rel = StaticFiles.RelativeTo(ctx.Path(), m.Prefix());
                if (rel != null) {
                    return StaticFiles.ServeFile(ctx, rel, m.Root(), m.Prefix(), m.MaxAge());
                }
            }
        }
        if (StaticFiles.root.Length == 0) { return true; }
        string relLegacy = StaticFiles.Relative(ctx.Path());
        if (relLegacy == null) { return true; }
        return StaticFiles.ServeFile(ctx, relLegacy, StaticFiles.root, StaticFiles.prefix, StaticFiles.maxAge);
    }

    public static bool ServeFile(HttpContext ctx, string rel, string rootDir, string urlPrefix, int ageSeconds) {
        if (rel.Length == 0 || !StaticFiles.IsSafe(rel)) {
            ctx.Status(404, "Not Found").Text("not found");
            return false;
        }
        string full = Directory.ReadPath(rootDir + "/" + rel);
        if (!File.Exists(full)) {
            ctx.Status(404, "Not Found").Text("not found");
            return false;
        }
        FileStream file = null;
        try {
            file = FileStream.OpenRead(full);
        } catch (FileNotFoundException ex) {
            if (!File.EmbedExists(full)) {
                ctx.Status(404, "Not Found").Text("not found");
                return false;
            }
            byte[] lengthBytes = new byte[8];
            nint src = File.zan_embed_bytes(File.EmbedName(full), lengthBytes);
            int length = (int)lengthBytes[0] + (int)lengthBytes[1] * 256
                + (int)lengthBytes[2] * 65536 + (int)lengthBytes[3] * 16777216;
            if (src == 0 || length < 0) {
                ctx.Status(404, "Not Found").Text("not found");
                return false;
            }
            if (StaticFiles.TooLarge(ctx, length)) { return false; }
            byte[] embedded = new byte[0];
            if (ctx.Method() != "HEAD") {
                embedded = new byte[length];
                if (length > 0) { File.EmbedCopyIn(embedded, src, length); }
            }
            StaticFiles.AnswerMount(ctx, urlPrefix, ageSeconds, rel, embedded, length);
            return false;
        }
        try {
            StaticFiles.ServeStreamMount(ctx, rel, file, urlPrefix, ageSeconds);
        } finally {
            file.Close();
        }
        return false;
    }

    public static void ServeStream(HttpContext ctx, string rel, Stream file) {
        StaticFiles.ServeStreamMount(ctx, rel, file, StaticFiles.prefix, StaticFiles.maxAge);
    }

    public static void ServeStreamMount(HttpContext ctx, string rel, Stream file, string urlPrefix, int ageSeconds) {
        long length = file.Length();
        if (length < 0 || file.Seek(0, 0) != 0) {
            ctx.Status(404, "Not Found").Text("not found");
            return;
        }
        if (StaticFiles.TooLarge(ctx, length)) { return; }
        int size = (int)length;
        if (ctx.Method() == "HEAD") {
            StaticFiles.AnswerMount(ctx, urlPrefix, ageSeconds, rel, new byte[0], size);
            return;
        }
        byte[] data = new byte[size];
        int have = 0;
        while (have < size) {
            int got = file.ReadInto((nint)data + (nint)have, size - have);
            if (got <= 0 || got > size - have) {
                ctx.Status(503, "Service Unavailable").Text("static file changed or unreadable");
                return;
            }
            have = have + got;
        }
        byte[] extra = new byte[1];
        int more = file.ReadInto((nint)extra, 1);
        if (more != 0 || file.Length() != length) {
            ctx.Status(503, "Service Unavailable").Text("static file changed or unreadable");
            return;
        }
        StaticFiles.AnswerMount(ctx, urlPrefix, ageSeconds, rel, data, size);
    }

    public static bool TooLarge(HttpContext ctx, long length) {
        if (length <= StaticFiles.MaxFileBytes) { return false; }
        ctx.Status(413, "Content Too Large").Text("static file exceeds 4 MiB limit");
        return true;
    }

    public static void Answer(HttpContext ctx, string rel, byte[] data, int size) {
        StaticFiles.AnswerMount(ctx, StaticFiles.prefix, StaticFiles.maxAge, rel, data, size);
    }

    public static void AnswerMount(HttpContext ctx, string urlPrefix, int ageSeconds, string rel, byte[] data, int size) {
        ctx.SetRoutePattern(urlPrefix + "/" + rel);
        ctx.SetHeader("Cache-Control", "public, max-age="
            + Convert.ToString(ageSeconds));
        ctx.Binary(StaticFiles.ContentType(rel), data, size);
    }

    public static string Relative(string path) {
        return StaticFiles.RelativeTo(path, StaticFiles.prefix);
    }

    public static string RelativeTo(string path, string urlPrefix) {
        if (path == null || urlPrefix == null) { return null; }
        if (urlPrefix == "/") {
            if (path.Length <= 1 || (path[0] & 255) != 47) { return null; }
            return path.Substring(1);
        }
        int pn = urlPrefix.Length;
        if (path.Length <= pn) { return null; }
        if (path.Substring(0, pn) != urlPrefix) { return null; }
        if ((path[pn] & 255) != 47) { return null; }  // '/'
        return path.Substring(pn + 1);
    }

    public static bool IsSafe(string rel) {
        int n = rel.Length;
        bool segStart = true;
        for (int i = 0; i < n; i = i + 1) {
            int c = rel[i] & 255;
            if (c == 47) {  // '/'
                if (segStart) { return false; }  // "//" or leading
                segStart = true;
                continue;
            }
            if (segStart && c == 46) { return false; }  // ".." / dotfile
            segStart = false;
            bool ok = (c >= 97 && c <= 122)  // a-z
                || (c >= 65 && c <= 90)  // A-Z
                || (c >= 48 && c <= 57)  // 0-9
                || c == 46 || c == 45 || c == 95;  // . - _
            if (!ok) { return false; }
        }
        return !segStart;
    }

    // 按扩展名（小写化后）查询可扩展 MIME 表；未知类型为
    // application/octet-stream。
    public static string ContentType(string rel) {
        string ext = StaticFiles.Extension(rel);
        if (ext.Length == 0) { return "application/octet-stream"; }
        string mime = "";
        if (StaticFiles.EnsureMimes().TryGetValue(ext, out mime)) { return mime; }
        return "application/octet-stream";
    }

    // 末段最后一个 '.' 之后的扩展名（小写）；无扩展名或以 '.' 结尾为空串。
    public static string Extension(string rel) {
        int n = rel.Length;
        int dot = -1;
        for (int i = n - 1; i >= 0; i = i - 1) {
            int c = rel[i] & 255;
            if (c == 47) { break; }  // '/'
            if (c == 46) { dot = i; break; }  // '.'
        }
        if (dot < 0 || dot == n - 1) { return ""; }
        return rel.Substring(dot + 1, n - dot - 1).ToLower();
    }
}
