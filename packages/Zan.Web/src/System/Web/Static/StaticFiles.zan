using System;
using System.IO;

namespace System.Web;

// 静态资源文件服务中间件：提供 CSS/JS/字体/图片的高性能流式分发与缓存控制。
public class StaticFiles {
    private static string stateLock = "System.Web.StaticFiles.stateLock";
    private static string prefix = "";
    private static string root = "";
    private static int maxAge = HttpLimits.DefaultTtlSeconds;
    public static const int MaxFileBytes = HttpLimits.MaxStaticFileBytes;
    private static List<StaticMount> mounts = null;
    private static Dict<string, string> mimeTypes = null;
    private static bool customMimeRegistered = false;

    private static Dict<string, string> EnsureMimesLocked() {
        if (StaticFiles.mimeTypes == null) {
            Dict<string, string> m = new Dict<string, string>();
            m.Add("css", "text/css; charset=utf-8");
            m.Add("js", "application/javascript; charset=utf-8");
            m.Add("mjs", "application/javascript; charset=utf-8");
            m.Add("json", "application/json; charset=utf-8");
            m.Add("map", "application/json; charset=utf-8");
            m.Add("html", "text/html; charset=utf-8");
            m.Add("txt", "text/plain; charset=utf-8");
            m.Add("svg", "image/svg+xml");
            m.Add("png", "image/png");
            m.Add("jpg", "image/jpeg");
            m.Add("jpeg", "image/jpeg");
            m.Add("gif", "image/gif");
            m.Add("webp", "image/webp");
            m.Add("ico", "image/x-icon");
            m.Add("woff", "font/woff");
            m.Add("woff2", "font/woff2");
            m.Add("ttf", "font/ttf");
            StaticFiles.mimeTypes = m;
        }
        return StaticFiles.mimeTypes;
    }

    // 注册或覆盖扩展名对应的 Content-Type（ext 可带或不带前导点；拒绝含 CR/LF/控制字符的值防头注入）。
    public static void RegisterMime(string ext, string contentType) {
        if (ext == null || contentType == null) { return; }
        string key = ext.Trim().ToLower();
        if (key.StartsWith(".")) { key = key.Substring(1); }
        if (key.Length == 0 || contentType.Length == 0) { return; }
        for (int i = 0; i < contentType.Length; i = i + 1) {
            int c = contentType[i] & 255;
            if (c < 32 || c == 127) { return; }
        }
        lock (StaticFiles.stateLock) {
            Dict<string, string> m = StaticFiles.EnsureMimesLocked();
            if (m.ContainsKey(key)) {
                m[key] = contentType;
            } else {
                m.Add(key, contentType);
            }
            StaticFiles.customMimeRegistered = true;
        }
    }

    // 将本地目录挂载至指定 URL 前缀路由中间件。
    public static void Mount(WebApp app, string urlPrefix, string dir) {
        if (urlPrefix == null || urlPrefix.Length == 0 || dir == null || dir.Length == 0) { return; }
        int age = HttpLimits.DefaultTtlSeconds;
        lock (StaticFiles.stateLock) {
            StaticFiles.prefix = urlPrefix;
            StaticFiles.root = dir;
            age = StaticFiles.maxAge;
            if (StaticFiles.mounts == null) { StaticFiles.mounts = new List<StaticMount>(); }
            StaticFiles.mounts.Add(new StaticMount(urlPrefix, dir, age));
        }
        if (app != null) {
            app.Mount(urlPrefix, dir, age);
        }
    }

    // 浏览器客户端资源缓存时长（秒，开发环境可配置为 0）。
    public static void MaxAge(int seconds) {
        int clamped = seconds < 0 ? 0 : seconds;
        lock (StaticFiles.stateLock) {
            StaticFiles.maxAge = clamped;
            if (StaticFiles.mounts != null) {
                for (int i = 0; i < StaticFiles.mounts.Count; i = i + 1) {
                    StaticFiles.mounts[i].SetMaxAge(clamped);
                }
            }
        }
    }

    // 请求前置中间件：匹配静态资源直接响应，未匹配放行后续路由。
    public static bool Serve(HttpContext ctx) {
        if (ctx == null) { return true; }
        if (ctx.Method() != "GET" && ctx.Method() != "HEAD") { return true; }
        WebApp app = ctx.App();
        if (app != null && app.StaticMounts().Count > 0) {
            bool handled = !app.ServeStatic(ctx);
            if (handled) { return false; }
        }
        string reqPath = ctx.Path();
        string matchedRel = null;
        string matchedRoot = "";
        string matchedPrefix = "";
        int matchedAge = HttpLimits.DefaultTtlSeconds;
        lock (StaticFiles.stateLock) {
            if (StaticFiles.mounts != null && StaticFiles.mounts.Count > 0) {
                for (int i = 0; i < StaticFiles.mounts.Count; i = i + 1) {
                    StaticMount m = StaticFiles.mounts[i];
                    string rel = StaticFiles.RelativeTo(reqPath, m.Prefix());
                    if (rel != null) {
                        matchedRel = rel;
                        matchedRoot = m.Root();
                        matchedPrefix = m.Prefix();
                        matchedAge = m.MaxAge();
                        break;
                    }
                }
            }
            if (matchedRel == null && StaticFiles.root.Length > 0) {
                string relLegacy = StaticFiles.RelativeTo(reqPath, StaticFiles.prefix);
                if (relLegacy != null) {
                    matchedRel = relLegacy;
                    matchedRoot = StaticFiles.root;
                    matchedPrefix = StaticFiles.prefix;
                    matchedAge = StaticFiles.maxAge;
                }
            }
        }
        if (matchedRel == null) { return true; }
        return StaticFiles.ServeFile(ctx, matchedRel, matchedRoot, matchedPrefix, matchedAge);
    }

    public static bool ServeFile(HttpContext ctx, string rel, string rootDir, string urlPrefix, int ageSeconds) {
        if (ctx == null) { return true; }
        if (rootDir == null || rootDir.Length == 0 || rel == null || rel.Length == 0 || !StaticFiles.IsSafe(rel)) {
            ctx.Status(404, "Not Found").Text("not found");
            return false;
        }
        string full = Directory.ReadPath(rootDir + "/" + rel);
        if (!File.Exists(full)) {
            ctx.Status(404, "Not Found").Text("not found");
            return false;
        }
        FileStream file = null;
        try {
            file = FileStream.OpenRead(full);
        } catch (FileNotFoundException ex) {
            if (!File.EmbedExists(full)) {
                ctx.Status(404, "Not Found").Text("not found");
                return false;
            }
            byte[] lengthBytes = new byte[8];
            nint src = File.zan_embed_bytes(File.EmbedName(full), lengthBytes);
            int length = (int)lengthBytes[0] + (int)lengthBytes[1] * 256
                + (int)lengthBytes[2] * 65536 + (int)lengthBytes[3] * 16777216;
            if (src == 0 || length < 0) {
                ctx.Status(404, "Not Found").Text("not found");
                return false;
            }
            if (StaticFiles.TooLarge(ctx, length)) { return false; }
            byte[] embedded = new byte[0];
            if (ctx.Method() != "HEAD") {
                embedded = new byte[length];
                if (length > 0) { File.EmbedCopyIn(embedded, src, length); }
            }
            StaticFiles.AnswerMount(ctx, urlPrefix, ageSeconds, rel, embedded, length);
            return false;
        }
        try {
            StaticFiles.ServeStreamMount(ctx, rel, file, urlPrefix, ageSeconds);
        } finally {
            file.Close();
        }
        return false;
    }

    public static void ServeStream(HttpContext ctx, string rel, Stream file) {
        StaticFiles.ServeStreamMount(ctx, rel, file, StaticFiles.prefix, StaticFiles.maxAge);
    }

    public static void ServeStreamMount(HttpContext ctx, string rel, Stream file, string urlPrefix, int ageSeconds) {
        long length = file.Length();
        if (length < 0 || file.Seek(0, 0) != 0) {
            ctx.Status(404, "Not Found").Text("not found");
            return;
        }
        if (StaticFiles.TooLarge(ctx, length)) { return; }
        int size = (int)length;
        if (ctx.Method() == "HEAD") {
            StaticFiles.AnswerMount(ctx, urlPrefix, ageSeconds, rel, new byte[0], size);
            return;
        }
        byte[] data = new byte[size];
        int have = 0;
        while (have < size) {
            int got = file.ReadInto((nint)data + (nint)have, size - have);
            if (got <= 0 || got > size - have) {
                ctx.Status(503, "Service Unavailable").Text("static file changed or unreadable");
                return;
            }
            have = have + got;
        }
        byte[] extra = new byte[1];
        int more = file.ReadInto((nint)extra, 1);
        if (more != 0 || file.Length() != length) {
            ctx.Status(503, "Service Unavailable").Text("static file changed or unreadable");
            return;
        }
        StaticFiles.AnswerMount(ctx, urlPrefix, ageSeconds, rel, data, size);
    }

    public static bool TooLarge(HttpContext ctx, long length) {
        if (length <= StaticFiles.MaxFileBytes) { return false; }
        ctx.Status(413, "Content Too Large").Text("static file exceeds 4 MiB limit");
        return true;
    }

    public static void Answer(HttpContext ctx, string rel, byte[] data, int size) {
        StaticFiles.AnswerMount(ctx, StaticFiles.prefix, StaticFiles.maxAge, rel, data, size);
    }

    public static void AnswerMount(HttpContext ctx, string urlPrefix, int ageSeconds, string rel, byte[] data, int size) {
        ctx.SetRoutePattern(urlPrefix + "/" + rel);
        ctx.SetHeader("Cache-Control", "public, max-age="
            + Convert.ToString(ageSeconds));
        ctx.Binary(StaticFiles.ContentType(rel), data, size);
    }

    public static string Relative(string path) {
        string p = "";
        lock (StaticFiles.stateLock) { p = StaticFiles.prefix; }
        return StaticFiles.RelativeTo(path, p);
    }

    public static string RelativeTo(string path, string urlPrefix) {
        if (path == null || urlPrefix == null || urlPrefix.Length == 0) { return null; }
        int pn = urlPrefix.Length;
        if (pn == 1 && (urlPrefix[0] & 255) == 47) {
            if (path.Length <= 1 || (path[0] & 255) != 47) { return null; }
            return path.Substring(1);
        }
        if (path.Length <= pn || (path[pn] & 255) != 47) { return null; }
        for (int i = 0; i < pn; i = i + 1) {
            if ((path[i] & 255) != (urlPrefix[i] & 255)) { return null; }
        }
        return path.Substring(pn + 1);
    }

    private static bool IsReservedDeviceSegment(string rel, int start, int end) {
        int stemEnd = start;
        while (stemEnd < end && (rel[stemEnd] & 255) != 46) { stemEnd = stemEnd + 1; }
        int len = stemEnd - start;
        if (len == 3) {
            int c0 = StaticFiles.LowerAscii(rel[start] & 255);
            int c1 = StaticFiles.LowerAscii(rel[start + 1] & 255);
            int c2 = StaticFiles.LowerAscii(rel[start + 2] & 255);
            if ((c0 == 99 && c1 == 111 && c2 == 110)   // con
                || (c0 == 112 && c1 == 114 && c2 == 110) // prn
                || (c0 == 97 && c1 == 117 && c2 == 120)  // aux
                || (c0 == 110 && c1 == 117 && c2 == 108)) { // nul
                return true;
            }
        } else if (len == 4) {
            int c0 = StaticFiles.LowerAscii(rel[start] & 255);
            int c1 = StaticFiles.LowerAscii(rel[start + 1] & 255);
            int c2 = StaticFiles.LowerAscii(rel[start + 2] & 255);
            int c3 = rel[start + 3] & 255;
            if (c3 >= 49 && c3 <= 57) {
                if ((c0 == 99 && c1 == 111 && c2 == 109)   // com1..9
                    || (c0 == 108 && c1 == 112 && c2 == 116)) { // lpt1..9
                    return true;
                }
            }
        }
        return false;
    }

    public static bool IsSafe(string rel) {
        if (rel == null || rel.Length == 0) { return false; }
        int n = rel.Length;
        int segBegin = 0;
        bool segStart = true;
        for (int i = 0; i < n; i = i + 1) {
            int c = rel[i] & 255;
            if (c == 47) {  // '/'
                if (segStart) { return false; }  // "//" or leading
                if (StaticFiles.IsReservedDeviceSegment(rel, segBegin, i)) { return false; }
                segStart = true;
                segBegin = i + 1;
                continue;
            }
            if (segStart && c == 46) { return false; }  // ".." / dotfile
            segStart = false;
            bool ok = (c >= 97 && c <= 122)  // a-z
                || (c >= 65 && c <= 90)  // A-Z
                || (c >= 48 && c <= 57)  // 0-9
                || c == 46 || c == 45 || c == 95;  // . - _
            if (!ok) { return false; }
        }
        if (segStart) { return false; }
        if (StaticFiles.IsReservedDeviceSegment(rel, segBegin, n)) { return false; }
        return true;
    }

    private static int LowerAscii(int c) {
        return (c >= 65 && c <= 90) ? (c + 32) : c;
    }

    private static string BuiltinMime(string rel, int start, int len) {
        if (len == 2) {
            if (StaticFiles.LowerAscii(rel[start] & 255) == 106
                && StaticFiles.LowerAscii(rel[start + 1] & 255) == 115) {
                return "application/javascript; charset=utf-8";
            }
            return "application/octet-stream";
        }
        if (len == 3) {
            int c0 = StaticFiles.LowerAscii(rel[start] & 255);
            int c1 = StaticFiles.LowerAscii(rel[start + 1] & 255);
            int c2 = StaticFiles.LowerAscii(rel[start + 2] & 255);
            if (c0 == 99 && c1 == 115 && c2 == 115) { return "text/css; charset=utf-8"; }
            if (c0 == 109) {
                if (c1 == 106 && c2 == 115) { return "application/javascript; charset=utf-8"; }
                if (c1 == 97 && c2 == 112) { return "application/json; charset=utf-8"; }
                return "application/octet-stream";
            }
            if (c0 == 116) {
                if (c1 == 120 && c2 == 116) { return "text/plain; charset=utf-8"; }
                if (c1 == 116 && c2 == 102) { return "font/ttf"; }
                return "application/octet-stream";
            }
            if (c0 == 115 && c1 == 118 && c2 == 103) { return "image/svg+xml"; }
            if (c0 == 112 && c1 == 110 && c2 == 103) { return "image/png"; }
            if (c0 == 106 && c1 == 112 && c2 == 103) { return "image/jpeg"; }
            if (c0 == 103 && c1 == 105 && c2 == 102) { return "image/gif"; }
            if (c0 == 105 && c1 == 99 && c2 == 111) { return "image/x-icon"; }
            return "application/octet-stream";
        }
        if (len == 4) {
            int c0 = StaticFiles.LowerAscii(rel[start] & 255);
            int c1 = StaticFiles.LowerAscii(rel[start + 1] & 255);
            int c2 = StaticFiles.LowerAscii(rel[start + 2] & 255);
            int c3 = StaticFiles.LowerAscii(rel[start + 3] & 255);
            if (c0 == 106) {
                if (c1 == 115 && c2 == 111 && c3 == 110) { return "application/json; charset=utf-8"; }
                if (c1 == 112 && c2 == 101 && c3 == 103) { return "image/jpeg"; }
                return "application/octet-stream";
            }
            if (c0 == 104 && c1 == 116 && c2 == 109 && c3 == 108) { return "text/html; charset=utf-8"; }
            if (c0 == 119) {
                if (c1 == 101 && c2 == 98 && c3 == 112) { return "image/webp"; }
                if (c1 == 111 && c2 == 102 && c3 == 102) { return "font/woff"; }
                return "application/octet-stream";
            }
            return "application/octet-stream";
        }
        if (len == 5) {
            if (StaticFiles.LowerAscii(rel[start] & 255) == 119
                && StaticFiles.LowerAscii(rel[start + 1] & 255) == 111
                && StaticFiles.LowerAscii(rel[start + 2] & 255) == 102
                && StaticFiles.LowerAscii(rel[start + 3] & 255) == 102
                && (rel[start + 4] & 255) == 50) {
                return "font/woff2";
            }
        }
        return "application/octet-stream";
    }

    // 按扩展名（小写化后）查询可扩展 MIME 表；未知类型为
    // application/octet-stream。
    public static string ContentType(string rel) {
        if (rel == null || rel.Length == 0) { return "application/octet-stream"; }
        if (!StaticFiles.customMimeRegistered) {
            int n = rel.Length;
            int dot = -1;
            for (int i = n - 1; i >= 0; i = i - 1) {
                int c = rel[i] & 255;
                if (c == 47) { break; }
                if (c == 46) { dot = i; break; }
            }
            if (dot < 0 || dot == n - 1) { return "application/octet-stream"; }
            return StaticFiles.BuiltinMime(rel, dot + 1, n - dot - 1);
        }
        string ext = StaticFiles.Extension(rel);
        if (ext.Length == 0) { return "application/octet-stream"; }
        lock (StaticFiles.stateLock) {
            string mime = "";
            if (StaticFiles.EnsureMimesLocked().TryGetValue(ext, out mime)) { return mime; }
        }
        return "application/octet-stream";
    }

    // 末段最后一个 '.' 之后的扩展名（小写）；无扩展名或以 '.' 结尾为空串。
    public static string Extension(string rel) {
        int n = rel.Length;
        int dot = -1;
        bool hasUpper = false;
        for (int i = n - 1; i >= 0; i = i - 1) {
            int c = rel[i] & 255;
            if (c == 47) { break; }  // '/'
            if (c == 46) { dot = i; break; }  // '.'
            if (c >= 65 && c <= 90) { hasUpper = true; }
        }
        if (dot < 0 || dot == n - 1) { return ""; }
        int extStart = dot + 1;
        int extLen = n - extStart;
        if (!hasUpper) {
            return rel.Substring(extStart, extLen);
        }
        byte[] buf = new byte[extLen];
        for (int i = 0; i < extLen; i = i + 1) {
            int c = rel[extStart + i] & 255;
            buf[i] = (byte)((c >= 65 && c <= 90) ? (c + 32) : c);
        }
        return NativeMemory.GetString((nint)buf, 0, extLen);
    }
}
