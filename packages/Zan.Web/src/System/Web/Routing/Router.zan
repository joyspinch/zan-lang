using System;
using System.Threading;
using System.Json;
using System.Text.RegularExpressions;

namespace System.Web;

// 单个路由端点共享内存性能指标（路由、调用次数、平均微秒耗时）。
public class Router {
    private List<Route> statics;  // no {param} segments: matched by full-path compare
    private List<Route> dynamics;  // contain {param} segments: matched per-segment
    private List<Route> regexes;   // regex patterns: matched by Regex.Find / IsMatch
    // 静态路由开放寻址哈希索引。
    private int[] hashSlots;
    private int hashMask;
    private bool hasWildcardStatic;
    private int minStaticLen;
    private int maxStaticLen;
    private Route[] staticArr;
    private Route[] dynArr;
    private List<Route> flat;
    // 路由统计键元数据实体列表（结构化管理，消除平行列表）。
    private List<RouteStatEntry> statEntries;
    // 跨进程共享路由统计表（记录命中次数与总微秒耗时）。
    private SharedTable routeStats;
    // 跨进程共享路由属性查找表（服务器启动时一次性预装载，用于极速 O(1) 匹配与 404 判定）。
    private RouteTable routeTable;

    public Router() {
        this.statics = new List<Route>();
        this.dynamics = new List<Route>();
        this.regexes = new List<Route>();
        this.hashSlots = null;
        this.hashMask = 0;
        this.hasWildcardStatic = false;
        this.minStaticLen = 2147483647;
        this.maxStaticLen = -1;
        this.staticArr = null;
        this.dynArr = null;
        this.flat = new List<Route>();
        this.statEntries = new List<RouteStatEntry>();
        this.routeStats = null;
        this.routeTable = null;
    }

    public int Count() { return this.flat.Count; }

    // 注册一条路由并返回 Route（可继续 fluent 配置）。
    // 无 {param} 段的路由进静态桶并建哈希索引，其余进动态桶。
    public Route Add(string method, string pattern, HttpHandler handler) {
        string m = method != null ? method : "";
        string p = pattern != null ? pattern : "";
        Route r = new Route(m, p, handler);
        lock (this) {
            if (Router.IsStatic(p)) {
                this.statics.Add(r);
                if (m == "*") { this.hasWildcardStatic = true; }
                int plen = r.pattern.Length;
                if (plen < this.minStaticLen) { this.minStaticLen = plen; }
                if (plen > this.maxStaticLen) { this.maxStaticLen = plen; }
                this.hashSlots = null;
                this.staticArr = null;
            } else {
                this.dynamics.Add(r);
                this.dynArr = null;
            }
            r.SetIdx(this.flat.Count);
            this.flat.Add(r);
        }
        return r;
    }

    // 注册一条正则路由并返回 Route（可继续 fluent 配置）。
    public Route AddRegex(string method, string pattern, HttpHandler handler) {
        string m = method != null ? method : "";
        string p = pattern != null ? pattern : "";
        Route r = new Route(m, p, handler, true);
        lock (this) {
            this.regexes.Add(r);
            r.SetIdx(this.flat.Count);
            this.flat.Add(r);
        }
        return r;
    }

    // 路由键哈希预计算与槽位映射。
    private void HashRouteKeys() {
        this.statEntries = new List<RouteStatEntry>();
        for (int h = 0; h < this.flat.Count; h = h + 1) {
            string rk = this.flat[h].key;
            long hash = SharedTable.Hash(rk);
            this.statEntries.Add(new RouteStatEntry(rk, hash));
        }
    }

    // 新建统计表：每路由一行，hits 与 total_us 两列（容量为路由数+4）。
    private SharedTable NewStatsTable() {
        SharedTable t = new SharedTable("", this.flat.Count + 4);
        t.KeySize(128);
        t.ColumnInt("hits");
        t.ColumnInt("total_us");
        return t;
    }

    private void SeedStats(SharedTable t) {
        for (int i = 0; i < this.statEntries.Count; i = i + 1) {
            t.SetIntAt(this.statEntries[i].Hash(), "hits", 0);
            t.SetIntAt(this.statEntries[i].Hash(), "total_us", 0);
        }
    }

    public void InitStatsShared() {
        if (this.flat.Count == 0) { return; }
        if (this.routeStats != null) { return; }
        this.HashRouteKeys();
        SharedTable t = this.NewStatsTable();
        if (!t.CreateAnonymous()) { return; }
        t.Label("web route stats");
        this.SeedStats(t);
        this.routeStats = t;
    }

    public long StatsOsHandle() {
        if (this.routeStats == null) { return 0; }
        return this.routeStats.OsHandle();
    }

    public void AttachStats(long osHandle) {
        if (this.flat.Count == 0 || osHandle == 0) { return; }
        this.HashRouteKeys();
        SharedTable t = SharedTable.Attach(osHandle);
        if (!t.IsOpen()) { return; }
        t.Label("web route stats");
        this.routeStats = t;
    }

    public void InitRouteTableShared() {
        if (this.flat.Count == 0) { return; }
        if (this.routeTable != null) { return; }
        RouteTable rt = RouteTable.Create("", this.flat.Count + 16);
        if (rt == null) { return; }
        for (int i = 0; i < this.statics.Count; i = i + 1) {
            Route r = this.statics[i];
            int auth = (r.NeedsLogin() || r.NeedsAuth()) ? 1 : 0;
            int perm = 0;
            int menu = r.InMenu() ? 1 : 0;
            rt.Add(r.Method(), r.Pattern(), auth, perm, menu, r.Action(), r.Idx());
        }
        this.routeTable = rt;
    }

    public long RouteTableOsHandle() {
        if (this.routeTable == null) { return 0; }
        return this.routeTable.OsHandle();
    }

    public void AttachRouteTable(long osHandle) {
        if (osHandle == 0) { return; }
        this.routeTable = RouteTable.Attach(osHandle);
    }

    // computation.
    public void RecordHit(int idx, long us) {
        if (this.routeStats == null) { return; }
        if (this.statEntries == null || idx < 0 || idx >= this.statEntries.Count) { return; }
        long key = this.statEntries[idx].hash;
        this.routeStats.IncrementAt(key, "hits", 1);
        this.routeStats.IncrementAt(key, "total_us", us);
    }

    public List<Route> All() {
        List<Route> outp = new List<Route>();
        lock (this) {
            int i = 0;
            for (; i < this.statics.Count; i = i + 1) { outp.Add(this.statics[i]); }
            i = 0;
            while (i < this.dynamics.Count) { outp.Add(this.dynamics[i]); i = i + 1; }
            i = 0;
            while (i < this.regexes.Count) { outp.Add(this.regexes[i]); i = i + 1; }
        }
        return outp;
    }

    // 单个路由端点共享内存性能指标（路由、调用次数、平均微秒耗时）。
    public List<RouteHitDoc> Stats() {
        List<RouteHitDoc> outp = new List<RouteHitDoc>();
        if (this.routeStats == null) { return outp; }
        if (this.statEntries != null) {
            for (int i = 0; i < this.statEntries.Count; i = i + 1) {
                RouteStatEntry entry = this.statEntries[i];
                long hits = this.routeStats.GetIntAt(entry.Hash(), "hits");
                if (hits > 0) {
                    long totalUs = this.routeStats.GetIntAt(entry.Hash(), "total_us");
                    long avgUs = totalUs / hits;
                    outp.Add(new RouteHitDoc(entry.Key(), hits, avgUs));
                }
            }
        }
        return outp;
    }

    public string StatsJson() {
        return Json.Serialize<List<RouteHitDoc>>(this.Stats());
    }

    // GET 快捷（= Add("GET", ...)）。
    public Route Get(string pattern, HttpHandler handler) { return this.Add("GET", pattern, handler); }
    // POST 快捷。
    public Route Post(string pattern, HttpHandler handler) { return this.Add("POST", pattern, handler); }
    // PUT 快捷。
    public Route Put(string pattern, HttpHandler handler) { return this.Add("PUT", pattern, handler); }
    // DELETE 快捷。
    public Route Delete(string pattern, HttpHandler handler) { return this.Add("DELETE", pattern, handler); }

    // 纯同步路由注册（零协程帧分配快路径）。
    public Route AddSync(string method, string pattern, SyncHttpAction handler) {
        return this.Add(method, pattern, null).SyncAction(handler);
    }
    public Route GetSync(string pattern, SyncHttpAction handler) { return this.AddSync("GET", pattern, handler); }
    public Route PostSync(string pattern, SyncHttpAction handler) { return this.AddSync("POST", pattern, handler); }
    public Route PutSync(string pattern, SyncHttpAction handler) { return this.AddSync("PUT", pattern, handler); }
    public Route DeleteSync(string pattern, SyncHttpAction handler) { return this.AddSync("DELETE", pattern, handler); }

    // 正则快捷
    public Route GetRegex(string pattern, HttpHandler handler) { return this.AddRegex("GET", pattern, handler); }
    public Route PostRegex(string pattern, HttpHandler handler) { return this.AddRegex("POST", pattern, handler); }
    public Route PutRegex(string pattern, HttpHandler handler) { return this.AddRegex("PUT", pattern, handler); }
    public Route DeleteRegex(string pattern, HttpHandler handler) { return this.AddRegex("DELETE", pattern, handler); }

    private static int HashKey(string method, string path) {
        int h = 0x811C9DC5;
        if (method != null) {
            int mn = method.Length;
            if (mn > 0) {
                Span<byte> mb = new Span<byte>((nint)method, mn);
                for (int i = 0; i < mn; i = i + 1) {
                    h = ((h ^ (mb[i] & 255)) * 16777619) & 1073741823;
                }
            }
        }
        h = ((h ^ 32) * 16777619) & 1073741823;
        if (path != null) {
            int pn = path.Length;
            if (pn > 0) {
                Span<byte> pb = new Span<byte>((nint)path, pn);
                for (int i = 0; i < pn; i = i + 1) {
                    h = ((h ^ (pb[i] & 255)) * 16777619) & 1073741823;
                }
            }
        }
        return h;
    }

    private void RebuildIndex() {
        int statCnt = this.statics.Count;
        Route[] sarr = new Route[statCnt];
        for (int i = 0; i < statCnt; i = i + 1) { sarr[i] = this.statics[i]; }
        int cap = 16;
        while (cap < statCnt * 4) { cap = cap * 2; }
        int[] slots = new int[cap];
        Span<int> slotSpan = new Span<int>((nint)slots, cap);
        for (int i = 0; i < cap; i = i + 1) { slotSpan[i] = -1; }
        int mask = cap - 1;
        for (int i = 0; i < statCnt; i = i + 1) {
            Route r = sarr[i];
            int h = Router.HashKey(r.method, r.pattern) & mask;
            bool placed = false;
            while (!placed) {
                int si = slotSpan[h];
                if (si < 0) {
                    slotSpan[h] = i;
                    placed = true;
                } else {
                    Route other = sarr[si];
                    if (other.method == r.method && other.pattern == r.pattern) {
                        /* 重复注册先声明者赢（web_route_duplicate_key 钉的
                         * 口径）：同键后到者不进索引，首个 handler 继续服务。 */
                        placed = true;
                    } else {
                        h = (h + 1) & mask;
                    }
                }
            }
        }
        this.staticArr = sarr;
        this.hashMask = mask;
        this.hashSlots = slots;
    }

    private Route[] EnsureDynArr() {
        Route[] arr = this.dynArr;
        if (arr != null) { return arr; }
        lock (this) {
            if (this.dynArr == null) {
                int n = this.dynamics.Count;
                Route[] d = new Route[n];
                for (int i = 0; i < n; i = i + 1) { d[i] = this.dynamics[i]; }
                this.dynArr = d;
            }
            return this.dynArr;
        }
    }

    private Route FindStatic(string method, string path) {
        int[] slots = this.hashSlots;
        Route[] sarr = this.staticArr;
        if (slots == null || sarr == null) {
            lock (this) {
                if (this.hashSlots == null || this.staticArr == null) { this.RebuildIndex(); }
                slots = this.hashSlots;
                sarr = this.staticArr;
            }
        }
        int cap = slots.Length;
        int mask = cap - 1;
        Span<int> slotSpan = new Span<int>((nint)slots, cap);
        int h = Router.HashKey(method, path) & mask;
        for (int guard = 0; guard <= mask; guard = guard + 1) {
            int si = slotSpan[h];
            if (si < 0) { return null; }
            Route r = sarr[si];
            if (r.method == method && r.pattern == path) { return r; }
            h = (h + 1) & mask;
        }
        return null;
    }

    private static int CountPathSegs(string path) {
        if (path == null) { return 0; }
        int n = path.Length;
        if (n == 0) { return 0; }
        Span<byte> pb = new Span<byte>((nint)path, n);
        int count = 0;
        int i = 0;
        while (i < n) {
            while (i < n && pb[i] == 47) { i = i + 1; }
            if (i < n) {
                count = count + 1;
                while (i < n && pb[i] != 47) { i = i + 1; }
            }
        }
        return count;
    }

    // 零分配检查动态路由静态段是否全部吻合（不产生 SplitPath / Substring / StrMap 副作用）。
    private static bool MatchRouteStaticOnly(Route r, string path) {
        int count = r.segCount;
        string[] pat = r.segArr;
        string[] pnames = r.paramNameArr;
        int n = path != null ? path.Length : 0;
        Span<byte> pb = n > 0 ? new Span<byte>((nint)path, n) : new Span<byte>((nint)0, 0);
        int pos = 0;
        for (int i = 0; i < count; i = i + 1) {
            while (pos < n && pb[pos] == 47) { pos = pos + 1; }
            int start = pos;
            while (pos < n && pb[pos] != 47) { pos = pos + 1; }
            int slen = pos - start;
            if (slen == 0) { return false; }
            if (pnames[i].Length == 0) {
                string expected = pat[i];
                if (expected.Length != slen) { return false; }
                Span<byte> eb = new Span<byte>((nint)expected, slen);
                for (int k = 0; k < slen; k = k + 1) {
                    if (pb[start + k] != eb[k]) { return false; }
                }
            }
        }
        return true;
    }

    // 参数超过 4 个时的兜底提取。
    private static void ExtractRouteParams(Route r, string path, StrMap into) {
        int count = r.segCount;
        string[] pnames = r.paramNameArr;
        int n = path.Length;
        Span<byte> pb = new Span<byte>((nint)path, n);
        int pos = 0;
        for (int i = 0; i < count; i = i + 1) {
            while (pos < n && pb[pos] == 47) { pos = pos + 1; }
            int start = pos;
            while (pos < n && pb[pos] != 47) { pos = pos + 1; }
            string pname = pnames[i];
            if (pname.Length > 0) {
                into.Set(pname, path.Substring(start, pos - start));
            }
        }
    }

    // 单趟匹配静态段并顺手记录前 4 个参数切片位置（零堆分配，命中后免二次扫描 path）。
    private static bool MatchAndExtractDynamic(Route r, string path, HttpContext ctx) {
        int count = r.segCount;
        string[] pat = r.segArr;
        string[] pnames = r.paramNameArr;
        int n = path != null ? path.Length : 0;
        Span<byte> pb = n > 0 ? new Span<byte>((nint)path, n) : new Span<byte>((nint)0, 0);
        int pos = 0;
        int pcnt = 0;
        int p0s = 0; int p0l = 0; string p0n = "";
        int p1s = 0; int p1l = 0; string p1n = "";
        int p2s = 0; int p2l = 0; string p2n = "";
        int p3s = 0; int p3l = 0; string p3n = "";
        for (int i = 0; i < count; i = i + 1) {
            while (pos < n && pb[pos] == 47) { pos = pos + 1; }
            int start = pos;
            while (pos < n && pb[pos] != 47) { pos = pos + 1; }
            int slen = pos - start;
            if (slen == 0) { return false; }
            string pname = pnames[i];
            if (pname.Length == 0) {
                string expected = pat[i];
                if (expected.Length != slen) { return false; }
                Span<byte> eb = new Span<byte>((nint)expected, slen);
                for (int k = 0; k < slen; k = k + 1) {
                    if (pb[start + k] != eb[k]) { return false; }
                }
            } else {
                if (pcnt == 0) { p0s = start; p0l = slen; p0n = pname; }
                else if (pcnt == 1) { p1s = start; p1l = slen; p1n = pname; }
                else if (pcnt == 2) { p2s = start; p2l = slen; p2n = pname; }
                else if (pcnt == 3) { p3s = start; p3l = slen; p3n = pname; }
                pcnt = pcnt + 1;
            }
        }
        StrMap into = ctx.EnsureRouteParams();
        if (pcnt <= 4) {
            if (pcnt > 0) { into.Set(p0n, path.Substring(p0s, p0l)); }
            if (pcnt > 1) { into.Set(p1n, path.Substring(p1s, p1l)); }
            if (pcnt > 2) { into.Set(p2n, path.Substring(p2s, p2l)); }
            if (pcnt > 3) { into.Set(p3n, path.Substring(p3s, p3l)); }
        } else {
            Router.ExtractRouteParams(r, path, into);
        }
        return true;
    }

    public Route Match(HttpContext ctx) {
        string method = ctx.Method();
        string path = ctx.Path();

        // 静态路由直接查本地哈希索引；按已注册静态路径长度上下界快滤，动态长路径免算哈希。
        if (this.statics.Count > 0) {
            int plen = path.Length;
            if (plen >= this.minStaticLen && plen <= this.maxStaticLen) {
                Route hit = this.FindStatic(method, path);
                if (hit != null) { return hit; }
                if (this.hasWildcardStatic) {
                    hit = this.FindStatic("*", path);
                    if (hit != null) { return hit; }
                }
            }
            // 自动尾部斜杠容错：/about/company/ -> /about/company
            if (plen > 1 && (path[plen - 1] & 255) == 47) {
                int altLen = plen - 1;
                if (altLen >= this.minStaticLen && altLen <= this.maxStaticLen) {
                    string altPath = path.Substring(0, altLen);
                    Route hit = this.FindStatic(method, altPath);
                    if (hit != null) { return hit; }
                    if (this.hasWildcardStatic) {
                        hit = this.FindStatic("*", altPath);
                        if (hit != null) { return hit; }
                    }
                }
            }
        }

        // 动态分段路由（零 SplitPath 预分配，单趟验证静态段 + 栈记录前 4 参数位置）
        if (this.dynamics.Count > 0) {
            Route[] darr = this.EnsureDynArr();
            int dynCount = darr.Length;
            int segCount = Router.CountPathSegs(path);
            for (int i = 0; i < dynCount; i = i + 1) {
                Route r = darr[i];
                if (r.segCount == segCount && (r.method == method || r.method == "*")) {
                    if (Router.MatchAndExtractDynamic(r, path, ctx)) {
                        return r;
                    }
                }
            }
        }

        // 正则路由（支持命名捕获组及数字捕获组自动写入 ctx.routeParams）
        int regCount = this.regexes.Count;
        if (regCount > 0) {
            for (int ri = 0; ri < regCount; ri = ri + 1) {
                Route r = this.regexes[ri];
                if (r.Method() == method || r.Method() == "*") {
                    Match m = r.Regex().Find(path);
                    if (m.Success()) {
                        StrMap routeParams = ctx.EnsureRouteParams();
                        if (r.RegexGroupNames() != null) {
                            for (int gi = 0; gi < r.RegexGroupNames().Count; gi = gi + 1) {
                                string gname = r.RegexGroupNames()[gi];
                                if (gname.Length > 0) {
                                    int gnum = r.Regex().GroupNumber(gname);
                                    if (gnum >= 0 && m.GroupSuccess(gnum)) {
                                        routeParams.Set(gname, m.Group(gnum));
                                    }
                                }
                            }
                        }
                        for (int gi = 1; gi < m.GroupCount(); gi = gi + 1) {
                            if (m.GroupSuccess(gi)) {
                                routeParams.Set(Convert.ToString(gi), m.Group(gi));
                            }
                        }
                        return r;
                    }
                }
            }
        }
        return null;
    }

    public bool PathExists(string path) {
        if (path == null) { return false; }
        int statCnt = this.statics.Count;
        for (int i = 0; i < statCnt; i = i + 1) {
            if (this.statics[i].Pattern() == path) { return true; }
        }
        int plen = path.Length;
        if (plen > 1 && (path[plen - 1] & 255) == 47) {
            string altPath = path.Substring(0, plen - 1);
            for (int i = 0; i < statCnt; i = i + 1) {
                if (this.statics[i].Pattern() == altPath) { return true; }
            }
        }
        int dynCount = this.dynamics.Count;
        if (dynCount > 0) {
            Route[] darr = this.EnsureDynArr();
            int segCount = Router.CountPathSegs(path);
            for (int i = 0; i < dynCount; i = i + 1) {
                Route r = darr[i];
                if (r.segCount == segCount && Router.MatchRouteStaticOnly(r, path)) { return true; }
            }
        }
        int regCount = this.regexes.Count;
        if (regCount > 0) {
            for (int ri = 0; ri < regCount; ri = ri + 1) {
                if (this.regexes[ri].Regex().IsMatch(path)) { return true; }
            }
        }
        return false;
    }

    // 模式不含 {param} 段（即无 '{'）时为静态路由。
    public static bool IsStatic(string pattern) {
        if (pattern == null || pattern.Length == 0) { return true; }
        return NativeMemory.Find((nint)pattern, 0, 123, pattern.Length) < 0;
    }

    // 段数相等且逐段相等；利用预编译的 paramNames 零分配写入 into。
    public static bool MatchRoute(Route r, List<string> segs, StrMap into) {
        int count = r.segCount;
        if (count != segs.Count) { return false; }
        string[] pat = r.segArr;
        string[] pnames = r.paramNameArr;
        // 1. 先验证所有静态段是否吻合，不产生中间副作用
        for (int i = 0; i < count; i = i + 1) {
            if (pnames[i].Length == 0 && pat[i] != segs[i]) {
                return false;
            }
        }
        // 2. 全部匹配后才写入提取的参数
        for (int i = 0; i < count; i = i + 1) {
            string pname = pnames[i];
            if (pname.Length > 0) {
                into.Set(pname, segs[i]);
            }
        }
        return true;
    }

    // 段数相等且逐段相等；{param} 段匹配任意段并把值写入 into。
    public static bool MatchSegs(List<string> pat, List<string> segs, StrMap into) {
        int count = pat.Count;
        if (count != segs.Count) { return false; }
        // 1. 先验证非参数段是否完全吻合
        for (int i = 0; i < count; i = i + 1) {
            string p = pat[i];
            if (!(p.Length > 2 && (p[0] & 255) == 123
                && (p[p.Length - 1] & 255) == 125)) {  // '{' '}'
                if (p != segs[i]) { return false; }
            }
        }
        // 2. 确认全部匹配后才写入参数
        for (int i = 0; i < count; i = i + 1) {
            string p = pat[i];
            if (p.Length > 2 && (p[0] & 255) == 123
                && (p[p.Length - 1] & 255) == 125) {  // '{' '}'
                into.Set(p.Substring(1, p.Length - 2), segs[i]);
            }
        }
        return true;
    }

    // 按 '/' 切分并去掉空段（"/a//b/" -> ["a","b"]）。
    public static List<string> SplitPath(string path) {
        List<string> outp = new List<string>();
        if (path == null) { return outp; }
        int n = path.Length;
        if (n == 0) { return outp; }
        Span<byte> pb = new Span<byte>((nint)path, n);
        int i = 0;
        while (i < n) {
            while (i < n && pb[i] == 47) { i = i + 1; }  // '/'
            int e = i;
            while (e < n && pb[e] != 47) { e = e + 1; }  // '/'
            if (e > i) { outp.Add(path.Substring(i, e - i)); }
            i = e;
        }
        return outp;
    }
}
