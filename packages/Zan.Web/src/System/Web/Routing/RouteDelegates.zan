using System;

namespace System.Web;

// 异步请求处理器委托签名。
public async delegate void HttpHandler(HttpContext ctx);

// 同步请求处理器快路径委托签名：已同步完成响应则返回 true，需回退异步派发则返回 false。
public delegate bool SyncHttpHandler(HttpContext ctx);

// 纯同步路由动作委托签名（无返回值的直接同步处理，零协程帧分配）。
public delegate void SyncHttpAction(HttpContext ctx);
