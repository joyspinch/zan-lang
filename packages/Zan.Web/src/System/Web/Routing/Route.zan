using System;
using System.Collections.Generic;
using System.Text.RegularExpressions;

namespace System.Web;

public class Route {
    private string method;
    private string pattern;
    private List<string> segs;
    // 逐段预提取的参数名（若为 "{id}" 则存 "id"，静态段存 ""，避免运行时重复 Substring）
    private List<string> paramNames;
    private HttpHandler handler;
    private string key;
    private string action;  // "Controller.Method" -- for docs / menu / diagnostics

    // 正则路由属性
    private bool isRegex;
    private Regex regex;
    private List<string> regexGroupNames;

    // [Title] 人类可读标题（菜单文案 / 文档）。
    private string title;  // [Title] human label (menu text / docs)
    // [Custom(ApiMax=n)] 每秒请求上限；0（默认）不限——限流须显式声明。
    private int rateLimit;
    private string rateScope;
    private bool needsLogin;  // Authorization = Login: a resolved user is required
    private bool needsAuth;
    private string lockScope;  // [Lock]  request lock: "" none | "user" | "global"
    private bool streamUpload;
    // [Menu] 在管理菜单展示本路由；节与文案来自 URL 和 [Description]。
    private bool inMenu;
    // 路由参数元数据，由编译器根据动作签名与特性自动生成。
    private List<ApiParam> docParams;
    // 自由属性表（Rank/ApiMax/Component/Icon/ContentType/...）。
    private StrMap meta;

    // 路由平坦表紧凑索引。
    private int idx;

    // 构造路由：模式立即按 '/' 预切分为段。
    public Route(string method, string pattern, HttpHandler handler) {
        this.method = method;
        this.pattern = pattern;
        this.segs = Router.SplitPath(pattern);
        this.paramNames = new List<string>();
        for (int si = 0; si < this.segs.Count; si = si + 1) {
            string sp = this.segs[si];
            if (sp.Length > 2 && (sp[0] & 255) == 123 && (sp[sp.Length - 1] & 255) == 125) {
                this.paramNames.Add(sp.Substring(1, sp.Length - 2));
            } else {
                this.paramNames.Add("");
            }
        }
        this.handler = handler;
        this.key = method + " " + pattern;
        this.action = "";
        this.title = "";
        this.rateLimit = 0;
        this.rateScope = "route";
        this.needsLogin = false;
        this.needsAuth = false;
        this.lockScope = "";
        this.streamUpload = false;
        this.inMenu = false;
        this.docParams = new List<ApiParam>();
        this.meta = new StrMap();
        this.idx = -1;
        this.isRegex = false;
        this.regex = null;
        this.regexGroupNames = null;
    }

    // 正则路由构造函数
    public Route(string method, string pattern, HttpHandler handler, bool isRegex) {
        this.method = method;
        this.pattern = pattern;
        this.segs = new List<string>();
        this.paramNames = new List<string>();
        this.handler = handler;
        this.key = method + " " + pattern;
        this.action = "";
        this.title = "";
        this.rateLimit = 0;
        this.rateScope = "route";
        this.needsLogin = false;
        this.needsAuth = false;
        this.lockScope = "";
        this.streamUpload = false;
        this.inMenu = false;
        this.docParams = new List<ApiParam>();
        this.meta = new StrMap();
        this.idx = -1;
        this.isRegex = isRegex;
        if (isRegex) {
            this.regex = new Regex(pattern);
            this.regexGroupNames = this.regex.GroupNames();
        } else {
            this.regex = null;
            this.regexGroupNames = null;
        }
    }

    // 动作名（"Controller.Method"，文档/菜单/诊断用）。
    public Route Named(string action) { this.action = action; return this; }
    // 标题（菜单文案 / 文档 summary）。
    public Route Title(string title) { this.title = title; return this; }
    // 每秒限流上限；0 不限流。
    public Route Limit(int maxPerWindow) { this.rateLimit = maxPerWindow; return this; }
    // 同时设限流上限与维度（"route"/"uid"/"ip"）。
    public Route LimitBy(int maxPerWindow, string scope) {
        this.rateLimit = maxPerWindow;
        this.rateScope = scope;
        return this;
    }
    // 只设限流维度不改上限。
    public Route RateBy(string scope) { this.rateScope = scope; return this; }
    // 要求已解析的登录用户（未登录 401）。
    public Route Login() { this.needsLogin = true; return this; }
    // 要求登录 + 对 `action` 的权限（无权 403）；蕴含 Login。
    public Route Auth() { this.needsAuth = true; this.needsLogin = true; return this; }
    // 请求锁维度："" 无 | "user" 用户级 | "global" 全局。
    public Route Lock(string scope) { this.lockScope = scope; return this; }
    // 请求体流式写盘而非驻留内存（大文件上传）。
    public Route Upload() { this.streamUpload = true; return this; }
    // 在管理菜单中展示本路由（节与文案来自 URL 和 [Description]）。
    public Route Menu() { this.inMenu = true; return this; }
    // 写入自由属性（Rank/ApiMax/Component/Icon/ContentType/...）。
    public Route Meta(string key, string val) { this.meta.Set(key, val); return this; }
    // 请求参数元数据描述符（由编译器根据动作签名生成）。
    public Route Param(string name, string type, bool required, string def, string desc,
                string source) {
        for (int i = 0; i < this.docParams.Count; i = i + 1) {
            if (this.docParams[i].Name() == name) { return this; }
        }
        this.docParams.Add(new ApiParam(name, type, required, def, desc, source));
        return this;
    }
    // 读自由属性；缺失返回空串。
    public string MetaGet(string key) { return this.meta.Get(key); }

    // 预计算的 "METHOD pattern"（每请求统计/锁键）。
    public string Key() { return this.key; }

    public string Method() { return this.method; }
    public string Pattern() { return this.pattern; }
    public List<string> Segs() { return this.segs; }
    public List<string> ParamNames() { return this.paramNames; }
    public HttpHandler Handler() { return this.handler; }
    public string Action() { return this.action; }
    public bool IsRegex() { return this.isRegex; }
    public Regex Regex() { return this.regex; }
    public List<string> RegexGroupNames() { return this.regexGroupNames; }
    public string GetTitle() { return this.title; }
    public string Title() { return this.title; }
    public int RateLimit() { return this.rateLimit; }
    public string RateScope() { return this.rateScope; }
    public bool NeedsLogin() { return this.needsLogin; }
    public bool NeedsAuth() { return this.needsAuth; }
    public string LockScope() { return this.lockScope; }
    public bool StreamUpload() { return this.streamUpload; }
    public bool InMenu() { return this.inMenu; }
    public List<ApiParam> DocParams() { return this.docParams; }
    public StrMap GetMeta() { return this.meta; }
    public int Idx() { return this.idx; }
    public void SetIdx(int idx) { this.idx = idx; }
}
