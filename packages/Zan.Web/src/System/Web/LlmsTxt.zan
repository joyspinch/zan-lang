using System;
using System.Collections.Generic;
using System.Text;

namespace System.Web;

/* LlmsLink -- llms.txt 链接条目。 */
class LlmsLink {
    string title;
    string url;
    string description;
    string fullContent;

    LlmsLink(string t, string u, string d, string fc) {
        this.title = t;
        this.url = u;
        this.description = d;
        this.fullContent = fc;
    }

    string Title() { return this.title; }
    string Url() { return this.url; }
    string Description() { return this.description; }
    string FullContent() { return this.fullContent; }
}

/* LlmsSection -- llms.txt 分组节。 */
class LlmsSection {
    string name;
    List<LlmsLink> links;

    LlmsSection(string n) {
        this.name = n;
        this.links = new List<LlmsLink>();
    }

    string Name() { return this.name; }
    List<LlmsLink> Links() { return this.links; }

    void Add(string title, string url, string desc, string fullContent) {
        this.links.Add(new LlmsLink(title, url, desc, fullContent));
    }
}

/* LlmsTxt -- 专为生成式 AI 搜索引擎和 LLM 爬虫自动构建标准的 llms.txt 与 llms-full.txt。 */
class LlmsTxt {
    string title;
    string summary;
    string details;
    List<LlmsSection> sections;

    LlmsTxt(string t, string s) {
        this.title = t;
        this.summary = s;
        this.details = "";
        this.sections = new List<LlmsSection>();
    }

    static LlmsTxt Create(string title, string summary) {
        return new LlmsTxt(title, summary);
    }

    LlmsTxt SetDetails(string d) {
        this.details = d;
        return this;
    }

    /* 添加分节与链接 */
    LlmsTxt AddLink(string sectionName, string title, string url, string desc) {
        return this.AddFullLink(sectionName, title, url, desc, "");
    }

    LlmsTxt AddFullLink(string sectionName, string title, string url, string desc, string fullContent) {
        LlmsSection sec = null;
        for (int i = 0; i < this.sections.Count; i = i + 1) {
            if (this.sections[i].Name() == sectionName) {
                sec = this.sections[i];
                break;
            }
        }
        if (sec == null) {
            sec = new LlmsSection(sectionName);
            this.sections.Add(sec);
        }
        sec.Add(title, url, desc, fullContent);
        return this;
    }

    /* 生成规范的 llms.txt Markdown 文本 */
    string ToMarkdown() {
        StringBuilder sb = new StringBuilder();
        sb.Append("# ");
        sb.Append(this.title);
        sb.Append("\n\n");

        if (this.summary.Length > 0) {
            sb.Append("> ");
            sb.Append(this.summary);
            sb.Append("\n\n");
        }

        if (this.details.Length > 0) {
            sb.Append(this.details);
            sb.Append("\n\n");
        }

        for (int i = 0; i < this.sections.Count; i = i + 1) {
            LlmsSection sec = this.sections[i];
            sb.Append("## ");
            sb.Append(sec.Name());
            sb.Append("\n\n");

            List<LlmsLink> links = sec.Links();
            for (int j = 0; j < links.Count; j = j + 1) {
                LlmsLink link = links[j];
                sb.Append("- [");
                sb.Append(link.Title());
                sb.Append("](");
                sb.Append(link.Url());
                sb.Append(")");
                if (link.Description().Length > 0) {
                    sb.Append(": ");
                    sb.Append(link.Description());
                }
                sb.Append("\n");
            }
            sb.Append("\n");
        }

        return sb.ToString();
    }

    /* 生成聚合长文本 llms-full.txt，便于 AI 引擎单次抓取完整上下文 */
    string ToFullMarkdown() {
        StringBuilder sb = new StringBuilder();
        sb.Append(this.ToMarkdown());
        sb.Append("\n---\n\n");

        for (int i = 0; i < this.sections.Count; i = i + 1) {
            LlmsSection sec = this.sections[i];
            List<LlmsLink> links = sec.Links();
            for (int j = 0; j < links.Count; j = j + 1) {
                LlmsLink link = links[j];
                if (link.FullContent().Length > 0) {
                    sb.Append("### ");
                    sb.Append(link.Title());
                    sb.Append("\n\nURL: ");
                    sb.Append(link.Url());
                    sb.Append("\n\n");
                    sb.Append(link.FullContent());
                    sb.Append("\n\n---\n\n");
                }
            }
        }

        return sb.ToString();
    }
}
