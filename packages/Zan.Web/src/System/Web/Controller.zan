using System.Text;
using System;

namespace System.Web;

// 未授权重定向的登录页路由（未配置时默认返回 401 JSON）。
public class Controller {
    public HttpContext ctx;
    // 已解析的登录主体 id（匿名时为 ""）。
    public string uid;  // resolved principal id ("" when anonymous)
    string __viewKey;
    GeoMeta geoMeta;

    public void __Bind(HttpContext c) {
        this.ctx = c;
        this.uid = c.uid;
    }

    // 动作前置同步钩子，返回 false 则短路拦截后续执行。
    public bool __Before() { return this.OnBefore(); }

    // 动作前置异步钩子，运行于请求协程内以支持等待 I/O 资源。
    public async bool __BeforeAsync() { return await this.OnBeforeAsync(); }

    // 路由意图标记 (ReadOnly)：供连接池按读写分离获取数据库连接。
    public virtual void __UseReadOnly() { }

    // 控制器异步前置设置，支持重写以执行依赖准备工作。
    public virtual async bool OnBeforeAsync() { return this.OnBefore(); }

    public void __After() { this.OnAfter(); }

    // 动作后置异步清理钩子，释放事务或归还连接池资源。
    public async void __AfterAsync() { await this.OnAfterAsync(); }

    // 控制器异步后置清理，支持重写以处理资源回收。
    public virtual async void OnAfterAsync() { this.OnAfter(); }

    // [Tx] 声明式事务跳板钩子：开启请求级事务，失败时返回 false。
    public virtual async bool __TxBegin() { return true; }

    // [Tx] 声明式事务跳板钩子：开启请求级事务，失败时返回 false。
    public virtual async void __TxCommit() { }

    // [Tx] 声明式事务跳板钩子：开启请求级事务，失败时返回 false。
    public virtual async void __TxRollback() { }

    // 控制器级前置守卫钩子，返回 false 拦截请求。
    public virtual bool OnBefore() { return true; }

    public virtual void OnAfter() { }

    // 本实例绑定的请求上下文。
    public HttpContext Ctx() { return this.ctx; }
    // 本次请求是否已解析出登录用户。
    public bool IsLogin() { return this.uid.Length > 0; }

    // 过滤后的参数（trim + 去控制符；route → query → form 合并）。
    public string In(string name) { return this.ctx.In(name); }
    // 原始未过滤值：多行语义字段专用，渲染转义由调用方负责。
    public string InRaw(string name) { return this.ctx.InRaw(name); }
    // 过滤并 HTML 转义的参数（可直接渲染进页面）。
    public string InText(string name) { return this.ctx.InText(name); }
    // 过滤后的整型；缺失/非法取 def（严格整串解析）。
    public int InInt(string name, int def) { return this.ctx.InInt(name, def); }
    // 过滤后的 64 位整型；规则同 InInt。
    public long InLong(string name, long def) { return this.ctx.InLong(name, def); }
    // 过滤后的数值；缺失/非法取 def。
    public double InDouble(string name, double def) { return this.ctx.InDouble(name, def); }
    // 布尔参数："1/true/on/yes" 真，"0/false/off/no" 假，其余 def。
    public bool InBool(string name, bool def) { return this.ctx.InBool(name, def); }
    // 参数是否在 form/query/route 任一处出现。
    public bool HasIn(string name) { return this.ctx.HasIn(name); }
    // 路由参数（{param} 段）。
    public string Param(string name) { return this.ctx.Param(name); }
    // 原始请求正文。
    public string Body() { return this.ctx.Body(); }

    // 必要参数校验与提取。

    public string Need(string name, string label) {
        string v = this.ctx.In(name);
        if (v.Length == 0) { throw new ApiError(400, "0003", label + "不能为空"); }
        return v;
    }

    public string NeedText(string name, string label) {
        string v = this.ctx.InText(name);
        if (v.Length == 0) { throw new ApiError(400, "0003", label + "不能为空"); }
        return v;
    }

    // 获取必填整数参数（缺失或非整数时中断并返回 400）。
    public int NeedInt(string name, string label) {
        string raw = this.ctx.In(name);
        if (raw.Length == 0) { throw new ApiError(400, "0003", label + "不能为空"); }
        int sentinel = 0 - 2147483647 - 1;
        int v = Filter.ToInt(raw, sentinel);
        if (v == sentinel) { throw new ApiError(400, "0003", label + "必须是整数"); }
        return v;
    }

    public long NeedLong(string name, string label) {
        string raw = this.ctx.In(name);
        if (raw.Length == 0) { throw new ApiError(400, "0003", label + "不能为空"); }
        long sentinel = -9223372036854775807;
        long v = Filter.ToLong(raw, sentinel);
        if (v == sentinel) { throw new ApiError(400, "0003", label + "必须是整数"); }
        return v;
    }

    // 获取必填数值参数（缺失或非数值时中断并返回 400）。
    public double NeedDouble(string name, string label) {
        string raw = this.ctx.In(name);
        if (raw.Length == 0) { throw new ApiError(400, "0003", label + "不能为空"); }
        double sentinel = -1.7976931348623157e308;
        double v = Filter.ToDouble(raw, sentinel);
        if (v == sentinel) { throw new ApiError(400, "0003", label + "必须是数字"); }
        return v;
    }

    // 获取必填布尔标记参数（缺失时中断并返回 400）。
    public bool NeedBool(string name, string label) {
        string raw = this.ctx.In(name);
        if (raw.Length == 0) { throw new ApiError(400, "0003", label + "不能为空"); }
        return Filter.ToBool(raw, false);
    }

    public bool WantsJson() {
        if (this.ctx.Header("HX-Request").Length > 0) { return true; }
        if (this.ctx.Header("X-Requested-With").Length > 0) { return true; }
        string accept = this.ctx.Header("Accept");
        return accept.Contains("application/json");
    }

    public ListQuery Paged(string defOrder, int defLimit) {
        return ListQuery.From(this.ctx, defOrder, defLimit, 200);
    }

    public void Ok(string data) { this.ctx.Api("0000", "ok", data); }

    public void Fail(int status, string code, string msg) {
        throw new ApiError(status, code, msg);
    }

    // 以 application/json 应答。
    public void Json(string json) { this.ctx.Json(json); }
    // 以 text/plain 应答。
    public void Text(string text) { this.ctx.Text(text); }
    // 以 text/html 应答。
    public void Html(string html) { this.ctx.Html(html); }
    // 以 text/markdown 应答（专供 AI 爬虫或客户端内容协商）。
    public void Markdown(string md) { this.ctx.Markdown(md); }

    // 获取当前控制器的 GEO/SEO 元数据构建器。
    public GeoMeta Geo() {
        if (this.geoMeta == null) {
            this.geoMeta = GeoMeta.Create();
        }
        return this.geoMeta;
    }

    // 判断请求客户端是否命中生成式 AI 搜索引擎爬虫。
    public bool IsAiBot() { return this.ctx.IsAiBot(); }

    // 判断当前请求是否期望接收 Markdown 降级内容。
    public bool WantsMarkdown() { return this.ctx.WantsMarkdown(); }

    public void __SetView(string key) { this.__viewKey = key; }

    private void ApplyGeoHeaders() {
        if (this.geoMeta != null) {
            string canonical = this.geoMeta.GetCanonical();
            if (canonical.Length > 0) {
                this.ctx.SetHeader("Link", "<" + canonical + ">; rel=\"canonical\"");
            }
        }
        WebApp app = WebHost.Current();
        if (app != null && app.Llms() != null) {
            this.ctx.SetHeader("Link", "</.well-known/llms.txt>; rel=\"llms-txt\"");
        }
    }

    public void View(ViewData data) {
        this.ApplyGeoHeaders();
        if (this.geoMeta != null && data != null) {
            data.Set("geo_head", this.geoMeta.RenderHead());
        }
        this.ctx.Html(WebHost.Current().RenderPage(this.__viewKey, data));
    }

    public void Fragment(ViewData data) {
        this.ctx.Html(WebHost.Current().RenderFragment(this.__viewKey, data));
    }

    public void FragmentOf(string name, ViewData data) {
        this.ctx.Html(WebHost.Current().RenderFragment(name, data));
    }

    public void ViewOf(string name, ViewData data) {
        this.ApplyGeoHeaders();
        if (this.geoMeta != null && data != null) {
            data.Set("geo_head", this.geoMeta.RenderHead());
        }
        this.ctx.Html(WebHost.Current().RenderPage(name, data));
    }

    // GEO 智能双模视图：当检测到 AI 爬虫或请求协商 Markdown 时，返回高密度纯净 Markdown；否则渲染正常 HTML 视图。
    public void SmartView(ViewData data, string markdownBody = "") {
        this.ApplyGeoHeaders();
        if (this.WantsMarkdown()) {
            if (markdownBody.Length > 0) {
                this.Markdown(markdownBody);
                return;
            }
        }
        this.View(data);
    }

    // GEO 智能双模视图（指定视图名）。
    public void SmartViewOf(string name, ViewData data, string markdownBody = "") {
        this.ApplyGeoHeaders();
        if (this.WantsMarkdown()) {
            if (markdownBody.Length > 0) {
                this.Markdown(markdownBody);
                return;
            }
        }
        this.ViewOf(name, data);
    }
}
