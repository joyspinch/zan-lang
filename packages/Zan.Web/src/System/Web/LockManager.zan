using System;
using System.Threading;

namespace System.Web;

// (PermissionFn).
async delegate string AuthFn(string token);
async delegate bool PermissionFn(string uid, string action);

// Request-lock registry: the typed replacement for the PHP "接口请求锁" pattern.
class LockManager {
    SharedTable table;
    long ownerSequence;
    long leaseMs;

    LockManager() {
        this.ownerSequence = 0;
        this.leaseMs = 30000;
    }

    // 新建锁表：65536 键位，单列 owner。
    static SharedTable NewTable() {
        SharedTable t = new SharedTable("", 65536);
        t.KeySize(192);
        t.ColumnInt("owner");
        return t;
    }

    static LockManager Owned() {
        LockManager m = new LockManager();
        SharedTable t = LockManager.NewTable();
        if (t.CreateAnonymous()) {
            t.Label("web request lock");
            m.table = t;
        }
        return m;
    }

    static LockManager Attach(long osHandle) {
        LockManager m = new LockManager();
        if (osHandle == 0) { return m; }
        SharedTable t = SharedTable.Attach(osHandle);
        if (t.IsOpen()) {
            t.Label("web request lock");
            m.table = t;
        }
        return m;
    }

    long OsHandle() {
        if (this.table == null) { return 0; }
        return this.table.OsHandle();
    }

    // 依 [Lock] 维度构锁键："user" → "u:<principal>:<路由键>"
    // （匿名者记 _anon_），"global" → "g:<路由键>"；未声明锁维度
    // 返回空串。
    static string KeyFor(Route route, string principal) {
        if (route.lockScope == "user") {
            string who = principal;
            if (who.Length == 0) { who = "_anon_"; }
            return "u:" + who + ":" + route.Key();
        }
        if (route.lockScope == "global") {
            return "g:" + route.Key();
        }
        return "";
    }

    // 取租约：键为空、表未就绪或键已被持有都返回 null。
    LockLease TryAcquire(string key) {
        if (key.Length == 0) { return null; }
        if (this.table == null) { return null; }
        this.ownerSequence = this.ownerSequence + 1;
        long owner = this.ownerSequence;
        if (!this.table.TryAcquireLease(key, owner, -1, this.leaseMs)) {
            return null;
        }
        return new LockLease(key, owner);
    }

    // 释放租约（须为本持有者）；lease 为 null 或表未就绪时静默返回。
    void Release(LockLease lease) {
        if (lease == null || this.table == null) { return; }
        this.table.ReleaseLease(lease.key, lease.owner);
    }
}
