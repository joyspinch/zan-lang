using System;
using System.Collections.Generic;

namespace System.Web;

public class StrMap {
    private Dictionary<string, string> map;

    public StrMap() {
        this.map = null;
    }

    // 键数；尚未写入过为 0。
    public int Count() {
        if (this.map == null) { return 0; }
        return this.map.Count;
    }

    // 写入键值（首次写入时才创建底层字典）。
    public void Set(string key, string val) {
        if (this.map == null) {
            this.map = new Dictionary<string, string>();
        }
        this.map[key] = val;
    }

    // 是否含该键。
    public bool Has(string key) {
        if (this.map == null) { return false; }
        return this.map.ContainsKey(key);
    }

    // 取值；缺失返回空串。
    public string Get(string key) { return this.GetOr(key, ""); }

    // 取值；缺失返回 def。
    public string GetOr(string key, string def) {
        if (this.map == null) { return def; }
        string val;
        if (this.map.TryGetValue(key, out val)) { return val; }
        return def;
    }

    // 清空底层字典（保留已分配容量，避免后续写入反复 new Dictionary）。
    public void Clear() {
        if (this.map != null) {
            this.map.Clear();
        }
    }

    // 删除键。
    public void Remove(string key) {
        if (this.map == null) { return; }
        this.map.Remove(key);
    }
}
