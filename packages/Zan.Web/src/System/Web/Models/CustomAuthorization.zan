using System;

namespace System.Web;

enum CustomAuthorization {
    Unknown,   // 未声明：默认按 Login 强制登录处理（安全基线，fail-closed）
    None,      // 不检测登录：完全公开（如登录页、公开静态/落地页、健康检查）
    Auth,      // 只检测登录：不强制，登录了就能拿到当前用户（如博客前台）
    Login,     // 强制登录：未登录跳登录页 / 401，但不查权限
    Grant,     // 强制登录 + 该路由 action 的授权（后台页面/接口）
    ApiAuth    // 同 Grant，用于以 token 调用的接口
}
