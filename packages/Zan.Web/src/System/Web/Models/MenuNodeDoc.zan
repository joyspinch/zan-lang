using System;
using System.Collections.Generic;

namespace System.Web;

public class MenuNodeDoc {
    public string title;
    public string path;
    public string group;
    public string icon;
    public bool active;

    public MenuNodeDoc() {
        this.title = "";
        this.path = "";
        this.group = "";
        this.icon = "";
        this.active = false;
    }

    public MenuNodeDoc(string title, string path, string group, string icon, bool active) {
        this.title = title;
        this.path = path;
        this.group = group;
        this.icon = icon;
        this.active = active;
    }

    public string Title() { return this.title; }
    public string Path() { return this.path; }
    public string Group() { return this.group; }
    public string Icon() { return this.icon; }
    public bool Active() { return this.active; }

    public MenuNodeDoc SetTitle(string v) { this.title = v; return this; }
    public MenuNodeDoc SetPath(string v) { this.path = v; return this; }
    public MenuNodeDoc SetGroup(string v) { this.group = v; return this; }
    public MenuNodeDoc SetIcon(string v) { this.icon = v; return this; }
    public MenuNodeDoc SetActive(bool v) { this.active = v; return this; }
}
