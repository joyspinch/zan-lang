using System;
using System.Collections.Generic;

namespace System.Web;

public class ViewData {
    public StrMap vars;
    public List<RowList> lists;

    public ViewData() {
        this.vars = new StrMap();
        this.lists = new List<RowList>();
    }

    // 设置字符串变量（可链式）。
    public ViewData Set(string key, string val) { this.vars.Set(key, val); return this; }

    // 新增具名行列表并返回其行（直接追加行即为填充数据）。
    public List<StrMap> AddList(string name) {
        RowList rl = new RowList(name);
        this.lists.Add(rl);
        return rl.rows;
    }

    // 取具名行列表；没有则 null。
    public List<StrMap> ListOf(string name) {
        for (int i = 0; i < this.lists.Count; i = i + 1) {
            if (this.lists[i].name == name) { return this.lists[i].rows; }
        }
        return null;
    }
}

