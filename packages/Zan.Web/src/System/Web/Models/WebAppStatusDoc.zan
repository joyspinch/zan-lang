using System;
using System.Collections.Generic;

namespace System.Web;

public class WebAppStatusDoc {
    public int total_requests;
    public int active_connections;
    public List<RouteHitDoc> routes;

    public WebAppStatusDoc() {
        this.total_requests = 0;
        this.active_connections = 0;
        this.routes = new List<RouteHitDoc>();
    }

    public WebAppStatusDoc(int totalRequests, int activeConnections, List<RouteHitDoc> routes) {
        this.total_requests = totalRequests;
        this.active_connections = activeConnections;
        this.routes = routes;
    }

    public int TotalRequests() { return this.total_requests; }
    public int ActiveConnections() { return this.active_connections; }
    public List<RouteHitDoc> Routes() { return this.routes; }

    public WebAppStatusDoc SetTotalRequests(int v) { this.total_requests = v; return this; }
    public WebAppStatusDoc SetActiveConnections(int v) { this.active_connections = v; return this; }
    public WebAppStatusDoc SetRoutes(List<RouteHitDoc> v) { this.routes = v; return this; }
}
