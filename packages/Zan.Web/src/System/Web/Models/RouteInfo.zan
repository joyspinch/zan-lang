using System;

namespace System.Web;

/// <summary>
/// 跨进程共享内存路由属性与查找结果实体模型
/// </summary>
public class RouteInfo {
    private bool found;
    private int auth;       // 1: 需要登录会话
    private int perm;       // 权限位掩码
    private int menu;       // 1: 显示在导航菜单
    private int routeIdx;   // 路由槽位索引
    private string handler;

    public RouteInfo() {
        this.found = false;
        this.auth = 0;
        this.perm = 0;
        this.menu = 0;
        this.routeIdx = -1;
        this.handler = "";
    }

    public RouteInfo(bool found, int auth, int perm, int menu, int routeIdx, string handler) {
        this.found = found;
        this.auth = auth;
        this.perm = perm;
        this.menu = menu;
        this.routeIdx = routeIdx;
        this.handler = handler;
    }

    public bool Found() { return this.found; }
    public int Auth() { return this.auth; }
    public int Perm() { return this.perm; }
    public int Menu() { return this.menu; }
    public int RouteIdx() { return this.routeIdx; }
    public string Handler() { return this.handler; }
}
