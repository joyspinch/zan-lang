using System;

namespace System.Web;

public class RouteHitDoc {
    public string route;
    public long count;
    public long avg_us;

    public RouteHitDoc() {
        this.route = "";
        this.count = 0;
        this.avg_us = 0;
    }

    public RouteHitDoc(string route, long count, long avg_us) {
        this.route = route;
        this.count = count;
        this.avg_us = avg_us;
    }

    public string Route() { return this.route; }
    public long Count() { return this.count; }
    public long AvgUs() { return this.avg_us; }

    public RouteHitDoc SetRoute(string v) { this.route = v; return this; }
    public RouteHitDoc SetCount(long v) { this.count = v; return this; }
    public RouteHitDoc SetAvgUs(long v) { this.avg_us = v; return this; }
}

// 异步请求处理器委托签名。
public async delegate void HttpHandler(HttpContext ctx);

// 已注册的路由描述符：预分段路径以实现高效参数匹配。
