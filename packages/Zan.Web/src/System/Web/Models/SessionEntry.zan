using System;

namespace System.Web;

internal class SessionEntry {
    internal string token;
    internal string uid;
    internal int expiresAt;
    internal SessionEntry prev;
    internal SessionEntry next;

    internal SessionEntry() {
        this.token = "";
        this.uid = "";
        this.expiresAt = 0;
        this.prev = null;
        this.next = null;
    }

    internal SessionEntry(string token, string uid, int expiresAt) {
        this.token = token;
        this.uid = uid;
        this.expiresAt = expiresAt;
        this.prev = null;
        this.next = null;
    }
}
