using System;

namespace System.Web;

public class SessionEntry {
    public string token;
    public string uid;
    public int expiresAt;
    public SessionEntry prev;
    public SessionEntry next;

    public SessionEntry() {
        this.token = "";
        this.uid = "";
        this.expiresAt = 0;
        this.prev = null;
        this.next = null;
    }

    public SessionEntry(string token, string uid, int expiresAt) {
        this.token = token;
        this.uid = uid;
        this.expiresAt = expiresAt;
        this.prev = null;
        this.next = null;
    }
}
