using System;
using System.Collections.Generic;

namespace System.Web;

public class ApiParam {
    public string name;
    public string type;  // "string" | "int" | "long" | "number" | "bool"
    public bool required;
    // 源码中书写的字面默认值（无默认值时为 ""）。
    public string def;
    // Need(label, ...) 传入的标签；In() 时为 ""。
    public string desc;  // label passed to Need(), or "" for In()
    public string source;

    public ApiParam(string name, string type, bool required, string def, string desc,
                    string source) {
        this.name = name;
        this.type = type;
        this.required = required;
        this.def = def;
        this.desc = desc;
        this.source = source;
    }

    // 参数名。
    public string Name() { return this.name; }
    // 参数类型（"string" | "int" | "long" | "number" | "bool"）。
    public string Type() { return this.type; }
    // 是否必填。
    public bool Required() { return this.required; }
    // 默认值（无则 ""）。
    public string Default() { return this.def; }
    // 参数说明（Need 的标签）。
    public string Desc() { return this.desc; }
    // 参数来源（"path" | "query"，query 覆盖 form/query/body 字段）。
    public string Source() { return this.source; }

    string JsonType() {
        if (this.type == "int" || this.type == "long") { return "integer"; }
        if (this.type == "number") { return "number"; }
        if (this.type == "bool") { return "boolean"; }
        return "string";
    }
}

// 内置 API 接口文档生成器：自动导出 OpenAPI 3 规范与离线 Swagger UI。
