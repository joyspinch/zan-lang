using System;

namespace System.Web;

class LockLease {
    string key;
    long owner;

    LockLease(string key, long owner) {
        this.key = key;
        this.owner = owner;
    }
}

// 请求锁的租约表（匿名共享内存）：一个键同一时刻只有一个持有者，拿
// 不到租约的请求由调用方回答 429。经 SharedTable.TryAcquireLease 加锁
// （30 秒租约窗口）、ReleaseLease 释放；表未就绪的管理器不发放租约。
