using System;
using System.Collections.Generic;

namespace System.Web;

/* LlmsSection -- llms.txt 分组节实体模型。 */
public class LlmsSection {
    private string name;
    private List<LlmsLink> links;

    public LlmsSection(string n) {
        this.name = n;
        this.links = new List<LlmsLink>();
    }

    public string Name() { return this.name; }
    public List<LlmsLink> Links() { return this.links; }

    public void Add(string title, string url, string desc, string fullContent) {
        this.links.Add(new LlmsLink(title, url, desc, fullContent));
    }
}
