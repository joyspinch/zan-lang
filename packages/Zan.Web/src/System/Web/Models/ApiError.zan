using System;
using System.Collections.Generic;

namespace System.Web;

public class ApiError : Exception {
    public int status;  // HTTP status to answer with
    // 业务错误码（"0003" = 缺失或非法参数）。
    public string code;  // business code ("0003" = missing/invalid parameter)

    // 构造受控中止：status 为应答状态码，code 为业务错误码。
    public ApiError(int status, string code, string message) {
        Message = message;
        this.status = status;
        this.code = code;
    }

    // 应答用的 HTTP 状态码。
    public int Status() { return this.status; }
    // 业务错误码。
    public string Code() { return this.code; }

    // HTTP 状态码标准原因短语（对齐 RFC 协议）。
    public static string Reason(int status) {
        if (status == 400) { return "Bad Request"; }
        if (status == 401) { return "Unauthorized"; }
        if (status == 403) { return "Forbidden"; }
        if (status == 404) { return "Not Found"; }
        if (status == 405) { return "Method Not Allowed"; }
        if (status == 409) { return "Conflict"; }
        if (status == 413) { return "Payload Too Large"; }
        if (status == 422) { return "Unprocessable Entity"; }
        if (status == 429) { return "Too Many Requests"; }
        if (status == 500) { return "Internal Server Error"; }
        if (status == 503) { return "Service Unavailable"; }
        if (status < 400) { return "OK"; }
        return "Error";
    }
}

// OpenAPI 接口参数文档元数据描述符。
