using System;
using System.Collections.Generic;

namespace System.Web;

public class Listing {
    // 列表响应 JSON（{"items","total","page","limit","pages"}）；
    // items 是已序列化的行 JSON，经 PutJson 挂树（能解析就保型嵌入，
    // 解析不出按字符串存——无论如何不会产出非法 JSON），空时输出 []。
    public static string Json(string itemsJson, int total, ListQuery q) {
        string safeItems = itemsJson != null ? itemsJson : "";
        ListQuery safeQ = q != null ? q : new ListQuery();
        int safeTotal = total >= 0 ? total : 0;
        JsonValue o = JsonValue.NewObject();
        o.PutJson("items", safeItems.Length == 0 ? "[]" : safeItems);
        o.PutInt("total", safeTotal);
        o.PutInt("page", safeQ.Page());
        o.PutInt("limit", safeQ.Limit());
        o.PutInt("pages", safeQ.Pages(safeTotal));
        return o.ToJson();
    }
}
