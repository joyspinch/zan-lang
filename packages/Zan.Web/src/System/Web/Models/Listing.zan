using System;
using System.Collections.Generic;

namespace System.Web;

class Listing {
    // 列表响应 JSON（{"items","total","page","limit","pages"}）；
    // items 是已序列化的行 JSON，经 PutJson 挂树（能解析就保型嵌入，
    // 解析不出按字符串存——无论如何不会产出非法 JSON），空时输出 []。
    static string Json(string itemsJson, int total, ListQuery q) {
        JsonValue o = JsonValue.NewObject();
        o.PutJson("items", itemsJson.Length == 0 ? "[]" : itemsJson);
        o.PutInt("total", total);
        o.PutInt("page", q.Page());
        o.PutInt("limit", q.Limit());
        o.PutInt("pages", q.Pages(total));
        return o.ToJson();
    }
}
