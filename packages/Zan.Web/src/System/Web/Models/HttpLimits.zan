namespace System.Web;

// HTTP 运行边界与默认配置常量：
// 集中管理请求正文大小、超时窗口、TTL 周期、连接与表容量等物理硬约束，消除散落魔法数字与硬编码。
public class HttpLimits {
    // 默认请求到达与响应处理超时窗口（毫秒，默认 30s）
    public static const int DefaultTimeoutMs = 30000;

    // 默认资源缓存与长会话 TTL 生命周期（秒，默认 86400s / 24小时）
    public static const int DefaultTtlSeconds = 86400;

    // 默认 CSRF 校验令牌有效期（秒，默认 43200s / 12小时）
    public static const int DefaultCsrfTokenTtlSeconds = 43200;

    // 默认跨进程共享哈希表槽位数（限流、锁、会话等表空间基线，默认 65536）
    public static const int DefaultSharedTableSlots = 65536;

    // 默认跨进程共享哈希表键名最大字节宽度（默认 192 字节）
    public static const int DefaultSharedTableKeyBytes = 192;

    // 默认内存请求体上限（字节，超限回答 413，默认 2MB）
    public static const int DefaultMaxBodyBytes = 2097152;

    // 默认大文件流式直传落盘上限（字节，作用于 [Upload] 路由，默认 512MB）
    public static const int DefaultMaxUploadBytes = 536870912;

    // 默认单进程并发连接数硬上限（0 = 不设上限，默认 10000）
    public static const int DefaultMaxConnections = 10000;

    // WebSocket 单帧安全阈值（字节，防畸形大帧 OOM，默认 16MB）
    public static const int MaxWsFrameBytes = 16777216;

    // 静态文件流式分发单文件尺寸上限（默认 4MB）
    public static const int MaxStaticFileBytes = 4194304;

    // 分页列表查询默认每页条数（默认 20）
    public static const int DefaultPageLimit = 20;

    // 分页列表查询单页条数硬上限（默认 100）
    public static const int MaxPageLimit = 100;

    // 底层流式网络与磁盘 IO 缓冲区默认分块大小（默认 64KB）
    public static const int IoChunkBytes = 65536;

    // 默认流式上传文件暂存目录
    public static const string DefaultUploadDir = "uploads";

    // 默认 OpenAPI 交互文档入口路由
    public static const string DefaultApiDocsPath = "/api/docs";

    // 默认 SEO / 爬虫协议入口路由定义
    public static const string DefaultLlmsTxtPath = "/.well-known/llms.txt";
    public static const string DefaultSitemapPath = "/sitemap.xml";
    public static const string DefaultRobotsTxtPath = "/robots.txt";

    // 标准 MIME 协议定义
    public static const string MimeJson = "application/json";
    public static const string MimeJsonUtf8 = "application/json; charset=utf-8";
    public static const string MimeHtmlUtf8 = "text/html; charset=utf-8";
    public static const string MimePlainUtf8 = "text/plain; charset=utf-8";
    public static const string MimeEventStream = "text/event-stream; charset=utf-8";
    public static const string MimeXmlUtf8 = "application/xml; charset=utf-8";
}
