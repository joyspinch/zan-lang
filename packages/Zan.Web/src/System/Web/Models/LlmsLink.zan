using System;

namespace System.Web;

/* LlmsLink -- llms.txt 链接条目实体模型。 */
public class LlmsLink {
    private string title;
    private string url;
    private string description;
    private string fullContent;

    public LlmsLink(string t, string u, string d, string fc) {
        this.title = t;
        this.url = u;
        this.description = d;
        this.fullContent = fc;
    }

    public string Title() { return this.title; }
    public string Url() { return this.url; }
    public string Description() { return this.description; }
    public string FullContent() { return this.fullContent; }
}
