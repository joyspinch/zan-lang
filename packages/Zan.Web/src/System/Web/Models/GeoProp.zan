using System;

namespace System.Web;

/* GeoProp -- Schema 属性键值项，保证有序输出。 */
public class GeoProp {
    private string key;
    private string val;

    public GeoProp(string k, string v) {
        this.key = k;
        this.val = v;
    }

    public string Key() { return this.key; }
    public string Val() { return this.val; }
    public void SetVal(string v) { this.val = v; }
}
