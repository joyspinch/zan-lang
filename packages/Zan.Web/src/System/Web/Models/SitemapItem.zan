using System;

namespace System.Web;

/* SitemapItem -- 站点地图条目实体模型。 */
public class SitemapItem {
    private string loc;
    private string lastMod;
    private string changeFreq;
    private string priority;

    public SitemapItem(string l, string lm, string cf, string p) {
        this.loc = l;
        this.lastMod = lm;
        this.changeFreq = cf;
        this.priority = p;
    }

    public string Loc() { return this.loc; }
    public string LastMod() { return this.lastMod; }
    public string ChangeFreq() { return this.changeFreq; }
    public string Priority() { return this.priority; }
}
