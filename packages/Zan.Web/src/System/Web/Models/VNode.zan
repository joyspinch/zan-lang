using System;
using System.Collections.Generic;

namespace System.Web;

class VNode {
    // 节点类型编码：0 字面量, 1 转义变量, 2 原始变量, 3 条件分支, 4 循环, 5 内容插槽。
    int kind;
    string text;  // literal text, or the variable/list name
    List<VNode> body;  // children of #if / #each
    List<VNode> elseBody;  // kind==3: children after a same-level {{else}}

    VNode(int kind, string text) {
        this.kind = kind;
        this.text = text;
        this.body = null;
        this.elseBody = null;
    }
}

// 内存高性能模板引擎：首次加载即编译解析并驻留内存。
