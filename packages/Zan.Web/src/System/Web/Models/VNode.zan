using System;
using System.Collections.Generic;

namespace System.Web;

public class VNodeKind {
    // 节点类型编码：字面量文本
    public static const int Literal = 0;
    // 转义 HTML 变量
    public static const int EscapedVar = 1;
    // 原始未转义 HTML 变量 ({{{raw}}})
    public static const int RawVar = 2;
    // 条件块 (#if)
    public static const int If = 3;
    // 列表循环 (#each)
    public static const int Each = 4;
    // 内容插槽 ({{content}})
    public static const int ContentSlot = 5;
}

public class VNode {
    private int kind;
    private string text;  // literal text, or the variable/list name
    private List<VNode> body;  // children of #if / #each
    private List<VNode> elseBody;  // kind==3: children after a same-level {{else}}

    public VNode(int kind, string text) {
        this.kind = kind;
        this.text = text;
        this.body = null;
        this.elseBody = null;
    }

    public int Kind() { return this.kind; }
    public string Text() { return this.text; }
    public List<VNode> Body() { return this.body; }
    public List<VNode> ElseBody() { return this.elseBody; }

    public VNode SetBody(List<VNode> body) { this.body = body; return this; }
    public VNode SetElseBody(List<VNode> elseBody) { this.elseBody = elseBody; return this; }
}
