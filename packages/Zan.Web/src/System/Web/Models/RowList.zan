using System;
using System.Collections.Generic;

namespace System.Web;

public class RowList {
    private string name;
    private List<StrMap> rows;

    public RowList(string name) {
        this.name = name;
        this.rows = new List<StrMap>();
    }

    public string Name() { return this.name; }
    public List<StrMap> Rows() { return this.rows; }
}
