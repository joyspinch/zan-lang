using System;

namespace System.Web;

public class StaticMount {
    private string prefix;
    private string root;
    private int maxAge;

    public StaticMount(string prefix, string root, int maxAge) {
        this.prefix = prefix;
        this.root = root;
        this.maxAge = maxAge;
    }

    public string Prefix() { return this.prefix; }
    public string Root() { return this.root; }
    public int MaxAge() { return this.maxAge; }
    public void SetMaxAge(int maxAge) { this.maxAge = maxAge; }
}
