using System;

namespace System.Web;

public class ListQuery {
    private int page;
    private int limit;
    private string order;
    private bool desc;
    private string kw;

    public ListQuery() {
        this.page = 1;
        this.limit = HttpLimits.DefaultPageLimit;
        this.order = "";
        this.desc = true;
        this.kw = "";
    }

    // 设置当前页码并返回自身
    public ListQuery SetPage(int page) { this.page = page; return this; }
    // 设置每页条数并返回自身
    public ListQuery SetLimit(int limit) { this.limit = limit; return this; }
    // 设置排序字段并返回自身
    public ListQuery SetOrder(string order) { this.order = order; return this; }
    // 设置是否降序并返回自身
    public ListQuery SetDesc(bool desc) { this.desc = desc; return this; }
    // 设置关键词并返回自身
    public ListQuery SetKw(string kw) { this.kw = kw; return this; }

    // 页码（从 1 起）。
    public int Page() { return this.page; }
    // 每页行数（钳制在 [1, max]）。
    public int Limit() { return this.limit; }
    // 排序键（由控制器映射到具体列）。
    public string Order() { return this.order; }
    // 是否降序（仅 `?dir=asc` 得到升序）。
    public bool Desc() { return this.desc; }
    // 搜索文本（未搜索时为 ""）。
    public string Kw() { return this.kw; }

    public int Skip() { return (this.page - 1) * this.limit; }

    // an empty list still reads as "第 1 / 1 页").
    public int Pages(int total) {
        if (total <= 0) { return 1; }
        return (total + this.limit - 1) / this.limit;
    }

    public string QueryString() {
        StringBuilder sb = new StringBuilder();
        sb.Append("limit=");
        sb.Append(Convert.ToString(this.limit));
        if (this.order.Length > 0) {
            sb.Append("&order=");
            sb.Append(Encoding.UrlEncode(this.order));
            if (this.desc) { sb.Append("&dir=desc"); } else { sb.Append("&dir=asc"); }
        }
        if (this.kw.Length > 0) {
            sb.Append("&kw=");
            sb.Append(Encoding.UrlEncode(this.kw));
        }
        return sb.ToString();
    }

    public static ListQuery From(HttpContext ctx, string defOrder, int defLimit,
                                 int maxLimit) {
        ListQuery q = new ListQuery();
        q.page = ctx.InInt("page", 1);
        if (q.page < 1) { q.page = 1; }
        q.limit = ctx.InInt("limit", defLimit);
        if (q.limit < 1) { q.limit = defLimit; }
        if (q.limit > maxLimit) { q.limit = maxLimit; }
        q.order = ctx.In("order");
        if (q.order.Length == 0) { q.order = defOrder; }
        q.desc = ctx.In("dir") != "asc";
        q.kw = ctx.InText("kw").Trim();
        return q;
    }
}
