using System;
using System.Collections.Generic;

namespace System.Web;

public class ApiEnvelope {
    public string code;
    public string msg;
    public JsonValue data;

    public ApiEnvelope() {
        this.code = "";
        this.msg = "";
        this.data = null;
    }

    public ApiEnvelope(string code, string msg, JsonValue data) {
        this.code = code;
        this.msg = msg;
        this.data = data;
    }

    public string Code() { return this.code; }
    public string Msg() { return this.msg; }
    public JsonValue Data() { return this.data; }

    public ApiEnvelope SetCode(string v) { this.code = v; return this; }
    public ApiEnvelope SetMsg(string v) { this.msg = v; return this; }
    public ApiEnvelope SetData(JsonValue v) { this.data = v; return this; }
}
