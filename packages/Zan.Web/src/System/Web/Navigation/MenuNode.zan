using System;
using System.Collections.Generic;

namespace System.Web;

public class MenuNode {
    private string title;
    private string path;
    private string group;
    private string icon;
    private bool active;
    // 菜单分类分组展示排序权重。
    private int groupOrder;
    // 分组内子页面根据 URL 路径排定层级与显示顺序。
    private string order;

    public MenuNode() {
        this.title = "";
        this.path = "";
        this.group = "";
        this.icon = "";
        this.active = false;
        this.groupOrder = 0x7FFFFFFF;
        this.order = "";
    }

    public string Title() { return this.title; }
    public string Path() { return this.path; }
    public string Group() { return this.group; }
    public string Icon() { return this.icon; }
    public bool Active() { return this.active; }
    public int GroupOrder() { return this.groupOrder; }
    public string Order() { return this.order; }

    public MenuNode SetTitle(string v) { this.title = v; return this; }
    public MenuNode SetPath(string v) { this.path = v; return this; }
    public MenuNode SetGroup(string v) { this.group = v; return this; }
    public MenuNode SetIcon(string v) { this.icon = v; return this; }
    public MenuNode SetActive(bool v) { this.active = v; return this; }
    public MenuNode SetGroupOrder(int v) { this.groupOrder = v; return this; }
    public MenuNode SetOrder(string v) { this.order = v; return this; }
}
