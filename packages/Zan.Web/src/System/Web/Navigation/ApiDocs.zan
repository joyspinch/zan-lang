using System;
using System.Collections.Generic;
using System.Text;

namespace System.Web;

public class ApiDocs {
    private static string title = "API";
    private static string err400Code = "0004";
    private static string err400Msg = "参数不合法";
    private static string err401Code = "0001";
    private static string err401Msg = "登录已过期，请重新登录";
    private static string err403Code = "0403";
    private static string err403Msg = "没有执行该操作的权限";
    private static string err404Code = "0404";
    private static string err404Msg = "对象不存在";

    public static void Title(string name) { ApiDocs.title = name; }

    // 按 HTTP 状态码定制 OpenAPI 文档里的默认错误码与示例消息。
    public static void ConfigureError(int status, string code, string msg) {
        if (code == null || code.Length == 0 || msg == null) { return; }
        if (status == 400) { ApiDocs.err400Code = code; ApiDocs.err400Msg = msg; }
        else if (status == 401) { ApiDocs.err401Code = code; ApiDocs.err401Msg = msg; }
        else if (status == 403) { ApiDocs.err403Code = code; ApiDocs.err403Msg = msg; }
        else if (status == 404) { ApiDocs.err404Code = code; ApiDocs.err404Msg = msg; }
    }

    public static void Mount(WebApp app, string path) {
        string p = path;
        if (p.Length == 0) { p = HttpLimits.DefaultApiDocsPath; }
        app.Map("GET", p + ".json", ApiDocs.Spec).Named("ApiDocs.Spec")
            .Title("API 文档 (OpenAPI)");
        app.Map("GET", p, ApiDocs.Page).Named("ApiDocs.Page")
            .Title("API 文档").Menu()
            .Meta("Icon", "mdi:book-open-variant");
    }

    // 等价 Mount(app, "/api/docs")。
    public static void Mount(WebApp app) { ApiDocs.Mount(app, HttpLimits.DefaultApiDocsPath); }

    public static void MountSpec(WebApp app, string path) {
        string p = path;
        if (p.Length == 0) { p = HttpLimits.DefaultApiDocsPath; }
        app.Map("GET", p + ".json", ApiDocs.Spec).Named("ApiDocs.Spec")
            .Title("API 文档 (OpenAPI)");
    }

    // GET &lt;path&gt;.json 处理器：no-store 输出 OpenAPI 文档。
    public static async void Spec(HttpContext ctx) {
        ctx.SetHeader("Cache-Control", "no-store");
        ctx.Json(ApiDocs.SpecJson(WebHost.Current()));
    }

    // GET &lt;path&gt; 处理器：输出离线 UI 页面。
    public static async void Page(HttpContext ctx) {
        ctx.Html(ApiDocs.Html());
    }

    // 静态 {"code","msg","data"} 信封 schema 常量片段，消除每条路由数十个 JsonValue 树节点分配。
    private static const string ENVELOPE_SCHEMA_JSON =
        "{\"type\":\"object\",\"required\":[\"code\",\"msg\"],\"properties\":{"
        + "\"code\":{\"type\":\"string\",\"description\":\"0000 表示成功，其余为错误码\"},"
        + "\"msg\":{\"type\":\"string\",\"description\":\"提示文案\"},"
        + "\"data\":{\"description\":\"业务数据，可为 null\"}}}";

    private static void AppendJsonStr(StringBuilder sb, string v) {
        if (v == null) {
            sb.Append("null");
            return;
        }
        sb.Append("\"");
        Encoding.JsonEscapeTo(sb, v);
        sb.Append("\"");
    }

    private static void AppendJsonArrayStr(StringBuilder sb, string v) {
        sb.Append("\"");
        if (v != null && v.Length > 0) {
            Encoding.JsonEscapeTo(sb, v);
        }
        sb.Append("\"");
    }

    private static string LowerMethod(string m) {
        if (m == "GET") { return "get"; }
        if (m == "POST") { return "post"; }
        if (m == "PUT") { return "put"; }
        if (m == "DELETE") { return "delete"; }
        if (m == "PATCH") { return "patch"; }
        if (m == "HEAD") { return "head"; }
        if (m == "OPTIONS") { return "options"; }
        return m.ToLower();
    }

    // 单遍 O(R) 路径分组 + 流式 JSON 序列化（零 JsonValue DOM 树分配，与原 JsonValue.ToJson 字节级等价）。
    public static string SpecJson(WebApp host) {
        List<Route> routes = null;
        if (host != null) { routes = host.Router().All(); }
        int rcount = routes != null ? routes.Count : 0;

        StringBuilder sb = new StringBuilder(rcount * 640 + 256);
        sb.Append("{\"openapi\":\"3.0.3\",\"info\":{\"title\":");
        ApiDocs.AppendJsonStr(sb, ApiDocs.title);
        sb.Append(",\"version\":\"1.0.0\"},\"paths\":{");

        if (rcount > 0) {
            Dictionary<string, List<Route>> groups = new Dictionary<string, List<Route>>();
            List<string> pathOrder = new List<string>();
            for (int i = 0; i < rcount; i = i + 1) {
                Route rt = routes[i];
                string pt = rt.Pattern();
                List<Route> bucket = null;
                if (!groups.TryGetValue(pt, out bucket)) {
                    bucket = new List<Route>();
                    groups[pt] = bucket;
                    pathOrder.Add(pt);
                }
                bucket.Add(rt);
            }

            int pcount = pathOrder.Count;
            for (int i = 0; i < pcount; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string pt = pathOrder[i];
                ApiDocs.AppendJsonStr(sb, pt);
                sb.Append(":{");
                List<Route> bucket = groups[pt];
                int bcount = bucket.Count;
                for (int k = 0; k < bcount; k = k + 1) {
                    if (k > 0) { sb.Append(","); }
                    Route rt = bucket[k];
                    ApiDocs.AppendJsonStr(sb, ApiDocs.LowerMethod(rt.Method()));
                    sb.Append(":");
                    ApiDocs.AppendOperation(sb, rt, host);
                }
                sb.Append("}");
            }
        }

        sb.Append("}}");
        return sb.ToString();
    }

    // 把一条路由流式写成 OpenAPI operation 对象（字段顺序与转义规则与原 JsonValue 路径字节级一致）。
    private static void AppendOperation(StringBuilder sb, Route rt, WebApp host) {
        string act = rt.Action();
        string sum = rt.GetTitle();
        if (sum.Length == 0) { sum = act; }
        sb.Append("{\"summary\":");
        ApiDocs.AppendJsonStr(sb, sum);
        sb.Append(",\"operationId\":");
        ApiDocs.AppendJsonStr(sb, act);
        sb.Append(",\"tags\":[");
        ApiDocs.AppendJsonArrayStr(sb, ApiDocs.Tag(rt));
        sb.Append("],\"x-login\":");
        sb.Append(rt.NeedsLogin() ? "true" : "false");
        sb.Append(",\"x-auth\":");
        sb.Append(rt.NeedsAuth() ? "true" : "false");
        sb.Append(",\"x-menu\":");
        sb.Append(rt.InMenu() ? "true" : "false");

        List<ApiParam> ps = rt.DocParams();
        int pcount = ps.Count;
        string method = rt.Method();
        bool bodyForm = method != "GET" && method != "HEAD";
        sb.Append(",\"parameters\":[");
        bool anyParam = false;
        bool anyBody = false;
        for (int i = 0; i < pcount; i = i + 1) {
            ApiParam p = ps[i];
            if (bodyForm && p.Source() != "path") {
                anyBody = true;
                continue;
            }
            if (anyParam) { sb.Append(","); }
            anyParam = true;
            ApiDocs.AppendParamJson(sb, p);
        }
        sb.Append("]");

        if (anyBody) {
            sb.Append(",\"requestBody\":{\"content\":{\"application/x-www-form-urlencoded\":{\"schema\":{\"type\":\"object\",\"properties\":{");
            bool firstProp = true;
            for (int i = 0; i < pcount; i = i + 1) {
                ApiParam p = ps[i];
                if (p.Source() == "path") { continue; }
                if (!firstProp) { sb.Append(","); }
                firstProp = false;
                ApiDocs.AppendJsonStr(sb, p.Name());
                sb.Append(":{\"type\":");
                ApiDocs.AppendJsonStr(sb, p.JsonType());
                string desc = p.Desc();
                if (desc.Length > 0) {
                    sb.Append(",\"description\":");
                    ApiDocs.AppendJsonStr(sb, desc);
                }
                string def = p.Default();
                if (def.Length > 0) {
                    sb.Append(",\"default\":");
                    ApiDocs.AppendJsonStr(sb, def);
                }
                sb.Append("}");
            }
            sb.Append("},\"required\":[");
            bool firstReq = true;
            for (int i = 0; i < pcount; i = i + 1) {
                ApiParam p = ps[i];
                if (p.Source() == "path" || !p.Required()) { continue; }
                if (!firstReq) { sb.Append(","); }
                firstReq = false;
                ApiDocs.AppendJsonArrayStr(sb, p.Name());
            }
            sb.Append("]}}}}");
        }

        sb.Append(",\"responses\":");
        ApiDocs.AppendResponses(sb, rt, host, method);
        sb.Append("}");
    }

    private static bool IsDefaultApiPattern(string pat) {
        string p = pat;
        if (p == HttpLimits.DefaultApiPrefix) { return true; }
        int plen = HttpLimits.DefaultApiPrefix.Length;
        return p.Length > plen && (p[plen] & 255) == 47 && p.StartsWith(HttpLimits.DefaultApiPrefix);
    }

    private static void AppendResponses(StringBuilder sb, Route rt, WebApp host, string method) {
        string rawKind = rt.MetaGet("ResponseKind");
        string kind = rawKind.Length > 0 ? rawKind.ToLower() : "";
        string pat = rt.Pattern();
        bool stream = kind == "stream"
            || (kind.Length == 0 && pat.IndexOf("/stream") >= 0);
        bool json = kind == "json";
        if (kind.Length == 0 && !stream) {
            json = method != "GET" && method != "HEAD";
            if (!json) {
                json = host != null
                    ? host.IsApiPath(pat)
                    : ApiDocs.IsDefaultApiPattern(pat);
            }
        }

        sb.Append("{\"200\":");
        if (stream) {
            sb.Append("{\"description\":\"事件流已建立，服务端持续推送\",\"content\":{\"text/event-stream\":{\"schema\":{\"type\":\"string\"},\"example\":\"event: metrics\\ndata: {\\\"requests\\\":{\\\"count\\\":128}}\\n\\n\"}}}");
        } else if (json) {
            sb.Append("{\"description\":\"成功\",\"content\":{\"application/json\":{\"schema\":");
            sb.Append(ApiDocs.ENVELOPE_SCHEMA_JSON);
            sb.Append(",\"example\":{\"code\":\"0000\",\"msg\":\"ok\",\"data\":null}}}}");
        } else {
            sb.Append("{\"description\":\"页面\",\"content\":{\"text/html\":{\"schema\":{\"type\":\"string\"}}}}");
        }

        if (json || stream) {
            sb.Append(",\"400\":");
            ApiDocs.AppendErrorResponse(sb, "参数不合法", ApiDocs.err400Code, ApiDocs.err400Msg);
        }
        if (rt.NeedsLogin() || rt.NeedsAuth()) {
            sb.Append(",\"401\":");
            ApiDocs.AppendErrorResponse(sb, "未登录或登录已过期", ApiDocs.err401Code, ApiDocs.err401Msg);
            sb.Append(",\"403\":");
            ApiDocs.AppendErrorResponse(sb, "没有该操作的权限", ApiDocs.err403Code, ApiDocs.err403Msg);
        }
        if (json) {
            sb.Append(",\"404\":");
            ApiDocs.AppendErrorResponse(sb, "对象不存在", ApiDocs.err404Code, ApiDocs.err404Msg);
        }
        sb.Append("}");
    }

    // 一个错误状态响应（信封 schema + 示例）。
    private static void AppendErrorResponse(StringBuilder sb, string desc, string code, string msg) {
        sb.Append("{\"description\":");
        ApiDocs.AppendJsonStr(sb, desc);
        sb.Append(",\"content\":{\"application/json\":{\"schema\":");
        sb.Append(ApiDocs.ENVELOPE_SCHEMA_JSON);
        sb.Append(",\"example\":{\"code\":");
        ApiDocs.AppendJsonStr(sb, code);
        sb.Append(",\"msg\":");
        ApiDocs.AppendJsonStr(sb, msg);
        sb.Append("}}}}");
    }

    // 一个 OpenAPI parameter 对象（in 取 path/query）。
    private static void AppendParamJson(StringBuilder sb, ApiParam p) {
        sb.Append("{\"name\":");
        ApiDocs.AppendJsonStr(sb, p.Name());
        sb.Append(",\"in\":");
        ApiDocs.AppendJsonStr(sb, p.Source());
        sb.Append(",\"required\":");
        sb.Append(p.Required() ? "true" : "false");
        string desc = p.Desc();
        if (desc.Length > 0) {
            sb.Append(",\"description\":");
            ApiDocs.AppendJsonStr(sb, desc);
        }
        sb.Append(",\"schema\":{\"type\":");
        ApiDocs.AppendJsonStr(sb, p.JsonType());
        string def = p.Default();
        if (def.Length > 0) {
            sb.Append(",\"default\":");
            ApiDocs.AppendJsonStr(sb, def);
        }
        sb.Append("}}");
    }

    // 提取分组标签：零 Router.SplitPath 分配。
    private static string Tag(Route rt) {
        string a = rt.Action();
        int dot = a.IndexOf(".");
        if (dot > 0) { return a.Substring(0, dot); }
        string pat = rt.Pattern();
        int n = pat.Length;
        int i = 0;
        while (i < n && (pat[i] & 255) == 47) { i = i + 1; }
        if (i < n) {
            int slash = pat.IndexOf("/", i);
            int end = slash < 0 ? n : slash;
            if (end > i) { return pat.Substring(i, end - i); }
        }
        return "api";
    }

    private static string Html() {
        return ApiDocs.Shell();
    }

    // 文档页 HTML 外壳（内联 CSS 与 JS，无外部依赖）。
    private static string Shell() {
        return "<!doctype html>\n<html lang=\"zh-CN\"><head><meta charset=\"utf-8\">"
            + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
            + "<title>API 文档</title>\n<style>" + ApiDocs.Css() + "</style></head>\n"
            + "<body><header><div class=\"wrap\"><h1>API 文档</h1>"
            + "<p class=\"sub\">由路由属性与动作参数自动生成 · "
            + "<a href=\"docs.json\">OpenAPI JSON</a></p>"
            + "<input id=\"q\" type=\"search\" placeholder=\"搜索路径、标题或参数\" "
            + "autocomplete=\"off\"></div></header>\n"
            + "<main class=\"wrap\" id=\"out\">加载中…</main>\n"
            + "<script>" + ApiDocs.Js() + "</script></body></html>\n";
    }

    // 内联样式（亮/暗双色，随系统偏好）。
    private static string Css() {
        return ":root{--bg:#f5f5f7;--card:#fff;--ink:#1d1d1f;--dim:#6e6e73;"
            + "--line:rgba(0,0,0,.08);--accent:#0071e3}"
            + "@media (prefers-color-scheme:dark){:root{--bg:#000;--card:#1c1c1e;"
            + "--ink:#f5f5f7;--dim:#98989d;--line:rgba(255,255,255,.12);"
            + "--accent:#0a84ff}}"
            + "*{box-sizing:border-box}body{margin:0;background:var(--bg);"
            + "color:var(--ink);font:15px/1.55 -apple-system,BlinkMacSystemFont,"
            + "'SF Pro Text','Helvetica Neue','PingFang SC','Microsoft YaHei',sans-serif}"
            + ".wrap{max-width:960px;margin:0 auto;padding:0 24px}"
            + "header{backdrop-filter:saturate(180%) blur(20px);"
            + "background:color-mix(in srgb,var(--bg) 80%,transparent);"
            + "border-bottom:1px solid var(--line);position:sticky;top:0;z-index:9;"
            + "padding:28px 0 18px}"
            + "h1{margin:0;font-size:28px;letter-spacing:-.02em}"
            + ".sub{margin:6px 0 14px;color:var(--dim);font-size:13px}"
            + ".sub a{color:var(--accent);text-decoration:none}"
            + "#q{width:100%;padding:10px 14px;border-radius:12px;"
            + "border:1px solid var(--line);background:var(--card);color:var(--ink);"
            + "font-size:14px;outline:none}"
            + "#q:focus{border-color:var(--accent)}"
            + "main{padding-bottom:64px}"
            + "h2{font-size:13px;text-transform:uppercase;letter-spacing:.08em;"
            + "color:var(--dim);margin:34px 0 10px}"
            + ".op{background:var(--card);border:1px solid var(--line);"
            + "border-radius:14px;margin:8px 0;overflow:hidden}"
            + ".op>summary{cursor:pointer;padding:13px 16px;display:flex;gap:10px;"
            + "align-items:center;list-style:none}"
            + ".op>summary::-webkit-details-marker{display:none}"
            + ".m{font:600 11px/1 ui-monospace,SFMono-Regular,Menlo,monospace;"
            + "padding:5px 8px;border-radius:7px;color:#fff;letter-spacing:.04em}"
            + ".GET{background:#34c759}.POST{background:#0071e3}"
            + ".PUT{background:#ff9500}.PATCH{background:#af52de}"
            + ".DELETE{background:#ff3b30}.HEAD{background:#8e8e93}"
            + ".OPTIONS{background:#8e8e93}"
            + ".p{font:13px/1 ui-monospace,SFMono-Regular,Menlo,monospace;flex:1;"
            + "overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
            + ".t{color:var(--dim);font-size:13px}"
            + ".badge{font-size:11px;padding:3px 7px;border-radius:6px;"
            + "border:1px solid var(--line);color:var(--dim)}"
            + ".body{padding:0 16px 16px;border-top:1px solid var(--line)}"
            + "table{width:100%;border-collapse:collapse;margin-top:12px;font-size:13px}"
            + "th{text-align:left;color:var(--dim);font-weight:500;padding:6px 8px;"
            + "border-bottom:1px solid var(--line)}"
            + "td{padding:7px 8px;border-bottom:1px solid var(--line);"
            + "vertical-align:top}"
            + "code{font:12px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;"
            + "background:color-mix(in srgb,var(--ink) 7%,transparent);"
            + "padding:2px 5px;border-radius:5px}"
            + ".req{color:#ff3b30}.none{color:var(--dim);padding:12px 0;font-size:13px}";
    }

    // 内联脚本：fetch docs.json，收集/排序/渲染接口卡片，搜索框即时过滤。
    private static string Js() {
        return "const esc=s=>String(s??'').replace(/[&<>\"]/g,"
            + "c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\n"
            + "let ops=[];\n"
            + "function collect(spec){const out=[];"
            + "for(const [path,item] of Object.entries(spec.paths||{})){"
            + "for(const [m,op] of Object.entries(item)){"
            + "const ps=(op.parameters||[]).map(p=>({name:p.name,"
            + "where:p.in,required:!!p.required,desc:p.description||'',"
            + "type:(p.schema||{}).type||'string',def:(p.schema||{}).default}));"
            + "const rb=((((op.requestBody||{}).content||{})"
            + "['application/x-www-form-urlencoded']||{}).schema)||null;"
            + "if(rb){const req=rb.required||[];"
            + "for(const [n,s] of Object.entries(rb.properties||{}))"
            + "ps.push({name:n,where:'form',required:req.includes(n),"
            + "desc:s.description||'',type:s.type||'string',def:s.default});}"
            + "out.push({method:m.toUpperCase(),path,tag:(op.tags||['api'])[0],"
            + "summary:op.summary||'',login:op['x-login'],auth:op['x-auth'],"
            + "menu:op['x-menu'],params:ps});}}"
            + "out.sort((a,b)=>a.tag.localeCompare(b.tag)||a.path.localeCompare(b.path));"
            + "return out;}\n"
            + "function params(ps){if(!ps.length)return"
            + "'<p class=\"none\">无参数</p>';"
            + "return '<table><tr><th>参数</th><th>位置</th><th>类型</th>"
            + "<th>必填</th><th>默认</th><th>说明</th></tr>'+ps.map(p=>"
            + "'<tr><td><code>'+esc(p.name)+'</code></td><td>'+esc(p.where)+"
            + "'</td><td>'+esc(p.type)+'</td><td>'+(p.required?"
            + "'<span class=\"req\">是</span>':'否')+'</td><td>'+"
            + "(p.def!==undefined&&p.def!==''?'<code>'+esc(p.def)+'</code>':'—')+"
            + "'</td><td>'+esc(p.desc)+'</td></tr>').join('')+'</table>';}\n"
            + "function render(list){const out=document.getElementById('out');"
            + "if(!list.length){out.innerHTML='<p class=\"none\">没有匹配的接口</p>';return;}"
            + "let html='',tag=null;"
            + "for(const o of list){if(o.tag!==tag){tag=o.tag;"
            + "html+='<h2>'+esc(tag)+'</h2>';}"
            + "const badges=(o.auth?'<span class=\"badge\">鉴权</span>':"
            + "(o.login?'<span class=\"badge\">登录</span>':''))+"
            + "(o.menu?'<span class=\"badge\">菜单</span>':'');"
            + "html+='<details class=\"op\"><summary><span class=\"m '+o.method+'\">'"
            + "+o.method+'</span><span class=\"p\">'+esc(o.path)+'</span>'+"
            + "'<span class=\"t\">'+esc(o.summary)+'</span>'+badges+'</summary>'+"
            + "'<div class=\"body\">'+params(o.params)+'</div></details>';}"
            + "out.innerHTML=html;}\n"
            + "function filter(){const q=document.getElementById('q').value"
            + ".trim().toLowerCase();"
            + "render(!q?ops:ops.filter(o=>(o.path+' '+o.summary+' '+o.tag+' '+"
            + "o.params.map(p=>p.name).join(' ')).toLowerCase().includes(q)));}\n"
            + "document.getElementById('q').addEventListener('input',filter);\n"
            + "fetch('docs.json').then(r=>r.json()).then(s=>{ops=collect(s);"
            + "render(ops);}).catch(e=>{document.getElementById('out')"
            + ".textContent='加载失败: '+e;});\n";
    }
}
