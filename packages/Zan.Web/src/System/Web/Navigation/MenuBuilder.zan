using System;
using System.Collections.Generic;

namespace System.Web;

public class MenuBuilder {
    private static string stateLock = "System.Web.MenuBuilder.stateLock";
    // Display name per URL segment ("system" -> "系统"). Lazy to avoid static ARC leak.
    private static StrMap labels = null;
    private static List<string> sections = null;
    private static List<string> stripPrefixes = null;
    private static List<string> excludedPaths = null;
    // 菜单项图标缺省值（可通过 DefaultIcon 配置覆盖）。
    private static string defaultIcon = "mdi:antenna";

    // 配置缺省图标；空串保持原值。
    public static void DefaultIcon(string icon) {
        if (icon != null && icon.Length > 0) {
            lock (MenuBuilder.stateLock) {
                MenuBuilder.defaultIcon = icon;
            }
        }
    }

    private static List<string> EnsureStripPrefixesLocked() {
        if (MenuBuilder.stripPrefixes == null) {
            MenuBuilder.stripPrefixes = new List<string>();
            MenuBuilder.stripPrefixes.Add("admin");
            MenuBuilder.stripPrefixes.Add("api");
        }
        return MenuBuilder.stripPrefixes;
    }

    // 注册分组推断时需要剥离的首段路由前缀（默认已含 "admin"、"api"）。
    public static void StripPrefix(string prefix) {
        if (prefix == null || prefix.Length == 0) { return; }
        string p = prefix.StartsWith("/") ? prefix.Substring(1) : prefix;
        p = p.ToLower();
        lock (MenuBuilder.stateLock) {
            List<string> list = MenuBuilder.EnsureStripPrefixesLocked();
            for (int i = 0; i < list.Count; i = i + 1) {
                if (list[i] == p) { return; }
            }
            list.Add(p);
        }
    }

    // 清空默认剥离前缀列表，完全按真实路径首段分组。
    public static void ClearStripPrefixes() {
        lock (MenuBuilder.stateLock) {
            MenuBuilder.stripPrefixes = new List<string>();
        }
    }

    // 从自动菜单中排除指定路径（例如通过独立顶栏入口打开的个人资料页）。
    public static void Exclude(string path) {
        if (path == null || path.Length == 0) { return; }
        lock (MenuBuilder.stateLock) {
            if (MenuBuilder.excludedPaths == null) {
                MenuBuilder.excludedPaths = new List<string>();
            }
            for (int i = 0; i < MenuBuilder.excludedPaths.Count; i = i + 1) {
                if (MenuBuilder.excludedPaths[i] == path) { return; }
            }
            MenuBuilder.excludedPaths.Add(path);
        }
    }

    private static bool IsExcluded(Route r) {
        if (r == null) { return true; }
        if (r.MetaGet("Hidden") == "true") { return true; }
        string pt = r.Pattern();
        lock (MenuBuilder.stateLock) {
            if (MenuBuilder.excludedPaths == null) { return false; }
            for (int i = 0; i < MenuBuilder.excludedPaths.Count; i = i + 1) {
                if (MenuBuilder.excludedPaths[i] == pt) { return true; }
            }
            return false;
        }
    }

    // 声明 URL 路由段对应的菜单分组名称与排序。
    public static void Section(string segment, string label) {
        if (segment == null || label == null) { return; }
        lock (MenuBuilder.stateLock) {
            if (MenuBuilder.labels == null) { MenuBuilder.labels = new StrMap(); }
            if (MenuBuilder.sections == null) { MenuBuilder.sections = new List<string>(); }
            if (!MenuBuilder.labels.Has(segment)) {
                MenuBuilder.sections.Add(segment);
            }
            MenuBuilder.labels.Set(segment, label);
        }
    }

    public static async List<MenuNode> ForUser(WebApp app, string uid, string activePath) {
        return await MenuBuilder.ForUser(app, uid, activePath, null);
    }

    public static async List<MenuNode> ForUser(WebApp app, string uid, string activePath, object scope) {
        List<MenuNode> outp = new List<MenuNode>();
        if (app == null) { return outp; }
        string safeUid = uid != null ? uid : "";
        string safeActive = activePath != null ? activePath : "";
        List<Route> routes = app.Router().All();
        for (int i = 0; i < routes.Count; i = i + 1) {
            Route r = routes[i];
            if (!r.InMenu()) { continue; }
            if (MenuBuilder.IsExcluded(r)) { continue; }
            if (r.Method() != "GET") { continue; }
            if ((r.NeedsLogin() || r.NeedsAuth()) && safeUid.Length == 0) { continue; }
            if (r.NeedsAuth() && !await app.Allow(safeUid, r.Action(), scope)) { continue; }

            string pt = r.Pattern();
            MenuNode n = new MenuNode();
            string title = r.GetTitle();
            if (title.Length == 0) { title = r.Action(); }
            n.SetTitle(title);
            n.SetPath(pt);

            string explicitGroup = r.MetaGet("Group");
            string explicitGroupOrder = r.MetaGet("GroupOrder");
            int segStart = 0;
            int segLen = 0;
            bool hasSecond = false;
            if (explicitGroup.Length == 0 || explicitGroupOrder.Length == 0) {
                MenuBuilder.FirstBodySegment(pt, out segStart, out segLen, out hasSecond);
            }

            /* 优先采用特性显式声明的分组（[Custom(Group = "...")]），未声明时按 URL 前缀约定回退 */
            if (explicitGroup.Length > 0) {
                n.SetGroup(explicitGroup);
            } else {
                n.SetGroup(MenuBuilder.GroupFromSeg(pt, segStart, segLen, hasSecond));
            }

            /* 优先采用特性显式声明的排序（[Custom(GroupOrder = ...)] / [Custom(Order = ...)]） */
            int parsedOrder = 0;
            if (explicitGroupOrder.Length > 0 && Filter.TryParseInt(explicitGroupOrder, out parsedOrder)) {
                n.SetGroupOrder(parsedOrder);
            } else {
                n.SetGroupOrder(MenuBuilder.OrderFromSeg(n.Group(), pt, segStart, segLen));
            }

            string explicitOrder = r.MetaGet("Order");
            if (explicitOrder.Length > 0) {
                n.SetOrder(explicitOrder);
            } else {
                n.SetOrder(pt);
            }

            string icon = r.MetaGet("Icon");
            if (icon.Length == 0) {
                lock (MenuBuilder.stateLock) {
                    icon = MenuBuilder.defaultIcon;
                }
            }
            n.SetIcon(icon);
            n.SetActive(MenuBuilder.Matches(pt, safeActive));
            outp.Add(n);
        }
        MenuBuilder.Sort(outp);
        return outp;
    }

    public static async string LandingFor(WebApp app, string uid) {
        List<MenuNode> nodes = await MenuBuilder.ForUser(app, uid, "");
        if (nodes.Count == 0) { return ""; }
        return nodes[0].Path();
    }

    public static async string JsonFor(WebApp app, string uid, string activePath) {
        List<MenuNode> nodes = await MenuBuilder.ForUser(app, uid, activePath);
        List<MenuNodeDoc> outp = new List<MenuNodeDoc>();
        for (int i = 0; i < nodes.Count; i = i + 1) {
            MenuNode n = nodes[i];
            MenuNodeDoc o = new MenuNodeDoc(
                n.Title(), n.Path(), n.Group(), n.Icon(), n.Active());
            outp.Add(o);
        }
        return Json.Serialize<List<MenuNodeDoc>>(outp);
    }

    public static void Fill(List<StrMap> rows, List<MenuNode> nodes) {
        if (rows == null || nodes == null) { return; }
        string group = "";
        bool first = true;
        for (int i = 0; i < nodes.Count; i = i + 1) {
            MenuNode n = nodes[i];
            if (first || n.Group() != group) {
                first = false;
                group = n.Group();
                if (group.Length > 0) {
                    StrMap head = new StrMap();
                    head.Set("group", group);
                    rows.Add(head);
                }
            }
            StrMap row = new StrMap();
            row.Set("title", n.Title());
            row.Set("path", n.Path());
            row.Set("icon", n.Icon());
            if (n.Active()) { row.Set("active", "active"); }
            rows.Add(row);
        }
    }

    private static bool SliceEqualsStr(string s, int start, int len, string target) {
        if (len != target.Length) { return false; }
        for (int i = 0; i < len; i = i + 1) {
            if ((s[start + i] & 255) != (target[i] & 255)) { return false; }
        }
        return true;
    }

    private static void FirstBodySegment(string pattern, out int segStart, out int segLen, out bool hasSecond) {
        segStart = 0;
        segLen = 0;
        hasSecond = false;
        if (pattern == null || pattern.Length == 0) { return; }
        lock (MenuBuilder.stateLock) {
            List<string> stripped = MenuBuilder.EnsureStripPrefixesLocked();
            int strippedCount = stripped.Count;
            int n = pattern.Length;
            int i = 0;
            bool foundFirst = false;
            while (i < n) {
                while (i < n && (pattern[i] & 255) == 47) { i = i + 1; }
                int e = i;
                while (e < n && (pattern[e] & 255) != 47) { e = e + 1; }
                int len = e - i;
                if (len > 0 && (pattern[i] & 255) != 123) {
                    if (!foundFirst) {
                        bool skip = false;
                        for (int j = 0; j < strippedCount; j = j + 1) {
                            if (MenuBuilder.SliceEqualsStr(pattern, i, len, stripped[j])) {
                                skip = true;
                                break;
                            }
                        }
                        if (!skip) {
                            segStart = i;
                            segLen = len;
                            foundFirst = true;
                        }
                    } else {
                        hasSecond = true;
                        return;
                    }
                }
                i = e;
            }
        }
    }

    private static string GroupFromSeg(string path, int segStart, int segLen, bool hasSecond) {
        if (segLen == 0) { return ""; }
        string seg = path.Substring(segStart, segLen);
        lock (MenuBuilder.stateLock) {
            if (MenuBuilder.labels != null) {
                string named = MenuBuilder.labels.Get(seg);
                if (named.Length > 0) { return named; }
                if (!hasSecond && !MenuBuilder.labels.Has(seg)) { return ""; }
            } else if (!hasSecond) {
                return "";
            }
        }
        return MenuBuilder.CapitalizeFirst(seg);
    }

    private static int OrderFromSeg(string group, string path, int segStart, int segLen) {
        if (group == null || group.Length == 0) { return -1; }
        lock (MenuBuilder.stateLock) {
            if (MenuBuilder.sections == null) { return 1; }
            int cnt = MenuBuilder.sections.Count;
            for (int i = 0; i < cnt; i = i + 1) {
                string s = MenuBuilder.sections[i];
                if ((segLen > 0 && MenuBuilder.SliceEqualsStr(path, segStart, segLen, s))
                    || (segLen == 0 && s.Length == 0)
                    || (MenuBuilder.labels != null && MenuBuilder.labels.Get(s) == group)) {
                    return (i + 1) * 10;
                }
            }
            return 1;
        }
    }

    // pages do.
    public static string GroupOf(string path) {
        int segStart = 0;
        int segLen = 0;
        bool hasSecond = false;
        MenuBuilder.FirstBodySegment(path, out segStart, out segLen, out hasSecond);
        return MenuBuilder.GroupFromSeg(path, segStart, segLen, hasSecond);
    }

    public static int OrderOf(string path) {
        int segStart = 0;
        int segLen = 0;
        bool hasSecond = false;
        MenuBuilder.FirstBodySegment(path, out segStart, out segLen, out hasSecond);
        string g = MenuBuilder.GroupFromSeg(path, segStart, segLen, hasSecond);
        return MenuBuilder.OrderFromSeg(g, path, segStart, segLen);
    }

    public static int OrderOfGroup(string group, string path) {
        if (group.Length == 0) { return -1; }
        int segStart = 0;
        int segLen = 0;
        bool hasSecond = false;
        MenuBuilder.FirstBodySegment(path, out segStart, out segLen, out hasSecond);
        return MenuBuilder.OrderFromSeg(group, path, segStart, segLen);
    }

    private static string CapitalizeFirst(string s) {
        int n = s.Length;
        if (n == 0) { return s; }
        int c0 = s[0] & 255;
        if (c0 < 97 || c0 > 122) { return s; }
        byte[] buf = new byte[n];
        NativeMemory.Copy((nint)buf, (nint)s, n);
        buf[0] = (byte)(c0 - 32);
        return NativeMemory.GetString((nint)buf, 0, n);
    }

    public static bool Matches(string pattern, string path) {
        if (pattern == null || path == null) { return false; }
        int qn = path.Length;
        if (qn == 0) { return false; }
        if (pattern == path) { return true; }
        int pn = pattern.Length;
        int pi = 0;
        int qi = 0;
        int wantCount = 0;
        while (pi < pn) {
            while (pi < pn && (pattern[pi] & 255) == 47) { pi = pi + 1; }
            if (pi >= pn) { break; }
            int pe = pi;
            while (pe < pn && (pattern[pe] & 255) != 47) { pe = pe + 1; }
            wantCount = wantCount + 1;

            while (qi < qn && (path[qi] & 255) == 47) { qi = qi + 1; }
            if (qi >= qn) { return false; }
            int qe = qi;
            while (qe < qn && (path[qe] & 255) != 47) { qe = qe + 1; }

            if ((pattern[pi] & 255) != 123) {
                int wlen = pe - pi;
                if (wlen != qe - qi) { return false; }
                for (int k = 0; k < wlen; k = k + 1) {
                    if ((pattern[pi + k] & 255) != (path[qi + k] & 255)) { return false; }
                }
            }
            pi = pe;
            qi = qe;
        }
        return wantCount > 0;
    }

    public static void Sort(List<MenuNode> list) {
        if (list == null) { return; }
        for (int i = 1; i < list.Count; i = i + 1) {
            MenuNode n = list[i];
            int j = i - 1;
            while (j >= 0 && MenuBuilder.Before(n, list[j])) {
                list[j + 1] = list[j];
                j = j - 1;
            }
            list[j + 1] = n;
        }
    }

    // 排序键：节注册序 → 节名字典序 → URL 字典序。
    private static bool Before(MenuNode a, MenuNode b) {
        if (a.GroupOrder() != b.GroupOrder()) { return a.GroupOrder() < b.GroupOrder(); }
        if (a.Group() != b.Group()) {
            return String.CompareOrdinal(a.Group(), b.Group()) < 0;
        }
        return String.CompareOrdinal(a.Order(), b.Order()) < 0;
    }
}
