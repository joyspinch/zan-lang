using System;
using System.IO;

namespace System.Web;

/// <summary>
/// Serves files from a directory on disk (CSS/JS/fonts/images: everything the
/// views reference but no controller should own).
///
/// It is a Before hook rather than a route: assets must be answered before
/// authentication, rate limiting and the router's pattern matching, and they
/// must not appear in the route table (nothing to secure, nothing to put in a
/// menu). Returning false from the hook short-circuits the request with the
/// response already built.
///
/// <code>
/// StaticFiles.Mount(app, "/static", "public");   // GET /static/css/app.css
/// </code>
///
/// The URL path is resolved against the mounted directory only: a request is
/// rejected unless every byte is an unreserved file character, so "..", "//",
/// backslashes, NUL and query-smuggled separators cannot walk out of the root.
///
/// Bodies are not cached in workers: a public upload directory can contain an
/// unbounded number of files. HttpContext supports buffered binary responses,
/// not file streaming, so files above MaxFileBytes (4 MiB) return 413, including
/// HEAD. Larger downloads need a streaming file server. Upload acceptance is
/// separate and is not changed by this limit. Each in-flight GET owns at most
/// one bounded body; total memory still depends on connection concurrency.
/// Browser caching follows MaxAge. Binary bytes, including NUL, are preserved.
/// Trusted build-time embedded resources retain the runtime's own lazy decode
/// cache; this limit bounds their response copy, not runtime decompression.
/// </summary>
class StaticMount {
    string prefix;
    string root;
    int maxAge;

    StaticMount(string prefix, string root, int maxAge) {
        this.prefix = prefix;
        this.root = root;
        this.maxAge = maxAge;
    }
}

class StaticFiles {
    static string prefix = "";
    static string root = "";
    static int maxAge = 86400;
    static const int MaxFileBytes = 4 * 1024 * 1024;
    static List<StaticMount> mounts = new List<StaticMount>();

    /// <summary>Mounts `dir` under `urlPrefix` and registers the hook on the
    /// app. `urlPrefix` is matched literally ("/static" answers
    /// "/static/css/app.css"); `dir` is relative to the process working
    /// directory.</summary>
    static void Mount(WebApp app, string urlPrefix, string dir) {
        StaticFiles.prefix = urlPrefix;
        StaticFiles.root = dir;
        StaticMount m = new StaticMount(urlPrefix, dir, StaticFiles.maxAge);
        StaticFiles.mounts.Add(m);
        app.Before(StaticFiles.Serve);
    }

    /// <summary>How long browsers may cache an asset (seconds). Set it to 0
    /// while developing so an edited file is picked up by a reload. Existing
    /// mounts follow: Mount snapshots maxAge into the mount record, so a
    /// MaxAge call that only touched the static default would be silently
    /// swallowed by every earlier Mount — the usual Mount-then-MaxAge order
    /// answered assets with the 86400 default (static_files_bounded caught
    /// it).</summary>
    static void MaxAge(int seconds) {
        StaticFiles.maxAge = seconds;
        for (int i = 0; i < StaticFiles.mounts.Count; i = i + 1) {
            StaticMount m = StaticFiles.mounts[i];
            m.maxAge = seconds;
        }
    }

    /// <summary>Before hook: answers asset requests, passes everything else on
    /// (true = keep going).</summary>
    static bool Serve(HttpContext ctx) {
        if (ctx.method != "GET" && ctx.method != "HEAD") { return true; }
        if (StaticFiles.mounts.Count > 0) {
            for (int i = 0; i < StaticFiles.mounts.Count; i = i + 1) {
                StaticMount m = StaticFiles.mounts[i];
                string rel = StaticFiles.RelativeTo(ctx.path, m.prefix);
                if (rel != null) {
                    return StaticFiles.ServeFile(ctx, rel, m.root, m.prefix, m.maxAge);
                }
            }
        }
        if (StaticFiles.root.Length == 0) { return true; }
        string relLegacy = StaticFiles.Relative(ctx.path);
        if (relLegacy == null) { return true; }
        return StaticFiles.ServeFile(ctx, relLegacy, StaticFiles.root, StaticFiles.prefix, StaticFiles.maxAge);
    }

    static bool ServeFile(HttpContext ctx, string rel, string rootDir, string urlPrefix, int ageSeconds) {
        if (rel.Length == 0 || !StaticFiles.IsSafe(rel)) {
            ctx.Status(404, "Not Found").Text("not found");
            return false;
        }
        string full = Directory.ReadPath(rootDir + "/" + rel);
        if (!File.Exists(full)) {
            ctx.Status(404, "Not Found").Text("not found");
            return false;
        }
        FileStream file = null;
        try {
            file = FileStream.OpenRead(full);
        } catch (FileNotFoundException ex) {
            // Embedded assets have no file handle. Their immutable length is
            // checked before copying, rather than using ReadAllBytes.
            if (!File.EmbedExists(full)) {
                ctx.Status(404, "Not Found").Text("not found");
                return false;
            }
            byte[] lengthBytes = new byte[8];
            nint src = File.zan_embed_bytes(File.EmbedName(full), lengthBytes);
            int length = (int)lengthBytes[0] + (int)lengthBytes[1] * 256
                + (int)lengthBytes[2] * 65536 + (int)lengthBytes[3] * 16777216;
            if (src == 0 || length < 0) {
                ctx.Status(404, "Not Found").Text("not found");
                return false;
            }
            if (StaticFiles.TooLarge(ctx, length)) { return false; }
            byte[] embedded = new byte[0];
            if (ctx.method != "HEAD") {
                embedded = new byte[length];
                if (length > 0) { File.EmbedCopyIn(embedded, src, length); }
            }
            StaticFiles.AnswerMount(ctx, urlPrefix, ageSeconds, rel, embedded, length);
            return false;
        }
        try {
            // Measure and read the SAME handle, in 64 bits. A pathname size
            // check followed by ReadAllBytes can race replacement/growth.
            StaticFiles.ServeStreamMount(ctx, rel, file, urlPrefix, ageSeconds);
        } finally {
            file.Close();
        }
        return false;
    }

    /// <summary>Buffered static response from an opened stream. The caller
    /// owns the stream. Reads use the checked length plus a one-byte EOF probe.</summary>
    static void ServeStream(HttpContext ctx, string rel, Stream file) {
        StaticFiles.ServeStreamMount(ctx, rel, file, StaticFiles.prefix, StaticFiles.maxAge);
    }

    static void ServeStreamMount(HttpContext ctx, string rel, Stream file, string urlPrefix, int ageSeconds) {
        long length = file.Length();
        if (length < 0 || file.Seek(0, 0) != 0) {
            ctx.Status(404, "Not Found").Text("not found");
            return;
        }
        if (StaticFiles.TooLarge(ctx, length)) { return; }
        int size = (int)length;
        if (ctx.method == "HEAD") {
            // Binary's non-null marker carries Content-Length; WebApp never
            // sends its bytes for HEAD. Do not allocate/read the file body.
            StaticFiles.AnswerMount(ctx, urlPrefix, ageSeconds, rel, new byte[0], size);
            return;
        }
        byte[] data = new byte[size];
        int have = 0;
        while (have < size) {
            int got = file.ReadInto((nint)data + (nint)have, size - have);
            if (got <= 0 || got > size - have) {
                ctx.Status(503, "Service Unavailable").Text("static file changed or unreadable");
                return;
            }
            have = have + got;
        }
        // Reject growth rather than cache/serve a silently truncated success.
        // Even a continuously growing file costs only this one extra byte.
        byte[] extra = new byte[1];
        int more = file.ReadInto((nint)extra, 1);
        if (more != 0 || file.Length() != length) {
            ctx.Status(503, "Service Unavailable").Text("static file changed or unreadable");
            return;
        }
        StaticFiles.AnswerMount(ctx, urlPrefix, ageSeconds, rel, data, size);
    }

    static bool TooLarge(HttpContext ctx, long length) {
        if (length <= StaticFiles.MaxFileBytes) { return false; }
        ctx.Status(413, "Content Too Large").Text("static file exceeds 4 MiB limit");
        return true;
    }

    static void Answer(HttpContext ctx, string rel, byte[] data, int size) {
        StaticFiles.AnswerMount(ctx, StaticFiles.prefix, StaticFiles.maxAge, rel, data, size);
    }

    static void AnswerMount(HttpContext ctx, string urlPrefix, int ageSeconds, string rel, byte[] data, int size) {
        ctx.routePattern = urlPrefix + "/" + rel;
        ctx.SetHeader("Cache-Control", "public, max-age="
            + Convert.ToString(ageSeconds));
        ctx.Binary(StaticFiles.ContentType(rel), data, size);
    }

    /// <summary>The path below the mount point, or null when the request is not
    /// for this mount.</summary>
    static string Relative(string path) {
        return StaticFiles.RelativeTo(path, StaticFiles.prefix);
    }

    static string RelativeTo(string path, string urlPrefix) {
        int pn = urlPrefix.Length;
        if (path.Length <= pn) { return null; }
        if (path.Substring(0, pn) != urlPrefix) { return null; }
        if ((path[pn] & 255) != 47) { return null; }        // '/'
        return path.Substring(pn + 1);
    }

    /// <summary>Only unreserved path characters, and no empty or dot-leading
    /// segment: that rules out "..", absolute paths, backslashes, NUL bytes and
    /// hidden files in one pass.</summary>
    static bool IsSafe(string rel) {
        int n = rel.Length;
        bool segStart = true;
        for (int i = 0; i < n; i = i + 1) {
            int c = rel[i] & 255;
            if (c == 47) {                                   // '/'
                if (segStart) { return false; }              // "//" or leading
                segStart = true;
                continue;
            }
            if (segStart && c == 46) { return false; }       // ".." / dotfile
            segStart = false;
            bool ok = (c >= 97 && c <= 122)                  // a-z
                || (c >= 65 && c <= 90)                      // A-Z
                || (c >= 48 && c <= 57)                      // 0-9
                || c == 46 || c == 45 || c == 95;            // . - _
            if (!ok) { return false; }
        }
        return !segStart;
    }

    /// 按扩展名（小写化后）映射 Content-Type；未知类型为
    /// application/octet-stream。
    static string ContentType(string rel) {
        string ext = StaticFiles.Extension(rel);
        if (ext == "css") { return "text/css; charset=utf-8"; }
        if (ext == "js") { return "application/javascript; charset=utf-8"; }
        if (ext == "mjs") { return "application/javascript; charset=utf-8"; }
        if (ext == "json") { return "application/json; charset=utf-8"; }
        if (ext == "map") { return "application/json; charset=utf-8"; }
        if (ext == "html") { return "text/html; charset=utf-8"; }
        if (ext == "txt") { return "text/plain; charset=utf-8"; }
        if (ext == "svg") { return "image/svg+xml"; }
        if (ext == "png") { return "image/png"; }
        if (ext == "jpg") { return "image/jpeg"; }
        if (ext == "jpeg") { return "image/jpeg"; }
        if (ext == "gif") { return "image/gif"; }
        if (ext == "webp") { return "image/webp"; }
        if (ext == "ico") { return "image/x-icon"; }
        if (ext == "woff") { return "font/woff"; }
        if (ext == "woff2") { return "font/woff2"; }
        if (ext == "ttf") { return "font/ttf"; }
        return "application/octet-stream";
    }

    /// 末段最后一个 '.' 之后的扩展名（小写）；无扩展名或以 '.' 结尾为空串。
    static string Extension(string rel) {
        int n = rel.Length;
        int dot = -1;
        for (int i = n - 1; i >= 0; i = i - 1) {
            int c = rel[i] & 255;
            if (c == 47) { break; }                          // '/'
            if (c == 46) { dot = i; break; }                 // '.'
        }
        if (dot < 0 || dot == n - 1) { return ""; }
        return rel.Substring(dot + 1, n - dot - 1).ToLower();
    }
}
