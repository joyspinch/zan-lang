using System;
using System.Net.Sockets;
using System.Net.WebSocket;
using System.Text;

namespace System.Web;

/// <summary>WebSocket 服务端会话实例：封装底层连接、帧读写与生命周期管理。</summary>
class WsSession {
    TcpClient client;
    WsReader reader;
    WsWriter writer;
    WsAssembler asm;
    // HTTP 协议升级源上下文：继承超时重置与流式性能指标。
    HttpContext ctx;
    bool open;
    // 最近一次接收到的 WebSocket 帧操作码 (文本/二进制)。
    int lastOpcode;

    WsSession(TcpClient client, WsReader reader, WsWriter writer,
              WsAssembler asm, HttpContext ctx) {
        this.client = client;
        this.reader = reader;
        this.writer = writer;
        this.asm = asm;
        this.ctx = ctx;
        this.open = true;
        this.lastOpcode = WsOpcode.Text;
    }

    /// <summary>当前 WebSocket 会话连接是否处于就绪存活状态。</summary>
    bool Open() { return this.open; }

    /// 接口数据协议与执行契约。
    /// 核心契约与语义定义。
    int LastOpcode() { return this.lastOpcode; }

    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 核心契约与语义定义。
    async string Recv() {
        return await this.Recv(0);
    }

    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    async string Recv(int timeoutMs) {
        while (this.open) {
            int total = this.reader.FrameSize();
            while (total < 0) {
                if (total == -2 || total == -3) {
                    // -2 = 帧长编码违规（1002）；-3 = 消息超过单条上限
                    // （1009）：对端声明一个 2GB 的帧不能把缓冲撑到 OOM。
                    await this.Close(total == -3 ? 1009 : 1002);
                    return null;
                }
                // 接口数据协议与执行契约。
                // 接口数据协议与执行契约。
                if (this.writer.Pending()) {
                    bool flushed = await this.FlushOut();
                    if (!flushed) { return null; }
                }
                int got = await this.reader.FillMore(timeoutMs);
                this.Touch();
                if (got == 0) {
                    this.open = false;
                    return null;
                }
                if (got < 0) { return ""; }  // 空闲窗口到，会话保持
                total = this.reader.FrameSize();
            }

            WsFrame frame = this.reader.TakeFrame(total);

            if (!WsFrame.ValidInbound(frame, true)) {
                // RFC 6455：MVC 与 Worker/WSS 共用客户端帧门禁，避免
                // 某一入口放过未掩码、RSV 或非法 Close 控制帧。
                await this.Close(1002);
                return null;
            }
            if (frame.opcode == WsOpcode.Ping) {
                WsFrame pong = WsFrame.RawFrame(
                    WsOpcode.Pong, frame.payload, frame.payloadLen);
                byte[] encoded = pong.Encode();
                this.writer.Append(encoded,
                    WsFrame.HeaderLen(frame.payloadLen) + frame.payloadLen);
                continue;
            }
            if (frame.opcode == WsOpcode.Pong) { continue; }
            if (frame.opcode == WsOpcode.Close) {
                // 礼貌收尾：回一个空 Close 帧再断开（RFC 6455 §5.5.1）。
                byte[] enc2 = WsFrame.CloseFrame().Encode();
                this.writer.Append(enc2, 2);
                int _f = await this.writer.Flush(this.client);
                this.open = false;
                return null;
            }

            int feed = this.asm.Feed(frame);
            if (feed < 0) {
                // -1 = 协议违规（1002）；-2 = 分片累计超上限（1009）。
                await this.Close(feed == -2 ? 1009 : 1002);
                return null;
            }
            if (feed == 0) { continue; }  // 分片未完，等下一帧

            this.Touch();
            this.lastOpcode = this.asm.MessageOpcode();
            return this.asm.Complete();
        }
        return null;
    }

    /// 接口数据协议与执行契约。
    /// 核心契约与语义定义。
    async bool SendText(string message) {
        if (!this.open || message == null || message.Length > 16777216) {
            return false;
        }
        WsFrame frame = WsFrame.TextFrame(message);
        byte[] encoded = frame.Encode();
        this.writer.Append(encoded,
            WsFrame.HeaderLen(message.Length) + message.Length);
        bool ok = await this.FlushOut();
        if (ok && this.ctx != null) {
            this.ctx.frames = this.ctx.frames + 1;
            this.ctx.framesBytes = this.ctx.framesBytes + message.Length;
        }
        return ok;
    }

    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    async bool SendBinary(string data, int len) {
        if (!this.open || data == null || len < 0
            || len > 16777216 || len > data.Length) { return false; }
        WsFrame frame = WsFrame.BinaryFrame(data, len);
        byte[] encoded = frame.Encode();
        this.writer.Append(encoded, WsFrame.HeaderLen(len) + len);
        bool ok = await this.FlushOut();
        if (ok && this.ctx != null) {
            this.ctx.frames = this.ctx.frames + 1;
            this.ctx.framesBytes = this.ctx.framesBytes + len;
        }
        return ok;
    }

    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    async bool Ping() {
        if (!this.open) { return false; }
        byte[] encoded = WsFrame.PingFrame().Encode();
        this.writer.Append(encoded, 2);
        return await this.FlushOut();
    }

    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    async void Close(int code) {
        if (!this.open) { return; }
        this.open = false;
        byte[] enc = WsFrame.CloseFrameWithCode(code).Encode();
        this.writer.Append(enc, 4);
        int _f = await this.writer.Flush(this.client);
    }

    /// 把写缓冲里挂起的帧推到对端；失败即关闭会话并返回 false。
    async bool FlushOut() {
        int n = await this.writer.Flush(this.client);
        if (n < 0) {
            this.open = false;
            return false;
        }
        this.Touch();
        return true;
    }

    /// 经升级来源的 HttpContext 续期连接空闲窗口；独立构造的会话无操作。
    void Touch() {
        if (this.ctx != null) {
            this.ctx.TouchDeadline(this.ctx.streamIdleMs);
        }
    }
}
