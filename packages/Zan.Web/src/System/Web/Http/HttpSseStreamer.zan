using System;
using System.Diagnostics;
using System.Net.Sockets;
using System.Net.Tls;
using System.Text;

namespace System.Web;

// HTTP Server-Sent Events (SSE) 流式传输器：
// 负责 SSE 协议握手、事件帧打包、保活 Ping 帧发送及底层 TCP/TLS 背压流式循环写出。
public class HttpSseStreamer {

    // 开启 SSE 流式连接通道：发送标准响应头，接管底层 TCP/TLS 连接并标记统计指标。
    public static async bool Open(HttpContext ctx) {
        if (ctx == null || ctx.Hijacked() || ctx.Ended()
            || (ctx.Conn() == null && ctx.Tls() == null)) {
            return false;
        }
        string head = "HTTP/1.1 200 OK\r\n"
            + "Content-Type: " + HttpLimits.MimeEventStream + "\r\n"
            + "Cache-Control: no-cache, no-transform\r\n"
            + "Connection: keep-alive\r\n"
            + "X-Accel-Buffering: no\r\n\r\n";
        bool ok = await ctx.SendAllTcp(head);
        if (!ok) {
            // 响应头可能已部分落网，标记已接管并关闭以避免上层再写出 500 破坏字节流。
            ctx.Hijack();
            ctx.CloseHijack();
            return false;
        }
        ctx.Hijack();
        ctx.MarkEnded();
        ServerMetrics.Global().StreamOpened();
        return true;
    }

    // 循环发送全部 TCP 字节。在客户端高背压或慢订阅者场景下处理短写，直到全部写入或连接中断。
    public static async bool SendAllTcp(TcpClient conn, string data) {
        if (conn == null || data == null) { return false; }
        int total = data.Length;
        if (total == 0) { return true; }
        nint basePtr = (nint)data;
        int sent = 0;
        while (sent < total) {
            StringView rest = new StringView(basePtr + (nint)sent, total - sent);
            int n = await conn.SendViewAsync(rest);
            if (n <= 0) { return false; }
            sent = sent + n;
        }
        return true;
    }

    // 循环发送全部 TLS 字节（HTTPS 下 SSE/WebSocket 握手及帧写出路径）。
    public static async bool SendAllTls(TlsStream stream, string data) {
        if (stream == null || data == null) { return false; }
        int total = data.Length;
        if (total == 0) { return true; }
        byte[] raw = data.ToBytes();
        int sent = 0;
        while (sent < total) {
            int n = await stream.SendBytesAsync(raw, sent, total - sent);
            if (n <= 0) { return false; }
            sent = sent + n;
        }
        return true;
    }

    // 格式化并发送一条 SSE 事件消息（包含可选事件名称与多行 data 编码）。
    public static async bool Send(HttpContext ctx, string name, string data) {
        if (ctx == null || !ctx.Hijacked() || (ctx.Conn() == null && ctx.Tls() == null)) { return false; }
        if (name == null) { name = ""; }
        if (data == null) { data = ""; }
        StringBuilder sb = new StringBuilder();
        if (name.Length > 0) {
            // 剔除事件名中的 CR/LF，防止 SSE 帧字段注入
            StringBuilder cleanName = new StringBuilder();
            for (int ni = 0; ni < name.Length; ni = ni + 1) {
                int nc = name[ni] & 255;
                if (nc != 10 && nc != 13) { cleanName.Append(name.Substring(ni, 1)); }
            }
            string safeName = cleanName.ToString();
            if (safeName.Length > 0) {
                sb.Append("event: ");
                sb.Append(safeName);
                sb.Append("\n");
            }
        }
        int start = 0;
        int dlen = data.Length;
        for (int i = 0; i <= dlen; i = i + 1) {
            bool atEnd = (i == dlen);
            int ch = atEnd ? 0 : (data[i] & 255);
            if (atEnd || ch == 10 || ch == 13) {
                sb.Append("data: ");
                sb.Append(data.Substring(start, i - start));
                sb.Append("\n");
                if (ch == 13 && i + 1 < dlen && (data[i + 1] & 255) == 10) {
                    i = i + 1;
                }
                start = i + 1;
            }
        }
        sb.Append("\n");
        string frame = sb.ToString();
        bool ok = await ctx.SendAllTcp(frame);
        if (!ok) { ctx.CloseHijack(); return false; }
        // 续期超时期限，避免健康流被连接清扫器回收
        ctx.TouchDeadline(ctx.StreamIdleMs());
        ctx.RecordFrame(frame.Length);
        return true;
    }

    // 发送 SSE 格式的标准注释保活帧 (: ping\n\n)。
    public static async bool Ping(HttpContext ctx) {
        if (ctx == null || !ctx.Hijacked() || (ctx.Conn() == null && ctx.Tls() == null)) { return false; }
        bool ok = await ctx.SendAllTcp(": ping\n\n");
        if (!ok) { ctx.CloseHijack(); return false; }
        ctx.TouchDeadline(ctx.StreamIdleMs());
        ctx.RecordFrame(8);
        return true;
    }
}
