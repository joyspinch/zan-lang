using System;
using System.Collections.Generic;

namespace System.Web;

// WebApp 功能扩展部分：GEO/SEO 挂载、模板渲染、静态文件、CSRF 豁免与 WebSocket 来源白名单。
public partial class WebApp {
    public WebApp UseLlmsTxt(LlmsTxt llms) {
        this.llmsTxt = llms;
        if (llms != null) { this.MountLlms(); }
        return this;
    }

    public WebApp UseLlmsSource(LlmsSource source) {
        this.llmsSource = source;
        if (source != null) { this.MountLlms(); }
        return this;
    }

    public void MountLlms() { SeoRouter.MountLlms(this); }

    public WebApp UseRobotsTxt(RobotsTxt robots) {
        this.robotsTxt = robots;
        if (robots != null) { this.MountRobots(); }
        return this;
    }

    public WebApp UseRobotsSource(RobotsSource source) {
        this.robotsSource = source;
        if (source != null) { this.MountRobots(); }
        return this;
    }

    public void MountRobots() { SeoRouter.MountRobots(this); }

    public WebApp UseSitemap(Sitemap sm) {
        this.sitemap = sm;
        if (sm != null) { this.MountSitemap(); }
        return this;
    }

    public WebApp UseSitemapSource(SitemapSource source) {
        this.sitemapSource = source;
        if (source != null) { this.MountSitemap(); }
        return this;
    }

    public void MountSitemap() { SeoRouter.MountSitemap(this); }

    public LlmsTxt Llms() { return this.llmsTxt; }
    public RobotsTxt Robots() { return this.robotsTxt; }
    public Sitemap SiteMap() { return this.sitemap; }
    public LlmsSource LlmsSource() { return this.llmsSource; }
    public RobotsSource RobotsSource() { return this.robotsSource; }
    public SitemapSource SitemapSource() { return this.sitemapSource; }
    public bool IsSitemapMounted() { return this.sitemapMounted; }
    public void MarkSitemapMounted() { this.sitemapMounted = true; }
    public bool IsRobotsMounted() { return this.robotsMounted; }
    public void MarkRobotsMounted() { this.robotsMounted = true; }
    public bool IsLlmsMounted() { return this.llmsMounted; }
    public void MarkLlmsMounted() { this.llmsMounted = true; }
    public bool HasLlms() { return this.llmsTxt != null || this.llmsSource != null; }
    public bool HasRobots() { return this.robotsTxt != null || this.robotsSource != null; }
    public bool HasSitemap() { return this.sitemap != null || this.sitemapSource != null; }

    public static async void HandleLlmsTxt(HttpContext ctx) { SeoRouter.HandleLlmsTxt(ctx); }
    public static async void HandleLlmsFullTxt(HttpContext ctx) { SeoRouter.HandleLlmsFullTxt(ctx); }
    public static async void HandleRobotsTxt(HttpContext ctx) { SeoRouter.HandleRobotsTxt(ctx); }
    public static async void HandleSitemapXml(HttpContext ctx) { SeoRouter.HandleSitemapXml(ctx); }

    public string RenderPage(string name, ViewData data) {
        if (this.views == null) { return ""; }
        return this.views.RenderPage(name, data);
    }

    public string RenderFragment(string name, ViewData data) {
        if (this.views == null) { return ""; }
        return this.views.Render(name, data);
    }

    public WebApp Mount(string urlPrefix, string dir) {
        return this.Mount(urlPrefix, dir, HttpLimits.DefaultTtlSeconds);
    }

    public WebApp Mount(string urlPrefix, string dir, int maxAge) {
        this.staticMounts.Add(new StaticMount(urlPrefix, dir, maxAge));
        if (!this.staticHookInstalled) {
            this.staticHookInstalled = true;
            this.Before(WebApp.StaticHook);
        }
        return this;
    }

    private static bool StaticHook(HttpContext ctx) {
        if (ctx == null) { return true; }
        WebApp app = ctx.App();
        if (app != null) {
            return app.ServeStatic(ctx);
        }
        return true;
    }

    public List<StaticMount> StaticMounts() { return this.staticMounts; }

    public bool ServeStatic(HttpContext ctx) {
        if (ctx.Method() != "GET" && ctx.Method() != "HEAD") { return true; }
        int count = this.staticMounts.Count;
        for (int i = 0; i < count; i = i + 1) {
            StaticMount m = this.staticMounts[i];
            string rel = StaticFiles.RelativeTo(ctx.Path(), m.Prefix());
            if (rel != null) {
                return StaticFiles.ServeFile(ctx, rel, m.Root(), m.Prefix(), m.MaxAge());
            }
        }
        return true;
    }

    public WebApp SkipCsrf(string prefix) {
        if (prefix != null && prefix.Length > 0) {
            this.csrfSkips.Add(prefix);
        }
        return this;
    }

    public bool HasCsrfSkip(string path) {
        int count = this.csrfSkips.Count;
        for (int i = 0; i < count; i = i + 1) {
            string p = this.csrfSkips[i];
            if (p.Length > 0 && HttpContext.StartsWith(path, p)) { return true; }
        }
        return false;
    }

    public WebApp AllowWsOrigin(string origin) {
        if (origin != null && origin.Length > 0) {
            this.wsOrigins.Add(origin);
        }
        return this;
    }

    public bool HasWsOrigin(string origin) {
        int count = this.wsOrigins.Count;
        for (int i = 0; i < count; i = i + 1) {
            if (this.wsOrigins[i] == origin) { return true; }
        }
        return false;
    }
}
