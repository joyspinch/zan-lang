using System.Json;
using System.IO;
using System.Net.Http;
using System.Net.Sockets;
using System.Net.Tls;
using System.Text;
using System.Diagnostics;
using System;

namespace System.Web;

// 统一请求上下文核心：承载请求元数据、参数解析与安全过滤输入。
public partial class HttpContext : IDisposable {
    private WebApp app;
    public RequestTrace Trace { get; internal set; }
    private HttpRequest request;
    private string method;
    private string path;
    private string remoteIp;
    private string clientIp;
    private StrMap routeParams;
    private StrMap query;
    private StrMap form;
    // 已登录的主体 id（匿名时为 ""）。
    private string uid;
    // 命中路由的动作名（"Users.Save"）。
    private string routeAction;
    private string routePattern;
    // 命中路由的下标（O(1) 按路由记账）；非路由（如资源）为 -1。
    private int routeSlot;
    // 已落盘的 multipart 正文路径（无则为 ""）。
    private string uploadPath;
    private long uploadSize;
    // JSON 正文的惰性缓存：JsonBody()/JsonDoc() 第一次调用时解析一次。
    private JsonValue jsonBody;
    private bool jsonParsed;
    private JsonDoc jsonDoc;
    private bool jsonDocParsed;

    private int status;
    private string statusText;
    private string contentType;
    private string body;
    // 二进制字节响应负载（图片、字体等媒体文件）。
    private byte[] bodyBytes;
    private int bodyBytesLen;
    private List<string> headers;
    private bool ended;

    // Worker 级序列化缓冲池持有的全响应（头+正文）缓冲，发送完毕后归还。
    internal StringBuilder responseSb;
    internal byte[] responseBuf;
    internal int responseLen;

    // ---- 流式响应 (SSE / WebSocket) 连接接管 ----
    internal TcpClient conn;
    private TlsStream tlsStream;
    // 传输层已加密但不暴露原始流（HTTP/2 over TLS：应答经帧层写出）。
    private bool transportSecure;
    internal bool hijacked;
    internal bool wasHijacked;
    private long frames;
    private long framesBytes;
    internal HttpDeadlineToken deadlineSlot;
    internal int streamIdleMs;
    internal HttpFramer framer;

    // 构造请求上下文：解析 query，并对 POST/PUT/PATCH 的 urlencoded 或 multipart 正文做表单解析。
    public HttpContext(HttpRequest req, string remoteIp) {
        this.app = null;
        this.Trace = null;
        this.request = req;
        this.method = req.method;
        this.path = req.path;
        this.remoteIp = remoteIp;
        this.clientIp = "";
        this.routeParams = null;
        this.query = null;
        this.form = null;
        this.uid = "";
        this.routeAction = "";
        this.routePattern = "";
        this.routeSlot = 0 - 1;
        this.uploadPath = "";
        this.uploadSize = 0;
        this.jsonBody = null;
        this.jsonParsed = false;
        this.jsonDoc = null;
        this.jsonDocParsed = false;
        this.status = 200;
        this.statusText = "OK";
        this.contentType = HttpLimits.MimeHtmlUtf8;
        this.body = "";
        this.bodyBytes = null;
        this.bodyBytesLen = 0;
        this.headers = null;
        this.ended = false;
        this.responseSb = null;
        this.responseBuf = null;
        this.responseLen = 0;
        this.conn = null;
        this.tlsStream = null;
        this.transportSecure = false;
        this.hijacked = false;
        this.wasHijacked = false;
        this.frames = 0;
        this.framesBytes = 0;
        this.deadlineSlot = null;
        this.streamIdleMs = HttpLimits.DefaultTimeoutMs;
        this.framer = null;
        this.ParseInitialQueryAndForm(req);
    }

    // 长连接复用上下文：原地重置所有请求级字段与集合（保留底层连接与已分配 Map/List 容器）。
    public void ResetForRequest(HttpRequest req, string remoteIp) {
        this.ReleaseResponseBuf();
        this.Trace = null;
        this.request = req;
        this.method = req.method;
        this.path = req.path;
        this.remoteIp = remoteIp;
        this.clientIp = "";
        if (this.routeParams != null) { this.routeParams.Clear(); }
        if (this.query != null) { this.query.Clear(); }
        if (this.form != null) { this.form.Clear(); }
        this.uid = "";
        this.routeAction = "";
        this.routePattern = "";
        this.routeSlot = 0 - 1;
        this.uploadPath = "";
        this.uploadSize = 0;
        this.jsonBody = null;
        this.jsonParsed = false;
        this.jsonDoc = null;
        this.jsonDocParsed = false;
        this.status = 200;
        this.statusText = "OK";
        this.contentType = HttpLimits.MimeHtmlUtf8;
        this.body = "";
        this.bodyBytes = null;
        this.bodyBytesLen = 0;
        if (this.headers != null) { this.headers.Clear(); }
        this.ended = false;
        this.hijacked = false;
        this.wasHijacked = false;
        this.frames = 0;
        this.framesBytes = 0;
        if (req.queryString.Length > 0) {
            if (this.query == null) { this.query = new StrMap(); }
            HttpFormParser.ParsePairs(req.queryString, this.query);
        }
    }

    private void ParseInitialQueryAndForm(HttpRequest req) {
        if (req.queryString.Length > 0) {
            this.query = new StrMap();
            HttpFormParser.ParsePairs(req.queryString, this.query);
        }
        if (req.method == "POST" || req.method == "PUT" || req.method == "PATCH") {
            if (HttpContext.StartsWith(req.contentType, "application/x-www-form-urlencoded")) {
                if (req.body.Length > 0) {
                    this.form = new StrMap();
                    HttpFormParser.ParsePairs(req.body, this.form);
                }
            } else if (HttpContext.StartsWith(req.contentType, "multipart/form-data")) {
                HttpFormParser.ParseMultipartFields(req, this);
            }
        }
    }

    public void Dispose() {
        this.CleanupUpload();
        this.ReleaseResponseBuf();
        if (this.headers != null) {
            this.headers.Clear();
            this.headers = null;
        }
        if (this.form != null) { this.form.Clear(); }
        if (this.query != null) { this.query.Clear(); }
        if (this.routeParams != null) { this.routeParams.Clear(); }
        this.bodyBytes = null;
        this.jsonBody = null;
        this.jsonDoc = null;
    }

    // 客户端实际 IP（在开启反向代理标头还原时提取真实公网 IP，默认回退为底层对端 IP）。
    public void SetClientIp(string ip) { this.clientIp = ip; }
    public string ClientIp() {
        if (this.clientIp != null && this.clientIp.Length > 0) { return this.clientIp; }
        return this.remoteIp;
    }

    public string RemoteIp() { return this.remoteIp; }
    public long RemoteIpLong() { return Socket.Ipv4ToLong(this.remoteIp); }

    public string Method() { return this.method; }
    public string Path() { return this.path; }
    public string Uid() { return this.uid; }
    public void SetUid(string u) { this.uid = u; }
    public string RouteAction() { return this.routeAction; }
    public string RoutePattern() { return this.routePattern; }
    public int RouteSlot() { return this.routeSlot; }
    public string UploadPath() { return this.uploadPath; }
    public long UploadSize() { return this.uploadSize; }
    public int GetStatus() { return this.status; }
    public bool Ended() { return this.ended; }
    public HttpRequest Request() { return this.request; }
    public StrMap RouteParams() { return this.EnsureRouteParams(); }
    public StrMap QueryParams() { return this.EnsureQuery(); }
    public StrMap QueryMap() { return this.EnsureQuery(); }
    public void SetQuery(StrMap q) { this.query = q; }
    public StrMap FormParams() {
        if (this.form == null) { this.form = new StrMap(); }
        return this.form;
    }
    public string ContentType() { return this.contentType; }
    public List<string> Headers() { return this.headers; }

    public string TakeUpload() {
        string path = this.uploadPath;
        this.uploadPath = "";
        this.uploadSize = 0;
        return path;
    }

    public void CleanupUpload() {
        string path = this.TakeUpload();
        if (path.Length == 0) { return; }
        try {
            if (File.Exists(path)) { File.Delete(path); }
        } catch (Exception e) {
            Console.WriteLine("[WebApp upload cleanup] " + e.Message);
        }
    }

    public void SetUpload(string path, long size) {
        this.CleanupUpload();
        this.uploadPath = path;
        this.uploadSize = size;
    }

    public void SetRoute(string action, string pattern, int slot) {
        this.routeAction = action;
        this.routePattern = pattern;
        this.routeSlot = slot;
    }

    public void SetRoutePattern(string pattern) { this.routePattern = pattern; }
    public void SetRouteAction(string action) { this.routeAction = action; }
    public string StatusText() { return this.statusText; }
    public void SetEnded(bool e) { this.ended = e; }
    public void MarkEnded() { this.ended = true; }

    public StrMap EnsureForm() {
        if (this.form == null) { this.form = new StrMap(); }
        else { this.form.Clear(); }
        return this.form;
    }

    public StrMap EnsureRouteParams() {
        if (this.routeParams == null) { this.routeParams = new StrMap(); }
        return this.routeParams;
    }

    public StrMap EnsureQuery() {
        if (this.query == null) { this.query = new StrMap(); }
        return this.query;
    }

    public static void ParseFormBody(HttpRequest req, HttpContext ctx) {
        HttpFormParser.ParseFormBody(req, ctx);
    }

    public static void ParseMultipartFields(HttpRequest req, HttpContext ctx) {
        HttpFormParser.ParseMultipartFields(req, ctx);
    }

    public string Param(string name) {
        if (this.routeParams == null) { return ""; }
        return this.routeParams.Get(name);
    }
    public string Query(string name) {
        if (this.query == null) { return ""; }
        return this.query.Get(name);
    }
    public string Form(string name) {
        if (this.form == null) { return ""; }
        return this.form.Get(name);
    }
    public string Body() { return this.request.body; }

    public JsonValue JsonBody() {
        if (!this.jsonParsed) {
            this.jsonParsed = true;
            this.jsonBody = null;
            string b = this.request.body;
            if (b.Length > 0) {
                this.jsonBody = JsonValue.ParseLenient(b);
            }
        }
        return this.jsonBody;
    }

    public JsonDoc JsonDoc() {
        if (!this.jsonDocParsed) {
            this.jsonDocParsed = true;
            this.jsonDoc = null;
            string b = this.request.body;
            if (b.Length > 0) {
                try {
                    this.jsonDoc = System.Json.JsonDoc.Parse(b);
                } catch (Exception _ex) {
                    this.jsonDoc = null;
                }
            }
        }
        return this.jsonDoc;
    }

    public int JsonInt(string path, int dflt) {
        JsonDoc doc = this.JsonDoc();
        return doc != null ? doc.PathInt(path, dflt) : dflt;
    }

    public long JsonLong(string path, long dflt) {
        JsonDoc doc = this.JsonDoc();
        return doc != null ? doc.PathLong(path, dflt) : dflt;
    }

    public string JsonStr(string path, string dflt) {
        JsonDoc doc = this.JsonDoc();
        return doc != null ? doc.PathStr(path, dflt) : dflt;
    }

    public bool JsonBool(string path, bool dflt) {
        JsonDoc doc = this.JsonDoc();
        return doc != null ? doc.PathBool(path, dflt) : dflt;
    }

    public string InputString(string name) { return this.InRaw(name); }
    public int InputInt(string name, int dflt) { return this.InInt(name, dflt); }
    public long InputLong(string name, long dflt) { return this.InLong(name, dflt); }
    public bool InputBool(string name, bool dflt) { return this.InBool(name, dflt); }

    public static int ParseIntStrict(string v, int dflt) {
        if (v == null || v.Length == 0) { return dflt; }
        long sentinel = 2147483648L;
        long r = HttpContext.ParseLongStrict(v, sentinel);
        if (r > 2147483647L || r < -2147483648L) { return dflt; }
        return (int)r;
    }

    private static bool AsciiEq(string a, string b) {
        if (a.Length != b.Length) { return false; }
        for (int i = 0; i < a.Length; i = i + 1) {
            int x = a[i] & 255;
            int y = b[i] & 255;
            if (x >= 65 && x <= 90) { x = x + 32; }
            if (y >= 65 && y <= 90) { y = y + 32; }
            if (x != y) { return false; }
        }
        return true;
    }

    public static long ParseLongStrict(string v, long dflt) {
        if (v == null || v.Length == 0) { return dflt; }
        int i = 0;
        bool neg = false;
        int c0 = v[0] & 255;
        if (c0 == 45) { neg = true; i = 1; }
        else if (c0 == 43) { i = 1; }
        if (i >= v.Length) { return dflt; }
        long acc = 0L;
        long minVal = -9223372036854775807L - 1L;
        long minLimit10 = -922337203685477580L;
        while (i < v.Length) {
            int c = v[i] & 255;
            if (c < 48 || c > 57) { return dflt; }
            long d = (long)(c - 48);
            if (acc < minLimit10) { return dflt; }
            acc = acc * 10L;
            if (acc < minVal + d) { return dflt; }
            acc = acc - d;
            i = i + 1;
        }
        if (neg) { return acc; }
        if (acc == minVal) { return dflt; }
        return -acc;
    }

    public string Header(string name) { return this.request.GetHeader(name); }

    public string Cookie(string name) {
        string all = this.request.GetHeader("Cookie");
        int allLen = all.Length;
        if (allLen == 0) { return ""; }
        int nameLen = name.Length;
        int i = 0;
        while (i < allLen) {
            while (i < allLen) {
                int c = all[i] & 255;
                if (c != 32 && c != 59) { break; }
                i = i + 1;
            }
            int e = i;
            while (e < allLen && (all[e] & 255) != 59) { e = e + 1; }
            if (e - i > nameLen + 1 && (all[i + nameLen] & 255) == 61) {
                bool same = true;
                for (int k = 0; k < nameLen; k = k + 1) {
                    if ((all[i + k] & 255) != (name[k] & 255)) { same = false; break; }
                }
                if (same) {
                    int vStart = i + nameLen + 1;
                    return all.Substring(vStart, e - vStart);
                }
            }
            i = e + 1;
        }
        return "";
    }

    public bool IsAjax() {
        string x = this.request.GetHeader("X-Requested-With");
        return x == "XMLHttpRequest" || x == "xmlhttprequest";
    }

    public string InRaw(string name) {
        if (this.routeParams != null) {
            string v = this.routeParams.Get(name);
            if (v.Length > 0) { return v; }
        }
        if (this.query != null) {
            string v = this.query.Get(name);
            if (v.Length > 0) { return v; }
        }
        if (this.form != null) {
            return this.form.Get(name);
        }
        return "";
    }

    public string In(string name) { return Filter.Clean(this.InRaw(name)); }
    public string InText(string name) { return Filter.Html(this.InRaw(name)); }
    public int InInt(string name, int def) { return HttpContext.ParseIntStrict(Filter.Clean(this.InRaw(name)), def); }
    public long InLong(string name, long def) { return HttpContext.ParseLongStrict(Filter.Clean(this.InRaw(name)), def); }
    public double InDouble(string name, double def) { return Filter.ToDouble(this.InRaw(name), def); }
    public bool InBool(string name, bool def) { return Filter.ToBool(this.InRaw(name), def); }

    public bool HasIn(string name) {
        if (this.form != null && this.form.Has(name)) { return true; }
        if (this.query != null && this.query.Has(name)) { return true; }
        if (this.routeParams != null && this.routeParams.Has(name)) { return true; }
        return false;
    }

    public static bool StartsWith(string s, string prefix) {
        if (s == null || prefix == null || s.Length < prefix.Length) { return false; }
        int n = prefix.Length;
        for (int i = 0; i < n; i = i + 1) {
            if (s[i] != prefix[i]) { return false; }
        }
        return true;
    }

    public static void ParsePairs(string s, StrMap into) {
        HttpFormParser.ParsePairs(s, into);
    }
}
