namespace System.Web;

// Web 应用服务器核心：配置项、共享内存表初始化、路由注册、生命周期与状态快照。
public partial class WebApp : IDisposable {
    private string host;
    private int port;
    private bool running;
    private TcpListener listener;
    // 共享内存表：包含限流、锁和路由计数器，多工作进程间无拷贝共享。
    private Router router;
    private Hooks hooks;
    private View views;
    private Sessions sessions;
    private ISessionStorage sessionStorage;
    private ForwardedHeaders forwardedHeaders;
    private HealthChecks healthChecks;
    private RateLimiter limiter;
    private LockManager locks;
    private AuthFn authResolver;
    private PermissionFn permissionResolver;
    private ScopedPermissionFn scopedPermissionResolver;
    private ServerMetrics metrics;
    private RequestProfiler requestProfiler;
    private bool profileRequestResources;
    private bool profileRequestExecution;
    private bool profileRequestStages;
    private RequestDiagnosticsHandler requestDiagnostics;
    private int requestDiagnosticEvery;
    private AtomicInt requestDiagnosticSequence;
    private LlmsTxt llmsTxt;
    private RobotsTxt robotsTxt;
    private Sitemap sitemap;
    /* 应用层 GEO 内容源：内容由应用层每次请求求值，协议层只渲染。 */
    private SitemapSource sitemapSource;
    private RobotsSource robotsSource;
    private LlmsSource llmsSource;
    /* 挂载幂等标记：静态对象与内容源共用挂载点，同一路径只挂一次。 */
    private bool sitemapMounted;
    private bool robotsMounted;
    private bool llmsMounted;
    private List<StaticMount> staticMounts;
    private bool staticHookInstalled;
    private List<string> csrfSkips;
    private List<string> wsOrigins;
    private TlsContext tls;
    private string certFile;
    private string keyFile;

    private int maxBodyBytes;
    private int maxUploadBytes;
    private int requestTimeoutMs;
    private int maxConnections;
    private string uploadDir;
    private AtomicInt uploadSeq;
    private string loginPath;
    private string sessionCookie;
    private string authHeader;
    private string authScheme;
    private string apiPrefix;
    private List<string> extraApiPrefixes;
    private string[] customErrorBodies;
    private int globalLimit;
    private AtomicInt[] totalRequestsShards;
    private AtomicInt activeConnections;
    private bool reusePort;

    private static WebApp active;
    private static string[] defaultErrorBodies;

    private static const string ShareRate = "WEB_RATE";
    private static const string ShareLock = "WEB_LOCK";
    private static const string ShareRoute = "WEB_ROUTE";
    private static const string ShareRouteTable = "WEB_ROUTE_TABLE";

    public WebApp(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.router = new Router();
        this.hooks = new Hooks();
        this.views = null;
        this.sessions = new Sessions();
        this.sessionStorage = this.sessions;
        this.forwardedHeaders = null;
        this.healthChecks = null;
        this.authResolver = null;
        this.permissionResolver = null;
        this.metrics = ServerMetrics.Global();
        int profileCapacity = Filter.ToInt(Environment.GetEnvironmentVariable("ZAN_REQUEST_PROFILE_CAPACITY"), 0);
        if (profileCapacity > 0) { this.requestProfiler = new RequestProfiler(profileCapacity); }
        this.profileRequestResources = Environment.GetEnvironmentVariable("ZAN_REQUEST_PROFILE_RESOURCES") == "1";
        this.profileRequestExecution = this.profileRequestResources && OperatingSystem.IsWindows()
            && Environment.GetEnvironmentVariable("ZAN_REQUEST_PROFILE_EXECUTION") == "1";
        this.profileRequestStages = this.profileRequestResources
            && Environment.GetEnvironmentVariable("ZAN_REQUEST_PROFILE_STAGES") == "1";
        if (this.profileRequestResources) { RequestTrace.EnableResources(); }
        this.maxBodyBytes = HttpLimits.DefaultMaxBodyBytes;
        this.maxUploadBytes = HttpLimits.DefaultMaxUploadBytes;
        this.requestTimeoutMs = HttpLimits.DefaultTimeoutMs;
        this.maxConnections = HttpLimits.DefaultMaxConnections;
        this.uploadDir = HttpLimits.DefaultUploadDir;
        this.uploadSeq = new AtomicInt(0);
        this.loginPath = "";
        this.sessionCookie = HttpLimits.DefaultSessionCookie;
        this.authHeader = HttpLimits.DefaultAuthHeader;
        this.authScheme = HttpLimits.DefaultAuthScheme;
        this.apiPrefix = HttpLimits.DefaultApiPrefix;
        this.extraApiPrefixes = null;
        this.customErrorBodies = null;
        this.globalLimit = 0;
        this.totalRequestsShards = new AtomicInt[16];
        for (int i = 0; i < 16; i = i + 1) {
            this.totalRequestsShards[i] = new AtomicInt(0);
        }
        this.activeConnections = new AtomicInt(0);
        this.reusePort = false;
        this.limiter = null;
        this.locks = null;
        this.sitemapMounted = false;
        this.robotsMounted = false;
        this.llmsMounted = false;
        this.staticMounts = new List<StaticMount>();
        this.staticHookInstalled = false;
        this.csrfSkips = new List<string>();
        this.wsOrigins = new List<string>();
        this.tls = null;
        this.certFile = "";
        this.keyFile = "";
    }

    // ---- 基础配置 ----
    public string Host() { return this.host; }
    public int Port() { return this.port; }
    public Router Router() { return this.router; }
    public Hooks Hooks() { return this.hooks; }
    public View GetViews() { return this.views; }
    public Sessions Sessions() { return this.sessions; }
    public WebApp UseSessions(ISessionStorage storage) {
        if (storage != null) { this.sessionStorage = storage; }
        return this;
    }
    public ISessionStorage SessionStorage() { return this.sessionStorage; }

    // 启用反向代理标头还原（X-Forwarded-For 真实客户端 IP）。只信
    // ForwardedHeaders().AddTrustedProxy 登记的代理跳；未登记任何代理时
    // XFF 一律忽略，客户端自带的头不能换限流桶。
    public WebApp UseForwardedHeaders() {
        if (this.forwardedHeaders == null) { this.forwardedHeaders = new ForwardedHeaders(); }
        this.forwardedHeaders.Enable();
        return this;
    }
    public ForwardedHeaders ForwardedHeaders() { return this.forwardedHeaders; }

    public WebApp UseHealthChecks() { return this.UseHealthChecks("/healthz", "/readyz"); }
    public WebApp UseHealthChecks(string livenessPath, string readinessPath) {
        if (this.healthChecks == null) {
            this.healthChecks = new HealthChecks(livenessPath, readinessPath);
        }
        this.healthChecks.Enable();
        this.router.Get(this.healthChecks.LivenessPath(), HealthChecks.HandleLiveness);
        this.router.Get(this.healthChecks.ReadinessPath(), this.healthChecks.HandleReadiness);
        return this;
    }
    public HealthChecks Health() { return this.healthChecks; }

    public void Drain() {
        if (this.healthChecks != null) { this.healthChecks.Drain(); }
    }

    public WebApp UseWsBackplane(IWsBackplane backplane) {
        WsHub.Default().UseBackplane(backplane);
        return this;
    }
    public WebApp UseWsBackplane(WsBackplanePublishHandler publishFn) {
        WsHub.Default().UseBackplane(publishFn);
        return this;
    }
    public ServerMetrics Metrics() { return this.metrics; }

    public WebApp UseRequestProfiler(RequestProfiler profiler) { this.requestProfiler = profiler; return this; }
    public RequestProfiler RequestProfile() { return this.requestProfiler; }

    public WebApp UseRequestDiagnostics(int every, RequestDiagnosticsHandler completed) {
        this.requestDiagnostics = every > 0 ? completed : null;
        this.requestDiagnosticEvery = every;
        this.requestDiagnosticSequence = this.requestDiagnostics != null && every > 1
            ? new AtomicInt(Stopwatch.GetMicroseconds()) : null;
        return this;
    }

    private RequestTrace StartRequestTrace(string protocol, long startUs) {
        RequestDiagnosticsHandler report = this.requestDiagnostics;
        if (report != null && this.requestDiagnosticSequence != null) {
            long draw = this.requestDiagnosticSequence.Increment() * 6364136223846793005L;
            if (((draw >> 33) & 2147483647L) % this.requestDiagnosticEvery != 0) { report = null; }
        }
        if (this.requestProfiler != null) { return this.requestProfiler.Start(protocol, startUs, report); }
        return report != null ? new RequestTrace(null, report, 0, protocol, startUs) : null;
    }

    public WebApp Views(string dir) { this.views = View.LoadDir(dir); return this; }
    public WebApp MaxBody(int bytes) { this.maxBodyBytes = bytes; return this; }
    public WebApp MaxUpload(int bytes) { this.maxUploadBytes = bytes; return this; }
    public WebApp Timeout(int ms) { this.requestTimeoutMs = ms; return this; }
    public WebApp MaxConnections(int n) { this.maxConnections = n; return this; }
    public WebApp UploadDir(string dir) { this.uploadDir = dir; return this; }
    public WebApp GlobalLimit(int perSecond) { this.globalLimit = perSecond; return this; }
    public WebApp LoginPath(string path) { this.loginPath = path; return this; }
    public WebApp SessionCookie(string name) {
        if (name != null && name.Length > 0) { this.sessionCookie = name; }
        return this;
    }
    public string GetSessionCookie() { return this.sessionCookie; }
    public WebApp AuthHeader(string header, string scheme) {
        if (header != null && header.Length > 0) { this.authHeader = header; }
        if (scheme != null) { this.authScheme = scheme; }
        return this;
    }
    public string GetAuthHeader() { return this.authHeader; }
    public string GetAuthScheme() { return this.authScheme; }
    public WebApp ApiPrefix(string prefix) {
        this.apiPrefix = prefix != null ? prefix : "";
        return this;
    }
    public WebApp AddApiPrefix(string prefix) {
        if (prefix != null && prefix.Length > 0) {
            if (this.extraApiPrefixes == null) { this.extraApiPrefixes = new List<string>(); }
            this.extraApiPrefixes.Add(prefix);
        }
        return this;
    }
    public bool IsApiPath(string path) {
        if (path == null || path.Length == 0) { return false; }
        if (WebApp.MatchesPrefix(path, this.apiPrefix)) { return true; }
        if (this.extraApiPrefixes != null) {
            for (int i = 0; i < this.extraApiPrefixes.Count; i = i + 1) {
                if (WebApp.MatchesPrefix(path, this.extraApiPrefixes[i])) { return true; }
            }
        }
        return false;
    }
    private static bool MatchesPrefix(string path, string prefix) {
        if (prefix == null || prefix.Length == 0) { return false; }
        if (prefix == "/") { return path.StartsWith("/"); }
        if (path == prefix) { return true; }
        if (!path.StartsWith(prefix)) { return false; }
        return (path[prefix.Length] & 255) == 47;
    }
    public WebApp Error(int status, string code, string msg) {
        if (status >= 400 && status < 520) {
            if (this.customErrorBodies == null) { this.customErrorBodies = new string[120]; }
            this.customErrorBodies[status - 400] = WebApp.BuildErrorJson(code, msg);
        }
        return this;
    }
    private static string BuildErrorJson(string code, string msg) {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("code", code != null ? code : "");
        w.WriteProperty("msg", msg != null ? msg : "");
        w.WriteEndObject();
        return w.ToJson();
    }
    public WebApp ReusePort(bool on) { this.reusePort = on; return this; }

    public WebApp UseHttps(string certFile, string keyFile) {
        this.certFile = certFile;
        this.keyFile = keyFile;
        this.tls = TlsContext.CreateServer(certFile, keyFile);
        return this.UseTls(this.tls);
    }

    public WebApp UseTls(TlsContext ctx) {
        if (ctx != null && ctx.alpnProtocols.Count == 0) {
            ctx.alpnProtocols.Add("h2");
            ctx.alpnProtocols.Add("http/1.1");
        }
        this.tls = ctx;
        return this;
    }

    public bool IsHttps() { return this.tls != null; }
    public TlsContext Tls() { return this.tls; }
    public bool IsRunning() { return this.running; }

    // ---- 共享内存表（多工作进程无拷贝共享） ----
    public void InitStats() { this.router.InitStatsShared(); }

    public void InitShared() {
        if (this.AttachShared()) { return; }
        RateLimiter l = this.Limiter();
        LockManager k = this.Locks();
        this.InitStats();
        this.router.InitRouteTableShared();
        Worker.ShareHandle(WebApp.ShareRate, l.OsHandle());
        Worker.ShareHandle(WebApp.ShareLock, k.OsHandle());
        Worker.ShareHandle(WebApp.ShareRoute, this.router.StatsOsHandle());
        Worker.ShareHandle(WebApp.ShareRouteTable, this.router.RouteTableOsHandle());
    }

    public bool AttachShared() {
        long rate = Worker.InheritedHandle(WebApp.ShareRate);
        long lockTable = Worker.InheritedHandle(WebApp.ShareLock);
        long route = Worker.InheritedHandle(WebApp.ShareRoute);
        long routeTable = Worker.InheritedHandle(WebApp.ShareRouteTable);
        if (rate == 0 && lockTable == 0 && route == 0 && routeTable == 0) { return false; }
        if (this.limiter == null) { this.limiter = RateLimiter.Attach(rate, 1000); }
        if (this.locks == null) { this.locks = LockManager.Attach(lockTable); }
        this.router.AttachStats(route);
        this.router.AttachRouteTable(routeTable);
        return true;
    }

    public RateLimiter Limiter() {
        if (this.limiter == null) { this.limiter = RateLimiter.Owned(1000); }
        return this.limiter;
    }

    public LockManager Locks() {
        if (this.locks == null) { this.locks = LockManager.Owned(); }
        return this.locks;
    }

    // ---- 钩子、鉴权与路由注册 ----
    public WebApp Before(HookFn fn) { this.hooks.Before(fn); return this; }
    public WebApp After(AfterFn fn) { this.hooks.After(fn); return this; }
    public WebApp AuthResolver(AuthFn fn) { this.authResolver = fn; return this; }
    public WebApp PermissionResolver(PermissionFn fn) {
        this.permissionResolver = fn;
        this.scopedPermissionResolver = null;
        return this;
    }

    public WebApp ScopedPermissionResolver(ScopedPermissionFn fn) {
        this.scopedPermissionResolver = fn;
        this.permissionResolver = null;
        return this;
    }

    public Route Map(string method, string pattern, HttpHandler h) {
        return this.router.Add(method, pattern, h);
    }

    public Route MapRegex(string method, string pattern, HttpHandler h) {
        return this.router.AddRegex(method, pattern, h);
    }

    public Route Get(string pattern, HttpHandler h) { return this.router.Get(pattern, h); }
    public Route Post(string pattern, HttpHandler h) { return this.router.Post(pattern, h); }
    public Route Put(string pattern, HttpHandler h) { return this.router.Put(pattern, h); }
    public Route Delete(string pattern, HttpHandler h) { return this.router.Delete(pattern, h); }

    // 纯同步路由快捷入口（零协程帧分配）
    public Route MapSync(string method, string pattern, SyncHttpAction h) {
        return this.router.AddSync(method, pattern, h);
    }
    public Route GetSync(string pattern, SyncHttpAction h) { return this.router.GetSync(pattern, h); }
    public Route PostSync(string pattern, SyncHttpAction h) { return this.router.PostSync(pattern, h); }
    public Route PutSync(string pattern, SyncHttpAction h) { return this.router.PutSync(pattern, h); }
    public Route DeleteSync(string pattern, SyncHttpAction h) { return this.router.DeleteSync(pattern, h); }

    public static int NowSeconds() { return (int)(DateTime.GetCurrentUnixMilliseconds() / 1000L); }

    public bool IsTrustedProxy(string remoteIp) {
        return this.forwardedHeaders != null && this.forwardedHeaders.IsTrustedPeer(remoteIp);
    }

    private static string Redact(string s) {
        if (s == null) { return ""; }
        if (s.Length > 500) { return s.Substring(0, 500); }
        return s;
    }

    public ServerBanner Banner(int procs) {
        string mode = "single process";
        if (procs > 1) { mode = "master + " + Convert.ToString(procs) + " workers"; }
        ServerBanner b = new ServerBanner("ZAN WEB", "SERVICES").Mode(mode);
        b.Service("http",
            "http://" + this.host + ":" + Convert.ToString(this.port),
            Convert.ToString(procs), "[OK]");
        b.Info("routes", Convert.ToString(this.router.Count()));
        if (this.views != null) { b.Info("views", "loaded"); }
        if (this.sessionStorage != null) {
            b.Info("sessions", this.sessionStorage == this.sessions ? "in-memory" : "distributed");
        }
        if (this.forwardedHeaders != null && this.forwardedHeaders.IsEnabled()) {
            b.Info("proxy-headers", "on");
        }
        if (this.healthChecks != null && this.healthChecks.IsEnabled()) {
            b.Info("health", "on");
        }
        b.Info("max body", Convert.ToString(this.maxBodyBytes / (1024 * 1024)) + "MB");
        b.Info("uploads", this.uploadDir + "/ "
            + Convert.ToString(this.maxUploadBytes / (1024 * 1024)) + "MB max");
        if (this.globalLimit > 0) {
            b.Info("rate limit", Convert.ToString(this.globalLimit) + " req/s");
        }
        if (this.reusePort) { b.Info("reuseport", "on"); }
        return b;
    }

    public async int Start() {
        this.InitShared();
        Socket.Initialize();
        this.listener = new TcpListener(this.host, this.port);
        if (this.reusePort) { this.listener.StartReusePort(); } else { this.listener.Start(); }
        this.running = true;
        this.Banner(1).Footer("Press Ctrl+C to stop. Start success.").Print();
        while (this.running) {
            nint clientSock = await this.listener.AcceptAsync();
            if (clientSock >= 0) {
                if (await this.RefuseOverCapacity(clientSock)) { continue; }
                if (this.tls != null) {
                    Task.Spawn(HandleTlsConnection(clientSock));
                } else {
                    Task.Spawn(HandleConnection(clientSock));
                }
            }
        }
        return 0;
    }

    public void Stop() {
        this.running = false;
        if (this.listener != null) { this.listener.Stop(); }
    }

    public void Dispose() {
        this.Stop();
        if (this.hooks != null) { this.hooks.Clear(); }
        if (this.staticMounts != null) { this.staticMounts.Clear(); }
        if (this.csrfSkips != null) { this.csrfSkips.Clear(); }
        if (this.wsOrigins != null) { this.wsOrigins.Clear(); }
        if (this.limiter != null) {
            this.limiter.Dispose();
            this.limiter = null;
        }
        if (this.locks != null) {
            this.locks.Dispose();
            this.locks = null;
        }
        if (this.tls != null) {
            this.tls.Free();
            this.tls = null;
        }
    }

    public void Activate() { active = this; }

    public static void SetActive(WebApp app) {
        if (app != null) { app.Activate(); }
        else { active = null; }
    }

    public string StatusJson() {
        WebAppStatusDoc o = new WebAppStatusDoc();
        long totalReq = 0;
        for (int i = 0; i < 16; i = i + 1) {
            totalReq = totalReq + this.totalRequestsShards[i].Load();
        }
        o.total_requests = (int)totalReq;
        o.active_connections = (int)this.activeConnections.Load();
        o.routes = this.router.Stats();
        return Json.Serialize<WebAppStatusDoc>(o);
    }

    public string MetricsJson() { return this.metrics.SnapshotJson(); }
    public string MetricsSeriesJson(int seconds) { return this.metrics.SeriesJson(seconds); }
}
