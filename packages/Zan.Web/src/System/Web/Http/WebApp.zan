using System.Diagnostics;
using System.IO;
using System.Json;
using System.Net.Http;
using System.Net.Http.Http2;
using System.Net.Sockets;
using System.Net.Tls;
using System.Net;
using System.Text;
using System.Threading;
using System;

namespace System.Web;

public class WebApp : IDisposable {
    private string host;
    private int port;
    private bool running;
    private TcpListener listener;
    // 共享内存表：包含限流、锁和路由计数器，多工作进程间无拷贝共享。
    private Router router;
    private Hooks hooks;
    private View views;
    private Sessions sessions;
    private ISessionStorage sessionStorage;
    private ForwardedHeaders forwardedHeaders;
    private HealthChecks healthChecks;
    private RateLimiter limiter;
    private LockManager locks;
    private AuthFn authResolver;
    private PermissionFn permissionResolver;
    private ServerMetrics metrics;
    private LlmsTxt llmsTxt;
    private RobotsTxt robotsTxt;
    private Sitemap sitemap;
    /* 应用层 GEO 内容源：内容由应用层每次请求求值，协议层只渲染。 */
    private SitemapSource sitemapSource;
    private RobotsSource robotsSource;
    private LlmsSource llmsSource;
    /* 挂载幂等标记：静态对象与内容源共用挂载点，同一路径只挂一次。 */
    private bool sitemapMounted;
    private bool robotsMounted;
    private bool llmsMounted;
    private List<StaticMount> staticMounts;
    private bool staticHookInstalled;
    private List<string> csrfSkips;
    private List<string> wsOrigins;
    private TlsContext tls;
    private string certFile;
    private string keyFile;

    // 内存请求体上限（字节），超出回答 413。
    private int maxBodyBytes;  // in-memory request body cap (413 above this)
    // 流式上传上限（字节），只作用于 [Upload] 路由。
    private int maxUploadBytes;  // streaming upload cap for .Upload() routes
    private int requestTimeoutMs;  // per-request deadline: a connection that stops
    // 并发连接上限（0 = 不设上限；超限回答 503 并关闭）。
    private int maxConnections;  // concurrent connections served at once (0 = no cap)
    private string uploadDir;  // where streamed uploads land
    // 进程内全局连接统计原子计数器。
    private AtomicInt uploadSeq;
    private string loginPath;
    // 全局每秒请求上限（0 = 不限；超限 429）。
    private int globalLimit;  // requests/sec across all routes (0 = unlimited)
    private AtomicInt totalRequests;
    private AtomicInt activeConnections;
    private bool reusePort;

    // 当前进程单例应用实例句柄，供 Worker 底层连接回调分发。
    private static WebApp active;

    // 构造应用服务器并填入默认配置：请求体上限 2MB、流式上传上限
    // 512MB、请求超时 30s、并发连接上限 10000、上传目录 uploads；
    // 共享表（限流/锁/路由统计）由 InitShared 在派生 worker 之前创建，
    // 不在这里。
    public WebApp(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.router = new Router();
        this.hooks = new Hooks();
        this.views = null;
        this.sessions = new Sessions();
        this.sessionStorage = this.sessions;
        this.forwardedHeaders = null;
        this.healthChecks = null;
        this.authResolver = null;
        this.permissionResolver = null;
        this.metrics = ServerMetrics.Global();
        this.maxBodyBytes = HttpLimits.DefaultMaxBodyBytes;
        this.maxUploadBytes = HttpLimits.DefaultMaxUploadBytes;
        this.requestTimeoutMs = HttpLimits.DefaultTimeoutMs;
        this.maxConnections = HttpLimits.DefaultMaxConnections;
        this.uploadDir = HttpLimits.DefaultUploadDir;
        this.uploadSeq = new AtomicInt(0);
        this.loginPath = "";
        this.globalLimit = 0;
        this.totalRequests = new AtomicInt(0);
        this.activeConnections = new AtomicInt(0);
        this.reusePort = false;
        // 共享内存表在 Worker 派生前由 InitShared 创建。
        this.limiter = null;
        this.locks = null;
        this.sitemapMounted = false;
        this.robotsMounted = false;
        this.llmsMounted = false;
        this.staticMounts = new List<StaticMount>();
        this.staticHookInstalled = false;
        this.csrfSkips = new List<string>();
        this.wsOrigins = new List<string>();
        this.tls = null;
        this.certFile = "";
        this.keyFile = "";
    }

    // ---- configuration ----

    // 监听主机地址。
    public string Host() { return this.host; }
    // 监听端口。
    public int Port() { return this.port; }
    // 路由分发器。
    public Router Router() { return this.router; }
    // 中间件钩子注册器。
    public Hooks Hooks() { return this.hooks; }
    // 视图模板引擎实例。
    public View GetViews() { return this.views; }
    // 内存/分布式会话管理器。
    public Sessions Sessions() { return this.sessions; }
    // 配置分布式或自定义会话持久化存储驱动（默认使用本地高性能内存会话）。
    public WebApp UseSessions(ISessionStorage storage) {
        if (storage != null) {
            this.sessionStorage = storage;
        }
        return this;
    }
    public ISessionStorage SessionStorage() { return this.sessionStorage; }

    // 启用反向代理标头还原（解析 X-Forwarded-For 真实客户端 IP 与 X-Forwarded-Proto 协议）。
    public WebApp UseForwardedHeaders() {
        if (this.forwardedHeaders == null) {
            this.forwardedHeaders = new ForwardedHeaders();
        }
        this.forwardedHeaders.Enable();
        return this;
    }
    public ForwardedHeaders ForwardedHeaders() { return this.forwardedHeaders; }

    // 启用云原生与负载均衡器健康检查探针（默认 /healthz 与 /readyz）。
    public WebApp UseHealthChecks() {
        return this.UseHealthChecks("/healthz", "/readyz");
    }
    public WebApp UseHealthChecks(string livenessPath, string readinessPath) {
        if (this.healthChecks == null) {
            this.healthChecks = new HealthChecks(livenessPath, readinessPath);
        }
        this.healthChecks.Enable();
        this.router.Get(this.healthChecks.LivenessPath(), HealthChecks.HandleLiveness);
        this.router.Get(this.healthChecks.ReadinessPath(), this.healthChecks.HandleReadiness);
        return this;
    }
    public HealthChecks Health() { return this.healthChecks; }

    // 平滑排空本节点流量（Ready 探针置为 503 DRAINING，网关摘除流量）。
    public void Drain() {
        if (this.healthChecks != null) {
            this.healthChecks.Drain();
        }
    }

    // 配置集群 WebSocket 跨节点消息广播背板（IWsBackplane）。
    public WebApp UseWsBackplane(IWsBackplane backplane) {
        WsHub.Default().UseBackplane(backplane);
        return this;
    }
    public WebApp UseWsBackplane(WsBackplanePublishHandler publishFn) {
        WsHub.Default().UseBackplane(publishFn);
        return this;
    }
    // 服务端度量统计收集器。
    public ServerMetrics Metrics() { return this.metrics; }
    // 加载视图目录（编译进内存）并返回自身。
    public WebApp Views(string dir) { this.views = View.LoadDir(dir); return this; }
    // 内存请求体上限（字节），超出回答 413。
    public WebApp MaxBody(int bytes) { this.maxBodyBytes = bytes; return this; }
    // 流式上传上限（字节），只作用于 [Upload] 路由，超出回答 413。
    public WebApp MaxUpload(int bytes) { this.maxUploadBytes = bytes; return this; }
    // 请求到达与响应处理的超时时限（毫秒）。
    public WebApp Timeout(int ms) { this.requestTimeoutMs = ms; return this; }
    // 最大并发连接数上限，超出时直接响应 503 并关闭连接。
    public WebApp MaxConnections(int n) { this.maxConnections = n; return this; }
    // 流式上传的落盘目录（默认 uploads）。
    public WebApp UploadDir(string dir) { this.uploadDir = dir; return this; }
    // 全局每秒请求上限，按 uid（匿名时按对端 IP）计；0 不限，超限 429。
    public WebApp GlobalLimit(int perSecond) { this.globalLimit = perSecond; return this; }
    // 未授权重定向的登录页路由（未配置时默认返回 401 JSON）。
    public WebApp LoginPath(string path) { this.loginPath = path; return this; }
    // 多进程部署时以 SO_REUSEPORT 监听，由内核把连接分发给各 worker。
    public WebApp ReusePort(bool on) { this.reusePort = on; return this; }

    // 配置 HTTPS 原生 TLS 服务端证书与私钥。
    public WebApp UseHttps(string certFile, string keyFile) {
        this.certFile = certFile;
        this.keyFile = keyFile;
        this.tls = TlsContext.CreateServer(certFile, keyFile);
        return this;
    }

    // 注入现有的服务端 TLS 上下文。
    public WebApp UseTls(TlsContext ctx) {
        this.tls = ctx;
        return this;
    }

    public bool IsHttps() {
        return this.tls != null;
    }

    public TlsContext Tls() {
        return this.tls;
    }

    // 初始化跨进程路由统计共享内存表。
    public void InitStats() { this.router.InitStatsShared(); }

    private static const string ShareRate = "WEB_RATE";
    private static const string ShareLock = "WEB_LOCK";
    private static const string ShareRoute = "WEB_ROUTE";
    private static const string ShareRouteTable = "WEB_ROUTE_TABLE";

    // 共享内存表：包含限流、锁和路由计数器，多工作进程间无拷贝共享。
    public void InitShared() {
        if (this.AttachShared()) { return; }
        RateLimiter l = this.Limiter();
        LockManager k = this.Locks();
        this.InitStats();
        this.router.InitRouteTableShared();
        // 共享内存表句柄传递：在派生工作进程时分发匿名共享表句柄。
        Worker.ShareHandle(WebApp.ShareRate, l.OsHandle());
        Worker.ShareHandle(WebApp.ShareLock, k.OsHandle());
        Worker.ShareHandle(WebApp.ShareRoute, this.router.StatsOsHandle());
        Worker.ShareHandle(WebApp.ShareRouteTable, this.router.RouteTableOsHandle());
    }

    // Worker 侧：映射主进程创建并下发的各表。主进程与单进程服务没有
    // 可继承句柄，返回 false，由它们自己建表。
    public bool AttachShared() {
        long rate = Worker.InheritedHandle(WebApp.ShareRate);
        long lockTable = Worker.InheritedHandle(WebApp.ShareLock);
        long route = Worker.InheritedHandle(WebApp.ShareRoute);
        long routeTable = Worker.InheritedHandle(WebApp.ShareRouteTable);
        if (rate == 0 && lockTable == 0 && route == 0 && routeTable == 0) { return false; }
        if (this.limiter == null) {
            this.limiter = RateLimiter.Attach(rate, 1000);
        }
        if (this.locks == null) { this.locks = LockManager.Attach(lockTable); }
        this.router.AttachStats(route);
        this.router.AttachRouteTable(routeTable);
        return true;
    }

    // 按需创建；拥有各表的进程已在 InitShared 里提前建好。
    public RateLimiter Limiter() {
        if (this.limiter == null) { this.limiter = RateLimiter.Owned(1000); }
        return this.limiter;
    }

    // 按需创建请求锁管理器；worker 进程由 AttachShared 映射主进程下发的表。
    public LockManager Locks() {
        if (this.locks == null) { this.locks = LockManager.Owned(); }
        return this.locks;
    }
    // 注册 before 钩子（按注册顺序执行；返回 false 短路请求）。
    public WebApp Before(HookFn fn) { this.hooks.Before(fn); return this; }
    // 注册 after 钩子（请求结束后按注册顺序执行，收微秒耗时）。
    public WebApp After(AfterFn fn) { this.hooks.After(fn); return this; }
    // 安装 token→用户解析器；未安装时用内置 Sessions 表解析。
    public WebApp AuthResolver(AuthFn fn) { this.authResolver = fn; return this; }
    // 安装权限解析器；未安装时"任何已登录用户"即被允许。
    public WebApp PermissionResolver(PermissionFn fn) { this.permissionResolver = fn; return this; }

    // 通用路由注册底层入口（供属性路由生成器调用）。
    public Route Map(string method, string pattern, HttpHandler h) {
        return this.router.Add(method, pattern, h);
    }

    // 正则路由注册底层入口（供属性路由生成器调用）。
    public Route MapRegex(string method, string pattern, HttpHandler h) {
        return this.router.AddRegex(method, pattern, h);
    }

    // 注册 GET 路由（= Map("GET", ...)）。
    public Route Get(string pattern, HttpHandler h) { return this.router.Get(pattern, h); }
    // 注册 POST 路由。
    public Route Post(string pattern, HttpHandler h) { return this.router.Post(pattern, h); }
    // 注册 PUT 路由。
    public Route Put(string pattern, HttpHandler h) { return this.router.Put(pattern, h); }
    // 注册 DELETE 路由。
    public Route Delete(string pattern, HttpHandler h) { return this.router.Delete(pattern, h); }

    // 启用 GEO 大模型站点友好规范，自动挂载 /.well-known/llms.txt 与 /llms.txt。
    public WebApp UseLlmsTxt(LlmsTxt llms) {
        this.llmsTxt = llms;
        if (llms != null) { this.MountLlms(); }
        return this;
    }

    // 应用层接管 llms.txt 内容：委托每次请求求值，返回 null 时回退静态对象。
    public WebApp UseLlmsSource(LlmsSource source) {
        this.llmsSource = source;
        if (source != null) { this.MountLlms(); }
        return this;
    }

    // llms.txt 挂载点：委托给 SeoRouter。
    public void MountLlms() {
        SeoRouter.MountLlms(this);
    }

    // 启用搜索引擎与 AI 爬虫协议规则 robots.txt。
    public WebApp UseRobotsTxt(RobotsTxt robots) {
        this.robotsTxt = robots;
        if (robots != null) { this.MountRobots(); }
        return this;
    }

    // 应用层接管 robots.txt 内容：委托每次请求求值，返回 null 时回退静态对象。
    public WebApp UseRobotsSource(RobotsSource source) {
        this.robotsSource = source;
        if (source != null) { this.MountRobots(); }
        return this;
    }

    // robots.txt 挂载点：委托给 SeoRouter。
    public void MountRobots() {
        SeoRouter.MountRobots(this);
    }

    // 启用 XML 站点地图 sitemap.xml。
    public WebApp UseSitemap(Sitemap sm) {
        this.sitemap = sm;
        if (sm != null) { this.MountSitemap(); }
        return this;
    }

    // 应用层接管 sitemap.xml 内容：委托每次请求求值，返回 null 时回退静态对象。
    public WebApp UseSitemapSource(SitemapSource source) {
        this.sitemapSource = source;
        if (source != null) { this.MountSitemap(); }
        return this;
    }

    // sitemap.xml 挂载点：委托给 SeoRouter。
    public void MountSitemap() {
        SeoRouter.MountSitemap(this);
    }

    public bool IsRunning() { return this.running; }
    public LlmsTxt Llms() { return this.llmsTxt; }
    public RobotsTxt Robots() { return this.robotsTxt; }
    public Sitemap SiteMap() { return this.sitemap; }
    public LlmsSource LlmsSource() { return this.llmsSource; }
    public RobotsSource RobotsSource() { return this.robotsSource; }
    public SitemapSource SitemapSource() { return this.sitemapSource; }
    public bool IsSitemapMounted() { return this.sitemapMounted; }
    public void MarkSitemapMounted() { this.sitemapMounted = true; }
    public bool IsRobotsMounted() { return this.robotsMounted; }
