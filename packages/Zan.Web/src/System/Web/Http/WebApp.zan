    public bool IsLlmsMounted() { return this.llmsMounted; }
    public void MarkLlmsMounted() { this.llmsMounted = true; }
    // 是否已启用 llms.txt（静态对象或应用层内容源任一）。
    public bool HasLlms() { return this.llmsTxt != null || this.llmsSource != null; }
    // 是否已启用 robots.txt（静态对象或应用层内容源任一）。
    public bool HasRobots() { return this.robotsTxt != null || this.robotsSource != null; }
    // 是否已启用 sitemap.xml（静态对象或应用层内容源任一）。
    public bool HasSitemap() { return this.sitemap != null || this.sitemapSource != null; }

