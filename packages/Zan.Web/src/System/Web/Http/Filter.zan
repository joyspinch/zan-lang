using System;
using System.Text;

namespace System.Web;

// 统一输入净化过滤：剥离控制字符与首尾空白，防范注入攻击。
public class Filter {
    // 是否空白符：空格 / TAB / CR / LF。
    public static bool IsSpace(string c) {
        return c == " " || c == "\t" || c == "\r" || c == "\n";
    }

    public static string Clean(string s) {
        int n = s.Length;
        if (n == 0) { return s; }
        int start = 0;
        while (start < n) {
            int c = s[start] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
            start = start + 1;
        }
        int end = n;
        while (end > start) {
            int c = s[end - 1] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
            end = end - 1;
        }
        if (start >= end) { return ""; }
        int firstCtrl = -1;
        int k = start;
        while (k < end) {
            int c = s[k] & 255;
            if (c == 13 || c == 10 || c == 9) { firstCtrl = k; break; }
            k = k + 1;
        }
        if (firstCtrl < 0) {
            if (start == 0 && end == n) { return s; }
            return s.Substring(start, end - start);
        }
        int drop = 0;
        for (int j = firstCtrl; j < end; j = j + 1) {
            int c = s[j] & 255;
            if (c == 13 || c == 10) { drop = drop + 1; }
        }
        int outLen = (end - start) - drop;
        byte[] buf = new byte[outLen];
        int prefixLen = firstCtrl - start;
        if (prefixLen > 0) {
            NativeMemory.Copy((nint)buf, (nint)s + (nint)start, prefixLen);
        }
        int di = prefixLen;
        for (int i = firstCtrl; i < end; i = i + 1) {
            int c = s[i] & 255;
            if (c == 13 || c == 10) { continue; }
            buf[di] = (byte)(c == 9 ? 32 : c);
            di = di + 1;
        }
        return NativeMemory.GetString((nint)buf, 0, outLen);
    }

    public static string Html(string s) {
        int n = s.Length;
        if (n == 0) { return s; }
        int start = 0;
        while (start < n) {
            int c = s[start] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
            start = start + 1;
        }
        int end = n;
        while (end > start) {
            int c = s[end - 1] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
            end = end - 1;
        }
        if (start >= end) { return ""; }
        int first = -1;
        for (int k = start; k < end; k = k + 1) {
            int c = s[k] & 255;
            if (c == 38 || c == 60 || c == 62 || c == 34 || c == 39
                || c == 13 || c == 10 || c == 9) {
                first = k;
                break;
            }
        }
        if (first < 0) {
            if (start == 0 && end == n) { return s; }
            return s.Substring(start, end - start);
        }
        StringBuilder sb = new StringBuilder((end - start) + 32);
        nint sp = (nint)s;
        int flush = start;
        for (int i = first; i < end; i = i + 1) {
            int c = s[i] & 255;
            if (c == 38) {
                if (i > flush) { sb.Append(new StringView(sp + (nint)flush, i - flush)); }
                sb.Append("&amp;");
                flush = i + 1;
            } else if (c == 60) {
                if (i > flush) { sb.Append(new StringView(sp + (nint)flush, i - flush)); }
                sb.Append("&lt;");
                flush = i + 1;
            } else if (c == 62) {
                if (i > flush) { sb.Append(new StringView(sp + (nint)flush, i - flush)); }
                sb.Append("&gt;");
                flush = i + 1;
            } else if (c == 34) {
                if (i > flush) { sb.Append(new StringView(sp + (nint)flush, i - flush)); }
                sb.Append("&quot;");
                flush = i + 1;
            } else if (c == 39) {
                if (i > flush) { sb.Append(new StringView(sp + (nint)flush, i - flush)); }
                sb.Append("&#39;");
                flush = i + 1;
            } else if (c == 13 || c == 10) {
                if (i > flush) { sb.Append(new StringView(sp + (nint)flush, i - flush)); }
                flush = i + 1;
            } else if (c == 9) {
                if (i > flush) { sb.Append(new StringView(sp + (nint)flush, i - flush)); }
                sb.Append(" ");
                flush = i + 1;
            }
        }
        if (end > flush) { sb.Append(new StringView(sp + (nint)flush, end - flush)); }
        return sb.ToString();
    }

    // '0'–'9' 映射 0–9，其余 -1。
    public static int DigitValue(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        return -1;
    }

    public static int ToInt(string s, int def) {
        long r = Filter.ToLong(s, 2147483648L);
        if (r > 2147483647L || r < -2147483648L) { return def; }
        return (int)r;
    }

    public static long ToLong(string s, long def) {
        int n = s.Length;
        if (n == 0) { return def; }
        int start = 0;
        while (start < n) {
            int c = s[start] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
            start = start + 1;
        }
        int end = n;
        while (end > start) {
            int c = s[end - 1] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
            end = end - 1;
        }
        if (start >= end) { return def; }
        int i = start;
        bool neg = false;
        if ((s[i] & 255) == 45) { neg = true; i = i + 1; }  // '-'
        long acc = 0L;
        long minVal = -9223372036854775807L - 1L;
        long minLimit10 = -922337203685477580L;
        bool any = false;
        while (i < end) {
            int c = s[i] & 255;
            if (c == 13 || c == 10) { i = i + 1; continue; }
            int d = c - 48;
            if (d < 0 || d > 9) { return def; }
            if (acc < minLimit10) { return def; }
            acc = acc * 10L;
            if (acc < minVal + (long)d) { return def; }
            acc = acc - (long)d;
            any = true;
            i = i + 1;
        }
        if (!any) { return def; }
        if (neg) { return acc; }
        if (acc == minVal) { return def; }
        return -acc;
    }

    public static double ToDouble(string s, double def) {
        int n = s.Length;
        if (n == 0) { return def; }
        int start = 0;
        while (start < n) {
            int c = s[start] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
            start = start + 1;
        }
        int end = n;
        while (end > start) {
            int c = s[end - 1] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
            end = end - 1;
        }
        if (start >= end) { return def; }
        int i = start;
        bool neg = false;
        if ((s[i] & 255) == 45) { neg = true; i = i + 1; }
        double val = 0.0;
        bool any = false;
        while (i < end) {
            int c = s[i] & 255;
            if (c == 13 || c == 10) { i = i + 1; continue; }
            if (c == 46) { break; }  // '.'
            int d = c - 48;
            if (d < 0 || d > 9) { return def; }
            val = val * 10.0 + (double)d;
            any = true;
            i = i + 1;
        }
        if (i < end && (s[i] & 255) == 46) {
            i = i + 1;
            double scale = 0.1;
            while (i < end) {
                int c = s[i] & 255;
                if (c == 13 || c == 10) { i = i + 1; continue; }
                int d = c - 48;
                if (d < 0 || d > 9) { return def; }
                val = val + (double)d * scale;
                scale = scale * 0.1;
                any = true;
                i = i + 1;
            }
        }
        if (!any) { return def; }
        if (neg) { return -val; }
        return val;
    }

    public static bool ToBool(string s, bool def) {
        int n = s.Length;
        if (n == 0) { return def; }
        int start = 0;
        while (start < n) {
            int c = s[start] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
            start = start + 1;
        }
        int end = n;
        while (end > start) {
            int c = s[end - 1] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
            end = end - 1;
        }
        if (start >= end) { return def; }
        int b0 = 0; int b1 = 0; int b2 = 0; int b3 = 0; int b4 = 0;
        int len = 0;
        for (int i = start; i < end; i = i + 1) {
            int c = s[i] & 255;
            if (c == 13 || c == 10) { continue; }
            if (c == 9) { c = 32; }
            else if (c >= 65 && c <= 90) { c = c + 32; }
            if (len == 0) { b0 = c; }
            else if (len == 1) { b1 = c; }
            else if (len == 2) { b2 = c; }
            else if (len == 3) { b3 = c; }
            else if (len == 4) { b4 = c; }
            else { return def; }
            len = len + 1;
        }
        if (len == 1) {
            if (b0 == 49) { return true; }   // '1'
            if (b0 == 48) { return false; }  // '0'
            return def;
        }
        if (len == 2) {
            if (b0 == 111 && b1 == 110) { return true; }   // "on"
            if (b0 == 110 && b1 == 111) { return false; }  // "no"
            return def;
        }
        if (len == 3) {
            if (b0 == 121 && b1 == 101 && b2 == 115) { return true; }   // "yes"
            if (b0 == 111 && b1 == 102 && b2 == 102) { return false; }  // "off"
            return def;
        }
        if (len == 4) {
            if (b0 == 116 && b1 == 114 && b2 == 117 && b3 == 101) { return true; }  // "true"
            return def;
        }
        if (len == 5) {
            if (b0 == 102 && b1 == 97 && b2 == 108 && b3 == 115 && b4 == 101) { return false; }  // "false"
            return def;
        }
        return def;
    }
}
