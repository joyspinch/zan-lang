using System;

namespace System.Web;

// 云原生与负载均衡器健康检查及平滑流量摘除探针 (Liveness / Readiness / Draining)
public class HealthChecks {
    private bool enabled;
    private bool isDraining;
    private string livenessPath;
    private string readinessPath;

    public HealthChecks() {
        this.enabled = false;
        this.isDraining = false;
        this.livenessPath = "/healthz";
        this.readinessPath = "/readyz";
    }

    public HealthChecks(string livenessPath, string readinessPath) {
        this.enabled = false;
        this.isDraining = false;
        this.livenessPath = livenessPath != null ? livenessPath : "/healthz";
        this.readinessPath = readinessPath != null ? readinessPath : "/readyz";
    }

    public void Enable() {
        this.enabled = true;
    }

    public bool IsEnabled() {
        return this.enabled;
    }

    public string LivenessPath() {
        return this.livenessPath;
    }

    public string ReadinessPath() {
        return this.readinessPath;
    }

    // 触发平滑排空（反向代理与网关将收到 503 并摘除本节点，在途请求不受影响）
    public void Drain() {
        this.isDraining = true;
    }

    public bool IsDraining() {
        return this.isDraining;
    }

    public static async void HandleLiveness(HttpContext ctx) {
        ctx.Status(200, "OK");
        ctx.Json("{\"status\":\"UP\"}");
    }

    public async void HandleReadiness(HttpContext ctx) {
        if (this.isDraining) {
            ctx.Status(503, "Service Unavailable");
            ctx.Json("{\"status\":\"DRAINING\"}");
        } else {
            ctx.Status(200, "OK");
            ctx.Json("{\"status\":\"READY\"}");
        }
    }
}
