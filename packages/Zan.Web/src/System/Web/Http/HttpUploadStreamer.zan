using System;
using System.IO;
using System.Interop;
using System.Net.Http;
using System.Threading;

namespace System.Web;

// The streamer owns a partial spool until every byte and fclose succeed.
// A successful return transfers ownership to the request's HttpContext.
public class HttpUploadStreamer {
#if WINDOWS
    private static const int OpenExclusiveBinary = 0x0001 | 0x0100 | 0x0400 | 0x8000;
    private static const int ShareDenyNone = 0x0040;
    private static const int ReadWriteMode = 0x0180;

    [DllImport("crt", EntryPoint = "_wsopen_s")]
    private static extern int OpenWide(ref int fd, nint path, int flags, int sharing, int mode);

    [DllImport("crt", EntryPoint = "_fdopen")]
    private static extern nint OpenDescriptor(int fd, string mode);

    [DllImport("crt", EntryPoint = "_close")]
    private static extern int CloseDescriptor(int fd);
#else
    [DllImport("crt")]
    private static extern nint fopen(string path, string mode);
#endif

    [DllImport("crt")]
    private static extern long fwrite(nint buf, long size, long count, nint fp);

    [DllImport("crt")]
    private static extern int fclose(nint fp);

    private static nint OpenExclusive(string path) {
#if WINDOWS
        // The supported legacy Windows CRT does not recognize fopen("wbx").
        nint wide = Wide.Of(path);
        if (wide == 0) { return 0; }
        int fd = -1;
        int result = HttpUploadStreamer.OpenWide(ref fd, wide, OpenExclusiveBinary,
            ShareDenyNone, ReadWriteMode);
        Wide.Free(wide);
        if (result != 0) { return 0; }
        nint fp = HttpUploadStreamer.OpenDescriptor(fd, "wb");
        if (fp == 0) {
            int closed = HttpUploadStreamer.CloseDescriptor(fd);
            HttpUploadStreamer.DeletePartial(path);
        }
        return fp;
#else
        return HttpUploadStreamer.fopen(path, "wbx");
#endif
    }

    private static void DeletePartial(string path) {
        try {
            if (File.Exists(path)) { File.Delete(path); }
        } catch (Exception e) {
            // Preserve the original IO failure; report failed cleanup.
            Console.WriteLine("[WebApp upload cleanup] " + e.Message);
        }
    }

    public static async string StreamToFile(nint sock, HttpFramer framer,
                                           HttpRequest request, string uploadDir,
                                           AtomicInt uploadSeq) {
        if (sock == 0) { return ""; }
        return await HttpUploadStreamer.StreamToFile(framer, request, uploadDir, uploadSeq);
    }

    public static async string StreamToFile(HttpFramer framer, HttpRequest request,
                                           string uploadDir, AtomicInt uploadSeq) {
        if (framer == null || request == null || request.chunked
            || request.contentLength <= 0 || request.bodyStart < 0
            || request.bodyStart > framer.Pending()) { return ""; }
        if (!Directory.Exists(uploadDir)) {
            Directory.CreateDirectoryRecursive(uploadDir);
        }
        string id = Guid.New();
        if (id.Length == 0) { return ""; }
        int seq = uploadSeq != null ? uploadSeq.Increment() : 1;
        string tmp = Path.Combine(uploadDir, "upload_" + id + "_" + Convert.ToString(seq) + ".bin");
        // The name is random across workers and the open cannot replace an existing file.
        nint fp = HttpUploadStreamer.OpenExclusive(tmp);
        if (fp == 0) { return ""; }
        bool complete = false;
        try {
            int remaining = request.contentLength;
            framer.Consume(request.bodyStart);
            while (remaining > 0) {
                int count = framer.Pending();
                if (count == 0) {
                    // This bound also applies to decrypted bytes already in the
                    // TLS record buffer. The next request stays with its reader.
                    count = await framer.FillTo(remaining);
                    if (count <= 0) { return ""; }
                }
                if (count > remaining) { count = remaining; }
                StringView chunk = framer.SliceView(0, count);
                long written = HttpUploadStreamer.fwrite(chunk.ptr, 1, count, fp);
                if (written != count) { return ""; }
                framer.Consume(count);
                remaining = remaining - count;
            }
            int closed = HttpUploadStreamer.fclose(fp);
            fp = 0;
            if (closed != 0) { return ""; }
            complete = true;
            return tmp;
        } finally {
            if (fp != 0) { int closed = HttpUploadStreamer.fclose(fp); }
            if (!complete) { HttpUploadStreamer.DeletePartial(tmp); }
        }
    }
}
