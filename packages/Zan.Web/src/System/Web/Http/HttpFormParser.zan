using System;
using System.Net.Http;
using System.Text;

namespace System.Web;

// HTTP 表单与 Multipart 协议解析器：
// 负责 application/x-www-form-urlencoded 与 multipart/form-data 的键值对解析与文本字段提取。
public class HttpFormParser {

    // 解析 application/x-www-form-urlencoded 格式的键值对。
    public static void ParseUrlEncoded(string body, StrMap form) {
        if (body == null || body.Length == 0 || form == null) { return; }
        HttpFormParser.ParsePairs(body, form);
    }

    private static const int MaxMultipartParts = 1024;

    // 解析请求体中的表单内容（支持 urlencoded 与 multipart/form-data）。
    public static void ParseFormBody(HttpRequest req, HttpContext ctx) {
        if (req == null || ctx == null) { return; }
        if (HttpContext.MediaTypeMatches(req.contentType, "application/x-www-form-urlencoded")) {
            StrMap form = ctx.EnsureForm();
            if (req.body.Length > 0) {
                HttpFormParser.ParsePairs(req.body, form);
            }
        }
    }

    // multipart/form-data 的文本字段进 form 表。
    public static void ParseMultipartFields(HttpRequest req, HttpContext ctx) {
        if (req == null || ctx == null) { return; }
        StrMap form = ctx.EnsureForm();
        HttpFormParser.ParseMultipartInto(req.contentType, req.body, form);
    }

    private static int FindBoundaryParam(string contentType) {
        int ctLen = contentType.Length;
        int from = 0;
        while (from < ctLen) {
            int idx = HttpFormParser.FindNoCaseFrom(contentType, "boundary=", from);
            if (idx < 0) { return -1; }
            if (idx > 0) {
                int prev = contentType[idx - 1] & 255;
                if (prev == 59 || prev == 32 || prev == 9) { return idx; }
            }
            from = idx + 1;
        }
        return -1;
    }

    private static bool IsBoundaryLineAnchored(string body, int pos) {
        if (pos == 0) { return true; }
        return (body[pos - 1] & 255) == 10;
    }

    private static int FindNextAnchoredBoundary(string body, string delim, int from) {
        int p = from;
        int n = body.Length;
        while (p <= n) {
            int hit = body.IndexOf(delim, p);
            if (hit < 0) { return -1; }
            if (HttpFormParser.IsBoundaryLineAnchored(body, hit)) { return hit; }
            p = hit + 1;
        }
        return -1;
    }

    // 将 multipart 文本字段解析进指定 StrMap。
    public static void ParseMultipartInto(string contentType, string body, StrMap form) {
        if (contentType == null || body == null || form == null) { return; }
        int bIdx = HttpFormParser.FindBoundaryParam(contentType);
        if (bIdx < 0) { return; }
        int bs = bIdx + 9;
        int ctLen = contentType.Length;
        int be;
        if (bs < ctLen && (contentType[bs] & 255) == 34) {
            bs = bs + 1;
            be = NativeMemory.Find((nint)contentType, bs, 34, ctLen - bs);
            if (be < 0) { return; }
        } else {
            be = NativeMemory.Find((nint)contentType, bs, 59, ctLen - bs);
            if (be < 0) { be = ctLen; }
            while (be > bs && ((contentType[be - 1] & 255) == 32 || (contentType[be - 1] & 255) == 9)) {
                be = be - 1;
            }
        }
        int rlen = be - bs;
        if (rlen <= 0 || rlen > 70) { return; }
        // RFC 2046 §5.1.1：boundary 只允许 bchars（字母数字与 '()+_,-./:=?）且上限 70 字符。
        for (int bi = bs; bi < be; bi = bi + 1) {
            int bc = contentType[bi] & 255;
            bool legal = (bc >= 48 && bc <= 57)
                || (bc >= 65 && bc <= 90)
                || (bc >= 97 && bc <= 122)
                || bc == 39 || bc == 40 || bc == 41
                || (bc >= 43 && bc <= 47)
                || bc == 58 || bc == 61 || bc == 63
                || bc == 95;
            if (!legal) { return; }
        }
        byte[] dbuf = new byte[rlen + 2];
        dbuf[0] = 45;
        dbuf[1] = 45;
        NativeMemory.Copy((nint)dbuf + (nint)2, (nint)contentType + (nint)bs, rlen);
        string delim = NativeMemory.GetString((nint)dbuf, 0, rlen + 2);
        int n = body.Length;
        int dlen = rlen + 2;
        nint bp = n > 0 ? (nint)body : 0;
        int pos = HttpFormParser.FindNextAnchoredBoundary(body, delim, 0);
        int parts = 0;
        while (pos >= 0 && parts < HttpFormParser.MaxMultipartParts) {
            int after = pos + dlen;
            if (after + 1 < n && (body[after] & 255) == 45
                && (body[after + 1] & 255) == 45) {
                break;  // "--boundary--"：结束分隔
            }
            if (after + 1 < n && (body[after] & 255) == 13
                && (body[after + 1] & 255) == 10) {
                after = after + 2;
            } else if (after < n && (body[after] & 255) == 10) {
                after = after + 1;
            }
            int hb = body.IndexOf("\r\n\r\n", after);
            if (hb < 0 || hb + 4 > n) { break; }
            parts = parts + 1;
            int vStart = hb + 4;
            string name = HttpFormParser.DispositionNameSlice(body, bp, after, vStart);
            int next = HttpFormParser.FindNextAnchoredBoundary(body, delim, vStart);
            if (name.Length > 0 && next > vStart) {
                int vEnd = next;
                if (vEnd > vStart && (body[vEnd - 1] & 255) == 10) { vEnd = vEnd - 1; }
                if (vEnd > vStart && (body[vEnd - 1] & 255) == 13) { vEnd = vEnd - 1; }
                form.Set(name, body.Substring(vStart, vEnd - vStart));
            }
            if (next < 0) { break; }
            pos = next;
        }
    }

    public static string DispositionName(string head) {
        if (head == null || head.Length == 0) { return ""; }
        return HttpFormParser.DispositionNameSlice(head, (nint)head, 0, head.Length);
    }

    private static bool MatchLower4(string s, int pos, int c0, int c1, int c2, int c3) {
        int a0 = s[pos] & 255; if (a0 >= 65 && a0 <= 90) { a0 = a0 + 32; }
        if (a0 != c0) { return false; }
        int a1 = s[pos + 1] & 255; if (a1 >= 65 && a1 <= 90) { a1 = a1 + 32; }
        if (a1 != c1) { return false; }
        int a2 = s[pos + 2] & 255; if (a2 >= 65 && a2 <= 90) { a2 = a2 + 32; }
        if (a2 != c2) { return false; }
        int a3 = s[pos + 3] & 255; if (a3 >= 65 && a3 <= 90) { a3 = a3 + 32; }
        return a3 == c3;
    }

    private static bool IsParamBoundary(int c) {
        return c == 59 || c == 32 || c == 9;
    }

    // 仅在 Content-Disposition 行内解析 name 参数，跳过 filename= 与 filename*= 文件段。
    private static string DispositionNameSlice(string s, nint sp, int start, int end) {
        int dispStart = start;
        int dispEnd = end;
        int line = start;
        bool hasColon = false;
        bool foundDisp = false;
        while (line < end) {
            int nl = NativeMemory.Find(sp, line, 10, end - line);
            int lEnd = nl < 0 ? end : nl;
            if (lEnd > line && (s[lEnd - 1] & 255) == 13) { lEnd = lEnd - 1; }
            int colon = NativeMemory.Find(sp, line, 58, lEnd - line);
            if (colon >= 0) {
                hasColon = true;
                if (colon - line == 19
                    && HttpFormParser.FindNoCaseRange(s, line, colon, "content-disposition") == line) {
                    dispStart = colon + 1;
                    dispEnd = lEnd;
                    foundDisp = true;
                    break;
                }
            }
            if (nl < 0) { break; }
            line = nl + 1;
        }
        if (hasColon && !foundDisp) { return ""; }

        int firstNameVal = -1;
        int p = dispStart;
        while (p < dispEnd) {
            int eq = NativeMemory.Find(sp, p, 61, dispEnd - p);  // '='
            if (eq < 0) { break; }
            // RFC 5987 filename*= 检测
            if (eq >= dispStart + 9 && (s[eq - 1] & 255) == 42
                && HttpFormParser.MatchLower4(s, eq - 9, 102, 105, 108, 101)
                && HttpFormParser.MatchLower4(s, eq - 5, 110, 97, 109, 101)
                && (eq - 9 == dispStart || HttpFormParser.IsParamBoundary(s[eq - 10] & 255))) {
                return "";
            }
            if (eq >= dispStart + 4 && HttpFormParser.MatchLower4(s, eq - 4, 110, 97, 109, 101)) {
                // "...name="：检查前面是否 "file"（即 "filename="）
                if (eq >= dispStart + 8 && HttpFormParser.MatchLower4(s, eq - 8, 102, 105, 108, 101)
                    && (eq - 8 == dispStart || HttpFormParser.IsParamBoundary(s[eq - 9] & 255))) {
                    return "";
                }
                if (firstNameVal < 0
                    && (eq - 4 == dispStart || HttpFormParser.IsParamBoundary(s[eq - 5] & 255))) {
                    firstNameVal = eq + 1;
                }
            }
            p = eq + 1;
        }
        if (firstNameVal < 0) { return ""; }
        int qs = firstNameVal;
        if (qs < dispEnd && (s[qs] & 255) == 34) {
            int qe = NativeMemory.Find(sp, qs + 1, 34, dispEnd - (qs + 1));
            if (qe < 0) { return ""; }
            return s.Substring(qs + 1, qe - qs - 1);
        }
        int e = qs;
        while (e < dispEnd) {
            int c = s[e] & 255;
            if (c == 59 || c == 13 || c == 10) { break; }  // ';' CR LF
            e = e + 1;
        }
        return s.Substring(qs, e - qs);
    }

    public static int FindFrom(string hay, string needle, int from) {
        int n = hay.Length;
        int m = needle.Length;
        if (from < 0) { from = 0; }
        if (m == 0) { return from <= n ? from : -1; }
        if (from + m > n) { return -1; }
        return hay.IndexOf(needle, from);
    }

    public static int FindNoCaseFrom(string hay, string needle, int from) {
        return HttpFormParser.FindNoCaseRange(hay, from, hay.Length, needle);
    }

    private static int FindNoCaseRange(string hay, int from, int end, string needle) {
        int m = needle.Length;
        if (from < 0) { from = 0; }
        if (end > hay.Length) { end = hay.Length; }
        if (m == 0) { return from <= end ? from : -1; }
        int limit = end - m + 1;
        if (from >= limit) { return -1; }
        int c0 = needle[0] & 255;
        int lo = (c0 >= 65 && c0 <= 90) ? (c0 + 32) : c0;
        int hi = (lo >= 97 && lo <= 122) ? (lo - 32) : lo;
        nint hp = (nint)hay;
        int i = from;
        while (i < limit) {
            int hit;
            if (lo == hi) {
                hit = NativeMemory.Find(hp, i, lo, limit - i);
            } else {
                int rel = NativeMemory.IndexOfAny(hp + (nint)i, limit - i, (byte)lo, (byte)hi);
                hit = rel < 0 ? -1 : (i + rel);
            }
            if (hit < 0) { return -1; }
            int k = 1;
            while (k < m) {
                int a = hay[hit + k] & 255;
                int b = needle[k] & 255;
                if (a >= 65 && a <= 90) { a = a + 32; }
                if (b >= 65 && b <= 90) { b = b + 32; }
                if (a != b) { break; }
                k = k + 1;
            }
            if (k == m) { return hit; }
            i = hit + 1;
        }
        return -1;
    }

    // 切片直解 URL 表单字段：无 '+'/'%' 时跳过 Encoding.UrlDecode 直接切片；
    // 含编码字节时单遍直解入 byte[]，消除 Substring + UrlDecode 二次分配。
    private static string DecodeFormSlice(string s, nint sp, int start, int end) {
        int len = end - start;
        if (len <= 0) { return ""; }
        int rel = NativeMemory.IndexOfAny(sp + (nint)start, len, 43, 37);  // '+' or '%'
        if (rel < 0) {
            return s.Substring(start, len);
        }
        byte[] outBuf = new byte[len];
        if (rel > 0) {
            NativeMemory.Copy((nint)outBuf, sp + (nint)start, rel);
        }
        int di = rel;
        int i = start + rel;
        while (i < end) {
            int c = s[i] & 255;
            if (c == 43) {
                outBuf[di] = 32;
                di = di + 1;
                i = i + 1;
            } else if (c == 37 && i + 2 < end) {
                int h = Encoding.HexDigit(s[i + 1] & 255);
                int l = Encoding.HexDigit(s[i + 2] & 255);
                if (h >= 0 && l >= 0) {
                    outBuf[di] = (byte)((h << 4) | l);
                    di = di + 1;
                    i = i + 3;
                } else {
                    outBuf[di] = 37;
                    di = di + 1;
                    i = i + 1;
                }
            } else {
                outBuf[di] = (byte)c;
                di = di + 1;
                i = i + 1;
            }
        }
        return NativeMemory.GetString((nint)outBuf, 0, di);
    }

    public static void ParsePairs(string s, StrMap into) {
        if (s == null || into == null) { return; }
        int i = 0;
        int n = s.Length;
        nint sp = n > 0 ? (nint)s : 0;
        int pairCount = 0;
        Dictionary<string, StringBuilder> arrayAcc = null;
        while (i < n && pairCount < 4096) {
            int amp = NativeMemory.Find(sp, i, 38, n - i);  // '&'
            int e = amp < 0 ? n : amp;
            int eq = e > i ? NativeMemory.Find(sp, i, 61, e - i) : -1;  // '='
            if (eq > i) {
                pairCount = pairCount + 1;
                bool isArr = (eq - i > 2) && (s[eq - 2] & 255) == 91 && (s[eq - 1] & 255) == 93;
                string k = HttpFormParser.DecodeFormSlice(s, sp, i, isArr ? (eq - 2) : eq);
                string v = HttpFormParser.DecodeFormSlice(s, sp, eq + 1, e);
                if (!isArr) {
                    int kl = k.Length;
                    if (kl > 2 && (k[kl - 2] & 255) == 91 && (k[kl - 1] & 255) == 93) {
                        k = k.Substring(0, kl - 2);
                        isArr = true;
                    }
                }
                if (isArr) {
                    if (arrayAcc == null) { arrayAcc = new Dictionary<string, StringBuilder>(); }
                    StringBuilder sb = null;
                    if (arrayAcc.TryGetValue(k, out sb) && sb != null) {
                        if (sb.Length > 0) {
                            if (sb.Length < 65536 && v.Length <= 65536 - sb.Length) {
                                sb.Append(",");
                                sb.Append(v);
                            }
                        } else if (v.Length <= 65536) {
                            sb.Append(v);
                        }
                    } else {
                        StringBuilder next = new StringBuilder();
                        string prev = "";
                        if (into.TryGet(k, out prev) && prev != null && prev.Length > 0) {
                            next.Append(prev);
                            if (next.Length < 65536 && v.Length <= 65536 - next.Length) {
                                next.Append(",");
                                next.Append(v);
                            }
                        } else if (v.Length <= 65536) {
                            next.Append(v);
                        }
                        arrayAcc.Add(k, next);
                    }
                } else {
                    if (arrayAcc != null && arrayAcc.ContainsKey(k)) {
                        arrayAcc.Remove(k);
                    }
                    into.Set(k, v);
                }
            }
            i = e + 1;
        }
        if (arrayAcc != null) {
            List<string> keys = arrayAcc.Keys;
            for (int ki = 0; ki < keys.Count; ki = ki + 1) {
                string key = keys[ki];
                into.Set(key, arrayAcc[key].ToString());
            }
        }
    }
}
