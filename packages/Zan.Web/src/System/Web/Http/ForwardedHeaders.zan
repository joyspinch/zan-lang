using System;

namespace System.Web;

// 反向代理（Nginx / Envoy / HAProxy / K8s Ingress）标头还原处理器
public class ForwardedHeaders {
    private bool enabled;
    private List<string> trustedProxies;

    public ForwardedHeaders() {
        this.enabled = false;
        this.trustedProxies = new List<string>();
    }

    public void Enable() {
        this.enabled = true;
    }

    public bool IsEnabled() {
        return this.enabled;
    }

    public void AddTrustedProxy(string proxyIp) {
        if (proxyIp != null && proxyIp.Length > 0) {
            this.trustedProxies.Add(proxyIp);
        }
    }

    // 从 HttpContext 提取并还原真实客户端 IP
    public string ResolveClientIp(HttpContext ctx) {
        if (ctx == null) { return ""; }
        if (!this.enabled) {
            return ctx.RemoteIp();
        }

        // 1. 优先读取 X-Forwarded-For（取首个非空 IP）
        string xff = ctx.Header("X-Forwarded-For");
        if (xff != null && xff.Length > 0) {
            int commaIdx = xff.IndexOf(",");
            string firstIp = commaIdx >= 0 ? xff.Substring(0, commaIdx) : xff;
            firstIp = firstIp.Trim();
            if (firstIp.Length > 0) {
                return firstIp;
            }
        }

        // 2. 备选读取 X-Real-IP
        string xRealIp = ctx.Header("X-Real-IP");
        if (xRealIp != null && xRealIp.Length > 0) {
            string rip = xRealIp.Trim();
            if (rip.Length > 0) {
                return rip;
            }
        }

        // 3. 回退为底层套接字对端 IP
        return ctx.RemoteIp();
    }
}
