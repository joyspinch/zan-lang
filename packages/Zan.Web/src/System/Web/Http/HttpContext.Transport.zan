using System.Net.Http;
using System.Net.Sockets;
using System.Net.Tls;
using System;

namespace System.Web;

// HttpContext 传输层与流式接管部分（TLS/Socket/Deadline/SSE/WebSocket）。
public partial class HttpContext {
    public WebApp App() { return this.app; }

    public void ExcludeRequestProfile() {
        RequestTrace trace = this.Trace;
        if (trace == null) { return; }
        trace.Discard();
        this.Trace = null;
    }

    public void SetApp(WebApp a) { this.app = a; }
    public void Attach(TcpClient client) { this.conn = client; }
    public void AttachTls(TlsStream stream) { this.tlsStream = stream; }
    public TlsStream Tls() { return this.tlsStream; }
    public void MarkTransportSecure() { this.transportSecure = true; }
    public bool IsSecure() {
        if (this.tlsStream != null || this.transportSecure) { return true; }
        if (this.request == null || this.request.parseStatus != 0) { return false; }
        if (this.app != null && this.app.IsTrustedProxy(this.RemoteIp())) {
            return HttpContext.SingleForwardedProtoIsHttps(this.request.rawHeaders);
        }
        return false;
    }

    private static bool SingleForwardedProtoIsHttps(string rawHeaders) {
        if (rawHeaders == null || rawHeaders.Length == 0) { return false; }
        int n = rawHeaders.Length;
        int pos = 0;
        bool matched = false;
        int count = 0;
        while (pos < n) {
            int lineEnd = pos;
            while (lineEnd < n && (rawHeaders[lineEnd] & 255) != 10) { lineEnd = lineEnd + 1; }
            int stop = lineEnd;
            if (stop > pos && (rawHeaders[stop - 1] & 255) == 13) { stop = stop - 1; }
            if (stop > pos) {
                int first = rawHeaders[pos] & 255;
                if (first == 32 || first == 9) { return false; }  // obs-fold rejected
                int colon = pos;
                while (colon < stop && (rawHeaders[colon] & 255) != 58) { colon = colon + 1; }
                if (colon < stop) {
                    int nameLen = colon - pos;
                    if (nameLen == 17 && HttpContext.AsciiSliceEq(rawHeaders, pos, 17, "x-forwarded-proto")) {
                        count = count + 1;
                        if (count > 1) { return false; }
                        int vs = colon + 1;
                        while (vs < stop && ((rawHeaders[vs] & 255) == 32 || (rawHeaders[vs] & 255) == 9)) {
                            vs = vs + 1;
                        }
                        int ve = stop;
                        while (ve > vs && ((rawHeaders[ve - 1] & 255) == 32 || (rawHeaders[ve - 1] & 255) == 9)) {
                            ve = ve - 1;
                        }
                        matched = (ve - vs == 5)
                            && HttpContext.AsciiSliceEq(rawHeaders, vs, 5, "https");
                    }
                }
            }
            pos = lineEnd + 1;
        }
        return count == 1 && matched;
    }

    private static bool AsciiSliceEq(string s, int offset, int len, string lowerTarget) {
        if (len != lowerTarget.Length || offset + len > s.Length) { return false; }
        for (int i = 0; i < len; i = i + 1) {
            int c = s[offset + i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != (lowerTarget[i] & 255)) { return false; }
        }
        return true;
    }

    public nint ClientSock() {
        if (this.conn == null) { return 0; }
        return this.conn.Sock();
    }

    public HttpDeadlineToken DeadlineSlot() { return this.deadlineSlot; }
    public int StreamIdleMs() { return this.streamIdleMs; }
    public HttpFramer Framer() { return this.framer; }
    public TcpClient Conn() { return this.conn; }

    public void SetDeadlineSlot(HttpDeadlineToken slot, int idleMs) {
        this.deadlineSlot = slot;
        this.streamIdleMs = idleMs;
    }

    public void SetFramer(HttpFramer framer) { this.framer = framer; }

    public void TouchDeadline(int timeoutMs) {
        if (this.deadlineSlot != null) {
            HttpDeadline.Touch(this.deadlineSlot, timeoutMs);
        }
    }

    public void Hijack() {
        this.hijacked = true;
        this.wasHijacked = true;
    }

    public void CloseHijack() {
        this.hijacked = false;
    }

    public void RecordFrame(long bytes) {
        this.frames = this.frames + 1;
        this.framesBytes = this.framesBytes + bytes;
    }

    public bool Hijacked() { return this.hijacked; }
    public bool MetricsExcluded() { return this.wasHijacked; }
    public long Frames() { return this.frames; }
    public long FrameBytes() { return this.framesBytes; }

    public async bool SseOpen() {
        return await HttpSseStreamer.Open(this);
    }

    public async bool SendAllTcp(string data) {
        if (this.tlsStream != null) {
            return await HttpSseStreamer.SendAllTls(this.tlsStream, data);
        }
        return await HttpSseStreamer.SendAllTcp(this.conn, data);
    }

    public async bool SseSend(string name, string data) {
        return await HttpSseStreamer.Send(this, name, data);
    }

    public async bool SsePing() {
        return await HttpSseStreamer.Ping(this);
    }

    public bool IsWebSocketRequest() {
        if (this.conn == null && this.tlsStream == null) { return false; }
        string up = this.request.GetHeader("Upgrade");
        int ul = up.Length;
        int i = 0;
        bool found = false;
        while (i < ul && !found) {
            while (i < ul && ((up[i] & 255) == 32 || (up[i] & 255) == 9)) {
                i = i + 1;
            }
            int start = i;
            while (i < ul && (up[i] & 255) != 44) { i = i + 1; }
            int stop = i;
            while (stop > start
                   && ((up[stop - 1] & 255) == 32 || (up[stop - 1] & 255) == 9)) {
                stop = stop - 1;
            }
            if (stop - start == 9) {
                found = true;
                string w = "websocket";
                for (int j = 0; j < 9; j = j + 1) {
                    int c = up[start + j] & 255;
                    if (c >= 65 && c <= 90) { c = c + 32; }
                    if (c != (w[j] & 255)) { found = false; break; }
                }
            }
            i = i + 1;
        }
        if (!found) { return false; }
        return this.request.GetHeader("Sec-WebSocket-Key").Length > 0;
    }
}
