using System.Net.Http;

namespace System.Web;

// 每条 TLS 连接一个：把连接级的对端 IP 带进 HTTP/2 的逐流处理器
// （HttpRequestHandler 只收 HttpRequest，拿不到连接上下文）。
internal class Http2RequestBridge {
    private WebApp app;
    private string remoteIp;

    public Http2RequestBridge(WebApp app, string remoteIp) {
        this.app = app;
        this.remoteIp = remoteIp;
    }

    public async HttpResponse Handle(HttpRequest req) {
        return await this.app.HandleHttp2Request(req, this.remoteIp);
    }
}
