using System;
using System.Text;

namespace System.Web;

// 统一输入净化过滤：剥离控制字符与首尾空白，防范注入攻击。
class Filter {
    // 是否空白符：空格 / TAB / CR / LF。
    static bool IsSpace(string c) {
        return c == " " || c == "\t" || c == "\r" || c == "\n";
    }

    static string Clean(string s) {
        int n = s.Length;
        if (n == 0) { return s; }
        int start = 0;
        for (; start < n; start = start + 1) {
            int c = s[start] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
        }
        int end = n;
        while (end > start) {
            int c = s[end - 1] & 255;
            if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
            end = end - 1;
        }
        bool hasControl = false;
        int k = start;
        while (k < end) {
            int c = s[k] & 255;
            if (c == 13 || c == 10 || c == 9) { hasControl = true; break; }
            k = k + 1;
        }
        if (!hasControl) { return s.Substring(start, end - start); }
        StringBuilder sb = new StringBuilder();
        int flush = start;
        int i = start;
        while (i < end) {
            int c = s[i] & 255;
            if (c == 13 || c == 10) {
                if (i > flush) { sb.Append(s.Substring(flush, i - flush)); }
                flush = i + 1;
            } else if (c == 9) {
                if (i > flush) { sb.Append(s.Substring(flush, i - flush)); }
                sb.Append(" ");
                flush = i + 1;
            }
            i = i + 1;
        }
        if (end > flush) { sb.Append(s.Substring(flush, end - flush)); }
        return sb.ToString();
    }

    static string Html(string s) {
        string t = Filter.Clean(s);
        if (t.IndexOf("&") < 0 && t.IndexOf("<") < 0 && t.IndexOf(">") < 0
            && t.IndexOf("\"") < 0 && t.IndexOf("'") < 0) { return t; }
        StringBuilder sb = new StringBuilder();
        int n = t.Length;
        int start = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = t[i] & 255;
            string esc = "";
            if (c == 38) { esc = "&amp;"; }  // '&'
            else if (c == 60) { esc = "&lt;"; }  // '<'
            else if (c == 62) { esc = "&gt;"; }  // '>'
            else if (c == 34) { esc = "&quot;"; }  // '"'
            else if (c == 39) { esc = "&#39;"; }  // '\''
            if (esc.Length > 0) {
                if (i > start) { sb.Append(t.Substring(start, i - start)); }
                sb.Append(esc);
                start = i + 1;
            }
        }
        if (n > start) { sb.Append(t.Substring(start, n - start)); }
        return sb.ToString();
    }

    // '0'–'9' 映射 0–9，其余 -1。
    static int DigitValue(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        return -1;
    }

    static int ToInt(string s, int def) {
        string t = Filter.Clean(s);
        if (t.Length == 0) { return def; }
        int i = 0;
        bool neg = false;
        if ((t[0] & 255) == 45) { neg = true; i = 1; }  // '-'
        if (i >= t.Length) { return def; }
        int val = 0;
        while (i < t.Length) {
            int d = Filter.DigitValue(t[i] & 255);
            if (d < 0) { return def; }
            val = val * 10 + d;
            i = i + 1;
        }
        if (neg) { return -val; }
        return val;
    }

    static long ToLong(string s, long def) {
        string t = Filter.Clean(s);
        if (t.Length == 0) { return def; }
        int i = 0;
        bool neg = false;
        if ((t[0] & 255) == 45) { neg = true; i = 1; }  // '-'
        if (i >= t.Length) { return def; }
        long val = 0;
        while (i < t.Length) {
            int d = Filter.DigitValue(t[i] & 255);
            if (d < 0) { return def; }
            val = val * 10 + (long)d;
            i = i + 1;
        }
        if (neg) { return -val; }
        return val;
    }

    static double ToDouble(string s, double def) {
        string t = Filter.Clean(s);
        if (t.Length == 0) { return def; }
        int i = 0;
        bool neg = false;
        if ((t[0] & 255) == 45) { neg = true; i = 1; }
        if (i >= t.Length) { return def; }
        double val = 0.0;
        bool any = false;
        while (i < t.Length) {
            int c = t[i] & 255;
            if (c == 46) { break; }  // '.'
            int d = Filter.DigitValue(c);
            if (d < 0) { return def; }
            val = val * 10.0 + (double)d;
            any = true;
            i = i + 1;
        }
        if (i < t.Length && (t[i] & 255) == 46) {
            i = i + 1;
            double scale = 0.1;
            while (i < t.Length) {
                int d = Filter.DigitValue(t[i] & 255);
                if (d < 0) { return def; }
                val = val + (double)d * scale;
                scale = scale * 0.1;
                any = true;
                i = i + 1;
            }
        }
        if (!any) { return def; }
        if (neg) { return -val; }
        return val;
    }

    static bool ToBool(string s, bool def) {
        string t = Filter.Clean(s).ToLower();
        if (t.Length == 0) { return def; }
        if (t == "1" || t == "true" || t == "on" || t == "yes") { return true; }
        if (t == "0" || t == "false" || t == "off" || t == "no") { return false; }
        return def;
    }
}
