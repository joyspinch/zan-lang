using System;
using System.Collections.Generic;

namespace System.Web;

// WebSocket 集群会话枢纽：管理本地长连接、组/用户映射，并驱动跨节点背板 (IWsBackplane)
public class WsHub {
    private static string defaultLock = "System.Web.WsHub.defaultLock";
    private static WsHub defaultHub;
    private Dictionary<string, List<WsSession>> userMap;
    private Dictionary<string, List<WsSession>> groupMap;
    private List<WsSession> allSessions;
    // 反向索引：session -> allSessions 下标 / 归属 uid 集合 / 归属 group 集合，
    // 使 Register/Unregister 降至 O(1) / O(groups(session))，彻底消除 O(U+G+S) 全表扫。
    private Dictionary<WsSession, int> sessionIndex;
    private Dictionary<WsSession, List<string>> sessionUsers;
    private Dictionary<WsSession, List<string>> sessionGroups;
    private IWsBackplane backplane;

    public WsHub() {
        this.userMap = new Dictionary<string, List<WsSession>>();
        this.groupMap = new Dictionary<string, List<WsSession>>();
        this.allSessions = new List<WsSession>();
        this.sessionIndex = new Dictionary<WsSession, int>();
        this.sessionUsers = new Dictionary<WsSession, List<string>>();
        this.sessionGroups = new Dictionary<WsSession, List<string>>();
        this.backplane = null;
    }

    public static WsHub Default() {
        if (WsHub.defaultHub == null) {
            lock (WsHub.defaultLock) {
                if (WsHub.defaultHub == null) {
                    WsHub.defaultHub = new WsHub();
                }
            }
        }
        return WsHub.defaultHub;
    }

    public void UseBackplane(IWsBackplane bp) {
        this.backplane = bp;
    }

    public void UseBackplane(WsBackplanePublishHandler publishFn) {
        if (publishFn != null) {
            this.backplane = new ActionWsBackplane(publishFn);
        } else {
            this.backplane = null;
        }
    }

    public IWsBackplane Backplane() {
        return this.backplane;
    }

    // 登记用户连接
    public void Register(string uid, WsSession session) {
        if (session == null) { return; }
        lock (this) {
            if (!this.sessionIndex.ContainsKey(session)) {
                this.sessionIndex[session] = this.allSessions.Count;
                this.allSessions.Add(session);
            }
            if (uid != null && uid.Length > 0) {
                List<WsSession> uList;
                if (!this.userMap.TryGetValue(uid, out uList)) {
                    uList = new List<WsSession>();
                    this.userMap[uid] = uList;
                }
                List<string> uNames;
                if (!this.sessionUsers.TryGetValue(session, out uNames)) {
                    uNames = new List<string>();
                    this.sessionUsers[session] = uNames;
                }
                if (!uNames.Contains(uid)) {
                    uNames.Add(uid);
                    uList.Add(session);
                }
            }
        }
    }

    // 加入分组/频道
    public void JoinGroup(string group, WsSession session) {
        if (session == null || group == null || group.Length == 0) { return; }
        lock (this) {
            List<WsSession> gList;
            if (!this.groupMap.TryGetValue(group, out gList)) {
                gList = new List<WsSession>();
                this.groupMap[group] = gList;
            }
            List<string> gNames;
            if (!this.sessionGroups.TryGetValue(session, out gNames)) {
                gNames = new List<string>();
                this.sessionGroups[session] = gNames;
            }
            if (!gNames.Contains(group)) {
                gNames.Add(group);
                gList.Add(session);
            }
        }
    }

    // 离开分组/频道
    public void LeaveGroup(string group, WsSession session) {
        if (session == null || group == null || group.Length == 0) { return; }
        lock (this) {
            List<WsSession> gList;
            if (this.groupMap.TryGetValue(group, out gList)) {
                gList.Remove(session);
                if (gList.Count == 0) { this.groupMap.Remove(group); }
            }
            List<string> gNames;
            if (this.sessionGroups.TryGetValue(session, out gNames)) {
                gNames.Remove(group);
                if (gNames.Count == 0) { this.sessionGroups.Remove(session); }
            }
        }
    }

    // 注销会话（O(1) 交换删除 allSessions + 按反向索引精准移除用户/分组归属）
    public void Unregister(WsSession session) {
        if (session == null) { return; }
        lock (this) {
            int idx = -1;
            if (this.sessionIndex.TryGetValue(session, out idx)) {
                int last = this.allSessions.Count - 1;
                if (idx != last) {
                    WsSession moved = this.allSessions[last];
                    this.allSessions[idx] = moved;
                    this.sessionIndex[moved] = idx;
                }
                this.allSessions.RemoveAt(last);
                this.sessionIndex.Remove(session);
            }
            List<string> uNames;
            if (this.sessionUsers.TryGetValue(session, out uNames)) {
                for (int i = 0; i < uNames.Count; i = i + 1) {
                    string uid = uNames[i];
                    List<WsSession> uList;
                    if (this.userMap.TryGetValue(uid, out uList)) {
                        uList.Remove(session);
                        if (uList.Count == 0) { this.userMap.Remove(uid); }
                    }
                }
                this.sessionUsers.Remove(session);
            }
            List<string> gNames;
            if (this.sessionGroups.TryGetValue(session, out gNames)) {
                for (int i = 0; i < gNames.Count; i = i + 1) {
                    string grp = gNames[i];
                    List<WsSession> gList;
                    if (this.groupMap.TryGetValue(grp, out gList)) {
                        gList.Remove(session);
                        if (gList.Count == 0) { this.groupMap.Remove(grp); }
                    }
                }
                this.sessionGroups.Remove(session);
            }
        }
    }

    // 向指定用户推送（单机直推 + 集群跨节点背板广播）
    public void SendToUser(string uid, string message) {
        if (uid == null || uid.Length == 0 || message == null) { return; }
        // 1. 本机投递
        this.DeliverUserLocal(uid, message);

        // 2. 集群背板广播
        IWsBackplane bp = this.backplane;
        if (bp != null) {
            bp.Publish("user", uid, message);
        }
    }

    // 向指定分组推送（单机直推 + 集群跨节点背板广播）
    public void SendToGroup(string group, string message) {
        if (group == null || group.Length == 0 || message == null) { return; }
        // 1. 本机投递
        this.DeliverGroupLocal(group, message);

        // 2. 集群背板广播
        IWsBackplane bp = this.backplane;
        if (bp != null) {
            bp.Publish("group", group, message);
        }
    }

    // 全集群全量广播（单机直推 + 集群跨节点背板广播）
    public void Broadcast(string message) {
        if (message == null) { return; }
        // 1. 本机投递
        this.DeliverAllLocal(message);

        // 2. 集群背板广播
        IWsBackplane bp = this.backplane;
        if (bp != null) {
            bp.Publish("broadcast", "", message);
        }
    }

    // 收到来自跨节点背板的消息时（仅向本地会话分发，避免重入广播死循环）
    public void OnBackplaneMessage(string action, string target, string payload) {
        if (action == null || payload == null) { return; }
        if (action == "user") {
            if (target != null && target.Length > 0) { this.DeliverUserLocal(target, payload); }
        } else if (action == "group") {
            if (target != null && target.Length > 0) { this.DeliverGroupLocal(target, payload); }
        } else if (action == "broadcast") {
            this.DeliverAllLocal(payload);
        }
    }

    private void DeliverUserLocal(string uid, string message) {
        if (uid == null || uid.Length == 0 || message == null) { return; }
        List<WsSession> targets = null;
        lock (this) {
            List<WsSession> src;
            if (this.userMap.TryGetValue(uid, out src)) {
                targets = new List<WsSession>();
                for (int i = 0; i < src.Count; i = i + 1) {
                    targets.Add(src[i]);
                }
            }
        }
        if (targets != null) {
            for (int i = 0; i < targets.Count; i = i + 1) {
                WsSession s = targets[i];
                if (s == null) { continue; }
                if (!s.Open()) { this.Unregister(s); continue; }
                s.SendText(message);
            }
        }
    }

    private void DeliverGroupLocal(string group, string message) {
        if (group == null || group.Length == 0 || message == null) { return; }
        List<WsSession> targets = null;
        lock (this) {
            List<WsSession> src;
            if (this.groupMap.TryGetValue(group, out src)) {
                targets = new List<WsSession>();
                for (int i = 0; i < src.Count; i = i + 1) {
                    targets.Add(src[i]);
                }
            }
        }
        if (targets != null) {
            for (int i = 0; i < targets.Count; i = i + 1) {
                WsSession s = targets[i];
                if (s == null) { continue; }
                if (!s.Open()) { this.Unregister(s); continue; }
                s.SendText(message);
            }
        }
    }

    private void DeliverAllLocal(string message) {
        if (message == null) { return; }
        List<WsSession> targets = new List<WsSession>();
        lock (this) {
            for (int i = 0; i < this.allSessions.Count; i = i + 1) {
                targets.Add(this.allSessions[i]);
            }
        }
        for (int i = 0; i < targets.Count; i = i + 1) {
            WsSession s = targets[i];
            if (s == null) { continue; }
            if (!s.Open()) { this.Unregister(s); continue; }
            s.SendText(message);
        }
    }

    public int OnlineCount() {
        lock (this) {
            return this.allSessions.Count;
        }
    }

    public void Clear() {
        lock (this) {
            this.allSessions.Clear();
            this.sessionIndex.Clear();
            this.sessionUsers.Clear();
            this.sessionGroups.Clear();
            this.userMap.Clear();
            this.groupMap.Clear();
            this.backplane = null;
        }
    }
}
