namespace System.Web;

// WebSocket 集群分布式跨节点背板委托
public delegate void WsBackplanePublishHandler(string action, string target, string payload);

// WebSocket 集群分布式跨节点背板接口（用于横向扩展时跨节点推送）
public interface IWsBackplane {
    // 发布集群级通信动作（action 可取: "broadcast", "user", "group"）
    void Publish(string action, string target, string payload);
}

// 基于委托的轻量级背板适配器
public class ActionWsBackplane : IWsBackplane {
    private WsBackplanePublishHandler handler;

    public ActionWsBackplane(WsBackplanePublishHandler handler) {
        this.handler = handler;
    }

    public void Publish(string action, string target, string payload) {
        if (this.handler != null) {
            this.handler(action, target, payload);
        }
    }
}
