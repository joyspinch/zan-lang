using System.Diagnostics;
using System.IO;
using System.Json;
using System.Net.Http;
using System.Net.Sockets;
using System.Net;
using System.Text;
using System.Threading;
using System;

namespace System.Web;

public class WebApp : IDisposable {
    [DllImport("crt")]
    private static extern long time(nint ptr);

    [DllImport("crt")]
    private static extern nint fopen(string path, string mode);

    [DllImport("crt")]
    private static extern long fwrite(string buf, long size, long count, nint fp);

    [DllImport("crt")]
    private static extern int fclose(nint fp);

    string host;
    int port;
    bool running;
    TcpListener listener;
    // 共享内存表：包含限流、锁和路由计数器，多工作进程间无拷贝共享。
    Router router;
    Hooks hooks;
    View views;
    Sessions sessions;
    RateLimiter limiter;
    LockManager locks;
    AuthFn authResolver;
    PermissionFn permissionResolver;
    ServerMetrics metrics;
    LlmsTxt llmsTxt;
    RobotsTxt robotsTxt;
    Sitemap sitemap;
    /* 应用层 GEO 内容源：内容由应用层每次请求求值，协议层只渲染。 */
    SitemapSource sitemapSource;
    RobotsSource robotsSource;
    LlmsSource llmsSource;
    /* 挂载幂等标记：静态对象与内容源共用挂载点，同一路径只挂一次。 */
    bool sitemapMounted;
    bool robotsMounted;
    bool llmsMounted;

    // 内存请求体上限（字节），超出回答 413。
    int maxBodyBytes;  // in-memory request body cap (413 above this)
    // 流式上传上限（字节），只作用于 [Upload] 路由。
    int maxUploadBytes;  // streaming upload cap for .Upload() routes
    int requestTimeoutMs;  // per-request deadline: a connection that stops
    // 并发连接上限（0 = 不设上限；超限回答 503 并关闭）。
    int maxConnections;  // concurrent connections served at once (0 = no cap)
    string uploadDir;  // where streamed uploads land
    // 进程内全局连接统计原子计数器。
    AtomicInt uploadSeq;
    string loginPath;
    // 全局每秒请求上限（0 = 不限；超限 429）。
    int globalLimit;  // requests/sec across all routes (0 = unlimited)
    AtomicInt totalRequests;
    AtomicInt activeConnections;
    bool reusePort;

    // 当前进程单例应用实例句柄，供 Worker 底层连接回调分发。
    static WebApp active;

    // 构造应用服务器并填入默认配置：请求体上限 2MB、流式上传上限
    // 512MB、请求超时 30s、并发连接上限 10000、上传目录 uploads；
    // 共享表（限流/锁/路由统计）由 InitShared 在派生 worker 之前创建，
    // 不在这里。
    public WebApp(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.router = new Router();
        this.hooks = new Hooks();
        this.views = null;
        this.sessions = new Sessions();
        this.authResolver = null;
        this.permissionResolver = null;
        this.metrics = ServerMetrics.Global();
        this.maxBodyBytes = 2 * 1024 * 1024;  // 2MB default
        this.maxUploadBytes = 512 * 1024 * 1024;  // 512MB streamed-upload default
        this.requestTimeoutMs = 30000;
        this.maxConnections = 10000;
        this.uploadDir = "uploads";
        this.uploadSeq = new AtomicInt(0);
        this.loginPath = "";
        this.globalLimit = 0;
        this.totalRequests = new AtomicInt(0);
        this.activeConnections = new AtomicInt(0);
        this.reusePort = false;
        // 共享内存表在 Worker 派生前由 InitShared 创建。
        this.limiter = null;
        this.locks = null;
        this.sitemapMounted = false;
        this.robotsMounted = false;
        this.llmsMounted = false;
    }

    // ---- configuration ----

    // 监听主机地址。
    public string Host() { return this.host; }
    // 监听端口。
    public int Port() { return this.port; }
    // 加载视图目录（编译进内存）并返回自身。
    public WebApp Views(string dir) { this.views = View.LoadDir(dir); return this; }
    // 内存请求体上限（字节），超出回答 413。
    public WebApp MaxBody(int bytes) { this.maxBodyBytes = bytes; return this; }
    // 流式上传上限（字节），只作用于 [Upload] 路由，超出回答 413。
    public WebApp MaxUpload(int bytes) { this.maxUploadBytes = bytes; return this; }
    // 请求到达与响应处理的超时时限（毫秒）。
    public WebApp Timeout(int ms) { this.requestTimeoutMs = ms; return this; }
    // 最大并发连接数上限，超出时直接响应 503 并关闭连接。
    public WebApp MaxConnections(int n) { this.maxConnections = n; return this; }
    // 流式上传的落盘目录（默认 uploads）。
    public WebApp UploadDir(string dir) { this.uploadDir = dir; return this; }
    // 全局每秒请求上限，按 uid（匿名时按对端 IP）计；0 不限，超限 429。
    public WebApp GlobalLimit(int perSecond) { this.globalLimit = perSecond; return this; }
    // 未授权重定向的登录页路由（未配置时默认返回 401 JSON）。
    public WebApp LoginPath(string path) { this.loginPath = path; return this; }
    // 多进程部署时以 SO_REUSEPORT 监听，由内核把连接分发给各 worker。
    public WebApp ReusePort(bool on) { this.reusePort = on; return this; }
    // 初始化跨进程路由统计共享内存表。
    public void InitStats() { this.router.InitStatsShared(); }

    static const string ShareRate = "WEB_RATE";
    static const string ShareLock = "WEB_LOCK";
    static const string ShareRoute = "WEB_ROUTE";

    // 共享内存表：包含限流、锁和路由计数器，多工作进程间无拷贝共享。
    public void InitShared() {
        if (this.AttachShared()) { return; }
        RateLimiter l = this.Limiter();
        LockManager k = this.Locks();
        this.InitStats();
        // 共享内存表句柄传递：在派生工作进程时分发匿名共享表句柄。
        Worker.ShareHandle(WebApp.ShareRate, l.OsHandle());
        Worker.ShareHandle(WebApp.ShareLock, k.OsHandle());
        Worker.ShareHandle(WebApp.ShareRoute, this.router.StatsOsHandle());
    }

    // Worker 侧：映射主进程创建并下发的各表。主进程与单进程服务没有
    // 可继承句柄，返回 false，由它们自己建表。
    public bool AttachShared() {
        long rate = Worker.InheritedHandle(WebApp.ShareRate);
        long lockTable = Worker.InheritedHandle(WebApp.ShareLock);
        long route = Worker.InheritedHandle(WebApp.ShareRoute);
        if (rate == 0 && lockTable == 0 && route == 0) { return false; }
        if (this.limiter == null) {
            this.limiter = RateLimiter.Attach(rate, 1000);
        }
        if (this.locks == null) { this.locks = LockManager.Attach(lockTable); }
        this.router.AttachStats(route);
        return true;
    }

    // 按需创建；拥有各表的进程已在 InitShared 里提前建好。
    public RateLimiter Limiter() {
        if (this.limiter == null) { this.limiter = RateLimiter.Owned(1000); }
        return this.limiter;
    }

    // 按需创建请求锁管理器；worker 进程由 AttachShared 映射主进程下发的表。
    public LockManager Locks() {
        if (this.locks == null) { this.locks = LockManager.Owned(); }
        return this.locks;
    }
    // 注册 before 钩子（按注册顺序执行；返回 false 短路请求）。
    public WebApp Before(HookFn fn) { this.hooks.Before(fn); return this; }
    // 注册 after 钩子（请求结束后按注册顺序执行，收微秒耗时）。
    public WebApp After(AfterFn fn) { this.hooks.After(fn); return this; }
    // 安装 token→用户解析器；未安装时用内置 Sessions 表解析。
    public WebApp AuthResolver(AuthFn fn) { this.authResolver = fn; return this; }
    // 安装权限解析器；未安装时"任何已登录用户"即被允许。
    public WebApp PermissionResolver(PermissionFn fn) { this.permissionResolver = fn; return this; }

    // 通用路由注册底层入口（供属性路由生成器调用）。
    public Route Map(string method, string pattern, HttpHandler h) {
        return this.router.Add(method, pattern, h);
    }

    // 正则路由注册底层入口（供属性路由生成器调用）。
    public Route MapRegex(string method, string pattern, HttpHandler h) {
        return this.router.AddRegex(method, pattern, h);
    }

    // 注册 GET 路由（= Map("GET", ...)）。
    public Route Get(string pattern, HttpHandler h) { return this.router.Get(pattern, h); }
    // 注册 POST 路由。
    public Route Post(string pattern, HttpHandler h) { return this.router.Post(pattern, h); }
    // 注册 PUT 路由。
    public Route Put(string pattern, HttpHandler h) { return this.router.Put(pattern, h); }
    // 注册 DELETE 路由。
    public Route Delete(string pattern, HttpHandler h) { return this.router.Delete(pattern, h); }

    // 启用 GEO 大模型站点友好规范，自动挂载 /.well-known/llms.txt 与 /llms.txt。
    WebApp UseLlmsTxt(LlmsTxt llms) {
        this.llmsTxt = llms;
        if (llms != null) { this.MountLlms(); }
        return this;
    }

    // 应用层接管 llms.txt 内容：委托每次请求求值，返回 null 时回退静态对象。
    WebApp UseLlmsSource(LlmsSource source) {
        this.llmsSource = source;
        if (source != null) { this.MountLlms(); }
        return this;
    }

    // llms.txt 挂载点：静态对象与内容源共用，三条路径只挂一次。
    void MountLlms() {
        if (!this.llmsMounted) {
            this.llmsMounted = true;
            this.router.Get("/.well-known/llms.txt", WebApp.HandleLlmsTxt);
            this.router.Get("/.well-known/llms-full.txt", WebApp.HandleLlmsFullTxt);
            this.router.Get("/llms.txt", WebApp.HandleLlmsTxt);
        }
        /* 如果未显式定制 robots.txt，自动挂载默认放行 AI 爬虫并声明 llms.txt 的 robots.txt */
        if (this.robotsTxt == null && this.robotsSource == null) {
            this.UseRobotsTxt(RobotsTxt.Create());
        }
    }

    // 启用搜索引擎与 AI 爬虫协议规则 robots.txt。
    WebApp UseRobotsTxt(RobotsTxt robots) {
        this.robotsTxt = robots;
        if (robots != null) { this.MountRobots(); }
        return this;
    }

    // 应用层接管 robots.txt 内容：委托每次请求求值，返回 null 时回退静态对象。
    WebApp UseRobotsSource(RobotsSource source) {
        this.robotsSource = source;
        if (source != null) { this.MountRobots(); }
        return this;
    }

    // robots.txt 挂载点：静态对象与内容源共用，同一路径只挂一次。
    void MountRobots() {
        if (this.robotsMounted) { return; }
        this.robotsMounted = true;
        this.router.Get("/robots.txt", WebApp.HandleRobotsTxt);
    }

    // 启用 XML 站点地图 sitemap.xml。
    WebApp UseSitemap(Sitemap sm) {
        this.sitemap = sm;
        if (sm != null) { this.MountSitemap(); }
        return this;
    }

    // 应用层接管 sitemap.xml 内容：委托每次请求求值，返回 null 时回退静态对象。
    WebApp UseSitemapSource(SitemapSource source) {
        this.sitemapSource = source;
        if (source != null) { this.MountSitemap(); }
        return this;
    }

    // sitemap.xml 挂载点：静态对象与内容源共用，同一路径只挂一次。
    void MountSitemap() {
        if (this.sitemapMounted) { return; }
        this.sitemapMounted = true;
        this.router.Get("/sitemap.xml", WebApp.HandleSitemapXml);
    }

    LlmsTxt Llms() { return this.llmsTxt; }
    RobotsTxt Robots() { return this.robotsTxt; }
    Sitemap SiteMap() { return this.sitemap; }
    // 是否已启用 llms.txt（静态对象或应用层内容源任一）。
    bool HasLlms() { return this.llmsTxt != null || this.llmsSource != null; }
    // 是否已启用 robots.txt（静态对象或应用层内容源任一）。
    bool HasRobots() { return this.robotsTxt != null || this.robotsSource != null; }
    // 是否已启用 sitemap.xml（静态对象或应用层内容源任一）。
    bool HasSitemap() { return this.sitemap != null || this.sitemapSource != null; }

    // llms.txt 处理器：内容源优先，其次静态对象，都没有则给出未配置提示。
    static async void HandleLlmsTxt(HttpContext ctx) {
        WebApp app = WebHost.Current();
        if (app != null) {
            LlmsSource source = app.llmsSource;
            if (source != null) {
                LlmsTxt content = await source();
                if (content != null) {
                    ctx.Markdown(content.ToMarkdown());
                    return;
                }
            }
            if (app.llmsTxt != null) {
                ctx.Markdown(app.llmsTxt.ToMarkdown());
                return;
            }
        }
        ctx.Text("# llms.txt not configured\n");
    }

    // llms-full.txt 处理器：与 llms.txt 同源，长文本聚合版。
    static async void HandleLlmsFullTxt(HttpContext ctx) {
        WebApp app = WebHost.Current();
        if (app != null) {
            LlmsSource source = app.llmsSource;
            if (source != null) {
                LlmsTxt content = await source();
                if (content != null) {
                    ctx.Markdown(content.ToFullMarkdown());
                    return;
                }
            }
            if (app.llmsTxt != null) {
                ctx.Markdown(app.llmsTxt.ToFullMarkdown());
                return;
            }
        }
        ctx.Text("# llms-full.txt not configured\n");
    }

    // robots.txt 处理器：内容源优先，其次静态对象，都没有则全站放行。
    static async void HandleRobotsTxt(HttpContext ctx) {
        WebApp app = WebHost.Current();
        if (app != null) {
            RobotsSource source = app.robotsSource;
            if (source != null) {
                RobotsTxt content = await source();
                if (content != null) {
                    ctx.Text(content.ToText());
                    return;
                }
            }
            if (app.robotsTxt != null) {
                ctx.Text(app.robotsTxt.ToText());
                return;
            }
        }
        ctx.Text("User-agent: *\nAllow: /\n");
    }

    // sitemap.xml 处理器：内容源优先，其次静态对象，都没有则给空站点地图。
    static async void HandleSitemapXml(HttpContext ctx) {
        WebApp app = WebHost.Current();
        if (app != null) {
            SitemapSource source = app.sitemapSource;
            if (source != null) {
                Sitemap content = await source();
                if (content != null) {
                    ctx.Xml(content.ToXml());
                    return;
                }
            }
            if (app.sitemap != null) {
                ctx.Xml(app.sitemap.ToXml());
                return;
            }
        }
        ctx.Xml("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"></urlset>\n");
    }

    // 渲染模板并套最近的布局；未加载视图时返回空串。
    string RenderPage(string name, ViewData data) {
        if (this.views == null) { return ""; }
        return this.views.RenderPage(name, data);
    }

    // 局部渲染模板（不包含外层 layout，供页面局部无刷新更新调用）。
    string RenderFragment(string name, ViewData data) {
        if (this.views == null) { return ""; }
        return this.views.Render(name, data);
    }

    // 墙钟秒（CRT time），上传文件名与错误日志时间戳用。
    public static int NowSeconds() { return time(0); }

    // 错误日志消息截断（防止超大异常堆栈撑爆日志文件）。
    private static string Redact(string s) {
        if (s == null) { return ""; }
        if (s.Length > 500) { return s.Substring(0, 500); }
        return s;
    }

    ServerBanner Banner(int procs) {
        string mode = "single process";
        if (procs > 1) {
            mode = "master + " + Convert.ToString(procs) + " workers";
        }
        ServerBanner b = new ServerBanner("ZAN WEB", "SERVICES").Mode(mode);
        b.Service("http",
            "http://" + this.host + ":" + Convert.ToString(this.port),
            Convert.ToString(procs), "[OK]");
        b.Info("routes", Convert.ToString(this.router.Count()));
        if (this.views != null) { b.Info("views", "loaded"); }
        if (this.sessions != null) { b.Info("sessions", "in-memory"); }
        b.Info("max body", Convert.ToString(this.maxBodyBytes / (1024 * 1024))
            + "MB");
        b.Info("uploads", this.uploadDir + "/ "
            + Convert.ToString(this.maxUploadBytes / (1024 * 1024)) + "MB max");
        if (this.globalLimit > 0) {
            b.Info("rate limit", Convert.ToString(this.globalLimit) + " req/s");
        }
        if (this.reusePort) { b.Info("reuseport", "on"); }
        return b;
    }


    public async int Start() {
        this.InitShared();
        Socket.Initialize();
        this.listener = new TcpListener(this.host, this.port);
        if (this.reusePort) { this.listener.StartReusePort(); } else { this.listener.Start(); }
        this.running = true;
        this.Banner(1).Footer("Press Ctrl+C to stop. Start success.").Print();
        while (this.running) {
            nint clientSock = await this.listener.AcceptAsync();
            if (clientSock >= 0) {
                if (await this.RefuseOverCapacity(clientSock)) { continue; }
                Task.Spawn(HandleConnection(clientSock));
            }
        }
        return 0;
    }

    // 置停标志并关闭监听 socket，accept 循环随之退出。
    public void Stop() {
        this.running = false;
        if (this.listener != null) { this.listener.Stop(); }
    }

    public void Dispose() {
        this.Stop();
    }

    public static void SetActive(WebApp app) {
        active = app;
    }

    static async void ServeSock(nint clientSock) {
        WebApp app = active;
        if (app == null) { Socket.Close(clientSock); return; }
        if (await app.RefuseOverCapacity(clientSock)) { return; }
        await app.HandleConnection(clientSock);
    }

    async bool RefuseOverCapacity(nint clientSock) {
        long live = this.activeConnections.Increment();
        if (this.maxConnections <= 0 || live <= (long)this.maxConnections) {
            return false;
        }
        long _back = this.activeConnections.Decrement();
        TcpClient c = TcpClient.FromSocket(clientSock);
        int _s = await c.SendAsync(WebApp.SimpleResponse(503,
            "Service Unavailable", "server is at capacity"));
        c.Close();
        return true;
    }

    // 一条 keep-alive 连接的完整生命周期：读入并定界请求头（超 64KB 回
    // 431）→ 解析（定界失败按 parseStatus 回 400/501）→ 流式上传落盘或
    // 缓冲内存正文（超限 413）→ 解析表单 → Dispatch → 写回应答，直到
    // 对端断开或非 keep-alive 为止。每个请求重置一次空闲期限（防
    // slowloris）；SSE/WS 劫持的连接由 handler 接管，循环随即结束。
    // 清理走 finally：即便管线里有未被 catch 的异常展开到这一层，
    // deadline 槽位、framer 缓冲、套接字与连接计数也必须归位。
    async void HandleConnection(nint clientSock) {
        try {
            await this.HandleConnectionInner(clientSock);
        } finally {
            Socket.Close(clientSock);
        }
    }

    // HandleConnection 的主体：watch/framer/client 三个局部资源
    // 在这里创建，正常结束路径统一清理；套接字本身的 Close 由
    // HandleConnection 的 finally 负责（ShutdownBoth 无法替代——
    // 劫持连接之后的收尾也要真正释放描述符）。
    async void HandleConnectionInner(nint clientSock) {
        Socket.SetNoDelay(clientSock);
        TcpClient client = TcpClient.FromSocket(clientSock);
        HttpFramer framer = HttpFramer.Create(clientSock);
        HttpDeadlineToken watch = HttpDeadline.Arm(clientSock, this.requestTimeoutMs);
        // 对端地址是连接的属性，不是请求的属性：一条 keep-alive 连接上
        // 每个请求都问一次内核（getpeername）等于白付一次系统调用。
        string remoteIp = Socket.RemoteIp(clientSock);
        bool keepAlive = true;
        while (keepAlive) {
            HttpDeadline.Touch(watch, this.requestTimeoutMs);
            int headerEnd = await framer.ReadHead(65000);
            if (headerEnd == -431) {
                int _s = await client.SendAsync(WebApp.SimpleResponse(431,
                    "Request Header Fields Too Large",
                    "header block too large"));
                break;
            }
            if (headerEnd <= 0) { break; }

            HttpRequest request = HttpRequest.Parse(framer.Head(headerEnd),
                                                   headerEnd);
            // 定界失败（Content-Length 溢出/重复不一致、非数字、
            // Transfer-Encoding 未实现等）→ 拒绝，不切分正文：
            // 剩余字节可能是走私的伪装请求。
            if (request.parseStatus != 0) {
                int _s0 = await client.SendAsync(WebApp.SimpleResponse(
                    request.parseStatus,
                    request.parseStatus == 501 ? "Not Implemented" : "Bad Request",
                    "malformed request framing"));
                break;
            }
            keepAlive = request.keepAlive;
            HttpContext ctx = new HttpContext(request, remoteIp);
            ctx.__Attach(client);
            ctx.__SetFramer(framer);
            // 请求到达与响应处理的超时时限（毫秒）。
            ctx.__SetDeadlineSlot(watch, this.requestTimeoutMs);
            Route route = this.router.Match(ctx);

            // 限流在正文之前：原顺序先把正文缓冲齐（≤maxBodyBytes）并解析
            // form/multipart，DispatchInner 才判全局限流与路由限流——被限的
            // 调用方照样花掉服务器的带宽与解析 CPU，限流形同虚设。判定只在
            // 这里做一次（Allow 消耗令牌，判两次等于双倍扣减）；429 用
            // SimpleResponse 应答并断连，因为正文留在流上没读，keep-alive
            // 复用会把残余字节当下一个请求的头。
            if (await this.LimitExceeded(ctx, route)) {
                int _s1 = await client.SendAsync(WebApp.SimpleResponse(429,
                    "Too Many Requests", "rate limit exceeded"));
                break;
            }

            if (route != null && route.streamUpload && request.contentLength > 0) {
                if (request.contentLength > this.maxUploadBytes) {
                    int _s2 = await client.SendAsync(WebApp.SimpleResponse(413,
                        "Payload Too Large", "upload exceeds limit"));
                    break;
                }
                string tmp = await this.StreamBodyToFile(clientSock, framer,
                    request);
                if (tmp.Length == 0) {
                    int _s3 = await client.SendAsync(WebApp.SimpleResponse(400,
                        "Bad Request", "upload failed"));
                    break;
                }
                ctx.uploadPath = tmp;
                ctx.uploadSize = request.contentLength;
                request.body = "";
            } else {
                if (request.contentLength > this.maxBodyBytes) {
                    int _s4 = await client.SendAsync(WebApp.SimpleResponse(413,
                        "Payload Too Large", "body exceeds limit"));
                    break;
                }
                int bodyStatus = await framer.ReadBody(request, this.maxBodyBytes);
                if (bodyStatus > 0) {
                    int _s4b = await client.SendAsync(WebApp.SimpleResponse(
                        bodyStatus,
                        bodyStatus == 413 ? "Payload Too Large" : "Bad Request",
                        bodyStatus == 413 ? "body exceeds limit"
                                          : "malformed request body"));
                    break;
                }
                if (bodyStatus < 0) {
                    int _s5 = await client.SendAsync(WebApp.SimpleResponse(400,
                        "Bad Request", "incomplete body"));
                    break;
                }
                framer.Consume(framer.RequestBytes());
                if (request.bodyLength > 0) {
                    if (HttpContext.StartsWith(request.contentType,
                                               "multipart/form-data")) {
                        // 内存路径的 multipart：文本字段进 form 表
                        // （文件部件由处理器按需取用）。
                        HttpContext.ParseMultipartFields(request, ctx);
                    } else {
                        HttpContext.ParseFormBody(request, ctx);
                    }
                }
            }

            Worker.BumpStat();
            await this.Dispatch(ctx, route, keepAlive);
            if (ctx.Hijacked()) { keepAlive = false; ctx.ReleaseResponseBuf(); break; }
            if (ctx.responseBuf != null && ctx.responseLen > 0) {
                int _sent = await client.SendBytesAsync(ctx.responseBuf, 0, ctx.responseLen);
            }
            ctx.ReleaseResponseBuf();
            Worker.BumpSent();
            if (!keepAlive) { break; }
        }
        HttpDeadline.Disarm(watch);
        framer.Dispose();
        client.Close();
        long _live = this.activeConnections.Decrement();
    }

    // failure.
    async string StreamBodyToFile(nint sock, HttpFramer framer,
                                  HttpRequest request) {
        if (!Directory.Exists(this.uploadDir)) {
            Directory.CreateDirectoryRecursive(this.uploadDir);
        }
        long seq = this.uploadSeq.Increment();
        string tmp = this.uploadDir + "/upload_" + Convert.ToString(WebApp.NowSeconds())
            + "_" + Convert.ToString(seq) + ".bin";
        nint fp = fopen(tmp, "wb");
        if (fp == 0) { return ""; }
        int total = request.contentLength;
        int have = 0;
        int headerEnd = request.bodyStart;
        int bodyInBuf = framer.Pending() - headerEnd;
        if (bodyInBuf > total) { bodyInBuf = total; }
        if (bodyInBuf > 0) {
            string firstChunk = framer.Slice(headerEnd, bodyInBuf);
            int _w0 = (int)fwrite(firstChunk, 1, bodyInBuf, fp);
            if (_w0 < bodyInBuf) { int _c0 = fclose(fp); return ""; }
            have = bodyInBuf;
        }
        framer.Consume(headerEnd + have);
        byte[] buf = WebApp.MakeBuffer(65536);
        while (have < total) {
            int n = await Socket.RecvIntoAsync(sock, buf, 65535);
            if (n <= 0) { int _c1 = fclose(fp); return ""; }
            if (have + n > total) { n = total - have; }
            // fwrite 短写（磁盘满/配额）必须当失败处理：不校验的话
            // have 照常推进，落盘文件被静默截断，调用方拿到一个
            // 看似成功的残缺文件。
            int _w = (int)fwrite(buf, 1, n, fp);
            if (_w < n) { int _c3 = fclose(fp); return ""; }
            have = have + n;
        }
        int _c2 = fclose(fp);
        return tmp;
    }

    private static byte[] MakeBuffer(int size) {
        return new byte[size + 1];
    }

    async void Dispatch(HttpContext ctx, Route route, bool keepAlive) {
        long startUs = ServerMetrics.MonoMicros();
        long _n = this.totalRequests.Increment();
        this.metrics.Entered();
        try {
            await this.DispatchInner(ctx, route, keepAlive, startUs);
        } finally {
            this.metrics.Left();
        }
        long elapsedUs = ServerMetrics.MonoMicros() - startUs;
        if (ctx.MetricsExcluded()) {
            this.metrics.StreamClosed(ctx.Frames(), ctx.FrameBytes());
        }
        // 未授权重定向的登录页路由（未配置时默认返回 401 JSON）。
        if (!ctx.MetricsExcluded()) {
            if (ctx.routePattern.Length == 0) {
                this.metrics.RecordUnmatched(ctx.status, elapsedUs);
            } else {
                this.metrics.RecordRoute(ctx.routeSlot, ctx.method,
                    ctx.routePattern, ctx.status, elapsedUs);
            }
        }
        this.hooks.RunAfter(ctx, elapsedUs);
    }

    // 全局与路由限流的唯一判定点，在正文缓冲/解析之前调用。
    // 键语义与键序与原 DispatchInner 内联判定一致：全局限流按 uid（匿名
    // 回落 IP，再回落 _unknown_），路由限流按 rateScope 拼 uid/ip。返回
    // true 表示超限，应答由调用方写出并断连。ctx.uid 顺带在这里解析好
    // （AuthUser 只看请求头），DispatchInner 复用、不再重付会话查询。
    async bool LimitExceeded(HttpContext ctx, Route route) {
        string uid = await this.AuthUser(ctx);
        ctx.uid = uid;
        string principal = uid;
        if (principal.Length == 0) { principal = ctx.RemoteIp(); }
        if (principal.Length == 0) { principal = "_unknown_"; }
        if (this.globalLimit > 0
            && !this.Limiter().Allow("_global_:" + principal, this.globalLimit)) {
            return true;
        }
        if (route == null || route.rateLimit <= 0) { return false; }
        string rateKey = route.Key();
        if (route.rateScope == "uid") {
            rateKey = rateKey + ":uid:" + uid;
        } else if (route.rateScope == "ip") {
            rateKey = rateKey + ":ip:" + ctx.RemoteIp();
        }
        return !this.Limiter().Allow(rateKey, route.rateLimit);
    }

    // 认证之后的请求管线，按序：before 钩子 → 404/405 → 填路由元数据 →
    // 登录/权限门 → [Lock] 请求锁 → handler。全局限流与路由限流已前移到
    // 正文读取之前（HandleConnectionInner 的 LimitExceeded——被限请求不再
    // 花服务器的带宽与解析 CPU），uid 亦由门处解析好放在 ctx.uid。
    // ApiError 变成它携带的应答；其余异常记录后回答 500，handler 结束
    // 时仍未写应答的也兜底 500。
    async void DispatchInner(HttpContext ctx, Route route, bool keepAlive, long startUs) {

        string uid = ctx.uid;
        string principal = uid;
        if (principal.Length == 0) { principal = ctx.RemoteIp(); }
        if (principal.Length == 0) { principal = "_unknown_"; }

        if (!this.hooks.RunBefore(ctx)) {
            ctx.BuildResponseDirect(keepAlive);
            return;
        }

        if (route == null) {
            if (this.router.PathExists(ctx.path)) {
                ctx.Status(405, "Method Not Allowed");
                ctx.Json(WebApp.ErrorJson("405", "method not allowed"));
            } else {
                ctx.Status(404, "Not Found");
                ctx.Json(WebApp.ErrorJson("404", "not found"));
            }
            ctx.BuildResponseDirect(keepAlive);
            return;
        }

        ctx.routeAction = route.action;
        ctx.routePattern = route.pattern;
        ctx.routeSlot = route.idx;

        if (route.needsLogin || route.needsAuth) {
            if (uid.Length == 0) {
                if (this.WantsPage(ctx)) {
                    ctx.Redirect(this.loginPath + "?next="
                        + Encoding.UrlEncode(ctx.path));
                    ctx.BuildResponseDirect(keepAlive);
                    return;
                }
                ctx.Status(401, "Unauthorized");
                ctx.Json(WebApp.ErrorJson("401", "authentication required"));
                ctx.BuildResponseDirect(keepAlive);
                return;
            }
            if (route.needsAuth) {
                if (!await this.Allow(uid, route.action)) {
                    ctx.Status(403, "Forbidden");
                    ctx.Json(WebApp.ErrorJson("403", "insufficient permission"));
                    ctx.BuildResponseDirect(keepAlive);
                    return;
                }
            }
        }

        LockLease lockLease = null;
        if (route.lockScope.Length > 0) {
            lockLease = this.Locks().TryAcquire(
                LockManager.KeyFor(route, principal));
            if (lockLease == null) {
                ctx.Status(429, "Too Many Requests").SetHeader("Retry-After", "1");
                ctx.Json(WebApp.ErrorJson("429", "request already in progress"));
                ctx.BuildResponseDirect(keepAlive);
                return;
            }
        }

        int rIdx = route.idx;
        HttpHandler h = route.handler;
        bool errLogged = false;
        try {
            await h(ctx);
        } catch (ApiError ae) {
            if (ae.Status() >= 500) {
                this.metrics.RecordError((long)WebApp.NowSeconds(),
                    ctx.method + " " + ctx.path, WebApp.Redact(ae.Message));
                errLogged = true;
            }
            if (!ctx.ended) {
                ctx.Status(ae.Status(), ApiError.Reason(ae.Status()));
                ctx.Api(ae.Code(), ae.Message, "null");
            }
        } catch (Exception e) {
            this.metrics.RecordError((long)WebApp.NowSeconds(),
                ctx.method + " " + ctx.path, WebApp.Redact(e.Message));
            errLogged = true;
            if (!ctx.ended) {
                ctx.Status(500, "Internal Server Error");
                ctx.Json(WebApp.ErrorJson("500", "internal server error"));
            }
        }
        if (lockLease != null) { this.Locks().Release(lockLease); }
        if (!ctx.ended) {
            this.metrics.RecordError((long)WebApp.NowSeconds(),
                ctx.method + " " + ctx.path, "handler produced no response");
            errLogged = true;
            ctx.Status(500, "Internal Server Error");
            ctx.Json(WebApp.ErrorJson("500", "handler produced no response"));
        }
        if (ctx.status >= 500 && !errLogged) {
            string detail = ctx.statusText;
            if (detail == null || detail.Length == 0) {
                detail = "HTTP " + Convert.ToString(ctx.status);
            }
            this.metrics.RecordError((long)WebApp.NowSeconds(),
                ctx.method + " " + ctx.path, detail);
        }

        // ServerMetrics.RecordRequest in Dispatch.
        if (!ctx.MetricsExcluded()) {
            long elapsedUs = ServerMetrics.MonoMicros() - startUs;
            this.router.RecordHit(rIdx, elapsedUs);
        }
        ctx.BuildResponseDirect(keepAlive);
    }

    bool WantsPage(HttpContext ctx) {
        if (this.loginPath.Length == 0) { return false; }
        if (ctx.method != "GET") { return false; }
        if (ctx.Header("HX-Request").Length > 0) { return false; }
        if (ctx.Header("X-Requested-With").Length > 0) { return false; }
        if (ctx.Header("X-Fragment").Length > 0) { return false; }
        return !ctx.Header("Accept").Contains("application/json");
    }

    async bool Allow(string uid, string action) {
        if (this.permissionResolver != null) {
            return await this.permissionResolver(uid, action);
        }
        return uid.Length > 0;
    }

    async string AuthUser(HttpContext ctx) {
        string auth = ctx.Header("Authorization");
        if (auth != null && auth.StartsWith("Bearer ")) {
            string token = auth.Substring(7);
            if (this.authResolver != null) { return await this.authResolver(token); }
            return this.sessions.UserOf(token);
        }
        string cookie = ctx.Cookie("zsession");
        if (cookie.Length > 0) {
            if (this.authResolver != null) { return await this.authResolver(cookie); }
            return this.sessions.UserOf(cookie);
        }
        return "";
    }

    static string err404 = "{\"code\":\"404\",\"msg\":\"not found\"}";
    static string err405 = "{\"code\":\"405\",\"msg\":\"method not allowed\"}";
    static string err401 = "{\"code\":\"401\",\"msg\":\"authentication required\"}";
    static string err403 = "{\"code\":\"403\",\"msg\":\"insufficient permission\"}";
    static string err429 = "{\"code\":\"429\",\"msg\":\"request already in progress\"}";
    static string err500 = "{\"code\":\"500\",\"msg\":\"internal server error\"}";
    static string err500noResp = "{\"code\":\"500\",\"msg\":\"handler produced no response\"}";

    private static string ErrorJson(string code, string msg) {
        if (code == "404" && msg == "not found") { return WebApp.err404; }
        if (code == "500") {
            if (msg == "internal server error") { return WebApp.err500; }
            if (msg == "handler produced no response") { return WebApp.err500noResp; }
        }
        if (code == "401" && msg == "authentication required") { return WebApp.err401; }
        if (code == "403" && msg == "insufficient permission") { return WebApp.err403; }
        if (code == "405" && msg == "method not allowed") { return WebApp.err405; }
        if (code == "429" && msg == "request already in progress") { return WebApp.err429; }
        return "{\"code\":\"" + code + "\",\"msg\":\"" + msg + "\"}";
    }

    string StatusJson() {
        WebAppStatusDoc o = new WebAppStatusDoc();
        o.total_requests = (int)this.totalRequests.Load();
        o.active_connections = (int)this.activeConnections.Load();
        o.routes = this.router.Stats();
        return Json.Serialize<WebAppStatusDoc>(o);
    }

    string MetricsJson() {
        return this.metrics.SnapshotJson();
    }

    // start or stop.
    string MetricsSeriesJson(int seconds) {
        return this.metrics.SeriesJson(seconds);
    }

    // 构造一条完整的 HTTP/1.1 JSON 应答字符串（Connection: close），
    // 用于 HttpContext 尚不存在的早期拒绝（413/431/503、定界失败）。
    private static string SimpleResponse(int code, string text, string msg) {
        StringBuilder sb = HttpBufferPool.Rent();
        sb.Append("{\"code\":\"");
        sb.Append(Convert.ToString(code));
        sb.Append("\",\"msg\":\"");
        sb.Append(msg);
        sb.Append("\"}");
        string body = sb.ToString();
        sb.Clear();
        sb.Append("HTTP/1.1 ");
        sb.Append(Convert.ToString(code));
        sb.Append(" ");
        sb.Append(text);
        sb.Append("\r\nContent-Type: application/json\r\nContent-Length: ");
        sb.Append(Convert.ToString(body.Length));
        sb.Append("\r\nConnection: close\r\n\r\n");
        sb.Append(body);
        string res = sb.ToString();
        HttpBufferPool.Return(sb);
        return res;
    }

    // 报文中头部块的结束位置（"\n\n" 或 "\n\r\n" 之后的首下标）；
    // 没有空行返回 -1。
    private static int FindHeaderEnd(string raw) {
        int n = raw.Length;
        for (int i = 0; i < n; i = i + 1) {
            if ((raw[i] & 255) == 10) {
                // "\n\n"
                if (i + 1 < n && (raw[i + 1] & 255) == 10) { return i + 2; }
                // "\n\r\n"
                if (i + 2 < n && (raw[i + 1] & 255) == 13 && (raw[i + 2] & 255) == 10) { return i + 3; }
            }
        }
        return -1;
    }
}
