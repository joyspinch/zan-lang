using System;
using System.Collections.Generic;
using System.Security.Cryptography;

namespace System.Web;

// CSRF 防护（opt-in）：double-submit cookie。
// 语义：
// - 安全方法（GET/HEAD/OPTIONS）不拦截；首次访问补发随机 token
// cookie（不带 HttpOnly——浏览器脚本必须读它、回显到
// X-CSRF-Token 头或 _csrf 表单字段；SameSite=Lax 保留，本身就是
// 第一道防线）。
// - 不安全方法要求 X-CSRF-Token（或 _csrf 字段）与 cookie 逐字节
// 相等；缺失或不匹配 → 403 并短路（返回 false，路由不再执行）。
// - 比较走常时路径（按最大长度累积异或），不因首个差异字节提前返回。
// - token 无状态（16 随机字节的 hex），重启/多 worker 之间均有效，
// 服务端不需要存储与过期清扫。
// - 豁免：自带签名校验的回调路由用 <see cref="Csrf.Skip"/> 登记前缀。
class Csrf {
    static string CookieName = "csrf_token";
    static string HeaderName = "X-CSRF-Token";
    static string FormName = "_csrf";
    static List<string> skips;

    // 登记豁免前缀：路径以其开头即不拦截。用于支付回调、
    // webhook 等自带签名校验、调用方不可能持有 cookie 的路由。
    static void Skip(string prefix) {
        if (Csrf.skips == null) { Csrf.skips = new List<string>(); }
        Csrf.skips.Add(prefix);
    }

    // 路径是否命中任一豁免前缀。
    static bool Skipped(string path) {
        if (Csrf.skips == null) { return false; }
        int n = Csrf.skips.Count;
        for (int i = 0; i < n; i = i + 1) {
            string p = Csrf.skips[i];
            if (p.Length > 0 && HttpContext.StartsWith(path, p)) { return true; }
        }
        return false;
    }

    // Before 钩子本体。返回 false 表示已写好 403 响应，
    // 管线短路。前哨先做 Origin/Sec-Fetch-Site 站点校验（浏览器自动
    // 附带、免客户端配合），double-submit token 是第二道闸。
    static bool Guard(HttpContext ctx) {
        if (!Csrf.OriginCheck(ctx)) {
            ctx.Status(403, "Forbidden");
            ctx.Text("cross-site request rejected");
            return false;
        }
        bool safe = ctx.method == "GET" || ctx.method == "HEAD"
            || ctx.method == "OPTIONS";
        if (safe) {
            if (ctx.Cookie(Csrf.CookieName).Length == 0) {
                ctx.SetCookieJs(Csrf.CookieName, Csrf.NewToken(), 43200);
            }
            return true;
        }
        if (Csrf.Skipped(ctx.path)) { return true; }
        string cookie = ctx.Cookie(Csrf.CookieName);
        string sent = ctx.Header(Csrf.HeaderName);
        if (sent.Length == 0) { sent = ctx.Form(Csrf.FormName); }
        if (cookie.Length == 0 || sent.Length == 0
            || !Csrf.ConstantTimeEquals(cookie, sent)) {
            ctx.Status(403, "Forbidden");
            ctx.Text("csrf token missing or invalid");
            return false;
        }
        return true;
    }

    // 新 token：16 随机字节的 hex（128 位熵）。
    static string NewToken() {
        return Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
    }

    // 常时比较：按较长一方的长度累积异或，长度不等直接计入差异位，
    // 不因首个差异字节提前返回。
    static bool ConstantTimeEquals(string a, string b) {
        int la = a.Length;
        int lb = b.Length;
        int n = la > lb ? la : lb;
        int diff = la == lb ? 0 : 1;
        for (int i = 0; i < n; i = i + 1) {
            int x = i < la ? a[i] & 255 : 0;
            int y = i < lb ? b[i] & 255 : 0;
            diff = diff | (x ^ y);
        }
        return diff == 0;
    }

    // 站点校验前哨（Before 钩子形态）：不安全方法上依据
    // 浏览器自动附带的证据拒绝跨站请求，无需页面/脚本配合——
    // Sec-Fetch-Site: cross-site 直接拒；带 Origin 头且其 authority
    // 与 Host 不符也拒。两样都缺（老浏览器、非浏览器客户端）放行，
    // 此时 SameSite=Lax 会话 cookie 仍是底线。安全方法一律放行。
    static bool OriginGuard(HttpContext ctx) {
        if (ctx.method == "GET" || ctx.method == "HEAD"
            || ctx.method == "OPTIONS") { return true; }
        if (Csrf.OriginCheck(ctx)) { return true; }
        ctx.Status(403, "Forbidden");
        ctx.Text("cross-site request rejected");
        return false;
    }

    // 前哨的纯校验半口：true 放行，false 跨站（应答由钩子写）。
    static bool OriginCheck(HttpContext ctx) {
        if (ctx.method == "GET" || ctx.method == "HEAD"
            || ctx.method == "OPTIONS") { return true; }
        string site = ctx.Header("Sec-Fetch-Site");
        if (site == "cross-site") { return false; }
        string origin = ctx.Header("Origin");
        if (origin.Length > 0 && !Csrf.SameAuthority(origin,
            ctx.Header("Host"))) { return false; }
        return true;
    }

    // Origin 的 authority（冒号后段，去默认端口、小写）是否与 Host
    // 一致。大小写不敏感按 RFC 3986；Host 缺失视为不一致（保守）。
    static bool SameAuthority(string origin, string host) {
        if (host.Length == 0) { return false; }
        int scheme = origin.IndexOf("://");
        string auth = scheme >= 0 ? origin.Substring(scheme + 3) : origin;
        auth = Csrf.TrimDefaultPort(auth, origin.StartsWith("https://"));
        host = Csrf.TrimDefaultPort(host, false);
        return auth.ToLower() == host.ToLower();
    }

    // 去掉明确的默认端口后缀（https 的 :443 / 明文的 :80）；
    // 其余端口保留参与比较。
    static string TrimDefaultPort(string auth, bool isHttps) {
        if (isHttps && auth.EndsWith(":443")) {
            return auth.Substring(0, auth.Length - 4);
        }
        if (!isHttps && auth.EndsWith(":80")) {
            return auth.Substring(0, auth.Length - 3);
        }
        return auth;
    }
}
