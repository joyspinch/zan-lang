namespace System.Web;

/* GEO 内容源委托：应用层接管内容，协议层只负责协议形状。
   协议层不关心内容从哪来——数据库、配置还是静态对象，都由应用层在每次
   请求时求值后交回协议对象（Sitemap/RobotsTxt/LlmsTxt）；协议层只做
   路由挂载与渲染（XML/文本），状态码与内容类型仍由协议层掌控。

   异步：内容源常要读数据库（已发布文章等），故用 async delegate。
   委托由 WebApp.Use*Source 挂载，与静态对象入口（UseLlmsTxt/UseRobotsTxt/
   UseSitemap）共用同一挂载点——同一路径只挂一次，内容源优先。 */

public async delegate Sitemap SitemapSource();
public async delegate RobotsTxt RobotsSource();
public async delegate LlmsTxt LlmsSource();
