using System;
using System.Collections.Generic;

namespace System.Web;

delegate bool HookFn(HttpContext ctx);

delegate void AfterFn(HttpContext ctx, long elapsedUs);

class Hooks {
    List<HookFn> before;
    List<AfterFn> after;

    Hooks() {
        this.before = new List<HookFn>();
        this.after = new List<AfterFn>();
    }

    // 注册 before 钩子。
    void Before(HookFn fn) { this.before.Add(fn); }
    // 注册 after 钩子。
    void After(AfterFn fn) { this.after.Add(fn); }

    bool RunBefore(HttpContext ctx) {
        for (int i = 0; i < this.before.Count; i = i + 1) {
            HookFn fn = this.before[i];
            if (!fn(ctx)) { return false; }
        }
        return true;
    }

    // 按注册顺序执行全部 after 钩子（不可短路）。
    void RunAfter(HttpContext ctx, long elapsedUs) {
        for (int i = 0; i < this.after.Count; i = i + 1) {
            AfterFn fn = this.after[i];
            fn(ctx, elapsedUs);
        }
    }
}
