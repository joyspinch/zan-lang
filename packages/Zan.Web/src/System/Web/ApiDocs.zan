using System;
using System.Json;

namespace System.Web;

/// <summary>统一 API 异常响应中断：参数缺失或校验失败时抛出标准化错误。</summary>
class ApiError : Exception {
    int status;  // HTTP status to answer with
    /// 业务错误码（"0003" = 缺失或非法参数）。
    string code;  // business code ("0003" = missing/invalid parameter)

    /// 构造受控中止：status 为应答状态码，code 为业务错误码。
    ApiError(int status, string code, string message) {
        Message = message;
        this.status = status;
        this.code = code;
    }

    /// 应答用的 HTTP 状态码。
    int Status() { return this.status; }
    /// 业务错误码。
    string Code() { return this.code; }

    /// <summary>HTTP 状态码标准原因短语（对齐 RFC 协议）。</summary>
    static string Reason(int status) {
        if (status == 400) { return "Bad Request"; }
        if (status == 401) { return "Unauthorized"; }
        if (status == 403) { return "Forbidden"; }
        if (status == 404) { return "Not Found"; }
        if (status == 405) { return "Method Not Allowed"; }
        if (status == 409) { return "Conflict"; }
        if (status == 413) { return "Payload Too Large"; }
        if (status == 422) { return "Unprocessable Entity"; }
        if (status == 429) { return "Too Many Requests"; }
        if (status == 500) { return "Internal Server Error"; }
        if (status == 503) { return "Service Unavailable"; }
        if (status < 400) { return "OK"; }
        return "Error";
    }
}

/// <summary>OpenAPI 接口参数文档元数据描述符。</summary>
class ApiParam {
    string name;
    string type;  // "string" | "int" | "long" | "number" | "bool"
    bool required;
    /// 源码中书写的字面默认值（无默认值时为 ""）。
    string def;  // literal default as written in the source ("" when none)
    /// Need(label, ...) 传入的标签；In() 时为 ""。
    string desc;  // label passed to Need(), or "" for In()
    string source;  // "path" | "query" (query covers form/query/body fields)

    ApiParam(string name, string type, bool required, string def, string desc,
             string source) {
        this.name = name;
        this.type = type;
        this.required = required;
        this.def = def;
        this.desc = desc;
        this.source = source;
    }

    /// 参数名。
    string Name() { return this.name; }
    /// 参数类型（"string" | "int" | "long" | "number" | "bool"）。
    string Type() { return this.type; }
    /// 是否必填。
    bool Required() { return this.required; }
    /// 默认值（无则 ""）。
    string Default() { return this.def; }
    /// 参数说明（Need 的标签）。
    string Desc() { return this.desc; }
    /// 参数来源（"path" | "query"，query 覆盖 form/query/body 字段）。
    string Source() { return this.source; }

    /// <summary>OpenAPI JSON type for this parameter.</summary>
    string JsonType() {
        if (this.type == "int" || this.type == "long") { return "integer"; }
        if (this.type == "number") { return "number"; }
        if (this.type == "bool") { return "boolean"; }
        return "string";
    }
}

/// <summary>内置 API 接口文档生成器：自动导出 OpenAPI 3 规范与离线 Swagger UI。</summary>
class ApiDocs {
    /// Document title shown in the UI and the OpenAPI info block.
    static string title = "API";

    /// <summary>Names the documented service (defaults to "API").</summary>
    static void Title(string name) { ApiDocs.title = name; }

    /// <summary>Registers GET &lt;path&gt; (UI) and &lt;path&gt;.json (OpenAPI).
    /// Both are public: they describe the surface, not the data.</summary>
    static void Mount(WebApp app, string path) {
        string p = path;
        if (p.Length == 0) { p = "/api/docs"; }
        app.Map("GET", p + ".json", ApiDocs.Spec).Named("ApiDocs.Spec")
            .Title("API 文档 (OpenAPI)");
        // The page carries its own menu entry, so mounting the docs is the whole
        // installation: an admin sidebar built from MenuBuilder picks it up.
        app.Map("GET", p, ApiDocs.Page).Named("ApiDocs.Page")
            .Title("API 文档").Menu()
            .Meta("Icon", "mdi:book-open-variant");
    }

    /// 等价 Mount(app, "/api/docs")。
    static void Mount(WebApp app) { ApiDocs.Mount(app, "/api/docs"); }

    /// <summary>Registers only GET &lt;path&gt;.json, for applications that
    /// render the reference themselves (an admin screen, a docs site) and want
    /// the machine-readable document without a second UI in the menu.</summary>
    static void MountSpec(WebApp app, string path) {
        string p = path;
        if (p.Length == 0) { p = "/api/docs"; }
        app.Map("GET", p + ".json", ApiDocs.Spec).Named("ApiDocs.Spec")
            .Title("API 文档 (OpenAPI)");
    }

    /// GET &lt;path&gt;.json 处理器：no-store 输出 OpenAPI 文档。
    static async void Spec(HttpContext ctx) {
        ctx.SetHeader("Cache-Control", "no-store");
        ctx.Json(ApiDocs.SpecJson(WebHost.Current()));
    }

    /// GET &lt;path&gt; 处理器：输出离线 UI 页面。
    static async void Page(HttpContext ctx) {
        ctx.Html(ApiDocs.Html());
    }

    /// <summary>The OpenAPI 3.0 document for every registered route.
    /// 全程 JsonValue 树构建 + ToJson 序列化——标题/描述等文本经
    /// Encoding.JsonEscape 转义，任何路由名/参数名都毁不掉文档结构。</summary>
    static string SpecJson(WebApp host) {
        JsonValue paths = JsonValue.NewObject();

        List<Route> routes = null;
        if (host != null) { routes = host.router.All(); }
        if (routes == null) { routes = new List<Route>(); }

        // Group by path: OpenAPI keys paths, then methods inside them.
        List<string> seen = new List<string>();
        for (int i = 0; i < routes.Count; i++) {
            string pt = routes[i].pattern;
            bool done = false;
            for (int j = 0; j < seen.Count; j++) {
                if (seen[j] == pt) { done = true; }
            }
            if (done) { continue; }
            seen.Add(pt);

            JsonValue ops = JsonValue.NewObject();
            for (int k = 0; k < routes.Count; k++) {
                Route rt = routes[k];
                if (rt.pattern != pt) { continue; }
                ops.Put(rt.method.ToLower(), ApiDocs.Operation(rt));
            }
            paths.Put(ApiDocs.OpenApiPath(pt), ops);
        }

        JsonValue info = JsonValue.NewObject();
        info.PutStr("title", ApiDocs.title);
        info.PutStr("version", "1.0.0");
        JsonValue root = JsonValue.NewObject();
        root.PutStr("openapi", "3.0.3");
        root.Put("info", info);
        root.Put("paths", paths);
        return root.ToJson();
    }

    /// <summary>"/user/{id}" is already OpenAPI's own syntax; this keeps the
    /// conversion in one place in case the router's syntax ever diverges.</summary>
    static string OpenApiPath(string pattern) { return pattern; }

    /// 把一条路由写成一个 OpenAPI operation：summary/operationId/tags、
    /// x-login/x-auth/x-menu 徽标、parameters 与 requestBody（写请求的
    /// 非 path 参数归入表单体）、responses。
    static JsonValue Operation(Route rt) {
        JsonValue op = JsonValue.NewObject();
        string sum = rt.title;
        if (sum.Length == 0) { sum = rt.action; }
        op.PutStr("summary", sum);
        op.PutStr("operationId", rt.action);
        JsonValue tags = JsonValue.NewArray();
        tags.AppendStr(ApiDocs.Tag(rt));
        op.Put("tags", tags);

        // Auth requirements are the dispatcher's, not a hand-written note.
        op.PutBool("x-login", rt.needsLogin);
        op.PutBool("x-auth", rt.needsLogin);
        op.PutBool("x-menu", rt.inMenu);

        List<ApiParam> ps = rt.docParams;
        JsonValue parameters = JsonValue.NewArray();
        bool bodyForm = rt.method != "GET" && rt.method != "HEAD";
        for (int i = 0; i < ps.Count; i++) {
            ApiParam p = ps[i];
            // In a write request the non-path parameters are the form body, and
            // OpenAPI wants those under requestBody rather than parameters.
            if (bodyForm && p.Source() != "path") { continue; }
            parameters.Append(ApiDocs.ParamJson(p));
        }
        op.Put("parameters", parameters);

        if (bodyForm) {
            bool anyBody = false;
            for (int i = 0; i < ps.Count; i++) {
                if (ps[i].Source() != "path") { anyBody = true; }
            }
            if (anyBody) {
                JsonValue properties = JsonValue.NewObject();
                JsonValue required = JsonValue.NewArray();
                for (int i = 0; i < ps.Count; i++) {
                    ApiParam p = ps[i];
                    if (p.Source() == "path") { continue; }
                    JsonValue prop = JsonValue.NewObject();
                    prop.PutStr("type", p.JsonType());
                    if (p.Desc().Length > 0) { prop.PutStr("description", p.Desc()); }
                    if (p.Default().Length > 0) { prop.PutStr("default", p.Default()); }
                    properties.Put(p.Name(), prop);
                    if (p.Required()) { required.AppendStr(p.Name()); }
                }
                JsonValue schema = JsonValue.NewObject();
                schema.PutStr("type", "object");
                schema.Put("properties", properties);
                schema.Put("required", required);
                JsonValue form = JsonValue.NewObject();
                form.Put("schema", schema);
                JsonValue content = JsonValue.NewObject();
                content.Put("application/x-www-form-urlencoded", form);
                JsonValue requestBody = JsonValue.NewObject();
                requestBody.Put("content", content);
                op.Put("requestBody", requestBody);
            }
        }

        op.Put("responses", ApiDocs.Responses(rt));
        return op;
    }

    /// <summary>What the endpoint answers with, per status.
    /// The shapes are the framework's own and therefore knowable: an HTML page,
    /// the {"code","msg","data"} envelope every JSON action writes, or an event
    /// stream. Emitting them here means /api/docs.json describes the response as
    /// precisely as it describes the request, instead of the bare "200 ok" a
    /// generator produces when nobody tells it anything.</summary>
    static JsonValue Responses(Route rt) {
        bool stream = rt.pattern.IndexOf("/stream") >= 0;
        bool json = rt.method != "GET" && rt.method != "HEAD";
        if (rt.pattern.Length >= 5 && rt.pattern.Substring(0, 5) == "/api/") { json = true; }

        JsonValue ok = JsonValue.NewObject();
        if (stream) {
            ok.PutStr("description", "事件流已建立，服务端持续推送");
            JsonValue schema = JsonValue.NewObject();
            schema.PutStr("type", "string");
            JsonValue sse = JsonValue.NewObject();
            sse.Put("schema", schema);
            sse.PutStr("example", "event: metrics\ndata: {\"requests\":{\"count\":128}}\n\n");
            JsonValue content = JsonValue.NewObject();
            content.Put("text/event-stream", sse);
            ok.Put("content", content);
        } else if (json) {
            ok.PutStr("description", "成功");
            JsonValue schemaJson = JsonValue.NewObject();
            schemaJson.Put("schema", ApiDocs.EnvelopeSchema());
            JsonValue example = JsonValue.NewObject();
            example.PutStr("code", "0000");
            example.PutStr("msg", "ok");
            example.PutNull("data");
            schemaJson.Put("example", example);
            JsonValue content = JsonValue.NewObject();
            content.Put("application/json", schemaJson);
            ok.Put("content", content);
        } else {
            ok.PutStr("description", "页面");
            JsonValue schema = JsonValue.NewObject();
            schema.PutStr("type", "string");
            JsonValue html = JsonValue.NewObject();
            html.Put("schema", schema);
            JsonValue content = JsonValue.NewObject();
            content.Put("text/html", html);
            ok.Put("content", content);
        }

        JsonValue responses = JsonValue.NewObject();
        responses.Put("200", ok);
        if (json || stream) {
            responses.Put("400", ApiDocs.ErrorResponse("参数不合法", "0004", "参数不合法"));
        }
        if (rt.needsLogin || rt.needsAuth) {
            responses.Put("401", ApiDocs.ErrorResponse("未登录或登录已过期", "0001", "登录已过期，请重新登录"));
        }
        if (rt.needsLogin || rt.needsAuth) {
            responses.Put("403", ApiDocs.ErrorResponse("没有该操作的权限", "0403", "没有执行该操作的权限"));
        }
        if (json) {
            responses.Put("404", ApiDocs.ErrorResponse("对象不存在", "0404", "对象不存在"));
        }
        return responses;
    }

    /// {"code","msg","data"} 统一信封的 schema。
    static JsonValue EnvelopeSchema() {
        JsonValue code = JsonValue.NewObject();
        code.PutStr("type", "string");
        code.PutStr("description", "0000 表示成功，其余为错误码");
        JsonValue msg = JsonValue.NewObject();
        msg.PutStr("type", "string");
        msg.PutStr("description", "提示文案");
        JsonValue data = JsonValue.NewObject();
        data.PutStr("description", "业务数据，可为 null");
        JsonValue properties = JsonValue.NewObject();
        properties.Put("code", code);
        properties.Put("msg", msg);
        properties.Put("data", data);
        JsonValue schema = JsonValue.NewObject();
        schema.PutStr("type", "object");
        JsonValue required = JsonValue.NewArray();
        required.AppendStr("code");
        required.AppendStr("msg");
        schema.Put("required", required);
        schema.Put("properties", properties);
        return schema;
    }

    /// 一个错误状态响应（信封 schema + 示例）。
    static JsonValue ErrorResponse(string desc, string code, string msg) {
        JsonValue example = JsonValue.NewObject();
        example.PutStr("code", code);
        example.PutStr("msg", msg);
        JsonValue schemaJson = JsonValue.NewObject();
        schemaJson.Put("schema", ApiDocs.EnvelopeSchema());
        schemaJson.Put("example", example);
        JsonValue content = JsonValue.NewObject();
        content.Put("application/json", schemaJson);
        JsonValue resp = JsonValue.NewObject();
        resp.PutStr("description", desc);
        resp.Put("content", content);
        return resp;
    }

    /// 一个 OpenAPI parameter 对象（in 取 path/query）。
    static JsonValue ParamJson(ApiParam p) {
        JsonValue param = JsonValue.NewObject();
        param.PutStr("name", p.Name());
        param.PutStr("in", p.Source());
        param.PutBool("required", p.Required());
        if (p.Desc().Length > 0) { param.PutStr("description", p.Desc()); }
        JsonValue schema = JsonValue.NewObject();
        schema.PutStr("type", p.JsonType());
        if (p.Default().Length > 0) { schema.PutStr("default", p.Default()); }
        param.Put("schema", schema);
        return param;
    }

    /// <summary>Tag = the controller half of "Controller.Action", falling back to
    /// the first path segment, so the UI groups endpoints the way the code is
    /// organised.</summary>
    static string Tag(Route rt) {
        string a = rt.action;
        int dot = a.IndexOf(".");
        if (dot > 0) { return a.Substring(0, dot); }
        List<string> segs = Router.SplitPath(rt.pattern);
        if (segs.Count > 0) { return segs[0]; }
        return "api";
    }

    /// <summary>The offline UI: one page, no CDN, no bundler. It fetches the
    /// spec next door and renders it, because a docs page that needs the network
    /// is useless exactly where docs matter (an air-gapped deployment).</summary>
    static string Html() {
        return ApiDocs.Shell();
    }

    /// 文档页 HTML 外壳（内联 CSS 与 JS，无外部依赖）。
    static string Shell() {
        return "<!doctype html>\n<html lang=\"zh-CN\"><head><meta charset=\"utf-8\">"
            + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
            + "<title>API 文档</title>\n<style>" + ApiDocs.Css() + "</style></head>\n"
            + "<body><header><div class=\"wrap\"><h1>API 文档</h1>"
            + "<p class=\"sub\">由路由属性与动作参数自动生成 · "
            + "<a href=\"docs.json\">OpenAPI JSON</a></p>"
            + "<input id=\"q\" type=\"search\" placeholder=\"搜索路径、标题或参数\" "
            + "autocomplete=\"off\"></div></header>\n"
            + "<main class=\"wrap\" id=\"out\">加载中…</main>\n"
            + "<script>" + ApiDocs.Js() + "</script></body></html>\n";
    }

    /// 内联样式（亮/暗双色，随系统偏好）。
    static string Css() {
        return ":root{--bg:#f5f5f7;--card:#fff;--ink:#1d1d1f;--dim:#6e6e73;"
            + "--line:rgba(0,0,0,.08);--accent:#0071e3}"
            + "@media (prefers-color-scheme:dark){:root{--bg:#000;--card:#1c1c1e;"
            + "--ink:#f5f5f7;--dim:#98989d;--line:rgba(255,255,255,.12);"
            + "--accent:#0a84ff}}"
            + "*{box-sizing:border-box}body{margin:0;background:var(--bg);"
            + "color:var(--ink);font:15px/1.55 -apple-system,BlinkMacSystemFont,"
            + "'SF Pro Text','Helvetica Neue','PingFang SC','Microsoft YaHei',sans-serif}"
            + ".wrap{max-width:960px;margin:0 auto;padding:0 24px}"
            + "header{backdrop-filter:saturate(180%) blur(20px);"
            + "background:color-mix(in srgb,var(--bg) 80%,transparent);"
            + "border-bottom:1px solid var(--line);position:sticky;top:0;z-index:9;"
            + "padding:28px 0 18px}"
            + "h1{margin:0;font-size:28px;letter-spacing:-.02em}"
            + ".sub{margin:6px 0 14px;color:var(--dim);font-size:13px}"
            + ".sub a{color:var(--accent);text-decoration:none}"
            + "#q{width:100%;padding:10px 14px;border-radius:12px;"
            + "border:1px solid var(--line);background:var(--card);color:var(--ink);"
            + "font-size:14px;outline:none}"
            + "#q:focus{border-color:var(--accent)}"
            + "main{padding-bottom:64px}"
            + "h2{font-size:13px;text-transform:uppercase;letter-spacing:.08em;"
            + "color:var(--dim);margin:34px 0 10px}"
            + ".op{background:var(--card);border:1px solid var(--line);"
            + "border-radius:14px;margin:8px 0;overflow:hidden}"
            + ".op>summary{cursor:pointer;padding:13px 16px;display:flex;gap:10px;"
            + "align-items:center;list-style:none}"
            + ".op>summary::-webkit-details-marker{display:none}"
            + ".m{font:600 11px/1 ui-monospace,SFMono-Regular,Menlo,monospace;"
            + "padding:5px 8px;border-radius:7px;color:#fff;letter-spacing:.04em}"
            + ".GET{background:#34c759}.POST{background:#0071e3}"
            + ".PUT{background:#ff9500}.PATCH{background:#af52de}"
            + ".DELETE{background:#ff3b30}.HEAD{background:#8e8e93}"
            + ".OPTIONS{background:#8e8e93}"
            + ".p{font:13px/1 ui-monospace,SFMono-Regular,Menlo,monospace;flex:1;"
            + "overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
            + ".t{color:var(--dim);font-size:13px}"
            + ".badge{font-size:11px;padding:3px 7px;border-radius:6px;"
            + "border:1px solid var(--line);color:var(--dim)}"
            + ".body{padding:0 16px 16px;border-top:1px solid var(--line)}"
            + "table{width:100%;border-collapse:collapse;margin-top:12px;font-size:13px}"
            + "th{text-align:left;color:var(--dim);font-weight:500;padding:6px 8px;"
            + "border-bottom:1px solid var(--line)}"
            + "td{padding:7px 8px;border-bottom:1px solid var(--line);"
            + "vertical-align:top}"
            + "code{font:12px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;"
            + "background:color-mix(in srgb,var(--ink) 7%,transparent);"
            + "padding:2px 5px;border-radius:5px}"
            + ".req{color:#ff3b30}.none{color:var(--dim);padding:12px 0;font-size:13px}";
    }

    /// 内联脚本：fetch docs.json，收集/排序/渲染接口卡片，搜索框即时过滤。
    static string Js() {
        return "const esc=s=>String(s??'').replace(/[&<>\"]/g,"
            + "c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\n"
            + "let ops=[];\n"
            + "function collect(spec){const out=[];"
            + "for(const [path,item] of Object.entries(spec.paths||{})){"
            + "for(const [m,op] of Object.entries(item)){"
            + "const ps=(op.parameters||[]).map(p=>({name:p.name,"
            + "where:p.in,required:!!p.required,desc:p.description||'',"
            + "type:(p.schema||{}).type||'string',def:(p.schema||{}).default}));"
            + "const rb=((((op.requestBody||{}).content||{})"
            + "['application/x-www-form-urlencoded']||{}).schema)||null;"
            + "if(rb){const req=rb.required||[];"
            + "for(const [n,s] of Object.entries(rb.properties||{}))"
            + "ps.push({name:n,where:'form',required:req.includes(n),"
            + "desc:s.description||'',type:s.type||'string',def:s.default});}"
            + "out.push({method:m.toUpperCase(),path,tag:(op.tags||['api'])[0],"
            + "summary:op.summary||'',login:op['x-login'],auth:op['x-auth'],"
            + "menu:op['x-menu'],params:ps});}}"
            + "out.sort((a,b)=>a.tag.localeCompare(b.tag)||a.path.localeCompare(b.path));"
            + "return out;}\n"
            + "function params(ps){if(!ps.length)return"
            + "'<p class=\"none\">无参数</p>';"
            + "return '<table><tr><th>参数</th><th>位置</th><th>类型</th>"
            + "<th>必填</th><th>默认</th><th>说明</th></tr>'+ps.map(p=>"
            + "'<tr><td><code>'+esc(p.name)+'</code></td><td>'+esc(p.where)+"
            + "'</td><td>'+esc(p.type)+'</td><td>'+(p.required?"
            + "'<span class=\"req\">是</span>':'否')+'</td><td>'+"
            + "(p.def!==undefined&&p.def!==''?'<code>'+esc(p.def)+'</code>':'—')+"
            + "'</td><td>'+esc(p.desc)+'</td></tr>').join('')+'</table>';}\n"
            + "function render(list){const out=document.getElementById('out');"
            + "if(!list.length){out.innerHTML='<p class=\"none\">没有匹配的接口</p>';return;}"
            + "let html='',tag=null;"
            + "for(const o of list){if(o.tag!==tag){tag=o.tag;"
            + "html+='<h2>'+esc(tag)+'</h2>';}"
            + "const badges=(o.auth?'<span class=\"badge\">鉴权</span>':"
            + "(o.login?'<span class=\"badge\">登录</span>':''))+"
            + "(o.menu?'<span class=\"badge\">菜单</span>':'');"
            + "html+='<details class=\"op\"><summary><span class=\"m '+o.method+'\">'"
            + "+o.method+'</span><span class=\"p\">'+esc(o.path)+'</span>'+"
            + "'<span class=\"t\">'+esc(o.summary)+'</span>'+badges+'</summary>'+"
            + "'<div class=\"body\">'+params(o.params)+'</div></details>';}"
            + "out.innerHTML=html;}\n"
            + "function filter(){const q=document.getElementById('q').value"
            + ".trim().toLowerCase();"
            + "render(!q?ops:ops.filter(o=>(o.path+' '+o.summary+' '+o.tag+' '+"
            + "o.params.map(p=>p.name).join(' ')).toLowerCase().includes(q)));}\n"
            + "document.getElementById('q').addEventListener('input',filter);\n"
            + "fetch('docs.json').then(r=>r.json()).then(s=>{ops=collect(s);"
            + "render(ops);}).catch(e=>{document.getElementById('out')"
            + ".textContent='加载失败: '+e;});\n";
    }
}
