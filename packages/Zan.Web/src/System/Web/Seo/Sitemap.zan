using System;
using System.Collections.Generic;
using System.Text;

namespace System.Web;

/* Sitemap -- XML 站点地图构建器。 */
public class Sitemap {
    private List<SitemapItem> items;

    public Sitemap() {
        this.items = new List<SitemapItem>();
    }

    public static Sitemap Create() {
        return new Sitemap();
    }

    public Sitemap Add(string loc, string lastMod = "", string changeFreq = "weekly", string priority = "0.8") {
        if (loc != null && loc.Length > 0) {
            this.items.Add(new SitemapItem(
                loc,
                lastMod != null ? lastMod : "",
                changeFreq != null ? changeFreq : "",
                priority != null ? priority : ""));
        }
        return this;
    }

    private static bool NeedsXmlEscapeOrStrip(int b) {
        if (b <= 62 && (b == 38 || b == 60 || b == 62 || b == 34 || b == 39)) { return true; }
        if ((b < 32 && b != 9 && b != 10 && b != 13) || b == 127) { return true; }
        return false;
    }

    public static string XmlEscape(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int len = s.Length;
        int first = -1;
        for (int i = 0; i < len; i = i + 1) {
            if (Sitemap.NeedsXmlEscapeOrStrip(s[i] & 255)) {
                first = i;
                break;
            }
        }
        if (first < 0) { return s; }
        StringBuilder sb = new StringBuilder(len + 16);
        Sitemap.XmlEscapeTail(s, first, sb);
        return sb.ToString();
    }

    internal static void XmlEscapeInto(string s, StringBuilder sb) {
        if (s == null || s.Length == 0) { return; }
        int len = s.Length;
        int first = -1;
        for (int i = 0; i < len; i = i + 1) {
            if (Sitemap.NeedsXmlEscapeOrStrip(s[i] & 255)) {
                first = i;
                break;
            }
        }
        if (first < 0) {
            sb.Append(s);
            return;
        }
        Sitemap.XmlEscapeTail(s, first, sb);
    }

    private static void XmlEscapeTail(string s, int first, StringBuilder sb) {
        int len = s.Length;
        nint sp = (nint)s;
        int start = 0;
        for (int i = first; i < len; i = i + 1) {
            int b = s[i] & 255;
            if (Sitemap.NeedsXmlEscapeOrStrip(b)) {
                if (i > start) { sb.Append(new StringView(sp + (nint)start, i - start)); }
                if (b == 38) { sb.Append("&amp;"); }
                else if (b == 60) { sb.Append("&lt;"); }
                else if (b == 62) { sb.Append("&gt;"); }
                else if (b == 34) { sb.Append("&quot;"); }
                else if (b == 39) { sb.Append("&apos;"); }
                start = i + 1;
            }
        }
        if (len > start) { sb.Append(new StringView(sp + (nint)start, len - start)); }
    }

    /* 渲染为标准 sitemap.xml 格式 */
    public string ToXml() {
        int cnt = this.items.Count;
        StringBuilder sb = new StringBuilder(128 + cnt * 160);
        sb.Append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
        sb.Append("<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n");

        for (int i = 0; i < cnt; i = i + 1) {
            SitemapItem item = this.items[i];
            sb.Append("  <url>\n    <loc>");
            Sitemap.XmlEscapeInto(item.Loc(), sb);
            sb.Append("</loc>\n");
            string lm = item.LastMod();
            if (lm.Length > 0) {
                sb.Append("    <lastmod>");
                Sitemap.XmlEscapeInto(lm, sb);
                sb.Append("</lastmod>\n");
            }
            string cf = item.ChangeFreq();
            if (cf.Length > 0) {
                sb.Append("    <changefreq>");
                Sitemap.XmlEscapeInto(cf, sb);
                sb.Append("</changefreq>\n");
            }
            string pr = item.Priority();
            if (pr.Length > 0) {
                sb.Append("    <priority>");
                Sitemap.XmlEscapeInto(pr, sb);
                sb.Append("</priority>\n");
            }
            sb.Append("  </url>\n");
        }

        sb.Append("</urlset>\n");
        return sb.ToString();
    }
}
