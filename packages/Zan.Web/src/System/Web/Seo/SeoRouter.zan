using System;

namespace System.Web;

// GEO / 搜索引擎优化 (SEO) 路由分发器：
// 统一管理 /.well-known/llms.txt、/llms.txt、/.well-known/llms-full.txt、
// /robots.txt 以及 /sitemap.xml 的协议端点路由挂载与内容协商分发。
public class SeoRouter {

    // 挂载 LLMS 规范文档端点（支持静态对象与动态委托内容源）。
    public static void MountLlms(WebApp app) {
        if (app == null || app.llmsMounted) { return; }
        app.llmsMounted = true;
        app.router.Get("/.well-known/llms.txt", SeoRouter.HandleLlmsTxt);
        app.router.Get("/.well-known/llms-full.txt", SeoRouter.HandleLlmsFullTxt);
        app.router.Get("/llms.txt", SeoRouter.HandleLlmsTxt);
        // 若未定制 robots.txt，自动挂载默认放行 AI 爬虫并声明 llms.txt 的 robots.txt
        if (app.robotsTxt == null && app.robotsSource == null) {
            app.UseRobotsTxt(RobotsTxt.Create());
        }
    }

    // 挂载 robots.txt 爬虫协议端点。
    public static void MountRobots(WebApp app) {
        if (app == null || app.robotsMounted) { return; }
        app.robotsMounted = true;
        app.router.Get("/robots.txt", SeoRouter.HandleRobotsTxt);
    }

    // 挂载 sitemap.xml 站点地图端点。
    public static void MountSitemap(WebApp app) {
        if (app == null || app.sitemapMounted) { return; }
        app.sitemapMounted = true;
        app.router.Get("/sitemap.xml", SeoRouter.HandleSitemapXml);
    }

    // llms.txt 处理器：优先由应用层委托内容源求值，其次回退静态对象。
    public static async void HandleLlmsTxt(HttpContext ctx) {
        WebApp app = WebHost.Current();
        if (app != null) {
            LlmsSource source = app.llmsSource;
            if (source != null) {
                LlmsTxt content = await source();
                if (content != null) {
                    ctx.Markdown(content.ToMarkdown());
                    return;
                }
            }
            if (app.llmsTxt != null) {
                ctx.Markdown(app.llmsTxt.ToMarkdown());
                return;
            }
        }
        ctx.Text("# llms.txt not configured\n");
    }

    // llms-full.txt 处理器：长文本聚合版。
    public static async void HandleLlmsFullTxt(HttpContext ctx) {
        WebApp app = WebHost.Current();
        if (app != null) {
            LlmsSource source = app.llmsSource;
            if (source != null) {
                LlmsTxt content = await source();
                if (content != null) {
                    ctx.Markdown(content.ToFullMarkdown());
                    return;
                }
            }
            if (app.llmsTxt != null) {
                ctx.Markdown(app.llmsTxt.ToFullMarkdown());
                return;
            }
        }
        ctx.Text("# llms-full.txt not configured\n");
    }

    // robots.txt 处理器：优先由应用层委托内容源求值，未配置则默认全站放行。
    public static async void HandleRobotsTxt(HttpContext ctx) {
        WebApp app = WebHost.Current();
        if (app != null) {
            RobotsSource source = app.robotsSource;
            if (source != null) {
                RobotsTxt content = await source();
                if (content != null) {
                    ctx.Text(content.ToText());
                    return;
                }
            }
            if (app.robotsTxt != null) {
                ctx.Text(app.robotsTxt.ToText());
                return;
            }
        }
        ctx.Text("User-agent: *\nAllow: /\n");
    }

    // sitemap.xml 处理器：优先由应用层委托内容源求值，未配置则输出标准空站点地图。
    public static async void HandleSitemapXml(HttpContext ctx) {
        WebApp app = WebHost.Current();
        if (app != null) {
            SitemapSource source = app.sitemapSource;
            if (source != null) {
                Sitemap content = await source();
                if (content != null) {
                    ctx.Xml(content.ToXml());
                    return;
                }
            }
            if (app.sitemap != null) {
                ctx.Xml(app.sitemap.ToXml());
                return;
            }
        }
        ctx.Xml("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"></urlset>\n");
    }
}
