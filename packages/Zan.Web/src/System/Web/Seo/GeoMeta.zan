using System;
using System.Collections.Generic;
using System.Text;

namespace System.Web;

/* GeoMeta -- 管理页面级 GEO 元标签、OpenGraph、Canonical 与引用保护信息。 */
public class GeoMeta {
    private string title;
    private string description;
    private string canonicalUrl;
    private string siteName;
    private string author;
    private string robots;
    private string imageUrl;
    private string ogType;
    private List<GeoSchema> schemas;

    public GeoMeta() {
        this.title = "";
        this.description = "";
        this.canonicalUrl = "";
        this.siteName = "";
        this.author = "";
        this.robots = "index, follow, max-snippet:-1, max-image-preview:large";
        this.imageUrl = "";
        this.ogType = "website";
        this.schemas = new List<GeoSchema>();
    }

    public static GeoMeta Create() {
        return new GeoMeta();
    }

    public string Title() { return this.title; }
    public string Description() { return this.description; }
    public string SiteName() { return this.siteName; }
    public string Author() { return this.author; }
    public string Robots() { return this.robots; }
    public string Image() { return this.imageUrl; }
    public string OgType() { return this.ogType; }
    public List<GeoSchema> Schemas() { return this.schemas; }

    public GeoMeta SetTitle(string t) { this.title = t; return this; }
    public GeoMeta SetDescription(string d) { this.description = d; return this; }
    public GeoMeta SetCanonical(string url) { this.canonicalUrl = url; return this; }
    public string GetCanonical() { return this.canonicalUrl; }
    public GeoMeta SetSiteName(string name) { this.siteName = name; return this; }
    public GeoMeta SetAuthor(string a) { this.author = a; return this; }
    public GeoMeta SetRobots(string r) { this.robots = r; return this; }
    // 社交与大模型引用的封面图（绝对地址）。
    public GeoMeta SetImage(string url) { this.imageUrl = url; return this; }
    // OpenGraph 对象类型（website / article / profile …），默认 website。
    public GeoMeta SetOgType(string t) { this.ogType = t; return this; }

    public GeoMeta AddSchema(GeoSchema s) {
        if (s != null) {
            this.schemas.Add(s);
        }
        return this;
    }

    public static string HtmlEscape(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int len = s.Length;
        int first = -1;
        for (int i = 0; i < len; i = i + 1) {
            int b = s[i] & 255;
            if (b <= 62 && (b == 34 || b == 38 || b == 60 || b == 62)) {
                first = i;
                break;
            }
        }
        if (first < 0) { return s; }
        StringBuilder sb = new StringBuilder(len + 16);
        GeoMeta.HtmlEscapeTail(s, first, sb);
        return sb.ToString();
    }

    internal static void HtmlEscapeInto(string s, StringBuilder sb) {
        if (s == null || s.Length == 0) { return; }
        int len = s.Length;
        int first = -1;
        for (int i = 0; i < len; i = i + 1) {
            int b = s[i] & 255;
            if (b <= 62 && (b == 34 || b == 38 || b == 60 || b == 62)) {
                first = i;
                break;
            }
        }
        if (first < 0) {
            sb.Append(s);
            return;
        }
        GeoMeta.HtmlEscapeTail(s, first, sb);
    }

    private static void HtmlEscapeTail(string s, int first, StringBuilder sb) {
        int len = s.Length;
        nint sp = (nint)s;
        int start = 0;
        for (int i = first; i < len; i = i + 1) {
            int b = s[i] & 255;
            if (b <= 62 && (b == 34 || b == 38 || b == 60 || b == 62)) {
                if (i > start) { sb.Append(new StringView(sp + (nint)start, i - start)); }
                if (b == 34) { sb.Append("&quot;"); }
                else if (b == 38) { sb.Append("&amp;"); }
                else if (b == 60) { sb.Append("&lt;"); }
                else { sb.Append("&gt;"); }
                start = i + 1;
            }
        }
        if (len > start) { sb.Append(new StringView(sp + (nint)start, len - start)); }
    }

    /* 生成包含所有 GEO 元标签与 JSON-LD 的 HTML 片段（注入 <head>） */
    public string RenderHead() {
        int sCount = this.schemas.Count;
        StringBuilder sb = new StringBuilder(1024 + sCount * 384);

        /* Robots 标签：明确授权 AI 爬虫完整文本与大图引用 */
        if (this.robots.Length > 0) {
            sb.Append("<meta name=\"robots\" content=\"");
            GeoMeta.HtmlEscapeInto(this.robots, sb);
            sb.Append("\" />\n");
        }

        /* 描述与作者 */
        if (this.description.Length > 0) {
            sb.Append("<meta name=\"description\" content=\"");
            GeoMeta.HtmlEscapeInto(this.description, sb);
            sb.Append("\" />\n");
        }
        if (this.author.Length > 0) {
            sb.Append("<meta name=\"author\" content=\"");
            GeoMeta.HtmlEscapeInto(this.author, sb);
            sb.Append("\" />\n");
        }

        /* 规范链接（Canonical URL，防止 AI 搜索引擎归因混乱） */
        if (this.canonicalUrl.Length > 0) {
            sb.Append("<link rel=\"canonical\" href=\"");
            GeoMeta.HtmlEscapeInto(this.canonicalUrl, sb);
            sb.Append("\" />\n");
        }

        /* OpenGraph / 社交与大模型引用标签 */
        if (this.title.Length > 0) {
            sb.Append("<meta property=\"og:title\" content=\"");
            GeoMeta.HtmlEscapeInto(this.title, sb);
            sb.Append("\" />\n");
        }
        if (this.description.Length > 0) {
            sb.Append("<meta property=\"og:description\" content=\"");
            GeoMeta.HtmlEscapeInto(this.description, sb);
            sb.Append("\" />\n");
        }
        if (this.canonicalUrl.Length > 0) {
            sb.Append("<meta property=\"og:url\" content=\"");
            GeoMeta.HtmlEscapeInto(this.canonicalUrl, sb);
            sb.Append("\" />\n");
        }
        if (this.siteName.Length > 0) {
            sb.Append("<meta property=\"og:site_name\" content=\"");
            GeoMeta.HtmlEscapeInto(this.siteName, sb);
            sb.Append("\" />\n");
        }
        if (this.imageUrl.Length > 0) {
            sb.Append("<meta property=\"og:image\" content=\"");
            GeoMeta.HtmlEscapeInto(this.imageUrl, sb);
            sb.Append("\" />\n");
        }
        sb.Append("<meta property=\"og:type\" content=\"");
        GeoMeta.HtmlEscapeInto(this.ogType, sb);
        sb.Append("\" />\n");

        /* Twitter 标签 */
        sb.Append("<meta name=\"twitter:card\" content=\"summary\" />\n");
        if (this.title.Length > 0) {
            sb.Append("<meta name=\"twitter:title\" content=\"");
            GeoMeta.HtmlEscapeInto(this.title, sb);
            sb.Append("\" />\n");
        }
        if (this.description.Length > 0) {
            sb.Append("<meta name=\"twitter:description\" content=\"");
            GeoMeta.HtmlEscapeInto(this.description, sb);
            sb.Append("\" />\n");
        }
        if (this.imageUrl.Length > 0) {
            sb.Append("<meta name=\"twitter:image\" content=\"");
            GeoMeta.HtmlEscapeInto(this.imageUrl, sb);
            sb.Append("\" />\n");
        }

        /* 渲染注入每一个 Schema.org JSON-LD 标签（直接流式写入，免中间整串拷贝） */
        for (int i = 0; i < sCount; i = i + 1) {
            this.schemas[i].ToHtmlTagInto(sb);
            sb.Append("\n");
        }

        return sb.ToString();
    }
}
