using System;
using System.Collections.Generic;
using System.Text;

namespace System.Web;

/* GeoMeta -- 管理页面级 GEO 元标签、OpenGraph、Canonical 与引用保护信息。 */
public class GeoMeta {
    public string title;
    public string description;
    public string canonicalUrl;
    public string siteName;
    public string author;
    public string robots;
    public string imageUrl;
    public string ogType;
    public List<GeoSchema> schemas;

    public GeoMeta() {
        this.title = "";
        this.description = "";
        this.canonicalUrl = "";
        this.siteName = "";
        this.author = "";
        this.robots = "index, follow, max-snippet:-1, max-image-preview:large";
        this.imageUrl = "";
        this.ogType = "website";
        this.schemas = new List<GeoSchema>();
    }

    public static GeoMeta Create() {
        return new GeoMeta();
    }

    public GeoMeta SetTitle(string t) { this.title = t; return this; }
    public GeoMeta SetDescription(string d) { this.description = d; return this; }
    public GeoMeta SetCanonical(string url) { this.canonicalUrl = url; return this; }
    public string GetCanonical() { return this.canonicalUrl; }
    public GeoMeta SetSiteName(string name) { this.siteName = name; return this; }
    public GeoMeta SetAuthor(string a) { this.author = a; return this; }
    public GeoMeta SetRobots(string r) { this.robots = r; return this; }
    // 社交与大模型引用的封面图（绝对地址）。
    public GeoMeta SetImage(string url) { this.imageUrl = url; return this; }
    // OpenGraph 对象类型（website / article / profile …），默认 website。
    public GeoMeta SetOgType(string t) { this.ogType = t; return this; }

    public GeoMeta AddSchema(GeoSchema s) {
        if (s != null) {
            this.schemas.Add(s);
        }
        return this;
    }

    public static string HtmlEscape(string s) {
        if (s == null) { return ""; }
        StringBuilder sb = new StringBuilder();
        int len = s.Length;
        for (int i = 0; i < len; i = i + 1) {
            char c = s[i];
            if (c == '"') { sb.Append("&quot;"); }
            else if (c == '&') { sb.Append("&amp;"); }
            else if (c == '<') { sb.Append("&lt;"); }
            else if (c == '>') { sb.Append("&gt;"); }
            else { sb.Append(c); }
        }
        return sb.ToString();
    }

    /* 生成包含所有 GEO 元标签与 JSON-LD 的 HTML 片段（注入 <head>） */
    public string RenderHead() {
        StringBuilder sb = new StringBuilder();

        /* Robots 标签：明确授权 AI 爬虫完整文本与大图引用 */
        if (this.robots.Length > 0) {
            sb.Append("<meta name=\"robots\" content=\"");
            sb.Append(GeoMeta.HtmlEscape(this.robots));
            sb.Append("\" />\n");
        }

        /* 描述与作者 */
        if (this.description.Length > 0) {
            sb.Append("<meta name=\"description\" content=\"");
            sb.Append(GeoMeta.HtmlEscape(this.description));
            sb.Append("\" />\n");
        }
        if (this.author.Length > 0) {
            sb.Append("<meta name=\"author\" content=\"");
            sb.Append(GeoMeta.HtmlEscape(this.author));
            sb.Append("\" />\n");
        }

        /* 规范链接（Canonical URL，防止 AI 搜索引擎归因混乱） */
        if (this.canonicalUrl.Length > 0) {
            sb.Append("<link rel=\"canonical\" href=\"");
            sb.Append(GeoMeta.HtmlEscape(this.canonicalUrl));
            sb.Append("\" />\n");
        }

        /* OpenGraph / 社交与大模型引用标签 */
        if (this.title.Length > 0) {
            sb.Append("<meta property=\"og:title\" content=\"");
            sb.Append(GeoMeta.HtmlEscape(this.title));
            sb.Append("\" />\n");
        }
        if (this.description.Length > 0) {
            sb.Append("<meta property=\"og:description\" content=\"");
            sb.Append(GeoMeta.HtmlEscape(this.description));
            sb.Append("\" />\n");
        }
        if (this.canonicalUrl.Length > 0) {
            sb.Append("<meta property=\"og:url\" content=\"");
            sb.Append(GeoMeta.HtmlEscape(this.canonicalUrl));
            sb.Append("\" />\n");
        }
        if (this.siteName.Length > 0) {
            sb.Append("<meta property=\"og:site_name\" content=\"");
            sb.Append(GeoMeta.HtmlEscape(this.siteName));
            sb.Append("\" />\n");
        }
        if (this.imageUrl.Length > 0) {
            sb.Append("<meta property=\"og:image\" content=\"");
            sb.Append(GeoMeta.HtmlEscape(this.imageUrl));
            sb.Append("\" />\n");
        }
        sb.Append("<meta property=\"og:type\" content=\"");
        sb.Append(GeoMeta.HtmlEscape(this.ogType));
        sb.Append("\" />\n");

        /* Twitter 标签 */
        sb.Append("<meta name=\"twitter:card\" content=\"summary\" />\n");
        if (this.title.Length > 0) {
            sb.Append("<meta name=\"twitter:title\" content=\"");
            sb.Append(GeoMeta.HtmlEscape(this.title));
            sb.Append("\" />\n");
        }
        if (this.description.Length > 0) {
            sb.Append("<meta name=\"twitter:description\" content=\"");
            sb.Append(GeoMeta.HtmlEscape(this.description));
            sb.Append("\" />\n");
        }
        if (this.imageUrl.Length > 0) {
            sb.Append("<meta name=\"twitter:image\" content=\"");
            sb.Append(GeoMeta.HtmlEscape(this.imageUrl));
            sb.Append("\" />\n");
        }

        /* 渲染注入每一个 Schema.org JSON-LD 标签 */
        for (int i = 0; i < this.schemas.Count; i = i + 1) {
            sb.Append(this.schemas[i].ToHtmlTag());
            sb.Append("\n");
        }

        return sb.ToString();
    }
}
