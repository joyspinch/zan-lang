using System;
using System.Collections.Generic;
using System.Text;

namespace System.Web;

/* GeoSchema -- 强类型 Schema.org / JSON-LD 结构化数据构建器，专供 AI 搜索引擎提取实体与事实。 */
public class GeoSchema {
    private string schemaType;
    private List<GeoProp> properties;
    private List<Dictionary<string, string>> items;

    public GeoSchema(string type) {
        this.schemaType = type != null ? type : "";
        this.properties = new List<GeoProp>();
        this.items = new List<Dictionary<string, string>>();
    }

    public string SchemaType() { return this.schemaType; }
    public List<GeoProp> Properties() { return this.properties; }
    public List<Dictionary<string, string>> Items() { return this.items; }

    /* 快速创建通用 Schema 实体 */
    public static GeoSchema Of(string type) {
        return new GeoSchema(type);
    }

    /* 创建文章/技术文档 Schema */
    public static GeoSchema Article(string headline, string description, string author, string datePublished) {
        GeoSchema s = new GeoSchema("TechArticle");
        s.Set("headline", headline);
        s.Set("description", description);
        s.Set("author", author);
        s.Set("datePublished", datePublished);
        return s;
    }

    /* 创建 FAQ 页面 Schema */
    public static GeoSchema FAQ() {
        return new GeoSchema("FAQPage");
    }

    /* 创建产品/系统信息 Schema */
    public static GeoSchema Product(string name, string description, string brand) {
        GeoSchema s = new GeoSchema("Product");
        s.Set("name", name);
        s.Set("description", description);
        s.Set("brand", brand);
        return s;
    }

    /* 创建面包屑导航 Schema */
    public static GeoSchema Breadcrumbs() {
        return new GeoSchema("BreadcrumbList");
    }

    /* 创建机构/站点信息 Schema */
    public static GeoSchema Organization(string name, string url, string description) {
        GeoSchema s = new GeoSchema("Organization");
        s.Set("name", name);
        s.Set("url", url);
        s.Set("description", description);
        return s;
    }

    /* 设置键值属性 */
    public GeoSchema Set(string key, string val) {
        if (key != null && val != null) {
            bool found = false;
            for (int i = 0; i < this.properties.Count; i = i + 1) {
                if (this.properties[i].Key() == key) {
                    this.properties[i].SetVal(val);
                    found = true;
                    break;
                }
            }
            if (!found) {
                this.properties.Add(new GeoProp(key, val));
            }
        }
        return this;
    }

    /* 添加 FAQ 问答对 */
    public GeoSchema AddFAQ(string question, string answer) {
        Dictionary<string, string> qa = new Dictionary<string, string>();
        qa.Add("q", question != null ? question : "");
        qa.Add("a", answer != null ? answer : "");
        this.items.Add(qa);
        return this;
    }

    /* 添加面包屑条目 */
    public GeoSchema AddBreadcrumb(string name, string url) {
        Dictionary<string, string> crumb = new Dictionary<string, string>();
        crumb.Add("name", name != null ? name : "");
        crumb.Add("url", url != null ? url : "");
        this.items.Add(crumb);
        return this;
    }

    private static const string HEX_LOWER = "0123456789abcdef";

    private static bool NeedsJsonEscapeByte(string s, int i, int len) {
        int b = s[i] & 255;
        if (b < 32 || b == 34 || b == 92 || b == 60 || b == 62 || b == 38 || b == 127) {
            return true;
        }
        // U+2028 (E2 80 A8) / U+2029 (E2 80 A9)：阻断 JSON-LD <script> 行分隔符注入
        if (b == 226 && i + 2 < len && (s[i + 1] & 255) == 128) {
            int b2 = s[i + 2] & 255;
            if (b2 == 168 || b2 == 169) { return true; }
        }
        return false;
    }

    /* JSON 字符串安全转义（同时转义 < > &、控制字符及 U+2028/U+2029，阻断 JSON-LD <script> 逃逸 XSS） */
    public static string JsonEscape(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int len = s.Length;
        int first = -1;
        for (int i = 0; i < len; i = i + 1) {
            if (GeoSchema.NeedsJsonEscapeByte(s, i, len)) {
                first = i;
                break;
            }
        }
        if (first < 0) { return s; }
        StringBuilder sb = new StringBuilder(len + 16);
        GeoSchema.JsonEscapeTail(s, first, sb);
        return sb.ToString();
    }

    internal static void JsonEscapeInto(string s, StringBuilder sb) {
        if (s == null || s.Length == 0) { return; }
        int len = s.Length;
        int first = -1;
        for (int i = 0; i < len; i = i + 1) {
            if (GeoSchema.NeedsJsonEscapeByte(s, i, len)) {
                first = i;
                break;
            }
        }
        if (first < 0) {
            sb.Append(s);
            return;
        }
        GeoSchema.JsonEscapeTail(s, first, sb);
    }

    private static void JsonEscapeTail(string s, int first, StringBuilder sb) {
        int len = s.Length;
        int start = 0;
        nint basePtr = (nint)s;
        for (int i = first; i < len; i = i + 1) {
            int b = s[i] & 255;
            if (b < 32 || b == 34 || b == 92 || b == 60 || b == 62 || b == 38 || b == 127) {
                if (i > start) { sb.Append(new StringView(basePtr + (nint)start, i - start)); }
                if (b == 34) { sb.Append("\\\""); }
                else if (b == 92) { sb.Append("\\\\"); }
                else if (b == 10) { sb.Append("\\n"); }
                else if (b == 13) { sb.Append("\\r"); }
                else if (b == 9) { sb.Append("\\t"); }
                else if (b == 8) { sb.Append("\\b"); }
                else if (b == 12) { sb.Append("\\f"); }
                else if (b == 60) { sb.Append("\\u003c"); }
                else if (b == 62) { sb.Append("\\u003e"); }
                else if (b == 38) { sb.Append("\\u0026"); }
                else if (b == 127) { sb.Append("\\u007f"); }
                else {
                    sb.Append("\\u00");
                    sb.Append(GeoSchema.HEX_LOWER[(b >> 4) & 15]);
                    sb.Append(GeoSchema.HEX_LOWER[b & 15]);
                }
                start = i + 1;
            } else if (b == 226 && i + 2 < len && (s[i + 1] & 255) == 128) {
                int b2 = s[i + 2] & 255;
                if (b2 == 168 || b2 == 169) {
                    if (i > start) { sb.Append(new StringView(basePtr + (nint)start, i - start)); }
                    sb.Append(b2 == 168 ? "\\u2028" : "\\u2029");
                    i = i + 2;
                    start = i + 1;
                }
            }
        }
        if (len > start) { sb.Append(new StringView(basePtr + (nint)start, len - start)); }
    }

    private static string SafeDictGet(Dictionary<string, string> dict, string key) {
        if (dict == null) { return ""; }
        string val;
        if (dict.TryGetValue(key, out val) && val != null) { return val; }
        return "";
    }

    internal void ToJsonInto(StringBuilder sb) {
        sb.Append("{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"");
        GeoSchema.JsonEscapeInto(this.schemaType, sb);
        sb.Append("\"");

        /* 渲染主属性 */
        int pCount = this.properties.Count;
        for (int k = 0; k < pCount; k = k + 1) {
            GeoProp prop = this.properties[k];
            if (prop == null) { continue; }
            sb.Append(",\n  \"");
            GeoSchema.JsonEscapeInto(prop.Key(), sb);
            sb.Append("\": \"");
            GeoSchema.JsonEscapeInto(prop.Val(), sb);
            sb.Append("\"");
        }

        /* 针对 FAQPage 渲染 mainEntity 数组 */
        int iCount = this.items.Count;
        if (this.schemaType == "FAQPage" && iCount > 0) {
            sb.Append(",\n  \"mainEntity\": [\n");
            for (int i = 0; i < iCount; i = i + 1) {
                Dictionary<string, string> qa = this.items[i];
                sb.Append("    {\n      \"@type\": \"Question\",\n      \"name\": \"");
                GeoSchema.JsonEscapeInto(GeoSchema.SafeDictGet(qa, "q"), sb);
                sb.Append("\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"");
                GeoSchema.JsonEscapeInto(GeoSchema.SafeDictGet(qa, "a"), sb);
                sb.Append("\"\n      }\n    }");
                if (i < iCount - 1) { sb.Append(","); }
                sb.Append("\n");
            }
            sb.Append("  ]");
        }
        /* 针对 BreadcrumbList 渲染 itemListElement 数组 */
        else if (this.schemaType == "BreadcrumbList" && iCount > 0) {
            sb.Append(",\n  \"itemListElement\": [\n");
            for (int j = 0; j < iCount; j = j + 1) {
                Dictionary<string, string> crumb = this.items[j];
                sb.Append("    {\n      \"@type\": \"ListItem\",\n      \"position\": ");
                sb.Append(j + 1);
                sb.Append(",\n      \"name\": \"");
                GeoSchema.JsonEscapeInto(GeoSchema.SafeDictGet(crumb, "name"), sb);
                sb.Append("\",\n      \"item\": \"");
                GeoSchema.JsonEscapeInto(GeoSchema.SafeDictGet(crumb, "url"), sb);
                sb.Append("\"\n    }");
                if (j < iCount - 1) { sb.Append(","); }
                sb.Append("\n");
            }
            sb.Append("  ]");
        }

        sb.Append("\n}");
    }

    internal void ToHtmlTagInto(StringBuilder sb) {
        sb.Append("<script type=\"application/ld+json\">\n");
        this.ToJsonInto(sb);
        sb.Append("\n</script>");
    }

    /* 序列化为标准 JSON-LD 字符串 */
    public string ToJson() {
        long capL = 128L + (long)this.properties.Count * 64L + (long)this.items.Count * 192L;
        if (capL > 65536L) { capL = 65536L; }
        StringBuilder sb = new StringBuilder((int)capL);
        this.ToJsonInto(sb);
        return sb.ToString();
    }

    /* 渲染为可直接放入 HTML <head> 的 script 标签 */
    public string ToHtmlTag() {
        long capL = 192L + (long)this.properties.Count * 64L + (long)this.items.Count * 192L;
        if (capL > 65536L) { capL = 65536L; }
        StringBuilder sb = new StringBuilder((int)capL);
        this.ToHtmlTagInto(sb);
        return sb.ToString();
    }
}
