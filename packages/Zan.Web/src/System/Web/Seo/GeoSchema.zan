using System;
using System.Collections.Generic;
using System.Text;

namespace System.Web;

/* GeoProp -- Schema 属性键值项，保证有序输出。 */
public class GeoProp {
    public string key;
    public string val;
    public GeoProp(string k, string v) { this.key = k; this.val = v; }
    public string Key() { return this.key; }
    public string Val() { return this.val; }
    public void SetVal(string v) { this.val = v; }
}

/* GeoSchema -- 强类型 Schema.org / JSON-LD 结构化数据构建器，专供 AI 搜索引擎提取实体与事实。 */
public class GeoSchema {
    public string schemaType;
    public List<GeoProp> properties;
    public List<Dictionary<string, string>> items;

    public GeoSchema(string type) {
        this.schemaType = type;
        this.properties = new List<GeoProp>();
        this.items = new List<Dictionary<string, string>>();
    }

    /* 快速创建通用 Schema 实体 */
    public static GeoSchema Of(string type) {
        return new GeoSchema(type);
    }

    /* 创建文章/技术文档 Schema */
    public static GeoSchema Article(string headline, string description, string author, string datePublished) {
        GeoSchema s = new GeoSchema("TechArticle");
        s.Set("headline", headline);
        s.Set("description", description);
        s.Set("author", author);
        s.Set("datePublished", datePublished);
        return s;
    }

    /* 创建 FAQ 页面 Schema */
    public static GeoSchema FAQ() {
        return new GeoSchema("FAQPage");
    }

    /* 创建产品/系统信息 Schema */
    public static GeoSchema Product(string name, string description, string brand) {
        GeoSchema s = new GeoSchema("Product");
        s.Set("name", name);
        s.Set("description", description);
        s.Set("brand", brand);
        return s;
    }

    /* 创建面包屑导航 Schema */
    public static GeoSchema Breadcrumbs() {
        return new GeoSchema("BreadcrumbList");
    }

    /* 创建机构/站点信息 Schema */
    public static GeoSchema Organization(string name, string url, string description) {
        GeoSchema s = new GeoSchema("Organization");
        s.Set("name", name);
        s.Set("url", url);
        s.Set("description", description);
        return s;
    }

    /* 设置键值属性 */
    public GeoSchema Set(string key, string val) {
        if (key != null && val != null) {
            bool found = false;
            for (int i = 0; i < this.properties.Count; i = i + 1) {
                if (this.properties[i].Key() == key) {
                    this.properties[i].SetVal(val);
                    found = true;
                    break;
                }
            }
            if (!found) {
                this.properties.Add(new GeoProp(key, val));
            }
        }
        return this;
    }

    /* 添加 FAQ 问答对 */
    public GeoSchema AddFAQ(string question, string answer) {
        Dictionary<string, string> qa = new Dictionary<string, string>();
        qa.Add("q", question);
        qa.Add("a", answer);
        this.items.Add(qa);
        return this;
    }

    /* 添加面包屑条目 */
    public GeoSchema AddBreadcrumb(string name, string url) {
        Dictionary<string, string> crumb = new Dictionary<string, string>();
        crumb.Add("name", name);
        crumb.Add("url", url);
        this.items.Add(crumb);
        return this;
    }

    /* JSON 字符串安全转义 */
    public static string JsonEscape(string s) {
        if (s == null) { return ""; }
        StringBuilder sb = new StringBuilder();
        int len = s.Length;
        for (int i = 0; i < len; i = i + 1) {
            char c = s[i];
            if (c == '"') { sb.Append("\\\""); }
            else if (c == '\\') { sb.Append("\\\\"); }
            else if (c == '\n') { sb.Append("\\n"); }
            else if (c == '\r') { sb.Append("\\r"); }
            else if (c == '\t') { sb.Append("\\t"); }
            else { sb.Append(c); }
        }
        return sb.ToString();
    }

    /* 序列化为标准 JSON-LD 字符串 */
    public string ToJson() {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\n");
        sb.Append("  \"@context\": \"https://schema.org\",\n");
        sb.Append("  \"@type\": \"");
        sb.Append(GeoSchema.JsonEscape(this.schemaType));
        sb.Append("\"");

        /* 渲染主属性 */
        for (int k = 0; k < this.properties.Count; k = k + 1) {
            GeoProp prop = this.properties[k];
            sb.Append(",\n  \"");
            sb.Append(GeoSchema.JsonEscape(prop.Key()));
            sb.Append("\": \"");
            sb.Append(GeoSchema.JsonEscape(prop.Val()));
            sb.Append("\"");
        }

        /* 针对 FAQPage 渲染 mainEntity 数组 */
        if (this.schemaType == "FAQPage" && this.items.Count > 0) {
            sb.Append(",\n  \"mainEntity\": [\n");
            for (int i = 0; i < this.items.Count; i = i + 1) {
                Dictionary<string, string> qa = this.items[i];
                sb.Append("    {\n");
                sb.Append("      \"@type\": \"Question\",\n");
                sb.Append("      \"name\": \"");
                sb.Append(GeoSchema.JsonEscape(qa["q"]));
                sb.Append("\",\n");
                sb.Append("      \"acceptedAnswer\": {\n");
                sb.Append("        \"@type\": \"Answer\",\n");
                sb.Append("        \"text\": \"");
                sb.Append(GeoSchema.JsonEscape(qa["a"]));
                sb.Append("\"\n");
                sb.Append("      }\n");
                sb.Append("    }");
                if (i < this.items.Count - 1) { sb.Append(","); }
                sb.Append("\n");
            }
            sb.Append("  ]");
        }
        /* 针对 BreadcrumbList 渲染 itemListElement 数组 */
        else if (this.schemaType == "BreadcrumbList" && this.items.Count > 0) {
            sb.Append(",\n  \"itemListElement\": [\n");
            for (int j = 0; j < this.items.Count; j = j + 1) {
                Dictionary<string, string> crumb = this.items[j];
                sb.Append("    {\n");
                sb.Append("      \"@type\": \"ListItem\",\n");
                sb.Append("      \"position\": ");
                sb.Append(j + 1);
                sb.Append(",\n");
                sb.Append("      \"name\": \"");
                sb.Append(GeoSchema.JsonEscape(crumb["name"]));
                sb.Append("\",\n");
                sb.Append("      \"item\": \"");
                sb.Append(GeoSchema.JsonEscape(crumb["url"]));
                sb.Append("\"\n");
                sb.Append("    }");
                if (j < this.items.Count - 1) { sb.Append(","); }
                sb.Append("\n");
            }
            sb.Append("  ]");
        }

        sb.Append("\n}");
        return sb.ToString();
    }

    /* 渲染为可直接放入 HTML <head> 的 script 标签 */
    public string ToHtmlTag() {
        StringBuilder sb = new StringBuilder();
        sb.Append("<script type=\"application/ld+json\">\n");
        sb.Append(this.ToJson());
        sb.Append("\n</script>");
        return sb.ToString();
    }
}
