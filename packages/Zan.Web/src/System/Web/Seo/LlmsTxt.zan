using System;
using System.Collections.Generic;
using System.Text;

namespace System.Web;

/* LlmsTxt -- 专为生成式 AI 搜索引擎和 LLM 爬虫自动构建标准的 llms.txt 与 llms-full.txt。 */
public class LlmsTxt {
    private string title;
    private string summary;
    private string details;
    private List<LlmsSection> sections;

    public LlmsTxt(string t, string s) {
        this.title = t;
        this.summary = s;
        this.details = "";
        this.sections = new List<LlmsSection>();
    }

    public static LlmsTxt Create(string title, string summary) {
        return new LlmsTxt(title, summary);
    }

    public LlmsTxt SetDetails(string d) {
        this.details = d;
        return this;
    }

    /* 添加分节与链接 */
    public LlmsTxt AddLink(string sectionName, string title, string url, string desc) {
        return this.AddFullLink(sectionName, title, url, desc, "");
    }

    public LlmsTxt AddFullLink(string sectionName, string title, string url, string desc, string fullContent) {
        LlmsSection sec = null;
        for (int i = 0; i < this.sections.Count; i = i + 1) {
            if (this.sections[i].Name() == sectionName) {
                sec = this.sections[i];
                break;
            }
        }
        if (sec == null) {
            sec = new LlmsSection(sectionName);
            this.sections.Add(sec);
        }
        sec.Add(title, url, desc, fullContent);
        return this;
    }

    /* 生成规范的 llms.txt Markdown 文本 */
    public string ToMarkdown() {
        StringBuilder sb = new StringBuilder();
        sb.Append("# ");
        sb.Append(this.title);
        sb.Append("\n\n");

        if (this.summary.Length > 0) {
            sb.Append("> ");
            sb.Append(this.summary);
            sb.Append("\n\n");
        }

        if (this.details.Length > 0) {
            sb.Append(this.details);
            sb.Append("\n\n");
        }

        for (int i = 0; i < this.sections.Count; i = i + 1) {
            LlmsSection sec = this.sections[i];
            sb.Append("## ");
            sb.Append(sec.Name());
            sb.Append("\n\n");

            List<LlmsLink> links = sec.Links();
            for (int j = 0; j < links.Count; j = j + 1) {
                LlmsLink link = links[j];
                sb.Append("- [");
                sb.Append(link.Title());
                sb.Append("](");
                sb.Append(link.Url());
                sb.Append(")");
                if (link.Description().Length > 0) {
                    sb.Append(": ");
                    sb.Append(link.Description());
                }
                sb.Append("\n");
            }
            sb.Append("\n");
        }

        return sb.ToString();
    }

    /* 生成聚合长文本 llms-full.txt，便于 AI 引擎单次抓取完整上下文 */
    public string ToFullMarkdown() {
        StringBuilder sb = new StringBuilder();
        sb.Append(this.ToMarkdown());
        sb.Append("\n---\n\n");

        for (int i = 0; i < this.sections.Count; i = i + 1) {
            LlmsSection sec = this.sections[i];
            List<LlmsLink> links = sec.Links();
            for (int j = 0; j < links.Count; j = j + 1) {
                LlmsLink link = links[j];
                if (link.FullContent().Length > 0) {
                    sb.Append("### ");
                    sb.Append(link.Title());
                    sb.Append("\n\nURL: ");
                    sb.Append(link.Url());
                    sb.Append("\n\n");
                    sb.Append(link.FullContent());
                    sb.Append("\n\n---\n\n");
                }
            }
        }

        return sb.ToString();
    }
}
