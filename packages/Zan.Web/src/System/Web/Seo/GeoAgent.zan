using System;

namespace System.Web;

/* GeoAgent -- 识别生成式 AI 搜索引擎爬虫与大模型请求，支持智能内容协商。 */
public class GeoAgent {
    /* 已知主流 AI 搜索与大模型爬虫标识（全部以小写比对）。 */
    private static string[] aiBotSignatures = new string[] {
        "gptbot",
        "chatgpt-user",
        "chatgpt",
        "perplexitybot",
        "perplexity",
        "claudebot",
        "claude-web",
        "anthropic-ai",
        "google-extended",
        "googleother",
        "bytespider",
        "applebot-extended",
        "cohere-ai",
        "diffbot",
        "omgilibot",
        "ccbot",
        "facebookbot",
        "amazonbot",
        "meta-externalagent"
    };

    /* 获取受支持的已知 AI 爬虫标识列表（返回防御性副本，防外部篡改静态表）。 */
    public static string[] BotSignatures() {
        int n = GeoAgent.aiBotSignatures.Length;
        string[] copy = new string[n];
        for (int i = 0; i < n; i = i + 1) {
            copy[i] = GeoAgent.aiBotSignatures[i];
        }
        return copy;
    }

    private static bool MatchLowerTail(string s, int pos, string lowerPat) {
        int m = lowerPat.Length;
        for (int k = 2; k < m; k = k + 1) {
            int a = s[pos + k] & 255;
            if (a >= 65 && a <= 90) { a = a + 32; }
            if (a != (lowerPat[k] & 255)) { return false; }
        }
        return true;
    }

    /* 判断 User-Agent 是否命中已知生成式 AI 引擎爬虫（零分配单遍位掩码调度，替代 ToLower + 19 次 Contains）。 */
    public static bool IsAiBot(string userAgent) {
        if (userAgent == null) { return false; }
        int n = userAgent.Length;
        if (n < 5) { return false; }
        // 17 条非冗余签名（chatgpt 覆盖 chatgpt-user，perplexity 覆盖 perplexitybot）首字母掩码：
        // a(0) b(1) c(2) d(3) f(5) g(6) m(12) o(14) p(15) => 0xD06F = 53359
        int limit = n - 5;
        for (int i = 0; i <= limit; i = i + 1) {
            int c0 = (userAgent[i] & 255) | 32;
            int idx = c0 - 97;
            if (idx < 0 || idx > 15 || ((53359 >> idx) & 1) == 0) { continue; }
            int rem = n - i;
            int c1 = (userAgent[i + 1] & 255) | 32;
            if (c0 == 99) {  // 'c'
                if (c1 == 99) {
                    if (GeoAgent.MatchLowerTail(userAgent, i, "ccbot")) { return true; }
                } else if (c1 == 104) {
                    if (rem >= 7 && GeoAgent.MatchLowerTail(userAgent, i, "chatgpt")) { return true; }
                } else if (c1 == 108) {
                    if (rem >= 9 && GeoAgent.MatchLowerTail(userAgent, i, "claudebot")) { return true; }
                    if (rem >= 10 && GeoAgent.MatchLowerTail(userAgent, i, "claude-web")) { return true; }
                } else if (c1 == 111) {
                    if (rem >= 9 && GeoAgent.MatchLowerTail(userAgent, i, "cohere-ai")) { return true; }
                }
            } else if (c0 == 103) {  // 'g'
                if (c1 == 112) {
                    if (rem >= 6 && GeoAgent.MatchLowerTail(userAgent, i, "gptbot")) { return true; }
                } else if (c1 == 111) {
                    if (rem >= 11 && GeoAgent.MatchLowerTail(userAgent, i, "googleother")) { return true; }
                    if (rem >= 15 && GeoAgent.MatchLowerTail(userAgent, i, "google-extended")) { return true; }
                }
            } else if (c0 == 97) {  // 'a'
                if (c1 == 109) {
                    if (rem >= 9 && GeoAgent.MatchLowerTail(userAgent, i, "amazonbot")) { return true; }
                } else if (c1 == 110) {
                    if (rem >= 12 && GeoAgent.MatchLowerTail(userAgent, i, "anthropic-ai")) { return true; }
                } else if (c1 == 112) {
                    if (rem >= 17 && GeoAgent.MatchLowerTail(userAgent, i, "applebot-extended")) { return true; }
                }
            } else if (c0 == 98) {  // 'b'
                if (c1 == 121 && rem >= 10 && GeoAgent.MatchLowerTail(userAgent, i, "bytespider")) { return true; }
            } else if (c0 == 100) {  // 'd'
                if (c1 == 105 && rem >= 7 && GeoAgent.MatchLowerTail(userAgent, i, "diffbot")) { return true; }
            } else if (c0 == 102) {  // 'f'
                if (c1 == 97 && rem >= 11 && GeoAgent.MatchLowerTail(userAgent, i, "facebookbot")) { return true; }
            } else if (c0 == 109) {  // 'm'
                if (c1 == 101 && rem >= 18 && GeoAgent.MatchLowerTail(userAgent, i, "meta-externalagent")) { return true; }
            } else if (c0 == 111) {  // 'o'
                if (c1 == 109 && rem >= 9 && GeoAgent.MatchLowerTail(userAgent, i, "omgilibot")) { return true; }
            } else {  // 'p'
                if (c1 == 101 && rem >= 10 && GeoAgent.MatchLowerTail(userAgent, i, "perplexity")) { return true; }
            }
        }
        return false;
    }

    /* 内容协商判断：客户端是否期望接收 Markdown 或由 AI 引擎消费。 */
    public static bool WantsMarkdown(HttpContext ctx) {
        if (ctx == null) { return false; }

        /* 1. 显式查询参数或路径覆盖：?format=md 或 ?format=markdown */
        string fmt = ctx.Query("format");
        if (fmt == "md" || fmt == "markdown") { return true; }

        /* 2. 检查 Accept 请求头是否优先请求 markdown */
        string accept = ctx.Header("Accept");
        if (accept == null) { accept = ""; }
        if (accept.Length > 0) {
            if (accept.Contains("text/markdown")) { return true; }
        }

        /* 3. 检查 User-Agent 是否为 AI 爬虫 */
        string ua = ctx.Header("User-Agent");
        if (GeoAgent.IsAiBot(ua)) {
            /* 如果没有特意指定必须只要 text/html，则对 AI 爬虫默认开启 Markdown 降级 */
            if (accept.Length == 0 || !accept.Contains("text/html") || accept.Contains("*/*")) {
                return true;
            }
        }

        return false;
    }
}
