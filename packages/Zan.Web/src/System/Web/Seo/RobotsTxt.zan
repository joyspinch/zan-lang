using System;
using System.Collections.Generic;
using System.Text;

namespace System.Web;

/* RobotsTxt -- 面向 AI 爬虫友好授权与站点索引声明的 robots.txt 构建器。 */
public class RobotsTxt {
    public List<string> disallows;
    public List<string> allows;
    public string sitemapUrl;
    public string llmsTxtUrl;

    public RobotsTxt() {
        this.disallows = new List<string>();
        this.allows = new List<string>();
        this.sitemapUrl = "/sitemap.xml";
        this.llmsTxtUrl = "/.well-known/llms.txt";
    }

    public static RobotsTxt Create() {
        return new RobotsTxt();
    }

    public RobotsTxt Disallow(string path) {
        if (path != null && path.Length > 0) {
            this.disallows.Add(path);
        }
        return this;
    }

    public RobotsTxt Allow(string path) {
        if (path != null && path.Length > 0) {
            this.allows.Add(path);
        }
        return this;
    }

    public RobotsTxt SetSitemap(string url) {
        this.sitemapUrl = url;
        return this;
    }

    public RobotsTxt SetLlmsTxt(string url) {
        this.llmsTxtUrl = url;
        return this;
    }

    /* 生成规范的 robots.txt 纯文本 */
    public string ToText() {
        StringBuilder sb = new StringBuilder();

        /* 通用蜘蛛规则 */
        sb.Append("User-agent: *\n");
        for (int i = 0; i < this.allows.Count; i = i + 1) {
            sb.Append("Allow: ");
            sb.Append(this.allows[i]);
            sb.Append("\n");
        }
        for (int j = 0; j < this.disallows.Count; j = j + 1) {
            sb.Append("Disallow: ");
            sb.Append(this.disallows[j]);
            sb.Append("\n");
        }
        if (this.allows.Count == 0 && this.disallows.Count == 0) {
            sb.Append("Allow: /\n");
        }

        /* 针对主流 AI 搜索引擎蜘蛛显式明确授权放行 */
        string[] aiBots = new string[] { "GPTBot", "PerplexityBot", "ClaudeBot", "Google-Extended", "Bytespider" };
        for (int k = 0; k < aiBots.Length; k = k + 1) {
            sb.Append("\nUser-agent: ");
            sb.Append(aiBots[k]);
            sb.Append("\nAllow: /\n");
        }

        /* 声明 AI 大模型全站索引与传统 Sitemap */
        if (this.llmsTxtUrl.Length > 0) {
            sb.Append("\n# LLM Knowledge Hub\nllms.txt: ");
            sb.Append(this.llmsTxtUrl);
            sb.Append("\n");
        }
        if (this.sitemapUrl.Length > 0) {
            sb.Append("Sitemap: ");
            sb.Append(this.sitemapUrl);
            sb.Append("\n");
        }

        return sb.ToString();
    }
}
