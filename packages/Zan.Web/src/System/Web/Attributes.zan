using System;

namespace System.Web;

// 接口数据协议与执行契约。
class Attribute { }

// 接口数据协议与执行契约。
class RouteAttribute : Attribute {
    string template;
    RouteAttribute(string template) { this.template = template; }
}

// 接口数据协议与执行契约。
class HttpGetAttribute : Attribute { }
// 核心契约与语义定义。
class HttpPostAttribute : Attribute { }
// 核心契约与语义定义。
class HttpPutAttribute : Attribute { }
// 核心契约与语义定义。
class HttpDeleteAttribute : Attribute { }
// 核心契约与语义定义。
class HttpPatchAttribute : Attribute { }

// 接口数据协议与执行契约。
class DescriptionAttribute : Attribute {
    string text;
    DescriptionAttribute(string text) { this.text = text; }
}

// 接口数据协议与执行契约。
class NonActionAttribute : Attribute { }

// 接口数据协议与执行契约。
class ReadOnlyAttribute : Attribute { }

// 接口数据协议与执行契约。
// 核心契约与语义定义。
enum CustomAuthorization {
    Unknown,   // 未声明：默认按 Login 强制登录处理（安全基线，fail-closed）
    None,      // 不检测登录：完全公开（如登录页、公开静态/落地页、健康检查）
    Auth,      // 只检测登录：不强制，登录了就能拿到当前用户（如博客前台）
    Login,     // 强制登录：未登录跳登录页 / 401，但不查权限
    Grant,     // 强制登录 + 该路由 action 的授权（后台页面/接口）
    ApiAuth    // 同 Grant，用于以 token 调用的接口
}

// 接口数据协议与执行契约。
enum PermBit {
    Unknown = 0,
    View    = 1,
    Create  = 2,
    Update  = 4,
    Delete  = 8,
    Export  = 16,
    Import  = 32,
    Audit   = 64,
    Publish = 128
}

// 接口数据协议与执行契约。
enum ContentTypes {
    TextPlain,
    TextHtml,
    TextXml,
    ApplicationJson,
    ApplicationXml,
    ApplicationPdf,
    ApplicationZip,
    ApplicationGzip,
    ApplicationOctetStream
}

// 接口数据协议与执行契约。
// 核心契约与语义定义。
// 接口数据协议与执行契约。
// 核心契约与执行状态转移规范。
class CustomAttribute : Attribute {
    // 接口数据协议与执行契约。
    // 核心契约与执行状态转移规范。
    bool IsMenu { get; set; } = false;
    // 鉴权级别；未赋值即 Unknown（按 None 处理）。
    CustomAuthorization Authorization { get; set; }
    // 前端组件名（构造默认 "vlist/index.vue"）。
    string Component { get; set; }
    // 菜单图标（构造默认 "mdi:antenna"）。
    string Icon { get; set; }
    // 每秒限流上限（默认 1000）。
    int ApiMax { get; set; } = 1000;
    // 响应内容类型（默认 ApplicationJson）。
    ContentTypes ContentType { get; set; } = ContentTypes.ApplicationJson;
    // 请求锁维度："" 无 | "user" | "global"（同 Route.Lock）。
    string Lock { get; set; } = "";
    // 请求体流式落盘（同 Route.Upload）。
    bool Upload { get; set; } = false;
    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    PermBit Perm { get; set; } = PermBit.Unknown;

    CustomAttribute(
        CustomAuthorization customAuthorization = CustomAuthorization.None,
        bool customMenu = false,
        string component = "vlist/index.vue",
        string icon = "mdi:antenna",
        int apiMax = 1000,
        ContentTypes contentType = ContentTypes.ApplicationJson) {
        this.IsMenu = customMenu;
        this.Authorization = customAuthorization;
        this.Component = component;
        this.Icon = icon;
        this.ApiMax = apiMax;
        this.ContentType = contentType;
    }
}
