using System;
using System.Collections.Generic;
using System.Text;

namespace System.Web;

/* SitemapItem -- 站点地图条目。 */
class SitemapItem {
    string loc;
    string lastMod;
    string changeFreq;
    string priority;

    SitemapItem(string l, string lm, string cf, string p) {
        this.loc = l;
        this.lastMod = lm;
        this.changeFreq = cf;
        this.priority = p;
    }

    string Loc() { return this.loc; }
    string LastMod() { return this.lastMod; }
    string ChangeFreq() { return this.changeFreq; }
    string Priority() { return this.priority; }
}

/* Sitemap -- XML 站点地图构建器。 */
class Sitemap {
    List<SitemapItem> items;

    Sitemap() {
        this.items = new List<SitemapItem>();
    }

    static Sitemap Create() {
        return new Sitemap();
    }

    Sitemap Add(string loc, string lastMod = "", string changeFreq = "weekly", string priority = "0.8") {
        if (loc != null && loc.Length > 0) {
            this.items.Add(new SitemapItem(loc, lastMod, changeFreq, priority));
        }
        return this;
    }

    static string XmlEscape(string s) {
        if (s == null) { return ""; }
        StringBuilder sb = new StringBuilder();
        int len = s.Length;
        for (int i = 0; i < len; i = i + 1) {
            char c = s[i];
            if (c == '&') { sb.Append("&amp;"); }
            else if (c == '<') { sb.Append("&lt;"); }
            else if (c == '>') { sb.Append("&gt;"); }
            else if (c == '"') { sb.Append("&quot;"); }
            else if (c == '\'') { sb.Append("&apos;"); }
            else { sb.Append(c); }
        }
        return sb.ToString();
    }

    /* 渲染为标准 sitemap.xml 格式 */
    string ToXml() {
        StringBuilder sb = new StringBuilder();
        sb.Append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
        sb.Append("<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n");

        for (int i = 0; i < this.items.Count; i = i + 1) {
            SitemapItem item = this.items[i];
            sb.Append("  <url>\n");
            sb.Append("    <loc>");
            sb.Append(Sitemap.XmlEscape(item.Loc()));
            sb.Append("</loc>\n");
            if (item.LastMod().Length > 0) {
                sb.Append("    <lastmod>");
                sb.Append(Sitemap.XmlEscape(item.LastMod()));
                sb.Append("</lastmod>\n");
            }
            if (item.ChangeFreq().Length > 0) {
                sb.Append("    <changefreq>");
                sb.Append(Sitemap.XmlEscape(item.ChangeFreq()));
                sb.Append("</changefreq>\n");
            }
            if (item.Priority().Length > 0) {
                sb.Append("    <priority>");
                sb.Append(Sitemap.XmlEscape(item.Priority()));
                sb.Append("</priority>\n");
            }
            sb.Append("  </url>\n");
        }

        sb.Append("</urlset>\n");
        return sb.ToString();
    }
}
