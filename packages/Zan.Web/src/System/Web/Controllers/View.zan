using System;
using System.IO;

namespace System.Web;

// (for {{#each}} blocks).
// 具名行集合：一个 {{#each}} 列表的数据源。
public class View {
    private static const int MaxTemplateDepth = 64;
    private static const int MaxDirDepth = 32;
    private Dictionary<string, List<VNode>> compiled;  // name -> parsed template
    private string dir;
    private bool devReload;  // dev only: re-read templates on each render

    public View() {
        this.compiled = new Dictionary<string, List<VNode>>();
        this.dir = "";
        this.devReload = false;
    }

    public string Dir() { return this.dir; }
    public void SetDevReload(bool reload) { this.devReload = reload; }
    public bool DevReload() { return this.devReload; }

    // 递归加载视图目录下所有 .html 模板至内存字典中缓存。
    public static View LoadDir(string dir) {
        View v = new View();
        v.dir = dir != null ? dir : "";
        v.LoadAll();
        return v;
    }

    // 清缓存并重读视图目录下全部模板（devReload 打开时每次渲染前调用）。
    // 先构建新字典再原子切换，避免并发渲染读到半加载字典。
    public void LoadAll() {
        Dictionary<string, List<VNode>> next = new Dictionary<string, List<VNode>>();
        this.LoadRecInto(next, this.dir, "", 0);
        lock (this) {
            this.compiled = next;
        }
    }

    // Copy-on-write 替换整个字典，保证并发 Render/RenderPage 在锁外读快照绝不产生字典读写竞争。
    public void Put(string key, string body) {
        if (key == null) { return; }
        List<VNode> nodes = View.Compile(body);
        lock (this) {
            Dictionary<string, List<VNode>> next = new Dictionary<string, List<VNode>>();
            List<string> existingKeys = this.compiled.Keys;
            for (int i = 0; i < existingKeys.Count; i = i + 1) {
                string k = existingKeys[i];
                next.Add(k, this.compiled[k]);
            }
            if (next.ContainsKey(key)) {
                next[key] = nodes;
            } else {
                next.Add(key, nodes);
            }
            this.compiled = next;
        }
    }

    private static void PutInto(Dictionary<string, List<VNode>> map, string key, string body) {
        List<VNode> nodes = View.Compile(body);
        if (map.ContainsKey(key)) {
            map[key] = nodes;
        } else {
            map.Add(key, nodes);
        }
    }

    private void LoadRecInto(Dictionary<string, List<VNode>> map, string d, string prefix, int depth) {
        if (depth >= View.MaxDirDepth || d == null || d.Length == 0 || !Directory.Exists(d)) { return; }
        List<string> files = Directory.GetFileNames(d);
        for (int i = 0; i < files.Count; i = i + 1) {
            string fn = files[i];
            if (fn.Length > 5 && fn.Substring(fn.Length - 5, 5) == ".html") {
                string stem = fn.Substring(0, fn.Length - 5);
                string body = File.ReadAllText(d + "/" + fn);
                View.PutInto(map, prefix + stem, body);
                if (stem == "layout" && prefix.Length == 0) { View.PutInto(map, "layout", body); }
            }
        }
        List<string> dirs = Directory.GetDirectories(d);
        for (int j = 0; j < dirs.Count; j = j + 1) {
            string sub = dirs[j];
            if (sub == "View") {
                this.LoadRecInto(map, d + "/" + sub, prefix, depth + 1);
            } else {
                this.LoadRecInto(map, d + "/" + sub, prefix + sub + ".", depth + 1);
            }
        }
    }

    private static string SafeMissingComment(string name) {
        string escaped = View.HtmlEscape(name != null ? name : "");
        return "<!-- view not found: " + escaped.Replace("--", "- -") + " -->";
    }

    public string Render(string name, ViewData data) {
        if (this.devReload) { this.LoadAll(); }
        Dictionary<string, List<VNode>> map;
        lock (this) { map = this.compiled; }
        List<VNode> nodes = null;
        if (name == null || !map.TryGetValue(name, out nodes)) {
            return View.SafeMissingComment(name);
        }
        StringBuilder sb = new StringBuilder(256);
        View.Emit(nodes, data, null, null, sb);
        return sb.ToString();
    }

    public string RenderPage(string name, ViewData data) {
        if (this.devReload) { this.LoadAll(); }
        Dictionary<string, List<VNode>> map;
        lock (this) { map = this.compiled; }
        List<VNode> page = null;
        if (name == null || !map.TryGetValue(name, out page)) {
            // 禁止将缺失视图名送入 View.Compile，杜绝模板注入（SSTI）与注释逃逸（XSS）。
            page = new List<VNode>();
            page.Add(new VNode(VNodeKind.Literal, View.SafeMissingComment(name)));
        }
        string layoutKey = "layout";
        int dot = name != null ? name.IndexOf(".") : -1;
        if (dot > 0) {
            string modLayout = name.Substring(0, dot) + ".layout";
            if (map.ContainsKey(modLayout)) { layoutKey = modLayout; }
        }
        StringBuilder sb = new StringBuilder(512);
        List<VNode> layout = null;
        if (!map.TryGetValue(layoutKey, out layout)) {
            View.Emit(page, data, null, null, sb);
            return sb.ToString();
        }
        View.Emit(layout, data, null, page, sb);
        return sb.ToString();
    }

    public static string RenderStr(string tpl, ViewData data, StrMap row) {
        if (tpl == null || tpl.Length == 0) { return ""; }
        // 扁平字节码直编译+直渲染：零 VNode 堆对象、零字面量 Substring 拷贝（全走 StringView）。
        List<int> ops = new List<int>();
        List<int> argA = new List<int>();
        List<int> argB = new List<int>();
        List<string> keys = new List<string>();
        int[] state = new int[2];
        state[0] = 0;
        state[1] = 0;
        View.CompileFlat(tpl, tpl.Length, state, 0, ops, argA, argB, keys, 0);
        StringBuilder sb = new StringBuilder(tpl.Length + 128);
        StrMap vars = data != null ? data.Vars() : null;
        View.ExecFlat(tpl, (nint)tpl, ops, argA, argB, keys, 0, ops.Count, data, vars, row, sb, 0);
        return sb.ToString();
    }

    // 扁平指令集：0=Lit(a=start,b=len), 1=EscVar(key), 2=RawVar(key),
    // 3=If(key, a=elsePc or endPc, b=endPc), 4=Each(key, a=endPc), 5=ContentSlot。
    private static void CompileFlat(string tpl, int n, int[] state, int mode,
                                    List<int> ops, List<int> argA, List<int> argB, List<string> keys,
                                    int depth) {
        if (depth >= View.MaxTemplateDepth) {
            state[0] = n;
            state[1] = 0;
            return;
        }
        int i = state[0];
        while (i < n) {
            int open = tpl.IndexOf("{{", i);
            if (open < 0) {
                ops.Add(0); argA.Add(i); argB.Add(n - i); keys.Add("");
                state[0] = n;
                state[1] = 0;
                return;
            }
            if (open > i) {
                ops.Add(0); argA.Add(i); argB.Add(open - i); keys.Add("");
            }
            if (open + 2 < n && (tpl[open + 2] & 255) == 123) {
                int close = tpl.IndexOf("}}}", open + 3);
                if (close < 0) {
                    state[0] = n;
                    state[1] = 0;
                    return;
                }
                ops.Add(2); argA.Add(0); argB.Add(0); keys.Add(View.TrimSlice(tpl, open + 3, close));
                i = close + 3;
                continue;
            }
            int close2 = tpl.IndexOf("}}", open + 2);
            if (close2 < 0) {
                state[0] = n;
                state[1] = 0;
                return;
            }
            int rawStart = open + 2;
            int rawLen = close2 - rawStart;
            if (mode == 1 && rawLen == 4
                && (tpl[rawStart] & 255) == 101 && (tpl[rawStart + 1] & 255) == 108
                && (tpl[rawStart + 2] & 255) == 115 && (tpl[rawStart + 3] & 255) == 101) {
                state[0] = close2 + 2;
                state[1] = 1;
                return;
            }
            if ((mode == 1 || mode == 2) && rawLen == 3
                && (tpl[rawStart] & 255) == 47 && (tpl[rawStart + 1] & 255) == 105
                && (tpl[rawStart + 2] & 255) == 102) {
                state[0] = close2 + 2;
                state[1] = 2;
                return;
            }
            if (mode == 3 && rawLen == 5
                && (tpl[rawStart] & 255) == 47 && (tpl[rawStart + 1] & 255) == 101
                && (tpl[rawStart + 2] & 255) == 97 && (tpl[rawStart + 3] & 255) == 99
                && (tpl[rawStart + 4] & 255) == 104) {
                state[0] = close2 + 2;
                state[1] = 3;
                return;
            }
            int ts = rawStart;
            int te = close2;
            while (ts < te && (tpl[ts] & 255) == 32) { ts = ts + 1; }
            while (te > ts && (tpl[te - 1] & 255) == 32) { te = te - 1; }
            int tlen = te - ts;
            if (tlen > 4 && (tpl[ts] & 255) == 35 && (tpl[ts + 1] & 255) == 105
                && (tpl[ts + 2] & 255) == 102 && (tpl[ts + 3] & 255) == 32) {
                int ifPc = ops.Count;
                ops.Add(3); argA.Add(0); argB.Add(0); keys.Add(View.TrimSlice(tpl, ts + 4, te));
                state[0] = close2 + 2;
                View.CompileFlat(tpl, n, state, 1, ops, argA, argB, keys, depth + 1);
                if (state[1] == 0) {
                    while (ops.Count > ifPc) {
                        ops.RemoveAt(ops.Count - 1);
                        argA.RemoveAt(argA.Count - 1);
                        argB.RemoveAt(argB.Count - 1);
                        keys.RemoveAt(keys.Count - 1);
                    }
                    return;
                }
                int elsePc = ops.Count;
                if (state[1] == 1) {
                    View.CompileFlat(tpl, n, state, 2, ops, argA, argB, keys, depth + 1);
                    if (state[1] != 2) {
                        while (ops.Count > ifPc) {
                            ops.RemoveAt(ops.Count - 1);
                            argA.RemoveAt(argA.Count - 1);
                            argB.RemoveAt(argB.Count - 1);
                            keys.RemoveAt(keys.Count - 1);
                        }
                        return;
                    }
                }
                argA[ifPc] = elsePc;
                argB[ifPc] = ops.Count;
                i = state[0];
            } else if (tlen > 6 && (tpl[ts] & 255) == 35 && (tpl[ts + 1] & 255) == 101
                && (tpl[ts + 2] & 255) == 97 && (tpl[ts + 3] & 255) == 99
                && (tpl[ts + 4] & 255) == 104 && (tpl[ts + 5] & 255) == 32) {
                int eachPc = ops.Count;
                ops.Add(4); argA.Add(0); argB.Add(0); keys.Add(View.TrimSlice(tpl, ts + 6, te));
                state[0] = close2 + 2;
                View.CompileFlat(tpl, n, state, 3, ops, argA, argB, keys, depth + 1);
                if (state[1] != 3) {
                    while (ops.Count > eachPc) {
                        ops.RemoveAt(ops.Count - 1);
                        argA.RemoveAt(argA.Count - 1);
                        argB.RemoveAt(argB.Count - 1);
                        keys.RemoveAt(keys.Count - 1);
                    }
                    return;
                }
                argA[eachPc] = ops.Count;
                i = state[0];
            } else if (tlen == 7 && (tpl[ts] & 255) == 99 && (tpl[ts + 1] & 255) == 111
                && (tpl[ts + 2] & 255) == 110 && (tpl[ts + 3] & 255) == 116
                && (tpl[ts + 4] & 255) == 101 && (tpl[ts + 5] & 255) == 110
                && (tpl[ts + 6] & 255) == 116) {
                ops.Add(5); argA.Add(0); argB.Add(0); keys.Add("");
                i = close2 + 2;
            } else {
                ops.Add(1); argA.Add(0); argB.Add(0);
                keys.Add(tlen > 0 ? tpl.Substring(ts, tlen) : "");
                i = close2 + 2;
            }
        }
        state[0] = n;
        state[1] = 0;
    }

    private static void ExecFlat(string tpl, nint tp,
                                 List<int> ops, List<int> argA, List<int> argB, List<string> keys,
                                 int pc, int endPc, ViewData data, StrMap vars, StrMap row,
                                 StringBuilder sb, int depth) {
        if (depth >= View.MaxTemplateDepth) { return; }
        while (pc < endPc) {
            int op = ops[pc];
            if (op == 0) {
                sb.Append(new StringView(tp + (nint)argA[pc], argB[pc]));
                pc = pc + 1;
            } else if (op == 1) {
                View.HtmlEscapeInto(View.LookupFast(keys[pc], vars, row), sb);
                pc = pc + 1;
            } else if (op == 2) {
                sb.Append(View.LookupFast(keys[pc], vars, row));
                pc = pc + 1;
            } else if (op == 3) {
                string val = View.LookupFast(keys[pc], vars, row);
                int vlen = val.Length;
                int elsePc = argA[pc];
                int nextPc = argB[pc];
                if (vlen > 0 && !(vlen == 1 && (val[0] & 255) == 48)
                    && !(vlen == 5 && val == "false")) {
                    View.ExecFlat(tpl, tp, ops, argA, argB, keys, pc + 1, elsePc, data, vars, row, sb, depth + 1);
                } else if (elsePc < nextPc) {
                    View.ExecFlat(tpl, tp, ops, argA, argB, keys, elsePc, nextPc, data, vars, row, sb, depth + 1);
                }
                pc = nextPc;
            } else if (op == 4) {
                int nextPc = argA[pc];
                List<StrMap> rows = data != null ? data.ListOf(keys[pc]) : null;
                if (rows != null) {
                    int rcount = rows.Count;
                    for (int r = 0; r < rcount; r = r + 1) {
                        View.ExecFlat(tpl, tp, ops, argA, argB, keys, pc + 1, nextPc, data, vars, rows[r], sb, depth + 1);
                    }
                }
                pc = nextPc;
            } else {
                string cval = "";
                if (View.TryLookupFast("content", vars, row, out cval)) {
                    View.HtmlEscapeInto(cval, sb);
                } else {
                    sb.Append("{{content}}");
                }
                pc = pc + 1;
            }
        }
    }

    private static string TrimSlice(string s, int start, int end) {
        while (start < end && (s[start] & 255) == 32) { start = start + 1; }
        while (end > start && (s[end - 1] & 255) == 32) { end = end - 1; }
        return start < end ? s.Substring(start, end - start) : "";
    }

    // 单遍 O(N) 区间递归下降编译：彻底消除 FindTag/FindElse 的 O(N^2) 尾部重扫与嵌套 Substring 拷贝。
    // state[0] = 当前游标，state[1] = 停止原因（0=EOF, 1={{else}}, 2={{/if}}, 3={{/each}}）。
    // mode: 0=顶层, 1=#if 真分支, 2=#if 假分支, 3=#each 循环体。
    private static List<VNode> CompileBlock(string tpl, int n, int[] state, int mode, int depth) {
        List<VNode> nodes = new List<VNode>();
        if (depth >= View.MaxTemplateDepth) {
            state[0] = n;
            state[1] = 0;
            return nodes;
        }
        int i = state[0];
        while (i < n) {
            int open = tpl.IndexOf("{{", i);
            if (open < 0) {
                nodes.Add(new VNode(VNodeKind.Literal, tpl.Substring(i, n - i)));
                state[0] = n;
                state[1] = 0;
                return nodes;
            }
            if (open > i) {
                nodes.Add(new VNode(VNodeKind.Literal, tpl.Substring(i, open - i)));
            }
            // {{{raw}}}
            if (open + 2 < n && (tpl[open + 2] & 255) == 123) {
                int close = tpl.IndexOf("}}}", open + 3);
                if (close < 0) {
                    state[0] = n;
                    state[1] = 0;
                    return nodes;
                }
                nodes.Add(new VNode(VNodeKind.RawVar, View.TrimSlice(tpl, open + 3, close)));
                i = close + 3;
                continue;
            }
            int close2 = tpl.IndexOf("}}", open + 2);
            if (close2 < 0) {
                state[0] = n;
                state[1] = 0;
                return nodes;
            }
            int rawStart = open + 2;
            int rawLen = close2 - rawStart;
            // 精确匹配控制结束符（与旧 FindTag / FindElse 的字面量口径完全一致）
            if (mode == 1 && rawLen == 4
                && (tpl[rawStart] & 255) == 101 && (tpl[rawStart + 1] & 255) == 108
                && (tpl[rawStart + 2] & 255) == 115 && (tpl[rawStart + 3] & 255) == 101) {
                state[0] = close2 + 2;
                state[1] = 1;
                return nodes;
            }
            if ((mode == 1 || mode == 2) && rawLen == 3
                && (tpl[rawStart] & 255) == 47 && (tpl[rawStart + 1] & 255) == 105
                && (tpl[rawStart + 2] & 255) == 102) {
                state[0] = close2 + 2;
                state[1] = 2;
                return nodes;
            }
            if (mode == 3 && rawLen == 5
                && (tpl[rawStart] & 255) == 47 && (tpl[rawStart + 1] & 255) == 101
                && (tpl[rawStart + 2] & 255) == 97 && (tpl[rawStart + 3] & 255) == 99
                && (tpl[rawStart + 4] & 255) == 104) {
                state[0] = close2 + 2;
                state[1] = 3;
                return nodes;
            }
            int ts = rawStart;
            int te = close2;
            while (ts < te && (tpl[ts] & 255) == 32) { ts = ts + 1; }
            while (te > ts && (tpl[te - 1] & 255) == 32) { te = te - 1; }
            int tlen = te - ts;
            if (tlen > 4 && (tpl[ts] & 255) == 35 && (tpl[ts + 1] & 255) == 105
                && (tpl[ts + 2] & 255) == 102 && (tpl[ts + 3] & 255) == 32) {
                string condName = View.TrimSlice(tpl, ts + 4, te);
                state[0] = close2 + 2;
                List<VNode> thenBody = View.CompileBlock(tpl, n, state, 1, depth + 1);
                if (state[1] == 0) {
                    return nodes;
                }
                VNode node = new VNode(VNodeKind.If, condName);
                node.SetBody(thenBody);
                if (state[1] == 1) {
                    List<VNode> elseBody = View.CompileBlock(tpl, n, state, 2, depth + 1);
                    if (state[1] != 2) {
                        return nodes;
                    }
                    node.SetElseBody(elseBody);
                }
                nodes.Add(node);
                i = state[0];
            } else if (tlen > 6 && (tpl[ts] & 255) == 35 && (tpl[ts + 1] & 255) == 101
                && (tpl[ts + 2] & 255) == 97 && (tpl[ts + 3] & 255) == 99
                && (tpl[ts + 4] & 255) == 104 && (tpl[ts + 5] & 255) == 32) {
                string listName = View.TrimSlice(tpl, ts + 6, te);
                state[0] = close2 + 2;
                List<VNode> eachBody = View.CompileBlock(tpl, n, state, 3, depth + 1);
                if (state[1] != 3) {
                    return nodes;
                }
                VNode node = new VNode(VNodeKind.Each, listName);
                node.SetBody(eachBody);
                nodes.Add(node);
                i = state[0];
            } else if (tlen == 7 && (tpl[ts] & 255) == 99 && (tpl[ts + 1] & 255) == 111
                && (tpl[ts + 2] & 255) == 110 && (tpl[ts + 3] & 255) == 116
                && (tpl[ts + 4] & 255) == 101 && (tpl[ts + 5] & 255) == 110
                && (tpl[ts + 6] & 255) == 116) {
                nodes.Add(new VNode(VNodeKind.ContentSlot, ""));
                i = close2 + 2;
            } else {
                nodes.Add(new VNode(VNodeKind.EscapedVar, tlen > 0 ? tpl.Substring(ts, tlen) : ""));
                i = close2 + 2;
            }
        }
        state[0] = n;
        state[1] = 0;
        return nodes;
    }

    public static List<VNode> Compile(string tpl) {
        if (tpl == null || tpl.Length == 0) { return new List<VNode>(); }
        int[] state = new int[2];
        state[0] = 0;
        state[1] = 0;
        return View.CompileBlock(tpl, tpl.Length, state, 0, 0);
    }

    private static void Emit(List<VNode> nodes, ViewData data, StrMap row,
                             List<VNode> content, StringBuilder sb) {
        StrMap vars = data != null ? data.Vars() : null;
        View.EmitFast(nodes, data, vars, row, content, sb, 0);
    }

    private static void EmitFast(List<VNode> nodes, ViewData data, StrMap vars, StrMap row,
                                 List<VNode> content, StringBuilder sb, int depth) {
        if (nodes == null || depth >= View.MaxTemplateDepth) { return; }
        int count = nodes.Count;
        for (int i = 0; i < count; i = i + 1) {
            VNode nd = nodes[i];
            int kind = nd.Kind();
            if (kind == VNodeKind.Literal) {
                sb.Append(nd.Text());
            } else if (kind == VNodeKind.EscapedVar) {
                View.HtmlEscapeInto(View.LookupFast(nd.Text(), vars, row), sb);
            } else if (kind == VNodeKind.RawVar) {
                sb.Append(View.LookupFast(nd.Text(), vars, row));
            } else if (kind == VNodeKind.If) {
                string val = View.LookupFast(nd.Text(), vars, row);
                int vlen = val.Length;
                if (vlen > 0 && !(vlen == 1 && (val[0] & 255) == 48)
                    && !(vlen == 5 && val == "false")) {
                    View.EmitFast(nd.Body(), data, vars, row, content, sb, depth + 1);
                } else if (nd.ElseBody() != null) {
                    View.EmitFast(nd.ElseBody(), data, vars, row, content, sb, depth + 1);
                }
            } else if (kind == VNodeKind.Each) {
                List<StrMap> rows = null;
                if (data != null) { rows = data.ListOf(nd.Text()); }
                if (rows != null) {
                    List<VNode> body = nd.Body();
                    int rcount = rows.Count;
                    for (int r = 0; r < rcount; r = r + 1) {
                        View.EmitFast(body, data, vars, rows[r], content, sb, depth + 1);
                    }
                }
            } else {
                /* {{content}} 双语义（Bug#2）：layout 填洞优先；否则单次探测解析同名变量；
                   都不满足才回落字面量占位。 */
                if (content != null) {
                    View.EmitFast(content, data, vars, row, null, sb, depth + 1);
                } else {
                    string cval = "";
                    if (View.TryLookupFast("content", vars, row, out cval)) {
                        View.HtmlEscapeInto(cval, sb);
                    } else {
                        sb.Append("{{content}}");
                    }
                }
            }
        }
    }

    /* 每个 {{变量}} 都走这里：行字段优先，其次外提的 vars。单次探测。 */
    private static string LookupFast(string key, StrMap vars, StrMap row) {
        string value = "";
        if (row != null && row.TryGet(key, out value)) {
            return value != null ? value : "";
        }
        if (vars != null && vars.TryGet(key, out value)) {
            return value != null ? value : "";
        }
        return "";
    }

    private static bool TryLookupFast(string key, StrMap vars, StrMap row, out string outVal) {
        string value = "";
        if (row != null && row.TryGet(key, out value)) {
            outVal = value != null ? value : "";
            return true;
        }
        if (vars != null && vars.TryGet(key, out value)) {
            outVal = value != null ? value : "";
            return true;
        }
        outVal = "";
        return false;
    }

    // HTML 转义直写目标 StringBuilder，位掩码快筛 + StringView 切片零分配拼接。
    // 特殊字符 < (60), > (62), & (38), " (34), ' (39) 全落在 [34..62]，
    // 掩码 (1<<0)|(1<<4)|(1<<5)|(1<<26)|(1<<28) = 335544369。
    private static void HtmlEscapeInto(string s, StringBuilder sb) {
        if (s == null || s.Length == 0) { return; }
        int n = s.Length;
        int first = -1;
        for (int k = 0; k < n; k = k + 1) {
            int d = (s[k] & 255) - 34;
            if (d >= 0 && d <= 28 && ((335544369 >> d) & 1) != 0) { first = k; break; }
        }
        if (first < 0) { sb.Append(s); return; }
        nint basePtr = (nint)s;
        int start = 0;
        for (int i = first; i < n; i = i + 1) {
            int c = s[i] & 255;
            int d = c - 34;
            if (d < 0 || d > 28 || ((335544369 >> d) & 1) == 0) { continue; }
            if (i > start) { sb.Append(new StringView(basePtr + (nint)start, i - start)); }
            if (c == 60) { sb.Append("&lt;"); }
            else if (c == 62) { sb.Append("&gt;"); }
            else if (c == 38) { sb.Append("&amp;"); }
            else if (c == 34) { sb.Append("&quot;"); }
            else { sb.Append("&#39;"); }
            start = i + 1;
        }
        if (n > start) { sb.Append(new StringView(basePtr + (nint)start, n - start)); }
    }

    // HTML 转义 < > & " '。位掩码单遍扫描，无需转义时原串返回。
    public static string HtmlEscape(string s) {
        if (s == null) { return ""; }
        int n = s.Length;
        int first = -1;
        for (int k = 0; k < n; k = k + 1) {
            int d = (s[k] & 255) - 34;
            if (d >= 0 && d <= 28 && ((335544369 >> d) & 1) != 0) { first = k; break; }
        }
        if (first < 0) { return s; }
        StringBuilder sb = new StringBuilder(n + 16);
        View.HtmlEscapeInto(s, sb);
        return sb.ToString();
    }
}
