using System;
using System.Collections.Generic;

namespace System.Web;

class MenuNode {
    string title;
    string path;
    string group;
    string icon;
    bool active;
    // 菜单分类分组展示排序权重。
    int groupOrder;
    // 分组内子页面根据 URL 路径排定层级与显示顺序。
    string order;

    MenuNode() {
        this.title = "";
        this.path = "";
        this.group = "";
        this.icon = "";
        this.active = false;
        this.groupOrder = 0x7FFFFFFF;
        this.order = "";
    }

    string Title() { return this.title; }
    string Path() { return this.path; }
    string Group() { return this.group; }
    string Icon() { return this.icon; }
    bool Active() { return this.active; }
}

// 管理后台动态导航菜单构建器：基于路由表和特性声明自动生成。
