using System;
using System.Collections.Generic;

namespace System.Web;

public class MenuNode {
    public string title;
    public string path;
    public string group;
    public string icon;
    public bool active;
    // 菜单分类分组展示排序权重。
    public int groupOrder;
    // 分组内子页面根据 URL 路径排定层级与显示顺序。
    public string order;

    public MenuNode() {
        this.title = "";
        this.path = "";
        this.group = "";
        this.icon = "";
        this.active = false;
        this.groupOrder = 0x7FFFFFFF;
        this.order = "";
    }

    public string Title() { return this.title; }
    public string Path() { return this.path; }
    public string Group() { return this.group; }
    public string Icon() { return this.icon; }
    public bool Active() { return this.active; }
}

// 管理后台动态导航菜单构建器：基于路由表和特性声明自动生成。
