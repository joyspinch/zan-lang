using System;

namespace System.Web;

/* GeoAgent -- 识别生成式 AI 搜索引擎爬虫与大模型请求，支持智能内容协商。 */
public class GeoAgent {
    /* 已知主流 AI 搜索与大模型爬虫标识（全部以小写比对）。 */
    public static string[] AI_BOT_SIGNATURES = new string[] {
        "gptbot",
        "chatgpt-user",
        "chatgpt",
        "perplexitybot",
        "perplexity",
        "claudebot",
        "claude-web",
        "anthropic-ai",
        "google-extended",
        "googleother",
        "bytespider",
        "applebot-extended",
        "cohere-ai",
        "diffbot",
        "omgilibot",
        "ccbot",
        "facebookbot",
        "amazonbot",
        "meta-externalagent"
    };

    /* 判断 User-Agent 是否命中已知生成式 AI 引擎爬虫。 */
    public static bool IsAiBot(string userAgent) {
        if (userAgent == null || userAgent.Length == 0) { return false; }
        string ua = userAgent.ToLower();
        for (int i = 0; i < AI_BOT_SIGNATURES.Length; i = i + 1) {
            if (ua.Contains(AI_BOT_SIGNATURES[i])) {
                return true;
            }
        }
        return false;
    }

    /* 内容协商判断：客户端是否期望接收 Markdown 或由 AI 引擎消费。 */
    public static bool WantsMarkdown(HttpContext ctx) {
        if (ctx == null) { return false; }

        /* 1. 显式查询参数或路径覆盖：?format=md 或 ?format=markdown */
        string fmt = ctx.Query("format");
        if (fmt == "md" || fmt == "markdown") { return true; }

        /* 2. 检查 Accept 请求头是否优先请求 markdown */
        string accept = ctx.Header("Accept");
        if (accept.Length > 0) {
            if (accept.Contains("text/markdown")) { return true; }
        }

        /* 3. 检查 User-Agent 是否为 AI 爬虫 */
        string ua = ctx.Header("User-Agent");
        if (GeoAgent.IsAiBot(ua)) {
            /* 如果没有特意指定必须只要 text/html，则对 AI 爬虫默认开启 Markdown 降级 */
            if (accept.Length == 0 || !accept.Contains("text/html") || accept.Contains("*/*")) {
                return true;
            }
        }

        return false;
    }
}
