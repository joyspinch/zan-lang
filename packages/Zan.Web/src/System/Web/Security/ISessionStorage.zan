namespace System.Web;

// 分布式与集中式会话持久化统一抽象接口（支持单机内存、Redis 或分布式 KV 存储插拔）
public interface ISessionStorage {
    // 签发会话令牌
    string Issue(string uid, int nowSeconds, int ttlSeconds);

    // 查询会话令牌对应的用户 ID（过期返回空串）
    string UserOf(string token, int nowSeconds);

    // 撤销/删除指定会话
    bool Remove(string token);

    // 清空会话
    void Clear();
}
