using System;
using System.Collections.Generic;

namespace System.Web;

public class RateLimiter : IDisposable {
    private SharedTable table;
    private int windowMs;

    // 构造限流器；windowMs 为固定窗口宽度（毫秒），非正数回落 1000ms。
    public RateLimiter(int windowMs) {
        this.windowMs = windowMs > 0 ? windowMs : 1000;
    }

    public void Dispose() {
        lock (this) {
            if (this.table != null) {
                this.table.Close();
                this.table = null;
            }
        }
    }

    // 新建计数表：65536 个键位，每键 count 与 window_start 两列。
    public static SharedTable NewTable() {
        SharedTable t = new SharedTable("", HttpLimits.DefaultSharedTableSlots);
        t.KeySize(HttpLimits.DefaultSharedTableKeyBytes);
        t.ColumnInt("count");
        t.ColumnInt("window_start");
        return t;
    }

    public static RateLimiter Owned(int windowMs) {
        RateLimiter r = new RateLimiter(windowMs);
        SharedTable t = RateLimiter.NewTable();
        if (t.CreateAnonymous()) {
            t.Label("web rate limit");
            r.table = t;
        }
        return r;
    }

    public static RateLimiter Attach(long osHandle, int windowMs) {
        RateLimiter r = new RateLimiter(windowMs);
        if (osHandle == 0) { return r; }
        SharedTable t = SharedTable.Attach(osHandle);
        if (t.IsOpen()) {
            t.Label("web rate limit");
            r.table = t;
        }
        return r;
    }

    public long OsHandle() {
        SharedTable tbl = this.table;
        if (tbl == null) { return 0; }
        return tbl.OsHandle();
    }

    // 本窗口内 key 是否仍允许通过：limit<=0 恒允许；表未就绪一律拒绝
    // （fail closed，被限流的路由不会悄悄放开）。
    public bool Allow(string key, int limit) {
        if (limit <= 0) { return true; }
        SharedTable tbl = this.table;
        if (tbl == null || key == null) { return false; }
        return tbl.RateAllow(key, -1, this.windowMs, limit);
    }

    // key 当前窗口已计的请求数；表未就绪返回 0。
    public int CountOf(string key) {
        SharedTable tbl = this.table;
        if (tbl == null || key == null) { return 0; }
        return (int)tbl.GetInt(key, "count");
    }
}
