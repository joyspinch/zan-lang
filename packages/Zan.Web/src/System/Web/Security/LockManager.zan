using System;
using System.Threading;

namespace System.Web;

// Request-lock registry: the typed replacement for the PHP "接口请求锁" pattern.
public class LockManager : IDisposable {
    private SharedTable table;
    private long ownerPrefix;
    private long ownerSequence;
    private long leaseMs;

    public LockManager() {
        long pid = (long)(Environment.ProcessId & 0x7FFFFF);
        if (pid == 0) { pid = 1; }
        this.ownerPrefix = pid << 40;
        this.ownerSequence = 0;
        this.leaseMs = HttpLimits.DefaultTimeoutMs;
    }

    public void Dispose() {
        lock (this) {
            if (this.table != null) {
                this.table.Close();
                this.table = null;
            }
        }
    }

    // 新建锁表：65536 键位，单列 owner。
    public static SharedTable NewTable() {
        SharedTable t = new SharedTable("", HttpLimits.DefaultSharedTableSlots);
        t.KeySize(HttpLimits.DefaultSharedTableKeyBytes);
        t.ColumnInt("owner");
        return t;
    }

    public static LockManager Owned() {
        LockManager m = new LockManager();
        SharedTable t = LockManager.NewTable();
        if (t.CreateAnonymous()) {
            t.Label("web request lock");
            m.table = t;
        }
        return m;
    }

    public static LockManager Attach(long osHandle) {
        LockManager m = new LockManager();
        if (osHandle == 0) { return m; }
        SharedTable t = SharedTable.Attach(osHandle);
        if (t.IsOpen()) {
            t.Label("web request lock");
            m.table = t;
        }
        return m;
    }

    public long OsHandle() {
        SharedTable tbl = this.table;
        if (tbl == null) { return 0; }
        return tbl.OsHandle();
    }

    // 依 [Lock] 维度构锁键：
    // - "user" → "u:<principal>:<路由键>"（匿名者记 _anon_）
    // - "global" → "g:<路由键>"
    // - 其他自定义维度 <scope> → "<scope>:<principal>:<路由键>"
    // 未声明锁维度返回空串。
    public static string KeyFor(Route route, string principal) {
        if (route == null) { return ""; }
        string scope = route.LockScope();
        if (scope == null || scope.Length == 0) { return ""; }
        if (scope == "global") {
            return "g:" + route.Key();
        }
        string who = principal != null ? principal : "";
        if (who.Length == 0) { who = "_anon_"; }
        if (scope == "user") {
            return "u:" + who + ":" + route.Key();
        }
        return scope + ":" + who + ":" + route.Key();
    }

    // 取租约：键为空、表未就绪或键已被持有都返回 null。
    public LockLease TryAcquire(string key) {
        if (key == null || key.Length == 0) { return null; }
        SharedTable tbl = this.table;
        if (tbl == null) { return null; }
        long owner = 0;
        lock (this) {
            this.ownerSequence = this.ownerSequence + 1;
            owner = this.ownerPrefix | (this.ownerSequence & 0xFFFFFFFFFFL);
        }
        if (!tbl.TryAcquireLease(key, owner, -1, this.leaseMs)) {
            return null;
        }
        return new LockLease(key, owner);
    }

    // 释放租约（须为本持有者）；lease 为 null 或表未就绪时静默返回。
    public void Release(LockLease lease) {
        SharedTable tbl = this.table;
        if (lease == null || tbl == null) { return; }
        tbl.ReleaseLease(lease.Key(), lease.Owner());
    }
}
