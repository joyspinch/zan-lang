using System;
using System.Collections.Generic;
using System.Security.Cryptography;

namespace System.Web;

// CSRF 防护（opt-in）：double-submit cookie。
// 语义：
// - 安全方法（GET/HEAD/OPTIONS）不拦截；首次访问补发随机 token
// cookie（不带 HttpOnly——浏览器脚本必须读它、回显到
// X-CSRF-Token 头或 _csrf 表单字段；SameSite=Lax 保留，本身就是
// 第一道防线）。
// - 不安全方法要求 X-CSRF-Token（或 _csrf 字段）与 cookie 逐字节
// 相等；缺失或不匹配 → 403 并短路（返回 false，路由不再执行）。
// - 比较走常时路径（按最大长度累积异或），不因首个差异字节提前返回。
// - token 无状态（16 随机字节的 hex），重启/多 worker 之间均有效，
// 服务端不需要存储与过期清扫。
// - 豁免：自带签名校验的回调路由用 <see cref="Csrf.Skip"/> 登记前缀。
public class Csrf {
    public static string CookieName = "csrf_token";
    public static string HeaderName = "X-CSRF-Token";
    public static string FormName = "_csrf";
    private static string stateLock = "System.Web.Csrf.stateLock";
    private static List<string> skips;

    // 统一配置 CSRF Cookie、请求头与表单字段名；空串保持当前值不变。
    public static void Configure(string cookieName, string headerName, string formName) {
        lock (Csrf.stateLock) {
            if (cookieName != null && cookieName.Length > 0) { Csrf.CookieName = cookieName; }
            if (headerName != null && headerName.Length > 0) { Csrf.HeaderName = headerName; }
            if (formName != null && formName.Length > 0) { Csrf.FormName = formName; }
        }
    }

    // 登记豁免前缀：路径以其开头即不拦截。用于支付回调、
    // webhook 等自带签名校验、调用方不可能持有 cookie 的路由。
    public static void Skip(string prefix) {
        if (prefix == null || prefix.Length == 0) { return; }
        lock (Csrf.stateLock) {
            if (Csrf.skips == null) { Csrf.skips = new List<string>(); }
            Csrf.skips.Add(prefix);
        }
    }

    // 路径是否命中任一豁免前缀（优先检查上下文绑定的应用级配置，回退全局配置）。
    public static bool Skipped(HttpContext ctx, string path) {
        if (ctx != null && ctx.App() != null && ctx.App().HasCsrfSkip(path)) {
            return true;
        }
        return Csrf.Skipped(path);
    }

    // 路径前缀段边界匹配："/api/webhook" 仅命中 "/api/webhook" 或 "/api/webhook/..."，
    // 不会误匹配 "/api/webhook-evil"；以 "/" 结尾的前缀保持目录前缀语义。
    public static bool MatchesPrefix(string path, string prefix) {
        if (path == null || prefix == null) { return false; }
        int plen = prefix.Length;
        if (plen == 0 || path.Length < plen) { return false; }
        for (int i = 0; i < plen; i = i + 1) {
            if ((path[i] & 255) != (prefix[i] & 255)) { return false; }
        }
        if ((prefix[plen - 1] & 255) == 47) { return true; }
        return path.Length == plen || (path[plen] & 255) == 47;
    }

    // 路径是否命中任一全局豁免前缀。
    public static bool Skipped(string path) {
        if (path == null) { return false; }
        lock (Csrf.stateLock) {
            if (Csrf.skips == null) { return false; }
            int n = Csrf.skips.Count;
            for (int i = 0; i < n; i = i + 1) {
                if (Csrf.MatchesPrefix(path, Csrf.skips[i])) { return true; }
            }
            return false;
        }
    }

    // Before 钩子本体。返回 false 表示已写好 403 响应，
    // 管线短路。前哨先做 Origin/Sec-Fetch-Site 站点校验（浏览器自动
    // 附带、免客户端配合），double-submit token 是第二道闸。
    public static bool Guard(HttpContext ctx) {
        if (ctx == null) { return false; }
        bool safe = ctx.Method() == "GET" || ctx.Method() == "HEAD"
            || ctx.Method() == "OPTIONS";
        if (safe) {
            if (ctx.Cookie(Csrf.CookieName).Length == 0) {
                ctx.SetCookieJs(Csrf.CookieName, Csrf.NewToken(), HttpLimits.DefaultCsrfTokenTtlSeconds);
            }
            return true;
        }
        if (Csrf.Skipped(ctx, ctx.Path())) { return true; }
        if (!Csrf.OriginCheck(ctx)) {
            ctx.Status(403, "Forbidden");
            ctx.Text("cross-site request rejected");
            return false;
        }
        string cookie = ctx.Cookie(Csrf.CookieName);
        string sent = ctx.Header(Csrf.HeaderName);
        if (sent.Length == 0) { sent = ctx.Form(Csrf.FormName); }
        if (cookie.Length == 0 || sent.Length == 0
            || !Csrf.ConstantTimeEquals(cookie, sent)) {
            ctx.Status(403, "Forbidden");
            ctx.Text("csrf token missing or invalid");
            return false;
        }
        return true;
    }

    // 新 token：16 随机字节的 hex（128 位熵）。
    public static string NewToken() {
        return Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
    }

    // 常时比较：按较长一方的长度累积异或，长度不等直接计入差异位，
    // 不因首个差异字节提前返回。
    public static bool ConstantTimeEquals(string a, string b) {
        if (a == null || b == null) { return false; }
        int la = a.Length;
        int lb = b.Length;
        if (la == lb) {
            int diff = 0;
            for (int i = 0; i < la; i = i + 1) {
                diff = diff | ((a[i] & 255) ^ (b[i] & 255));
            }
            return diff == 0;
        }
        int n = la > lb ? la : lb;
        int diff2 = 1;
        for (int i = 0; i < n; i = i + 1) {
            int x = i < la ? (a[i] & 255) : 0;
            int y = i < lb ? (b[i] & 255) : 0;
            diff2 = diff2 | (x ^ y);
        }
        return diff2 == 0;
    }

    // 站点校验前哨（Before 钩子形态）：不安全方法上依据
    // 浏览器自动附带的证据拒绝跨站请求，无需页面/脚本配合——
    // Sec-Fetch-Site: cross-site 直接拒；带 Origin 头且其 authority
    // 与 Host 不符也拒。两样都缺（老浏览器、非浏览器客户端）放行，
    // 此时 SameSite=Lax 会话 cookie 仍是底线。安全方法一律放行。
    public static bool OriginGuard(HttpContext ctx) {
        if (ctx == null) { return false; }
        if (ctx.Method() == "GET" || ctx.Method() == "HEAD"
            || ctx.Method() == "OPTIONS") { return true; }
        if (Csrf.OriginCheck(ctx)) { return true; }
        ctx.Status(403, "Forbidden");
        ctx.Text("cross-site request rejected");
        return false;
    }

    // 前哨的纯校验半口：true 放行，false 跨站（应答由钩子写）。
    public static bool OriginCheck(HttpContext ctx) {
        if (ctx == null) { return false; }
        if (ctx.Method() == "GET" || ctx.Method() == "HEAD"
            || ctx.Method() == "OPTIONS") { return true; }
        string site = ctx.Header("Sec-Fetch-Site");
        if (site == "cross-site") { return false; }
        string origin = ctx.Header("Origin");
        if (origin.Length > 0 && !Csrf.SameAuthorityForScheme(origin,
            ctx.Header("Host"), ctx.IsSecure())) { return false; }
        return true;
    }

    // Origin 的 authority（冒号后段，去默认端口、小写）是否与 Host
    // 一致。大小写不敏感按 RFC 3986；Host 缺失视为不一致（保守）。
    public static bool SameAuthority(string origin, string host) {
        return Csrf.SameAuthorityForScheme(origin, host, false);
    }

    private static int LowerAscii(int c) {
        return (c >= 65 && c <= 90) ? (c + 32) : c;
    }

    private static int TrimDefaultPortEnd(string s, int start, int end, bool isHttps) {
        int len = end - start;
        if (isHttps) {
            if (len >= 4
                && (s[end - 4] & 255) == 58
                && (s[end - 3] & 255) == 52
                && (s[end - 2] & 255) == 52
                && (s[end - 1] & 255) == 51) {
                return end - 4;
            }
        } else {
            if (len >= 3
                && (s[end - 3] & 255) == 58
                && (s[end - 2] & 255) == 56
                && (s[end - 1] & 255) == 48) {
                return end - 3;
            }
        }
        return end;
    }

    // 含协议降级防护的同源校验：HTTPS 请求拒绝明文 http:// Origin。
    public static bool SameAuthorityForScheme(string origin, string host, bool requireHttps) {
        if (origin == null || host == null || host.Length == 0) { return false; }
        int olen = origin.Length;
        bool isHttps = false;
        int authStart = 0;

        // 快路径：99%+ Origin 以 "https://"（冒号在索引 5）或 "http://"（冒号在索引 4）开头，免扫描与 FFI。
        if (olen >= 8
            && (origin[5] & 255) == 58
            && (origin[6] & 255) == 47
            && (origin[7] & 255) == 47
            && ((origin[0] & 255) | 32) == 104
            && ((origin[1] & 255) | 32) == 116
            && ((origin[2] & 255) | 32) == 116
            && ((origin[3] & 255) | 32) == 112
            && ((origin[4] & 255) | 32) == 115) {
            isHttps = true;
            authStart = 8;
        } else if (olen >= 7
            && (origin[4] & 255) == 58
            && (origin[5] & 255) == 47
            && (origin[6] & 255) == 47
            && ((origin[0] & 255) | 32) == 104
            && ((origin[1] & 255) | 32) == 116
            && ((origin[2] & 255) | 32) == 116
            && ((origin[3] & 255) | 32) == 112) {
            if (requireHttps) { return false; }
            authStart = 7;
        } else {
            if (requireHttps) { return false; }
            int lim = olen - 2;
            for (int i = 0; i < lim; i = i + 1) {
                if ((origin[i] & 255) == 58 && (origin[i + 1] & 255) == 47 && (origin[i + 2] & 255) == 47) {
                    return false; // 含其他协议（非 http/https）
                }
            }
        }

        int authEnd = Csrf.TrimDefaultPortEnd(origin, authStart, olen, isHttps);
        int hostEnd = Csrf.TrimDefaultPortEnd(host, 0, host.Length, isHttps);
        int alen = authEnd - authStart;
        if (alen != hostEnd) { return false; }
        for (int i = 0; i < alen; i = i + 1) {
            int ca = origin[authStart + i] & 255;
            int cb = host[i] & 255;
            if (ca != cb && Csrf.LowerAscii(ca) != Csrf.LowerAscii(cb)) {
                return false;
            }
        }
        return true;
    }

    // 去掉明确的默认端口后缀（https 的 :443 / 明文的 :80）；
    // 其余端口保留参与比较。
    public static string TrimDefaultPort(string auth, bool isHttps) {
        if (auth == null) { return ""; }
        int n = auth.Length;
        int end = Csrf.TrimDefaultPortEnd(auth, 0, n, isHttps);
        if (end < n) {
            return auth.Substring(0, end);
        }
        return auth;
    }
}
