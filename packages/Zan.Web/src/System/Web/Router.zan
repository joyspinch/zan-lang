using System;
using System.Threading;
using System.Json;
using System.Text.RegularExpressions;

namespace System.Web;

// 单个路由端点共享内存性能指标（路由、调用次数、平均微秒耗时）。
public class Router {
    List<Route> statics;  // no {param} segments: matched by full-path compare
    List<Route> dynamics;  // contain {param} segments: matched per-segment
    List<Route> regexes;   // regex patterns: matched by Regex.Find / IsMatch
    // 静态路由 O(1) 快速查找哈希表。
    Dictionary<string, Route> staticIndex;
    // 静态路由开放寻址哈希索引。
    List<int> hashSlots;
    int hashMask;
    List<Route> flat;
    // 路由统计键元数据实体列表（结构化管理，消除平行列表）。
    List<RouteStatEntry> statEntries;
    // 跨进程共享路由统计表（记录命中次数与总微秒耗时）。
    SharedTable routeStats;

    public Router() {
        this.statics = new List<Route>();
        this.dynamics = new List<Route>();
        this.regexes = new List<Route>();
        this.staticIndex = new Dictionary<string, Route>();
        this.hashSlots = null;
        this.hashMask = 0;
        this.flat = new List<Route>();
        this.statEntries = new List<RouteStatEntry>();
        this.routeStats = null;
    }

    public int Count() { return this.flat.Count; }

    // 注册一条路由并返回 Route（可继续 fluent 配置）。
    // 无 {param} 段的路由进静态桶并建哈希索引，其余进动态桶。
    public Route Add(string method, string pattern, HttpHandler handler) {
        Route r = new Route(method, pattern, handler);
        if (Router.IsStatic(pattern)) {
            this.statics.Add(r);
            Dictionary<string, Route> idx = this.staticIndex;
            idx[method + " " + pattern] = r;
            this.hashSlots = null;
        } else {
            this.dynamics.Add(r);
        }
        r.idx = this.flat.Count;
        this.flat.Add(r);
        return r;
    }

    // 注册一条正则路由并返回 Route（可继续 fluent 配置）。
    public Route AddRegex(string method, string pattern, HttpHandler handler) {
        Route r = new Route(method, pattern, handler, true);
        this.regexes.Add(r);
        r.idx = this.flat.Count;
        this.flat.Add(r);
        return r;
    }

    // 路由键哈希预计算与槽位映射。
    void HashRouteKeys() {
        this.statEntries = new List<RouteStatEntry>();
        for (int h = 0; h < this.flat.Count; h = h + 1) {
            string rk = this.flat[h].key;
            long hash = SharedTable.Hash(rk);
            this.statEntries.Add(new RouteStatEntry(rk, hash));
        }
    }

    // 新建统计表：每路由一行，hits 与 total_us 两列（容量为路由数+4）。
    SharedTable NewStatsTable() {
        SharedTable t = new SharedTable("", this.flat.Count + 4);
        t.KeySize(128);
        t.ColumnInt("hits");
        t.ColumnInt("total_us");
        return t;
    }

    void SeedStats(SharedTable t) {
        for (int i = 0; i < this.statEntries.Count; i = i + 1) {
            t.SetIntAt(this.statEntries[i].hash, "hits", 0);
            t.SetIntAt(this.statEntries[i].hash, "total_us", 0);
        }
    }

    void InitStatsShared() {
        if (this.flat.Count == 0) { return; }
        if (this.routeStats != null) { return; }
        this.HashRouteKeys();
        SharedTable t = this.NewStatsTable();
        if (!t.CreateAnonymous()) { return; }
        t.Label("web route stats");
        this.SeedStats(t);
        this.routeStats = t;
    }

    long StatsOsHandle() {
        if (this.routeStats == null) { return 0; }
        return this.routeStats.OsHandle();
    }

    void AttachStats(long osHandle) {
        if (this.flat.Count == 0 || osHandle == 0) { return; }
        this.HashRouteKeys();
        SharedTable t = SharedTable.Attach(osHandle);
        if (!t.IsOpen()) { return; }
        t.Label("web route stats");
        this.routeStats = t;
    }

    // computation.
    void RecordHit(int idx, long us) {
        if (this.routeStats == null) { return; }
        if (this.statEntries == null || idx < 0 || idx >= this.statEntries.Count) { return; }
        long key = this.statEntries[idx].hash;
        this.routeStats.IncrementAt(key, "hits", 1);
        this.routeStats.IncrementAt(key, "total_us", us);
    }

    public List<Route> All() {
        List<Route> outp = new List<Route>();
        int i = 0;
        for (; i < this.statics.Count; i = i + 1) { outp.Add(this.statics[i]); }
        i = 0;
        while (i < this.dynamics.Count) { outp.Add(this.dynamics[i]); i = i + 1; }
        i = 0;
        while (i < this.regexes.Count) { outp.Add(this.regexes[i]); i = i + 1; }
        return outp;
    }

    // 单个路由端点共享内存性能指标（路由、调用次数、平均微秒耗时）。
    public List<RouteHitDoc> Stats() {
        List<RouteHitDoc> outp = new List<RouteHitDoc>();
        if (this.routeStats == null) { return outp; }
        if (this.statEntries != null) {
            for (int i = 0; i < this.statEntries.Count; i = i + 1) {
                RouteStatEntry entry = this.statEntries[i];
                long hits = this.routeStats.GetIntAt(entry.hash, "hits");
                if (hits > 0) {
                    long totalUs = this.routeStats.GetIntAt(entry.hash, "total_us");
                    long avgUs = totalUs / hits;
                    RouteHitDoc o = new RouteHitDoc();
                    o.route = entry.key;
                    o.count = hits;
                    o.avg_us = avgUs;
                    outp.Add(o);
                }
            }
        }
        return outp;
    }

    public string StatsJson() {
        return Json.Serialize<List<RouteHitDoc>>(this.Stats());
    }

    // GET 快捷（= Add("GET", ...)）。
    public Route Get(string pattern, HttpHandler handler) { return this.Add("GET", pattern, handler); }
    // POST 快捷。
    public Route Post(string pattern, HttpHandler handler) { return this.Add("POST", pattern, handler); }
    // PUT 快捷。
    public Route Put(string pattern, HttpHandler handler) { return this.Add("PUT", pattern, handler); }
    // DELETE 快捷。
    public Route Delete(string pattern, HttpHandler handler) { return this.Add("DELETE", pattern, handler); }

    // 正则快捷
    public Route GetRegex(string pattern, HttpHandler handler) { return this.AddRegex("GET", pattern, handler); }
    public Route PostRegex(string pattern, HttpHandler handler) { return this.AddRegex("POST", pattern, handler); }
    public Route PutRegex(string pattern, HttpHandler handler) { return this.AddRegex("PUT", pattern, handler); }
    public Route DeleteRegex(string pattern, HttpHandler handler) { return this.AddRegex("DELETE", pattern, handler); }

    private static int HashKey(string method, string path) {
        int h = 0x811C9DC5;
        int i = 0;
        int n = method.Length;
        for (; i < n; i = i + 1) {
            h = ((h ^ (method[i] & 255)) * 16777619) & 1073741823;
        }
        h = ((h ^ 32) * 16777619) & 1073741823;
        i = 0;
        n = path.Length;
        while (i < n) {
            h = ((h ^ (path[i] & 255)) * 16777619) & 1073741823;
            i = i + 1;
        }
        return h;
    }

    void RebuildIndex() {
        int cap = 16;
        while (cap < this.statics.Count * 4) { cap = cap * 2; }
        List<int> slots = new List<int>();
        int i = 0;
        for (; i < cap; i = i + 1) { slots.Add(-1); }
        int mask = cap - 1;
        i = 0;
        while (i < this.statics.Count) {
            Route r = this.statics[i];
            int h = Router.HashKey(r.method, r.pattern) & mask;
            bool placed = false;
            while (!placed) {
                int si = slots[h];
                if (si < 0) {
                    slots[h] = i;
                    placed = true;
                } else {
                    Route other = this.statics[si];
                    if (other.method == r.method && other.pattern == r.pattern) {
                        slots[h] = i;  // re-registration: last wins
                        placed = true;
                    } else {
                        h = (h + 1) & mask;
                    }
                }
            }
            i = i + 1;
        }
        this.hashSlots = slots;
        this.hashMask = mask;
    }

    Route FindStatic(string method, string path) {
        if (this.hashSlots == null) { this.RebuildIndex(); }
        int mask = this.hashMask;
        int h = Router.HashKey(method, path) & mask;
        for (int guard = 0; guard <= mask; guard = guard + 1) {
            int si = this.hashSlots[h];
            if (si < 0) { return null; }
            Route r = this.statics[si];
            if (r.method == method && r.pattern == path) { return r; }
            h = (h + 1) & mask;
        }
        return null;
    }

    public Route Match(HttpContext ctx) {
        string method = ctx.method;
        string path = ctx.path;
        Route hit = this.FindStatic(method, path);
        if (hit != null) { return hit; }
        hit = this.FindStatic("*", path);
        if (hit != null) { return hit; }
        // 自动尾部斜杠容错：/about/company/ -> /about/company
        if (path.Length > 1 && path.EndsWith("/")) {
            string altPath = path.Substring(0, path.Length - 1);
            hit = this.FindStatic(method, altPath);
            if (hit != null) { return hit; }
            hit = this.FindStatic("*", altPath);
            if (hit != null) { return hit; }
        }

        // 动态分段路由
        if (this.dynamics.Count > 0) {
            List<string> segs = Router.SplitPath(path);
            for (int i = 0; i < this.dynamics.Count; i = i + 1) {
                Route r = this.dynamics[i];
                if (r.method == method || r.method == "*") {
                    if (ctx.routeParams == null) { ctx.routeParams = new StrMap(); }
                    if (Router.MatchRoute(r, segs, ctx.routeParams)) {
                        return r;
                    }
                    ctx.routeParams.Clear();
                }
            }
        }

        // 正则路由（支持命名捕获组及数字捕获组自动写入 ctx.routeParams）
        if (this.regexes.Count > 0) {
            for (int ri = 0; ri < this.regexes.Count; ri = ri + 1) {
                Route r = this.regexes[ri];
                if (r.method == method || r.method == "*") {
                    Match m = r.regex.Find(path);
                    if (m.Success()) {
                        if (ctx.routeParams == null) { ctx.routeParams = new StrMap(); }
                        if (r.regexGroupNames != null) {
                            for (int gi = 0; gi < r.regexGroupNames.Count; gi = gi + 1) {
                                string gname = r.regexGroupNames[gi];
                                if (gname.Length > 0) {
                                    int gnum = r.regex.GroupNumber(gname);
                                    if (gnum >= 0 && m.GroupSuccess(gnum)) {
                                        ctx.routeParams.Set(gname, m.Group(gnum));
                                    }
                                }
                            }
                        }
                        for (int gi = 1; gi < m.GroupCount(); gi = gi + 1) {
                            if (m.GroupSuccess(gi)) {
                                ctx.routeParams.Set(Convert.ToString(gi), m.Group(gi));
                            }
                        }
                        return r;
                    }
                }
            }
        }
        return null;
    }

    public bool PathExists(string path) {
        int i = 0;
        for (; i < this.statics.Count; i = i + 1) {
            if (this.statics[i].pattern == path) { return true; }
        }
        if (path.Length > 1 && path.EndsWith("/")) {
            string altPath = path.Substring(0, path.Length - 1);
            for (i = 0; i < this.statics.Count; i = i + 1) {
                if (this.statics[i].pattern == altPath) { return true; }
            }
        }
        if (this.dynamics.Count > 0) {
            List<string> segs = Router.SplitPath(path);
            StrMap scratch = new StrMap();
            i = 0;
            while (i < this.dynamics.Count) {
                if (Router.MatchRoute(this.dynamics[i], segs, scratch)) { return true; }
                i = i + 1;
            }
        }
        if (this.regexes.Count > 0) {
            for (int ri = 0; ri < this.regexes.Count; ri = ri + 1) {
                if (this.regexes[ri].regex.IsMatch(path)) { return true; }
            }
        }
        return false;
    }

    // 模式不含 {param} 段（即无 '{'）时为静态路由。
    public static bool IsStatic(string pattern) {
        for (int i = 0; i < pattern.Length; i = i + 1) {
            if ((pattern[i] & 255) == 123) { return false; }  // '{'
        }
        return true;
    }

    // 段数相等且逐段相等；利用预编译的 paramNames 零分配写入 into。
    public static bool MatchRoute(Route r, List<string> segs, StrMap into) {
        List<string> pat = r.segs;
        if (pat.Count != segs.Count) { return false; }
        List<string> pnames = r.paramNames;
        for (int i = 0; i < pat.Count; i = i + 1) {
            string pname = pnames[i];
            if (pname.Length > 0) {
                into.Set(pname, segs[i]);
            } else if (pat[i] != segs[i]) {
                return false;
            }
        }
        return true;
    }

    // 段数相等且逐段相等；{param} 段匹配任意段并把值写入 into。
    public static bool MatchSegs(List<string> pat, List<string> segs, StrMap into) {
        if (pat.Count != segs.Count) { return false; }
        for (int i = 0; i < pat.Count; i = i + 1) {
            string p = pat[i];
            if (p.Length > 2 && (p[0] & 255) == 123
                && (p[p.Length - 1] & 255) == 125) {  // '{' '}'
                into.Set(p.Substring(1, p.Length - 2), segs[i]);
            } else if (p != segs[i]) {
                return false;
            }
        }
        return true;
    }

    // 按 '/' 切分并去掉空段（"/a//b/" -> ["a","b"]）。
    public static List<string> SplitPath(string path) {
        List<string> outp = new List<string>();
        int i = 0;
        int n = path.Length;
        while (i < n) {
            while (i < n && (path[i] & 255) == 47) { i = i + 1; }  // '/'
            int e = i;
            while (e < n && (path[e] & 255) != 47) { e = e + 1; }  // '/'
            if (e > i) { outp.Add(path.Substring(i, e - i)); }
            i = e;
        }
        return outp;
    }
}
