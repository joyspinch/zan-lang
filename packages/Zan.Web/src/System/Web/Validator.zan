using System;
using System.Collections.Generic;
using System.Json;

namespace System.Web;

// 请求参数链式校验器：支持链式添加校验规则并统一产出错误清单。
public class Validator {
    public List<string> errors;

    public Validator() { this.errors = new List<string>(); }

    // 值为空记一条 "<field> is required"（可链式）。
    public Validator Require(string val, string field) {
        if (val.Length == 0) { this.errors.Add(field + " is required"); }
        return this;
    }

    // 尚无任何错误时为真。
    public bool Ok() { return this.errors.Count == 0; }

    // 长度超过 max 记错误（可链式）。
    public Validator MaxLen(string val, int max, string field) {
        if (val.Length > max) {
            this.errors.Add(field + " exceeds " + Convert.ToString(max) + " chars");
        }
        return this;
    }

    // 非空且长度不足 min 记错误；空值跳过（可链式）。
    public Validator MinLen(string val, int min, string field) {
        if (val.Length > 0 && val.Length < min) {
            this.errors.Add(field + " is shorter than " + Convert.ToString(min) + " chars");
        }
        return this;
    }

    public Validator IsInt(string val, string field) {
        if (val.Length == 0) { return this; }
        int i = 0;
        if (val[0] == 45) { i = 1; }
        if (i >= val.Length) { this.errors.Add(field + " must be an integer"); return this; }
        bool ok = true;
        while (i < val.Length) {
            int c = val[i] & 255;
            if (c < 48 || c > 57) { ok = false; break; }
            i = i + 1;
        }
        if (!ok) { this.errors.Add(field + " must be an integer"); }
        return this;
    }

    public Validator OneOf(string val, string allowedCsv, string field) {
        if (val.Length == 0) { return this; }
        string csv = "," + allowedCsv + ",";
        if (!Validator.ContainsStr(csv, "," + val + ",")) {
            this.errors.Add(field + " is not an allowed value");
        }
        return this;
    }

    public static bool ContainsStr(string s, string pat) {
        if (s == null || pat == null) { return false; }
        return s.IndexOf(pat) >= 0;
    }

    // 错误列表的 JSON 数组。
    public string ErrorsJson() {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < this.errors.Count; i = i + 1) {
            arr.Append(JsonValue.NewStr(this.errors[i]));
        }
        return arr.ToJson();
    }

    // 客户端上传文件名路径遍历防御净化：剥离目录分隔符与恶意相对路径。
    public static string SafeFileName(string name) {
        if (name == null || name.Length == 0) { return "file"; }
        int slash1 = name.LastIndexOf("/");
        int slash2 = name.LastIndexOf("\\");
        int cut = slash1 > slash2 ? slash1 : slash2;
        string base_ = cut >= 0 ? name.Substring(cut + 1) : name;
        int blen = base_.Length;
        byte[] buf = new byte[blen];
        int outLen = 0;
        int prev = 0;
        for (int j = 0; j < blen; j = j + 1) {
            int c = base_[j] & 255;
            bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
                || (c >= 48 && c <= 57) || c == 46 || c == 95 || c == 45;
            if (ok && !(c == 46 && prev == 46)) {
                buf[outLen] = (byte)c;
                outLen = outLen + 1;
                prev = c;
            }
        }
        if (outLen == 0 || (outLen == 1 && buf[0] == 46)) { return "file"; }
        return buf.ToStr(0, outLen);
    }

    // 校验文件扩展名是否属于逗号分隔的安全白名单。
    public static bool ExtAllowed(string name, string allowedCsv) {
        if (name == null) { return false; }
        int dot = name.LastIndexOf(".");
        if (dot < 0 || dot == name.Length - 1) { return false; }
        string ext = name.Substring(dot + 1);
        string csv = "," + allowedCsv + ",";
        return Validator.ContainsStr(csv, "," + ext + ",");
    }
}
