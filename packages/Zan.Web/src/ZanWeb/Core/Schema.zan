using System;
using System.Data;
using System.Data.Orm;
using System.Security.Cryptography;
using System.Web;
using ZanWeb.Model.Sys;
using ZanWeb.Dao.Sys;
using ZanWeb.Security;

namespace ZanWeb.Core;

/* 表结构 + 种子数据，启动时由 ZanWeb.Boot 一次性应用。CodeFirst (SyncStructure) 读取数据库目录发 DDL，不做每次请求触发。种子带计数保护，重复启动不变。权限仅 seed 内置角色持有哪些 action，其余从路由表派生。业务表的种子经 OnSeed 挂点由应用侧注册——模型与 DAO 都在应用里，框架不预设任何业务。*/
async delegate bool SeedFn(IDbConnection db);

class Schema {
    /* 创建/更新全部表并填充种子数据。数据库不可达时返回 false，服务器仍启动。*/
    static async bool Ensure(DbContext ctx) {
        IDbConnection db = await ctx.Acquire();
        if (db == null) { return false; }
        try {
            /* SQLite 启用 WAL（其他引擎无操作）：多 worker 共享文件时避免写者阻塞读者。*/
            await DbSchema.UseWriteAheadLogAsync(db);
            /* 编译期已知所有 [Table] 类，一行调用覆盖全部，新模型无需补行。*/
            await db.SyncStructureAllAsync();

            if (!await Schema.SeedAdmin(db)) { return false; }
            if (!await Schema.SeedRoles(db)) { return false; }
            if (!await Schema.SeedDepartments(db)) { return false; }
            if (!await Schema.SeedDicts(db)) { return false; }
            if (!await Schema.SeedSettings(db)) { return false; }
            if (!await Schema.SeedJobs(db)) { return false; }
            if (!await Schema.RunSeed(db)) { return false; }
            return true;
        } finally {
            ctx.Release(db);
        }
    }

    /* 空库创建 bootstrap 账号；密码为开发用，部署前必须修改。*/
    static async bool SeedAdmin(IDbConnection db) {
        SysUserDao users = new SysUserDao(db);
        int have = await users.Count();
        if (have > 0) { return true; }
        SysUser admin = new SysUser();
        admin.username = "admin";
        admin.passwordSalt = "";
        admin.passwordHash = AuthUser.NewHash("admin1234");
        admin.nickname = "系统管理员";
        admin.status = AuthUser.Active;
        admin.isSuper = 1;
        admin.tokenVersion = 1;
        admin.createdAt = WebApp.NowSeconds();
        int _id = await users.Insert(admin);
        return _id > 0;
    }

    /* 两个内置角色：admin（全部管理）和 editor（仅内容管理）。bootstrap 账号绕过角色表，防止误操作锁死。具体权限由 SyncRoleGrants 从路由表填充。*/
    static async bool SeedRoles(IDbConnection db) {
        int have = await db.Select<SysRole>().CountAsync();
        if (have > 0) { return true; }
        int _admin = await Schema.AddRole(db, "系统管理员", "admin", 1,
            "除超级管理员外的全部管理权限", DataScope.RoleAll);
        int _editor = await Schema.AddRole(db, "内容编辑", "editor", 10,
            "只能管理博客内容", DataScope.RoleAll);
        return _admin > 0 && _editor > 0;
    }

    static async int AddRole(IDbConnection db, string name, string code, int rank,
                          string description, int dataScope) {
        SysRole r = new SysRole();
        r.name = name;
        r.code = code;
        r.rank = rank;
        r.status = 1;
        r.description = description;
        /* 旧行缺此列则读作 0，DataScope 视为 全部数据，升级不缩权。*/
        r.dataScope = dataScope;
        r.scopeDepts = "";
        r.createdAt = WebApp.NowSeconds();
        r.updatedAt = r.createdAt;
        return await db.Insert<SysRole>(r).ExecuteIdentityAsync();
    }

    static async bool Grant(IDbConnection db, int roleId, string screen, int mask,
                            long now) {
        SysRoleGrant g = new SysRoleGrant();
        g.roleId = roleId;
        g.action = screen;
        g.mask = mask;
        g.createdAt = now;
        int _id = await db.Insert<SysRoleGrant>(g).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool SeedDepartments(IDbConnection db) {
        int have = await db.Select<SysDepartment>().CountAsync();
        if (have > 0) { return true; }
        if (!await Schema.AddDept(db, 0, "总部", "root", 1)) { return false; }
        if (!await Schema.AddDept(db, 1, "技术部", "tech", 2)) { return false; }
        return await Schema.AddDept(db, 1, "内容运营", "content", 3);
    }

    static async bool AddDept(IDbConnection db, int parentId, string name,
                           string code, int sortOrder) {
        SysDepartment d = new SysDepartment();
        d.parentId = parentId;
        d.name = name;
        d.code = code;
        d.leaderUserId = 0;
        d.sortOrder = sortOrder;
        d.status = 1;
        int _id = await db.Insert<SysDepartment>(d).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool SeedDicts(IDbConnection db) {
        int have = await db.Select<SysDictType>().CountAsync();
        if (have > 0) { return true; }
        if (!await Schema.AddDictType(db, "user_status", "账号状态")) { return false; }
        if (!await Schema.AddDictItem(db, "user_status", "1", "启用", 1)) { return false; }
        if (!await Schema.AddDictItem(db, "user_status", "0", "禁用", 2)) { return false; }
        if (!await Schema.AddDictType(db, "post_status", "文章状态")) { return false; }
        if (!await Schema.AddDictItem(db, "post_status", "1", "已发布", 1)) { return false; }
        return await Schema.AddDictItem(db, "post_status", "0", "草稿", 2);
    }

    static async bool AddDictType(IDbConnection db, string code, string name) {
        SysDictType t = new SysDictType();
        t.code = code;
        t.name = name;
        t.status = 1;
        t.description = "";
        t.createdAt = WebApp.NowSeconds();
        t.updatedAt = t.createdAt;
        int _id = await db.Insert<SysDictType>(t).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool AddDictItem(IDbConnection db, string typeCode, string value,
                            string label, int sortOrder) {
        SysDictItem it = new SysDictItem();
        it.typeCode = typeCode;
        it.value = value;
        it.label = label;
        it.sortOrder = sortOrder;
        it.status = 1;
        it.createdAt = WebApp.NowSeconds();
        it.updatedAt = it.createdAt;
        int _id = await db.Insert<SysDictItem>(it).ExecuteIdentityAsync();
        return _id > 0;
    }

