        if (!await Schema.AddSetting(db, "基本", "site.description", "站点描述", "",
            "textarea", "写入首页 meta description", 3)) { return false; }
        if (!await Schema.AddSetting(db, "基本", "site.keywords", "关键词", "Zan,编译型语言,ZanWeb",
            "text", "逗号分隔，写入 meta keywords", 4)) { return false; }
        if (!await Schema.AddSetting(db, "备案", "site.icp", "ICP 备案号", "",
            "text", "显示在页脚并链接到工信部查询页", 10)) { return false; }
        if (!await Schema.AddSetting(db, "备案", "site.police", "公安备案号", "",
            "text", "", 11)) { return false; }
        if (!await Schema.AddSetting(db, "页脚", "site.copyright", "版权信息", "",
            "text", "", 20)) { return false; }
        if (!await Schema.AddSetting(db, "页脚", "site.contact", "联系方式", "",
            "text", "", 21)) { return false; }
        if (!await Schema.AddSetting(db, "统计", "site.analytics", "统计代码", "",
            "textarea", "原样输出到页面底部，只接受可信来源的脚本", 30)) { return false; }
        return await Schema.SeedFeatureSettings(db);
    }

