using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/* 一次产生变更的写操作，由执行动作记录。读操作不记录，它们是流量主体，无审计意义。 */
[Table(Name = "sys_operation_log")]
class OperationLog {
    [Column(IsIdentity = true)]
    int id;

    int userId;

    [Column(StringLength = 64)]
    string username;

    /* 所做操作，格式为动作权限码（如 "sys:user:save"），与授权记录对齐。 */
    [Column(StringLength = 128)]
    string action;

    [Column(StringLength = 128)]
    string title;

    [Column(StringLength = 8)]
    string method;

    [Column(StringLength = 255)]
    string path;

    /* 写操作影响的行，纯文本（如 "#7 admin"）。 */
    [Column(StringLength = 255)]
    string target;

    [Column(StringLength = 64)]
    string ip;

    /* 1=写操作成功。 */
    int ok;

    [Column(StringLength = 255)]
    string message;

    long createdAt;
}