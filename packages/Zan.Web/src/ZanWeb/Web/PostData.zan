using System;
using System.Json;
using System.Collections.Generic;

namespace ZanWeb.Web;

/* 前端表格 POST 请求体解析（对齐 adminUI POST /list 契约） */
public class PostData {
    public int formId;
    public int page;
    public int pageSize;
    public string tab;
    public string query;
    public string orderField;
    public string orderDirection;
    public string search;
    public Dictionary<string, string> filters;

    public PostData() {
        this.formId = 0;
        this.page = 1;
        this.pageSize = 20;
        this.tab = "";
        this.query = "";
        this.orderField = "";
        this.orderDirection = "";
        this.search = "";
        this.filters = new Dictionary<string, string>();
    }

    public static PostData FromJson(string jsonStr) {
        PostData post = new PostData();
        if (jsonStr == null || jsonStr.Length == 0) {
            return post;
        }
        try {
            JsonValue root = JsonValue.Parse(jsonStr);
            return PostData.FromJsonValue(root);
        } catch {
            return post;
        }
    }

    public static PostData FromJsonValue(JsonValue root) {
        PostData post = new PostData();
        if (root == null) { return post; }

        post.page = root.Int("page", 1);
        post.pageSize = root.Int("pageSize", 20);
        post.tab = root.Str("tab", "");
        post.search = root.Str("search", "");
        post.orderField = root.Str("orderField", "");
        string ord = root.Str("orderDirection", "");
        if (ord.Length == 0) {
            ord = root.Str("order", "");
        }
        post.orderDirection = ord;

        // 解析 query 或 filters 字典
        if (root.Has("query")) {
            JsonValue qVal = root.Get("query");
            if (qVal != null) {
                if (qVal.IsString()) {
                    string qStr = qVal.AsString("");
                    post.query = qStr;
                    if (qStr.Length > 0 && qStr.StartsWith("{")) {
                        try {
                            JsonValue qObj = JsonValue.Parse(qStr);
                            PostData.ExtractDict(qObj, post.filters);
                        } catch {}
                    }
                } else if (qVal.IsObject()) {
                    PostData.ExtractDict(qVal, post.filters);
                }
            }
        }
        if (root.Has("filters")) {
            JsonValue fVal = root.Get("filters");
            if (fVal != null && fVal.IsObject()) {
                PostData.ExtractDict(fVal, post.filters);
            }
        }

        return post;
    }

    static void ExtractDict(JsonValue obj, Dictionary<string, string> dict) {
        if (obj == null) { return; }
        for (int i = 0; i < obj.Count(); i = i + 1) {
            string key = obj.KeyAt(i);
            JsonValue val = obj.ValAt(i);
            if (val != null && !val.IsNull()) {
                if (val.IsString()) {
                    dict[key] = val.AsString("");
                } else if (val.IsNumber()) {
                    dict[key] = Convert.ToString(val.AsDouble(0.0));
                } else if (val.IsBool()) {
                    dict[key] = val.AsBool(false) ? "1" : "0";
                } else {
                    dict[key] = val.ToJson();
                }
            }
        }
    }
}

/* 单字段及批量字段编辑请求体解析（对齐 adminUI POST /field /batchfield /delete /batchdelete 契约） */
public class FieldPostData {
    public int id;
    public List<int> ids;
    public string field;
    public string value;

    public FieldPostData() {
        this.id = 0;
        this.ids = new List<int>();
        this.field = "";
        this.value = "";
    }

    public static FieldPostData FromJson(string jsonStr) {
        FieldPostData res = new FieldPostData();
        if (jsonStr == null || jsonStr.Length == 0) { return res; }
        try {
            JsonValue root = JsonValue.Parse(jsonStr);
            if (root != null) {
                res.id = root.Int("id", 0);
                if (res.id > 0) { res.ids.Add(res.id); }

                if (root.Has("ids")) {
                    JsonValue arr = root.Get("ids");
                    if (arr != null && arr.IsArray()) {
                        for (int i = 0; i < arr.Count(); i = i + 1) {
                            JsonValue item = arr.At(i);
                            if (item != null) {
                                int parsedId = item.AsInt(0);
                                if (parsedId > 0 && !res.ids.Contains(parsedId)) {
                                    res.ids.Add(parsedId);
                                }
                            }
                        }
                    }
                }
                res.field = root.Str("field", "");
                JsonValue v = root.Get("value");
                if (v != null) {
                    if (v.IsString()) { res.value = v.AsString(""); }
                    else if (v.IsNumber()) { res.value = Convert.ToString(v.AsDouble(0.0)); }
                    else if (v.IsBool()) { res.value = v.AsBool(false) ? "1" : "0"; }
                    else { res.value = v.ToJson(); }
                }
            }
        } catch {}
        return res;
    }
}
