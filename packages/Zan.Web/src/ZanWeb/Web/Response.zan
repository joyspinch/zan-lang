using System;
using System.Text;
using System.Json;
using System.Collections.Generic;

namespace ZanWeb.Web;

/* adminUI / OneAdmin 通用响应信封封装：
 * {
 *   "resp_code": "0000",
 *   "status": 200,
 *   "msg": "操作成功",
 *   "url": "",
 *   "dynamicToken": "",
 *   "t": 0,
 *   "data": ...
 * }
 */
public class ResponseEnvelope {
    public static string Ok(string dataJson, string msg, string traceId) {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"resp_code\":\"0000\",\"status\":200,\"msg\":\"");
        sb.Append(Escape(msg.Length > 0 ? msg : "操作成功"));
        sb.Append("\",\"url\":\"\",\"dynamicToken\":\"\",\"t\":0,\"data\":");
        sb.Append(dataJson.Length > 0 ? dataJson : "null");
        if (traceId.Length > 0) {
            sb.Append(",\"traceId\":\"");
            sb.Append(Escape(traceId));
            sb.Append("\"");
        }
        sb.Append("}");
        return sb.ToString();
    }

    public static string Fail(int status, string respCode, string msg, string traceId) {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"resp_code\":\"");
        sb.Append(Escape(respCode.Length > 0 ? respCode : "0004"));
        sb.Append("\",\"status\":");
        sb.Append(Convert.ToString(status > 0 ? status : 400));
        sb.Append(",\"msg\":\"");
        sb.Append(Escape(msg));
        sb.Append("\",\"url\":\"\",\"dynamicToken\":\"\",\"t\":0,\"data\":null");
        if (traceId.Length > 0) {
            sb.Append(",\"traceId\":\"");
            sb.Append(Escape(traceId));
            sb.Append("\"");
        }
        sb.Append("}");
        return sb.ToString();
    }

    public static string Escape(string s) {
        if (s == null || s.Length == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "\"") { sb.Append("\\\""); }
            else if (ch == "\\") { sb.Append("\\\\"); }
            else if (ch == "\n") { sb.Append("\\n"); }
            else if (ch == "\r") { sb.Append("\\r"); }
            else if (ch == "\t") { sb.Append("\\t"); }
            else { sb.Append(ch); }
        }
        return sb.ToString();
    }
}

/* 分页列表应答结构：{ "total": 100, "page": 1, "pageSize": 20, "data": [...] } */
public class ResponseList<T> {
    public long total;
    public int page;
    public int pageSize;
    public List<T> data;

    public ResponseList() {
        this.total = 0;
        this.page = 1;
        this.pageSize = 20;
        this.data = new List<T>();
    }

    public ResponseList(long total, int page, int pageSize, List<T> data) {
        this.total = total;
        this.page = page;
        this.pageSize = pageSize;
        this.data = data != null ? data : new List<T>();
    }

    public string ToJson() {
        return this.ToJson("[]");
    }

    public string ToJson(string dataJson) {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"total\":");
        sb.Append(Convert.ToString(this.total));
        sb.Append(",\"page\":");
        sb.Append(Convert.ToString(this.page));
        sb.Append(",\"pageSize\":");
        sb.Append(Convert.ToString(this.pageSize));
        sb.Append(",\"data\":");
        if (dataJson != null && dataJson.Length > 0) {
            sb.Append(dataJson);
        } else {
            sb.Append("[]");
        }
        sb.Append("}");
        return sb.ToString();
    }
}
