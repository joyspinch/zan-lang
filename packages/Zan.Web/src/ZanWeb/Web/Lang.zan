using System;
using System.IO;
using System.Json;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Security;
using ZanWeb.Services;

namespace ZanWeb.Web;

/* 站点多语言：以中文原文为键的轻量翻译层。语言取自站点设置
   site.language（zh-CN 原文直出；其他语言加载 i18n/{lang}.json
   扁平键值包，缺词条回落中文原文，界面永不残缺）。语言包随部署
   放在 i18n/ 下，换语言即换设置值，无需重编译；包缺失时全部回落
   中文，等价于未翻译。 */
class Lang {
    /* 当前已加载的语言与其键值包；zh-CN 时包保持为空（直出）。 */
    static string loaded = "zh-CN";
    static StrMap pack = new StrMap();

    /* 允许的语言；新增语言 = 提供 i18n/{lang}.json 并在此登记。 */
    static bool Known(string lang) {
        return lang == "zh-CN" || lang == "en-US";
    }

    /* 屏幕渲染前调用（Layout）：读设置并按需换包。设置有内存缓存且
       保存站点设置时 Forget，故改语言最迟下一次请求生效。 */
    static async void Load() {
        string lang = await Settings.Get(SettingKeys.SiteLanguage, "zh-CN");
        if (!Lang.Known(lang)) { lang = "zh-CN"; }
        if (lang == Lang.loaded) { return; }
        Lang.pack = new StrMap();
        if (lang != "zh-CN") {
            /* 语言包随 wwwroot 发布（--publish 整目录携带），路径相对工作目录。 */
            string path = "wwwroot/i18n/" + lang + ".json";
            if (File.Exists(path)) {
                JsonValue root = JsonValue.ParseLenient(File.ReadAllText(path));
                if (root != null) {
                    for (int i = 0; i < root.Count(); i = i + 1) {
                        JsonValue v = root.ValAt(i);
                        if (v != null && v.kind == 3) {
                            Lang.pack.Set(root.KeyAt(i), v.strVal);
                        }
                    }
                }
            }
        }
        Lang.loaded = lang;
    }

    /* 翻译一条 UI 文案；zh-CN 或包中无此词条时原样返回。 */
    public static string T(string zh) {
        if (Lang.loaded == "zh-CN") { return zh; }
        string alt = Lang.pack.Get(zh);
        if (alt.Length > 0) { return alt; }
        return zh;
    }

    /* 当前生效语言代码，如 zh-CN、en-US */
    public static string Current() {
        return Lang.loaded;
    }
}

/// <summary>
/// 强类型多语言字符串容器：支持字段级多语言存储与按当前语种自适应取值。
/// </summary>
public class I18nString {
    public string zh;
    public string en;

    public I18nString() {
        this.zh = "";
        this.en = "";
    }

    public I18nString(string zh, string en) {
        this.zh = zh;
        this.en = en;
    }

    public string Get(string lang) {
        if (lang == "en" || lang == "en-US") {
            if (this.en != null && this.en.Length > 0) { return this.en; }
            return this.zh;
        }
        return this.zh;
    }

    public string Value() {
        return this.Get(Lang.Current());
    }
}
