using System;
using System.Text;
using System.Collections.Generic;

namespace ZanWeb.Web;

/* adminUI ZanTable / OneAdmin TableConfig 前端表格元数据配置 */
public class TableConfig {
    public TableConf conf;
    public List<TableColumn> columns;
    public List<TableFilter> filters;
    public List<TableColumnButton> tools;
    public List<TableTab> tabs;

    public TableConfig() {
        this.conf = new TableConf();
        this.columns = new List<TableColumn>();
        this.filters = new List<TableFilter>();
        this.tools = new List<TableColumnButton>();
        this.tabs = new List<TableTab>();
    }

    public TableConfig AddColumn(string field, string headerName, string type, bool sortable, bool editable, int width) {
        TableColumn col = new TableColumn();
        col.field = field;
        col.headerName = headerName;
        col.type = type;
        col.sortable = sortable;
        col.editable = editable;
        col.width = width;
        this.columns.Add(col);
        return this;
    }

    public TableConfig AddColumnOpt(string field, string headerName, string type, string options, int width) {
        TableColumn col = new TableColumn();
        col.field = field;
        col.headerName = headerName;
        col.type = type;
        col.options = options;
        col.width = width;
        this.columns.Add(col);
        return this;
    }

    public TableConfig AddFilter(string name, string title, string type, string placeholder) {
        TableFilter f = new TableFilter();
        f.name = name;
        f.title = title;
        f.type = type;
        f.placeholder = placeholder;
        this.filters.Add(f);
        return this;
    }

    public TableConfig AddFilterSelect(string name, string title, string options) {
        TableFilter f = new TableFilter();
        f.name = name;
        f.title = title;
        f.type = "Select";
        f.options = options;
        this.filters.Add(f);
        return this;
    }

    public TableConfig AddFilterRemote(string name, string title, string remoteUrl) {
        TableFilter f = new TableFilter();
        f.name = name;
        f.title = title;
        f.type = "Select";
        f.remote = remoteUrl;
        this.filters.Add(f);
        return this;
    }

    public TableConfig AddTool(string name, string action, string type, string url, string confirm) {
        TableColumnButton b = new TableColumnButton();
        b.name = name;
        b.action = action;
        b.type = type;
        b.url = url;
        b.confirm = confirm;
        this.tools.Add(b);
        return this;
    }

    public TableConfig AddTab(string name, string index, string icon) {
        TableTab t = new TableTab();
        t.name = name;
        t.index = index;
        t.icon = icon;
        this.tabs.Add(t);
        return this;
    }

    public string ToJson() {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"conf\":");
        sb.Append(this.conf != null ? this.conf.ToJson() : "{}");
        sb.Append(",\"columns\":[");
        for (int i = 0; i < this.columns.Count; i = i + 1) {
            if (i > 0) { sb.Append(","); }
            sb.Append(this.columns[i].ToJson());
        }
        sb.Append("],\"filters\":[");
        for (int i = 0; i < this.filters.Count; i = i + 1) {
            if (i > 0) { sb.Append(","); }
            sb.Append(this.filters[i].ToJson());
        }
        sb.Append("],\"tools\":[");
        for (int i = 0; i < this.tools.Count; i = i + 1) {
            if (i > 0) { sb.Append(","); }
            sb.Append(this.tools[i].ToJson());
        }
        sb.Append("],\"tabs\":[");
        for (int i = 0; i < this.tabs.Count; i = i + 1) {
            if (i > 0) { sb.Append(","); }
            sb.Append(this.tabs[i].ToJson());
        }
        sb.Append("]}");
        return sb.ToString();
    }
}

public class TableConf {
    public string tabMode;
    public bool showPages;
    public int pageSize;
    public string pageSizes;
    public bool treeData;
    public bool local;
    public bool import;
    public bool export;
    public string innerKey;
    public string innerName;
    public string component;

    public TableConf() {
        this.tabMode = "tags";
        this.showPages = true;
        this.pageSize = 20;
        this.pageSizes = "10,20,50,100";
        this.treeData = false;
        this.local = false;
        this.import = false;
        this.export = false;
        this.innerKey = "id";
        this.innerName = "标题";
        this.component = "vlist/index.vue";
    }

    public string ToJson() {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"tabMode\":\"");
        sb.Append(this.tabMode);
        sb.Append("\",\"showPages\":");
        sb.Append(this.showPages ? "true" : "false");
        sb.Append(",\"pageSize\":");
        sb.Append(Convert.ToString(this.pageSize));
        sb.Append(",\"pageSizes\":\"");
        sb.Append(this.pageSizes);
        sb.Append("\",\"treeData\":");
        sb.Append(this.treeData ? "true" : "false");
        sb.Append(",\"local\":");
        sb.Append(this.local ? "true" : "false");
        sb.Append(",\"import\":");
        sb.Append(this.import ? "true" : "false");
        sb.Append(",\"export\":");
        sb.Append(this.export ? "true" : "false");
        sb.Append(",\"innerKey\":\"");
        sb.Append(this.innerKey);
        sb.Append("\",\"innerName\":\"");
        sb.Append(ResponseEnvelope.Escape(this.innerName));
        sb.Append("\",\"component\":\"");
        sb.Append(this.component);
        sb.Append("\"}");
        return sb.ToString();
    }
}

public class TableColumn {
    public string headerName;
    public string field;
    public string type;
    public bool sortable;
    public bool editable;
    public int width;
    public string options;

    public TableColumn() {
        this.headerName = "";
        this.field = "";
        this.type = "text";
        this.sortable = false;
        this.editable = false;
        this.width = 100;
        this.options = "";
    }

    public string ToJson() {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"headerName\":\"");
        sb.Append(ResponseEnvelope.Escape(this.headerName));
        sb.Append("\",\"field\":\"");
        sb.Append(ResponseEnvelope.Escape(this.field));
        sb.Append("\",\"type\":\"");
        sb.Append(ResponseEnvelope.Escape(this.type));
        sb.Append("\",\"sortable\":");
        sb.Append(this.sortable ? "true" : "false");
        sb.Append(",\"editable\":");
        sb.Append(this.editable ? "true" : "false");
        sb.Append(",\"width\":");
        sb.Append(Convert.ToString(this.width));
        if (this.options != null && this.options.Length > 0) {
            sb.Append(",\"options\":\"");
            sb.Append(ResponseEnvelope.Escape(this.options));
            sb.Append("\"");
        }
        sb.Append("}");
        return sb.ToString();
    }
}

public class TableFilter {
    public string name;
    public string title;
    public string type;
    public string placeholder;
    public string options;
    public string remote;

    public TableFilter() {
        this.name = "";
        this.title = "";
        this.type = "Input";
        this.placeholder = "";
        this.options = "";
        this.remote = "";
    }

    public string ToJson() {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"name\":\"");
        sb.Append(ResponseEnvelope.Escape(this.name));
        sb.Append("\",\"title\":\"");
        sb.Append(ResponseEnvelope.Escape(this.title));
        sb.Append("\",\"type\":\"");
        sb.Append(ResponseEnvelope.Escape(this.type));
        sb.Append("\"");
        if (this.placeholder != null && this.placeholder.Length > 0) {
            sb.Append(",\"placeholder\":\"");
            sb.Append(ResponseEnvelope.Escape(this.placeholder));
            sb.Append("\"");
        }
        if (this.options != null && this.options.Length > 0) {
            sb.Append(",\"options\":\"");
            sb.Append(ResponseEnvelope.Escape(this.options));
            sb.Append("\"");
        }
        if (this.remote != null && this.remote.Length > 0) {
            sb.Append(",\"remote\":\"");
            sb.Append(ResponseEnvelope.Escape(this.remote));
            sb.Append("\"");
        }
        sb.Append("}");
        return sb.ToString();
    }
}

public class TableColumnButton {
    public string name;
    public string field;
    public string action;
    public string type;
    public string url;
    public string confirm;
    public string width;
    public string height;

    public TableColumnButton() {
        this.name = "";
        this.field = "";
        this.action = "";
        this.type = "default";
        this.url = "";
        this.confirm = "";
        this.width = "450px";
        this.height = "300px";
    }

    public string ToJson() {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"name\":\"");
        sb.Append(ResponseEnvelope.Escape(this.name));
        sb.Append("\",\"field\":\"");
        sb.Append(ResponseEnvelope.Escape(this.field));
        sb.Append("\",\"action\":\"");
        sb.Append(ResponseEnvelope.Escape(this.action));
        sb.Append("\",\"type\":\"");
        sb.Append(ResponseEnvelope.Escape(this.type));
        sb.Append("\"");
        if (this.url != null && this.url.Length > 0) {
            sb.Append(",\"url\":\"");
            sb.Append(ResponseEnvelope.Escape(this.url));
            sb.Append("\"");
        }
        if (this.confirm != null && this.confirm.Length > 0) {
            sb.Append(",\"confirm\":\"");
            sb.Append(ResponseEnvelope.Escape(this.confirm));
            sb.Append("\"");
        }
        sb.Append(",\"width\":\"");
        sb.Append(this.width);
        sb.Append("\",\"height\":\"");
        sb.Append(this.height);
        sb.Append("\"}");
        return sb.ToString();
    }
}

public class TableTab {
    public string name;
    public string index;
    public string icon;

    public TableTab() {
