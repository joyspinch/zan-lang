using System;
using System.Data;
using System.Data.Sqlite;
using System.Data.Orm;
using System.Collections.Generic;
using ZanWeb.Web;

namespace ZanWeb.Dao;

public class BaseDao<TModel> {
    protected IDbConnection db;
    protected AppController host;
    protected string tableName;

    public BaseDao(AppController host, string tableName) {
        this.host = host;
        this.tableName = tableName;
    }

    public BaseDao(IDbConnection db, string tableName) {
        this.db = db;
        this.tableName = tableName;
    }

    public IDbConnection GetDb() {
        if (this.db != null) { return this.db; }
        if (this.host != null) { return this.host.__Conn(); }
        return null;
    }

    public string TableName() {
        return this.tableName;
    }

    public DbTableQuery Query() {
        IDbConnection conn = this.GetDb();
        if (conn == null) { return null; }
        return DbTable.Of(conn, this.tableName).Query();
    }

    public async int UpdateFieldAsync(int id, string field, string value) {
        IDbConnection conn = this.GetDb();
        if (conn == null) { return 0; }
        DbValues patch = new DbValues();
        patch.Set(field, value);
        return await DbTable.Of(conn, this.tableName).UpdateAsync(patch, "id", id);
    }

    public async int BatchUpdateFieldAsync(List<int> ids, string field, string value) {
        IDbConnection conn = this.GetDb();
        if (conn == null || ids == null || ids.Count == 0) { return 0; }
        DbValues patch = new DbValues();
        patch.Set(field, value);
        return await DbTable.Of(conn, this.tableName).Query().WhereIn("id", ids).ExecuteUpdateAsync(patch);
    }

    public async int DeleteByIdAsync(int id) {
        IDbConnection conn = this.GetDb();
        if (conn == null) { return 0; }
        return await DbTable.Of(conn, this.tableName).DeleteAsync("id", id);
    }

    public async int DeleteByIdsAsync(List<int> ids) {
        IDbConnection conn = this.GetDb();
        if (conn == null || ids == null || ids.Count == 0) { return 0; }
        return await DbTable.Of(conn, this.tableName).Query().WhereIn("id", ids).ExecuteDeleteAsync();
    }

    public async long CountAsync() {
        IDbConnection conn = this.GetDb();
        if (conn == null) { return 0; }
        return await DbTable.Of(conn, this.tableName).Query().CountAsync();
    }

    public async DbResult QueryPageAsync(PostData post) {
        IDbConnection conn = this.GetDb();
        if (conn == null) { return null; }
        DbTableQuery q = DbTable.Of(conn, this.tableName).Query();
        if (post != null) {
            if (post.orderField != null && post.orderField.Length > 0) {
                if (post.orderDirection == "desc" || post.orderDirection == "descending") {
                    q.OrderByDesc(post.orderField);
                } else {
                    q.OrderBy(post.orderField);
                }
            }
            if (post.filters != null) {
                foreach (string k in post.filters.Keys) {
                    string v = post.filters[k];
                    if (v != null && v.Length > 0) {
                        q.WhereEq(k, v);
                    }
                }
            }
            int page = post.page > 0 ? post.page : 1;
            int pageSize = post.pageSize > 0 ? post.pageSize : 20;
            int skip = (page - 1) * pageSize;
            return await q.Page(pageSize, skip).ToResultAsync();
        }
        return await q.Page(20, 0).ToResultAsync();
    }
}
