using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;
using ZanWeb.Web;

namespace ZanWeb.Dao;

/* sys_setting 的数据读写网关 */
class SysSiteSettingDao {
    IDbConnection db;

    SysSiteSettingDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    SysSiteSettingDao(IDbConnection db) {
        this.db = db;
    }

    async SysSiteSetting ById(int id) {
        return await this.db.Select<SysSiteSetting>().Where(a => a.id == id).FirstAsync();
    }

    async SysSiteSetting ByName(string name) {
        return await this.db.Select<SysSiteSetting>().Where(a => a.name == name).FirstAsync();
    }

    async List<SysSiteSetting> All() {
        return await this.db.Select<SysSiteSetting>().OrderBy(a => a.sortOrder).ToListAsync();
    }

    async List<SysSiteSetting> ByGroupName(string groupName) {
        return await this.db.Select<SysSiteSetting>()
            .Where(a => a.groupName == groupName)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async int SetValue(string name, string value) {
        return await this.db.Update<SysSiteSetting>()
            .Set(a => a.value, value)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.name == name)
            .ExecuteAffrowsAsync();
    }

    async int UpdateValueById(int id, string value, long updatedAt) {
        return await this.db.Update<SysSiteSetting>()
            .Set(a => a.value, value)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Insert(SysSiteSetting s) {
        return await this.db.Insert<SysSiteSetting>(s).ExecuteIdentityAsync();
    }
}
