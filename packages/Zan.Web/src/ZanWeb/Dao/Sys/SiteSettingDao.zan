using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* sys_setting 的数据读写网关 */
class SiteSettingDao {
    IDbConnection db;

    SiteSettingDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    SiteSettingDao(IDbConnection db) {
        this.db = db;
    }

    async SiteSetting ById(int id) {
        return await this.db.Select<SiteSetting>().Where(a => a.id == id).FirstAsync();
    }

    async SiteSetting ByName(string name) {
        return await this.db.Select<SiteSetting>().Where(a => a.name == name).FirstAsync();
    }

    async List<SiteSetting> All() {
        return await this.db.Select<SiteSetting>().OrderBy(a => a.sortOrder).ToListAsync();
    }

    async List<SiteSetting> ByGroupName(string groupName) {
        return await this.db.Select<SiteSetting>()
            .Where(a => a.groupName == groupName)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async int SetValue(string name, string value) {
        return await this.db.Update<SiteSetting>()
            .Set(a => a.value, value)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.name == name)
            .ExecuteAffrowsAsync();
    }

    async int UpdateValueById(int id, string value, long updatedAt) {
        return await this.db.Update<SiteSetting>()
            .Set(a => a.value, value)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Insert(SiteSetting s) {
        return await this.db.Insert<SiteSetting>(s).ExecuteIdentityAsync();
    }
}
