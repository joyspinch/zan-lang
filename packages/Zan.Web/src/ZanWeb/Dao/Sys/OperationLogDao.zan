using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;
using ZanWeb.Core;
using ZanWeb.Web;

namespace ZanWeb.Dao.Sys;

/* sys_operation_log 的数据读写网关 */
class OperationLogDao {
    IDbConnection db;

    OperationLogDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    OperationLogDao(IDbConnection db) {
        this.db = db;
    }

    async OperationLog ById(int id) {
        return await this.db.Select<OperationLog>().Where(a => a.id == id).FirstAsync();
    }

    async List<OperationLog> Latest(int limit) {
        return await this.db.Select<OperationLog>()
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OperationLog>().CountAsync();
    }

    async int Insert(OperationLog log) {
        return await this.db.Insert<OperationLog>(log).ExecuteIdentityAsync();
    }

    async int CountScoped(string kw, bool byActor, List<int> actors) {
        return await this.db.Select<OperationLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .CountAsync();
    }

    async List<OperationLog> PagedScoped(string kw, bool byActor, List<int> actors, int skip, int limit) {
        return await this.db.Select<OperationLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit).ToListAsync();
    }

    /* 声明式列表取数（ListPage.Collect 产出 conds）：kw 走操作人/标题
       双列 OR LIKE（WhereConds 按 "t.username|t.title" 逐列校验并绑定），
       时间区间走 GE/LE；数据边界仍由本 DAO 掌握。 */
    async int CountBy(List<OrmCond> conds, bool byActor, List<int> actors) {
        return await this.db.Select<OperationLog>()
            .WhereConds(conds)
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .CountAsync();
    }

    async List<OperationLog> PagedListBy(List<OrmCond> conds, bool byActor, List<int> actors, int skip, int limit) {
        return await this.db.Select<OperationLog>()
            .WhereConds(conds)
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit)
            .ToListAsync();
    }

    async int ClearAll() {
        return await this.db.Delete<OperationLog>().Where(a => a.id > 0).ExecuteAffrowsAsync();
    }
}
