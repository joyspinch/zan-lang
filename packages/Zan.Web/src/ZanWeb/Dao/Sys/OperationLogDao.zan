using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;
using ZanWeb.Core;
using ZanWeb.Web;

namespace ZanWeb.Dao.Sys;

/* sys_operation_log 的数据读写网关 */
class OperationLogDao {
    IDbConnection db;

    OperationLogDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    OperationLogDao(IDbConnection db) {
        this.db = db;
    }

    async OperationLog ById(int id) {
        return await this.db.Select<OperationLog>().Where(a => a.id == id).FirstAsync();
    }

    async List<OperationLog> Latest(int limit) {
        return await this.db.Select<OperationLog>()
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OperationLog>().CountAsync();
    }

    async int Insert(OperationLog log) {
        return await this.db.Insert<OperationLog>(log).ExecuteIdentityAsync();
    }

    async int CountScoped(string kw, bool byActor, List<int> actors) {
        return await this.db.Select<OperationLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .CountAsync();
    }

    async List<OperationLog> PagedScoped(string kw, bool byActor, List<int> actors, int skip, int limit) {
        return await this.db.Select<OperationLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit).ToListAsync();
    }

    /* 声明式列表取数（ListPage.Collect 产出 conds）：kw 走操作人/标题
       双列 OR LIKE，时间区间走 GE/LE；数据边界仍由本 DAO 掌握。 */
    static void ApplyConds(__DbQ_OperationLog sel, List<ListCond> conds) {
        for (int i = 0; i < conds.Count; i = i + 1) {
            ListCond q = conds[i];
            if (q.kind == "LIKE") {
                sel.W("((t.username LIKE ?) OR (t.title LIKE ?))");
                sel.P("%" + q.value + "%");
                sel.P("%" + q.value + "%");
            } else if (q.kind == "GE") {
                sel.W(q.col + " >= ?");
                sel.Pl(Filter.ToLong(q.value, 0));
            } else if (q.kind == "LE") {
                sel.W(q.col + " <= ?");
                sel.Pl(Filter.ToLong(q.value, 0));
            }
        }
    }

    async int CountBy(List<ListCond> conds, bool byActor, List<int> actors) {
        __DbQ_OperationLog sel = this.db.Select<OperationLog>();
        OperationLogDao.ApplyConds(sel, conds);
        if (byActor) {
            if (actors.Count == 0) { sel.W("1=0"); }
            else { sel.W("t.userId IN (?)"); sel.InI(actors); }
        }
        return await sel.CountAsync();
    }

    async List<OperationLog> PagedListBy(List<ListCond> conds, bool byActor, List<int> actors, int skip, int limit) {
        __DbQ_OperationLog sel = this.db.Select<OperationLog>();
        OperationLogDao.ApplyConds(sel, conds);
        if (byActor) {
            if (actors.Count == 0) { sel.W("1=0"); }
            else { sel.W("t.userId IN (?)"); sel.InI(actors); }
        }
        sel.OBD("t.id");
        sel.Skip(skip);
        sel.Take(limit);
        return await sel.ToListAsync();
    }

    async int ClearAll() {
        return await this.db.Delete<OperationLog>().Where(a => a.id > 0).ExecuteAffrowsAsync();
    }
}
