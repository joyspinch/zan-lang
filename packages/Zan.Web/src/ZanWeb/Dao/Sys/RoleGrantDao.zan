using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* sys_role_grant 的数据读写网关 */
class RoleGrantDao {
    IDbConnection db;

    RoleGrantDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    RoleGrantDao(IDbConnection db) {
        this.db = db;
    }

    async RoleGrant ById(int id) {
        return await this.db.Select<RoleGrant>().Where(a => a.id == id).FirstAsync();
    }

    async List<RoleGrant> ByRoleId(int roleId) {
        return await this.db.Select<RoleGrant>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    async int Insert(RoleGrant rg) {
        return await this.db.Insert<RoleGrant>(rg).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<RoleGrant>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int DeleteByRoleId(int roleId) {
        return await this.db.Delete<RoleGrant>().Where(a => a.roleId == roleId).ExecuteAffrowsAsync();
    }
}
