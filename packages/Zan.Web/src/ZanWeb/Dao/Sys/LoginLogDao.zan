using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;
using ZanWeb.Web;

namespace ZanWeb.Dao.Sys;

/* sys_login_log 的数据读写网关 */
class LoginLogDao {
    IDbConnection db;

    LoginLogDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    LoginLogDao(IDbConnection db) {
        this.db = db;
    }

    async LoginLog ById(int id) {
        return await this.db.Select<LoginLog>().Where(a => a.id == id).FirstAsync();
    }

    async List<LoginLog> Latest(int limit) {
        return await this.db.Select<LoginLog>()
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    async int Count() {
        return await this.db.Select<LoginLog>().CountAsync();
    }

    async int Insert(LoginLog log) {
        return await this.db.Insert<LoginLog>(log).ExecuteIdentityAsync();
    }

    async int CountScoped(string kw, bool byActor, List<string> actors, bool nothing) {
        return await this.db.Select<LoginLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.username))
            .WhereIf(nothing, a => a.id < 0)
            .CountAsync();
    }

    async List<LoginLog> PagedScoped(string kw, bool byActor, List<string> actors, bool nothing, int skip, int limit) {
        return await this.db.Select<LoginLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.username))
            .WhereIf(nothing, a => a.id < 0)
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit).ToListAsync();
    }

    async int ClearAll() {
        return await this.db.Delete<LoginLog>().Where(a => a.id > 0).ExecuteAffrowsAsync();
    }
}
