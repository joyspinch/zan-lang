using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;
using ZanWeb.Web;

namespace ZanWeb.Dao.Sys;

/* wiki_doc 的数据读写网关 */
class SysWikiDocDao {
    IDbConnection db;

    SysWikiDocDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    SysWikiDocDao(IDbConnection db) {
        this.db = db;
    }

    async SysWikiDoc ById(int id) {
        return await this.db.Select<SysWikiDoc>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysWikiDoc> BySpace(int spaceId) {
        return await this.db.Select<SysWikiDoc>()
            .Where(a => a.spaceId == spaceId)
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }

    async int Insert(SysWikiDoc doc) {
        return await this.db.Insert<SysWikiDoc>(doc).ExecuteIdentityAsync();
    }

    async int Update(SysWikiDoc doc) {
        return await this.db.Update<SysWikiDoc>()
            .Set(a => a.spaceId, doc.spaceId)
            .Set(a => a.title, doc.title)
            .Set(a => a.body, doc.body)
            .Set(a => a.summary, doc.summary)
            .Set(a => a.tags, doc.tags)
            .Set(a => a.status, doc.status)
            .Set(a => a.rev, doc.rev)
            .Where(a => a.id == doc.id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<SysWikiDoc>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
