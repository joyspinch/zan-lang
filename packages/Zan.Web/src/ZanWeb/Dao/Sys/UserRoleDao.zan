using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* sys_user_role 的数据读写网关 */
class UserRoleDao {
    IDbConnection db;

    UserRoleDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    UserRoleDao(IDbConnection db) {
        this.db = db;
    }

    async UserRole ById(int id) {
        return await this.db.Select<UserRole>().Where(a => a.id == id).FirstAsync();
    }

    async List<UserRole> All() {
        return await this.db.Select<UserRole>().ToListAsync();
    }

    async List<UserRole> ByUserId(int userId) {
        return await this.db.Select<UserRole>()
            .Where(a => a.userId == userId)
            .ToListAsync();
    }

    async List<UserRole> ByRoleId(int roleId) {
        return await this.db.Select<UserRole>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    async int Insert(UserRole ur) {
        return await this.db.Insert<UserRole>(ur).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<UserRole>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int DeleteByUserId(int userId) {
        return await this.db.Delete<UserRole>().Where(a => a.userId == userId).ExecuteAffrowsAsync();
    }

    async List<UserRole> ByRoleIds(List<int> roleIds) {
        return await this.db.Select<UserRole>()
            .Where(a => roleIds.Contains(a.roleId))
            .ToListAsync();
    }
}
