using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;
using ZanWeb.Web;

namespace ZanWeb.Dao.Sys;

/* sys_role_grant 的数据读写网关 */
class SysRoleGrantDao {
    IDbConnection db;

    SysRoleGrantDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    SysRoleGrantDao(IDbConnection db) {
        this.db = db;
    }

    async SysRoleGrant ById(int id) {
        return await this.db.Select<SysRoleGrant>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysRoleGrant> ByRoleId(int roleId) {
        return await this.db.Select<SysRoleGrant>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    async int Insert(SysRoleGrant rg) {
        return await this.db.Insert<SysRoleGrant>(rg).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<SysRoleGrant>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int DeleteByRoleId(int roleId) {
        return await this.db.Delete<SysRoleGrant>().Where(a => a.roleId == roleId).ExecuteAffrowsAsync();
    }
}
