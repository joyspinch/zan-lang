using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;
using ZanWeb.Web;

namespace ZanWeb.Dao.Sys;

/* sys_dict_type 的数据读写网关 */
class SysDictTypeDao {
    IDbConnection db;

    SysDictTypeDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    SysDictTypeDao(IDbConnection db) {
        this.db = db;
    }

    async SysDictType ById(int id) {
        return await this.db.Select<SysDictType>().Where(a => a.id == id).FirstAsync();
    }

    async SysDictType ByCode(string code) {
        return await this.db.Select<SysDictType>().Where(a => a.code == code).FirstAsync();
    }

    async List<SysDictType> All() {
        return await this.db.Select<SysDictType>().OrderBy(a => a.code).ToListAsync();
    }

    async List<SysDictType> AllActive() {
        return await this.db.Select<SysDictType>()
            .Where(a => a.status == 1)
            .OrderBy(a => a.code)
            .ToListAsync();
    }

    async int UpdateFields(int id, string code, string name, string description, int status, long updatedAt) {
        return await this.db.Update<SysDictType>()
            .Set(a => a.code, code)
            .Set(a => a.name, name)
            .Set(a => a.description, description)
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Insert(SysDictType dt) {
        return await this.db.Insert<SysDictType>(dt).ExecuteIdentityAsync();
    }

    async int Update(SysDictType dt) {
        return await this.UpdateFields(dt.id, dt.code, dt.name, dt.description, dt.status, dt.updatedAt);
    }

    async int Delete(int id) {
        return await this.db.Delete<SysDictType>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
