using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* wiki_revision 的数据读写网关 */
class WikiRevisionDao {
    IDbConnection db;

    WikiRevisionDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    WikiRevisionDao(IDbConnection db) {
        this.db = db;
    }

    async List<WikiRevision> ByDocId(int docId) {
        return await this.db.Select<WikiRevision>()
            .Where(a => a.docId == docId)
            .OrderByDescending(a => a.rev)
            .ToListAsync();
    }

    async WikiRevision ByDocAndRev(int docId, int rev) {
        return await this.db.Select<WikiRevision>()
            .Where(a => a.docId == docId && a.rev == rev)
            .FirstAsync();
    }

    async int Insert(WikiRevision rev) {
        return await this.db.Insert<WikiRevision>(rev).ExecuteIdentityAsync();
    }
}
