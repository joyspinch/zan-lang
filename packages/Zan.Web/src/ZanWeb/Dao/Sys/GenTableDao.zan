using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;
using ZanWeb.Web;

namespace ZanWeb.Dao.Sys;

/* sys_gen_table 的数据读写网关 */
class GenTableDao {
    IDbConnection db;

    GenTableDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    GenTableDao(IDbConnection db) {
        this.db = db;
    }

    async GenTable ById(int id) {
        return await this.db.Select<GenTable>().Where(a => a.id == id).FirstAsync();
    }

    async GenTable ByTableName(string tableName) {
        return await this.db.Select<GenTable>().Where(a => a.tableName == tableName).FirstAsync();
    }

    async List<GenTable> All() {
        return await this.db.Select<GenTable>().OrderBy(a => a.id).ToListAsync();
    }

    async List<GenTable> AllMigrated() {
        return await this.db.Select<GenTable>().Where(a => a.migrated == 1).ToListAsync();
    }

    async int Insert(GenTable table) {
        return await this.db.Insert<GenTable>(table).ExecuteIdentityAsync();
    }

    async int Update(GenTable table) {
        return await this.db.Update<GenTable>()
            .Set(a => a.tableName, table.tableName)
            .Set(a => a.entityName, table.entityName)
            .Set(a => a.title, table.title)
            .Set(a => a.section, table.section)
            .Set(a => a.orderColumn, table.orderColumn)
            .Set(a => a.migrated, table.migrated)
            .Where(a => a.id == table.id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<GenTable>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
