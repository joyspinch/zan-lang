using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* sys_gen_column 的数据读写网关 */
class GenColumnDao {
    IDbConnection db;

    GenColumnDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    GenColumnDao(IDbConnection db) {
        this.db = db;
    }

    async List<GenColumn> ByTableId(int tableId) {
        return await this.db.Select<GenColumn>()
            .Where(a => a.tableId == tableId)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async int Insert(GenColumn col) {
        return await this.db.Insert<GenColumn>(col).ExecuteIdentityAsync();
    }

    async int DeleteByTableId(int tableId) {
        return await this.db.Delete<GenColumn>().Where(a => a.tableId == tableId).ExecuteAffrowsAsync();
    }
}
