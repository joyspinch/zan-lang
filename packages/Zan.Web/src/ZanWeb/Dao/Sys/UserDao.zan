using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb.Model.Sys;
using ZanWeb.Core;
using ZanWeb.Web;

namespace ZanWeb.Dao.Sys;

/* sys_user 的读写入口；登录、令牌解析和管理后台都经此路由，账号表唯一网关。DAO 由调用方连接构造，无独立生命周期。所有方法异步，认证解析器也在请求协程上运行，不阻塞工作线程。 */
class UserDao {
    IDbConnection db;

    UserDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    UserDao(IDbConnection db) {
        this.db = db;
    }

    async User ByUsername(string username) {
        return await this.db.Select<User>()
            .Where(a => a.username == username)
            .FirstAsync();
    }

    async User ByEmail(string email) {
        return await this.db.Select<User>()
            .Where(a => a.email == email)
            .FirstAsync();
    }

    async int CountByUsername(string username) {
        return await this.db.Select<User>()
            .Where(a => a.username == username)
            .CountAsync();
    }

    async int CountByEmail(string email) {
        return await this.db.Select<User>()
            .Where(a => a.email == email)
            .CountAsync();
    }

    async User ById(int id) {
        return await this.db.Select<User>().Where(a => a.id == id).FirstAsync();
    }

    /* 返回所有账号实体列表（FreeSql 风格直接操作/返回实体） */
    async List<User> All() {
        return await this.db.Select<User>()
            .OrderBy(a => a.id)
            .ToListAsync();
    }

    async int Count() {
        return await this.db.Select<User>().CountAsync();
    }

    async int Insert(User user) {
        return await this.db.Insert<User>(user).ExecuteIdentityAsync();
    }

    /* 启用(1)/禁用(0)账号；禁用后无法登录，已发令牌也失效。返回影响行数。 */
    async int SetStatus(int id, int status) {
        return await this.db.Update<User>()
            .Set(a => a.status, status)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 更新账号基本属性 */
    async int UpdateProfile(int id, string username, string nickname, string email, string mobile, int departmentId, int status, long updatedAt) {
        return await this.db.Update<User>()
            .Set(a => a.username, username)
            .Set(a => a.nickname, nickname)
            .Set(a => a.email, email)
            .Set(a => a.mobile, mobile)
            .Set(a => a.departmentId, departmentId)
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 更新个人资料 */
    async int UpdatePersonal(int id, string nickname, string email, string mobile, long updatedAt) {
        return await this.db.Update<User>()
            .Set(a => a.nickname, nickname)
            .Set(a => a.email, email)
            .Set(a => a.mobile, mobile)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 删除账号，返回影响行数。 */
    async int Delete(int id) {
        return await this.db.Delete<User>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    /* 重置密码 */
    async int ResetPassword(int id, string salt, string hash, int tokenVersion, long updatedAt) {
        return await this.db.Update<User>()
            .Set(a => a.passwordSalt, salt)
            .Set(a => a.passwordHash, hash)
            .Set(a => a.tokenVersion, tokenVersion)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 使该账号已发所有令牌失效；改密或强制登出后调用。 */
    async int BumpTokenVersion(int id) {
        User row = await this.ById(id);
        if (row == null) { return 0; }
        return await this.db.Update<User>()
            .Set(a => a.tokenVersion, row.tokenVersion + 1)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 范围计数：数据权限过滤。 */
    async int CountScoped(bool byDept, List<int> depts, bool mine, int myId) {
        return await this.db.Select<User>()
            .WhereIf(byDept, a => depts.Contains(a.departmentId))
            .WhereIf(mine, a => a.id == myId)
            .CountAsync();
    }

    /* 管理后台分页计数 */
    async int CountPaged(string kw, int status, bool byDept, List<int> scoped, bool mine, int myId) {
        bool hasKw = kw != null && kw.Length > 0;
        return await this.db.Select<User>()
            .WhereIf(hasKw, a => a.username.Contains(kw))
            .WhereIf(status >= 0, a => a.status == status)
            .WhereIf(byDept, a => scoped.Contains(a.departmentId))
            .WhereIf(mine, a => a.id == myId)
            .CountAsync();
    }

    /* 管理后台分页列表 */
    async List<User> PagedList(string kw, int status, bool byDept, List<int> scoped, bool mine, int myId, int skip, int limit) {
        bool hasKw = kw != null && kw.Length > 0;
        return await this.db.Select<User>()
            .WhereIf(hasKw, a => a.username.Contains(kw))
            .WhereIf(status >= 0, a => a.status == status)
            .WhereIf(byDept, a => scoped.Contains(a.departmentId))
            .WhereIf(mine, a => a.id == myId)
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit)
            .ToListAsync();
    }

    async List<User> ByDeptIds(List<int> depts) {
        return await this.db.Select<User>()
            .Where(a => depts.Contains(a.departmentId))
            .ToListAsync();
    }

    /* 批量端点的取数与写：IN 占位符 "IN (?)" 由 InI 按参数个数展开，
       id 列表永远参数化，调用方保证非空。 */
    async List<User> ByIds(List<int> ids) {
        if (ids.Count == 0) { return new List<User>(); }
        return await this.db.Select<User>()
            .W("t.id IN (?)")
            .InI(ids)
            .ToListAsync();
    }

    async int SetStatusByIds(List<int> ids, int status) {
        if (ids.Count == 0) { return 0; }
        return await this.db.Update<User>()
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .W("t.id IN (?)")
            .InI(ids)
            .ExecuteAffrowsAsync();
    }

    async int DeleteByIds(List<int> ids) {
        if (ids.Count == 0) { return 0; }
        return await this.db.Delete<User>()
            .W("t.id IN (?)")
            .InI(ids)
            .ExecuteAffrowsAsync();
    }

    /* 声明式列表取数：conds 由 ListPage.Collect 产出，这里统一拼参数化
     * WHERE——列名来自控制器声明（非用户输入），值走占位符。数据边界
     * （部门/本人范围）仍由本 DAO 掌握，界面声明越不过权限。 */
    static void ApplyConds(__DbQ_User sel, List<ListCond> conds) {
        for (int i = 0; i < conds.Count; i = i + 1) {
            ListCond q = conds[i];
            if (q.kind == "LIKE") {
                List<string> cols = q.col.Split("|");
                string frag = "(";
                int n = 0;
                for (int p = 0; p < cols.Count; p = p + 1) {
                    string part = cols[p].Trim();
                    if (part.Length == 0) { continue; }
                    if (n > 0) { frag = frag + " OR "; }
                    frag = frag + part + " LIKE ?";
                    sel.P("%" + q.value + "%");
                    n = n + 1;
                }
                sel.W(frag + ")");
            } else if (q.kind == "EQ") {
                sel.W(q.col + " = ?");
                sel.Pi(Filter.ToInt(q.value, 0));
            } else if (q.kind == "GE") {
                sel.W(q.col + " >= ?");
                sel.Pl(Filter.ToLong(q.value, 0));
            } else if (q.kind == "LE") {
                sel.W(q.col + " <= ?");
                sel.Pl(Filter.ToLong(q.value, 0));
            }
        }
    }

    async int CountBy(List<ListCond> conds, bool byDept, List<int> scoped, bool mine, int myId) {
        __DbQ_User sel = this.db.Select<User>();
        UserDao.ApplyConds(sel, conds);
        if (byDept) {
            if (scoped.Count == 0) { sel.W("1=0"); }
            else { sel.W("t.departmentId IN (?)"); sel.InI(scoped); }
        }
        if (mine) { sel.W("t.id = ?"); sel.Pi(myId); }
        return await sel.CountAsync();
    }

    async List<User> PagedListBy(List<ListCond> conds, bool byDept, List<int> scoped, bool mine, int myId, int skip, int limit) {
        __DbQ_User sel = this.db.Select<User>();
        UserDao.ApplyConds(sel, conds);
        if (byDept) {
            if (scoped.Count == 0) { sel.W("1=0"); }
            else { sel.W("t.departmentId IN (?)"); sel.InI(scoped); }
        }
        if (mine) { sel.W("t.id = ?"); sel.Pi(myId); }
        sel.OBD("t.id");
        sel.Skip(skip);
        sel.Take(limit);
        return await sel.ToListAsync();
    }
}