using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;
using ZanWeb.Web;

namespace ZanWeb.Dao.Sys;

/* sys_dict_item 的数据读写网关 */
class DictItemDao {
    IDbConnection db;

    DictItemDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    DictItemDao(IDbConnection db) {
        this.db = db;
    }

    async DictItem ById(int id) {
        return await this.db.Select<DictItem>().Where(a => a.id == id).FirstAsync();
    }

    async List<DictItem> ByTypeCode(string typeCode) {
        return await this.db.Select<DictItem>()
            .Where(a => a.typeCode == typeCode)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async List<DictItem> ByTypeCodeActive(string typeCode) {
        return await this.db.Select<DictItem>()
            .Where(a => a.typeCode == typeCode && a.status == 1)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async int Insert(DictItem item) {
        return await this.db.Insert<DictItem>(item).ExecuteIdentityAsync();
    }

    async int Update(DictItem item) {
        return await this.UpdateFields(item.id, item.typeCode, item.label, item.value, item.sortOrder, item.status, item.updatedAt);
    }

    async int UpdateFields(int id, string typeCode, string label, string value, int sortOrder, int status, long updatedAt) {
        return await this.db.Update<DictItem>()
            .Set(a => a.typeCode, typeCode)
            .Set(a => a.label, label)
            .Set(a => a.value, value)
            .Set(a => a.sortOrder, sortOrder)
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int UpdateLabel(int id, string label, long updatedAt) {
        return await this.db.Update<DictItem>()
            .Set(a => a.label, label)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int UpdateSortOrder(int id, int sortOrder, long updatedAt) {
        return await this.db.Update<DictItem>()
            .Set(a => a.sortOrder, sortOrder)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int UpdateStatus(int id, int status, long updatedAt) {
        return await this.db.Update<DictItem>()
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<DictItem>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int DeleteByTypeCode(string typeCode) {
        return await this.db.Delete<DictItem>().Where(a => a.typeCode == typeCode).ExecuteAffrowsAsync();
    }
}
