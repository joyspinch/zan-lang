using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;
using ZanWeb.Web;

namespace ZanWeb.Dao.Sys;

/* sys_gen_table 的数据读写网关 */
class SysGenTableDao {
    IDbConnection db;

    SysGenTableDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    SysGenTableDao(IDbConnection db) {
        this.db = db;
    }

    async SysGenTable ById(int id) {
        return await this.db.Select<SysGenTable>().Where(a => a.id == id).FirstAsync();
    }

    async SysGenTable ByTableName(string tableName) {
        return await this.db.Select<SysGenTable>().Where(a => a.tableName == tableName).FirstAsync();
    }

    async List<SysGenTable> All() {
        return await this.db.Select<SysGenTable>().OrderBy(a => a.id).ToListAsync();
    }

    async List<SysGenTable> AllMigrated() {
        return await this.db.Select<SysGenTable>().Where(a => a.migrated == 1).ToListAsync();
    }

    async int Insert(SysGenTable table) {
        return await this.db.Insert<SysGenTable>(table).ExecuteIdentityAsync();
    }

    async int Update(SysGenTable table) {
        return await this.db.Update<SysGenTable>()
            .Set(a => a.tableName, table.tableName)
            .Set(a => a.entityName, table.entityName)
            .Set(a => a.title, table.title)
            .Set(a => a.section, table.section)
            .Set(a => a.orderColumn, table.orderColumn)
            .Set(a => a.migrated, table.migrated)
            .Where(a => a.id == table.id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<SysGenTable>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
