using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;
using ZanWeb.Web;

namespace ZanWeb.Dao;

/* sys_user_role 的数据读写网关 */
public class SysUserRoleDao : BaseDao<SysUserRole> {
    public SysUserRoleDao(AppController host) : base(host, "sys_user_role") {
        this.db = host != null ? host.__Conn() : null;
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    public SysUserRoleDao(IDbConnection db) : base(db, "sys_user_role") {
        this.db = db;
    }

    async SysUserRole ById(int id) {
        return await this.db.Select<SysUserRole>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysUserRole> All() {
        return await this.db.Select<SysUserRole>().ToListAsync();
    }

    async List<SysUserRole> ByUserId(int userId) {
        return await this.db.Select<SysUserRole>()
            .Where(a => a.userId == userId)
            .ToListAsync();
    }

    async List<SysUserRole> ByRoleId(int roleId) {
        return await this.db.Select<SysUserRole>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    async int Insert(SysUserRole ur) {
        return await this.db.Insert<SysUserRole>(ur).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<SysUserRole>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int DeleteByUserId(int userId) {
        return await this.db.Delete<SysUserRole>().Where(a => a.userId == userId).ExecuteAffrowsAsync();
    }

    async List<SysUserRole> ByRoleIds(List<int> roleIds) {
        return await this.db.Select<SysUserRole>()
            .Where(a => roleIds.Contains(a.roleId))
            .ToListAsync();
    }
}
