using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;
using ZanWeb.Web;

namespace ZanWeb.Dao;

/* media 的数据读写网关 */
class SysMediaFileDao {
    IDbConnection db;

    SysMediaFileDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    SysMediaFileDao(IDbConnection db) {
        this.db = db;
    }

    async SysMediaFile ById(int id) {
        return await this.db.Select<SysMediaFile>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysMediaFile> All() {
        return await this.db.Select<SysMediaFile>().OrderByDescending(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<SysMediaFile>().CountAsync();
    }

    async int Insert(SysMediaFile file) {
        return await this.db.Insert<SysMediaFile>(file).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<SysMediaFile>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
