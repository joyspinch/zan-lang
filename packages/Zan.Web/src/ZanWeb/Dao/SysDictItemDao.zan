using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;
using ZanWeb.Web;

namespace ZanWeb.Dao;

/* sys_dict_item 的数据读写网关 */
public class SysDictItemDao : BaseDao<SysDictItem> {
    public SysDictItemDao(AppController host) : base(host, "sys_dict_item") {
        this.db = host != null ? host.__Conn() : null;
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    public SysDictItemDao(IDbConnection db) : base(db, "sys_dict_item") {
        this.db = db;
    }

    async SysDictItem ById(int id) {
        return await this.db.Select<SysDictItem>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysDictItem> ByTypeCode(string typeCode) {
        return await this.db.Select<SysDictItem>()
            .Where(a => a.typeCode == typeCode)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async List<SysDictItem> ByTypeCodeActive(string typeCode) {
        return await this.db.Select<SysDictItem>()
            .Where(a => a.typeCode == typeCode && a.status == 1)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async int Insert(SysDictItem item) {
        return await this.db.Insert<SysDictItem>(item).ExecuteIdentityAsync();
    }

    async int Update(SysDictItem item) {
        return await this.UpdateFields(item.id, item.typeCode, item.label, item.value, item.sortOrder, item.status, item.updatedAt);
    }

    async int UpdateFields(int id, string typeCode, string label, string value, int sortOrder, int status, long updatedAt) {
        return await this.db.Update<SysDictItem>()
            .Set(a => a.typeCode, typeCode)
            .Set(a => a.label, label)
            .Set(a => a.value, value)
            .Set(a => a.sortOrder, sortOrder)
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int UpdateLabel(int id, string label, long updatedAt) {
        return await this.db.Update<SysDictItem>()
            .Set(a => a.label, label)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int UpdateSortOrder(int id, int sortOrder, long updatedAt) {
        return await this.db.Update<SysDictItem>()
            .Set(a => a.sortOrder, sortOrder)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int UpdateStatus(int id, int status, long updatedAt) {
        return await this.db.Update<SysDictItem>()
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<SysDictItem>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int DeleteByTypeCode(string typeCode) {
        return await this.db.Delete<SysDictItem>().Where(a => a.typeCode == typeCode).ExecuteAffrowsAsync();
    }
}
