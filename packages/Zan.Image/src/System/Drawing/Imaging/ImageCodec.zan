using System;

namespace System.Drawing.Imaging;

// 独立图片解码与缓存，不需要窗口或渲染器。像素为直通 alpha
// 的 ARGB32；内存图片 key 约定用 "mem:" 前缀。
class ImageCodec {
    // 文件或已注册 key 的像素宽度；首次读取文件时解码，失败返回 0。
    static int Width(string key) {
        return ImageCodec.zan_image_width(key);
    }

    // 文件或已注册 key 的像素高度，失败返回 0。
    static int Height(string key) {
        return ImageCodec.zan_image_height(key);
    }

    // 同步读取 len 字节并解码到 key，返回宽度，失败返回 0。
    // 支持 PNG/JPEG/BMP/GIF/TGA/PNM/PSD/WebP 与 PNG 压缩 ICO 子图。
    // 调用后可以释放源字节；重复注册活跃 key 保留首次图像。
    static int LoadMem(string key, string data, int len) {
        return ImageCodec.zan_image_load_mem(key, data, len);
    }

    // byte[] 重载；len 为有效数据字节数。
    static int LoadMem(string key, byte[] data, int len) {
        return ImageCodec.zan_image_load_mem_bytes(key, data, len);
    }

    // SVG 按原比例适配 rasterW/rasterH，返回宽度，失败返回 0。
    // 目标尺寸 <= 0 时使用文档固有尺寸；活跃 key 不重复光栅化。
    static int LoadSvg(string key, string svg, int rasterW, int rasterH) {
        return ImageCodec.zan_image_load_svg(key, svg, -1, rasterW, rasterH);
    }

    // SVG 字节重载；len 为有效数据字节数。
    static int LoadSvg(string key, byte[] svg, int len, int rasterW, int rasterH) {
        return ImageCodec.zan_image_load_svg_bytes(key, svg, len, rasterW, rasterH);
    }

    // 丢弃文件或内存 key 的缓存及失败记录。
    static void Evict(string key) {
        ImageCodec.zan_image_evict(key);
    }

    // 借用 native zan_bitmap 描述符；失败返回 0。仅供 graphics
    // bridge 同步转发，Zan 不得读取或释放。描述符及像素只有效到下一次
    // 图片缓存变动（解码、注册、替换或驱逐），不得跨该边界保留。
    static nint View(string key) {
        return ImageCodec.zan_image_get(key);
    }

    // 文件与内存图片的缓存条目数及像素内存统计。
    static string MemReport() {
        return ImageCodec.zan_image_mem_report();
    }

    [DllImport("zan_image")]
    static extern int zan_image_width(string key);

    [DllImport("zan_image")]
    static extern int zan_image_height(string key);

    [DllImport("zan_image")]
    static extern int zan_image_load_mem(string key, string data, int len);

    [DllImport("zan_image")]
    static extern int zan_image_load_mem_bytes(string key, byte[] data, int len);

    [DllImport("zan_image")]
    static extern int zan_image_load_svg(string key, string text, int len,
                                          int rasterW, int rasterH);

    [DllImport("zan_image", EntryPoint = "zan_image_load_svg")]
    static extern int zan_image_load_svg_bytes(string key, byte[] text, int len,
                                                int rasterW, int rasterH);

    [DllImport("zan_image")]
    static extern void zan_image_evict(string key);

    [DllImport("zan_image")]
    static extern nint zan_image_get(string key);

    [DllImport("zan_image")]
    static extern string zan_image_mem_report();
}
