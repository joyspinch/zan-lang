using System;
using Gui.Backend;

namespace System.Hardware;

// 屏幕防休眠与亮度控制服务（Screen）：
// 控制移动端/桌面端的屏幕常亮状态（防熄屏）与窗口级/屏幕级亮度调节。
// 适用场景：视频播放、车载导航、沉浸式游戏、展示收付款码时拉满亮度。
public class Screen {
    // 启用或禁用防休眠（KeepAwake）：
    // true: 阻止系统自动熄屏或进入睡眠省电模式；
    // false: 恢复系统默认的无操作熄屏计时策略。
    public static void KeepAwake(bool enable) {
        Platform.Shell().ScreenKeepAwake(enable);
    }

    // 查询当前是否处于防休眠常亮状态
    public static bool IsKeepAwake() {
        return Platform.Shell().ScreenIsKeepAwake();
    }

    // 调节屏幕/窗口亮度（brightness 范围 0.0f ~ 1.0f）：
    // 0.0f: 最暗；1.0f: 最亮（例如展示核验码、付款码）；
    // 恢复跟随系统请调用 RestoreBrightness()。
    public static void SetBrightness(float brightness) {
        if (brightness < 0.0f) { brightness = 0.0f; }
        if (brightness > 1.0f) { brightness = 1.0f; }
        Platform.Shell().ScreenSetBrightness(brightness);
    }

    // 获取当前设定的亮度（0.0f ~ 1.0f），若返回负数（-1.0f）表示当前跟随系统
    public static float Brightness() {
        return Platform.Shell().ScreenGetBrightness();
    }

    // 恢复跟随系统自动亮度调节
    public static void RestoreBrightness() {
        Platform.Shell().ScreenSetBrightness(-1.0f);
    }
}
