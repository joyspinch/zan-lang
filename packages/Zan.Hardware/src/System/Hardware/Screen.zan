using System;

namespace System.Hardware;

// 屏幕防休眠与亮度控制服务（Screen）：
// 控制移动端/桌面端的屏幕常亮状态（防熄屏）与窗口级/屏幕级亮度调节。
// 需由 GUI/移动端外壳通过 HardwareHost 注册实现；无头服务端下静默降级并诚实返回未接管状态。
public class Screen {
    // 启用或禁用防休眠（KeepAwake）：
    // true: 阻止系统自动熄屏或进入睡眠省电模式；
    // false: 恢复系统默认的无操作熄屏计时策略。
    public static void KeepAwake(bool enable) {
        IHardwareHost host = HardwareHost.Current();
        if (host != null) { host.ScreenKeepAwake(enable); }
    }

    // 查询当前是否处于防休眠常亮状态；未注册窗口宿主时返回 false。
    public static bool IsKeepAwake() {
        IHardwareHost host = HardwareHost.Current();
        if (host != null) { return host.ScreenIsKeepAwake(); }
        return false;
    }

    // 调节屏幕/窗口亮度（brightness 范围 0.0f ~ 1.0f）：
    // 0.0f: 最暗；1.0f: 最亮（例如展示核验码、付款码）；
    // 恢复跟随系统请调用 RestoreBrightness()。
    public static void SetBrightness(float brightness) {
        if (brightness < 0.0f) { brightness = 0.0f; }
        if (brightness > 1.0f) { brightness = 1.0f; }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) { host.ScreenSetBrightness(brightness); }
    }

    // 获取当前设定的亮度（0.0f ~ 1.0f），若返回负数（-1.0f）表示当前跟随系统或无屏幕宿主。
    public static float Brightness() {
        IHardwareHost host = HardwareHost.Current();
        if (host != null) { return host.ScreenGetBrightness(); }
        return -1.0f;
    }

    // 恢复跟随系统自动亮度调节
    public static void RestoreBrightness() {
        IHardwareHost host = HardwareHost.Current();
        if (host != null) { host.ScreenSetBrightness(-1.0f); }
    }
}
