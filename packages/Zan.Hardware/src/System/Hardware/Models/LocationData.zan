using System;

namespace System.Hardware;

// 物理地理位置快照模型（LocationData）：
// 封装 GPS / 北斗 / 基站 / Wifi 综合定位返回的高精度经纬度及运动学指标。
public class LocationData {
    // 纬度（Latitude，-90.0 ~ +90.0 度，北纬为正，南纬为负）
    public double latitude;

    // 经度（Longitude，-180.0 ~ +180.0 度，东经为正，西经为负）
    public double longitude;

    // 海拔高度（Altitude，米，WGS84 椭球面或海平面基准）
    public double altitude;

    // 水平位置定位精度半径（Accuracy，米，值越小越精确）
    public float accuracy;

    // 移动瞬时对地速度（Speed，米/秒）
    public float speed;

    // 定位数据时间戳（Unix 毫秒时间戳）
    public long timestampMs;

    public LocationData(double latitude, double longitude, double altitude, float accuracy, float speed, long timestampMs) {
        this.latitude = latitude;
        this.longitude = longitude;
        this.altitude = altitude;
        this.accuracy = accuracy;
        this.speed = speed;
        this.timestampMs = timestampMs;
    }
}
