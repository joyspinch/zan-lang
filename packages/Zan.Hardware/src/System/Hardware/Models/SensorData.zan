using System;
using System.Numerics;

namespace System.Hardware;

// 传感器单次采样数据包
public class SensorData {
    public Vector3 value;
    public long timestampMs;

    public SensorData() {
        this.value = Vector3.Zero;
        this.timestampMs = 0L;
    }

    public SensorData(Vector3 v, long ts) {
        this.value = v;
        this.timestampMs = ts;
    }
}
