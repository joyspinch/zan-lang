using System;

namespace System.Hardware;

// 硬件与外壳能力宿主桥接契约（依赖倒置）。
//
// Zan.Hardware 本身不依赖任何 GUI 包；服务端与命令行程序可直接查询
// OS/硬件能力。若应用运行在桌面 GUI 或移动端容器（Android/iOS/OHOS）中，
// 由上层宿主在启动时通过 HardwareHost.Register(host) 注入宿主实现，
// 从而在不引入反向依赖的前提下接管传感器、通知、原生选择器、系统栏与权限弹窗。
public interface IHardwareHost {
    int SensorGet(int sensorType, float[] outVec);
    int SensorSet(int sensorType, float x, float y, float z);
    int NotificationSend(string title, string body, string action, int badge, string sound);
    int NetworkType();
    bool IsDarkMode();
    int ShareText(string text, string title);
    string PickFile(string filter);
    int PermissionCheck(int permType);
    int PermissionRequest(int permType);
    void ScreenKeepAwake(bool enable);
    bool ScreenIsKeepAwake();
    void ScreenSetBrightness(float brightness);
    float ScreenGetBrightness();
    int LocationGet(double[] outCoords, float[] outMetrics);
    string DeviceInfoGet(int infoKey);
    bool DeviceIsFoldable();
    bool BiometricsCanAuthenticate();
    int BiometricsType();
    bool BiometricsAuthenticate(string title, string subtitle);
    void SystemBarSetStatus(bool visible, int style, int color);
    bool SystemBarIsStatusVisible();
    int SystemBarStyle();
    int SystemBarColor();
    void SystemBarSetNavVisible(bool visible);
    bool SystemBarIsNavVisible();
    string TakeOpenUrl();
    void InjectOpenUrl(string url);
}

// 进程级可选硬件宿主注册表（无宿主时为 null，退回无头 OS 探测或诚实未支持返回）。
public class HardwareHost {
    static IHardwareHost currentHost;

    // 注册上层宿主（如 GUI/移动端壳）。传 null 等同于 Clear()。
    public static void Register(IHardwareHost host) {
        HardwareHost.currentHost = host;
    }

    // 清除已注册宿主，恢复纯无头模式。
    public static void Clear() {
        HardwareHost.currentHost = null;
    }

    // 获取当前已注册宿主；未注册时返回 null。
    public static IHardwareHost Current() {
        return HardwareHost.currentHost;
    }
}
