using System;
using Gui.Backend;

namespace System.Hardware;

// 跨平台系统级通知（Notification）：
// 支持通过平台原生 NDK（OpenHarmony OH_Notification_PublishNotification、
// iOS UNUserNotificationCenter、Android NotificationManager、Windows Toast）
// 向系统通知中心分发本地与即时通知。
public class Notification {
    public string title;
    public string body;
    public string action;
    public int badge;
    public string sound;

    public Notification() {
        this.title = "";
        this.body = "";
        this.action = "";
        this.badge = 0;
        this.sound = "";
    }

    public Notification(string title, string body) {
        this.title = title != null ? title : "";
        this.body = body != null ? body : "";
        this.action = "";
        this.badge = 0;
        this.sound = "";
    }

    // 创建新的系统通知草稿
    public static Notification New(string title, string body) {
        return new Notification(title, body);
    }

    // 设置点击通知时的动作标识符（Action Identifier）
    public Notification WithAction(string act) {
        this.action = act != null ? act : "";
        return this;
    }

    // 设置桌面/主屏应用图标角标数字
    public Notification WithBadge(int count) {
        if (count >= 0) { this.badge = count; }
        return this;
    }

    // 设置通知播放的提示音（"chime", "tick", 或原生音频路径）
    public Notification WithSound(string snd) {
        this.sound = snd != null ? snd : "";
        return this;
    }

    // 立即向系统通知中心分发此通知
    public int Send() {
        return Platform.Shell().NotificationSend(
            this.title,
            this.body,
            this.action,
            this.badge,
            this.sound
        );
    }
}
