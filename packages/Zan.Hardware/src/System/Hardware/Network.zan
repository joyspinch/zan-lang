using System;
using Gui.Backend;

namespace System.Hardware;

// 网络连接类型
public enum NetworkType {
    None = 0,       // 0: 无网络/断网
    Wifi = 1,       // 1: Wi-Fi 无线局域网
    Cellular = 2,   // 2: 蜂窝数据（4G/5G 移动流量）
    Ethernet = 3    // 3: 有线以太网
}

// 跨平台网络连接感知门面（Network）：
// 实时探测当前设备是否连网、网络连接媒介类型，
// 辅助移动端在大文件下载、视频播放或实时同步时感知是否消耗蜂窝流量。
public class Network {
    // 当前设备是否处于已联网状态（True 为有网络）
    public static bool IsConnected() {
        return Network.Type() != NetworkType.None;
    }

    // 获取当前网络连接类型（Wifi, Cellular, Ethernet, None）
    public static NetworkType Type() {
        int t = Platform.Shell().NetworkType();
        if (t >= 0 && t <= 3) {
            return (NetworkType)t;
        }
        return NetworkType.None;
    }

    // 仿真/注入当前网络状态（用于离线测试、断网演练）
    public static void Inject(NetworkType t) {
        Platform.Shell().SetNetworkType((int)t);
    }
}
