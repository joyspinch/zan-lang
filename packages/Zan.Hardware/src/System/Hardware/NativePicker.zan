using System;
using Gui.Backend;

namespace System.Hardware;

// 跨平台系统原生文件与相册选择器（NativePicker）：
// 调起移动端沙箱原生安全选择器（PhotoPicker / DocumentPicker），
// 允许用户主动授权勾选文件，无需全盘存储读取权限。
public class NativePicker {
    // 调起系统相册选择单张图片（返回选中图片的沙箱绝对路径，取消返回 ""）
    public static string PickImage() {
        return Platform.Shell().PickFile("image/*");
    }

    // 调起系统文档选择器
    public static string PickFile(string mimeFilter) {
        return Platform.Shell().PickFile(mimeFilter != null ? mimeFilter : "*/*");
    }
}
