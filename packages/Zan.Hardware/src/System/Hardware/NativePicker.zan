using System;

namespace System.Hardware;

// 跨平台系统原生文件与相册选择器（NativePicker）：
// 由桌面 GUI 或移动端容器通过 HardwareHost 注册安全选择器实现；无头环境下返回 ""。
public class NativePicker {
    // 调起系统相册选择单张图片（返回选中图片的沙箱绝对路径，取消或不支持返回 ""）
    public static string PickImage() {
        return NativePicker.PickFile("image/*");
    }

    // 调起系统文档选择器
    public static string PickFile(string mimeFilter) {
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            string r = host.PickFile(mimeFilter != null ? mimeFilter : "*/*");
            return r != null ? r : "";
        }
        return "";
    }
}
