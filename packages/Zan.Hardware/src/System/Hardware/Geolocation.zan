using System;
using Gui.Backend;

namespace System.Hardware;

// 物理地理位置定位服务（Geolocation）：
// 提供基于卫星 GPS / 北斗 / 蜂窝基站的高精度物理位置查询，联动系统权限状态机。
public class Geolocation {
    private static double[] rawCoords = new double[] { 0.0, 0.0, 0.0 };
    private static float[]  rawMetrics = new float[] { 0.0f, 0.0f };

    // 获取当前时刻的地理坐标与运动指标。
    // 注意：若用户未授予 Location 权限，出于隐私安全将返回经纬度 0.0 且精度 0 的空数据。
    public static LocationData Current() {
        if (!Permissions.IsGranted(PermissionType.Location)) {
            return new LocationData(0.0, 0.0, 0.0, 0.0f, 0.0f, 0);
        }
        int ret = Platform.Shell().LocationGet(rawCoords, rawMetrics);
        if (ret == 0 && rawCoords.Length >= 3 && rawMetrics.Length >= 2) {
            long nowMs = (long)Platform.Shell().RawTickMs();
            return new LocationData(rawCoords[0], rawCoords[1], rawCoords[2], rawMetrics[0], rawMetrics[1], nowMs);
        }
        return new LocationData(0.0, 0.0, 0.0, 0.0f, 0.0f, 0);
    }

    // 仿真/注入地理位置数据（用于单元测试、模拟路线巡检与无硬件调试）
    public static void Inject(double latitude, double longitude, double altitude, float accuracy, float speed) {
        Platform.Shell().LocationSet(latitude, longitude, altitude, accuracy, speed);
    }

    // 地理定位硬件与服务是否可用
    public static bool IsSupported() {
        return Platform.Shell().LocationGet(rawCoords, rawMetrics) == 0;
    }
}
