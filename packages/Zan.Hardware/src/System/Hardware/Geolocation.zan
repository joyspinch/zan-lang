using System;

namespace System.Hardware;

// 物理地理位置定位服务（Geolocation）：
// 提供基于卫星 GPS / 北斗 / 蜂窝基站的高精度物理位置查询，联动系统权限状态机。
// 无头桌面/服务端未接入定位宿主时诚实返回 IsSupported() == false 及零坐标。
public class Geolocation {
    static bool hasMock;
    static double mockLat;
    static double mockLon;
    static double mockAlt;
    static float mockAcc;
    static float mockSpeed;

    // 获取当前时刻的地理坐标与运动指标。
    // 注意：若用户未授予 Location 权限，出于隐私安全将返回经纬度 0.0 且精度 0 的空数据。
    public static LocationData Current() {
        if (!Permissions.IsGranted(PermissionType.Location)) {
            return new LocationData(0.0, 0.0, 0.0, 0.0f, 0.0f, 0);
        }
        long nowMs = DateTime.GetCurrentUnixMilliseconds();
        if (Geolocation.hasMock) {
            return new LocationData(
                Geolocation.mockLat,
                Geolocation.mockLon,
                Geolocation.mockAlt,
                Geolocation.mockAcc,
                Geolocation.mockSpeed,
                nowMs
            );
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            double[] coords = new double[] { 0.0, 0.0, 0.0 };
            float[] metrics = new float[] { 0.0f, 0.0f };
            if (host.LocationGet(coords, metrics) == 0 && coords.Length >= 3 && metrics.Length >= 2) {
                return new LocationData(coords[0], coords[1], coords[2], metrics[0], metrics[1], nowMs);
            }
        }
        return new LocationData(0.0, 0.0, 0.0, 0.0f, 0.0f, 0);
    }

    // 仿真/注入地理位置数据（用于单元测试、模拟路线巡检与无硬件调试）
    public static void Inject(double latitude, double longitude, double altitude, float accuracy, float speed) {
        Geolocation.mockLat = latitude;
        Geolocation.mockLon = longitude;
        Geolocation.mockAlt = altitude;
        Geolocation.mockAcc = accuracy;
        Geolocation.mockSpeed = speed;
        Geolocation.hasMock = true;
    }

    // 清除仿真注入状态。
    public static void Reset() {
        Geolocation.hasMock = false;
        Geolocation.mockLat = 0.0;
        Geolocation.mockLon = 0.0;
        Geolocation.mockAlt = 0.0;
        Geolocation.mockAcc = 0.0f;
        Geolocation.mockSpeed = 0.0f;
    }

    // 地理定位硬件与服务是否可用
    public static bool IsSupported() {
        if (Geolocation.hasMock) { return true; }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            double[] coords = new double[] { 0.0, 0.0, 0.0 };
            float[] metrics = new float[] { 0.0f, 0.0f };
            return host.LocationGet(coords, metrics) == 0;
        }
        return false;
    }
}
