using System;
using Gui.Backend;

namespace System.Hardware;

// 跨平台系统主题与暗黑模式感知门面（SystemTheme）：
// 实时获取操作系统底层的深色/浅色模式外观设置，
// 驱动 GUI 组件树自适应跟随系统外观自动切换。
public class SystemTheme {
    // 操作系统当前是否处于深色/暗黑模式（True 为 Dark Mode）
    public static bool IsDarkMode() {
        return Platform.Shell().IsDarkMode();
    }

    // 仿真/注入当前主题外观（用于调试暗黑模式配色）
    public static void Inject(bool isDark) {
        Platform.Shell().SetDarkMode(isDark);
    }
}
