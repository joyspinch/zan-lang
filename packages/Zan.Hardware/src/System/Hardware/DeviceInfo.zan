using System;
using Gui.Backend;

namespace System.Hardware;

// 设备硬件标识与运行环境标定（DeviceInfo）：
// 提供设备型号、品牌厂商、操作系统版本以及形态（折叠屏/平板/手机）的轻量查询。
// 用于崩溃上报、特定机型 UI 微调与设备行为分流。
public class DeviceInfo {
    // 设备型号（例如 "HUAWEI Mate XT", "Pixel 8 Pro", "iPhone15,2", "PC Desktop"）
    public static string Model() {
        return Platform.Shell().DeviceInfoGet(1);
    }

    // 硬件制造商/品牌（例如 "HUAWEI", "Google", "Apple", "PC Architecture"）
    public static string Manufacturer() {
        return Platform.Shell().DeviceInfoGet(2);
    }

    // 运行操作系统平台名称（例如 "HarmonyOS", "Android", "iOS", "Windows", "Linux"）
    public static string PlatformName() {
        return Platform.Shell().DeviceInfoGet(3);
    }

    // 操作系统内核或发行版版本号（例如 "Next.0.0.36", "14.0", "17.4", "10.0.19044"）
    public static string OSVersion() {
        return Platform.Shell().DeviceInfoGet(4);
    }

    // 当前设备是否为折叠屏硬件形态（外折/内折/三折叠）
    public static bool IsFoldable() {
        return Platform.Shell().DeviceIsFoldable();
    }

    // 仿真/注入设备信息（用于多机型适配自动化测试）
    public static void Inject(string model, string manufacturer, string platform, string osVersion, bool isFoldable) {
        Platform.Shell().DeviceInfoSet(1, model);
        Platform.Shell().DeviceInfoSet(2, manufacturer);
        Platform.Shell().DeviceInfoSet(3, platform);
        Platform.Shell().DeviceInfoSet(4, osVersion);
        Platform.Shell().DeviceInfoSet(5, isFoldable ? "1" : "0");
    }
}
