using System;

namespace System.Hardware;

// 生物识别硬件类型
public enum BiometricType {
    None = 0,           // 0: 设备无生物识别硬件或未录入生物特征凭据
    Fingerprint = 1,    // 1: 屏下/侧边物理指纹识别
    Face = 2,           // 2: 3D 结构光 / 人脸识别（如 Face ID / 鸿蒙人脸）
    Iris = 3            // 3: 虹膜识别
}

// 生物识别与安全隐私鉴权（Biometrics）：
// 封装系统原生 TEE / TrustZone 安全弹窗鉴权流程，用于敏感资产保护、免密登录与支付校验。
// 无头桌面/服务端未注册宿主时诚实返回不支持（CanAuthenticate() == false, Type() == None）。
public class Biometrics {
    static string mockLock = "System.Hardware.Biometrics.mockLock";
    static bool hasMock;
    static bool mockCanAuth;
    static int mockType;
    static bool mockAuthResult;

    // 设备当前是否具备可用的生物识别能力（硬件就绪且用户已在系统设置中录入特征）
    public static bool CanAuthenticate() {
        lock (Biometrics.mockLock) {
            if (Biometrics.hasMock) { return Biometrics.mockCanAuth; }
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) { return host.BiometricsCanAuthenticate(); }
        return false;
    }

    // 获取当前设备的主流生物识别类型
    public static BiometricType Type() {
        lock (Biometrics.mockLock) {
            if (Biometrics.hasMock) {
                if (Biometrics.mockType >= 0 && Biometrics.mockType <= 3) {
                    return (BiometricType)Biometrics.mockType;
                }
                return BiometricType.None;
            }
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            int t = host.BiometricsType();
            if (t >= 0 && t <= 3) {
                return (BiometricType)t;
            }
        }
        return BiometricType.None;
    }

    // 调起系统原生安全鉴权面板（由系统安全隔离区接管UI与特征比对）
    // 返回 true 表示生物特征校验成功；false 表示用户取消、失败或当前环境不支持
    public static bool Authenticate(string title, string subtitle) {
        lock (Biometrics.mockLock) {
            if (Biometrics.hasMock) {
                return Biometrics.mockCanAuth && Biometrics.mockAuthResult;
            }
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            return host.BiometricsAuthenticate(
                title != null ? title : "",
                subtitle != null ? subtitle : ""
            );
        }
        return false;
    }

    // 调起系统原生安全鉴权面板（快捷重载）
    public static bool Authenticate(string title) {
        return Biometrics.Authenticate(title, "");
    }

    // 仿真/注入生物识别状态（用于单元测试与 CI 自动化流水线）
    public static void Inject(bool canAuth, BiometricType bioType, bool authResult) {
        lock (Biometrics.mockLock) {
            Biometrics.mockCanAuth = canAuth;
            Biometrics.mockType = (int)bioType;
            Biometrics.mockAuthResult = authResult;
            Biometrics.hasMock = true;
        }
    }

    // 清除仿真注入状态。
    public static void Reset() {
        lock (Biometrics.mockLock) {
            Biometrics.hasMock = false;
            Biometrics.mockCanAuth = false;
            Biometrics.mockType = 0;
            Biometrics.mockAuthResult = false;
        }
    }
}
