using System;
using System.Management;

namespace System.Hardware;

// 跨平台电池与电源管理门面（Battery）：
// 实时探测设备电池余量百分比、充电状态与节能低电量模式，
// 用于游戏或高刷渲染界面在低电量时自适应降频以保护设备续航。
public class Battery {
    // 获取当前电池电量百分比（0 ~ 100）；若无电池或未知则返回 -1
    public static int Level() {
        PowerStatus ps = Power.GetStatus();
        return ps.batteryPercent;
    }

    // 设备当前是否正由电池供电（True 为纯电池运行，False 为接通电源）
    public static bool IsOnBattery() {
        return Power.OnBattery();
    }

    // 设备当前是否处于外接交流电源充电状态
    public static bool IsCharging() {
        return !Power.OnBattery();
    }

    // 是否处于低电量预警状态（电量低于 20% 且使用电池运行）
    public static bool IsLowPowerMode() {
        int lvl = Battery.Level();
        return Battery.IsOnBattery() && lvl >= 0 && lvl <= 20;
    }
}
