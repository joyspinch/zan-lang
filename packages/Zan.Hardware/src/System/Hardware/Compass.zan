using System;

namespace System.Hardware;

// 电子罗盘 / 磁力计（Compass）：
// 测量设备相对于地磁北极的航向偏角（Heading，0.0° ~ 360.0°）。
// 广泛用于地图导航探路、罗盘寻向、AR 现实增强对齐。
public class Compass {
    static bool hasMock;
    static float mockHeading;

    static float NormalizeHeading(float h) {
        while (h < 0.0f) { h = h + 360.0f; }
        while (h >= 360.0f) { h = h - 360.0f; }
        return h;
    }

    // 获取当前指南针朝向角度（0.0° ~ 360.0°，0° 为地磁正北）；不可用时返回 0.0f。
    public static float Heading() {
        if (Compass.hasMock) {
            return Compass.NormalizeHeading(Compass.mockHeading);
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            float[] buf = new float[] { 0.0f, 0.0f, 0.0f };
            if (host.SensorGet(3, buf) == 0 && buf.Length >= 1) {
                return Compass.NormalizeHeading(buf[0]);
            }
        }
        return 0.0f;
    }

    // 仿真/注入罗盘航向角度
    public static void Inject(float heading) {
        Compass.mockHeading = heading;
        Compass.hasMock = true;
        IHardwareHost host = HardwareHost.Current();
        if (host != null) { host.SensorSet(3, heading, 0.0f, 0.0f); }
    }

    // 清除仿真注入状态。
    public static void Reset() {
        Compass.hasMock = false;
        Compass.mockHeading = 0.0f;
    }

    // 罗盘是否可用
    public static bool IsSupported() {
        if (Compass.hasMock) { return true; }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            float[] buf = new float[] { 0.0f, 0.0f, 0.0f };
            return host.SensorGet(3, buf) == 0;
        }
        return false;
    }
}
