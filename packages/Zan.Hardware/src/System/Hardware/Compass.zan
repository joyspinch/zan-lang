using System;
using Gui.Backend;

namespace System.Hardware;

// 电子罗盘 / 磁力计（Compass）：
// 测量设备相对于地磁北极的航向偏角（Heading，0.0° ~ 360.0°）。
// 广泛用于地图导航探路、罗盘寻向、AR 现实增强对齐。
public class Compass {
    private static float[] rawBuffer = new float[] { 0.0f, 0.0f, 0.0f };

    // 获取当前指南针朝向角度（0.0° ~ 360.0°，0° 为地磁正北）
    public static float Heading() {
        int ret = Platform.Shell().SensorGet(3, rawBuffer);
        if (ret == 0 && rawBuffer.Length >= 1) {
            float h = rawBuffer[0];
            while (h < 0.0f) { h = h + 360.0f; }
            while (h >= 360.0f) { h = h - 360.0f; }
            return h;
        }
        return 0.0f;
    }

    // 仿真/注入罗盘航向角度
    public static void Inject(float heading) {
        Platform.Shell().SensorSet(3, heading, 0.0f, 0.0f);
    }

    // 罗盘是否可用
    public static bool IsSupported() {
        return Platform.Shell().SensorGet(3, rawBuffer) == 0;
    }
}
