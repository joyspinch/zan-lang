using System;
using Gui.Backend;

namespace System.Hardware;

// 系统状态栏图标与文字风格
public enum StatusBarStyle {
    Default = 0,    // 0: 跟随操作系统默认外观
    LightIcons = 1, // 1: 浅色/白色文字与图标（适用于深色/暗黑背景、夜间模式、全屏视频）
    DarkIcons = 2   // 2: 深色/黑色文字与图标（适用于白色/浅色背景、标准亮色页面）
}

// 沉浸式系统状态栏与导航栏控制（SystemBar）：
// 控制移动端/折叠屏顶部的系统状态栏（时间/电量/网络图标）与底部手势导航条的显隐与色彩对比度。
public class SystemBar {
    // 设置状态栏文字/图标颜色风格（LightIcons / DarkIcons）
    public static void SetStyle(StatusBarStyle style) {
        bool vis = SystemBar.IsVisible();
        int col = SystemBar.Color();
        Platform.Shell().SystemBarSetStatus(vis, (int)style, col);
    }

    // 获取当前状态栏风格
    public static StatusBarStyle Style() {
        int s = Platform.Shell().SystemBarStyle();
        if (s >= 0 && s <= 2) {
            return (StatusBarStyle)s;
        }
        return StatusBarStyle.Default;
    }

    // 显示或隐藏顶部系统状态栏
    public static void SetVisible(bool visible) {
        int s = Platform.Shell().SystemBarStyle();
        int col = SystemBar.Color();
        Platform.Shell().SystemBarSetStatus(visible, s, col);
    }

    // 查询状态栏是否可见
    public static bool IsVisible() {
        return Platform.Shell().SystemBarIsStatusVisible();
    }

    // 设置状态栏背景底色（ARGB 32位色值，支持半透明沉浸）
    public static void SetColor(int argb) {
        bool vis = SystemBar.IsVisible();
        int s = Platform.Shell().SystemBarStyle();
        Platform.Shell().SystemBarSetStatus(vis, s, argb);
    }

    // 获取当前状态栏底色
    public static int Color() {
        return Platform.Shell().SystemBarColor();
    }

    // 显示或隐藏底部虚拟按键/手势操作横条（NavigationBar）
    public static void SetNavVisible(bool visible) {
        Platform.Shell().SystemBarSetNavVisible(visible);
    }

    // 查询底部导航栏是否可见
    public static bool IsNavVisible() {
        return Platform.Shell().SystemBarIsNavVisible();
    }

    // 一键切换全屏沉浸模式（隐藏状态栏与导航条，如游戏/全屏看图）
    public static void SetImmersive(bool immersive) {
        SystemBar.SetVisible(!immersive);
        SystemBar.SetNavVisible(!immersive);
    }

    // 快捷切换为深色文字图标模式（白底黑字，适用于常规白底页面）
    public static void SetDarkIcons() {
        SystemBar.SetStyle(StatusBarStyle.DarkIcons);
    }

    // 快捷切换为浅色文字图标模式（黑底白字，适用于深色背景或视频播放）
    public static void SetLightIcons() {
        SystemBar.SetStyle(StatusBarStyle.LightIcons);
    }
}
