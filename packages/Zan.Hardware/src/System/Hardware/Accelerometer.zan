using System;
using System.Numerics;

namespace System.Hardware;

// 三轴加速度计（Accelerometer）：
// 测量设备在 X、Y、Z 三个物理轴向上承受的加速度总和（单位 m/s^2）。
// 广泛用于摇一摇、倾斜检测、计步、重力感应。
// 无头桌面/服务端默认不可用（IsSupported()==false），需由移动端 HardwareHost 或 Inject 提供。
public class Accelerometer {
    static bool hasMock;
    static float mockX;
    static float mockY;
    static float mockZ;

    // 获取当前瞬间的三轴加速度（X, Y, Z，单位 m/s^2）；不可用时返回零向量。
    public static Vector3 Current() {
        if (Accelerometer.hasMock) {
            return new Vector3(Accelerometer.mockX, Accelerometer.mockY, Accelerometer.mockZ);
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            float[] buf = new float[] { 0.0f, 0.0f, 0.0f };
            if (host.SensorGet(1, buf) == 0 && buf.Length >= 3) {
                return new Vector3(buf[0], buf[1], buf[2]);
            }
        }
        return Vector3.Zero;
    }

    // 仿真/注入加速度计读数（用于单元测试与调试）
    public static void Inject(float x, float y, float z) {
        Accelerometer.mockX = x;
        Accelerometer.mockY = y;
        Accelerometer.mockZ = z;
        Accelerometer.hasMock = true;
        IHardwareHost host = HardwareHost.Current();
        if (host != null) { host.SensorSet(1, x, y, z); }
    }

    // 清除仿真注入状态。
    public static void Reset() {
        Accelerometer.hasMock = false;
        Accelerometer.mockX = 0.0f;
        Accelerometer.mockY = 0.0f;
        Accelerometer.mockZ = 0.0f;
    }

    // 传感器是否可用
    public static bool IsSupported() {
        if (Accelerometer.hasMock) { return true; }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            float[] buf = new float[] { 0.0f, 0.0f, 0.0f };
            return host.SensorGet(1, buf) == 0;
        }
        return false;
    }
}
