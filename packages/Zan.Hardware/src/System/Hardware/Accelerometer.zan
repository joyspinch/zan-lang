using System;
using System.Numerics;
using Gui.Backend;

namespace System.Hardware;

// 三轴加速度计（Accelerometer）：
// 测量设备在 X、Y、Z 三个物理轴向上承受的加速度总和（含重力加速度 9.8 m/s^2）。
// 广泛用于摇一摇、倾斜检测、计步、重力感应。
public class Accelerometer {
    private static float[] rawBuffer = new float[] { 0.0f, 9.8f, 0.0f };

    // 获取当前瞬间的三轴加速度（X, Y, Z，单位 m/s^2）
    public static Vector3 Current() {
        int ret = Platform.Shell().SensorGet(1, rawBuffer);
        if (ret == 0 && rawBuffer.Length >= 3) {
            return new Vector3(rawBuffer[0], rawBuffer[1], rawBuffer[2]);
        }
        return new Vector3(0.0f, 9.8f, 0.0f);
    }

    // 仿真/注入加速度计读数（用于单元测试与调试）
    public static void Inject(float x, float y, float z) {
        Platform.Shell().SensorSet(1, x, y, z);
    }

    // 传感器是否可用
    public static bool IsSupported() {
        return Platform.Shell().SensorGet(1, rawBuffer) == 0;
    }
}
