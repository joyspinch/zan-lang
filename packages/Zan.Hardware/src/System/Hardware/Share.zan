using System;
using Gui.Backend;

namespace System.Hardware;

// 跨平台系统原生分享门面（Share）：
// 调起移动操作系统原生分享面板（ShareSheet：iOS UIActivityViewController、
// 鸿蒙 ShareSheet、Android ACTION_SEND），桌面端优雅回退至系统剪贴板。
public class Share {
    // 调起原生分享面板分享文本或链接
    public static bool Text(string text, string title) {
        if (text == null) { return false; }
        return Platform.Shell().ShareText(text, title != null ? title : "") == 0;
    }

    public static bool Text(string text) {
        return Share.Text(text, "");
    }
}
