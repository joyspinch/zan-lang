using System;

namespace System.Hardware;

// 跨平台系统原生分享门面（Share）：
// 调起移动操作系统或桌面外壳注册的原生分享面板；未注册宿主时返回 false。
public class Share {
    // 调起原生分享面板分享文本或链接
    public static bool Text(string text, string title) {
        if (text == null) { return false; }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            return host.ShareText(text, title != null ? title : "") == 0;
        }
        return false;
    }

    public static bool Text(string text) {
        return Share.Text(text, "");
    }
}
