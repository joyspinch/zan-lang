using System;
using Gui.Backend;

namespace System.Hardware;

// 系统敏感权限类型
public enum PermissionType {
    Location = 0,       // 0: GPS 定位权限
    Camera = 1,         // 1: 相机拍摄权限
    Microphone = 2,     // 2: 麦克风录音权限
    Notification = 3,   // 3: 锁屏与系统推送通知权限
    Photo = 4           // 4: 系统相册读取权限
}

// 权限授权状态
public enum PermissionStatus {
    Granted = 0,        // 0: 用户已授权，可正常调用硬件
    Denied = 1,         // 1: 用户已拒绝访问
    Restricted = 2      // 2: 受家长控制或企业 MDM 策略限制
}

// 统一动态运行时权限管理中枢（Permissions）：
// 在移动端（iOS / Android / HarmonyOS NEXT）弹出系统级隐私授权弹窗，
// 桌面端默认全绿直通（Granted），并支持通过 Inject 注入状态进行单元测试。
public class Permissions {
    // 检查权限授权状态
    public static PermissionStatus Check(PermissionType type) {
        int status = Platform.Shell().PermissionCheck((int)type);
        if (status >= 0 && status <= 2) {
            return (PermissionStatus)status;
        }
        return PermissionStatus.Denied;
    }

    // 主动向用户申请敏感硬件权限（若未授权将弹出系统级原生对话框）
    public static PermissionStatus Request(PermissionType type) {
        int status = Platform.Shell().PermissionRequest((int)type);
        if (status >= 0 && status <= 2) {
            return (PermissionStatus)status;
        }
        return PermissionStatus.Denied;
    }

    // 快捷判断某项权限是否已获授权
    public static bool IsGranted(PermissionType type) {
        return Permissions.Check(type) == PermissionStatus.Granted;
    }

    // 仿真/注入权限状态（用于模拟用户拒绝/授权的测试场景）
    public static void Inject(PermissionType type, PermissionStatus status) {
        Platform.Shell().SetPermission((int)type, (int)status);
    }
}
