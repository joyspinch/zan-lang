using System;

namespace System.Hardware;

// 系统敏感权限类型
public enum PermissionType {
    Location = 0,       // 0: GPS 定位权限
    Camera = 1,         // 1: 相机拍摄权限
    Microphone = 2,     // 2: 麦克风录音权限
    Notification = 3,   // 3: 锁屏与系统推送通知权限
    Photo = 4           // 4: 系统相册读取权限
}

// 权限授权状态
public enum PermissionStatus {
    Unknown = -1,       // -1: 当前平台不支持或无法观测该动态权限状态
    Granted = 0,        // 0: 用户已授权，可正常调用硬件
    Denied = 1,         // 1: 用户已拒绝访问
    Restricted = 2      // 2: 受家长控制或企业 MDM 策略限制
}

// 统一动态运行时权限管理中枢（Permissions）：
// 移动端由宿主桥接弹出系统隐私授权弹窗；桌面/服务端无动态移动权限模型时
// 诚实返回 Unknown（不再伪造 Granted 或将 -1 折算为 Denied），并支持 Inject/Reset 用于测试。
public class Permissions {
    static string mockLock = "System.Hardware.Permissions.mockLock";
    static int mock0 = -2;
    static int mock1 = -2;
    static int mock2 = -2;
    static int mock3 = -2;
    static int mock4 = -2;

    static int GetMock(int idx) {
        lock (Permissions.mockLock) {
            if (idx == 0) { return Permissions.mock0; }
            if (idx == 1) { return Permissions.mock1; }
            if (idx == 2) { return Permissions.mock2; }
            if (idx == 3) { return Permissions.mock3; }
            if (idx == 4) { return Permissions.mock4; }
            return -2;
        }
    }

    static void SetMock(int idx, int val) {
        lock (Permissions.mockLock) {
            if (idx == 0) { Permissions.mock0 = val; }
            else if (idx == 1) { Permissions.mock1 = val; }
            else if (idx == 2) { Permissions.mock2 = val; }
            else if (idx == 3) { Permissions.mock3 = val; }
            else if (idx == 4) { Permissions.mock4 = val; }
        }
    }

    // 检查权限授权状态
    public static PermissionStatus Check(PermissionType type) {
        int m = Permissions.GetMock((int)type);
        if (m >= -1 && m <= 2) {
            return (PermissionStatus)m;
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            int status = host.PermissionCheck((int)type);
            if (status >= 0 && status <= 2) {
                return (PermissionStatus)status;
            }
            return PermissionStatus.Unknown;
        }
        return PermissionStatus.Unknown;
    }

    // 主动向用户申请敏感硬件权限（若未授权将弹出系统级原生对话框）
    public static PermissionStatus Request(PermissionType type) {
        int m = Permissions.GetMock((int)type);
        if (m >= -1 && m <= 2) {
            return (PermissionStatus)m;
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            int status = host.PermissionRequest((int)type);
            if (status >= 0 && status <= 2) {
                return (PermissionStatus)status;
            }
            return PermissionStatus.Unknown;
        }
        return PermissionStatus.Unknown;
    }

    // 快捷判断某项权限是否已获授权
    public static bool IsGranted(PermissionType type) {
        return Permissions.Check(type) == PermissionStatus.Granted;
    }

    // 仿真/注入权限状态（用于模拟用户拒绝/授权的测试场景）
    public static void Inject(PermissionType type, PermissionStatus status) {
        Permissions.SetMock((int)type, (int)status);
    }

    // 清除全部权限仿真注入状态。
    public static void Reset() {
        lock (Permissions.mockLock) {
            Permissions.mock0 = -2;
            Permissions.mock1 = -2;
            Permissions.mock2 = -2;
            Permissions.mock3 = -2;
            Permissions.mock4 = -2;
        }
    }
}
