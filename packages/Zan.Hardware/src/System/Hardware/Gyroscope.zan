using System;
using System.Numerics;
using Gui.Backend;

namespace System.Hardware;

// 三轴陀螺仪（Gyroscope）：
// 测量设备绕自身 X、Y、Z 物理轴旋转时的即时角速度（单位 rad/s）。
// 广泛用于体感射击瞄准、相机云台防抖、VR/AR 姿态追踪、赛车转向。
public class Gyroscope {
    private static float[] rawBuffer = new float[] { 0.0f, 0.0f, 0.0f };

    // 获取当前瞬间的三轴旋转角速度（X, Y, Z，单位 rad/s）
    public static Vector3 Current() {
        int ret = Platform.Shell().SensorGet(2, rawBuffer);
        if (ret == 0 && rawBuffer.Length >= 3) {
            return new Vector3(rawBuffer[0], rawBuffer[1], rawBuffer[2]);
        }
        return Vector3.Zero;
    }

    // 仿真/注入陀螺仪角速度（用于单元测试与调试）
    public static void Inject(float x, float y, float z) {
        Platform.Shell().SensorSet(2, x, y, z);
    }

    // 传感器是否可用
    public static bool IsSupported() {
        return Platform.Shell().SensorGet(2, rawBuffer) == 0;
    }
}
