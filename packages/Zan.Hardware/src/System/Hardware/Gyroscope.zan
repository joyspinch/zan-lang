using System;
using System.Numerics;

namespace System.Hardware;

// 三轴陀螺仪（Gyroscope）：
// 测量设备绕自身 X、Y、Z 物理轴旋转时的即时角速度（单位 rad/s）。
// 广泛用于体感射击瞄准、相机云台防抖、VR/AR 姿态追踪、赛车转向。
public class Gyroscope {
    static string mockLock = "System.Hardware.Gyroscope.mockLock";
    static bool hasMock;
    static float mockX;
    static float mockY;
    static float mockZ;

    // 获取当前瞬间的三轴旋转角速度（X, Y, Z，单位 rad/s）；不可用时返回零向量。
    public static Vector3 Current() {
        lock (Gyroscope.mockLock) {
            if (Gyroscope.hasMock) {
                return new Vector3(Gyroscope.mockX, Gyroscope.mockY, Gyroscope.mockZ);
            }
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            float[] buf = new float[] { 0.0f, 0.0f, 0.0f };
            if (host.SensorGet(2, buf) == 0 && buf.Length >= 3) {
                return new Vector3(buf[0], buf[1], buf[2]);
            }
        }
        return Vector3.Zero;
    }

    // 仿真/注入陀螺仪角速度（用于单元测试与调试）
    public static void Inject(float x, float y, float z) {
        lock (Gyroscope.mockLock) {
            Gyroscope.mockX = x;
            Gyroscope.mockY = y;
            Gyroscope.mockZ = z;
            Gyroscope.hasMock = true;
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) { host.SensorSet(2, x, y, z); }
    }

    // 清除仿真注入状态。
    public static void Reset() {
        lock (Gyroscope.mockLock) {
            Gyroscope.hasMock = false;
            Gyroscope.mockX = 0.0f;
            Gyroscope.mockY = 0.0f;
            Gyroscope.mockZ = 0.0f;
        }
    }

    // 传感器是否可用
    public static bool IsSupported() {
        lock (Gyroscope.mockLock) {
            if (Gyroscope.hasMock) { return true; }
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            float[] buf = new float[] { 0.0f, 0.0f, 0.0f };
            return host.SensorGet(2, buf) == 0;
        }
        return false;
    }
}
