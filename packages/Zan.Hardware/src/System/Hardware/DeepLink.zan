using System;

namespace System.Hardware;

// 深度链接与外部唤醒中枢（DeepLink）：
// 处理外部浏览器、第三方社交应用点击自定义 URL Scheme 或 Universal Link 唤起本 App。
public class DeepLink {
    static string sync = "System.Hardware.DeepLink.sync";
    static bool hasMockUrl;
    static string pendingUrl;

    // 读取并消费当前挂起的外部唤醒 URL（消费性读取，取出后内部队列将自动清空）。
    // 若当前无唤醒请求则返回空字符串 ""。
    public static string TakePendingUrl() {
        lock (DeepLink.sync) {
            if (DeepLink.hasMockUrl) {
                string url = DeepLink.pendingUrl != null ? DeepLink.pendingUrl : "";
                DeepLink.pendingUrl = null;
                DeepLink.hasMockUrl = false;
                return url;
            }
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            string u = host.TakeOpenUrl();
            return u != null ? u : "";
        }
        return "";
    }

    // 检查当前是否有外部唤醒 URL 等待处理
    public static bool HasPendingUrl() {
        lock (DeepLink.sync) {
            if (DeepLink.hasMockUrl) {
                return DeepLink.pendingUrl != null && DeepLink.pendingUrl.Length > 0;
            }
        }
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            string url = host.TakeOpenUrl();
            if (url != null && url.Length > 0) {
                host.InjectOpenUrl(url);
                return true;
            }
        }
        return false;
    }

    // 仿真/注入外部唤醒 URL（用于单元测试、模拟冷启动或热唤醒跳转）
    public static void Inject(string url) {
        string val = url != null ? url : "";
        IHardwareHost host = HardwareHost.Current();
        if (host != null) {
            lock (DeepLink.sync) {
                DeepLink.pendingUrl = null;
                DeepLink.hasMockUrl = false;
            }
            host.InjectOpenUrl(val);
            return;
        }
        lock (DeepLink.sync) {
            DeepLink.pendingUrl = val;
            DeepLink.hasMockUrl = val.Length > 0;
        }
    }

    // 清除挂起的仿真唤醒 URL。
    public static void Reset() {
        lock (DeepLink.sync) {
            DeepLink.pendingUrl = null;
            DeepLink.hasMockUrl = false;
        }
    }

    // 辅助解析：从 URL 中提取协议头 Scheme（例如 "zanapp://..." 返回 "zanapp"）
    public static string ExtractScheme(string url) {
        if (url == null || url.Length == 0) { return ""; }
        int idx = url.IndexOf("://");
        if (idx > 0) {
            return url.Substring(0, idx);
        }
        return "";
    }
}
