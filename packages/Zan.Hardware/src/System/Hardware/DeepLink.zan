using System;
using Gui.Backend;

namespace System.Hardware;

// 深度链接与外部唤醒中枢（DeepLink）：
// 处理外部浏览器、第三方社交应用点击自定义 URL Scheme 或 Universal Link 唤起本 App。
public class DeepLink {
    // 读取并消费当前挂起的外部唤醒 URL（消费性读取，取出后内部队列将自动清空）。
    // 若当前无唤醒请求则返回空字符串 ""。
    public static string TakePendingUrl() {
        return Platform.Shell().TakeOpenUrl();
    }

    // 检查当前是否有外部唤醒 URL 等待处理
    public static bool HasPendingUrl() {
        string url = DeepLink.TakePendingUrl();
        if (url.Length > 0) {
            // 重新塞回以便业务层稍后消费
            DeepLink.Inject(url);
            return true;
        }
        return false;
    }

    // 仿真/注入外部唤醒 URL（用于单元测试、模拟冷启动或热唤醒跳转）
    public static void Inject(string url) {
        Platform.Shell().InjectOpenUrl(url);
    }

    // 辅助解析：从 URL 中提取协议头 Scheme（例如 "zanapp://..." 返回 "zanapp"）
    public static string ExtractScheme(string url) {
        if (url == null || url.Length == 0) { return ""; }
        int idx = url.IndexOf("://");
        if (idx > 0) {
            return url.Substring(0, idx);
        }
        return "";
    }
}
