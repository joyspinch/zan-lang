using System;

namespace Game.HardcoreCombat;

// 削韧与失衡硬直系统（PoiseSystem）。
// 对应魂系与格斗动作游戏标志性的“架势条/韧性条”：
// 每次重击削减韧性，韧性归零打破防（Stagger），进入倒地虚弱或处决硬直态。
public class PoiseSystem {
    public double maxPoise;
    public double currentPoise;
    public double regenRate;        // 每秒自然回复速度 (默认 20.0/s)
    public double regenDelay;       // 受击后恢复延迟 (默认 1.2s)
    public double staggerDuration;  // 破防失衡僵直时间 (默认 1.5s)

    public double delayTimer;
    public double staggerTimer;
    public bool isStaggered;        // 当前是否处于失衡大硬直状态

    public PoiseSystem(double maxPoise) {
        this.maxPoise = maxPoise > 0.0 ? maxPoise : 100.0;
        this.currentPoise = this.maxPoise;
        this.regenRate = 20.0;
        this.regenDelay = 1.2;
        this.staggerDuration = 1.5;
        this.delayTimer = 0.0;
        this.staggerTimer = 0.0;
        this.isStaggered = false;
    }

    public static PoiseSystem Create(double maxPoise) {
        return new PoiseSystem(maxPoise);
    }

    public double Current { get { return currentPoise; } }
    public double Max { get { return maxPoise; } }
    public bool IsStaggered { get { return isStaggered; } }
    public double Percentage { get { return maxPoise > 0.0 ? currentPoise / maxPoise : 0.0; } }

    // 受到削韧打击。
    // 返回 true 表示本次受击导致韧性彻底被击穿，触发了破防失衡（Stagger）！
    public bool ApplyPoiseDamage(double poiseDamage) {
        if (poiseDamage <= 0.0) { return false; }

        delayTimer = regenDelay;

        // 如果已经在失衡状态，刷新僵直时间
        if (isStaggered) {
            staggerTimer = staggerDuration;
            return false;
        }

        currentPoise = currentPoise - poiseDamage;
        if (currentPoise <= 0.0) {
            currentPoise = 0.0;
            isStaggered = true;
            staggerTimer = staggerDuration;
            return true; // 触发破防！
        }
        return false;
    }

    // 时钟步进更新
    public void Update(double dt) {
        if (dt <= 0.0) { return; }

        // 1. 如果处于失衡大硬直态，倒计时
        if (isStaggered) {
            staggerTimer = staggerTimer - dt;
            if (staggerTimer <= 0.0) {
                // 失衡结束，满状态复原
                isStaggered = false;
                staggerTimer = 0.0;
                currentPoise = maxPoise;
                delayTimer = 0.0;
            }
            return;
        }

        // 2. 受击自然恢复延迟
        if (delayTimer > 0.0) {
            delayTimer = delayTimer - dt;
            if (delayTimer > 0.0) { return; }
        }

        // 3. 韧性自然回升
        if (currentPoise < maxPoise) {
            currentPoise = currentPoise + regenRate * dt;
            if (currentPoise > maxPoise) {
                currentPoise = maxPoise;
            }
        }
    }

    public void Reset() {
        currentPoise = maxPoise;
        delayTimer = 0.0;
        staggerTimer = 0.0;
        isStaggered = false;
    }
}
