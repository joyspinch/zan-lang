using System;

namespace Game.HardcoreCombat;

// 魂系与硬核动作精力/耐力槽系统（StaminaSystem）。
// 对应《黑神话》、《艾尔登法环》、《空洞骑士》等动作核心机制：
// 精确耐力消耗、耗尽虚脱态惩罚（Exhaustion Penalty）、动作后恢复延迟与自然回力。
public class StaminaSystem {
    public double maxStamina;
    public double currentStamina;
    public double regenRate;       // 每秒自然恢复速度（默认 35.0/s）
    public double regenDelay;      // 每次动作消耗后的恢复延迟（秒，默认 0.8s）
    public double exhaustThreshold;// 虚脱后必须恢复达到的最低耐力值才可重新行动（默认 20.0）

    public double delayTimer;      // 延迟计时器
    public bool isExhausted;       // 是否处于虚脱态（禁止使用任何耗精力动作）

    public StaminaSystem(double maxStamina, double regenRate) {
        this.maxStamina = maxStamina > 0.0 ? maxStamina : 100.0;
        this.currentStamina = this.maxStamina;
        this.regenRate = regenRate > 0.0 ? regenRate : 35.0;
        this.regenDelay = 0.8;
        this.exhaustThreshold = 20.0;
        this.delayTimer = 0.0;
        this.isExhausted = false;
    }

    public static StaminaSystem Create(double maxStamina, double regenRate) {
        return new StaminaSystem(maxStamina, regenRate);
    }

    public double Current { get { return currentStamina; } }
    public double Max { get { return maxStamina; } }
    public bool IsExhausted { get { return isExhausted; } }
    public double Percentage { get { return maxStamina > 0.0 ? currentStamina / maxStamina : 0.0; } }

    // 检查是否具备消耗 cost 精力的能力（虚脱中或耐力不足均拒绝）
    public bool CanConsume(double cost) {
        if (isExhausted) { return false; }
        return currentStamina >= cost;
    }

    // 尝试消耗耐力（如攻击、闪避、翻滚、招架）
    // 返回 true 表示成功扣减；返回 false 表示无法执行该动作
    public bool Consume(double cost) {
        if (!CanConsume(cost)) {
            return false;
        }

        currentStamina = currentStamina - cost;
        delayTimer = regenDelay; // 重置自然恢复倒计时

        if (currentStamina <= 0.0) {
            currentStamina = 0.0;
            isExhausted = true; // 耐力归零，触发虚脱惩罚态
        }
        return true;
    }

    // 强制强扣耐力（例如格挡敌方重击被打空精力）
    public void ForceDamage(double damage) {
        currentStamina = currentStamina - damage;
        delayTimer = regenDelay * 1.5; // 被破防后恢复延迟加倍
        if (currentStamina <= 0.0) {
            currentStamina = 0.0;
            isExhausted = true;
        }
    }

    // 时钟步进更新：处理延迟倒计时与耐力自然回复
    public void Update(double dt) {
        if (dt <= 0.0) { return; }

        if (delayTimer > 0.0) {
            delayTimer = delayTimer - dt;
            if (delayTimer > 0.0) { return; }
        }

        if (currentStamina < maxStamina) {
            currentStamina = currentStamina + regenRate * dt;
            if (currentStamina >= maxStamina) {
                currentStamina = maxStamina;
            }
        }

        // 检查虚脱态解除
        if (isExhausted && currentStamina >= exhaustThreshold) {
            isExhausted = false;
        }
    }

    // 立即重置到满耐力
    public void Reset() {
        currentStamina = maxStamina;
        delayTimer = 0.0;
        isExhausted = false;
    }
}
