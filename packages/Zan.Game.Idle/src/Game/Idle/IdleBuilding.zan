using System;

namespace Game.Idle;

// 放置挂机的建筑：等级、成本倍率、每秒产出。
//
// **机制与内容分离**：名字、描述、基础价、基础产出属于"这个游戏"，
// 由调用方自己填（idle 模板的 MineCatalog 就是那份内容表）；
// 这里只管通用的升级曲线与产出计算——换个挂机游戏还成立。
public class IdleBuilding {
    public int id;
    public string name;
    public string desc;
    public int level;
    public long baseCost;
    public long baseDps;
    public double costMult;

    // 默认成本倍率 1.15（每级涨价 15%）。
    public IdleBuilding(int id, string name, string desc, long baseCost, long baseDps) {
        this.id = id;
        this.name = name;
        this.desc = desc;
        this.level = 0;
        this.baseCost = baseCost;
        this.baseDps = baseDps;
        this.costMult = 1.15;
    }

    public IdleBuilding(int id, string name, string desc, long baseCost, long baseDps, double costMult) {
        this.id = id;
        this.name = name;
        this.desc = desc;
        this.level = 0;
        this.baseCost = baseCost;
        this.baseDps = baseDps;
        this.costMult = costMult;
    }

    // 读接口（界面与存档用属性名，字段留给内部直接改）。
    public string Name { get { return this.name; } }
    public string Desc { get { return this.desc; } }
    public int Level { get { return this.level; } }

    // 升级价 = 基础价 × 成本倍率^等级（长整截断）。
    public long Cost {
        get { return (long)((double)this.baseCost * Math.Pow(this.costMult, (double)this.level)); }
    }

    // 每秒产出 = 基础产出 × 等级（0 级不产出，与"先造后产"的直觉一致）。
    public long Dps {
        get { return this.baseDps * (long)this.level; }
    }

    public void Upgrade() {
        this.level = this.level + 1;
    }
}
