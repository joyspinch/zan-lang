using System;

namespace Game.Idle;

// 放置类数值曲线：生产/成本/收益三件套的标准公式库。
// 成本走 `cost = base * rate^(owned - baseOwned)`（指数，买 N 个后
// 下一个的价格），产出走 `rate * owned * prestigeMul`，等级收益走
// 幂律。全部 long 运算（千分位定点，除法带四舍五入），与 BigNum/
// 资源容器同单位。曲线参数一旦发布不可改——会破坏存量存档的
// 购买力，改数值只能加新参数并做版本迁移。
public class Curves {
    private const long LongMax = 9223372036854775807L;

    // 指数成本：第 `owned`（已拥有数，从 0 起）件之后的下一件价格。
    // cost = base * rate^owned，rate 千分比（1150 = ×1.15）。
    // 乘方用循环乘，`owned` 超过 64 时按 64 截断（rate>=1050 时
    // 价格早已溢出 long，截断点由饱和乘法收口）。
    public static long CostNext(long baseCost, int ratePermille, int owned) {
        if (baseCost <= 0) { return 0; }
        long c = baseCost;
        int n = owned;
        if (n < 0) { n = 0; }
        if (n > 64) { n = 64; }
        for (int i = 0; i < n; i = i + 1) {
            c = MulPermille(c, ratePermille);
            if (c >= Curves.LongMax || c <= 0) { break; }
        }
        return c;
    }

    // 从 `owned` 起、连买 `count` 件的总价（批量购买面板用）。
    // 等比求和的整数近似：递推累加（count 上限 1000，防长循环，由 O(N*64) 降至 O(N)）。
    public static long CostBulk(long baseCost, int ratePermille, int owned, int count) {
        if (count <= 0 || baseCost <= 0) { return 0; }
        int n = count;
        if (n > 1000) { n = 1000; }
        long curCost = CostNext(baseCost, ratePermille, owned);
        long total = 0;
        for (int i = 0; i < n; i = i + 1) {
            total = Curves.AddSaturate(total, curCost);
            if (total >= Curves.LongMax) { return Curves.LongMax; }
            if (owned + i < 64) {
                curCost = MulPermille(curCost, ratePermille);
            }
        }
        return total;
    }

    // 千分比乘法：(v * p) / 1000，四舍五入、溢出饱和停在 LongMax（绝不回绕成负/0）。
    public static long MulPermille(long v, int p) {
        if (v <= 0 || p <= 0) { return 0; }
        long pl = (long)p;
        long q = v / 1000L;
        long rem = v % 1000L;
        if (q > Curves.LongMax / pl) { return Curves.LongMax; }
        long hi = q * pl;
        long lo = (rem * pl + 500L) / 1000L;
        if (hi > Curves.LongMax - lo) { return Curves.LongMax; }
        return hi + lo;
    }

    // 产出速率：`unitRate * owned`（千分位/秒），乘 prestige 倍率。
    public static long RateAt(long unitRate, int owned, int prestigePermille) {
        if (unitRate <= 0 || owned <= 0 || prestigePermille <= 0) { return 0; }
        long baseRate = unitRate > Curves.LongMax / (long)owned
            ? Curves.LongMax
            : unitRate * (long)owned;
        return MulPermille(baseRate, prestigePermille);
    }

    // 等级幂律属性：`base * (level ^ exp)` 的千分位定点近似——
    // 逐级累乘逼近，exp 千分比（1100 = 每级 ×1.10）。饱和后提前退出，步数封顶 1024。
    public static long PowerCurve(long baseVal, int level, int expPermille) {
        if (baseVal <= 0) { return 0; }
        if (level <= 1) { return baseVal; }
        if (expPermille <= 0) { return 0; }
        long v = baseVal;
        int steps = level - 1;
        if (steps > 1024) { steps = 1024; }
        for (int lv = 0; lv < steps; lv = lv + 1) {
            v = MulPermille(v, expPermille);
            if (v <= 0 || v >= Curves.LongMax) { break; }
        }
        return v;
    }

    // 非负饱和加法：避免正数相加溢出回绕成负值触发“免费购买”漏洞。
    private static long AddSaturate(long a, long b) {
        if (a <= 0) { return b <= 0 ? 0 : b; }
        if (b <= 0) { return a; }
        if (a > Curves.LongMax - b) { return Curves.LongMax; }
        return a + b;
    }

    // 非负钳制（供外部对单一值做下界保护；乘法/加法饱和由 MulPermille / AddSaturate 在溢出前兜住）。
    public static long ClampLong(long v) {
        if (v < 0) { return 0; }
        return v;
    }
}
