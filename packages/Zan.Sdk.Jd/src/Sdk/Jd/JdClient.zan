using System;
using System.Text;
using System.Net.Http.Client;

namespace Sdk.Jd;

/// <summary>
/// 京东开放平台（JOS）客户端。
///
/// 用法（一行可用）：
/// <code>
/// JdClient client = new JdClient("your-app-key", "your-app-secret");
/// client.SetAccessToken("oauth-token");
///
/// JdRequest req = new JdRequest("jingdong.area.province.get");
/// JdResponse resp = await client.ExecuteAsync(req);
/// ProvinceResult r = Json.Deserialize&lt;ProvinceResult&gt;(resp.Data);
/// </code>
///
/// 可选配置一律链式，均有合理默认值：
/// <code>client.Timeout(15000).MaxRetries(3).TimeZoneOffset(480)
///       .Server("api.jd.com", 443, "/routerjson", true);</code>
///
/// 相对 C# 原版的改动（原版设计缺陷，未照搬）：
///  - 原版 <c>goto retry</c> + <c>Thread.Sleep</c> 阻塞整个线程重试
///    → 这里用 <c>await Task.Delay</c> 指数退避，真正挂起到 reactor；
///  - 原版把校验/网关错误吞成一个字段被填好的空 Response 返回
///    → 这里一律抛 <see cref="JdException"/>，失败无法被静默忽略；
///  - 原版残留 XML 分支和自造 JdDictionary → 删除，只留 JSON + 标准 Dictionary；
///  - 原版手拼签名与业务 JSON 字符串 → 业务参数走 JsonValue，签名走 JdSign。
///
/// 线程/协程安全：单个实例的配置在构造后只读，可被多个协程并发用于
/// <c>ExecuteAsync</c>；<c>SetAccessToken</c> 等 setter 应在并发调用前完成。
/// </summary>
class JdClient {
    // 协议级参数名（京东网关约定）。
    static string PARAM_JSON = "360buy_param_json";
    static string PARAM_METHOD = "method";
    static string PARAM_APP_KEY = "app_key";
    static string PARAM_VERSION = "v";
    static string PARAM_TIMESTAMP = "timestamp";
    static string PARAM_TOKEN = "access_token";
    static string PARAM_SIGN = "sign";

    string appKey;
    string appSecret;
    string accessToken;

    string host;
    int port;
    string path;
    bool useTls;

    int timeoutMs;
    int maxRetries;
    int tzOffsetMinutes;

    /// <summary>
    /// 用 appKey / appSecret 创建客户端，默认指向正式网关
    /// <c>https://api.jd.com/routerjson</c>。
    /// </summary>
    public JdClient(string appKey, string appSecret) {
        this.appKey = appKey;
        this.appSecret = appSecret;
        this.accessToken = "";
        this.host = "api.jd.com";
        this.port = 443;
        this.path = "/routerjson";
        this.useTls = true;
        this.timeoutMs = 30000;
        this.maxRetries = 3;
        this.tzOffsetMinutes = 480;
    }

    /// <summary>设置 OAuth access_token（调用需授权的接口时必填）。</summary>
    JdClient SetAccessToken(string token) {
        this.accessToken = token;
        return this;
    }

    /// <summary>指向另一个网关地址（沙箱 / 自建代理）。</summary>
    JdClient Server(string host, int port, string path, bool useTls) {
        this.host = host;
        this.port = port;
        this.path = path;
        this.useTls = useTls;
        return this;
    }

    /// <summary>
    /// 时间戳使用的时区偏移（分钟），默认 480（<c>+0800</c>，京东网关所在时区）。
    /// 例：印度 <c>TimeZoneOffset(330)</c>（+0530）、UTC <c>TimeZoneOffset(0)</c>。
    ///
    /// 之所以要显式配置而不是读系统时区：<c>DateTime.Now()</c> 是
    /// <c>DateTime.UtcNow()</c> 的别名，标准库不做本地时区换算，
    /// 直接用它会给每个请求打上 UTC 时间戳，在 <c>+0800</c> 的机器上差 8 小时。
    /// </summary>
    JdClient TimeZoneOffset(int minutes) {
        this.tzOffsetMinutes = minutes;
        return this;
    }

    /// <summary>请求超时（毫秒），默认 30000。</summary>
    JdClient Timeout(int ms) {
        this.timeoutMs = ms;
        return this;
    }

    /// <summary>
    /// 网关限流（错误码 66）时的最大重试次数，默认 3；设 0 关闭重试。
    /// 退避是 <c>await Task.Delay</c>，不占线程。
    /// </summary>
    JdClient MaxRetries(int n) {
        if (n < 0) { n = 0; }
        this.maxRetries = n;
        return this;
    }

    /// <summary>
    /// 执行一次调用。成功返回已剥掉信封的 <see cref="JdResponse"/>；
    /// 任何失败（本地校验、网络、网关错误码、业务错误码）都抛
    /// <see cref="JdException"/>。
    /// </summary>
    async JdResponse ExecuteAsync(JdRequest request) {
        if (request == null) {
            throw new JdException("client.paramError", "request 不能为空", "");
        }
        if (request.ApiName.Length == 0) {
            throw new JdException("client.paramError", "ApiName 不能为空", "");
        }
        if (this.appKey.Length == 0 || this.appSecret.Length == 0) {
            throw new JdException("client.paramError", "appKey / appSecret 不能为空", "");
        }

        string body = this.BuildBody(request);

        HttpClient http = this.NewHttp();
        int attempt = 0;
        while (true) {
            string raw = "";
            try {
                raw = await http.PostAsync(this.path, body);
            } catch (Exception e) {
                throw new JdException("client.networkError", e.Message, "");
            }

            // 解析成功就返回；只有网关限流（错误码 66）才继续循环重试。
            // 退避的 await 必须留在 catch 之外：在 catch 里挂起会在下一轮
            // 迭代崩溃（见 docs/bugs/await-in-catch-loop.md）。
            JdResponse resp = null;
            JdException failure = null;
            try {
                resp = JdResponse.Parse(raw);
            } catch (JdException e) {
                failure = e;
            }
            if (resp != null) { return resp; }
            if (failure.Code != "66" || attempt >= this.maxRetries) {
                throw failure;
            }
            attempt = attempt + 1;
            await Task.Delay(attempt * 500);
        }
    }

    HttpClient NewHttp() {
        HttpClient http = new HttpClient(this.host, this.port);
        if (this.useTls) { http.UseTls(); }
        http.SetTimeout(this.timeoutMs);
        return http;
    }

    /// <summary>
    /// 组装协议参数、算签名，编码成 form-urlencoded 请求体。
    /// </summary>
    string BuildBody(JdRequest request) {
        Dictionary<string, string> p = new Dictionary<string, string>();
        p.Add(PARAM_JSON, request.ParamJson());
        p.Add(PARAM_METHOD, request.ApiName);
        p.Add(PARAM_APP_KEY, this.appKey);
        p.Add(PARAM_VERSION, request.ApiVersion);
        p.Add(PARAM_TIMESTAMP, this.Timestamp());
        if (this.accessToken.Length > 0) {
            p.Add(PARAM_TOKEN, this.accessToken);
        }
        p.Add(PARAM_SIGN, JdSign.Compute(p, this.appSecret));
        return JdClient.FormEncode(p);
    }

    /// <summary>
    /// 京东要求的时间戳格式：<c>yyyy-MM-dd HH:mm:ss+0800</c>。
    /// 墙钟时间由 UTC 加上 <see cref="TimeZoneOffset"/> 得到，后缀就是同一个偏移，
    /// 两者永远自洽（原版 C# 取本机时区，这里改成显式配置，见 TimeZoneOffset）。
    /// 精度到秒；原版多带的 <c>.fff</c> 网关不要求，标准库 DateTime 也只到秒。
    /// </summary>
    string Timestamp() {
        return JdClient.FormatTimestamp(DateTime.UtcNow().ToUnixSeconds(),
                                        this.tzOffsetMinutes);
    }

    /// <summary>把 Unix 秒按给定分钟偏移格式化成网关要求的时间戳。</summary>
    static string FormatTimestamp(long unixSeconds, int offsetMinutes) {
        DateTime wall = DateTime.FromUnixSeconds(unixSeconds + offsetMinutes * 60);
        string sign = "+";
        int mins = offsetMinutes;
        if (mins < 0) { sign = "-"; mins = 0 - mins; }
        string hh = JdClient.Pad2(mins / 60);
        string mm = JdClient.Pad2(mins % 60);
        return wall.ToString() + sign + hh + mm;
    }

    static string Pad2(int n) {
        if (n < 10 && n >= 0) { return "0" + Convert.ToString(n); }
        return Convert.ToString(n);
    }

    /// <summary>把参数字典编码成 application/x-www-form-urlencoded 请求体。</summary>
    static string FormEncode(Dictionary<string, string> p) {
        StringBuilder sb = new StringBuilder();
        List<string> ks = p.Keys;
        int n = ks.Count;
        for (int i = 0; i < n; i = i + 1) {
            string k = ks[i];
            if (i > 0) { sb.Append("&"); }
            sb.Append(Encoding.UrlEncode(k));
            sb.Append("=");
            sb.Append(Encoding.UrlEncode(p[k]));
        }
        return sb.ToString();
    }
}
