using System;
using System.Json;
using System.Text;
using System.Net.Http;
using System.Net.Http.Client;
using System.Net.External;

namespace Sdk.Jd;

// 京东开放平台（JOS）客户端（支持 WithAccessToken 多租户派生与限流退避重试）。
public class JdClient {
    static string PARAM_JSON = "360buy_param_json";
    static string PARAM_METHOD = "method";
    static string PARAM_APP_KEY = "app_key";
    static string PARAM_VERSION = "v";
    static string PARAM_TIMESTAMP = "timestamp";
    static string PARAM_TOKEN = "access_token";
    static string PARAM_SIGN = "sign";

    string appKey;
    string appSecret;
    string accessToken;

    string host;
    int port;
    string path;
    bool useTls;

    int timeoutMs;
    int maxRetries;
    int tzOffsetMinutes;
    ExternalCallPolicy callPolicy;

    public JdClient(string appKey, string appSecret) {
        this.appKey = appKey;
        this.appSecret = appSecret;
        this.accessToken = "";
        this.host = "api.jd.com";
        this.port = 443;
        this.path = "/routerjson";
        this.useTls = true;
        this.timeoutMs = 30000;
        this.maxRetries = 3;
        this.tzOffsetMinutes = 480;
        this.callPolicy = null;
    }

    public string AccessToken { get { return this.accessToken; } }

    public JdClient SetAccessToken(string token) {
        this.accessToken = token == null ? "" : token;
        return this;
    }

    // 派生携带独立 access_token 的轻量会话（适合多店铺并发复用配置）。
    public JdClient WithAccessToken(string token) {
        JdClient copy = new JdClient(this.appKey, this.appSecret);
        copy.accessToken = token == null ? "" : token;
        copy.host = this.host;
        copy.port = this.port;
        copy.path = this.path;
        copy.useTls = this.useTls;
        copy.timeoutMs = this.timeoutMs;
        copy.maxRetries = this.maxRetries;
        copy.tzOffsetMinutes = this.tzOffsetMinutes;
        copy.callPolicy = this.callPolicy;
        return copy;
    }

    public JdClient Server(string host, int port, string path, bool useTls) {
        this.host = host;
        this.port = port;
        this.path = path;
        this.useTls = useTls;
        return this;
    }

    // 时间戳时区偏移（分钟），默认 480（+0800）。
    public JdClient TimeZoneOffset(int minutes) {
        this.tzOffsetMinutes = minutes;
        return this;
    }

    public JdClient Timeout(int ms) {
        this.timeoutMs = ms;
        return this;
    }

    // 网关限流（错误码 66）最大重试次数，默认 3；0 关闭重试。
    public JdClient MaxRetries(int n) {
        if (n < 0) { n = 0; }
        this.maxRetries = n;
        return this;
    }

    public JdClient WithCallPolicy(ExternalCallPolicy policy) {
        this.callPolicy = policy;
        return this;
    }

    // 原始 JSON 参数兜底调用（未收录接口或自定义参数用）。
    public async JdResponse CallAsync(string apiName, JsonValue param) {
        JdRequest req = new JdRequest(apiName);
        if (param != null && param.IsObject()) {
            for (int i = 0; i < param.Count(); i = i + 1) {
                req.SetValue(param.KeyAt(i), param.ValAt(i));
            }
        }
        return await this.ExecuteAsync(req);
    }

    public async JdResponse ExecuteAsync(JdRequest request) {
        if (request == null) {
            throw new JdException("client.paramError", "request 不能为空", "");
        }
        if (request.ApiName == null || request.ApiName.Length == 0) {
            throw new JdException("client.paramError", "ApiName 不能为空", "");
        }
        if (this.appKey == null || this.appKey.Length == 0 || this.appSecret == null || this.appSecret.Length == 0) {
            throw new JdException("client.paramError", "appKey / appSecret 不能为空", "");
        }

        int attempt = 0;
        while (true) {
            // 每次尝试重算 timestamp 与 sign，避免跨退避窗口签名过期。
            string body = this.BuildBody(request);
            string raw = "";
            int statusCode = 200;
            try {
                using (HttpClient http = this.NewHttp()) {
                    http.SetHeader("Content-Type", "application/x-www-form-urlencoded");
                    using (HttpResponse httpResp = await http.SendAsync("POST", this.path, body)) {
                        statusCode = httpResp.statusCode;
                        raw = httpResp.body;
                    }
                }
            } catch (Exception e) {
                throw new JdException("client.networkError", e.Message, "");
            }

            JdResponse resp = null;
            JdException failure = null;
            try {
                resp = JdResponse.Parse(raw);
            } catch (JdException e) {
                failure = e;
            }
            if (statusCode < 200 || statusCode >= 300) {
                if (resp != null || failure.Code == "client.badResponse") {
                    throw new JdException("http." + Convert.ToString(statusCode),
                        "HTTP " + Convert.ToString(statusCode), raw);
                }
            }
            if (resp != null) { return resp; }
            if (failure.Code != "66" || attempt >= this.maxRetries) {
                throw failure;
            }
            attempt = attempt + 1;
            await Task.Delay(attempt * 500);
        }
    }

    private HttpClient NewHttp() {
        HttpClient http = new HttpClient(this.host, this.port);
        if (this.useTls) { http.UseTls(); }
        http.SetTimeout(this.timeoutMs);
        if (this.callPolicy != null) { http.SetCallPolicy(this.callPolicy); }
        return http;
    }

    private string BuildBody(JdRequest request) {
        Dictionary<string, string> p = new Dictionary<string, string>();
        p.Add(PARAM_JSON, request.ParamJson());
        p.Add(PARAM_METHOD, request.ApiName);
        p.Add(PARAM_APP_KEY, this.appKey);
        p.Add(PARAM_VERSION, request.ApiVersion);
        p.Add(PARAM_TIMESTAMP, this.Timestamp());
        if (this.accessToken.Length > 0) {
            p.Add(PARAM_TOKEN, this.accessToken);
        }
        p.Add(PARAM_SIGN, JdSign.Compute(p, this.appSecret));
        return JdClient.FormEncode(p);
    }

    private string Timestamp() {
        return JdClient.FormatTimestamp(DateTime.UtcNow().ToUnixSeconds(),
                                        this.tzOffsetMinutes);
    }

    public static string FormatTimestamp(long unixSeconds, int offsetMinutes) {
        DateTime wall = DateTime.FromUnixSeconds(unixSeconds + offsetMinutes * 60);
        string sign = "+";
        int mins = offsetMinutes;
        if (mins < 0) { sign = "-"; mins = 0 - mins; }
        string hh = JdClient.Pad2(mins / 60);
        string mm = JdClient.Pad2(mins % 60);
        return wall.ToString() + sign + hh + mm;
    }

    private static string Pad2(int n) {
        if (n >= 0 && n < 100) {
            byte[] buf = new byte[2];
            buf[0] = (byte)(48 + n / 10);
            buf[1] = (byte)(48 + n % 10);
            return buf.ToStr(0, 2);
        }
        return Convert.ToString(n);
    }

    private static string FormEncode(Dictionary<string, string> p) {
        StringBuilder sb = new StringBuilder();
        List<string> ks = p.Keys;
        int n = ks.Count;
        for (int i = 0; i < n; i = i + 1) {
            string k = ks[i];
            if (i > 0) { sb.Append("&"); }
            sb.Append(Encoding.UrlEncode(k));
            sb.Append("=");
            sb.Append(Encoding.UrlEncode(p[k]));
        }
        return sb.ToString();
    }
}
