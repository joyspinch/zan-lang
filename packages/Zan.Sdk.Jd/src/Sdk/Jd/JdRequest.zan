using System;
using System.Json;

namespace Sdk.Jd;

// 京东开放平台裸请求（API 名 + 业务参数），所有业务字段通过 JsonValue 构建。
// 空串会被忽略（京东网关不接受空参数）。
public class JdRequest {
    public string ApiName;
    public string ApiVersion;

    JsonValue param;

    public JdRequest(string apiName) {
        this.ApiName = apiName;
        this.ApiVersion = "2.0";
        this.param = JsonValue.NewObject();
    }

    public JdRequest Set(string key, string paramValue) {
        if (key.Length == 0 || paramValue.Length == 0) { return this; }
        this.param.Set(key, JsonValue.NewStr(paramValue));
        return this;
    }

    public JdRequest SetInt(string key, int paramValue) {
        if (key.Length == 0) { return this; }
        this.param.Set(key, JsonValue.NewNum(Convert.ToString(paramValue)));
        return this;
    }

    // 64 位整数（wareId / skuId / orderId 不能走 int 通道截断）。
    public JdRequest SetLong(string key, long paramValue) {
        if (key.Length == 0) { return this; }
        this.param.Set(key, JsonValue.NewNum(Convert.ToString(paramValue)));
        return this;
    }

    public JdRequest SetBool(string key, bool paramValue) {
        if (key.Length == 0) { return this; }
        this.param.Set(key, JsonValue.NewBool(paramValue));
        return this;
    }

    public JdRequest SetValue(string key, JsonValue paramValue) {
        if (key.Length == 0 || paramValue == null) { return this; }
        this.param.Set(key, paramValue);
        return this;
    }

    public string ParamJson() {
        return this.param.ToJson();
    }
}
