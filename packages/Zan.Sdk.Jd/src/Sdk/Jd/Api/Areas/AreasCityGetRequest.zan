using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Areas;

// <c>jingdong.areas.city.get</c> 的请求。
public class AreasCityGetRequest {
    JdRequest req;

    public AreasCityGetRequest() {
        this.req = new JdRequest("jingdong.areas.city.get");
    }

    // 设置 <c>parent_id</c> 参数。
    AreasCityGetRequest ParentId(int parentId) {
        this.req.SetInt("parent_id", parentId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
