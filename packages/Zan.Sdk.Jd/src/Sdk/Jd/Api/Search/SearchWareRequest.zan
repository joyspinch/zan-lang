        this.req = new JdRequest("jingdong.search.ware");
    }

    // 设置 <c>key</c> 参数。
    public SearchWareRequest Key(string key) {
        this.req.Set("key", key);
        return this;
    }

    // 设置 <c>filt_type</c> 参数。
    public SearchWareRequest FiltType(string filtType) {
        this.req.Set("filt_type", filtType);
        return this;
    }

    // 设置 <c>area_ids</c> 参数。
    public SearchWareRequest AreaIds(string areaIds) {
        this.req.Set("area_ids", areaIds);
        return this;
    }

    // 设置 <c>sort_type</c> 参数。
    public SearchWareRequest SortType(string sortType) {
        this.req.Set("sort_type", sortType);
        return this;
    }

    // 设置 <c>page</c> 参数。
    public SearchWareRequest Page(string page) {
        this.req.Set("page", page);
        return this;
    }

    // 设置 <c>charset</c> 参数。
    public SearchWareRequest Charset(string charset) {
        this.req.Set("charset", charset);
        return this;
    }

    // 设置 <c>urlencode</c> 参数。
    public SearchWareRequest Urlencode(string urlencode) {
        this.req.Set("urlencode", urlencode);
        return this;
    }

