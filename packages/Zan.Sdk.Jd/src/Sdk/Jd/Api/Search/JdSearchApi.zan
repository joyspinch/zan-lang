using System;
using System.Json;
using Sdk.Jd;

namespace Sdk.Jd.Api.Search;

// jingdong.search.* 的强类型客户端。
class JdSearchApi {
    JdClient client;

    public JdSearchApi(JdClient client) { this.client = client; }

    // 执行 <c>jingdong.search.ware</c>。
    async SearchWareResponse WareAsync(SearchWareRequest request) {
        JdResponse raw = await this.client.ExecuteAsync(request.Raw());
        SearchWareResponse result = Json.Deserialize<SearchWareResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

}
