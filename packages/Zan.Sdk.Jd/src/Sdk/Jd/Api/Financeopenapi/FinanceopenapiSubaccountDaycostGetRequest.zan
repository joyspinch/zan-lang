using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Financeopenapi;

// <c>jingdong.financeopenapi.subaccount.daycost.get</c> 的请求。
public class FinanceopenapiSubaccountDaycostGetRequest {
    JdRequest req;

    public FinanceopenapiSubaccountDaycostGetRequest() {
        this.req = new JdRequest("jingdong.financeopenapi.subaccount.daycost.get");
    }

    // 设置 <c>subPin</c> 参数。
    FinanceopenapiSubaccountDaycostGetRequest SubPin(string subPin) {
        this.req.Set("subPin", subPin);
        return this;
    }

    // 设置 <c>showday</c> 参数。
    FinanceopenapiSubaccountDaycostGetRequest Showday(int showday) {
        this.req.SetInt("showday", showday);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
