using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Financeopenapi;

// <c>jingdong.financeopenapi.cost.list</c> 的请求。
public class FinanceopenapiCostListRequest {
    JdRequest req;

    public FinanceopenapiCostListRequest() {
        this.req = new JdRequest("jingdong.financeopenapi.cost.list");
    }

    // 设置 <c>beginDate</c> 参数。
    public FinanceopenapiCostListRequest BeginDate(string beginDate) {
        this.req.Set("beginDate", beginDate);
        return this;
    }

    // 设置 <c>endDate</c> 参数。
    public FinanceopenapiCostListRequest EndDate(string endDate) {
        this.req.Set("endDate", endDate);
        return this;
    }

    // 设置 <c>orderTypes</c> 参数。
    public FinanceopenapiCostListRequest OrderTypes(string orderTypes) {
        this.req.Set("orderTypes", orderTypes);
        return this;
    }

    // 设置 <c>subPin</c> 参数。
    public FinanceopenapiCostListRequest SubPin(string subPin) {
        this.req.Set("subPin", subPin);
        return this;
    }

    // 设置 <c>moneyType</c> 参数。
    public FinanceopenapiCostListRequest MoneyType(int moneyType) {
        this.req.SetInt("moneyType", moneyType);
        return this;
    }

    // 设置 <c>pageNo</c> 参数。
    public FinanceopenapiCostListRequest PageNo(int pageNo) {
        this.req.SetInt("pageNo", pageNo);
        return this;
    }

    // 设置 <c>pageSize</c> 参数。
    public FinanceopenapiCostListRequest PageSize(int pageSize) {
        this.req.SetInt("pageSize", pageSize);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
