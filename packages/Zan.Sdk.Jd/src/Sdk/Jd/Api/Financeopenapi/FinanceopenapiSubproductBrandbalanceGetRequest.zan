using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Financeopenapi;

// <c>jingdong.financeopenapi.subproduct.brandbalance.get</c> 的请求。
public class FinanceopenapiSubproductBrandbalanceGetRequest {
    JdRequest req;

    public FinanceopenapiSubproductBrandbalanceGetRequest() {
        this.req = new JdRequest("jingdong.financeopenapi.subproduct.brandbalance.get");
    }

    // 设置 <c>subPin</c> 参数。
    public FinanceopenapiSubproductBrandbalanceGetRequest SubPin(string subPin) {
        this.req.Set("subPin", subPin);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
