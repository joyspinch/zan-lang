using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Test774;

// <c>jingdong.test774</c> 的请求。
public class Test774Request {
    JdRequest req;

    public Test774Request() {
        this.req = new JdRequest("jingdong.test774");
    }

    // 设置 <c>param1</c> 参数。
    public Test774Request Param1(string param1) {
        this.req.Set("param1", param1);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
