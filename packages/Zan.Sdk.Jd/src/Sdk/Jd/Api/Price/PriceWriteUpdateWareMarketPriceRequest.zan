using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Price;

// <c>jingdong.price.write.updateWareMarketPrice</c> 的请求。
public class PriceWriteUpdateWareMarketPriceRequest {
    JdRequest req;

    public PriceWriteUpdateWareMarketPriceRequest() {
        this.req = new JdRequest("jingdong.price.write.updateWareMarketPrice");
    }

    // 设置 <c>wareId</c> 参数。
    public PriceWriteUpdateWareMarketPriceRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>marketPrice</c> 参数。
    public PriceWriteUpdateWareMarketPriceRequest MarketPrice(string marketPrice) {
        this.req.Set("marketPrice", marketPrice);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
