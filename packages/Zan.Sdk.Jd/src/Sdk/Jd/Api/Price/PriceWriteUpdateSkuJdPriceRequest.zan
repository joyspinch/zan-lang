using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Price;

// <c>jingdong.price.write.updateSkuJdPrice</c> 的请求。
public class PriceWriteUpdateSkuJdPriceRequest {
    JdRequest req;

    public PriceWriteUpdateSkuJdPriceRequest() {
        this.req = new JdRequest("jingdong.price.write.updateSkuJdPrice");
    }

    // 设置 <c>jdPrice</c> 参数。
    PriceWriteUpdateSkuJdPriceRequest JdPrice(string jdPrice) {
        this.req.Set("jdPrice", jdPrice);
        return this;
    }

    // 设置 <c>skuId</c> 参数。
    PriceWriteUpdateSkuJdPriceRequest SkuId(long skuId) {
        this.req.SetLong("skuId", skuId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
