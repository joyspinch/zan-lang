using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Dmp;

// <c>jingdong.dmp.new.crowd.del</c> 的请求。
public class DmpNewCrowdDelRequest {
    JdRequest req;

    public DmpNewCrowdDelRequest() {
        this.req = new JdRequest("jingdong.dmp.new.crowd.del");
    }

    // 设置 <c>accessPin</c> 参数。
    DmpNewCrowdDelRequest AccessPin(string accessPin) {
        this.req.Set("accessPin", accessPin);
        return this;
    }

    // 设置 <c>authType</c> 参数。
    DmpNewCrowdDelRequest AuthType(string authType) {
        this.req.Set("authType", authType);
        return this;
    }

    // 设置 <c>crowdIds</c> 参数。
    DmpNewCrowdDelRequest CrowdIds(string crowdIds) {
        this.req.Set("crowdIds", crowdIds);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
