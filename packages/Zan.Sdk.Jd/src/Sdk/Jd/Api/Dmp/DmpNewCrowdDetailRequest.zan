using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Dmp;

// <c>jingdong.dmp.new.crowd.detail</c> 的请求。
public class DmpNewCrowdDetailRequest {
    JdRequest req;

    public DmpNewCrowdDetailRequest() {
        this.req = new JdRequest("jingdong.dmp.new.crowd.detail");
    }

    // 设置 <c>accessPin</c> 参数。
    DmpNewCrowdDetailRequest AccessPin(string accessPin) {
        this.req.Set("accessPin", accessPin);
        return this;
    }

    // 设置 <c>authType</c> 参数。
    DmpNewCrowdDetailRequest AuthType(string authType) {
        this.req.Set("authType", authType);
        return this;
    }

    // 设置 <c>crowdId</c> 参数。
    DmpNewCrowdDetailRequest CrowdId(long crowdId) {
        this.req.SetLong("crowdId", crowdId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
