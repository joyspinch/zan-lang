using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Dmp;

// <c>jingdong.dmp.new.resource.list</c> 的请求。
public class DmpNewResourceListRequest {
    JdRequest req;

    public DmpNewResourceListRequest() {
        this.req = new JdRequest("jingdong.dmp.new.resource.list");
    }

    // 设置 <c>accessPin</c> 参数。
    public DmpNewResourceListRequest AccessPin(string accessPin) {
        this.req.Set("accessPin", accessPin);
        return this;
    }

    // 设置 <c>authType</c> 参数。
    public DmpNewResourceListRequest AuthType(string authType) {
        this.req.Set("authType", authType);
        return this;
    }

    // 设置 <c>pageSize</c> 参数。
    public DmpNewResourceListRequest PageSize(int pageSize) {
        this.req.SetInt("pageSize", pageSize);
        return this;
    }

    // 设置 <c>pageIndex</c> 参数。
    public DmpNewResourceListRequest PageIndex(int pageIndex) {
        this.req.SetInt("pageIndex", pageIndex);
        return this;
    }

    // 设置 <c>seedStatus</c> 参数。
    public DmpNewResourceListRequest SeedStatus(int seedStatus) {
        this.req.SetInt("seedStatus", seedStatus);
        return this;
    }

    // 设置 <c>seedName</c> 参数。
    public DmpNewResourceListRequest SeedName(string seedName) {
        this.req.Set("seedName", seedName);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
