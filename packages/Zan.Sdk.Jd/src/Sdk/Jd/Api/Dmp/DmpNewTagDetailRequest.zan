using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Dmp;

// <c>jingdong.dmp.new.tag.detail</c> 的请求。
public class DmpNewTagDetailRequest {
    JdRequest req;

    public DmpNewTagDetailRequest() {
        this.req = new JdRequest("jingdong.dmp.new.tag.detail");
    }

    // 设置 <c>accessPin</c> 参数。
    public DmpNewTagDetailRequest AccessPin(string accessPin) {
        this.req.Set("accessPin", accessPin);
        return this;
    }

    // 设置 <c>authType</c> 参数。
    public DmpNewTagDetailRequest AuthType(string authType) {
        this.req.Set("authType", authType);
        return this;
    }

    // 设置 <c>tagId</c> 参数。
    public DmpNewTagDetailRequest TagId(long tagId) {
        this.req.SetLong("tagId", tagId);
        return this;
    }

    // 设置 <c>crowdId</c> 参数。
    public DmpNewTagDetailRequest CrowdId(long crowdId) {
        this.req.SetLong("crowdId", crowdId);
        return this;
    }

    // 设置 <c>industryHot</c> 参数。
    public DmpNewTagDetailRequest IndustryHot(string industryHot) {
        this.req.Set("industryHot", industryHot);
        return this;
    }

    // 设置 <c>coverageRate</c> 参数。
    public DmpNewTagDetailRequest CoverageRate(string coverageRate) {
        this.req.Set("coverageRate", coverageRate);
        return this;
    }

    // 设置 <c>boardId</c> 参数。
    public DmpNewTagDetailRequest BoardId(long boardId) {
        this.req.SetLong("boardId", boardId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
