using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Dmp;

// <c>jingdong.dmp.common.smartcrowd.get</c> 的请求。
public class DmpCommonSmartcrowdGetRequest {
    JdRequest req;

    public DmpCommonSmartcrowdGetRequest() {
        this.req = new JdRequest("jingdong.dmp.common.smartcrowd.get");
    }

    // 设置 <c>accessPin</c> 参数。
    DmpCommonSmartcrowdGetRequest AccessPin(string accessPin) {
        this.req.Set("accessPin", accessPin);
        return this;
    }

    // 设置 <c>authType</c> 参数。
    DmpCommonSmartcrowdGetRequest AuthType(string authType) {
        this.req.Set("authType", authType);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
