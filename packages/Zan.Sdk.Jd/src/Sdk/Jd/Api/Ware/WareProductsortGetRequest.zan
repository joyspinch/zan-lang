using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Ware;

// <c>jingdong.ware.productsort.get</c> 的请求。
public class WareProductsortGetRequest {
    JdRequest req;

    public WareProductsortGetRequest() {
        this.req = new JdRequest("jingdong.ware.productsort.get");
    }

    // 设置 <c>product_sort_ids</c> 参数。
    WareProductsortGetRequest ProductSortIds(string productSortIds) {
        this.req.Set("product_sort_ids", productSortIds);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
