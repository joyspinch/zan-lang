using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Ware;

// <c>jingdong.ware.write.upOrDown</c> 的请求。
public class WareWriteUpOrDownRequest {
    JdRequest req;

    public WareWriteUpOrDownRequest() {
        this.req = new JdRequest("jingdong.ware.write.upOrDown");
    }

    // 设置 <c>note</c> 参数。
    public WareWriteUpOrDownRequest Note(string note) {
        this.req.Set("note", note);
        return this;
    }

    // 设置 <c>wareId</c> 参数。
    public WareWriteUpOrDownRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>opType</c> 参数。
    public WareWriteUpOrDownRequest OpType(int opType) {
        this.req.SetInt("opType", opType);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
