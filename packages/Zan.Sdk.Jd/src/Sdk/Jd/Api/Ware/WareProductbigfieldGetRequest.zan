using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Ware;

// <c>jingdong.ware.productbigfield.get</c> 的请求。
public class WareProductbigfieldGetRequest {
    JdRequest req;

    public WareProductbigfieldGetRequest() {
        this.req = new JdRequest("jingdong.ware.productbigfield.get");
    }

    // 设置 <c>sku_id</c> 参数。
    public WareProductbigfieldGetRequest SkuId(string skuId) {
        this.req.Set("sku_id", skuId);
        return this;
    }

    // 设置 <c>field</c> 参数。
    public WareProductbigfieldGetRequest Field(string field) {
        this.req.Set("field", field);
        return this;
    }

