using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Ware;

// <c>jingdong.ware.read.findOpReason</c> 的请求。
public class WareReadFindOpReasonRequest {
    JdRequest req;

    public WareReadFindOpReasonRequest() {
        this.req = new JdRequest("jingdong.ware.read.findOpReason");
    }

    // 设置 <c>wareId</c> 参数。
    WareReadFindOpReasonRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>field</c> 参数。
    WareReadFindOpReasonRequest Field(string field) {
        this.req.Set("field", field);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
