using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Ware;

// <c>jingdong.ware.write.delete</c> 的请求。
public class WareWriteDeleteRequest {
    JdRequest req;

    public WareWriteDeleteRequest() {
        this.req = new JdRequest("jingdong.ware.write.delete");
    }

    // 设置 <c>wareId</c> 参数。
    WareWriteDeleteRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
