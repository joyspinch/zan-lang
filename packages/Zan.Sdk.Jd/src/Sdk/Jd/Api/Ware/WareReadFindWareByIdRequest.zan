using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Ware;

// <c>jingdong.ware.read.findWareById</c> 的请求。
public class WareReadFindWareByIdRequest {
    JdRequest req;

    public WareReadFindWareByIdRequest() {
        this.req = new JdRequest("jingdong.ware.read.findWareById");
    }

    // 设置 <c>wareId</c> 参数。
    WareReadFindWareByIdRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>field</c> 参数。
    WareReadFindWareByIdRequest Field(string field) {
        this.req.Set("field", field);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
