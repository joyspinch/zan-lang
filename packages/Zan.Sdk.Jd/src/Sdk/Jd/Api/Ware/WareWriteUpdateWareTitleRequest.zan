using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Ware;

// <c>jingdong.ware.write.updateWareTitle</c> 的请求。
public class WareWriteUpdateWareTitleRequest {
    JdRequest req;

    public WareWriteUpdateWareTitleRequest() {
        this.req = new JdRequest("jingdong.ware.write.updateWareTitle");
    }

    // 设置 <c>wareId</c> 参数。
    WareWriteUpdateWareTitleRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>title</c> 参数。
    WareWriteUpdateWareTitleRequest Title(string title) {
        this.req.Set("title", title);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
