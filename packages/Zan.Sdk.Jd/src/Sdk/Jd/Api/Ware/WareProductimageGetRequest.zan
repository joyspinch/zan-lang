using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Ware;

// <c>jingdong.ware.productimage.get</c> 的请求。
public class WareProductimageGetRequest {
    JdRequest req;

    public WareProductimageGetRequest() {
        this.req = new JdRequest("jingdong.ware.productimage.get");
    }

    // 设置 <c>sku_id</c> 参数。
    WareProductimageGetRequest SkuId(string skuId) {
        this.req.Set("sku_id", skuId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
