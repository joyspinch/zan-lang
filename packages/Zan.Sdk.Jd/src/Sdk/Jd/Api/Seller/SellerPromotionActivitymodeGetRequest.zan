using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Seller;

// <c>jingdong.seller.promotion.activitymode.get</c> 的请求。
public class SellerPromotionActivitymodeGetRequest {
    JdRequest req;

    public SellerPromotionActivitymodeGetRequest() {
        this.req = new JdRequest("jingdong.seller.promotion.activitymode.get");
    }

    // 设置 <c>promo_id</c> 参数。
    public SellerPromotionActivitymodeGetRequest PromoId(long promoId) {
        this.req.SetLong("promo_id", promoId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
