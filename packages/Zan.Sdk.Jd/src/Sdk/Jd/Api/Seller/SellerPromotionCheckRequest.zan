using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Seller;

// <c>jingdong.seller.promotion.check</c> 的请求。
public class SellerPromotionCheckRequest {
    JdRequest req;

    public SellerPromotionCheckRequest() {
        this.req = new JdRequest("jingdong.seller.promotion.check");
    }

    // 设置 <c>promo_id</c> 参数。
    public SellerPromotionCheckRequest PromoId(long promoId) {
        this.req.SetLong("promo_id", promoId);
        return this;
    }

    // 设置 <c>status</c> 参数。
    public SellerPromotionCheckRequest Status(int status) {
        this.req.SetInt("status", status);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
