using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Seller;

// <c>jingdong.seller.promotion.delete</c> 的请求。
public class SellerPromotionDeleteRequest {
    JdRequest req;

    public SellerPromotionDeleteRequest() {
        this.req = new JdRequest("jingdong.seller.promotion.delete");
    }

    // 设置 <c>promo_id</c> 参数。
    SellerPromotionDeleteRequest PromoId(long promoId) {
        this.req.SetLong("promo_id", promoId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
