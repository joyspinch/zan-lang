using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Seller;

// <c>jingdong.seller.promotion.v2.get</c> 的请求。
public class SellerPromotionV2GetRequest {
    JdRequest req;

    public SellerPromotionV2GetRequest() {
        this.req = new JdRequest("jingdong.seller.promotion.v2.get");
    }

    // 设置 <c>ip</c> 参数。
    public SellerPromotionV2GetRequest Ip(string ip) {
        this.req.Set("ip", ip);
        return this;
    }

    // 设置 <c>port</c> 参数。
    public SellerPromotionV2GetRequest Port(string port) {
        this.req.Set("port", port);
        return this;
    }

    // 设置 <c>promo_id</c> 参数。
    public SellerPromotionV2GetRequest PromoId(long promoId) {
        this.req.SetLong("promo_id", promoId);
        return this;
    }

    // 设置 <c>promo_type</c> 参数。
    public SellerPromotionV2GetRequest PromoType(int promoType) {
        this.req.SetInt("promo_type", promoType);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
