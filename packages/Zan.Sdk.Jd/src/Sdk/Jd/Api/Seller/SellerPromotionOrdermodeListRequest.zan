using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Seller;

// <c>jingdong.seller.promotion.ordermode.list</c> 的请求。
public class SellerPromotionOrdermodeListRequest {
    JdRequest req;

    public SellerPromotionOrdermodeListRequest() {
        this.req = new JdRequest("jingdong.seller.promotion.ordermode.list");
    }

    // 设置 <c>promo_id</c> 参数。
    public SellerPromotionOrdermodeListRequest PromoId(long promoId) {
        this.req.SetLong("promo_id", promoId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
