using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Seller;

// <c>jingdong.seller.promotion.activitymode.add</c> 的请求。
public class SellerPromotionActivitymodeAddRequest {
    JdRequest req;

    public SellerPromotionActivitymodeAddRequest() {
        this.req = new JdRequest("jingdong.seller.promotion.activitymode.add");
    }

    // 设置 <c>promo_id</c> 参数。
    SellerPromotionActivitymodeAddRequest PromoId(long promoId) {
        this.req.SetLong("promo_id", promoId);
        return this;
    }

    // 设置 <c>num_bound</c> 参数。
    SellerPromotionActivitymodeAddRequest NumBound(int numBound) {
        this.req.SetInt("num_bound", numBound);
        return this;
    }

    // 设置 <c>freq_bound</c> 参数。
    SellerPromotionActivitymodeAddRequest FreqBound(int freqBound) {
        this.req.SetInt("freq_bound", freqBound);
        return this;
    }

    // 设置 <c>per_max_num</c> 参数。
    SellerPromotionActivitymodeAddRequest PerMaxNum(int perMaxNum) {
        this.req.SetInt("per_max_num", perMaxNum);
        return this;
    }

    // 设置 <c>per_min_num</c> 参数。
    SellerPromotionActivitymodeAddRequest PerMinNum(int perMinNum) {
        this.req.SetInt("per_min_num", perMinNum);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
