using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Seller;

// <c>jingdong.seller.promotion.sku.add</c> 的请求。
public class SellerPromotionSkuAddRequest {
    JdRequest req;

    public SellerPromotionSkuAddRequest() {
        this.req = new JdRequest("jingdong.seller.promotion.sku.add");
    }

    // 设置 <c>promo_id</c> 参数。
    public SellerPromotionSkuAddRequest PromoId(long promoId) {
        this.req.SetLong("promo_id", promoId);
        return this;
    }

    // 设置 <c>sku_ids</c> 参数。
    public SellerPromotionSkuAddRequest SkuIds(string skuIds) {
        this.req.Set("sku_ids", skuIds);
        return this;
    }

    // 设置 <c>jd_prices</c> 参数。
    public SellerPromotionSkuAddRequest JdPrices(string jdPrices) {
        this.req.Set("jd_prices", jdPrices);
        return this;
    }

    // 设置 <c>promo_prices</c> 参数。
    public SellerPromotionSkuAddRequest PromoPrices(string promoPrices) {
        this.req.Set("promo_prices", promoPrices);
        return this;
    }

    // 设置 <c>seq</c> 参数。
    public SellerPromotionSkuAddRequest Seq(string seq) {
        this.req.Set("seq", seq);
        return this;
    }

    // 设置 <c>num</c> 参数。
    public SellerPromotionSkuAddRequest Num(string num) {
        this.req.Set("num", num);
        return this;
    }

    // 设置 <c>bind_type</c> 参数。
    public SellerPromotionSkuAddRequest BindType(string bindType) {
        this.req.Set("bind_type", bindType);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
