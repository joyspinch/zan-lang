using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Seller;

// <c>jingdong.seller.promotion.list</c> 的请求。
public class SellerPromotionListRequest {
    JdRequest req;

    public SellerPromotionListRequest() {
        this.req = new JdRequest("jingdong.seller.promotion.list");
    }

    // 设置 <c>type</c> 参数。
    public SellerPromotionListRequest Type(int type) {
        this.req.SetInt("type", type);
        return this;
    }

    // 设置 <c>status</c> 参数。
    public SellerPromotionListRequest Status(int status) {
        this.req.SetInt("status", status);
        return this;
    }

    // 设置 <c>begin_time</c> 参数。
    public SellerPromotionListRequest BeginTime(string beginTime) {
        this.req.Set("begin_time", beginTime);
        return this;
    }

    // 设置 <c>end_time</c> 参数。
    public SellerPromotionListRequest EndTime(string endTime) {
        this.req.Set("end_time", endTime);
        return this;
    }

    // 设置 <c>sku_id</c> 参数。
    public SellerPromotionListRequest SkuId(long skuId) {
        this.req.SetLong("sku_id", skuId);
        return this;
    }

    // 设置 <c>favor_mode</c> 参数。
    public SellerPromotionListRequest FavorMode(int favorMode) {
        this.req.SetInt("favor_mode", favorMode);
        return this;
    }

    // 设置 <c>page</c> 参数。
    public SellerPromotionListRequest Page(string page) {
        this.req.Set("page", page);
        return this;
    }

    // 设置 <c>size</c> 参数。
    public SellerPromotionListRequest Size(string size) {
        this.req.Set("size", size);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
