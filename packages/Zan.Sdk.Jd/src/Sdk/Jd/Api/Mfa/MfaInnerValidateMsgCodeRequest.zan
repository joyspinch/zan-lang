using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Mfa;

// <c>jingdong.mfa.inner.validateMsgCode</c> 的请求。
public class MfaInnerValidateMsgCodeRequest {
    JdRequest req;

    public MfaInnerValidateMsgCodeRequest() {
        this.req = new JdRequest("jingdong.mfa.inner.validateMsgCode");
    }

    // 设置 <c>msgCode</c> 参数。
    public MfaInnerValidateMsgCodeRequest MsgCode(string msgCode) {
        this.req.Set("msgCode", msgCode);
        return this;
    }

    // 设置 <c>rKey</c> 参数。
    public MfaInnerValidateMsgCodeRequest RKey(string rKey) {
        this.req.Set("rKey", rKey);
        return this;
    }

    // 设置 <c>validateType</c> 参数。
    public MfaInnerValidateMsgCodeRequest ValidateType(int validateType) {
        this.req.SetInt("validateType", validateType);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
