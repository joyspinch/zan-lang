using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Mfa;

// <c>jingdong.mfa.inner.eliminateRisk</c> 的请求。
public class MfaInnerEliminateRiskRequest {
    JdRequest req;

    public MfaInnerEliminateRiskRequest() {
        this.req = new JdRequest("jingdong.mfa.inner.eliminateRisk");
    }

    // 设置 <c>rKey</c> 参数。
    public MfaInnerEliminateRiskRequest RKey(string rKey) {
        this.req.Set("rKey", rKey);
        return this;
    }

    // 设置 <c>validateType</c> 参数。
    public MfaInnerEliminateRiskRequest ValidateType(int validateType) {
        this.req.SetInt("validateType", validateType);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
