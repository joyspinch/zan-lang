using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Mfa;

// <c>jingdong.mfa.inner.sendCodeToMobile</c> 的请求。
public class MfaInnerSendCodeToMobileRequest {
    JdRequest req;

    public MfaInnerSendCodeToMobileRequest() {
        this.req = new JdRequest("jingdong.mfa.inner.sendCodeToMobile");
    }

    // 设置 <c>rKey</c> 参数。
    MfaInnerSendCodeToMobileRequest RKey(string rKey) {
        this.req.Set("rKey", rKey);
        return this;
    }

    // 设置 <c>validateType</c> 参数。
    MfaInnerSendCodeToMobileRequest ValidateType(int validateType) {
        this.req.SetInt("validateType", validateType);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
