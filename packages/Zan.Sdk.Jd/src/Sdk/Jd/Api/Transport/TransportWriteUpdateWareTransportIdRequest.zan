using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Transport;

// <c>jingdong.transport.write.updateWareTransportId</c> 的请求。
public class TransportWriteUpdateWareTransportIdRequest {
    JdRequest req;

    public TransportWriteUpdateWareTransportIdRequest() {
        this.req = new JdRequest("jingdong.transport.write.updateWareTransportId");
    }

    // 设置 <c>wareId</c> 参数。
    public TransportWriteUpdateWareTransportIdRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>transportId</c> 参数。
    public TransportWriteUpdateWareTransportIdRequest TransportId(long transportId) {
        this.req.SetLong("transportId", transportId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
