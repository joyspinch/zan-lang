using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Stock;

// <c>jingdong.stock.read.findSkuStock</c> 的请求。
public class StockReadFindSkuStockRequest {
    JdRequest req;

    public StockReadFindSkuStockRequest() {
        this.req = new JdRequest("jingdong.stock.read.findSkuStock");
    }

    // 设置 <c>skuId</c> 参数。
    public StockReadFindSkuStockRequest SkuId(long skuId) {
        this.req.SetLong("skuId", skuId);
        return this;
    }

    // 设置 <c>field</c> 参数。
    public StockReadFindSkuStockRequest Field(string field) {
        this.req.Set("field", field);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
