using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Stock;

// <c>jingdong.stock.write.updateSkuStock</c> 的请求。
public class StockWriteUpdateSkuStockRequest {
    JdRequest req;

    public StockWriteUpdateSkuStockRequest() {
        this.req = new JdRequest("jingdong.stock.write.updateSkuStock");
    }

    // 设置 <c>skuId</c> 参数。
    public StockWriteUpdateSkuStockRequest SkuId(long skuId) {
        this.req.SetLong("skuId", skuId);
        return this;
    }

    // 设置 <c>stockNum</c> 参数。
    public StockWriteUpdateSkuStockRequest StockNum(long stockNum) {
        this.req.SetLong("stockNum", stockNum);
        return this;
    }

    // 设置 <c>storeId</c> 参数。
    public StockWriteUpdateSkuStockRequest StoreId(long storeId) {
        this.req.SetLong("storeId", storeId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
