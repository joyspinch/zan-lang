using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Shopcategories;

// <c>jingdong.shopcategories.write.saveWareShopCategories</c> 的请求。
public class ShopcategoriesWriteSaveWareShopCategoriesRequest {
    JdRequest req;

    public ShopcategoriesWriteSaveWareShopCategoriesRequest() {
        this.req = new JdRequest("jingdong.shopcategories.write.saveWareShopCategories");
    }

    // 设置 <c>wareId</c> 参数。
    ShopcategoriesWriteSaveWareShopCategoriesRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>shopCategory</c> 参数。
    ShopcategoriesWriteSaveWareShopCategoriesRequest ShopCategory(string shopCategory) {
        this.req.Set("shopCategory", shopCategory);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
