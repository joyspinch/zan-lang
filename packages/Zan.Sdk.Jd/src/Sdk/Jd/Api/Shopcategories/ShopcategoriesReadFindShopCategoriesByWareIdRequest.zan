using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Shopcategories;

// <c>jingdong.shopcategories.read.findShopCategoriesByWareId</c> 的请求。
public class ShopcategoriesReadFindShopCategoriesByWareIdRequest {
    JdRequest req;

    public ShopcategoriesReadFindShopCategoriesByWareIdRequest() {
        this.req = new JdRequest("jingdong.shopcategories.read.findShopCategoriesByWareId");
    }

    // 设置 <c>wareId</c> 参数。
    ShopcategoriesReadFindShopCategoriesByWareIdRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
