using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Order;

// <c>jingdong.order.venderRemark.queryByOrderId</c> 的请求。
public class OrderVenderRemarkQueryByOrderIdRequest {
    JdRequest req;

    public OrderVenderRemarkQueryByOrderIdRequest() {
        this.req = new JdRequest("jingdong.order.venderRemark.queryByOrderId");
    }

    // 设置 <c>order_id</c> 参数。
    public OrderVenderRemarkQueryByOrderIdRequest OrderId(string orderId) {
        this.req.Set("order_id", orderId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
