using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Club;

// <c>jingdong.club.pop.commentreply.save</c> 的请求。
public class ClubPopCommentreplySaveRequest {
    JdRequest req;

    public ClubPopCommentreplySaveRequest() {
        this.req = new JdRequest("jingdong.club.pop.commentreply.save");
    }

    // 设置 <c>commentId</c> 参数。
    public ClubPopCommentreplySaveRequest CommentId(string commentId) {
        this.req.Set("commentId", commentId);
        return this;
    }

    // 设置 <c>content</c> 参数。
    public ClubPopCommentreplySaveRequest Content(string content) {
        this.req.Set("content", content);
        return this;
    }

    // 设置 <c>replyId</c> 参数。
    public ClubPopCommentreplySaveRequest ReplyId(string replyId) {
        this.req.Set("replyId", replyId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
