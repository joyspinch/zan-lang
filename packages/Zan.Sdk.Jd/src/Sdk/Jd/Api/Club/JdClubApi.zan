using System;
using System.Json;
using Sdk.Jd;

namespace Sdk.Jd.Api.Club;

// jingdong.club.* 的强类型客户端。
class JdClubApi {
    JdClient client;

    public JdClubApi(JdClient client) { this.client = client; }

    // 执行 <c>jingdong.club.pop.commentreply.save</c>。
    async ClubPopCommentreplySaveResponse PopCommentreplySaveAsync(ClubPopCommentreplySaveRequest request) {
        JdResponse raw = await this.client.ExecuteAsync(request.Raw());
        ClubPopCommentreplySaveResponse result = Json.Deserialize<ClubPopCommentreplySaveResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

}
