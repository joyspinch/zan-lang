using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.New;

// <c>jingdong.new.ware.mobilebigfield.get</c> 的请求。
public class NewWareMobilebigfieldGetRequest {
    JdRequest req;

    public NewWareMobilebigfieldGetRequest() {
        this.req = new JdRequest("jingdong.new.ware.mobilebigfield.get");
    }

    // 设置 <c>skuid</c> 参数。
    public NewWareMobilebigfieldGetRequest Skuid(long skuid) {
        this.req.SetLong("skuid", skuid);
