using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Vender;

// <c>jingdong.vender.auth.findUser</c> 的请求。
public class VenderAuthFindUserRequest {
    JdRequest req;

    public VenderAuthFindUserRequest() {
        this.req = new JdRequest("jingdong.vender.auth.findUser");
    }

    // 设置 <c>pin</c> 参数。
    VenderAuthFindUserRequest Pin(string pin) {
        this.req.Set("pin", pin);
        return this;
    }

    // 设置 <c>open_id_seller</c> 参数。
    VenderAuthFindUserRequest OpenIdSeller(string openIdSeller) {
        this.req.Set("open_id_seller", openIdSeller);
        return this;
    }

    // 设置 <c>xid_seller</c> 参数。
    VenderAuthFindUserRequest XidSeller(string xidSeller) {
        this.req.Set("xid_seller", xidSeller);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
