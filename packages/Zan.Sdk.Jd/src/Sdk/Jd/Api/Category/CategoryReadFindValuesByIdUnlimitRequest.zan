using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Category;

// <c>jingdong.category.read.findValuesByIdUnlimit</c> 的请求。
public class CategoryReadFindValuesByIdUnlimitRequest {
    JdRequest req;

    public CategoryReadFindValuesByIdUnlimitRequest() {
        this.req = new JdRequest("jingdong.category.read.findValuesByIdUnlimit");
    }

    // 设置 <c>id</c> 参数。
    CategoryReadFindValuesByIdUnlimitRequest Id(long id) {
        this.req.SetLong("id", id);
        return this;
    }

    // 设置 <c>field</c> 参数。
    CategoryReadFindValuesByIdUnlimitRequest Field(string field) {
        this.req.Set("field", field);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
