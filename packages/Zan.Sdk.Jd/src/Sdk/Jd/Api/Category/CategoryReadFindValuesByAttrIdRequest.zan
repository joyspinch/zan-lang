using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Category;

// <c>jingdong.category.read.findValuesByAttrId</c> 的请求。
public class CategoryReadFindValuesByAttrIdRequest {
    JdRequest req;

    public CategoryReadFindValuesByAttrIdRequest() {
        this.req = new JdRequest("jingdong.category.read.findValuesByAttrId");
    }

    // 设置 <c>categoryAttrId</c> 参数。
    public CategoryReadFindValuesByAttrIdRequest CategoryAttrId(long categoryAttrId) {
        this.req.SetLong("categoryAttrId", categoryAttrId);
        return this;
    }

    // 设置 <c>field</c> 参数。
    public CategoryReadFindValuesByAttrIdRequest Field(string field) {
        this.req.Set("field", field);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
