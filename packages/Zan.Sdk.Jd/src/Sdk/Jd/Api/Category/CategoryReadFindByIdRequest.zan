using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Category;

// <c>jingdong.category.read.findById</c> 的请求。
public class CategoryReadFindByIdRequest {
    JdRequest req;

    public CategoryReadFindByIdRequest() {
        this.req = new JdRequest("jingdong.category.read.findById");
    }

    // 设置 <c>cid</c> 参数。
    CategoryReadFindByIdRequest Cid(long cid) {
        this.req.SetLong("cid", cid);
        return this;
    }

    // 设置 <c>field</c> 参数。
    CategoryReadFindByIdRequest Field(string field) {
        this.req.Set("field", field);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
