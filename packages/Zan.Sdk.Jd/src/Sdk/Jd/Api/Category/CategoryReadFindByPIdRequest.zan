using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Category;

// <c>jingdong.category.read.findByPId</c> 的请求。
public class CategoryReadFindByPIdRequest {
    JdRequest req;

    public CategoryReadFindByPIdRequest() {
        this.req = new JdRequest("jingdong.category.read.findByPId");
    }

    // 设置 <c>parentCid</c> 参数。
    public CategoryReadFindByPIdRequest ParentCid(long parentCid) {
        this.req.SetLong("parentCid", parentCid);
        return this;
    }

    // 设置 <c>field</c> 参数。
    public CategoryReadFindByPIdRequest Field(string field) {
        this.req.Set("field", field);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
