using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Category;

// <c>jingdong.category.read.findAttrById</c> 的请求。
public class CategoryReadFindAttrByIdRequest {
    JdRequest req;

    public CategoryReadFindAttrByIdRequest() {
        this.req = new JdRequest("jingdong.category.read.findAttrById");
    }

    // 设置 <c>attrId</c> 参数。
    public CategoryReadFindAttrByIdRequest AttrId(long attrId) {
        this.req.SetLong("attrId", attrId);
        return this;
    }

    // 设置 <c>field</c> 参数。
    public CategoryReadFindAttrByIdRequest Field(string field) {
        this.req.Set("field", field);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
