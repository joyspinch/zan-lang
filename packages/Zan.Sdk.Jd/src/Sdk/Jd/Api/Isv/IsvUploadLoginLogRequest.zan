using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Isv;

// <c>jingdong.isv.uploadLoginLog</c> 的请求。
public class IsvUploadLoginLogRequest {
    JdRequest req;

    public IsvUploadLoginLogRequest() {
        this.req = new JdRequest("jingdong.isv.uploadLoginLog");
    }

    // 设置 <c>result</c> 参数。
    public IsvUploadLoginLogRequest Result(string result) {
        this.req.Set("result", result);
        return this;
    }

    // 设置 <c>user_ip</c> 参数。
    public IsvUploadLoginLogRequest UserIp(string userIp) {
        this.req.Set("user_ip", userIp);
        return this;
    }

    // 设置 <c>app_name</c> 参数。
    public IsvUploadLoginLogRequest AppName(string appName) {
        this.req.Set("app_name", appName);
        return this;
    }

    // 设置 <c>josAppKey</c> 参数。
    public IsvUploadLoginLogRequest JosAppKey(string josAppKey) {
        this.req.Set("josAppKey", josAppKey);
        return this;
    }

    // 设置 <c>jd_id</c> 参数。
    public IsvUploadLoginLogRequest JdId(string jdId) {
        this.req.Set("jd_id", jdId);
        return this;
    }

    // 设置 <c>device_id</c> 参数。
    public IsvUploadLoginLogRequest DeviceId(string deviceId) {
        this.req.Set("device_id", deviceId);
        return this;
    }

    // 设置 <c>user_id</c> 参数。
    public IsvUploadLoginLogRequest UserId(string userId) {
        this.req.Set("user_id", userId);
        return this;
    }

    // 设置 <c>message</c> 参数。
    public IsvUploadLoginLogRequest Message(string message) {
        this.req.Set("message", message);
        return this;
    }

    // 设置 <c>time_stamp</c> 参数。
    public IsvUploadLoginLogRequest TimeStamp(string timeStamp) {
        this.req.Set("time_stamp", timeStamp);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
