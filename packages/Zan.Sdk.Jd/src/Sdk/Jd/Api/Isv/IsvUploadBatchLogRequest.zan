using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Isv;

// <c>jingdong.isv.uploadBatchLog</c> 的请求。
public class IsvUploadBatchLogRequest {
    JdRequest req;

    public IsvUploadBatchLogRequest() {
        this.req = new JdRequest("jingdong.isv.uploadBatchLog");
    }

    // 设置 <c>josAppKey</c> 参数。
    IsvUploadBatchLogRequest JosAppKey(string josAppKey) {
        this.req.Set("josAppKey", josAppKey);
        return this;
    }

    // 设置 <c>data</c> 参数。
    IsvUploadBatchLogRequest Data(string data) {
        this.req.Set("data", data);
        return this;
    }

    // 设置 <c>time_stamp</c> 参数。
    IsvUploadBatchLogRequest TimeStamp(string timeStamp) {
        this.req.Set("time_stamp", timeStamp);
        return this;
    }

    // 设置 <c>type</c> 参数。
    IsvUploadBatchLogRequest Type(string type) {
        this.req.Set("type", type);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
