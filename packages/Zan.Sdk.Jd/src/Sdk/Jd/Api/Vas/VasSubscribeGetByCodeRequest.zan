using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Vas;

// <c>jingdong.vas.subscribe.getByCode</c> 的请求。
public class VasSubscribeGetByCodeRequest {
    JdRequest req;

    public VasSubscribeGetByCodeRequest() {
        this.req = new JdRequest("jingdong.vas.subscribe.getByCode");
    }

    // 设置 <c>item_code</c> 参数。
    public VasSubscribeGetByCodeRequest ItemCode(string itemCode) {
        this.req.Set("item_code", itemCode);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
