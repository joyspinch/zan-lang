using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Vas;

// <c>jingdong.vas.subscribe.get</c> 的请求。
public class VasSubscribeGetRequest {
    JdRequest req;

    public VasSubscribeGetRequest() {
        this.req = new JdRequest("jingdong.vas.subscribe.get");
    }

    // 设置 <c>user_name</c> 参数。
    VasSubscribeGetRequest UserName(string userName) {
        this.req.Set("user_name", userName);
        return this;
    }

    // 设置 <c>item_code</c> 参数。
    VasSubscribeGetRequest ItemCode(string itemCode) {
        this.req.Set("item_code", itemCode);
        return this;
    }

    // 设置 <c>open_id_buyer</c> 参数。
    VasSubscribeGetRequest OpenIdBuyer(string openIdBuyer) {
        this.req.Set("open_id_buyer", openIdBuyer);
        return this;
    }

    // 设置 <c>xid_buyer</c> 参数。
    VasSubscribeGetRequest XidBuyer(string xidBuyer) {
        this.req.Set("xid_buyer", xidBuyer);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
