using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Market;

// <c>jingdong.market.charge.list.get</c> 的请求。
public class MarketChargeListGetRequest {
    JdRequest req;

    public MarketChargeListGetRequest() {
        this.req = new JdRequest("jingdong.market.charge.list.get");
    }

    // 设置 <c>service_code</c> 参数。
    MarketChargeListGetRequest ServiceCode(string serviceCode) {
        this.req.Set("service_code", serviceCode);
        return this;
    }

    // 设置 <c>service_id</c> 参数。
    MarketChargeListGetRequest ServiceId(long serviceId) {
        this.req.SetLong("service_id", serviceId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
