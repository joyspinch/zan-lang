using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Market;

// <c>jingdong.market.bdp.cart.getPinsBySkuId</c> 的请求。
public class MarketBdpCartGetPinsBySkuIdRequest {
    JdRequest req;

    public MarketBdpCartGetPinsBySkuIdRequest() {
        this.req = new JdRequest("jingdong.market.bdp.cart.getPinsBySkuId");
    }

    // 设置 <c>skuId</c> 参数。
    public MarketBdpCartGetPinsBySkuIdRequest SkuId(long skuId) {
        this.req.SetLong("skuId", skuId);
        return this;
    }

    // 设置 <c>days</c> 参数。
    public MarketBdpCartGetPinsBySkuIdRequest Days(string days) {
        this.req.Set("days", days);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
