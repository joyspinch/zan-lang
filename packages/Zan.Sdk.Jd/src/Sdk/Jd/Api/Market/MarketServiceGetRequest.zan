using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Market;

// <c>jingdong.market.service.get</c> 的请求。
public class MarketServiceGetRequest {
    JdRequest req;

    public MarketServiceGetRequest() {
        this.req = new JdRequest("jingdong.market.service.get");
    }

    // 设置 <c>service_code</c> 参数。
    MarketServiceGetRequest ServiceCode(string serviceCode) {
        this.req.Set("service_code", serviceCode);
        return this;
    }

    // 设置 <c>id</c> 参数。
    MarketServiceGetRequest Id(long id) {
        this.req.SetLong("id", id);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
