using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Pop;

// <c>jingdong.pop.order.enGet</c> 的请求。
public class PopOrderEnGetRequest {
    JdRequest req;

    public PopOrderEnGetRequest() {
        this.req = new JdRequest("jingdong.pop.order.enGet");
    }

    // 设置 <c>order_state</c> 参数。
    public PopOrderEnGetRequest OrderState(string orderState) {
        this.req.Set("order_state", orderState);
        return this;
    }

    // 设置 <c>optional_fields</c> 参数。
    public PopOrderEnGetRequest OptionalFields(string optionalFields) {
        this.req.Set("optional_fields", optionalFields);
        return this;
    }

    // 设置 <c>order_id</c> 参数。
    public PopOrderEnGetRequest OrderId(string orderId) {
        this.req.Set("order_id", orderId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
