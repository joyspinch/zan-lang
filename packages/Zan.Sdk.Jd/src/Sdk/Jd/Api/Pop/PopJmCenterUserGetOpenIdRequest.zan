using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Pop;

// <c>jingdong.pop.jm.center.user.getOpenId</c> 的请求。
public class PopJmCenterUserGetOpenIdRequest {
    JdRequest req;

    public PopJmCenterUserGetOpenIdRequest() {
        this.req = new JdRequest("jingdong.pop.jm.center.user.getOpenId");
    }

    // 设置 <c>source</c> 参数。
    PopJmCenterUserGetOpenIdRequest Source(string source) {
        this.req.Set("source", source);
        return this;
    }

    // 设置 <c>token</c> 参数。
    PopJmCenterUserGetOpenIdRequest Token(string token) {
        this.req.Set("token", token);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
