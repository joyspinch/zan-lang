using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Pop;

// <c>jingdong.pop.fw.order.listwithpage</c> 的请求。
public class PopFwOrderListwithpageRequest {
    JdRequest req;

    public PopFwOrderListwithpageRequest() {
        this.req = new JdRequest("jingdong.pop.fw.order.listwithpage");
    }

    // 设置 <c>pageSize</c> 参数。
    public PopFwOrderListwithpageRequest PageSize(int pageSize) {
        this.req.SetInt("pageSize", pageSize);
        return this;
    }

    // 设置 <c>fwsPin</c> 参数。
    public PopFwOrderListwithpageRequest FwsPin(string fwsPin) {
        this.req.Set("fwsPin", fwsPin);
        return this;
    }

    // 设置 <c>currentPage</c> 参数。
    public PopFwOrderListwithpageRequest CurrentPage(int currentPage) {
        this.req.SetInt("currentPage", currentPage);
        return this;
    }

    // 设置 <c>serviceCode</c> 参数。
    public PopFwOrderListwithpageRequest ServiceCode(string serviceCode) {
        this.req.Set("serviceCode", serviceCode);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
