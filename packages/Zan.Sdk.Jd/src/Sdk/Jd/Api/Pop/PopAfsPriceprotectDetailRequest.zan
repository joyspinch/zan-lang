using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Pop;

// <c>jingdong.pop.afs.priceprotect.detail</c> 的请求。
public class PopAfsPriceprotectDetailRequest {
    JdRequest req;

    public PopAfsPriceprotectDetailRequest() {
        this.req = new JdRequest("jingdong.pop.afs.priceprotect.detail");
    }

    // 设置 <c>pricePrtctType</c> 参数。
    public PopAfsPriceprotectDetailRequest PricePrtctType(int pricePrtctType) {
        this.req.SetInt("pricePrtctType", pricePrtctType);
        return this;
    }

    // 设置 <c>uuid</c> 参数。
    public PopAfsPriceprotectDetailRequest Uuid(long uuid) {
        this.req.SetLong("uuid", uuid);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
