using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Pop;

// <c>jingdong.pop.order.encryptMobileNum</c> 的请求。
public class PopOrderEncryptMobileNumRequest {
    JdRequest req;

    public PopOrderEncryptMobileNumRequest() {
        this.req = new JdRequest("jingdong.pop.order.encryptMobileNum");
    }

    // 设置 <c>mobile</c> 参数。
    PopOrderEncryptMobileNumRequest Mobile(string mobile) {
        this.req.Set("mobile", mobile);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
