    }

    // 设置 <c>expiration</c> 参数。
    public PopOrderGetmobilelistRequest Expiration(int expiration) {
        this.req.SetInt("expiration", expiration);
        return this;
    }

    // 设置 <c>orderType</c> 参数。
    public PopOrderGetmobilelistRequest OrderType(string orderType) {
        this.req.Set("orderType", orderType);
