    public PopOrderGetmobilelistRequest Region(string region) {
        this.req.Set("region", region);
        return this;
    }

    // 设置 <c>orderId</c> 参数。
    public PopOrderGetmobilelistRequest OrderId(string orderId) {
        this.req.Set("orderId", orderId);
