using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Image;

// <c>jingdong.image.write.delete</c> 的请求。
public class ImageWriteDeleteRequest {
    JdRequest req;

    public ImageWriteDeleteRequest() {
        this.req = new JdRequest("jingdong.image.write.delete");
    }

    // 设置 <c>wareId</c> 参数。
    ImageWriteDeleteRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>colorIds</c> 参数。
    ImageWriteDeleteRequest ColorIds(string colorIds) {
        this.req.Set("colorIds", colorIds);
        return this;
    }

    // 设置 <c>imgIndexes</c> 参数。
    ImageWriteDeleteRequest ImgIndexes(string imgIndexes) {
        this.req.Set("imgIndexes", imgIndexes);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
