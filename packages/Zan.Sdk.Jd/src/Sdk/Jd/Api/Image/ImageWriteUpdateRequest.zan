using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Image;

// <c>jingdong.image.write.update</c> 的请求。
public class ImageWriteUpdateRequest {
    JdRequest req;

    public ImageWriteUpdateRequest() {
        this.req = new JdRequest("jingdong.image.write.update");
    }

    // 设置 <c>wareId</c> 参数。
    public ImageWriteUpdateRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>colorId</c> 参数。
    public ImageWriteUpdateRequest ColorId(string colorId) {
        this.req.Set("colorId", colorId);
        return this;
    }

    // 设置 <c>imgId</c> 参数。
    public ImageWriteUpdateRequest ImgId(string imgId) {
        this.req.Set("imgId", imgId);
        return this;
    }

    // 设置 <c>imgIndex</c> 参数。
    public ImageWriteUpdateRequest ImgIndex(string imgIndex) {
        this.req.Set("imgIndex", imgIndex);
        return this;
    }

    // 设置 <c>imgUrl</c> 参数。
    public ImageWriteUpdateRequest ImgUrl(string imgUrl) {
        this.req.Set("imgUrl", imgUrl);
        return this;
    }

    // 设置 <c>imgZoneId</c> 参数。
    public ImageWriteUpdateRequest ImgZoneId(string imgZoneId) {
        this.req.Set("imgZoneId", imgZoneId);
        return this;
    }

    // 设置 <c>isGgt</c> 参数。
    public ImageWriteUpdateRequest IsGgt(string isGgt) {
        this.req.Set("isGgt", isGgt);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
