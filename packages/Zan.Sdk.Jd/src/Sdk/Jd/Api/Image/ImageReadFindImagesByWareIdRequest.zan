using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Image;

// <c>jingdong.image.read.findImagesByWareId</c> 的请求。
public class ImageReadFindImagesByWareIdRequest {
    JdRequest req;

    public ImageReadFindImagesByWareIdRequest() {
        this.req = new JdRequest("jingdong.image.read.findImagesByWareId");
    }

    // 设置 <c>wareId</c> 参数。
    ImageReadFindImagesByWareIdRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
