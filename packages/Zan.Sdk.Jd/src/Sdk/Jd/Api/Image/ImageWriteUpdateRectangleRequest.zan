        this.req = new JdRequest("jingdong.image.write.updateRectangle");
    }

    // 设置 <c>wareId</c> 参数。
    public ImageWriteUpdateRectangleRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>colorId</c> 参数。
    public ImageWriteUpdateRectangleRequest ColorId(string colorId) {
        this.req.Set("colorId", colorId);
        return this;
    }

    // 设置 <c>imgId</c> 参数。
    public ImageWriteUpdateRectangleRequest ImgId(string imgId) {
        this.req.Set("imgId", imgId);
        return this;
    }

    // 设置 <c>imgRectangleUrl</c> 参数。
    public ImageWriteUpdateRectangleRequest ImgRectangleUrl(string imgRectangleUrl) {
        this.req.Set("imgRectangleUrl", imgRectangleUrl);
        return this;
    }

    // 设置 <c>imgIndex</c> 参数。
    public ImageWriteUpdateRectangleRequest ImgIndex(string imgIndex) {
        this.req.Set("imgIndex", imgIndex);
        return this;
    }

    // 设置 <c>isGgt</c> 参数。
    public ImageWriteUpdateRectangleRequest IsGgt(string isGgt) {
        this.req.Set("isGgt", isGgt);
        return this;
    }

