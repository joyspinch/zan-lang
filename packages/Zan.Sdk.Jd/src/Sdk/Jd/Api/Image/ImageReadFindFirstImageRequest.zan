using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Image;

// <c>jingdong.image.read.findFirstImage</c> 的请求。
public class ImageReadFindFirstImageRequest {
    JdRequest req;

    public ImageReadFindFirstImageRequest() {
        this.req = new JdRequest("jingdong.image.read.findFirstImage");
    }

    // 设置 <c>wareId</c> 参数。
    public ImageReadFindFirstImageRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>colorId</c> 参数。
    public ImageReadFindFirstImageRequest ColorId(string colorId) {
        this.req.Set("colorId", colorId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
