using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Image;

// <c>jingdong.image.read.findImagesByColor</c> 的请求。
public class ImageReadFindImagesByColorRequest {
    JdRequest req;

    public ImageReadFindImagesByColorRequest() {
        this.req = new JdRequest("jingdong.image.read.findImagesByColor");
    }

    // 设置 <c>wareId</c> 参数。
    public ImageReadFindImagesByColorRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    // 设置 <c>colorId</c> 参数。
    public ImageReadFindImagesByColorRequest ColorId(string colorId) {
        this.req.Set("colorId", colorId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
