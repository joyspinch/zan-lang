using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Sku;

// <c>jingdong.sku.read.findSkuById</c> 的请求。
public class SkuReadFindSkuByIdRequest {
    JdRequest req;

    public SkuReadFindSkuByIdRequest() {
        this.req = new JdRequest("jingdong.sku.read.findSkuById");
    }

    // 设置 <c>skuId</c> 参数。
    SkuReadFindSkuByIdRequest SkuId(long skuId) {
        this.req.SetLong("skuId", skuId);
        return this;
    }

    // 设置 <c>field</c> 参数。
    SkuReadFindSkuByIdRequest Field(string field) {
        this.req.Set("field", field);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
