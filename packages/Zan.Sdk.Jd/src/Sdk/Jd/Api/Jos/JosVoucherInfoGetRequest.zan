using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Jos;

// <c>jingdong.jos.voucher.info.get</c> 的请求。
public class JosVoucherInfoGetRequest {
    JdRequest req;

    public JosVoucherInfoGetRequest() {
        this.req = new JdRequest("jingdong.jos.voucher.info.get");
    }

    // 设置 <c>access_token</c> 参数。
    public JosVoucherInfoGetRequest AccessToken(string accessToken) {
        this.req.Set("access_token", accessToken);
        return this;
    }

    // 设置 <c>customer_user_id</c> 参数。
    public JosVoucherInfoGetRequest CustomerUserId(long customerUserId) {
        this.req.SetLong("customer_user_id", customerUserId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
