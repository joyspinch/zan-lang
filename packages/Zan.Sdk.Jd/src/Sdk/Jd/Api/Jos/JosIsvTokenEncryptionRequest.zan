using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Jos;

// <c>jingdong.jos.isv.token.encryption</c> 的请求。
public class JosIsvTokenEncryptionRequest {
    JdRequest req;

    public JosIsvTokenEncryptionRequest() {
        this.req = new JdRequest("jingdong.jos.isv.token.encryption");
    }

    // 设置 <c>tokenStr</c> 参数。
    JosIsvTokenEncryptionRequest TokenStr(string tokenStr) {
        this.req.Set("tokenStr", tokenStr);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
