using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Jos;

// <c>jingdong.jos.order.oaid.waiting</c> 的请求。
public class JosOrderOaidWaitingRequest {
    JdRequest req;

    public JosOrderOaidWaitingRequest() {
        this.req = new JdRequest("jingdong.jos.order.oaid.waiting");
    }

    // 设置 <c>orderType</c> 参数。
    public JosOrderOaidWaitingRequest OrderType(string orderType) {
        this.req.Set("orderType", orderType);
        return this;
    }

    // 设置 <c>isTelephoneCalculate</c> 参数。
    public JosOrderOaidWaitingRequest IsTelephoneCalculate(bool isTelephoneCalculate) {
        this.req.SetBool("isTelephoneCalculate", isTelephoneCalculate);
        return this;
    }

    // 设置 <c>orderId</c> 参数。
    public JosOrderOaidWaitingRequest OrderId(string orderId) {
        this.req.Set("orderId", orderId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
