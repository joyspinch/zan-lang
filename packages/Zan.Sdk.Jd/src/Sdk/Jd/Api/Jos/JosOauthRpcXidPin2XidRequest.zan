using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Jos;

// <c>jingdong.jos.oauth.rpc.xid.pin2Xid</c> 的请求。
public class JosOauthRpcXidPin2XidRequest {
    JdRequest req;

    public JosOauthRpcXidPin2XidRequest() {
        this.req = new JdRequest("jingdong.jos.oauth.rpc.xid.pin2Xid");
    }

    // 设置 <c>userPin</c> 参数。
    JosOauthRpcXidPin2XidRequest UserPin(string userPin) {
        this.req.Set("userPin", userPin);
        return this;
    }

    // 设置 <c>appKey</c> 参数。
    JosOauthRpcXidPin2XidRequest AppKey(string appKey) {
        this.req.Set("appKey", appKey);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
