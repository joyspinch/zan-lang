using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Jos;

// <c>jingdong.jos.master.key.get</c> 的请求。
public class JosMasterKeyGetRequest {
    JdRequest req;

    public JosMasterKeyGetRequest() {
        this.req = new JdRequest("jingdong.jos.master.key.get");
    }

    // 设置 <c>sig</c> 参数。
    JosMasterKeyGetRequest Sig(string sig) {
        this.req.Set("sig", sig);
        return this;
    }

    // 设置 <c>sdk_ver</c> 参数。
    JosMasterKeyGetRequest SdkVer(int sdkVer) {
        this.req.SetInt("sdk_ver", sdkVer);
        return this;
    }

    // 设置 <c>ts</c> 参数。
    JosMasterKeyGetRequest Ts(long ts) {
        this.req.SetLong("ts", ts);
        return this;
    }

    // 设置 <c>tid</c> 参数。
    JosMasterKeyGetRequest Tid(string tid) {
        this.req.Set("tid", tid);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
