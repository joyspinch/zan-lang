using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Test;

// <c>shangling.test.demo1</c> 的请求。
public class TestDemo1Request {
    JdRequest req;

    public TestDemo1Request() {
        this.req = new JdRequest("shangling.test.demo1");
    }

    // 设置 <c>bizTenantCode</c> 参数。
    TestDemo1Request BizTenantCode(string bizTenantCode) {
        this.req.Set("bizTenantCode", bizTenantCode);
        return this;
    }

    // 设置 <c>name</c> 参数。
    TestDemo1Request Name(string name) {
        this.req.Set("name", name);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
