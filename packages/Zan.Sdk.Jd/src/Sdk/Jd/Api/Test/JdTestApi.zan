using System;
using System.Json;
using Sdk.Jd;

namespace Sdk.Jd.Api.Test;

// jingdong.test.* 的强类型客户端。
class JdTestApi {
    JdClient client;

    public JdTestApi(JdClient client) { this.client = client; }

    // 执行 <c>shangling.test.demo1</c>。
    async TestDemo1Response Demo1Async(TestDemo1Request request) {
        JdResponse raw = await this.client.ExecuteAsync(request.Raw());
        TestDemo1Response result = Json.Deserialize<TestDemo1Response>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

}
