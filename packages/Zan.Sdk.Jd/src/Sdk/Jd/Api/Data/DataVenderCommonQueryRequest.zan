using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Data;

// <c>jingdong.data.vender.common.query</c> 的请求。
public class DataVenderCommonQueryRequest {
    JdRequest req;

    public DataVenderCommonQueryRequest() {
        this.req = new JdRequest("jingdong.data.vender.common.query");
    }

    // 设置 <c>method</c> 参数。
    DataVenderCommonQueryRequest Method(string method) {
        this.req.Set("method", method);
        return this;
    }

    // 设置 <c>input_para</c> 参数。
    DataVenderCommonQueryRequest InputPara(string inputPara) {
        this.req.Set("input_para", inputPara);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
