using System;
using System.Json;
using Sdk.Jd;

namespace Sdk.Jd.Api.Data;

// jingdong.data.* 的强类型客户端。
class JdDataApi {
    JdClient client;

    public JdDataApi(JdClient client) { this.client = client; }

    // 执行 <c>jingdong.data.vender.common.query</c>。
    async DataVenderCommonQueryResponse VenderCommonQueryAsync(DataVenderCommonQueryRequest request) {
        JdResponse raw = await this.client.ExecuteAsync(request.Raw());
        DataVenderCommonQueryResponse result = Json.Deserialize<DataVenderCommonQueryResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

}
