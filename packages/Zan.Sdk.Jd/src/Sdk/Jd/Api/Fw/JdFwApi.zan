using System;
using System.Json;
using Sdk.Jd;

namespace Sdk.Jd.Api.Fw;

// jingdong.fw.* 的强类型客户端。
class JdFwApi {
    JdClient client;

    public JdFwApi(JdClient client) { this.client = client; }

    // 执行 <c>jingdong.fw.market.paymentout</c>。
    async FwMarketPaymentoutResponse MarketPaymentoutAsync(FwMarketPaymentoutRequest request) {
        JdResponse raw = await this.client.ExecuteAsync(request.Raw());
        FwMarketPaymentoutResponse result = Json.Deserialize<FwMarketPaymentoutResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

}
