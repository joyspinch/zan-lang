using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.User;

// <c>jingdong.user.getUserInfoByOpenId</c> 的请求。
public class UserGetUserInfoByOpenIdRequest {
    JdRequest req;

    public UserGetUserInfoByOpenIdRequest() {
        this.req = new JdRequest("jingdong.user.getUserInfoByOpenId");
    }

    // 设置 <c>openId</c> 参数。
    public UserGetUserInfoByOpenIdRequest OpenId(string openId) {
        this.req.Set("openId", openId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
