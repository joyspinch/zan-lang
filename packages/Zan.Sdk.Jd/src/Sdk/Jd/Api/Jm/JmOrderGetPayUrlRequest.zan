using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Jm;

// <c>jingdong.jm.order.getPayUrl</c> 的请求。
public class JmOrderGetPayUrlRequest {
    JdRequest req;

    public JmOrderGetPayUrlRequest() {
        this.req = new JdRequest("jingdong.jm.order.getPayUrl");
    }

    // 设置 <c>serviceCode</c> 参数。
    public JmOrderGetPayUrlRequest ServiceCode(string serviceCode) {
        this.req.Set("serviceCode", serviceCode);
        return this;
    }

    // 设置 <c>accessCode</c> 参数。
    public JmOrderGetPayUrlRequest AccessCode(string accessCode) {
        this.req.Set("accessCode", accessCode);
        return this;
    }

    // 设置 <c>orderNum</c> 参数。
    public JmOrderGetPayUrlRequest OrderNum(int orderNum) {
        this.req.SetInt("orderNum", orderNum);
        return this;
    }

    // 设置 <c>skuId</c> 参数。
    public JmOrderGetPayUrlRequest SkuId(long skuId) {
        this.req.SetLong("skuId", skuId);
        return this;
    }

    // 设置 <c>clientIp</c> 参数。
    public JmOrderGetPayUrlRequest ClientIp(string clientIp) {
        this.req.Set("clientIp", clientIp);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
