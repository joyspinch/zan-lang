using System;
using System.Json;
using Sdk.Jd;
using Sdk.Jd.Domain;

namespace Sdk.Jd.Api.Adwords;

// <c>jingdong.adwords.read.findAdWordsByWareId</c> 的请求。
public class AdwordsReadFindAdWordsByWareIdRequest {
    JdRequest req;

    public AdwordsReadFindAdWordsByWareIdRequest() {
        this.req = new JdRequest("jingdong.adwords.read.findAdWordsByWareId");
    }

    // 设置 <c>wareId</c> 参数。
    AdwordsReadFindAdWordsByWareIdRequest WareId(long wareId) {
        this.req.SetLong("wareId", wareId);
        return this;
    }

    JdRequest Raw() { return this.req; }
}
