using System;

namespace Sdk.Jd;

/// <summary>
/// 京东开放平台（JOS）调用失败时抛出的异常。
///
/// 与 C# 原版不同：原版把参数校验失败和网关错误"吞"成一个字段被填好的
/// 空 Response 对象返回，调用方不检查 IsError 就会拿着假数据继续跑。
/// Zan 版一律抛异常，失败无法被静默忽略。
/// </summary>
class JdException : Exception {
    /// <summary>网关或业务错误码，本地校验失败时为 "client.paramError"。</summary>
    public string Code;

    /// <summary>原始响应报文，便于排查；本地失败时为空串。</summary>
    public string Body;

    public JdException(string code, string message, string body) {
        this.Code = code;
        this.Body = body;
        Message = code + ": " + message;
    }
}
