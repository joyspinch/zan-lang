using System;

namespace Sdk.Jd;

// 京东开放平台（JOS）异常；本地校验失败时 Code 为 "client.paramError"。
public class JdException : Exception {
    public string Code;
    public string Body;

    public JdException(string code, string message, string body) {
        this.Code = code;
        this.Body = body;
        Message = code + ": " + message;
    }
}
