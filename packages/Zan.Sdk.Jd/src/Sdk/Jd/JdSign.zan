using System;
using System.Text;
using System.Security.Cryptography;

namespace Sdk.Jd;

// 京东开放平台 MD5 签名（按 key 升序拼接 "secret+k1v1...+secret"，跳过空 key/空值）。
public class JdSign {
    public static string Compute(Dictionary<string, string> parameters, string secret) {
        if (parameters == null || secret == null || secret.Length == 0) {
            throw new JdException("client.paramError", "签名需要参数和应用密钥", "");
        }
        // Dictionary.Keys 返回内部 List，必须复制后再排序以免打乱键值映射。
        List<string> rawKeys = parameters.Keys;
        List<string> ks = new List<string>();
        for (int i = 0; i < rawKeys.Count; i = i + 1) {
            string rk = rawKeys[i];
            if (rk != null && rk.Length > 0 && rk != "sign") {
                ks.Add(rk);
            }
        }
        ks.Sort();

        StringBuilder sb = new StringBuilder();
        sb.Append(secret);
        for (int i = 0; i < ks.Count; i = i + 1) {
            string k = ks[i];
            string v = parameters[k];
            if (v != null && v.Length > 0) {
                sb.Append(k);
                sb.Append(v);
            }
        }
        sb.Append(secret);

        string payload = sb.ToString();
        return Convert.ToHexString(Md5.Hash(payload, payload.Length), 0, 16).ToUpperAscii();
    }
}
