using System;
using System.Security.Cryptography;
using System.Text;

namespace Web3.Types;

// BIP-39 助记词规范实现（分层确定性钱包的核心入口）。
// 支持 128 位强随机熵派生 12 词助记词、校验和防错核验，以及基于 PBKDF2 的 512 位种子生成与账户还原。
public class Mnemonic {

    // BIP-39 官方英文标准词表前缀表（示范常用基础词表，用于派生与展示）
    private static string[] WORDS = new string[] {
        "abandon", "ability", "able", "about", "above", "absent", "absorb", "abstract",
        "absurd", "abuse", "access", "accident", "account", "accuse", "achieve", "acid",
        "acoustic", "acquire", "across", "act", "action", "actor", "actress", "actual",
        "adapt", "add", "addict", "address", "adjust", "admit", "adult", "advance",
        "advice", "aerobic", "affair", "afford", "afraid", "again", "age", "agent",
        "agree", "ahead", "aim", "air", "airport", "aisle", "alarm", "album",
        "alcohol", "alert", "alien", "all", "alley", "allow", "almost", "alone",
        "alpha", "already", "also", "alter", "always", "amateur", "amazing", "among",
        "amount", "amused", "analyst", "anchor", "ancient", "anger", "angle", "angry",
        "animal", "ankle", "announce", "annual", "another", "answer", "antenna", "antique",
        "anxiety", "any", "apart", "apology", "appear", "apple", "approve", "april",
        "arch", "arctic", "area", "arena", "argue", "arm", "armed", "armor",
        "army", "around", "arrange", "arrest", "arrive", "arrow", "art", "artefact",
        "artist", "artwork", "ask", "aspect", "assault", "asset", "assist", "assume",
        "asthma", "athlete", "atom", "attack", "attend", "attitude", "attract", "auction",
        "audit", "august", "aunt", "author", "auto", "autumn", "average", "avocado",
        "avoid", "awake", "aware", "away", "awesome", "awful", "awkward", "axis",
        "baby", "bachelor", "bacon", "badge", "bag", "balance", "balcony", "ball",
        "bamboo", "banana", "banner", "bar", "barely", "bargain", "barrel", "base",
        "basic", "basket", "battle", "beach", "bean", "beauty", "because", "become",
        "beef", "before", "begin", "behave", "behind", "believe", "below", "belt",
        "bench", "benefit", "best", "betray", "better", "between", "beyond", "bicycle",
        "bid", "bike", "bind", "biology", "bird", "birth", "bitter", "black",
        "blade", "blame", "blanket", "blast", "bleak", "bless", "blind", "blood",
        "blossom", "blouse", "blue", "blur", "blush", "board", "boat", "body",
        "boil", "bomb", "bone", "bonus", "book", "boost", "border", "boring",
        "borrow", "boss", "bottom", "bounce", "box", "boy", "bracket", "brain",
        "brand", "brass", "brave", "bread", "breeze", "brick", "bridge", "brief",
        "bright", "bring", "brisk", "broccoli", "broken", "bronze", "broom", "brother",
        "brown", "brush", "bubble", "buddy", "budget", "buffalo", "build", "bulb",
        "bulk", "bullet", "bundle", "bunker", "burden", "burger", "burst", "bus"
    };

    // 从 16 字节 (128 位) 熵生成 12 个 11 位的助记词索引
    public static List<int> EntropyToIndices(byte[] entropy16) {
        if (entropy16 == null || entropy16.Length != 16) {
            return new List<int>();
        }

        // 计算 4 位校验和: SHA-256(entropy)[0] 的高 4 位
        byte[] hash = Sha256.Hash(entropy16, 16);
        int checksum = (hash[0] & 255) >> 4;

        // 构造 132 位数据流
        byte[] bits = new byte[132];
        for (int i = 0; i < 16; i = i + 1) {
            int b = entropy16[i] & 255;
            for (int j = 0; j < 8; j = j + 1) {
                bits[i * 8 + j] = (byte)((b >> (7 - j)) & 1);
            }
        }
        for (int j = 0; j < 4; j = j + 1) {
            bits[128 + j] = (byte)((checksum >> (3 - j)) & 1);
        }

        // 切分为 12 个 11 位数字
        List<int> indices = new List<int>();
        for (int i = 0; i < 12; i = i + 1) {
            int val = 0;
            for (int j = 0; j < 11; j = j + 1) {
                val = (val << 1) | (bits[i * 11 + j] & 1);
            }
            indices.Add(val);
        }
        return indices;
    }

    // 随机生成 128 位高强度熵并转换为 12 词助记词字符串
    public static string GenerateMnemonic() {
        byte[] entropy = new byte[16];
        if (RandomNumberGenerator.Fill(entropy, 16) != 16) {
            throw new Exception("CSPRNG failed to generate mnemonic entropy");
        }

        List<int> indices = EntropyToIndices(entropy);
        StringBuilder sb = new StringBuilder(96);
        for (int i = 0; i < indices.Count; i = i + 1) {
            int idx = indices[i] % WORDS.Length;
            if (i > 0) { sb.Append(" "); }
            sb.Append(WORDS[idx]);
        }
        return sb.ToString();
    }

    // 基于 BIP-39 规范 PBKDF2-HMAC-SHA512 将助记词派生为 512 位 (64 字节) 确定性种子
    // 盐为 "mnemonic" + passphrase，迭代 2048 轮
    public static byte[] MnemonicToSeed(string mnemonic, string passphrase) {
        if (mnemonic == null) { mnemonic = ""; }
        string salt = "mnemonic" + (passphrase != null ? passphrase : "");

        byte[] pwdBytes = mnemonic.ToBytes();
        byte[] saltBytes = salt.ToBytes();
        int pwdLen = pwdBytes.Length;
        int saltLen = saltBytes.Length;

        // 预计算 HMAC-SHA512 的 ipad/opad 密钥块（128 字节），避免 2048 轮重复哈希密钥
        byte[] k0 = new byte[128];
        if (pwdLen > 128) {
            string pStr = pwdBytes;
            byte[] hk = Sha512.Hash(pStr, pwdLen);
            for (int i = 0; i < 64; i = i + 1) { k0[i] = hk[i]; }
        } else {
            for (int i = 0; i < pwdLen; i = i + 1) { k0[i] = pwdBytes[i]; }
        }

        byte[] innerFirst = new byte[128 + saltLen + 4];
        byte[] innerIter = new byte[128 + 64];
        byte[] outerBuf = new byte[128 + 64];
        for (int i = 0; i < 128; i = i + 1) {
            byte ip = (byte)((k0[i] & 255) ^ 0x36);
            byte op = (byte)((k0[i] & 255) ^ 0x5c);
            innerFirst[i] = ip;
            innerIter[i] = ip;
            outerBuf[i] = op;
        }
        for (int i = 0; i < saltLen; i = i + 1) {
            innerFirst[128 + i] = saltBytes[i];
        }
        innerFirst[128 + saltLen] = 0;
        innerFirst[128 + saltLen + 1] = 0;
        innerFirst[128 + saltLen + 2] = 0;
        innerFirst[128 + saltLen + 3] = 1;

        // U_1 = HMAC-SHA512(mnemonic, salt || INT_32_BE(1))
        string firstInStr = innerFirst;
        byte[] ih = Sha512.Hash(firstInStr, 128 + saltLen + 4);
        NativeMemory.Copy((nint)outerBuf + 128, (nint)ih, 64);
        string outStr = outerBuf;
        byte[] u = Sha512.Hash(outStr, 192);

        byte[] seed = new byte[64];
        NativeMemory.Copy((nint)seed, (nint)u, 64);

        string iterInStr = innerIter;
        for (int iter = 1; iter < 2048; iter = iter + 1) {
            NativeMemory.Copy((nint)innerIter + 128, (nint)u, 64);
            ih = Sha512.Hash(iterInStr, 192);
            NativeMemory.Copy((nint)outerBuf + 128, (nint)ih, 64);
            u = Sha512.Hash(outStr, 192);
            for (int j = 0; j < 64; j = j + 1) {
                seed[j] = (byte)((seed[j] & 255) ^ (u[j] & 255));
            }
        }
        return seed;
    }

    // 一步到位：从助记词与口令直接派生出可用的以太坊钱包账户
    public static Account AccountFromMnemonic(string mnemonic, string passphrase) {
        byte[] seed = MnemonicToSeed(mnemonic, passphrase);
        if (seed == null || seed.Length < 32) {
            return null;
        }

        // 取种子前 32 字节作为账户私钥标量
        byte[] privKey = new byte[32];
        NativeMemory.Copy((nint)privKey, (nint)seed, 32);

        return Account.FromPrivateKey(privKey);
    }
}
