using System;
using System.Security.Cryptography;
using Web3.Encoding;

namespace Web3.Types;

// 以太坊现代 EIP-1559 动态费用交易（Type-2）与离线签名序列化实体。
public class Transaction {

    public long ChainId = 1;                     // 链 ID (以太坊主网为 1，Sepolia 为 11155111 等)
    public long Nonce = 0;                       // 发送者账户交易序号
    public BigInt MaxPriorityFeePerGas;          // 矿工小费上限 (Tip Cap，Wei)
    public BigInt MaxFeePerGas;                  // 整笔交易最高 Gas 费用单价 (BaseFee + TipCap，Wei)
    public BigInt GasPrice;                      // 经典 Legacy 交易 Gas 单价 (Wei，BSC / 老链使用)
    public bool IsLegacy = false;                // 是否为 EIP-155 传统 Type-0 交易 (BSC, TRON, HECO 等强制要求)
    public long GasLimit = 21000;                // Gas 消耗上限 (标准转账为 21000)
    public Address To;                           // 目标接收方地址
    public BigInt Value;                         // 转账金额 (Wei)
    public byte[] Data;                          // 合约调用 Calldata (无则为空数组)

    public Transaction() {
        MaxPriorityFeePerGas = BigInt.FromBytesBE(new byte[1], 1);
        MaxFeePerGas = BigInt.FromBytesBE(new byte[1], 1);
        GasPrice = BigInt.FromBytesBE(new byte[1], 1);
        Value = BigInt.zero();
        Data = new byte[0];
    }

    // 辅助函数：将 BigInt 转为去除高位前导零的大端序字节（RLP 规范要求）
    private static byte[] toMinimalBytes(BigInt val) {
        if (val == null || val.isZero()) {
            return new byte[0];
        }
        int bits = val.bitLength();
        int len = (bits + 7) / 8;
        if (len <= 0) { len = 1; }
        byte[] full = val.ToBytesBE(len);
        int start = 0;
        while (start < full.Length && full[start] == 0) {
            start = start + 1;
        }
        if (start >= full.Length) { return new byte[0]; }
        int trimmedLen = full.Length - start;
        byte[] res = new byte[trimmedLen];
        for (int i = 0; i < trimmedLen; i = i + 1) {
            res[i] = full[start + i];
        }
        return res;
    }

    // 构造待签名内容 RLP 列表 (包含 9 个字段: chainId, nonce, maxPriorityFeePerGas, maxFeePerGas, gasLimit, to, value, data, accessList)
    private List<RlpItem> buildUnsignedItems() {
        List<RlpItem> items = new List<RlpItem>();

        // 1. chainId
        items.Add(RlpItem.FromLong(ChainId));

        // 2. nonce
        items.Add(RlpItem.FromLong(Nonce));

        // 3. maxPriorityFeePerGas
        items.Add(RlpItem.FromBytes(toMinimalBytes(MaxPriorityFeePerGas)));

        // 4. maxFeePerGas
        items.Add(RlpItem.FromBytes(toMinimalBytes(MaxFeePerGas)));

        // 5. gasLimit
        items.Add(RlpItem.FromLong(GasLimit));

        // 6. to
        if (To != null && !To.Equals(Address.Zero)) {
            items.Add(RlpItem.FromBytes(To.ToBytes()));
        } else {
            items.Add(RlpItem.FromBytes(new byte[0]));
        }

        // 7. value
        items.Add(RlpItem.FromBytes(toMinimalBytes(Value)));

        // 8. data
        items.Add(RlpItem.FromBytes(Data != null ? Data : new byte[0]));

        // 9. accessList (目前以太坊绝大多数普通交易为空列表)
        items.Add(RlpItem.FromList(new List<RlpItem>()));

        return items;
    }

    // 计算 EIP-1559 交易待签名的 32 字节 Keccak-256 哈希值
    public byte[] GetSigningHash() {
        List<RlpItem> items = buildUnsignedItems();
        byte[] rlpEncoded = Rlp.Encode(RlpItem.FromList(items));

        // EIP-1559 待签 payload 前置 0x02 交易类型前缀
        byte[] payload = new byte[1 + rlpEncoded.Length];
        payload[0] = 2; // Type-2
        for (int i = 0; i < rlpEncoded.Length; i = i + 1) {
            payload[1 + i] = rlpEncoded[i];
        }

        return Keccak256.Hash(payload, payload.Length);
    }

    // 计算 EIP-155 经典交易 (Type-0) 待签名的 32 字节 Keccak-256 哈希值
    // 待签结构: rlp([nonce, gasPrice, gasLimit, to, value, data, chainId, 0, 0])
    public byte[] GetLegacySigningHash() {
        List<RlpItem> items = new List<RlpItem>();
        items.Add(RlpItem.FromLong(Nonce));
        items.Add(RlpItem.FromBytes(toMinimalBytes(GasPrice)));
        items.Add(RlpItem.FromLong(GasLimit));

        if (To != null && !To.Equals(Address.Zero)) {
            items.Add(RlpItem.FromBytes(To.ToBytes()));
        } else {
            items.Add(RlpItem.FromBytes(new byte[0]));
        }

        items.Add(RlpItem.FromBytes(toMinimalBytes(Value)));
        items.Add(RlpItem.FromBytes(Data != null ? Data : new byte[0]));

        // EIP-155 防重放后缀: chainId, 0, 0
        items.Add(RlpItem.FromLong(ChainId));
        items.Add(RlpItem.FromLong(0));
        items.Add(RlpItem.FromLong(0));

        byte[] rlpEncoded = Rlp.Encode(RlpItem.FromList(items));
        return Keccak256.Hash(rlpEncoded, rlpEncoded.Length);
    }

    // 签署 EIP-155 传统交易 (Type-0，广泛用于 BSC、TRON EVM 及传统合约链)
    public string SignLegacy(byte[] privKey32) {
        if (privKey32 == null || privKey32.Length != 32) { return null; }

        byte[] signingHash = GetLegacySigningHash();
        Secp256k1Signature sig = Secp256k1.Sign(signingHash, privKey32);
        if (sig == null) { return null; }

        List<RlpItem> signedItems = new List<RlpItem>();
        signedItems.Add(RlpItem.FromLong(Nonce));
        signedItems.Add(RlpItem.FromBytes(toMinimalBytes(GasPrice)));
        signedItems.Add(RlpItem.FromLong(GasLimit));

        if (To != null && !To.Equals(Address.Zero)) {
            signedItems.Add(RlpItem.FromBytes(To.ToBytes()));
        } else {
            signedItems.Add(RlpItem.FromBytes(new byte[0]));
        }

        signedItems.Add(RlpItem.FromBytes(toMinimalBytes(Value)));
        signedItems.Add(RlpItem.FromBytes(Data != null ? Data : new byte[0]));

        // EIP-155 计算: v = chainId * 2 + 35 + recoveryId
        long vEip155 = ChainId * 2 + 35 + (long)sig.V;
        signedItems.Add(RlpItem.FromLong(vEip155));

        BigInt rVal = BigInt.FromBytesBE(sig.R, 32);
        signedItems.Add(RlpItem.FromBytes(toMinimalBytes(rVal)));

        BigInt sVal = BigInt.FromBytesBE(sig.S, 32);
        signedItems.Add(RlpItem.FromBytes(toMinimalBytes(sVal)));

        byte[] rlpEncoded = Rlp.Encode(RlpItem.FromList(signedItems));
        // Type-0 交易直接广播 RLP 字节串（不带 0x02 前缀）
        return "0x" + Hex.Encode(rlpEncoded, rlpEncoded.Length);
    }

    // 使用发送方私钥对该交易进行离线签名，生成可直接在以太坊网络广播的 Raw Transaction 十六进制字符串
    public string Sign(byte[] privKey32) {
        if (privKey32 == null || privKey32.Length != 32) { return null; }
        if (IsLegacy) {
            return SignLegacy(privKey32);
        }

        byte[] signingHash = GetSigningHash();
        Secp256k1Signature sig = Secp256k1.Sign(signingHash, privKey32);
        if (sig == null) { return null; }

        // 构造包含签名的完整 12 字段列表
        List<RlpItem> signedItems = buildUnsignedItems();

        // 10. v (EIP-1559 中直接使用 y 奇偶性 0 或 1)
        signedItems.Add(RlpItem.FromLong((long)sig.V));

        // 11. r
        BigInt rVal = BigInt.FromBytesBE(sig.R, 32);
        signedItems.Add(RlpItem.FromBytes(toMinimalBytes(rVal)));

        // 12. s
        BigInt sVal = BigInt.FromBytesBE(sig.S, 32);
        signedItems.Add(RlpItem.FromBytes(toMinimalBytes(sVal)));

        byte[] rlpEncoded = Rlp.Encode(RlpItem.FromList(signedItems));

        // 广播格式：0x02 || rlpEncoded
        byte[] rawTx = new byte[1 + rlpEncoded.Length];
        rawTx[0] = 2;
        for (int i = 0; i < rlpEncoded.Length; i = i + 1) {
            rawTx[1 + i] = rlpEncoded[i];
        }

        return "0x" + Hex.Encode(rawTx, rawTx.Length);
    }
}
