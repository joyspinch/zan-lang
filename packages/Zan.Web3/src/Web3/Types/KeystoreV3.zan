using System;
using System.Security.Cryptography;
using Web3.Types;
using Web3.Encoding;

namespace Web3.Types;

// 以太坊 Keystore V3 标准密文持久化实现 (Web3 Secret Storage Definition)
// 使用 PBKDF2-SHA256 派生密钥与 AES-128-CTR 进行私钥加密存储，并用 Keccak-256 MAC 进行防篡改校验。
public class KeystoreV3 {

    // 辅助从 JSON 文本中提取某个键的字符串值
    private static string extractJsonString(string json, string key) {
        if (json == null || key == null) { return ""; }
        string pattern = "\"" + key + "\":";
        int idx = json.IndexOf(pattern);
        if (idx < 0) { return ""; }
        int start = idx + pattern.Length;
        while (start < json.Length && (json[start] == ' ' || json[start] == '\t' || json[start] == '\r' || json[start] == '\n')) {
            start = start + 1;
        }
        if (start >= json.Length || json[start] != '\"') { return ""; }
        start = start + 1;
        int end = json.IndexOf("\"", start);
        if (end < 0) { return ""; }
        return json.Substring(start, end - start);
    }

    // 辅助从 JSON 文本中提取某个键的整数值
    private static int extractJsonInt(string json, string key, int defaultVal) {
        if (json == null || key == null) { return defaultVal; }
        string pattern = "\"" + key + "\":";
        int idx = json.IndexOf(pattern);
        if (idx < 0) { return defaultVal; }
        int start = idx + pattern.Length;
        while (start < json.Length && (json[start] == ' ' || json[start] == '\t' || json[start] == '\r' || json[start] == '\n')) {
            start = start + 1;
        }
        if (start >= json.Length) { return defaultVal; }
        int end = start;
        while (end < json.Length && json[end] >= '0' && json[end] <= '9') {
            end = end + 1;
        }
        if (end == start) { return defaultVal; }
        string numStr = json.Substring(start, end - start);
        int val = 0;
        for (int i = 0; i < numStr.Length; i = i + 1) {
            val = val * 10 + (numStr[i] - 48);
        }
        return val;
    }

    // 将账户私钥加密导出为标准以太坊 Keystore V3 JSON 字符串
    // c: PBKDF2 迭代轮数（生产环境建议 262144，测试或快速环境可使用 2048）
    public static string Encrypt(Account account, string password, int iterations) {
        if (account == null || account.PrivateKey == null || password == null) {
            return null;
        }
        int c = iterations > 0 ? iterations : 262144;

        // 1. 生成 16 字节随机 Salt 与 16 字节随机 IV
        byte[] salt = new byte[16];
        RandomNumberGenerator.Fill(salt, 16);
        string saltStr = salt;

        byte[] iv = new byte[16];
        RandomNumberGenerator.Fill(iv, 16);
        string ivStr = iv;

        // 2. PBKDF2-SHA256 派生 32 字节密钥
        string derived = Pbkdf2.Derive(password, password.Length, saltStr, 16, c, 32);
        if (derived == null || derived.Length < 32) {
            return null;
        }

        // derived[0..15] 作为 AES-128 加密密钥
        byte[] encKey = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { encKey[i] = (byte)(derived[i] & 255); }
        string encKeyStr = encKey;

        // derived[16..31] 作为 MAC 密钥
        byte[] macKey = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { macKey[i] = (byte)(derived[16 + i] & 255); }

        // 3. AES-128-CTR 加密 32 字节私钥
        string privStr = account.PrivateKey;
        byte[] ciphertext = Aes.CryptCtr(encKeyStr, 16, ivStr, privStr, 32);
        if (ciphertext == null || ciphertext.Length != 32) {
            return null;
        }

        // 4. 计算 MAC = Keccak256(macKey[16] || ciphertext[32])
        byte[] macData = new byte[48];
        for (int i = 0; i < 16; i = i + 1) { macData[i] = macKey[i]; }
        for (int i = 0; i < 32; i = i + 1) { macData[16 + i] = ciphertext[i]; }
        byte[] mac = Keccak256.Hash(macData, 48);

        // 5. 组装以太坊标准 Keystore V3 JSON
        string addrHex = account.Address.ToLowerHex();
        if (addrHex.StartsWith("0x") || addrHex.StartsWith("0X")) {
            addrHex = addrHex.Substring(2);
        }

        string saltHex = Hex.Encode(salt, 16);
        string ivHex = Hex.Encode(iv, 16);
        string cipherHex = Hex.Encode(ciphertext, 32);
        string macHex = Hex.Encode(mac, 32);

        // 假定生成伪随机 UUID 结构
        byte[] uuidRaw = new byte[16];
        RandomNumberGenerator.Fill(uuidRaw, 16);
        string uuidHex = Hex.Encode(uuidRaw, 16);
        string idStr = uuidHex.Substring(0, 8) + "-" + uuidHex.Substring(8, 4) + "-" + uuidHex.Substring(12, 4) + "-" + uuidHex.Substring(16, 4) + "-" + uuidHex.Substring(20);

        string json = "{\n" +
            "  \"version\": 3,\n" +
            "  \"id\": \"" + idStr + "\",\n" +
            "  \"address\": \"" + addrHex + "\",\n" +
            "  \"crypto\": {\n" +
            "    \"ciphertext\": \"" + cipherHex + "\",\n" +
            "    \"cipher\": \"aes-128-ctr\",\n" +
            "    \"cipherparams\": {\n" +
            "      \"iv\": \"" + ivHex + "\"\n" +
            "    },\n" +
            "    \"kdf\": \"pbkdf2\",\n" +
            "    \"kdfparams\": {\n" +
            "      \"c\": " + c.ToString() + ",\n" +
            "      \"dklen\": 32,\n" +
            "      \"prf\": \"hmac-sha256\",\n" +
            "      \"salt\": \"" + saltHex + "\"\n" +
            "    },\n" +
            "    \"mac\": \"" + macHex + "\"\n" +
            "  }\n" +
            "}";

        return json;
    }

    // 从以太坊标准 Keystore V3 JSON 中解密恢复账户钱包
    public static Account Decrypt(string json, string password) {
        if (json == null || password == null) { return null; }

        string ciphertextHex = extractJsonString(json, "ciphertext");
        string ivHex = extractJsonString(json, "iv");
        string saltHex = extractJsonString(json, "salt");
        string macHex = extractJsonString(json, "mac");
        int c = extractJsonInt(json, "c", 262144);

        if (ciphertextHex.Length != 64 || ivHex.Length != 32 || saltHex.Length == 0 || macHex.Length != 64) {
            return null;
        }

        byte[] ciphertext = Hex.Decode(ciphertextHex, 64);
        byte[] iv = Hex.Decode(ivHex, 32);
        byte[] salt = Hex.Decode(saltHex, saltHex.Length);
        byte[] expectedMac = Hex.Decode(macHex, 64);

        if (ciphertext == null || iv == null || salt == null || expectedMac == null) {
            return null;
        }

        string saltStr = salt;
        string derived = Pbkdf2.Derive(password, password.Length, saltStr, salt.Length, c, 32);
        if (derived == null || derived.Length < 32) {
            return null;
        }

        // 提取 macKey 并校验 MAC，防止密码错误或文件被篡改
        byte[] macKey = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { macKey[i] = (byte)(derived[16 + i] & 255); }

        byte[] macData = new byte[48];
        for (int i = 0; i < 16; i = i + 1) { macData[i] = macKey[i]; }
        for (int i = 0; i < 32; i = i + 1) { macData[16 + i] = ciphertext[i]; }
        byte[] computedMac = Keccak256.Hash(macData, 48);

        // 常数时间比对 MAC
        int diff = 0;
        for (int i = 0; i < 32; i = i + 1) {
            diff = diff | ((computedMac[i] & 255) ^ (expectedMac[i] & 255));
        }
        if (diff != 0) {
            // MAC 校验失败，口令错误或密文损坏
            return null;
        }

        // 解密私钥
        byte[] encKey = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { encKey[i] = (byte)(derived[i] & 255); }
        string encKeyStr = encKey;
        string ivStr = iv;
        string cipherStr = ciphertext;

        byte[] plainPriv = Aes.CryptCtr(encKeyStr, 16, ivStr, cipherStr, 32);
        if (plainPriv == null || plainPriv.Length != 32) {
            return null;
        }

        return Account.FromPrivateKey(plainPriv);
    }
}
