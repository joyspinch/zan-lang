using System;
using System.Security.Cryptography;

namespace Web3.Types;

// 以太坊货币单位换算助手（Wei, Gwei, Ether）。
public class EtherUnit {

    // 常用单位比例系数（基于 Wei）
    public static long WeiPerGwei = 1000000000L; // 10^9

    private static BigInt _weiPerEther;
    private static bool _ready = false;

    private static void init() {
        if (_ready) { return; }
        // 10^18 = 0x0DE0B6B3A7640000
        byte[] b = new byte[8];
        long val = 1000000000000000000L;
        for (int i = 0; i < 8; i = i + 1) {
            b[7 - i] = (byte)((val >> (i * 8)) & 255);
        }
        _weiPerEther = BigInt.FromBytesBE(b, 8);
        _ready = true;
    }

    public static BigInt WeiPerEther() {
        init();
        return _weiPerEther;
    }

    // 从 Gwei 构造 Wei 大整数
    public static BigInt FromGwei(long gwei) {
        if (gwei <= 0) { return BigInt.zero(); }
        long weiTotal = gwei * WeiPerGwei;
        byte[] b = new byte[8];
        for (int i = 0; i < 8; i = i + 1) {
            b[7 - i] = (byte)((weiTotal >> (i * 8)) & 255);
        }
        return BigInt.FromBytesBE(b, 8);
    }

    // 将 Wei 转为整数 Gwei（提取 64 位范围安全转换）
    public static long ToGwei(BigInt wei) {
        if (wei == null || wei.isZero()) { return 0; }
        byte[] bytes = wei.ToBytesBE(8);
        long val = 0;
        for (int i = 0; i < 8; i = i + 1) {
            val = (val << 8) | (long)(bytes[i] & 255);
        }
        return val / WeiPerGwei;
    }
}
