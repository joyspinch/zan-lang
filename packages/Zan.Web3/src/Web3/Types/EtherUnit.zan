using System;
using System.Security.Cryptography;

namespace Web3.Types;

// 以太坊货币单位换算助手（Wei, Gwei, Ether）。
public class EtherUnit {

    // 常用单位比例系数（基于 Wei）
    public static long WeiPerGwei = 1000000000L; // 10^9

    private static BigInt _weiPerEther;
    private static BigInt _weiPerGwei;
    private static bool _ready = false;
    private static string initLock = "Zan.EtherUnit.Init";

    private static BigInt FromNonNegLong(long val) {
        if (val <= 0L) { return BigInt.zero(); }
        byte[] b = new byte[8];
        for (int i = 0; i < 8; i = i + 1) {
            b[7 - i] = (byte)((val >> (i * 8)) & 255);
        }
        return BigInt.FromBytesBE(b, 8);
    }

    private static void init() {
        if (_ready) { return; }
        lock (EtherUnit.initLock) {
            if (_ready) { return; }
            _weiPerEther = FromNonNegLong(1000000000000000000L);
            _weiPerGwei = FromNonNegLong(WeiPerGwei);
            _ready = true;
        }
    }

    public static BigInt WeiPerEther() {
        init();
        return _weiPerEther;
    }

    // 从 Gwei 构造 Wei 大整数（使用 BigInt 乘法，避免 > 9.22 ETH 时 64 位有符号溢出）
    public static BigInt FromGwei(long gwei) {
        if (gwei <= 0L) { return BigInt.zero(); }
        init();
        return BigInt.mul(FromNonNegLong(gwei), _weiPerGwei);
    }

    // 将任意精度 Wei 大整数除以 10^9 转为整数 Gwei（超过 long.MaxValue 时饱和返回 long.MaxValue）
    public static long ToGwei(BigInt wei) {
        if (wei == null || wei.isZero()) { return 0L; }
        int n = wei.count();
        ulong rem = 0UL;
        ulong q = 0UL;
        for (int i = n - 1; i >= 0; i = i - 1) {
            ulong cur = (rem << 32) | (ulong)(wei.limb(i) & 4294967295L);
            ulong digit = cur / 1000000000UL;
            rem = cur % 1000000000UL;
            if (q > 2147483647UL) { return 9223372036854775807L; }
            q = (q << 32) | digit;
        }
        return (long)q;
    }
}
