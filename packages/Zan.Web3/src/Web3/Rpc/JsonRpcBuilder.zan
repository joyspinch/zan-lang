using System;
using System.Text;
using Web3.Types;

namespace Web3.Rpc;

// 以太坊标准 JSON-RPC 2.0 请求报文构造器，用于与 Geth/Erigon/Reth/Infura/Alchemy/QuickNode 等节点交互。
public class JsonRpcBuilder {

    internal static void AppendJsonString(StringBuilder sb, string s) {
        sb.Append("\"");
        if (s != null) {
            int n = s.Length;
            int seg = 0;
            for (int i = 0; i < n; i = i + 1) {
                int c = s[i] & 255;
                string esc = null;
                if (c == 34) { esc = "\\\""; }
                else if (c == 92) { esc = "\\\\"; }
                else if (c == 10) { esc = "\\n"; }
                else if (c == 13) { esc = "\\r"; }
                else if (c == 9) { esc = "\\t"; }
                else if (c == 8) { esc = "\\b"; }
                else if (c == 12) { esc = "\\f"; }
                else if (c < 32) {
                    string hx = "0123456789abcdef";
                    esc = "\\u00" + hx.Substring((c >> 4) & 15, 1) + hx.Substring(c & 15, 1);
                }
                if (esc != null) {
                    if (i > seg) { sb.Append(s.Substring(seg, i - seg)); }
                    sb.Append(esc);
                    seg = i + 1;
                }
            }
            if (n > seg) { sb.Append(s.Substring(seg, n - seg)); }
        }
        sb.Append("\"");
    }

    // 基础包装：构建标准 JSON-RPC 请求
    public static string BuildRequest(string method, string paramsJson, int id) {
        StringBuilder sb = new StringBuilder(96);
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id.ToString());
        sb.Append(",\"method\":");
        JsonRpcBuilder.AppendJsonString(sb, method);
        sb.Append(",\"params\":");
        sb.Append(paramsJson != null && paramsJson.Length > 0 ? paramsJson : "[]");
        sb.Append("}");
        return sb.ToString();
    }

    // eth_blockNumber: 获取当前最新区块号
    public static string BlockNumber(int id) {
        return BuildRequest("eth_blockNumber", "[]", id);
    }

    // eth_chainId: 获取当前网络的链 ID (例如以太坊主网为 0x1)
    public static string ChainId(int id) {
        return BuildRequest("eth_chainId", "[]", id);
    }

    // eth_gasPrice: 获取当前建议的基础 Gas 价格 (Wei)
    public static string GasPrice(int id) {
        return BuildRequest("eth_gasPrice", "[]", id);
    }

    // eth_getBalance: 查询指定账户地址的以太币余额
    public static string GetBalance(Address address, string blockTag, int id) {
        string addrHex = address != null ? address.ToLowerHex() : "0x0000000000000000000000000000000000000000";
        string tag = (blockTag != null && blockTag.Length > 0) ? blockTag : "latest";
        StringBuilder p = new StringBuilder(64);
        p.Append("[");
        JsonRpcBuilder.AppendJsonString(p, addrHex);
        p.Append(",");
        JsonRpcBuilder.AppendJsonString(p, tag);
        p.Append("]");
        return BuildRequest("eth_getBalance", p.ToString(), id);
    }

    // eth_getTransactionCount: 查询账户地址的已确认交易计数（用于构造交易的 Nonce）
    public static string GetTransactionCount(Address address, string blockTag, int id) {
        string addrHex = address != null ? address.ToLowerHex() : "0x0000000000000000000000000000000000000000";
        string tag = (blockTag != null && blockTag.Length > 0) ? blockTag : "latest";
        StringBuilder p = new StringBuilder(64);
        p.Append("[");
        JsonRpcBuilder.AppendJsonString(p, addrHex);
        p.Append(",");
        JsonRpcBuilder.AppendJsonString(p, tag);
        p.Append("]");
        return BuildRequest("eth_getTransactionCount", p.ToString(), id);
    }

    // eth_call: 无需 Gas 消耗地调用合约只读方法（例如查询 ERC-20 余额、名称、代币精度）
    public static string Call(Address to, string dataHex, string blockTag, int id) {
        string toHex = to != null ? to.ToLowerHex() : "0x0000000000000000000000000000000000000000";
        string data = (dataHex != null && dataHex.Length > 0) ? dataHex : "0x";
        if (!data.StartsWith("0x") && !data.StartsWith("0X")) {
            data = "0x" + data;
        }
        string tag = (blockTag != null && blockTag.Length > 0) ? blockTag : "latest";
        StringBuilder p = new StringBuilder(96);
        p.Append("[{\"to\":");
        JsonRpcBuilder.AppendJsonString(p, toHex);
        p.Append(",\"data\":");
        JsonRpcBuilder.AppendJsonString(p, data);
        p.Append("},");
        JsonRpcBuilder.AppendJsonString(p, tag);
        p.Append("]");
        return BuildRequest("eth_call", p.ToString(), id);
    }

    // eth_estimateGas: 预估执行交易所需要的 Gas Limit 数量
    public static string EstimateGas(Address from, Address to, string dataHex, int id) {
        return EstimateGas(from, to, dataHex, "", id);
    }

    // eth_estimateGas（可选 value 字段）
    public static string EstimateGas(Address from, Address to, string dataHex, string valueHex, int id) {
        string fromHex = from != null ? from.ToLowerHex() : "";
        string toHex = to != null ? to.ToLowerHex() : "";
        string data = (dataHex != null && dataHex.Length > 0) ? dataHex : "0x";
        if (!data.StartsWith("0x") && !data.StartsWith("0X")) {
            data = "0x" + data;
        }

        StringBuilder p = new StringBuilder(128);
        p.Append("[{");
        bool hasField = false;
        if (fromHex.Length > 0) {
            p.Append("\"from\":");
            JsonRpcBuilder.AppendJsonString(p, fromHex);
            hasField = true;
        }
        if (toHex.Length > 0) {
            if (hasField) { p.Append(","); }
            p.Append("\"to\":");
            JsonRpcBuilder.AppendJsonString(p, toHex);
            hasField = true;
        }
        if (data.Length > 0) {
            if (hasField) { p.Append(","); }
            p.Append("\"data\":");
            JsonRpcBuilder.AppendJsonString(p, data);
            hasField = true;
        }
        if (valueHex != null && valueHex.Length > 0) {
            if (hasField) { p.Append(","); }
            p.Append("\"value\":");
            JsonRpcBuilder.AppendJsonString(p, valueHex);
        }
        p.Append("}]");

        return BuildRequest("eth_estimateGas", p.ToString(), id);
    }

    // eth_sendRawTransaction: 广播已完成签名的原始交易字节串
    public static string SendRawTransaction(string rawTxHex, int id) {
        string hex = rawTxHex != null ? rawTxHex : "0x";
        if (!hex.StartsWith("0x") && !hex.StartsWith("0X")) {
            hex = "0x" + hex;
        }
        StringBuilder p = new StringBuilder(hex.Length + 8);
        p.Append("[");
        JsonRpcBuilder.AppendJsonString(p, hex);
        p.Append("]");
        return BuildRequest("eth_sendRawTransaction", p.ToString(), id);
    }

    // eth_getTransactionReceipt: 根据交易哈希查询上链执行回执与状态
    public static string GetTransactionReceipt(string txHash, int id) {
        string hash = txHash != null ? txHash : "0x";
        if (!hash.StartsWith("0x") && !hash.StartsWith("0X")) {
            hash = "0x" + hash;
        }
        StringBuilder p = new StringBuilder(hash.Length + 8);
        p.Append("[");
        JsonRpcBuilder.AppendJsonString(p, hash);
        p.Append("]");
        return BuildRequest("eth_getTransactionReceipt", p.ToString(), id);
    }
}
