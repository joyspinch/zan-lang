using System;
using System.Text;
using Web3.Types;

namespace Web3.Rpc;

// 以太坊标准 JSON-RPC 2.0 请求报文构造器，用于与 Geth/Erigon/Reth/Infura/Alchemy/QuickNode 等节点交互。
public class JsonRpcBuilder {

    internal static void AppendJsonString(StringBuilder sb, string s) {
        sb.Append("\"");
        if (s != null) {
            int n = s.Length;
            int seg = 0;
            for (int i = 0; i < n; i = i + 1) {
                int c = s[i] & 255;
                string esc = null;
                if (c == 34) { esc = "\\\""; }
                else if (c == 92) { esc = "\\\\"; }
                else if (c == 10) { esc = "\\n"; }
                else if (c == 13) { esc = "\\r"; }
                else if (c == 9) { esc = "\\t"; }
                else if (c == 8) { esc = "\\b"; }
                else if (c == 12) { esc = "\\f"; }
                else if (c < 32) {
                    string hx = "0123456789abcdef";
                    esc = "\\u00" + hx.Substring((c >> 4) & 15, 1) + hx.Substring(c & 15, 1);
                }
                if (esc != null) {
                    if (i > seg) { sb.Append(s.Substring(seg, i - seg)); }
                    sb.Append(esc);
                    seg = i + 1;
                }
            }
            if (n > seg) { sb.Append(s.Substring(seg, n - seg)); }
        }
        sb.Append("\"");
    }

    // 预分配足额空间，单缓冲直写（不传出 byte[]，消除跨 LLVM 单元 ARC 引用计数）。
    private static int WriteEscapedInto(byte[] buf, nint dst, int pos, string s, bool ensureHexPrefix) {
        int n = s != null ? s.Length : 0;
        bool add0x = ensureHexPrefix && !(n >= 2 && (s[0] & 255) == 48 && ((s[1] & 255) == 120 || (s[1] & 255) == 88));
        buf[pos] = 34;
        pos = pos + 1;
        if (add0x) {
            buf[pos] = 48;
            buf[pos + 1] = 120;
            pos = pos + 2;
        }
        if (n > 0) {
            nint sp = (nint)s;
            int seg = 0;
            for (int i = 0; i < n; i = i + 1) {
                int c = s[i] & 255;
                if (c < 32 || c == 34 || c == 92) {
                    int run = i - seg;
                    if (run > 0) {
                        NativeMemory.Copy(dst + (nint)pos, sp + (nint)seg, run);
                        pos = pos + run;
                    }
                    buf[pos] = 92;
                    if (c == 34) { buf[pos + 1] = 34; pos = pos + 2; }
                    else if (c == 92) { buf[pos + 1] = 92; pos = pos + 2; }
                    else if (c == 10) { buf[pos + 1] = 110; pos = pos + 2; }
                    else if (c == 13) { buf[pos + 1] = 114; pos = pos + 2; }
                    else if (c == 9) { buf[pos + 1] = 116; pos = pos + 2; }
                    else if (c == 8) { buf[pos + 1] = 98; pos = pos + 2; }
                    else if (c == 12) { buf[pos + 1] = 102; pos = pos + 2; }
                    else {
                        int hiN = (c >> 4) & 15;
                        int loN = c & 15;
                        buf[pos + 1] = 117;
                        buf[pos + 2] = 48;
                        buf[pos + 3] = 48;
                        buf[pos + 4] = (byte)(hiN < 10 ? 48 + hiN : 87 + hiN);
                        buf[pos + 5] = (byte)(loN < 10 ? 48 + loN : 87 + loN);
                        pos = pos + 6;
                    }
                    seg = i + 1;
                }
            }
            int tail = n - seg;
            if (tail > 0) {
                NativeMemory.Copy(dst + (nint)pos, sp + (nint)seg, tail);
                pos = pos + tail;
            }
        }
        buf[pos] = 34;
        return pos + 1;
    }

    private static int EscapedMaxLen(string s) {
        if (s == null) { return 4; }
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c < 32 || c == 34 || c == 92) { return n * 6 + 4; }
        }
        return n + 4;
    }

    // 基础包装：构建标准 JSON-RPC 请求
    public static string BuildRequest(string method, string paramsJson, int id) {
        string p = (paramsJson != null && paramsJson.Length > 0) ? paramsJson : "[]";
        int cap = 56 + JsonRpcBuilder.EscapedMaxLen(method) + p.Length;
        byte[] buf = new byte[cap];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"{\"jsonrpc\":\"2.0\",\"id\":", 22);
        int pos = 22;
        if (id == 0) { buf[pos] = 48; pos = pos + 1; }
        else {
            long x = (long)id;
            if (x < 0L) { buf[pos] = 45; pos = pos + 1; x = -x; }
            int s = pos;
            while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
            int lo = s; int hi = pos - 1;
            while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
        }
        NativeMemory.Copy(dst + (nint)pos, (nint)",\"method\":", 10); pos = pos + 10;
        pos = JsonRpcBuilder.WriteEscapedInto(buf, dst, pos, method, false);
        NativeMemory.Copy(dst + (nint)pos, (nint)",\"params\":", 10); pos = pos + 10;
        NativeMemory.Copy(dst + (nint)pos, (nint)p, p.Length); pos = pos + p.Length;
        buf[pos] = 125; pos = pos + 1;
        return NativeMemory.GetString(dst, 0, pos);
    }

    // eth_blockNumber: 获取当前最新区块号
    public static string BlockNumber(int id) {
        byte[] buf = new byte[80];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"{\"jsonrpc\":\"2.0\",\"id\":", 22);
        int pos = 22;
        if (id == 0) { buf[pos] = 48; pos = pos + 1; }
        else {
            long x = (long)id;
            if (x < 0L) { buf[pos] = 45; pos = pos + 1; x = -x; }
            int s = pos;
            while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
            int lo = s; int hi = pos - 1;
            while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
        }
        NativeMemory.Copy(dst + (nint)pos, (nint)",\"method\":\"eth_blockNumber\",\"params\":[]}", 40);
        return NativeMemory.GetString(dst, 0, pos + 40);
    }

    // eth_chainId: 获取当前网络的链 ID
    public static string ChainId(int id) {
        byte[] buf = new byte[76];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"{\"jsonrpc\":\"2.0\",\"id\":", 22);
        int pos = 22;
        if (id == 0) { buf[pos] = 48; pos = pos + 1; }
        else {
            long x = (long)id;
            if (x < 0L) { buf[pos] = 45; pos = pos + 1; x = -x; }
            int s = pos;
            while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
            int lo = s; int hi = pos - 1;
            while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
        }
        NativeMemory.Copy(dst + (nint)pos, (nint)",\"method\":\"eth_chainId\",\"params\":[]}", 36);
        return NativeMemory.GetString(dst, 0, pos + 36);
    }

    // eth_gasPrice: 获取当前建议的基础 Gas 价格 (Wei)
    public static string GasPrice(int id) {
        byte[] buf = new byte[76];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"{\"jsonrpc\":\"2.0\",\"id\":", 22);
        int pos = 22;
        if (id == 0) { buf[pos] = 48; pos = pos + 1; }
        else {
            long x = (long)id;
            if (x < 0L) { buf[pos] = 45; pos = pos + 1; x = -x; }
            int s = pos;
            while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
            int lo = s; int hi = pos - 1;
            while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
        }
        NativeMemory.Copy(dst + (nint)pos, (nint)",\"method\":\"eth_gasPrice\",\"params\":[]}", 37);
        return NativeMemory.GetString(dst, 0, pos + 37);
    }

    // eth_getBalance: 查询指定账户地址的以太币余额
    public static string GetBalance(Address address, string blockTag, int id) {
        string addrHex = address != null ? address.ToLowerHex() : "0x0000000000000000000000000000000000000000";
        string tag = (blockTag != null && blockTag.Length > 0) ? blockTag : "latest";
        int cap = 128 + JsonRpcBuilder.EscapedMaxLen(tag);
        byte[] buf = new byte[cap];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"{\"jsonrpc\":\"2.0\",\"id\":", 22);
        int pos = 22;
        if (id == 0) { buf[pos] = 48; pos = pos + 1; }
        else {
            long x = (long)id;
            if (x < 0L) { buf[pos] = 45; pos = pos + 1; x = -x; }
            int s = pos;
            while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
            int lo = s; int hi = pos - 1;
            while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
        }
        NativeMemory.Copy(dst + (nint)pos, (nint)",\"method\":\"eth_getBalance\",\"params\":[\"", 38); pos = pos + 38;
        NativeMemory.Copy(dst + (nint)pos, (nint)addrHex, addrHex.Length); pos = pos + addrHex.Length;
        buf[pos] = 34; buf[pos + 1] = 44; pos = pos + 2;
        pos = JsonRpcBuilder.WriteEscapedInto(buf, dst, pos, tag, false);
        buf[pos] = 93; buf[pos + 1] = 125; pos = pos + 2;
        return NativeMemory.GetString(dst, 0, pos);
    }

    // eth_getTransactionCount: 查询账户地址的已确认交易计数
    public static string GetTransactionCount(Address address, string blockTag, int id) {
        string addrHex = address != null ? address.ToLowerHex() : "0x0000000000000000000000000000000000000000";
        string tag = (blockTag != null && blockTag.Length > 0) ? blockTag : "latest";
        int cap = 144 + JsonRpcBuilder.EscapedMaxLen(tag);
        byte[] buf = new byte[cap];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"{\"jsonrpc\":\"2.0\",\"id\":", 22);
        int pos = 22;
        if (id == 0) { buf[pos] = 48; pos = pos + 1; }
        else {
            long x = (long)id;
            if (x < 0L) { buf[pos] = 45; pos = pos + 1; x = -x; }
            int s = pos;
            while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
            int lo = s; int hi = pos - 1;
            while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
        }
        NativeMemory.Copy(dst + (nint)pos, (nint)",\"method\":\"eth_getTransactionCount\",\"params\":[\"", 47); pos = pos + 47;
        NativeMemory.Copy(dst + (nint)pos, (nint)addrHex, addrHex.Length); pos = pos + addrHex.Length;
        buf[pos] = 34; buf[pos + 1] = 44; pos = pos + 2;
        pos = JsonRpcBuilder.WriteEscapedInto(buf, dst, pos, tag, false);
        buf[pos] = 93; buf[pos + 1] = 125; pos = pos + 2;
        return NativeMemory.GetString(dst, 0, pos);
    }

    // eth_call: 无需 Gas 消耗地调用合约只读方法
    public static string Call(Address to, string dataHex, string blockTag, int id) {
        string toHex = to != null ? to.ToLowerHex() : "0x0000000000000000000000000000000000000000";
        string data = (dataHex != null && dataHex.Length > 0) ? dataHex : "0x";
        string tag = (blockTag != null && blockTag.Length > 0) ? blockTag : "latest";
        int cap = 160 + JsonRpcBuilder.EscapedMaxLen(data) + JsonRpcBuilder.EscapedMaxLen(tag);
        byte[] buf = new byte[cap];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"{\"jsonrpc\":\"2.0\",\"id\":", 22);
        int pos = 22;
        if (id == 0) { buf[pos] = 48; pos = pos + 1; }
        else {
            long x = (long)id;
            if (x < 0L) { buf[pos] = 45; pos = pos + 1; x = -x; }
            int s = pos;
            while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
            int lo = s; int hi = pos - 1;
            while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
        }
        NativeMemory.Copy(dst + (nint)pos, (nint)",\"method\":\"eth_call\",\"params\":[{\"to\":\"", 38); pos = pos + 38;
        NativeMemory.Copy(dst + (nint)pos, (nint)toHex, toHex.Length); pos = pos + toHex.Length;
        NativeMemory.Copy(dst + (nint)pos, (nint)"\",\"data\":", 9); pos = pos + 9;
        pos = JsonRpcBuilder.WriteEscapedInto(buf, dst, pos, data, true);
        buf[pos] = 125; buf[pos + 1] = 44; pos = pos + 2;
        pos = JsonRpcBuilder.WriteEscapedInto(buf, dst, pos, tag, false);
        buf[pos] = 93; buf[pos + 1] = 125; pos = pos + 2;
        return NativeMemory.GetString(dst, 0, pos);
    }

    public static string EstimateGas(Address from, Address to, string dataHex, int id) {
        return EstimateGas(from, to, dataHex, "", id);
    }

    public static string EstimateGas(Address from, Address to, string dataHex, string valueHex, int id) {
        string fromHex = from != null ? from.ToLowerHex() : "";
        string toHex = to != null ? to.ToLowerHex() : "";
        string data = (dataHex != null && dataHex.Length > 0) ? dataHex : "0x";
        int vLen = valueHex != null ? valueHex.Length : 0;
        int cap = 224 + JsonRpcBuilder.EscapedMaxLen(data) + (vLen > 0 ? JsonRpcBuilder.EscapedMaxLen(valueHex) : 0);
        byte[] buf = new byte[cap];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"{\"jsonrpc\":\"2.0\",\"id\":", 22);
        int pos = 22;
        if (id == 0) { buf[pos] = 48; pos = pos + 1; }
        else {
            long x = (long)id;
            if (x < 0L) { buf[pos] = 45; pos = pos + 1; x = -x; }
            int s = pos;
            while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
            int lo = s; int hi = pos - 1;
            while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
        }
        NativeMemory.Copy(dst + (nint)pos, (nint)",\"method\":\"eth_estimateGas\",\"params\":[{", 39); pos = pos + 39;
        bool hasField = false;
        if (fromHex.Length > 0) {
            NativeMemory.Copy(dst + (nint)pos, (nint)"\"from\":\"", 8); pos = pos + 8;
            NativeMemory.Copy(dst + (nint)pos, (nint)fromHex, fromHex.Length); pos = pos + fromHex.Length;
            buf[pos] = 34; pos = pos + 1;
            hasField = true;
        }
        if (toHex.Length > 0) {
            if (hasField) { buf[pos] = 44; pos = pos + 1; }
            NativeMemory.Copy(dst + (nint)pos, (nint)"\"to\":\"", 6); pos = pos + 6;
            NativeMemory.Copy(dst + (nint)pos, (nint)toHex, toHex.Length); pos = pos + toHex.Length;
            buf[pos] = 34; pos = pos + 1;
            hasField = true;
        }
        if (data.Length > 0) {
            if (hasField) { buf[pos] = 44; pos = pos + 1; }
            NativeMemory.Copy(dst + (nint)pos, (nint)"\"data\":", 7); pos = pos + 7;
            pos = JsonRpcBuilder.WriteEscapedInto(buf, dst, pos, data, true);
            hasField = true;
        }
        if (vLen > 0) {
            if (hasField) { buf[pos] = 44; pos = pos + 1; }
            NativeMemory.Copy(dst + (nint)pos, (nint)"\"value\":", 8); pos = pos + 8;
            pos = JsonRpcBuilder.WriteEscapedInto(buf, dst, pos, valueHex, false);
        }
        buf[pos] = 125; buf[pos + 1] = 93; buf[pos + 2] = 125; pos = pos + 3;
        return NativeMemory.GetString(dst, 0, pos);
    }

    public static string SendRawTransaction(string rawTxHex, int id) {
        string hex = rawTxHex != null ? rawTxHex : "0x";
        int cap = 96 + JsonRpcBuilder.EscapedMaxLen(hex);
        byte[] buf = new byte[cap];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"{\"jsonrpc\":\"2.0\",\"id\":", 22);
        int pos = 22;
        if (id == 0) { buf[pos] = 48; pos = pos + 1; }
        else {
            long x = (long)id;
            if (x < 0L) { buf[pos] = 45; pos = pos + 1; x = -x; }
            int s = pos;
            while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
            int lo = s; int hi = pos - 1;
            while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
        }
        NativeMemory.Copy(dst + (nint)pos, (nint)",\"method\":\"eth_sendRawTransaction\",\"params\":[", 45); pos = pos + 45;
        pos = JsonRpcBuilder.WriteEscapedInto(buf, dst, pos, hex, true);
        buf[pos] = 93; buf[pos + 1] = 125; pos = pos + 2;
        return NativeMemory.GetString(dst, 0, pos);
    }

    public static string GetTransactionReceipt(string txHash, int id) {
        string hash = txHash != null ? txHash : "0x";
        int cap = 104 + JsonRpcBuilder.EscapedMaxLen(hash);
        byte[] buf = new byte[cap];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"{\"jsonrpc\":\"2.0\",\"id\":", 22);
        int pos = 22;
        if (id == 0) { buf[pos] = 48; pos = pos + 1; }
        else {
            long x = (long)id;
            if (x < 0L) { buf[pos] = 45; pos = pos + 1; x = -x; }
            int s = pos;
            while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
            int lo = s; int hi = pos - 1;
            while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
        }
        NativeMemory.Copy(dst + (nint)pos, (nint)",\"method\":\"eth_getTransactionReceipt\",\"params\":[", 48); pos = pos + 48;
        pos = JsonRpcBuilder.WriteEscapedInto(buf, dst, pos, hash, true);
        buf[pos] = 93; buf[pos + 1] = 125; pos = pos + 2;
        return NativeMemory.GetString(dst, 0, pos);
    }
}
