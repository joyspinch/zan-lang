using System;
using Web3.Types;

namespace Web3.Rpc;

// 以太坊标准 JSON-RPC 2.0 请求报文构造器，用于与 Geth/Erigon/Reth/Infura/Alchemy/QuickNode 等节点交互。
public class JsonRpcBuilder {

    // 基础包装：构建标准 JSON-RPC 请求
    public static string BuildRequest(string method, string paramsJson, int id) {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id.ToString() + ",\"method\":\"" + method + "\",\"params\":" + paramsJson + "}";
    }

    // eth_blockNumber: 获取当前最新区块号
    public static string BlockNumber(int id) {
        return BuildRequest("eth_blockNumber", "[]", id);
    }

    // eth_chainId: 获取当前网络的链 ID (例如以太坊主网为 0x1)
    public static string ChainId(int id) {
        return BuildRequest("eth_chainId", "[]", id);
    }

    // eth_gasPrice: 获取当前建议的基础 Gas 价格 (Wei)
    public static string GasPrice(int id) {
        return BuildRequest("eth_gasPrice", "[]", id);
    }

    // eth_getBalance: 查询指定账户地址的以太币余额
    public static string GetBalance(Address address, string blockTag, int id) {
        string addrHex = address != null ? address.ToLowerHex() : "0x0000000000000000000000000000000000000000";
        string tag = (blockTag != null && blockTag.Length > 0) ? blockTag : "latest";
        return BuildRequest("eth_getBalance", "[\"" + addrHex + "\",\"" + tag + "\"]", id);
    }

    // eth_getTransactionCount: 查询账户地址的已确认交易计数（用于构造交易的 Nonce）
    public static string GetTransactionCount(Address address, string blockTag, int id) {
        string addrHex = address != null ? address.ToLowerHex() : "0x0000000000000000000000000000000000000000";
        string tag = (blockTag != null && blockTag.Length > 0) ? blockTag : "latest";
        return BuildRequest("eth_getTransactionCount", "[\"" + addrHex + "\",\"" + tag + "\"]", id);
    }

    // eth_call: 无需 Gas 消耗地调用合约只读方法（例如查询 ERC-20 余额、名称、代币精度）
    public static string Call(Address to, string dataHex, string blockTag, int id) {
        string toHex = to != null ? to.ToLowerHex() : "0x0000000000000000000000000000000000000000";
        string data = (dataHex != null && dataHex.Length > 0) ? dataHex : "0x";
        if (!data.StartsWith("0x") && !data.StartsWith("0X")) {
            data = "0x" + data;
        }
        string tag = (blockTag != null && blockTag.Length > 0) ? blockTag : "latest";
        string callObj = "{\"to\":\"" + toHex + "\",\"data\":\"" + data + "\"}";
        return BuildRequest("eth_call", "[" + callObj + ",\"" + tag + "\"]", id);
    }

    // eth_estimateGas: 预估执行交易所需要的 Gas Limit 数量
    public static string EstimateGas(Address from, Address to, string dataHex, int id) {
        string fromHex = from != null ? from.ToLowerHex() : "";
        string toHex = to != null ? to.ToLowerHex() : "";
        string data = (dataHex != null && dataHex.Length > 0) ? dataHex : "0x";
        if (!data.StartsWith("0x") && !data.StartsWith("0X")) {
            data = "0x" + data;
        }

        string txObj = "{";
        bool hasField = false;
        if (fromHex.Length > 0) {
            txObj = txObj + "\"from\":\"" + fromHex + "\"";
            hasField = true;
        }
        if (toHex.Length > 0) {
            if (hasField) { txObj = txObj + ","; }
            txObj = txObj + "\"to\":\"" + toHex + "\"";
            hasField = true;
        }
        if (data.Length > 0) {
            if (hasField) { txObj = txObj + ","; }
            txObj = txObj + "\"data\":\"" + data + "\"";
        }
        txObj = txObj + "}";

        return BuildRequest("eth_estimateGas", "[" + txObj + "]", id);
    }

    // eth_sendRawTransaction: 广播已完成签名的原始交易字节串
    public static string SendRawTransaction(string rawTxHex, int id) {
        string hex = rawTxHex != null ? rawTxHex : "0x";
        if (!hex.StartsWith("0x") && !hex.StartsWith("0X")) {
            hex = "0x" + hex;
        }
        return BuildRequest("eth_sendRawTransaction", "[\"" + hex + "\"]", id);
    }

    // eth_getTransactionReceipt: 根据交易哈希查询上链执行回执与状态
    public static string GetTransactionReceipt(string txHash, int id) {
        string hash = txHash != null ? txHash : "0x";
        if (!hash.StartsWith("0x") && !hash.StartsWith("0X")) {
            hash = "0x" + hash;
        }
        return BuildRequest("eth_getTransactionReceipt", "[\"" + hash + "\"]", id);
    }
}
