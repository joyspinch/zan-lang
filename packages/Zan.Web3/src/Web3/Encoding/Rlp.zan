using System;
using System.Security.Cryptography;

namespace Web3.Encoding;

// RLP 元素类型枚举：原始字节串或子项列表
public enum RlpType {
    Bytes,
    List
}

// RLP 结构化项，可表示单个字节串或嵌套列表
public class RlpItem {
    private static byte[] s_emptyBytes;
    private static string emptyLock = "Zan.RlpItem.Empty";

    private static byte[] EmptyBytes() {
        if (RlpItem.s_emptyBytes != null) { return RlpItem.s_emptyBytes; }
        lock (RlpItem.emptyLock) {
            if (RlpItem.s_emptyBytes == null) {
                RlpItem.s_emptyBytes = new byte[0];
            }
            return RlpItem.s_emptyBytes;
        }
    }

    public RlpType Type;
    public byte[] RawBytes;
    public List<RlpItem> Items;

    public RlpItem(byte[] bytes) {
        Type = RlpType.Bytes;
        RawBytes = bytes;
        Items = new List<RlpItem>();
    }

    public RlpItem(List<RlpItem> list) {
        Type = RlpType.List;
        RawBytes = RlpItem.EmptyBytes();
        Items = list != null ? list : new List<RlpItem>();
    }

    public static RlpItem FromBytes(byte[] bytes) {
        return new RlpItem(bytes);
    }

    public static RlpItem FromString(string text) {
        if (text == null) { return new RlpItem(RlpItem.EmptyBytes()); }
        return new RlpItem(text.ToBytes());
    }

    public static RlpItem FromLong(long value) {
        if (value == 0) {
            return new RlpItem(RlpItem.EmptyBytes());
        }
        ulong u = (ulong)value;
        int len = 1;
        ulong t = u >> 8;
        while (t != 0UL) {
            len = len + 1;
            t = t >> 8;
        }
        byte[] b = new byte[len];
        for (int i = len - 1; i >= 0; i = i - 1) {
            b[i] = (byte)(u & 255UL);
            u = u >> 8;
        }
        return new RlpItem(b);
    }

    public static RlpItem FromList(List<RlpItem> list) {
        return new RlpItem(list);
    }
}

// 内部前序度量表：单遍 O(N) 记录每个 List 节点的 payloadLen，写阶段直传 int[] lens
// 零字段 ARC 负载顺序消费，精确一次分配输出 byte[total]，无扩容拷贝与二次遍历。
internal class RlpSizePlan {
    internal int[] lens;
    internal int count;
    internal int readPos;

    internal RlpSizePlan() {
        this.lens = new int[32];
        this.count = 0;
        this.readPos = 0;
    }

    internal int AllocSlot() {
        int slot = this.count;
        int[] cur = this.lens;
        if (slot >= cur.Length) {
            int[] grown = new int[cur.Length * 2];
            NativeMemory.Copy((nint)grown, (nint)cur, slot * 4);
            this.lens = grown;
        }
        this.count = slot + 1;
        return slot;
    }
}

// 以太坊黄皮书标准的 RLP (Recursive Length Prefix) 编解码器。
public class Rlp {

    private static int BigEndianLenSize(int length) {
        if (length <= 0xFF) { return 1; }
        if (length <= 0xFFFF) { return 2; }
        if (length <= 0xFFFFFF) { return 3; }
        return 4;
    }

    private static int WriteBigEndianLen(byte[] dst, int pos, int length, int lenOfLen) {
        for (int i = lenOfLen - 1; i >= 0; i = i - 1) {
            dst[pos + i] = (byte)(length & 255);
            length = length >> 8;
        }
        return pos + lenOfLen;
    }

    private static int MeasureList(RlpItem listItem, RlpSizePlan plan, int depth) {
        if (depth > 128) { throw new ArgumentException("Rlp.Encode: nesting depth exceeds limit"); }
        int slot = plan.AllocSlot();
        long payloadLen = 0L;
        List<RlpItem> items = listItem.Items;
        if (items != null) {
            int cnt = items.Count;
            for (int i = 0; i < cnt; i = i + 1) {
                RlpItem child = items[i];
                if (child == null) {
                    payloadLen = payloadLen + 1L;
                } else if (child.Type == RlpType.Bytes) {
                    byte[] b = child.RawBytes;
                    if (b == null || b.Length == 0) {
                        payloadLen = payloadLen + 1L;
                    } else {
                        int blen = b.Length;
                        if (blen == 1 && (b[0] & 255) <= 0x7f) {
                            payloadLen = payloadLen + 1L;
                        } else if (blen <= 55) {
                            payloadLen = payloadLen + 1L + (long)blen;
                        } else {
                            payloadLen = payloadLen + 1L + (long)BigEndianLenSize(blen) + (long)blen;
                        }
                    }
                } else {
                    payloadLen = payloadLen + (long)MeasureList(child, plan, depth + 1);
                }
                if (payloadLen > 2147483640L) {
                    throw new ArgumentException("Rlp.Encode: encoded payload exceeds 2 GiB limit");
                }
            }
        }
        int pLen = (int)payloadLen;
        plan.lens[slot] = pLen;
        long total = pLen <= 55 ? (1L + payloadLen) : (1L + (long)BigEndianLenSize(pLen) + payloadLen);
        if (total > 2147483647L) {
            throw new ArgumentException("Rlp.Encode: encoded size exceeds 2 GiB limit");
        }
        return (int)total;
    }

    private static int WriteList(RlpItem listItem, byte[] dst, nint dstPtr, int pos, int[] lens, RlpSizePlan plan) {
        int payloadLen = lens[plan.readPos];
        plan.readPos = plan.readPos + 1;
        if (payloadLen <= 55) {
            dst[pos] = (byte)(0xc0 + payloadLen);
            pos = pos + 1;
        } else {
            int lol = BigEndianLenSize(payloadLen);
            dst[pos] = (byte)(0xf7 + lol);
            pos = WriteBigEndianLen(dst, pos + 1, payloadLen, lol);
        }
        List<RlpItem> items = listItem.Items;
        int cnt = items != null ? items.Count : 0;
        for (int i = 0; i < cnt; i = i + 1) {
            RlpItem child = items[i];
            if (child == null) {
                dst[pos] = 0x80;
                pos = pos + 1;
            } else if (child.Type == RlpType.Bytes) {
                byte[] b = child.RawBytes;
                if (b == null || b.Length == 0) {
                    dst[pos] = 0x80;
                    pos = pos + 1;
                } else {
                    int blen = b.Length;
                    if (blen == 1 && (b[0] & 255) <= 0x7f) {
                        dst[pos] = b[0];
                        pos = pos + 1;
                    } else {
                        if (blen <= 55) {
                            dst[pos] = (byte)(0x80 + blen);
                            pos = pos + 1;
                        } else {
                            int lol = BigEndianLenSize(blen);
                            dst[pos] = (byte)(0xb7 + lol);
                            pos = WriteBigEndianLen(dst, pos + 1, blen, lol);
                        }
                        if (blen >= 16) {
                            NativeMemory.Copy(dstPtr + (nint)pos, (nint)b, blen);
                        } else {
                            for (int k = 0; k < blen; k = k + 1) { dst[pos + k] = b[k]; }
                        }
                        pos = pos + blen;
                    }
                }
            } else {
                pos = WriteList(child, dst, dstPtr, pos, lens, plan);
            }
        }
        return pos;
    }

    // 编码原始字节串
    public static byte[] EncodeBytes(byte[] bytes) {
        if (bytes == null || bytes.Length == 0) {
            byte[] empty = new byte[1];
            empty[0] = 0x80;
            return empty;
        }
        int blen = bytes.Length;
        if (blen == 1 && (bytes[0] & 255) <= 0x7f) {
            byte[] single = new byte[1];
            single[0] = bytes[0];
            return single;
        }
        if (blen <= 55) {
            byte[] res = new byte[1 + blen];
            res[0] = (byte)(0x80 + blen);
            if (blen >= 16) {
                NativeMemory.Copy((nint)res + 1, (nint)bytes, blen);
            } else {
                for (int i = 0; i < blen; i = i + 1) { res[1 + i] = bytes[i]; }
            }
            return res;
        }
        int lol = BigEndianLenSize(blen);
        if ((long)blen > 2147483647L - 1L - (long)lol) {
            throw new ArgumentException("Rlp.EncodeBytes: input exceeds 2 GiB limit");
        }
        byte[] outb = new byte[1 + lol + blen];
        outb[0] = (byte)(0xb7 + lol);
        int offset = WriteBigEndianLen(outb, 1, blen, lol);
        NativeMemory.Copy((nint)outb + offset, (nint)bytes, blen);
        return outb;
    }

    // 编码字符串
    public static byte[] EncodeString(string text) {
        if (text == null) { return EncodeBytes(new byte[0]); }
        return EncodeBytes(text.ToBytes());
    }

    // 编码已经序列化的子项列表
    public static byte[] EncodeListRaw(List<byte[]> encodedItems) {
        long totalPayloadLenL = 0L;
        int cnt = encodedItems != null ? encodedItems.Count : 0;
        for (int i = 0; i < cnt; i = i + 1) {
            byte[] it = encodedItems[i];
            totalPayloadLenL = totalPayloadLenL + (it != null ? (long)it.Length : 1L);
            if (totalPayloadLenL > 2147483640L) {
                throw new ArgumentException("Rlp.EncodeListRaw: encoded payload exceeds 2 GiB limit");
            }
        }
        int totalPayloadLen = (int)totalPayloadLenL;
        byte[] outb;
        int offset;
        if (totalPayloadLen <= 55) {
            outb = new byte[1 + totalPayloadLen];
            outb[0] = (byte)(0xc0 + totalPayloadLen);
            offset = 1;
        } else {
            int lol = BigEndianLenSize(totalPayloadLen);
            outb = new byte[1 + lol + totalPayloadLen];
            outb[0] = (byte)(0xf7 + lol);
            offset = WriteBigEndianLen(outb, 1, totalPayloadLen, lol);
        }
        for (int i = 0; i < cnt; i = i + 1) {
            byte[] item = encodedItems[i];
            if (item == null) {
                outb[offset] = 0x80;
                offset = offset + 1;
                continue;
            }
            int ilen = item.Length;
            if (ilen >= 16) {
                NativeMemory.Copy((nint)outb + offset, (nint)item, ilen);
            } else {
                for (int j = 0; j < ilen; j = j + 1) { outb[offset + j] = item[j]; }
            }
            offset = offset + ilen;
        }
        return outb;
    }

    // 递归编码 RlpItem 结构（严格 O(N) 单遍前序度量 + 精确一次输出分配 + 零子数组分配）
    public static byte[] Encode(RlpItem item) {
        if (item == null || item.Type == RlpType.Bytes) {
            return EncodeBytes(item != null ? item.RawBytes : null);
        }
        RlpSizePlan plan = new RlpSizePlan();
        int total = MeasureList(item, plan, 0);
        byte[] outb = new byte[total];
        WriteList(item, outb, (nint)outb, 0, plan.lens, plan);
        return outb;
    }
}
