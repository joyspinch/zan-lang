using System;
using System.Security.Cryptography;
using Web3.Types;

namespace Web3.Encoding;

// 以太坊智能合约 ABI (Application Binary Interface) 编解码器与函数调用构造工具。
public class Abi {

    // 计算标准函数签名的 4 字节函数选择器（如 "transfer(address,uint256)" -> [0xa9, 0x05, 0x9c, 0xbb]）
    public static byte[] GetFunctionSelector(string signature) {
        if (signature == null) { return new byte[4]; }
        byte[] hash = Keccak256.Hash(signature);
        byte[] sel = new byte[4];
        for (int i = 0; i < 4; i = i + 1) {
            sel[i] = hash[i];
        }
        return sel;
    }

    // 计算并返回函数选择器的 8 位小写十六进制字符串（如 "a9059cbb"）
    public static string GetFunctionSelectorHex(string signature) {
        byte[] sel = GetFunctionSelector(signature);
        return Hex.Encode(sel, 4);
    }

    // 将 20 字节以太坊地址填充为 32 字节 ABI 槽位（高位补 12 个 0x00）
    public static byte[] EncodeAddress(Address addr) {
        byte[] slot = new byte[32];
        if (addr != null) {
            byte[] b = addr.ToBytes();
            NativeMemory.Copy((nint)slot + 12, (nint)b, 20);
        }
        return slot;
    }

    // 将布尔值编码为 32 字节 ABI 槽位
    public static byte[] EncodeBool(bool val) {
        byte[] slot = new byte[32];
        slot[31] = (byte)(val ? 1 : 0);
        return slot;
    }

    // 将 long 整数编码为 32 字节大端序无符号整数（高位补零）
    public static byte[] EncodeUint256(long val) {
        byte[] slot = new byte[32];
        slot[24] = (byte)((val >> 56) & 255);
        slot[25] = (byte)((val >> 48) & 255);
        slot[26] = (byte)((val >> 40) & 255);
        slot[27] = (byte)((val >> 32) & 255);
        slot[28] = (byte)((val >> 24) & 255);
        slot[29] = (byte)((val >> 16) & 255);
        slot[30] = (byte)((val >> 8) & 255);
        slot[31] = (byte)(val & 255);
        return slot;
    }

    // 将 BigInt 大整数编码为 32 字节大端序槽位
    public static byte[] EncodeUint256(BigInt val) {
        if (val == null) { return new byte[32]; }
        byte[] be = val.ToBytesBE(32);
        if (be == null || be.Length == 0) { return new byte[32]; }
        if (be.Length == 32) { return be; }
        byte[] slot = new byte[32];
        if (be.Length < 32) {
            NativeMemory.Copy((nint)slot + (nint)(32 - be.Length), (nint)be, be.Length);
        } else {
            NativeMemory.Copy((nint)slot, (nint)be + (nint)(be.Length - 32), 32);
        }
        return slot;
    }

    // 快速构造 ERC-20 transfer(address,uint256) 的 68 字节 calldata（常量选择器 0xa9059cbb，零重复 Keccak）
    public static byte[] EncodeErc20Transfer(Address recipient, BigInt amount) {
        byte[] calldata = new byte[68];
        calldata[0] = 0xa9;
        calldata[1] = 0x05;
        calldata[2] = 0x9c;
        calldata[3] = 0xbb;
        if (recipient != null) {
            byte[] rb = recipient.ToBytes();
            NativeMemory.Copy((nint)calldata + 16, (nint)rb, 20);
        }
        if (amount != null) {
            byte[] ab = amount.ToBytesBE(32);
            NativeMemory.Copy((nint)calldata + 36, (nint)ab, 32);
        }
        return calldata;
    }

    // 快速构造 ERC-20 balanceOf(address) 的 36 字节 calldata（常量选择器 0x70a08231，零重复 Keccak）
    public static byte[] EncodeErc20BalanceOf(Address owner) {
        byte[] calldata = new byte[36];
        calldata[0] = 0x70;
        calldata[1] = 0xa0;
        calldata[2] = 0x82;
        calldata[3] = 0x31;
        if (owner != null) {
            byte[] ob = owner.ToBytes();
            NativeMemory.Copy((nint)calldata + 16, (nint)ob, 20);
        }
        return calldata;
    }

    // 辅助解析输入十六进制字符串为字节数组
    private static byte[] cleanHexToBytes(string hex) {
        if (hex == null) { return new byte[0]; }
        string clean = hex.Trim();
        if (clean.StartsWith("0x") || clean.StartsWith("0X")) {
            clean = clean.Substring(2);
        }
        if (clean.Length == 0 || (clean.Length % 2) != 0) {
            return new byte[0];
        }
        return Hex.Decode(clean, clean.Length);
    }

    // 从 32 字节槽位解码 uint256 大整数
    public static BigInt DecodeUint256(byte[] data, int offset) {
        if (data == null || offset < 0 || offset > data.Length - 32) {
            return BigInt.zero();
        }
        if (offset == 0 && data.Length == 32) {
            return BigInt.FromBytesBE(data, 32);
        }
        byte[] slot = new byte[32];
        NativeMemory.Copy((nint)slot, (nint)data + offset, 32);
        return BigInt.FromBytesBE(slot, 32);
    }

    public static BigInt DecodeUint256(string hex) {
        return DecodeUint256(cleanHexToBytes(hex), 0);
    }

    // 从 32 字节槽位解码以太坊地址（取低 20 字节）
    public static Address DecodeAddress(byte[] data, int offset) {
        if (data == null || offset < 0 || offset > data.Length - 32) {
            return Address.Zero;
        }
        byte[] raw = new byte[20];
        NativeMemory.Copy((nint)raw, (nint)data + offset + 12, 20);
        return new Address(raw);
    }

    public static Address DecodeAddress(string hex) {
        return DecodeAddress(cleanHexToBytes(hex), 0);
    }

    // 从 32 字节槽位解码布尔值
    public static bool DecodeBool(byte[] data, int offset) {
        if (data == null || offset < 0 || offset > data.Length - 32) {
            return false;
        }
        return data[offset + 31] != 0;
    }

    public static bool DecodeBool(string hex) {
        return DecodeBool(cleanHexToBytes(hex), 0);
    }

    // 解码 Solidity 动态字符串（ABI 规范: 头部槽位中的偏移量相对于所在元组起点 tupleBase）。
    public static string DecodeString(byte[] data, int offset) {
        return DecodeString(data, offset, 0);
    }

    public static string DecodeString(byte[] data, int offset, int tupleBase) {
        if (data == null || tupleBase < 0 || offset < tupleBase || offset > data.Length - 32) {
            return "";
        }
        // 校验高 28 字节为 0，并用 64 位读取相对偏移量防符号溢出与负偏移
        for (int i = 0; i < 28; i = i + 1) {
            if (data[offset + i] != 0) { return ""; }
        }
        long relOffset = 0L;
        for (int i = 0; i < 4; i = i + 1) {
            relOffset = (relOffset << 8) | (long)(data[offset + 28 + i] & 255);
        }
        long maxLenSlot = (long)data.Length - 32L;
        if (relOffset < 0L || relOffset > maxLenSlot - (long)tupleBase) {
            return "";
        }
        int lenSlotOffset = tupleBase + (int)relOffset;

        // 校验高 28 字节为 0 并读取字符串字节长度
        for (int i = 0; i < 28; i = i + 1) {
            if (data[lenSlotOffset + i] != 0) { return ""; }
        }
        long strLenL = 0L;
        for (int i = 0; i < 4; i = i + 1) {
            strLenL = (strLenL << 8) | (long)(data[lenSlotOffset + 28 + i] & 255);
        }
        long avail = (long)data.Length - (long)lenSlotOffset - 32L;
        if (strLenL <= 0L || strLenL > avail) {
            return "";
        }
        int strLen = (int)strLenL;

        // 截取字符串实际字节
        byte[] strBytes = new byte[strLen];
        NativeMemory.Copy((nint)strBytes, (nint)data + (nint)(lenSlotOffset + 32), strLen);
        return strBytes;
    }

    public static string DecodeString(string hex) {
        return DecodeString(cleanHexToBytes(hex), 0);
    }
}
