using System;
using System.Security.Cryptography;
using Zan.Web3.Types;
using Zan.Web3.Encoding;
using Zan.Web3.Rpc;

namespace Zan.Web3.Contracts;

// ERC-20 工业级标准同质化代币强类型智能合约包装类 (ERC-20 Token Client)
// 支持 USDT, USDC, DAI, UNI 等代币的元数据查询、余额/授权查询与转账/授权交易广播。
public class Erc20Token {

    public Contract Contract;           // 底层智能合约门面

    public Erc20Token(Address tokenAddress, Web3Client client, long chainId) {
        Contract = new Contract(tokenAddress, client, chainId);
    }

    public Address Address {
        get { return Contract.ContractAddress; }
    }

    // 查询代币名称（如 "Tether USD"）
    public string Name() {
        return Contract.CallString("name()", new byte[0]);
    }

    // 查询代币符号（如 "USDT"）
    public string Symbol() {
        return Contract.CallString("symbol()", new byte[0]);
    }

    // 查询代币小数位数（通常为 18 或 6）
    public int Decimals() {
        BigInt decBig = Contract.CallUint256("decimals()", new byte[0]);
        if (decBig == null) { return 18; }
        return (int)(decBig.limb(0) & 255);
    }

    // 查询代币总发行量
    public BigInt TotalSupply() {
        return Contract.CallUint256("totalSupply()", new byte[0]);
    }

    // 查询特定账户的代币余额
    public BigInt BalanceOf(Address account) {
        byte[] args = Abi.EncodeAddress(account);
        return Contract.CallUint256("balanceOf(address)", args);
    }

    // 查询代币所有者授权给第三方使用者的额度
    public BigInt Allowance(Address owner, Address spender) {
        byte[] ownerSlot = Abi.EncodeAddress(owner);
        byte[] spenderSlot = Abi.EncodeAddress(spender);
        byte[] args = new byte[64];
        for (int i = 0; i < 32; i = i + 1) { args[i] = ownerSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = spenderSlot[i]; }
        return Contract.CallUint256("allowance(address,address)", args);
    }

    // 签署并广播转账交易 (transfer(address to, uint256 amount))
    public string Transfer(Account signer, Address recipient, BigInt amount) {
        byte[] addrSlot = Abi.EncodeAddress(recipient);
        byte[] amountSlot = Abi.EncodeUint256(amount);
        byte[] args = new byte[64];
        for (int i = 0; i < 32; i = i + 1) { args[i] = addrSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = amountSlot[i]; }

        return Contract.SendTransaction(
            signer,
            "transfer(address,uint256)",
            args,
            BigInt.zero(),
            65000,
            EtherUnit.FromGwei(25),
            EtherUnit.FromGwei(2)
        );
    }

    public string Transfer(Account signer, Address recipient, long amount) {
        byte[] addrSlot = Abi.EncodeAddress(recipient);
        byte[] amountSlot = Abi.EncodeUint256(amount);
        byte[] args = new byte[64];
        for (int i = 0; i < 32; i = i + 1) { args[i] = addrSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = amountSlot[i]; }

        return Contract.SendTransaction(
            signer,
            "transfer(address,uint256)",
            args,
            BigInt.zero(),
            65000,
            EtherUnit.FromGwei(25),
            EtherUnit.FromGwei(2)
        );
    }

    // 签署并广播代币授权交易 (approve(address spender, uint256 amount))
    public string Approve(Account signer, Address spender, BigInt amount) {
        byte[] spenderSlot = Abi.EncodeAddress(spender);
        byte[] amountSlot = Abi.EncodeUint256(amount);
        byte[] args = new byte[64];
        for (int i = 0; i < 32; i = i + 1) { args[i] = spenderSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = amountSlot[i]; }

        return Contract.SendTransaction(
            signer,
            "approve(address,uint256)",
            args,
            BigInt.zero(),
            50000,
            EtherUnit.FromGwei(25),
            EtherUnit.FromGwei(2)
        );
    }

    public string Approve(Account signer, Address spender, long amount) {
        byte[] spenderSlot = Abi.EncodeAddress(spender);
        byte[] amountSlot = Abi.EncodeUint256(amount);
        byte[] args = new byte[64];
        for (int i = 0; i < 32; i = i + 1) { args[i] = spenderSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = amountSlot[i]; }

        return Contract.SendTransaction(
            signer,
            "approve(address,uint256)",
            args,
            BigInt.zero(),
            50000,
            EtherUnit.FromGwei(25),
            EtherUnit.FromGwei(2)
        );
    }

    // 签署并广播授权转账交易 (transferFrom(address from, address to, uint256 amount))
    public string TransferFrom(Account signer, Address from, Address to, BigInt amount) {
        byte[] fromSlot = Abi.EncodeAddress(from);
        byte[] toSlot = Abi.EncodeAddress(to);
        byte[] amountSlot = Abi.EncodeUint256(amount);
        byte[] args = new byte[96];
        for (int i = 0; i < 32; i = i + 1) { args[i] = fromSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = toSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[64 + i] = amountSlot[i]; }

        return Contract.SendTransaction(
            signer,
            "transferFrom(address,address,uint256)",
            args,
            BigInt.zero(),
            80000,
            EtherUnit.FromGwei(25),
            EtherUnit.FromGwei(2)
        );
    }
}
