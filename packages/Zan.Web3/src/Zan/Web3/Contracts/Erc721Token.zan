using System;
using System.Security.Cryptography;
using Zan.Web3.Types;
using Zan.Web3.Encoding;
using Zan.Web3.Rpc;

namespace Zan.Web3.Contracts;

// ERC-721 工业级非同质化代币 (NFT) 强类型智能合约包装类 (ERC-721 NFT Client)
// 支持数字艺术品、元宇宙资产、链上域名 (ENS)、游戏装备等 NFT 的元数据解析、归属查询与所有权转让。
public class Erc721Token {

    public Contract Contract;           // 底层智能合约门面

    public Erc721Token(Address tokenAddress, Web3Client client, long chainId) {
        Contract = new Contract(tokenAddress, client, chainId);
    }

    public Address Address {
        get { return Contract.ContractAddress; }
    }

    // 查询 NFT 集合名称
    public string Name() {
        return Contract.CallString("name()", new byte[0]);
    }

    // 查询 NFT 集合代币符号
    public string Symbol() {
        return Contract.CallString("symbol()", new byte[0]);
    }

    // 查询特定账户拥有的 NFT 总数量
    public BigInt BalanceOf(Address owner) {
        byte[] args = Abi.EncodeAddress(owner);
        return Contract.CallUint256("balanceOf(address)", args);
    }

    // 查询指定 TokenId 的当前持有者地址 (ownerOf(uint256))
    public Address OwnerOf(BigInt tokenId) {
        byte[] args = Abi.EncodeUint256(tokenId);
        return Contract.CallAddress("ownerOf(uint256)", args);
    }

    public Address OwnerOf(long tokenId) {
        byte[] args = Abi.EncodeUint256(tokenId);
        return Contract.CallAddress("ownerOf(uint256)", args);
    }

    // 查询指定 TokenId 的元数据 URI (通常指向 IPFS 或 HTTP JSON 元数据)
    public string TokenURI(BigInt tokenId) {
        byte[] args = Abi.EncodeUint256(tokenId);
        return Contract.CallString("tokenURI(uint256)", args);
    }

    public string TokenURI(long tokenId) {
        byte[] args = Abi.EncodeUint256(tokenId);
        return Contract.CallString("tokenURI(uint256)", args);
    }

    // 查询指定 TokenId 单独授权的操作地址
    public Address GetApproved(BigInt tokenId) {
        byte[] args = Abi.EncodeUint256(tokenId);
        return Contract.CallAddress("getApproved(uint256)", args);
    }

    public Address GetApproved(long tokenId) {
        byte[] args = Abi.EncodeUint256(tokenId);
        return Contract.CallAddress("getApproved(uint256)", args);
    }

    // 查询 operator 是否被授权管理 owner 的全部 NFT 资产
    public bool IsApprovedForAll(Address owner, Address operatorAddr) {
        byte[] ownerSlot = Abi.EncodeAddress(owner);
        byte[] opSlot = Abi.EncodeAddress(operatorAddr);
        byte[] args = new byte[64];
        for (int i = 0; i < 32; i = i + 1) { args[i] = ownerSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = opSlot[i]; }
        return Contract.CallBool("isApprovedForAll(address,address)", args);
    }

    // 单个 NFT 转移授权 (approve(address to, uint256 tokenId))
    public string Approve(Account signer, Address to, BigInt tokenId) {
        byte[] toSlot = Abi.EncodeAddress(to);
        byte[] idSlot = Abi.EncodeUint256(tokenId);
        byte[] args = new byte[64];
        for (int i = 0; i < 32; i = i + 1) { args[i] = toSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = idSlot[i]; }

        return Contract.SendTransaction(
            signer,
            "approve(address,uint256)",
            args,
            BigInt.zero(),
            60000,
            EtherUnit.FromGwei(25),
            EtherUnit.FromGwei(2)
        );
    }

    public string Approve(Account signer, Address to, long tokenId) {
        byte[] toSlot = Abi.EncodeAddress(to);
        byte[] idSlot = Abi.EncodeUint256(tokenId);
        byte[] args = new byte[64];
        for (int i = 0; i < 32; i = i + 1) { args[i] = toSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = idSlot[i]; }

        return Contract.SendTransaction(
            signer,
            "approve(address,uint256)",
            args,
            BigInt.zero(),
            60000,
            EtherUnit.FromGwei(25),
            EtherUnit.FromGwei(2)
        );
    }

    // 全局授权或撤销授权 (setApprovalForAll(address operator, bool approved))
    public string SetApprovalForAll(Account signer, Address operatorAddr, bool approved) {
        byte[] opSlot = Abi.EncodeAddress(operatorAddr);
        byte[] appSlot = Abi.EncodeBool(approved);
        byte[] args = new byte[64];
        for (int i = 0; i < 32; i = i + 1) { args[i] = opSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = appSlot[i]; }

        return Contract.SendTransaction(
            signer,
            "setApprovalForAll(address,bool)",
            args,
            BigInt.zero(),
            50000,
            EtherUnit.FromGwei(25),
            EtherUnit.FromGwei(2)
        );
    }

    // 转移 NFT (transferFrom(address from, address to, uint256 tokenId))
    public string TransferFrom(Account signer, Address from, Address to, BigInt tokenId) {
        byte[] fromSlot = Abi.EncodeAddress(from);
        byte[] toSlot = Abi.EncodeAddress(to);
        byte[] idSlot = Abi.EncodeUint256(tokenId);
        byte[] args = new byte[96];
        for (int i = 0; i < 32; i = i + 1) { args[i] = fromSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = toSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[64 + i] = idSlot[i]; }

        return Contract.SendTransaction(
            signer,
            "transferFrom(address,address,uint256)",
            args,
            BigInt.zero(),
            85000,
            EtherUnit.FromGwei(25),
            EtherUnit.FromGwei(2)
        );
    }

    public string TransferFrom(Account signer, Address from, Address to, long tokenId) {
        byte[] fromSlot = Abi.EncodeAddress(from);
        byte[] toSlot = Abi.EncodeAddress(to);
        byte[] idSlot = Abi.EncodeUint256(tokenId);
        byte[] args = new byte[96];
        for (int i = 0; i < 32; i = i + 1) { args[i] = fromSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[32 + i] = toSlot[i]; }
        for (int i = 0; i < 32; i = i + 1) { args[64 + i] = idSlot[i]; }

        return Contract.SendTransaction(
            signer,
            "transferFrom(address,address,uint256)",
            args,
            BigInt.zero(),
            85000,
            EtherUnit.FromGwei(25),
            EtherUnit.FromGwei(2)
        );
    }
}
