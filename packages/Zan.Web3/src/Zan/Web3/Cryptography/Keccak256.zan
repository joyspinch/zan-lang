using System;
using System.Numerics;
using System.Security.Cryptography;

namespace Zan.Web3.Cryptography;

// 以太坊标准 Keccak-256 密码学海绵散列算法实现。
// 速率 r = 1088 位（136 字节），容量 c = 512 位，填充模式为以太坊规范的 pad10*1（0x01 ... 0x80）。
public class Keccak256 {

    // 24 轮常量表（通过 LFSR 预先推导）
    static long[] RC = new long[] {
        1L,
        32898L,
        -9223372036854742902L,
        -9223372034707259392L,
        32907L,
        2147483649L,
        -9223372034707259263L,
        -9223372036854743031L,
        138L,
        136L,
        2147516425L,
        2147483658L,
        2147516555L,
        -9223372036854775669L,
        -9223372036854742903L,
        -9223372036854743037L,
        -9223372036854743038L,
        -9223372036854775680L,
        32778L,
        -9223372034707292150L,
        -9223372034707259263L,
        -9223372036854742912L,
        2147483649L,
        -9223372034707259384L
    };

    // 旋转偏移常数表 (x + 5 * y)
    static int[] RHO = new int[] {
         0,  1, 62, 28, 27,
        36, 44,  6, 55, 20,
         3, 10, 43, 25, 39,
        41, 45, 15, 21,  8,
        18,  2, 61, 56, 14
    };

    // 64 位循环左移
    private static long rotl(long x, int n) {
        if (n == 0) { return x; }
        return BitOperations.RotateLeft(x, n);
    }

    // Keccak-f[1600] 置换核心函数（24 轮）
    private static void permute(long[] st) {
        long[] c = new long[5];
        long[] d = new long[5];
        long[] b = new long[25];

        for (int round = 0; round < 24; round = round + 1) {
            // 1. Theta 步骤
            for (int x = 0; x < 5; x = x + 1) {
                c[x] = st[x] ^ st[x + 5] ^ st[x + 10] ^ st[x + 15] ^ st[x + 20];
            }
            for (int x = 0; x < 5; x = x + 1) {
                long cPrev = c[(x + 4) % 5];
                long cNext = c[(x + 1) % 5];
                d[x] = cPrev ^ rotl(cNext, 1);
            }
            for (int i = 0; i < 25; i = i + 1) {
                st[i] = st[i] ^ d[i % 5];
            }

            // 2 & 3. Rho & Pi 步骤
            for (int x = 0; x < 5; x = x + 1) {
                for (int y = 0; y < 5; y = y + 1) {
                    int src = x + 5 * y;
                    int dst = y + 5 * ((2 * x + 3 * y) % 5);
                    b[dst] = rotl(st[src], RHO[src]);
                }
            }

            // 4. Chi 步骤
            for (int y = 0; y < 5; y = y + 1) {
                int row = 5 * y;
                for (int x = 0; x < 5; x = x + 1) {
                    st[row + x] = b[row + x] ^ ((~b[row + ((x + 1) % 5)]) & b[row + ((x + 2) % 5)]);
                }
            }

            // 5. Iota 步骤
            st[0] = st[0] ^ RC[round];
        }
    }

    // 计算字节数组的前 len 字节的 Keccak-256 散列，输出 32 字节摘要
    public static byte[] Hash(byte[] data, int len) {
        if (data == null || len < 0) { return new byte[32]; }
        if (len > data.Length) { len = data.Length; }

        int rate = 136; // 1088 位 = 136 字节
        long[] st = new long[25];

        int blockCount = (len / rate) + 1;
        int totalPadded = blockCount * rate;
        byte[] padded = new byte[totalPadded];

        // 复制原始数据
        for (int i = 0; i < len; i = i + 1) {
            padded[i] = data[i];
        }

        // 以太坊 Keccak 填充：0x01 ... 0x80
        padded[len] = (byte)(padded[len] ^ 1);
        padded[totalPadded - 1] = (byte)(padded[totalPadded - 1] ^ 128);

        // 按 136 字节块逐块吸收 (Absorb)
        for (int blk = 0; blk < blockCount; blk = blk + 1) {
            int offset = blk * rate;
            for (int i = 0; i < 17; i = i + 1) {
                int pos = offset + i * 8;
                long w = 0;
                for (int j = 0; j < 8; j = j + 1) {
                    long byteVal = (long)(padded[pos + j] & 255);
                    w = w | (byteVal << (j * 8));
                }
                st[i] = st[i] ^ w;
            }
            permute(st);
        }

        // 挤压输出前 32 字节 (Squeeze)
        byte[] output = new byte[32];
        for (int i = 0; i < 4; i = i + 1) {
            long w = st[i];
            int pos = i * 8;
            for (int j = 0; j < 8; j = j + 1) {
                output[pos + j] = (byte)((w >> (j * 8)) & 255);
            }
        }

        return output;
    }

    public static byte[] Hash(byte[] data) {
        if (data == null) { return Hash(new byte[0], 0); }
        return Hash(data, data.Length);
    }

    public static byte[] Hash(string text) {
        if (text == null) { text = ""; }
        byte[] b = text.ToBytes();
        return Hash(b, b.Length);
    }

    // 计算散列并返回小写十六进制字符串（如 "c5d2460186f7..."）
    public static string HashHex(byte[] data) {
        byte[] h = Hash(data);
        return Hex.Encode(h, h.Length);
    }

    public static string HashHex(string text) {
        byte[] h = Hash(text);
        return Hex.Encode(h, h.Length);
    }
}
