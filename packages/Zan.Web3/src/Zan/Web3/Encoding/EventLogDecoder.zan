using System;
using System.Security.Cryptography;
using Zan.Web3.Types;

namespace Zan.Web3.Encoding;

// ERC-20 Transfer(address indexed from, address indexed to, uint256 value) 事件数据
public class Erc20TransferEvent {
    public Address From;
    public Address To;
    public BigInt Value;

    public Erc20TransferEvent(Address from, Address to, BigInt value) {
        From = from != null ? from : Address.Zero;
        To = to != null ? to : Address.Zero;
        Value = value != null ? value : BigInt.zero();
    }
}

// ERC-20 Approval(address indexed owner, address indexed spender, uint256 value) 事件数据
public class Erc20ApprovalEvent {
    public Address Owner;
    public Address Spender;
    public BigInt Value;

    public Erc20ApprovalEvent(Address owner, Address spender, BigInt value) {
        Owner = owner != null ? owner : Address.Zero;
        Spender = spender != null ? spender : Address.Zero;
        Value = value != null ? value : BigInt.zero();
    }
}

// 智能合约事件日志编解码器 (Event Log Decoder)
public class EventLogDecoder {

    // 标准 ERC-20 Transfer 事件的 Keccak-256 主题哈希
    // keccak256("Transfer(address,address,uint256)")
    public static string Erc20TransferTopic0 = "0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef";

    // 标准 ERC-20 Approval 事件的 Keccak-256 主题哈希
    // keccak256("Approval(address,address,uint256)")
    public static string Erc20ApprovalTopic0 = "0x8c5be1e5ebec7d5bd14f71427d1e84f3dd0314c0f7b2291e5b200ac8c7c3b925";

    // 计算任意事件签名的 Topic[0] 散列（例如 "Transfer(address,address,uint256)"）
    public static string GetEventTopic0(string signature) {
        if (signature == null) { return ""; }
        return "0x" + Keccak256.HashHex(signature);
    }

    // 从 32 字节 Topic 十六进制字符串中解码以太坊地址（取低 20 字节，即跳过前 24 个十六进制字符）
    public static Address TopicToAddress(string topicHex) {
        if (topicHex == null) { return Address.Zero; }
        string clean = topicHex.Trim();
        if (clean.StartsWith("0x") || clean.StartsWith("0X")) {
            clean = clean.Substring(2);
        }
        if (clean.Length == 64) {
            // 取后 40 个字符
            clean = clean.Substring(24);
        }
        if (clean.Length != 40) { return Address.Zero; }
        return Address.Parse("0x" + clean);
    }

    // 解码 ERC-20 Transfer 事件日志
    public static Erc20TransferEvent DecodeTransfer(EventLog log) {
        if (log == null || log.Topics == null || log.Topics.Count < 3) {
            return null;
        }

        // 校验 Topic0 是否匹配
        string topic0 = log.Topics[0].ToLower();
        if (topic0 != Erc20TransferTopic0.ToLower()) {
            return null;
        }

        Address from = TopicToAddress(log.Topics[1]);
        Address to = TopicToAddress(log.Topics[2]);
        BigInt value = Abi.DecodeUint256(log.Data, 0);

        return new Erc20TransferEvent(from, to, value);
    }

    // 解码 ERC-20 Approval 事件日志
    public static Erc20ApprovalEvent DecodeApproval(EventLog log) {
        if (log == null || log.Topics == null || log.Topics.Count < 3) {
            return null;
        }

        string topic0 = log.Topics[0].ToLower();
        if (topic0 != Erc20ApprovalTopic0.ToLower()) {
            return null;
        }

        Address owner = TopicToAddress(log.Topics[1]);
        Address spender = TopicToAddress(log.Topics[2]);
        BigInt value = Abi.DecodeUint256(log.Data, 0);

        return new Erc20ApprovalEvent(owner, spender, value);
    }
}
