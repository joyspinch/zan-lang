using System;
using Zan.Web3.Rpc;

namespace Zan.Web3.Chains;

// EVM 区块链网络元数据配置实体与常用主流公链预设库
public class Chain {

    public long ChainId;                     // 链 ID
    public string Name;                      // 链可读名称
    public string Symbol;                    // 原生主币符号 (ETH, BNB, POL 等)
    public string RpcUrl;                    // 默认公共 RPC 节点 URL
    public string BlockExplorerUrl;          // 区块浏览器基础 URL
    public bool SupportsEip1559;             // 是否支持现代 EIP-1559 Type-2 动态费用交易

    public Chain(long chainId, string name, string symbol, string rpcUrl, string explorerUrl, bool supportsEip1559) {
        ChainId = chainId;
        Name = name != null ? name : "Unknown Chain";
        Symbol = symbol != null ? symbol : "ETH";
        RpcUrl = rpcUrl != null ? rpcUrl : "";
        BlockExplorerUrl = explorerUrl != null ? explorerUrl : "";
        SupportsEip1559 = supportsEip1559;
    }

    // 以太坊主网 (Ethereum Mainnet - 1)
    public static Chain Mainnet = new Chain(
        1, "Ethereum Mainnet", "ETH", "https://eth.llamarpc.com", "https://etherscan.io", true
    );

    // Arbitrum One 主网 (42161)
    public static Chain Arbitrum = new Chain(
        42161, "Arbitrum One", "ETH", "https://arb1.arbitrum.io/rpc", "https://arbiscan.io", true
    );

    // Optimism 主网 (10)
    public static Chain Optimism = new Chain(
        10, "OP Mainnet", "ETH", "https://mainnet.optimism.io", "https://optimistic.etherscan.io", true
    );

    // Base 主网 (8453)
    public static Chain Base = new Chain(
        8453, "Base", "ETH", "https://mainnet.base.org", "https://basescan.org", true
    );

    // Polygon PoS 主网 (137)
    public static Chain Polygon = new Chain(
        137, "Polygon PoS", "POL", "https://polygon-rpc.com", "https://polygonscan.com", true
    );

    // BNB Smart Chain 主网 (56)
    public static Chain Bsc = new Chain(
        56, "BNB Smart Chain", "BNB", "https://bsc-dataseed.binance.org", "https://bscscan.com", false
    );

    // 以太坊官方测试网 Sepolia (11155111)
    public static Chain Sepolia = new Chain(
        11155111, "Sepolia Testnet", "SepoliaETH", "https://rpc.sepolia.org", "https://sepolia.etherscan.io", true
    );

    // 根据 ChainId 获取预设链配置（未命中则返回动态构造的未知链配置）
    public static Chain FromId(long chainId) {
        if (chainId == 1) { return Mainnet; }
        if (chainId == 42161) { return Arbitrum; }
        if (chainId == 10) { return Optimism; }
        if (chainId == 8453) { return Base; }
        if (chainId == 137) { return Polygon; }
        if (chainId == 56) { return Bsc; }
        if (chainId == 11155111) { return Sepolia; }
        return new Chain(chainId, "Chain " + chainId.ToString(), "ETH", "", "", true);
    }

    // 为当前链创建专属绑定的 Web3Client 客户端
    public Web3Client CreateClient() {
        return new Web3Client(RpcUrl);
    }

    // 根据交易哈希生成区块浏览器链接
    public string GetTxUrl(string txHash) {
        if (BlockExplorerUrl == null || BlockExplorerUrl.Length == 0 || txHash == null) {
            return "";
        }
        string clean = txHash.Trim();
        return BlockExplorerUrl + "/tx/" + clean;
    }

    // 根据账户地址生成区块浏览器链接
    public string GetAddressUrl(string addressHex) {
        if (BlockExplorerUrl == null || BlockExplorerUrl.Length == 0 || addressHex == null) {
            return "";
        }
        string clean = addressHex.Trim();
        return BlockExplorerUrl + "/address/" + clean;
    }
}
