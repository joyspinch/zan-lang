using System;
using System.Security.Cryptography;
using Zan.Web3.Encoding;

namespace Zan.Web3.Types;

// EIP-712 结构化数据签名域定义实体。
public class Eip712Domain {
    public string Name;                  // DApp 或协议名称 (如 "Uniswap", "Permit2")
    public string Version;               // 协议主版本号 (如 "1")
    public long ChainId;                 // 目标区块链网络 ID (如 1)
    public Address VerifyingContract;    // 验证或执行该签名的合约地址

    public Eip712Domain(string name, string version, long chainId, Address verifyingContract) {
        Name = name != null ? name : "";
        Version = version != null ? version : "";
        ChainId = chainId;
        VerifyingContract = verifyingContract != null ? verifyingContract : Address.Zero;
    }

    // 计算 EIP-712 标准域隔离符 (Domain Separator，32 字节哈希值)
    public byte[] GetDomainSeparator() {
        // 标准 Domain 类型字符串定义
        string typeSig = "EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)";
        byte[] typeHash = Keccak256.Hash(typeSig);

        byte[] nameHash = Keccak256.Hash(Name);
        byte[] verHash = Keccak256.Hash(Version);
        byte[] chainIdSlot = Abi.EncodeUint256(ChainId);
        byte[] contractSlot = Abi.EncodeAddress(VerifyingContract);

        // 拼接 5 个 32 字节槽位 (共 160 字节) 并求 Keccak-256
        byte[] payload = new byte[160];
        for (int i = 0; i < 32; i = i + 1) {
            payload[i]       = typeHash[i];
            payload[32 + i]  = nameHash[i];
            payload[64 + i]  = verHash[i];
            payload[96 + i]  = chainIdSlot[i];
            payload[128 + i] = contractSlot[i];
        }
        return Keccak256.Hash(payload, 160);
    }
}

// 以太坊 EIP-712 类型化结构数据哈希与签名工具（DeFi 授权与离线挂单协议的核心工业标准）。
public class Eip712 {

    // 根据 EIP-712 规范计算最终待签名的 32 字节哈希值
    // 格式：keccak256("\x19\x01" || domainSeparator || structHash)
    public static byte[] HashTypedData(Eip712Domain domain, byte[] structHash32) {
        if (domain == null || structHash32 == null || structHash32.Length != 32) {
            return new byte[32];
        }

        byte[] domainSeparator = domain.GetDomainSeparator();

        // 2 字节前缀 + 32 字节 domainSeparator + 32 字节 structHash = 66 字节
        byte[] payload = new byte[66];
        payload[0] = 0x19;
        payload[1] = 0x01;

        for (int i = 0; i < 32; i = i + 1) {
            payload[2 + i] = domainSeparator[i];
            payload[34 + i] = structHash32[i];
        }

        return Keccak256.Hash(payload, 66);
    }
}
