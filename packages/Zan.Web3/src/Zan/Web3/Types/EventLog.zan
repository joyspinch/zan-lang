using System;
using Zan.Web3.Types;

namespace Zan.Web3.Types;

// 链上智能合约事件日志实体 (Ethereum / EVM Event Log)
public class EventLog {
    public Address Address;               // 产生事件的合约地址
    public List<string> Topics;           // 事件主题列表（Topic[0] 为签名 Hash，Topic[1..3] 为 indexed 参数）
    public byte[] Data;                   // 未被索引的事件负载数据（ABI 编码）
    public long BlockNumber;              // 所在区块高度
    public string TransactionHash;        // 所在交易哈希
    public int LogIndex;                  // 块内/交易内日志索引

    public EventLog() {
        Address = Address.Zero;
        Topics = new List<string>();
        Data = new byte[0];
        BlockNumber = 0;
        TransactionHash = "";
        LogIndex = 0;
    }

    public EventLog(Address contractAddr, List<string> topics, byte[] data) {
        Address = contractAddr != null ? contractAddr : Address.Zero;
        Topics = topics != null ? topics : new List<string>();
        Data = data != null ? data : new byte[0];
        BlockNumber = 0;
        TransactionHash = "";
        LogIndex = 0;
    }
}
