using System;
using Zan.Web3.Types;

namespace Zan.Web3.Types;

// BIP-44 多币种分级确定性钱包规范实现 (Multi-Account Hierarchy for Deterministic Wallets)
// 默认支持以太坊标准主网派生路径 m/44'/60'/0'/0/i
public class Bip44 {

    // 以太坊 Coin Type 编号 (SLIP-0044: 60)
    public static int EthereumCoinType = 60;

    // 从 BIP-39 Seed 派生指定索引的以太坊账户
    // 派生路径: m/44'/60'/0'/0/{accountIndex}
    public static Account DeriveAccount(byte[] seed, int accountIndex) {
        if (seed == null) { return null; }
        ExtendedKey root = Bip32.FromSeed(seed);
        if (root == null) { return null; }

        string path = "m/44'/60'/0'/0/" + accountIndex.ToString();
        ExtendedKey child = Bip32.DerivePath(root, path);
        if (child == null || child.Key == null) {
            return null;
        }

        return Account.FromPrivateKey(child.Key);
    }

    // 从助记词直接派生指定索引的标准以太坊 HD 账户
    public static Account DeriveAccountFromMnemonic(string mnemonic, string passphrase, int accountIndex) {
        byte[] seed = Mnemonic.MnemonicToSeed(mnemonic, passphrase);
        if (seed == null) { return null; }
        return DeriveAccount(seed, accountIndex);
    }
}
